# Environment for the labwc session. Reference: man labwc-config.
# A user's ~/.config/labwc/environment replaces this file.
# The cursor: also GSettings' cursor-theme and the login screen's. The two must
# match, or the cursor changes as it moves between a window and the desktop.
XCURSOR_THEME=FlickOS-Bibata
XCURSOR_SIZE=24
