<?xml version="1.0" encoding="UTF-8"?>
<!--
  FlickOS defaults for Thunar. Thunar keeps its settings in xfconf, whose
  daemon (xfconfd) is started by D-Bus without the session's XDG_CONFIG_DIRS,
  so this file can't live in /etc/xdg/flickos. It fills in only what the user
  hasn't set: the user's ~/.config/xfce4/xfconf/xfce-perchannel-xml/thunar.xml
  (written when Thunar saves a setting) wins.

  last-location-bar: the path as buttons (Thunar's default is the text entry;
  Ctrl+L still types a location). Window size as FlickOS's pcmanfm had.

  The rest is Thunar's one-row look: misc-use-csd draws a header bar (the HIG's
  one exception to WIN-1; flickos-layout gives it the layout's window buttons)
  and, with the menu bar off, the toolbar moves into it. The menu is the toolbar's
  menu item, and Ctrl+M brings the menu bar back.
-->
<channel name="thunar" version="1.0">
  <property name="last-location-bar" type="string" value="ThunarLocationButtons"/>
  <property name="last-window-width" type="int" value="960"/>
  <property name="last-window-height" type="int" value="600"/>
  <property name="last-separator-position" type="int" value="180"/>
  <property name="misc-use-csd" type="bool" value="true"/>
  <property name="last-menubar-visible" type="bool" value="false"/>
  <property name="last-statusbar-visible" type="bool" value="false"/>
  <property name="last-icon-view-zoom-level" type="string" value="THUNAR_ZOOM_LEVEL_150_PERCENT"/>
  <property name="last-toolbar-items" type="string" value="menu:1,back:1,forward:1,open-parent:0,open-home:0,new-tab:0,new-window:0,toggle-split-view:0,undo:0,redo:0,zoom-out:0,zoom-in:0,zoom-reset:0,view-as-icons:0,view-as-detailed-list:0,view-as-compact-list:0,location-bar:1,reload:0,search:1,view-switcher:1"/>
</channel>
