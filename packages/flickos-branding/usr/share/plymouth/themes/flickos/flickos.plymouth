[Plymouth Theme]
Name=FlickOS
Description=FlickOS boot splash: logo and spinner on a dark background.
# two-step.so comes from the plymouth-themes package (a dependency), not from
# plymouth itself. plymouth-set-default-theme fails if that package is missing.
ModuleName=two-step

# Images in ImageDir (generated by tools/make-placeholder-art.sh):
#   watermark.png            logo in the middle of the screen
#   throbber-NNNN.png        spinner shown while booting
#   animation-NNNN.png       required by two-step (end animation, unused)
#   entry.png, bullet.png, lock.png   disk encryption password dialog
[two-step]
Font=DejaVu Sans 12
TitleFont=DejaVu Sans 24
ImageDir=/usr/share/plymouth/themes/flickos
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.7
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.75
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.4
Transition=none
TransitionDuration=0.0
# Arc-Dark: background and borders; the bar in FlickOS's brand amber.
BackgroundStartColor=0x383c4a
BackgroundEndColor=0x383c4a
ProgressBarBackgroundColor=0x2b2e39
ProgressBarForegroundColor=0xffb13d
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing Updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading System...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting System...
SubTitle=Do not turn off your computer
