From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jon <dvbondoy@gmail.com>
Date: Sat, 21 Nov 2026 20:08:02 +0800
Subject: [PATCH 09/18] Icons: draw an Icon= that is a file path as a file

FlickOS change against upstream d40912d, not forwarded. Why: debian/README.source.
---
 src/appinfo.c        | 10 +++++++++-
 src/gui/scaleimage.c |  4 +++-
 2 files changed, 12 insertions(+), 2 deletions(-)

diff --git a/src/appinfo.c b/src/appinfo.c
index 7b2628c..c98fe1e 100644
--- a/src/appinfo.c
+++ b/src/appinfo.c
@@ -3,6 +3,7 @@
 #include <gtk/gtk.h>
 #include <sys/stat.h>
 #include "appinfo.h"
+#include "util/file.h"
 
 static GHashTable *app_info_wm_class_map;
 static GHashTable *icon_map;
@@ -203,7 +204,14 @@ gchar *app_info_icon_get ( const gchar *app_id, gboolean symbolic_pref )
   else
   {
     icon_name = g_desktop_app_info_get_string(app, "Icon");
-    icon = app_info_icon_test(icon_name, symbolic_pref);
+    /* FlickOS: a desktop file's Icon= may be a file's full path (Firefox's
+     * web apps write one); return it, and scale_image_set() draws it as a
+     * file. The icon theme only knows names, so upstream fell back to the
+     * default icon. */
+    if(icon_name && *icon_name == '/' && file_test_read(icon_name))
+      icon = g_strdup(icon_name);
+    else
+      icon = app_info_icon_test(icon_name, symbolic_pref);
     g_free(icon_name);
   }
 
diff --git a/src/gui/scaleimage.c b/src/gui/scaleimage.c
index 0e0458b..7c9436e 100644
--- a/src/gui/scaleimage.c
+++ b/src/gui/scaleimage.c
@@ -494,7 +494,9 @@ static gboolean scale_image_set ( GtkWidget *self )
   g_free(priv->fname);
   if( (priv->fname = app_info_icon_lookup(priv->file, priv->symbolic_pref)) )
   {
-    priv->ftype = SI_ICON;
+    /* FlickOS: app_info_icon_get() gives a desktop file's Icon= path as it
+     * is: a file, not a name in the icon theme. */
+    priv->ftype = *priv->fname == '/' ? SI_FILE : SI_ICON;
     priv->aspect = 0.0;
     priv->symbolic = g_str_has_suffix(priv->fname, "-symbolic");
     return TRUE;
