<?xml version="1.0" encoding="UTF-8"?>
<!-- A FlickOS kit is an AppStream add-on of the Tool Kits window
     (docs/design/flickos-dev.md, ADR-001 and ADR-002): Software lists add-ons
     that extend flickos-kits.desktop, and FlickOS::kit names the kit. The
     category is a custom value because appstreamcli ignores an X-FlickOS-*
     category. This kit's is "security" (docs/design/flickos-security.md,
     ADR-S01): Software shows it under Security Tools, with the permission
     sentence (ADR-S05) above the description, so the sentence isn't here. -->
<component type="addon">
  <id>io.github.dvbondoy.flickos.kits.reversing</id>
  <extends>flickos-kits.desktop</extends>
  <name>Reverse Engineering</name>
  <summary>Debuggers, tracers and hex editors for programs</summary>
  <description>
    <p>
      gdb and edb, ltrace and strace, objdump and readelf, apktool for
      Android apps, and the GHex and hexedit hex editors from Debian.
      apktool brings a Java runtime.
    </p>
    <p>
      Ghidra, radare2 and rizin aren't in Debian 13, so they aren't
      part of the kit.
    </p>
  </description>
  <icon type="stock">security-high</icon>
  <url type="homepage">https://flickos.org/</url>
  <developer id="io.github.dvbondoy">
    <name>FlickOS</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <custom>
    <value key="FlickOS::kit">reversing</value>
    <value key="FlickOS::kit-category">security</value>
  </custom>
</component>
