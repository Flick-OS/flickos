#!/usr/bin/make -f

# The tests import usr/bin/flickos-welcome; no bytecode next to installed files.
export PYTHONDONTWRITEBYTECODE = 1

# Translations (docs/12-translating.md): every po/LANG.po in po/LINGUAS.
LANGS := $(shell sed 's/\#.*//' po/LINGUAS)

%:
	dh $@

# --check: a translation with a broken {placeholder} fails the build.
override_dh_auto_build:
	set -e; for lang in $(LANGS); do \
		mkdir -p debian/locale/$$lang/LC_MESSAGES; \
		msgfmt --check --output-file=debian/locale/$$lang/LC_MESSAGES/flickos-welcome.mo po/$$lang.po; \
	done
	msgfmt --desktop --template=usr/share/applications/flickos-welcome.desktop -d po \
		--output-file=debian/flickos-welcome.desktop

# The desktop file with the translations' Name[LANG] lines replaces the one
# debian/install copied.
override_dh_install:
	dh_install
	install -m 644 debian/flickos-welcome.desktop debian/flickos-welcome/usr/share/applications/
	if [ -d debian/locale ]; then cp -r debian/locale debian/flickos-welcome/usr/share/; fi

# Skipped with DEB_BUILD_OPTIONS=nocheck.
override_dh_auto_test:
	python3 -m unittest discover -s tests -v
