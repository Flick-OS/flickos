#Api2
# Footprint's dock, run by sfwbar (sfwbar(1)) on the left edge. flickos-layout
# generates the config sfwbar reads: this file with "flickos/pinned" replaced
# by the installed apps of Pinned= (layout.ini) and "flickos/launcher" by
# what the panel's apps button runs, then the style's palette and dock.css
# (no #CSS section here). The dock keeps its width, so windows open to the
# right of it. It is in the bottom layer: labwc gives the top layer's bar
# its room first, so the top bar spans the whole width above the dock, and a
# fullscreen window covers it.

# The menu of a right click on an app, as Redmond+'s taskbar has (Q2b of
# docs/design/flickos-panel.md). A window's items, picked by its state:
# Minimize, Maximize, Close; maximized: Minimize, Unmaximize, Close;
# minimized: Restore, Close. An app's button also pins or unpins the app
# (`flickos-layout pinned`, the same list as Settings' Pinned Apps; the dock
# reads its config again): under its window's items when it has one window,
# alone when it has none (only pinned) or several (sfwbar gives no single
# window: the rows of its hover list carry the window's items). WindowInfo
# ("pinned") and ("appid") about the clicked app are FlickOS patches to
# sfwbar: 0 or 1 on an app's button, NA on a hover list's row. Icons: the
# theme's window-*-symbolic and view-pin-symbolic, which every FlickOS icon
# theme has. Plain strings: a value with a function call is polled every
# second (F-18 of docs/design/sfwbar-panel-spike/RESULTS.md).

Function DockMenu() {
  Var pin;
  pin = WindowInfo("pinned");
  If pin = NA()
    pin = "";
  Else If pin
    pin = "_unpin";
  Else
    pin = "_pin";
  If WindowInfo("title") = NA() & pin = ""
    Return;
  If WindowInfo("title") = NA()
    Menu("dock_app" + pin);
  Else If WindowInfo("minimized")
    Menu("dock_minimized" + pin);
  Else If WindowInfo("maximized")
    Menu("dock_maximized" + pin);
  Else
    Menu("dock_window" + pin);
}

menu "dock_window" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Maximize"  icon = "window-maximize-symbolic"  action = Maximize() }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "dock_window_pin" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Maximize"  icon = "window-maximize-symbolic"  action = Maximize() }
  item { value = "Pin to Dock"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned add '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "dock_window_unpin" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Maximize"  icon = "window-maximize-symbolic"  action = Maximize() }
  item { value = "Unpin from Dock"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned remove '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "dock_maximized" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Unmaximize"  icon = "window-restore-symbolic"  action = UnMaximize() }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "dock_maximized_pin" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Unmaximize"  icon = "window-restore-symbolic"  action = UnMaximize() }
  item { value = "Pin to Dock"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned add '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "dock_maximized_unpin" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Unmaximize"  icon = "window-restore-symbolic"  action = UnMaximize() }
  item { value = "Unpin from Dock"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned remove '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "dock_minimized" {
  item { value = "Restore"  icon = "window-restore-symbolic"  action = UnMinimize() }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "dock_minimized_pin" {
  item { value = "Restore"  icon = "window-restore-symbolic"  action = UnMinimize() }
  item { value = "Pin to Dock"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned add '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "dock_minimized_unpin" {
  item { value = "Restore"  icon = "window-restore-symbolic"  action = UnMinimize() }
  item { value = "Unpin from Dock"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned remove '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "dock_app_pin" {
  item { value = "Pin to Dock"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned add '" + WindowInfo("appid") + "'") }
}

menu "dock_app_unpin" {
  item { value = "Unpin from Dock"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned remove '" + WindowInfo("appid") + "'") }
}

# Show Apps, at the bottom end of the dock. This section comes before the
# bar below on purpose: sfwbar copies a bar to the other screens when it reads
# its `mirror` line, so a section declared after it never reaches them (Show
# Apps was missing on a second monitor). dock.config's test checks the order.
bar ":end" {
  button {
    style = "showapps"
    value = "view-app-grid-symbolic"
    tooltip = "Show Apps"
    action[LeftClick] = Exec("flickos/launcher")
  }
}

bar {
  edge = "left"
  layer = "bottom"
  mirror = "*"
  exclusive_zone = "auto"

  # One button per app: pinned apps first, then other running apps. Hovering
  # an app with several windows lists them (one under another: dock.css).
  taskbar {
    style = "dock"
    group = popup
    pins = "flickos/pinned"
    icons = true
    labels = false
    tooltips = true
    sort = false
    cols = 1
    group cols = 1
    group icons = true
    group labels = true
    action[RightClick] = DockMenu()
  }
}
