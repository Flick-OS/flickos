#Api2
# Footprint's dock, run by sfwbar (sfwbar(1)) on the left edge. flickos-layout
# generates the config sfwbar reads: this file with "flickos/pinned" replaced
# by the installed apps of Pinned= (layout.ini) and "flickos/launcher" by
# what the panel's apps button runs, then the style's palette and dock.css
# (no #CSS section here). The dock keeps its width, so windows open to the
# right of it. It is in the bottom layer: labwc gives the top layer's bar
# its room first, so the top bar spans the whole width above the dock, and a
# fullscreen window covers it.

# The menu of a right click on an app: pin it to the dock or take it off.
# `flickos-layout pinned` saves the choice (Settings' Pinned Apps shows the
# same list) and the dock reads its config again. WindowInfo("appid") and
# ("pinned") about the clicked app are FlickOS patches to sfwbar (the app
# may have no window, or several).
menu "dock_pin" {
  item {
    value = "Pin to Dock"
    action = Exec("flickos-layout pinned add '" + WindowInfo("appid") + "'")
  }
}

menu "dock_unpin" {
  item {
    value = "Unpin from Dock"
    action = Exec("flickos-layout pinned remove '" + WindowInfo("appid") + "'")
  }
}

# Show Apps, at the bottom end of the dock. This section comes before the
# bar below on purpose: sfwbar copies a bar to the other screens when it reads
# its `mirror` line, so a section declared after it never reaches them (Show
# Apps was missing on a second monitor). dock.config's test checks the order.
bar ":end" {
  button {
    style = "showapps"
    value = "view-app-grid-symbolic"
    tooltip = "Show Apps"
    action[LeftClick] = Exec("flickos/launcher")
  }
}

bar {
  edge = "left"
  layer = "bottom"
  mirror = "*"
  exclusive_zone = "auto"

  # One button per app: pinned apps first, then other running apps. Hovering
  # an app with several windows lists them (one under another: dock.css).
  taskbar {
    style = "dock"
    group = popup
    pins = "flickos/pinned"
    icons = true
    labels = false
    tooltips = true
    sort = false
    cols = 1
    group cols = 1
    group icons = true
    group labels = true
    action[RightClick] = Menu(If(WindowInfo("pinned"), "dock_unpin", "dock_pin"))
  }
}
