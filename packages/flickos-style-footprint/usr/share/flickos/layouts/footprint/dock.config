#Api2
# Footprint's dock, run by sfwbar (sfwbar(1)) on the left edge. flickos-layout
# generates the config sfwbar reads: this file with "flickos/pinned" replaced
# by the installed apps of Pinned= (layout.ini) and "flickos/launcher" by
# what the panel's apps button runs, then the style's palette and dock.css
# (no #CSS section here). The dock keeps its width, so windows open to the
# right of it. It is in the bottom layer: labwc gives the top layer's bar
# its room first, so the top bar spans the whole width above the dock, and a
# fullscreen window covers it.

bar {
  edge = "left"
  layer = "bottom"
  mirror = "*"
  exclusive_zone = "auto"

  # One button per app: pinned apps first, then other running apps. Hovering
  # an app with several windows lists them (one under another: dock.css).
  taskbar {
    style = "dock"
    group = popup
    pins = "flickos/pinned"
    icons = true
    labels = false
    tooltips = true
    sort = false
    cols = 1
    group cols = 1
    group icons = true
    group labels = true
  }
}

# Show Apps, at the bottom end of the dock.
bar ":end" {
  button {
    style = "showapps"
    value = "view-app-grid-symbolic"
    tooltip = "Show Apps"
    action[LeftClick] = Exec("flickos/launcher")
  }
}
