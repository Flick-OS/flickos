# Aye3: FlickOS's own window theme (flickos-style-aye3, written by
# tools/make-aye3.py; man labwc-theme). Flat title bars and thin borders: the
# focused window slate blue, the others grey. No button files: labwc's
# built-in buttons in the image colors below, small and quiet.
border.width: 2
window.active.border.color: #4c7899
window.inactive.border.color: #333333
window.active.indicator.toggled-keybind.color: #900000
window.titlebar.padding.width: 4
window.titlebar.padding.height: 0
window.active.title.bg.color: #285577
window.inactive.title.bg.color: #222222
window.active.label.text.color: #ffffff
window.inactive.label.text.color: #8c8c8c
window.label.text.justify: left
window.button.width: 20
window.button.height: 18
window.button.spacing: 0
window.button.hover.bg.corner-radius: 0
window.active.button.unpressed.image.color: #ffffff
window.inactive.button.unpressed.image.color: #8c8c8c
menu.border.width: 1
menu.border.color: #333333
menu.items.bg.color: #222222
menu.items.text.color: #bbbbbb
menu.items.active.bg.color: #285577
menu.items.active.text.color: #ffffff
menu.items.padding.x: 8
menu.items.padding.y: 4
menu.separator.color: #333333
menu.title.bg.color: #000000
menu.title.text.color: #ffffff
osd.bg.color: #222222
osd.border.color: #4c7899
osd.border.width: 1
osd.label.text.color: #ffffff
osd.window-switcher.preview.border.color: #2e9ef4
osd.window-switcher.width: 640
osd.window-switcher.padding: 8
osd.window-switcher.item.padding.x: 12
osd.window-switcher.item.padding.y: 6
osd.window-switcher.item.active.border.width: 2
snapping.overlay.region.bg.color: #2855774c
snapping.overlay.region.border.color: #4c7899
snapping.overlay.edge.bg.color: #2855774c
snapping.overlay.edge.border.color: #4c7899
magnifier.border.color: #4c7899
