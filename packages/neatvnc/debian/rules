#!/usr/bin/make -f

export DH_VERBOSE = 1

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# FlickOS: built inside the FlickOS git tree. meson.build asks git for a
# version (commit and branch) when it can: never ours.
export GIT_DIR = $(CURDIR)/.no-git

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
	        -Dtests=true \
		-Dh264=disabled \
		$(NULL)

# https://github.com/any1/neatvnc/issues/85
ifneq (,$(filter $(DEB_HOST_ARCH),s390x hppa powerpc ppc64))
override_dh_auto_test:
	-dh_auto_test
endif

execute_after_dh_auto_test:
	-cat obj-*/meson-logs/testlog.txt

# FlickOS (flickos-classroom-view's ADR-013): no H.264, so no libavcodec,
# libavfilter or libavutil: wayvnc then adds about 1.2 MB to FlickOS instead
# of 53 MB. Only the library is built; no -dbgsym package for the repo.
# One binary package: debhelper would install straight into it; the
# headers and pkg-config file (libneatvnc-dev's) stay in debian/tmp
# (debian/not-installed).
override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_dwz:
