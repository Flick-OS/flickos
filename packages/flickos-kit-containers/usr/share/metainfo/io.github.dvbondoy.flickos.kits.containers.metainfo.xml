<?xml version="1.0" encoding="UTF-8"?>
<!-- A FlickOS kit is an AppStream add-on of the Tool Kits window
     (docs/design/flickos-dev.md, ADR-001 and ADR-002): Software lists add-ons
     that extend flickos-kits.desktop under Developer Tools, and FlickOS::kit
     names the kit. The category is a custom value because appstreamcli
     ignores an X-FlickOS-* category. -->
<component type="addon">
  <id>io.github.dvbondoy.flickos.kits.containers</id>
  <extends>flickos-kits.desktop</extends>
  <name>Containers</name>
  <summary>Podman and Distrobox, without a daemon running</summary>
  <description>
    <p>
      Rootless containers with Podman (the docker command works through it) and
      Distrobox, which runs another system, such as a newer Debian, with your
      home folder inside it.
    </p>
    <p>
      No container runs until you start one. Podman's network helper for DHCP
      networks stays off unless you turn it on, which almost nobody needs.
    </p>
  </description>
  <icon type="stock">utilities-terminal</icon>
  <url type="homepage">https://flickos.org/</url>
  <developer id="io.github.dvbondoy">
    <name>FlickOS</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <custom>
    <value key="FlickOS::kit">containers</value>
    <value key="FlickOS::kit-category">development</value>
  </custom>
</component>
