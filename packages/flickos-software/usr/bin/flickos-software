LANG_ATTR = "{http://www.w3.org/XML/1998/namespace}lang"


class SoftwareError(Exception):
    """An expected failure, with a message for the user."""


def warn(message):
    print(f"{NAME}: {message}", file=sys.stderr)


# --- Files ---------------------------------------------------------------------------

def cache_dir():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "flickos", "software")


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        raise SoftwareError("XDG_RUNTIME_DIR is not set")
    return os.path.join(base, "flickos")


def write_atomic(path, data, mode=None):
    """Write text or bytes to path through a temporary file and a rename."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    temp = f"{path}.{os.getpid()}.{threading.get_ident()}.tmp"
    try:
        with open(temp, "wb" if isinstance(data, bytes) else "w",
                  **({} if isinstance(data, bytes) else {"encoding": "utf-8"})) as f:
            f.write(data)
        if mode is not None:
            os.chmod(temp, mode)
        os.replace(temp, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(temp)


def home_dir(variable, *default):
    return os.environ.get(variable) or os.path.join(os.path.expanduser("~"), *default)


def config_home():
    return home_dir("XDG_CONFIG_HOME", ".config")


def state_home():
    return home_dir("XDG_STATE_HOME", ".local", "state")


# --- The setting: apps with a price (ADR-007) ---------------------------------------

def user_conf():
    return os.path.join(config_home(), "flickos", "software")


def read_choice(path):
    """Paid= of one file: on, off, or None when it isn't set. A file that
    can't be read, or a value that isn't one, counts as absent (SET-4)."""
    ini = configparser.ConfigParser(interpolation=None)
    try:
        ini.read(path, encoding="utf-8")
        value = ini.get(SECTION, PAID_NAME, fallback="").strip().lower()
    except (configparser.Error, UnicodeDecodeError) as error:
        warn(f"{path}: {error}")
        return None
    if value and value not in CHOICES:
        warn(f"{path}: {PAID_NAME}={value} isn't on or off; left out")
        return None
    return value or None


def paid_setting():
    """(on or off, whether the user chose it): the user's file over the
    system's, over PAID_DEFAULT."""
    chosen = read_choice(user_conf())
    return chosen or read_choice(SYSTEM_CONF) or PAID_DEFAULT, chosen is not None


def set_paid(value):
    """`paid set VALUE`: write the user's choice (default removes it, so the
    system's applies again) and record the change. Returns the value in force."""
    value = value.lower()
    if value not in CHOICES + (DEFAULT_CHOICE,):
        raise SoftwareError(f"{PAID}: on, off or {DEFAULT_CHOICE}")
    before = paid_setting()[0]
    path = user_conf()
    ini = configparser.ConfigParser(interpolation=None)
    ini.optionxform = str
    with contextlib.suppress(configparser.Error, UnicodeDecodeError):
        ini.read(path, encoding="utf-8")
    if not ini.has_section(SECTION):
        ini.add_section(SECTION)
    for existing in list(ini[SECTION]):
        if existing.lower() == PAID_NAME.lower():
            ini.remove_option(SECTION, existing)
    if value != DEFAULT_CHOICE:
        ini[SECTION][PAID_NAME] = value
    try:
        if ini[SECTION]:
            lines = ["# Software's choices (flickos-software). Change them with: flickos-software paid set on|off",
                     "# VALUE default puts the system's back. The window's menu does the same.",
                     f"[{SECTION}]"]
            lines += [f"{key}={item}" for key, item in ini[SECTION].items()]
            write_atomic(path, "\n".join(lines) + "\n")
        else:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(path)
    except OSError as error:
        raise SoftwareError(f"{path} can't be written: {error}") from None
    after, chosen = paid_setting()
    record(PAID, before, after if chosen else DEFAULT_CHOICE)
    return after


# --- Hooks (docs/design/flickos-hooks.md) ---------------------------------------
# The user's own programs in ~/.config/flickos/hooks/EVENT.d/, run by
# flickos-hooks. `changed` carries what History records (owner, key, old, new),
# but only once the change is applied (ADR-007): record() queues it, History on
# or off, and fire_changed() fires the queue when the command is done (main) or
# a daemon or window has applied it. Only the keys changed_key() allows fire:
# a key History records isn't promised to scripts until it is added there.
CHANGED = []


def fire(event, **values):
    """Run the user's hooks for event (docs/design/flickos-hooks.md, ADR-004).
    Never waits for them and never fails: with no hook it is one failed
    listdir, and `setsid -f` returns as soon as flickos-hooks has forked. A
    change made by a hook doesn't fire again (FLICKOS_HOOK)."""
    if os.environ.get("FLICKOS_PLAIN") or os.environ.get("FLICKOS_HOOK"):
        return
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    with contextlib.suppress(OSError):
        if os.listdir(os.path.join(config, "flickos", "hooks", event + ".d")):
            import subprocess
            env = {**os.environ, **{"FLICKOS_" + key.upper(): str(value) for key, value in values.items()}}
            subprocess.run(["setsid", "-f", "flickos-hooks", "run", event], env=env, stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def changed_key(key):
    """Whether a change of key fires `changed` (the allow list, ADR-007)."""
    return key == PAID


def queue_changed(key, old, new):
    """record()'s change, kept for the `changed` hooks until it is applied."""
    if changed_key(key):
        CHANGED.append((key, str(old), str(new)))


def fire_changed():
    """The queued changes' `changed` hooks, oldest first. Call it once they are
    applied; without changes it does nothing."""
    while CHANGED:
        key, old, new = CHANGED.pop(0)
        fire("changed", owner=HISTORY_OWNER, key=key, old=old, new=new)


# --- History ------------------------------------------------------------------------
# One JSON line per change, appended. The format is shared with flickos-control
# and the other owners (docs/design/flickos-history.md).

def history_enabled():
    enabled = True
    for path in (HISTORY_CONF, os.path.join(config_home(), "flickos", "history")):
        ini = configparser.ConfigParser(interpolation=None)
        try:
            ini.read(path, encoding="utf-8")
            value = ini.get("History", "Enabled", fallback=None)
        except (configparser.Error, UnicodeDecodeError):
            continue
        if value is not None:
            enabled = value.strip().lower() not in ("no", "false", "off", "0")
    return enabled


def record(key, old, new):
    """Add a change to the history. It never stops the change itself: a
    history that can't be written is only a warning."""
    if old == new:
        return
    queue_changed(key, old, new)        # for the hooks, History on or off (ADR-007)
    if not history_enabled():
        return
    now = time.time_ns()
    when = datetime.datetime.fromtimestamp(now / 1e9).astimezone().isoformat(timespec="seconds")
    entry = {"v": 1, "id": str(now), "time": when, "owner": HISTORY_OWNER, "key": key, "old": old, "new": new}
    folder = os.path.join(state_home(), "flickos")
    try:
        os.makedirs(folder, mode=0o700, exist_ok=True)
        with open(os.path.join(folder, HISTORY_LOCK), "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            path = os.path.join(folder, HISTORY_FILE)
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a", encoding="utf-8") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
                size = os.fstat(f.fileno()).st_size
            if size > HISTORY_BYTES:
                trim_history(path)
    except OSError as error:
        warn(f"the history can't be written: {error}")


def trim_history(path):
    """Keep the newest lines that fit in half of HISTORY_BYTES (under the lock)."""
    with open(path, encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    kept, size = [], 0
    for line in reversed(lines):
        size += len(line.encode())
        if size > HISTORY_BYTES // 2:
            break
        kept.append(line)
    write_atomic(path, "".join(reversed(kept)), mode=0o600)


@contextlib.contextmanager
def single_instance():
    """Yields True for the first window of the session, False while one is open."""
    folder = runtime_dir()
    os.makedirs(folder, exist_ok=True)
    with open(os.path.join(folder, LOCK), "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        yield True


def mtime(path):
    try:
        return int(os.stat(path).st_mtime)
    except OSError:
        return 0


def newest(folder):
    """The newest mtime in a folder (following links), 0 when it is empty or missing."""
    try:
        names = os.listdir(folder)
    except OSError:
        return 0
    return max((mtime(os.path.join(folder, name)) for name in names), default=0)


# --- Text ----------------------------------------------------------------------------

def languages():
    """The user's languages for catalog text, best first, as ll_CC and ll
    (LANGUAGE, then LC_ALL, LC_MESSAGES or LANG)."""
    found = []
    values = (os.environ.get("LANGUAGE") or "").split(":")
    values.append(os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "")
    for value in values:
        value = value.split(".")[0].split("@")[0].replace("-", "_")
        if not value or value in ("C", "POSIX"):
            continue
        for name in (value, value.split("_")[0]):
            if name not in found:
                found.append(name)
    return found


def best(elements, langs):
    """Of elements that are translations of each other, the one in the best of
    langs, else the untranslated one (no xml:lang), else None."""
    chosen, rank = None, len(langs) + 1
    for element in elements:
        lang = element.get(LANG_ATTR)
        if lang is None:
            r = len(langs)
        else:
            lang = lang.replace("-", "_")
            if lang not in langs:
                continue
            r = langs.index(lang)
        if r < rank:
            chosen, rank = element, r
    return chosen


def tidy(text):
    return " ".join((text or "").split())


def paragraphs(element):
    """An AppStream <description> as plain paragraphs; list items as "• item"
    (numbered for <ol>). Untranslated children only: the caller picked the
    description element in the right language."""
    out = []
    for child in element:
        if child.get(LANG_ATTR) is not None:
            continue
        if child.tag == "p":
            text = tidy("".join(child.itertext()))
            if text:
                out.append(text)
        elif child.tag in ("ul", "ol"):
            items = [tidy("".join(li.itertext())) for li in child if li.tag == "li" and li.get(LANG_ATTR) is None]
            for number, item in enumerate((i for i in items if i), 1):
                out.append(f"{number}. {item}" if child.tag == "ol" else f"• {item}")
    return out


def description_paragraphs(markup):
    """paragraphs() for a description given as markup (libappstream's)."""
    if not markup:
        return []
    try:
        return paragraphs(ET.fromstring(f"<description>{markup}</description>"))
    except ET.ParseError:
        return [tidy(re.sub(r"<[^>]+>", " ", markup))]


def fold(text):
    """Text for search: case and accents folded."""
    text = unicodedata.normalize("NFKD", text.casefold())
    return "".join(c for c in text if not unicodedata.combining(c))


def human_size(count):
    """Bytes in the decimal units GLib and Debian use (CLI only; the window uses GLib)."""
    for unit, size in (("GB", 1e9), ("MB", 1e6), ("kB", 1e3)):
        if count >= size:
            return f"{count / size:.1f} {unit}"
    return f"{count} bytes"


def runtime_name(ref):
    """What a Flathub ref brings, in words ("the GNOME runtime"); None for the
    app itself, translations and debug parts."""
    parts = ref.split("/")
    if len(parts) < 2 or parts[0] != "runtime":
        return None
    name = parts[1]
    if name.endswith((".Locale", ".Debug", ".Sources")):
        return None
    for prefix, words in RUNTIME_NAMES:
        if name.startswith(prefix):
            return words
    return name


# --- Reading the catalogs ------------------------------------------------------------

def flathub_catalog():
    """Path of Flathub's catalog (the unpacked one when there), or None."""
    for name in ("appstream.xml", "appstream.xml.gz"):
        path = os.path.join(FLATHUB_CATALOG, name)
        if os.path.exists(path):
            return path
    return None


def flathub_configured():
    """True while the system installation has the Flathub remote (and flatpak)."""
    try:
        with open(os.path.join(FLATPAK_SYSTEM, "repo", "config"), encoding="utf-8") as f:
            return f'[remote "{FLATHUB}"]' in f.read()
    except OSError:
        return False


def pick_image(images, width=SHOT_WIDTH):
    """The image URL whose width is closest to width; source images last."""
    def distance(image):
        try:
            w = int(image[0])
        except (TypeError, ValueError):
            return 100_000
        return abs(w - width)
    usable = [i for i in images if i[1]]
    return min(usable, key=distance)[1] if usable else None


def flathub_apps(path, langs):
    """(row, page) for each desktop app in Flathub's catalog. Rows have no
    "src" key yet: flathub_source() is merged in by merge()."""
    opener = gzip.open if path.endswith(".gz") else open
    with opener(path, "rb") as f:
        for _event, el in ET.iterparse(f, events=("end",)):
            if el.tag != "component":
                continue
            if el.get("type") in APP_TYPES:
                with contextlib.suppress(ValueError):
                    yield flathub_component(el, langs)
            el.clear()


def flathub_component(el, langs):
    app_id = tidy(el.findtext("id"))
    bundle = el.find("bundle")
    if not app_id or bundle is None or not (bundle.text or "").startswith("app/"):
        raise ValueError(app_id)
    name = best(el.findall("name"), langs)
    summary = best(el.findall("summary"), langs)
    # The theme's icon by name, then the catalog's own file ("flathub:" is
    # relative to its icons folder), then a download only when there is none.
    icons, stock = [], None
    for icon in el.findall("icon"):
        kind, text = icon.get("type"), tidy(icon.text)
        if not text or icon.get("scale") not in (None, "1"):
            continue
        if kind == "stock":
            stock = text
        elif kind == "cached" and icon.get("width") in ("64", "128"):
            icons.append((0 if icon.get("width") == "64" else 1, f"flathub:{icon.get('width')}x{icon.get('height')}/{text}"))
        elif kind == "remote":
            icons.append((2, f"url:{text}"))
    icons = sorted(icons)[:1]
    icons = ([f"stock:{stock}"] if stock else []) + [i for _, i in icons]
    # Keywords come as one <keywords> per language, or (older catalogs) one
    # <keywords> whose <keyword>s each have a language.
    keywords = best(el.findall("keywords"), langs)
    words = []
    if keywords is not None:
        ranked = {}
        for k in keywords.findall("keyword"):
            lang = (k.get(LANG_ATTR) or "").replace("-", "_")
            rank = len(langs) if not lang else langs.index(lang) if lang in langs else None
            if rank is not None:
                ranked.setdefault(rank, []).append(tidy(k.text))
        words = ranked[min(ranked)] if ranked else []
    launch = [tidy(l.text) for l in el.findall("launchable") if l.get("type") == "desktop-id" and l.text]
    provides = [tidy(p.text) for p in el.findall("provides/id") if p.text]
    description = best(el.findall("description"), langs)
    shots = []
    for shot in el.findall("screenshots/screenshot"):
        images = [(i.get("width"), tidy(i.text)) for i in shot.findall("image")
                  if i.get("type") == "thumbnail" and i.get("scale") in (None, "1")]
        images = images or [(i.get("width"), tidy(i.text)) for i in shot.findall("image")]
        url = pick_image(images)
        if url:
            caption = best(shot.findall("caption"), langs)
            shots.append({"url": url, "caption": tidy(caption.text) if caption is not None else ""})
        if len(shots) >= SHOTS:
            break
    developer = best(el.findall("developer/name"), langs)
    releases = [r for r in el.findall("releases/release") if r.get("type") in (None, "stable")]
    release = max(releases, key=lambda r: int(r.get("timestamp") or 0), default=None)
    row = {
        "id": app_id,
        "name": tidy(name.text) if name is not None else app_id,
        "summary": tidy(summary.text) if summary is not None else "",
        "icons": icons,
        "cats": [tidy(c.text) for c in el.findall("categories/category") if c.text],
        "kw": [w for w in words if w][:KEYWORDS],
        "launch": launch,
        "provides": provides,
        "ref": tidy(bundle.text),
        "runtime": bundle.get("runtime") or "",
    }
    page = {
        "desc": paragraphs(description) if description is not None else [],
        "shots": shots,
        "dev": tidy(developer.text) if developer is not None else tidy(el.findtext("developer_name")),
        "license": tidy(el.findtext("project_license")),
        "home": next((tidy(u.text) for u in el.findall("url") if u.get("type") == "homepage"), ""),
        "version": release.get("version", "") if release is not None else "",
        "date": int(release.get("timestamp") or 0) if release is not None else 0,
    }
    return row, page


def apt_source(origin):
    """The apt source (APT_SOURCES) of a catalog origin."""
    return next((source for pattern, source in APT_ORIGINS if pattern.match(origin or "")), "debian")


def debian_apps():
    """(row, page) for each desktop app in the apt sources' catalogs (Debian's
    and FlickOS's), through libappstream and the system cache; each row's
    "origin" names its catalog. Nothing (and a warning) without libappstream."""
    try:
        import gi
        gi.require_version("AppStream", "1.0")
        from gi.repository import AppStream, GLib
    except (ImportError, ValueError) as error:
        warn(f"Debian's apps are left out: libappstream is not available ({error})")
        return
    pool = AppStream.Pool()
    pool.set_flags(AppStream.PoolFlags.LOAD_OS_CATALOG)
    try:
        pool.load(None)
    except GLib.Error as error:
        warn(f"Debian's apps are left out: {error.message}")
        return
    seen = set()
    found = [(c, None, None) for c in pool.get_components_by_kind(AppStream.ComponentKind.DESKTOP_APP).as_array()]
    for component in pool.get_components_by_kind(AppStream.ComponentKind.ADDON).as_array():
        style = style_of(component)
        if style and own_style(component, style):
            found.append((component, style, None))
        kit = kit_of(component)
        if kit:
            found.append((component, None, kit))
    # The store's fetched catalog last: the pool's copy (with a key) wins.
    found += [(c, None, None) for c in store_components(AppStream)]
    for component, style, kit in found:
        app_id = component.get_id()
        package = component.get_pkgname()
        key = (apt_source(component.get_origin()), app_id)
        if not app_id or not package or key in seen:
            continue
        seen.add(key)
        yield debian_component(AppStream, component, style, kit)


def store_catalog():
    """The fetched store catalog's path, or None."""
    path = os.path.join(cache_dir(), STORE_CATALOG)
    return path if os.path.exists(path) else None


def store_components(AppStream):
    """The desktop apps of the fetched store catalog (libappstream reads the
    gzipped DEP-11 itself, about 20 ms), only those whose origin is a store's."""
    path = store_catalog()
    if path is None:
        return []
    from gi.repository import Gio, GLib
    reader = AppStream.Metadata()
    reader.set_format_style(AppStream.FormatStyle.CATALOG)
    try:
        reader.parse_file(Gio.File.new_for_path(path), AppStream.FormatKind.YAML)
    except GLib.Error as error:
        warn(f"the FlickOS Store's apps are left out: {error.message}")
        return []
    return [c for c in reader.get_components().as_array()
            if c.get_kind() == AppStream.ComponentKind.DESKTOP_APP and STORE_ORIGIN.match(c.get_origin() or "")]


def style_of(addon):
    """The style folder an add-on component names, or None: only add-ons of
    the layout chooser with a style id (ADR-006) are styles."""
    style = addon.get_custom_value(STYLE_KEY)
    if STYLE_EXTENDS in (addon.get_extends() or []) and style and re.fullmatch(r"[a-z0-9][a-z0-9_-]*", style):
        return style
    return None


def kit_of(addon):
    """The kit an add-on of the Tool Kits window names, or None: it extends
    KIT_EXTENDS, names a kit and a known category, and is the package
    flickos-kit-NAME of FlickOS's own sources (a kit installs system packages;
    community apps can't)."""
    kit = addon.get_custom_value(KIT_KEY)
    category = KIT_CATEGORIES.get(addon.get_custom_value(KIT_CATEGORY_KEY) or "")
    if (KIT_EXTENDS in (addon.get_extends() or []) and category and kit and re.fullmatch(r"[a-z0-9][a-z0-9_-]*", kit)
            and (addon.get_pkgname() or "") == KIT_PREFIX + kit and apt_source(addon.get_origin()) != "community"):
        return kit
    return None


def layout_of(component):
    """The layout a FlickOS style package brings too, or None (LAYOUT_KEY)."""
    layout = component.get_custom_value(LAYOUT_KEY)
    if layout and re.fullmatch(r"[a-z0-9][a-z0-9_-]*", layout) and apt_source(component.get_origin()) != "community":
        return layout
    return None


def own_style(component, style):
    """Is the style an add-on names its own package's? A community package's
    style folder is its package's name (repo/community/check.py), so one that
    names another style (dark, another developer's) would get Try and Use for
    that style under its own name. FlickOS's packages name their own."""
    return apt_source(component.get_origin()) != "community" or style == component.get_pkgname()


def debian_component(AppStream, c, style=None, kit=None):
    """(row, page) from one libappstream component (also called by the tests
    with a stand-in). style: the style folder of a style's add-on; kit: the
    name of a kit's."""
    icons, later = [], []
    for icon in c.get_icons() or []:
        kind = icon.get_kind()
        if kind == AppStream.IconKind.STOCK and icon.get_name():
            icons.append(f"stock:{icon.get_name()}")
        elif kind == AppStream.IconKind.CACHED and icon.get_filename():
            later.insert(0, f"file:{icon.get_filename()}")
        elif kind == AppStream.IconKind.REMOTE and icon.get_url():
            later.append(f"url:{icon.get_url()}")
    launchable = c.get_launchable(AppStream.LaunchableKind.DESKTOP_ID)
    shots = []
    for shot in c.get_screenshots_all() or []:
        images = [(image.get_width(), image.get_url()) for image in shot.get_images_all() or []
                  if image.get_scale() in (0, 1)]
        url = pick_image(images)
        if url:
            shots.append({"url": url, "caption": tidy(shot.get_caption())})
        if len(shots) >= SHOTS:
            break
    releases = c.get_releases_plain()
    release = None
    if releases is not None:
        entries = [releases.index_safe(i) for i in range(releases.get_size())]
        entries = [r for r in entries if r is not None]
        release = max(entries, key=lambda r: r.get_timestamp() or 0, default=None)
    developer = c.get_developer()
    row = {
        "id": c.get_id(),
        "name": tidy(c.get_name()) or c.get_id(),
        "summary": tidy(c.get_summary()),
        "icons": icons + later,
        "cats": list(c.get_categories() or []),
        "kw": [tidy(k) for k in (c.get_keywords() or []) if k][:KEYWORDS],
        "launch": list(launchable.get_entries() or []) if launchable is not None else [],
        "provides": [],
        "pkg": c.get_pkgname(),
        "origin": c.get_origin() or "",
    }
    if kit:
        row["cats"], row["kit"] = [KIT_CATEGORIES[c.get_custom_value(KIT_CATEGORY_KEY)]], kit
    if style:
        row["cats"], row["style"] = [STYLE_CATEGORY], style
        layout = layout_of(c)
        if layout:
            row["layout"] = layout
    page = {
        "desc": description_paragraphs(c.get_description()),
        "shots": shots,
        "dev": tidy(developer.get_name()) if developer is not None else "",
        "license": tidy(c.get_project_license()),
        "home": tidy(c.get_url(AppStream.UrlKind.HOMEPAGE)),
        "version": release.get_version() or "" if release is not None else "",
        "date": int(release.get_timestamp() or 0) if release is not None else 0,
    }
    return row, page


def keys_of(row):
    """Every name an app is known by, folded: its ID and desktop IDs, with and
    without ".desktop"."""
    keys = set()
    for name in [row["id"], *row.get("launch", ()), *row.get("provides", ())]:
        name = name.casefold()
        keys.add(name)
        if name.endswith(".desktop"):
            keys.add(name[:-len(".desktop")])
    return keys


def merge(sources):
    """One list of apps from each source's (row, page offset) pairs, {source:
    [...]}: an app in more than one gets each of them (ADR-002), the first in
    SOURCES names it. Each app is {id, name, summary, icons, cats, kw, keys,
    src: {source: {pkg or id and ref, launch, page}}}."""
    apps, by_key = [], {}
    for name in SOURCES:
        for row, at in sources.get(name, ()):
            if name == "flathub":
                source = {"id": row["id"], "ref": row["ref"], "launch": row["launch"][:1], "page": at}
            else:
                source = {"pkg": row["pkg"], "launch": row["launch"][:1], "page": at}
            wanted = ([SAME_APPS[row["id"]].casefold()] if name == "flathub" and row["id"] in SAME_APPS
                      else sorted(keys_of(row)))
            match = next((by_key[k] for k in wanted if k in by_key and name not in by_key[k]["src"]), None)
            if match is not None:
                match["src"][name] = source
                match["cats"] = match["cats"] + [c for c in row["cats"] if c not in match["cats"]]
                match["keys"] = sorted(set(match["keys"]) | keys_of(row))
                match["kw"] = list(dict.fromkeys(match["kw"] + row["kw"]))[:2 * KEYWORDS]
                # Another source's icon file before any download: trixie's catalog
                # names icons appstream.debian.org has since replaced (404, 2026-10).
                local = [i for i in match["icons"] + row["icons"] if not i.startswith("url:")]
                match["icons"] = list(dict.fromkeys(local + [i for i in match["icons"] if i.startswith("url:")]))
                continue
            app = {k: row[k] for k in ("id", "name", "summary", "icons", "cats", "kw")}
            if row.get("kit"):
                app["kit"] = row["kit"]
            if row.get("style"):
                app["style"] = row["style"]
            if row.get("layout"):
                app["layout"] = row["layout"]
            app["src"] = {name: source}
            app["keys"] = sorted(keys_of(row))
            apps.append(app)
            for key in app["keys"]:
                by_key.setdefault(key, app)
    apps.sort(key=lambda a: fold(a["name"]))
    return apps


def stamps():
    """What the index was built from: changes when a catalog or the language does."""
    return {
        "lang": languages()[:1],
        "debian": max(newest(SWCATALOG_YAML), newest(SWCATALOG_CACHE)),
        "flathub": mtime(os.path.join(FLATHUB_CATALOG, "appstream.xml.gz")) if flathub_usable() else 0,
        STORE: mtime(os.path.join(cache_dir(), STORE_CATALOG)),
    }


def flathub_usable():
    """Flathub is a source while flatpak is installed and has the remote."""
    return bool(shutil.which("flatpak")) and flathub_configured()


def fetch_needed():
    """The catalogs `refresh` should fetch: Debian's while there is none
    (installed systems get apt's lists every day; the live image has none),
    Flathub's while there is none or it wasn't checked for REFRESH_DAYS."""
    needed = []
    if not newest(SWCATALOG_YAML):
        needed.append("debian")
    if flathub_usable():
        # flatpak touches .timestamp at every check, also when nothing changed.
        checked = max(mtime(os.path.join(os.path.dirname(FLATHUB_CATALOG), ".timestamp")),
                      mtime(os.path.join(FLATHUB_CATALOG, "appstream.xml.gz")))
        if not flathub_catalog() or checked < time.time() - REFRESH_DAYS * 86400:
            needed.append("flathub")
    return needed


def build_index(folder=None, debian=None, flathub=None):
    """Read the catalogs and write index.json and a new pages file into folder
    (the cache). debian: the apt sources' (row, page) iterable, rows with
    their "origin"; flathub: Flathub's (for the tests). Returns the number of
    apps per source."""
    folder = folder or cache_dir()
    os.makedirs(folder, exist_ok=True)
    langs = languages()
    if debian is None:
        debian = debian_apps()
    if flathub is None:
        path = flathub_catalog() if flathub_usable() else None
        flathub = flathub_apps(path, langs) if path else ()
    pages_name = PAGES.format(time.time_ns())
    pages_path = os.path.join(folder, pages_name)
    temp = pages_path + ".tmp"
    sources = {source: [] for source in SOURCES}
    with open(temp, "w", encoding="utf-8") as pages:
        for apt, items in ((True, debian), (False, flathub)):
            for row, page in items:
                source = apt_source(row.get("origin")) if apt else "flathub"
                sources[source].append((row, pages.tell()))
                pages.write(json.dumps(page, ensure_ascii=False, separators=(",", ":")) + "\n")
    os.replace(temp, pages_path)
    counts = {source: len(rows) for source, rows in sources.items()}
    apps = merge(sources)
    index = {"v": INDEX_VERSION, "stamps": stamps(), "pages": pages_name, "apps": apps}
    write_atomic(os.path.join(folder, INDEX), json.dumps(index, ensure_ascii=False, separators=(",", ":")))
    # Older pages files go: a window that still reads one keeps it open, and
    # an open file stays readable after it is deleted.
    for name in os.listdir(folder):
        if name.startswith("pages-") and name.endswith((".jsonl", ".tmp")) and name != pages_name:
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(folder, name))
    prune_images(os.path.join(folder, "images"))
    counts["apps"] = len(apps)
    return counts


def prune_images(folder, days=IMAGE_DAYS):
    """Delete downloaded icons and screenshots older than days."""
    limit = time.time() - days * 86400
    try:
        names = os.listdir(folder)
    except OSError:
        return
    for name in names:
        path = os.path.join(folder, name)
        with contextlib.suppress(OSError):
            if os.stat(path).st_mtime < limit:
                os.unlink(path)


# --- The front page's shelves (featured.json) -----------------------------------------

def parse_featured(text):
    """[{id, name, apps: [{id, …}]}] from featured.json's text; ValueError when
    it isn't one of this version's. Unknown keys are ignored."""
    data = json.loads(text)
    if not isinstance(data, dict) or data.get("v") != FEATURED_VERSION or not isinstance(data.get("shelves"), list):
        raise ValueError("not a featured.json of this version")
    shelves = []
    for shelf in data["shelves"]:
        if not isinstance(shelf, dict) or not isinstance(shelf.get("id"), str) \
                or not isinstance(shelf.get("name"), str) or not isinstance(shelf.get("apps", []), list):
            raise ValueError(f"a shelf isn't {{id, name, apps}}: {shelf!r:.80}")
        apps = []
        for entry in shelf.get("apps", []):
            entry = {"id": entry} if isinstance(entry, str) else entry
            if isinstance(entry, dict) and isinstance(entry.get("id"), str) and entry["id"]:
                apps.append(entry)
        shelves.append({"id": shelf["id"], "name": tidy(shelf["name"]), "apps": apps})
    return shelves


def parse_paid(text):
    """{app ID: {price, buy, product or None}} from featured.json's text (a
    usable one: parse_featured). An entry without a price, with a buy address
    that isn't https://, or with an odd product is left out with a warning."""
    paid = json.loads(text).get("paid", {})
    if not isinstance(paid, dict):
        warn("featured.json: paid isn't an object; left out")
        return {}
    found = {}
    for app_id, entry in paid.items():
        if not app_id or not isinstance(entry, dict):
            warn(f"featured.json: the price of {app_id!r:.40} isn't an object; left out")
            continue
        price = tidy(entry["price"]) if isinstance(entry.get("price"), str) else ""
        buy = entry.get("buy") if isinstance(entry.get("buy"), str) else ""
        product = entry.get("product")
        try:
            host = urllib.parse.urlsplit(buy).hostname
        except ValueError:
            host = None
        if not price or len(price) > PRICE_CHARS:
            problem = "no price" if not price else f"a price longer than {PRICE_CHARS} characters"
        elif not buy.startswith("https://") or not host or any(c.isspace() for c in buy):
            problem = "a buy address that isn't https://"
        elif product is not None and not (isinstance(product, str) and PRODUCT_NAME.fullmatch(product)):
            problem = "a product that isn't a store's product name"
        else:
            found[app_id] = {"price": price, "buy": buy, "product": product}
            continue
        warn(f"featured.json: {app_id:.40} has {problem}; left out")
    return found


def load_featured(folder=None):
    """(shelves, paid) of the newest usable featured.json: the fetched copy
    in the cache, else the package's. ([], {}) when neither can be read."""
    for path in (os.path.join(folder or cache_dir(), FEATURED), FEATURED_FILE):
        try:
            with open(path, encoding="utf-8") as f:
                text = f.read()
            return parse_featured(text), parse_paid(text)
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as error:
            warn(f"{path} is left out: {error}")
    return [], {}


def read_featured(folder=None):
    """The newest usable shelves (load_featured)."""
    return load_featured(folder)[0]


def featured_stale(folder=None):
    """True when featured.json wasn't fetched for FEATURED_HOURS (or ever)."""
    path = os.path.join(folder or cache_dir(), FEATURED)
    return mtime(path) < time.time() - FEATURED_HOURS * 3600


def fetch_featured(folder=None, url=None):
    """Download featured.json into the cache (only a usable one replaces the
    copy there); True when the shelves changed. A plain GET with nothing about
    the user (ADR-009). Raises OSError or ValueError."""
    url = url or FEATURED_URL
    request = urllib.request.Request(url, headers={"User-Agent": "FlickOS-Software"})
    with urllib.request.urlopen(request, timeout=FETCH_SECONDS) as response:
        data = response.read(FEATURED_BYTES + 1)
    if len(data) > FEATURED_BYTES:
        raise ValueError(f"{url} is larger than {FEATURED_BYTES} bytes")
    text = data.decode("utf-8")
    parse_featured(text)
    path = os.path.join(folder or cache_dir(), FEATURED)
    try:
        with open(path, encoding="utf-8") as f:
            changed = f.read() != text
    except OSError:
        changed = True
    # Written also when it is the same: its time says when it was checked.
    write_atomic(path, text)
    return changed


def flickos_release():
    """The Debian release FlickOS is built on (FLICKOS_DEBIAN), or None."""
    for path, name in ((FLICKOS_RELEASE, "FLICKOS_DEBIAN"), (OS_RELEASE, "VERSION_CODENAME")):
        with contextlib.suppress(OSError, UnicodeDecodeError), open(path, encoding="utf-8") as f:
            for line in f:
                match = re.fullmatch(rf'{name}="?([a-z]+)"?', line.strip())
                if match:
                    return match.group(1)
    return None


def read_purchases(path=None):
    """(the store's products this computer's key holds, whether its key was
    turned off) from PURCHASES_FILE: (frozenset(), False) without a key."""
    try:
        with open(path or PURCHASES_FILE, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return frozenset(), False
    if not isinstance(data, dict) or data.get("v") != 1:
        return frozenset(), False
    if data.get("status") == "revoked":
        return frozenset(), True
    products = data.get("products") if data.get("status") == "valid" else None
    if not isinstance(products, list):
        return frozenset(), False
    return frozenset(p for p in products if isinstance(p, str) and PRODUCT_NAME.fullmatch(p)), False


def key_shaped(text):
    """Whether text can be a store key (flickos-control checks it again):
    case, spaces and dashes don't matter."""
    plain = re.sub(r"[\s-]", "", text or "").lower()
    return len(plain) == KEY_CHARS and re.fullmatch(r"[a-z2-7]+", plain) is not None


def live_session(path=None):
    """The live image (boot=live): a key added there is lost at shutdown."""
    try:
        with open(path or CMDLINE, encoding="utf-8") as f:
            return "boot=live" in f.read().split()
    except OSError:
        return False


def claim_address(buy, code):
    """Buy…'s address with the claim code in its fragment, which the browser
    never sends to a server (ADR-011)."""
    return buy.split("#", 1)[0] + "#claim=" + code


def store_catalog_stale(folder=None):
    """True when the store's catalog wasn't fetched for FEATURED_HOURS (or ever)."""
    return mtime(os.path.join(folder or cache_dir(), STORE_CHECKED)) < time.time() - FEATURED_HOURS * 3600


def check_store_catalog(data):
    """ValueError unless data is a gzipped DEP-11 file of a store
    (STORE_ORIGIN, the release's), within STORE_CATALOG_BYTES."""
    try:
        with gzip.GzipFile(fileobj=io.BytesIO(data)) as packed:
            text = packed.read(STORE_CATALOG_BYTES + 1)
    except (OSError, EOFError) as error:
        raise ValueError(f"the store's catalog isn't gzip ({error})") from None
    if len(text) > STORE_CATALOG_BYTES:
        raise ValueError(f"the store's catalog is larger than {STORE_CATALOG_BYTES} bytes")
    header = text[:400].decode("utf-8", "replace")
    origin = re.search(r"^Origin: (\S+)$", header, re.M)
    if not header.startswith("---\nFile: DEP-11\n") or not origin or not STORE_ORIGIN.match(origin.group(1)):
        raise ValueError("the store's catalog isn't a FlickOS Store DEP-11 file")


def fetch_store_catalog(folder=None, url=None):
    """Download the store's catalog into the cache (only a usable one
    replaces the copy there); True when it changed. A plain GET with nothing
    about the user (ADR-009). Raises OSError or ValueError."""
    if url is None:
        release = flickos_release()
        if release is None:
            raise ValueError(f"the Debian release isn't known ({FLICKOS_RELEASE})")
        url = STORE_CATALOG_URL.format(release=release)
    request = urllib.request.Request(url, headers={"User-Agent": "FlickOS-Software"})
    with urllib.request.urlopen(request, timeout=FETCH_SECONDS) as response:
        data = response.read(STORE_CATALOG_BYTES + 1)
    if len(data) > STORE_CATALOG_BYTES:
        raise ValueError(f"{url} is larger than {STORE_CATALOG_BYTES} bytes")
    check_store_catalog(data)
    path = os.path.join(folder or cache_dir(), STORE_CATALOG)
    try:
        with open(path, "rb") as f:
            changed = f.read() != data
    except OSError:
        changed = True
    # Rewritten only when it changed: its time is the index's stamp.
    if changed:
        write_atomic(path, data)
    write_atomic(os.path.join(folder or cache_dir(), STORE_CHECKED), "")
    return changed


def fetch_shop(force=False, folder=None):
    """featured.json and the store's catalog, each when it is old (or with
    force): {"featured": changed, "store": changed}. A failure is a warning
    and counts as unchanged."""
    changed = {"featured": False, STORE: False}
    for name, stale, fetch, what in (("featured", featured_stale, fetch_featured, "The front page's shelves"),
                                     (STORE, store_catalog_stale, fetch_store_catalog, "The FlickOS Store's apps")):
        if force or stale(folder):
            try:
                changed[name] = fetch(folder)
            except (OSError, ValueError) as error:
                warn(f"{what} weren't updated: {error}")
    return changed


# --- The catalog the window and the commands read ------------------------------------

def searchable(app):
    """The folded text Catalog.search() looks in, kept in the app."""
    app["hay"] = fold(" ".join([app["name"], app["summary"], " ".join(app["kw"]), app["id"],
                                " ".join(s.get("pkg", "") for s in app["src"].values())]))
    app["fname"] = fold(app["name"])


def web_rows(known):
    """Rows like the index's for `flickos-switch webapp list --json --known`
    (phase 3b): {id: web:ENTRY for the list's web versions, made or not (its
    page stays its page), web:ID for one made from any address; src: {WEB:
    {url, webapp: Firefox's ID or None, launch}}}. Made ones first, then by
    name; anything odd is left out."""
    rows, seen = [], set()
    for item in known if isinstance(known, list) else []:
        if not isinstance(item, dict) or not all(isinstance(item.get(k), str) and item[k]
                                                 for k in ("name", "start")):
            continue
        made = item.get("made") is True and isinstance(item.get("id"), str)
        entry = item.get("entry") if isinstance(item.get("entry"), str) else None
        key = entry or (item["id"] if made else None)
        if not key or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", key) or key in seen:
            continue
        try:
            host = urllib.parse.urlsplit(item["start"]).hostname or item["start"]
        except ValueError:
            continue
        seen.add(key)
        windows = item.get("windows") if isinstance(item.get("windows"), str) else None
        icon, launcher = item.get("icon"), item.get("launcher")
        icons = [f"file:{icon}"] if made and isinstance(icon, str) and os.path.isabs(icon) else []
        launch = [launcher] if made and isinstance(launcher, str) and launcher.endswith(".desktop") else []
        rows.append({
            "id": f"web:{key}", "name": tidy(item["name"]),
            "summary": f"The web version of {windows}." if windows else f"A web app of {host}.",
            "icons": icons + [f"stock:{WEB_ICON}"], "cats": [WEB_CATEGORY],
            "kw": [w for w in (windows, host, "web app") if w],
            "src": {WEB: {"url": item["start"], "webapp": item["id"] if made else None, "launch": launch}},
            "keys": [f"web:{key}".casefold()],
        })
    rows.sort(key=lambda r: (r["src"][WEB]["webapp"] is None, fold(r["name"])))
    return rows


def web_address(text):
    """An address typed for a new web app, with https:// when none was
    typed; None unless it is http or https with a host that has a dot."""
    text = text.strip()
    if not text or text.startswith("-") or any(c.isspace() for c in text):
        return None
    if "://" not in text:
        text = "https://" + text
    try:
        parts = urllib.parse.urlsplit(text)
        host = parts.hostname
    except ValueError:
        return None
    if parts.scheme.lower() not in ("http", "https") or not host or "." not in host.strip("."):
        return None
    return text


class Catalog:
    """The index in memory, what is installed, and the search."""

    def __init__(self, folder=None):
        self.folder = folder or cache_dir()
        self.apps = []
        self.by_key = {}
        self.indexed = 0
        self.searchable = False
        self.pages_file = None
        self.stamps = None
        self.packages = {}          # installed Debian package -> version
        self.flatpaks = set()       # installed Flathub app IDs (system installation)
        self.protected = set()      # packages never removed
        self.app_packages = frozenset()     # the apt packages of the index's apps
        self.featured = []          # read_featured()'s shelves (the window reads them with the index)
        self.priced = []            # the apps set_paid() gave a price ("paid" in the row)
        self.show_paid = True       # the setting: off hides priced apps not installed (hidden)
        self.bought = frozenset()   # the store's products this computer's key holds (phase 3c)
        self.key_off = False        # the key on this computer was turned off (a refund)

    def close(self):
        if self.pages_file:
            self.pages_file.close()
            self.pages_file = None

    @property
    def loaded(self):
        return self.stamps is not None

    def load(self):
        """Read index.json (raises SoftwareError when there is none or it's broken)."""
        path = os.path.join(self.folder, INDEX)
        try:
            with open(path, encoding="utf-8") as f:
                index = json.load(f)
            if index.get("v") != INDEX_VERSION:
                raise SoftwareError("the index is from another version")
            pages = open(os.path.join(self.folder, index["pages"]), encoding="utf-8")
        except FileNotFoundError:
            raise SoftwareError("there is no index yet") from None
        except (OSError, ValueError, KeyError, TypeError) as error:
            raise SoftwareError(f"the index can't be read ({error})") from None
        self.close()
        self.pages_file = pages
        self.apps = index["apps"]
        self.indexed = len(self.apps)       # web apps (set_web) come after the index's
        self.stamps = index.get("stamps")
        self.by_key = {}
        self.searchable = False
        for number, app in enumerate(self.apps):
            for key in app.get("keys", ()):
                self.by_key.setdefault(key, number)
            app["number"] = number
        self.app_packages = frozenset(app["src"][source]["pkg"] for app in self.apps
                                      for source in APT_SOURCES if source in app["src"])

    def prepare_search(self):
        """The folded text search() looks in (about 100 ms: the window does it
        in its loading thread, `list` never)."""
        if self.searchable:
            return
        for app in self.apps:
            searchable(app)
        self.searchable = True

    def set_web(self, rows):
        """web_rows()'s web apps after the index's apps, in place of the ones
        set before: search, find, the categories and installed() see them."""
        for app in self.apps[self.indexed:]:
            for key in app["keys"]:
                if self.by_key.get(key) == app["number"]:
                    del self.by_key[key]
        del self.apps[self.indexed:]
        for row in rows:
            app = dict(row, number=len(self.apps))
            if self.searchable:
                searchable(app)
            self.apps.append(app)
            for key in app["keys"]:
                self.by_key.setdefault(key, app["number"])

    def set_paid(self, paid):
        """featured.json's prices (parse_paid) on the apps they name, in place
        of the ones set before. Not in the index: a new price needs no rebuild.
        Web apps never have one."""
        for app in self.priced:
            app.pop("paid", None)
        self.priced = []
        for app_id, entry in paid.items():
            app = self.find(app_id)
            if app is not None and WEB not in app["src"] and "paid" not in app:
                app["paid"] = entry
                self.priced.append(app)

    def locked(self, app):
        """True when the app is FlickOS's store's and not bought: Buy… in place of Install."""
        product = app.get("paid", {}).get("product")
        return product is not None and product not in self.bought

    def hidden(self, app):
        """True when the setting is off and the app has a price, isn't
        installed and isn't bought, or when it is only in the store and has
        no price (sources): not in the search, categories or shelves."""
        if STORE in app["src"] and not self.sources(app):
            return True
        paid = app.get("paid")
        return bool(paid) and not self.show_paid and paid["product"] not in self.bought \
            and not self.installed_from(app)

    def sources(self, app):
        """The app's sources a page offers, in SOURCES' order (web apps' last).
        The store's only while featured.json gives the app a price or it is
        installed from there; while it has one, FlickOS's free version only
        while that is installed (Q12: Buy…, never the old free version)."""
        found = [source for source in (*SOURCES, WEB) if source in app["src"]]
        if STORE not in app["src"]:
            return found
        installed = self.installed_from(app)
        if installed == STORE:
            return found
        if not app.get("paid"):
            return [source for source in found if source != STORE]
        return [source for source in found if source != "flickos" or installed == "flickos"]

    def stale(self):
        """True when a catalog (or the language) changed since the index was built."""
        return not self.loaded or self.stamps != stamps()

    def find(self, name):
        """The app with this ID, package or desktop ID (folded), or None."""
        number = self.by_key.get(name.casefold())
        if number is None:
            number = self.by_key.get(name.casefold() + ".desktop")
        if number is None:
            for app in self.apps:
                if any(s.get("pkg") == name for s in app["src"].values()):
                    return app
            return None
        return self.apps[number]

    def page(self, app, source):
        """An app's page from one source: {desc, shots, dev, license, home, version, date}."""
        at = app["src"][source]["page"]
        self.pages_file.seek(at)
        try:
            return json.loads(self.pages_file.readline())
        except ValueError:
            return {"desc": [], "shots": [], "dev": "", "license": "", "home": "", "version": "", "date": 0}

    def search(self, words):
        """Apps matching every word, best first: the name as typed, a name that
        starts with it, every word in the name, the rest by name."""
        query = fold(" ".join(words).strip())
        parts = query.split()
        if not parts:
            return []
        self.prepare_search()
        found = []
        for app in self.apps:
            hay = app["hay"]
            if not all(p in hay for p in parts) or self.hidden(app):
                continue
            name = app["fname"]
            if name == query:
                rank = 0
            elif name.startswith(query):
                rank = 1
            elif all(p in name for p in parts):
                rank = 2
            else:
                rank = 3
            found.append((rank, app["number"]))
        found.sort()
        return [self.apps[number] for _, number in found]

    def category(self, category_id):
        wanted = next((c[3] for c in CATEGORIES if c[0] == category_id), None)
        if wanted is None:
            raise SoftwareError(f"no category {category_id}")
        return [app for app in self.apps if any(c in wanted for c in app["cats"]) and not self.hidden(app)]

    def category_counts(self):
        """{category ID: number of apps}, in one pass."""
        counts = dict.fromkeys((c[0] for c in CATEGORIES), 0)
        wanted = {name: c[0] for c in CATEGORIES for name in c[3]}
        for app in self.apps:
            if self.hidden(app):
                continue
            for category_id in {wanted[c] for c in app["cats"] if c in wanted}:
                counts[category_id] += 1
        return counts

    def shelves(self, featured):
        """[(shelf ID, name, [app, …])] for read_featured()'s shelves: the apps
        this catalog has, each once, at most SHELF_APPS; empty shelves left out."""
        found = []
        for shelf in featured:
            apps = []
            for entry in shelf["apps"]:
                app = self.find(entry["id"])
                if app is not None and app not in apps and not self.hidden(app):
                    apps.append(app)
            if apps:
                found.append((shelf["id"], shelf["name"], apps[:SHELF_APPS]))
        return found

    def read_installed(self):
        """What is installed now (dpkg's status, the system Flatpak folder) and
        what the key bought."""
        self.packages, depends = installed_packages()
        self.flatpaks = installed_flatpaks()
        self.protected = depends
        self.bought, self.key_off = read_purchases()

    def installed_from(self, app):
        """The source app is installed from, or None."""
        web = app["src"].get(WEB)
        if web:
            return WEB if web["webapp"] else None
        for source in APT_SOURCES:
            apt = app["src"].get(source)
            if apt and apt["pkg"] in self.packages:
                # The same package as FlickOS's free version: the store's
                # only once its key holds the product (phase 3c).
                if source == STORE and "flickos" in app["src"] and \
                        app.get("paid", {}).get("product") not in self.bought:
                    continue
                return source
        flathub = app["src"].get("flathub")
        if flathub and flathub["id"] in self.flatpaks:
            return "flathub"
        return None

    def installed(self):
        """The installed apps by name, web apps among them (set_web puts them last)."""
        return sorted((app for app in self.apps if self.installed_from(app)), key=lambda a: fold(a["name"]))

    def is_protected(self, package):
        """Never removed here: what the desktop needs, and FlickOS's packages
        but its styles, its kits and its apps (Notes: no part of the desktop
        needs it)."""
        return package in self.protected or (package.startswith(PROTECTED_PREFIXES)
                                             and not package.startswith((STYLE_PREFIX, KIT_PREFIX))
                                             and package not in self.app_packages)


def kit_note(app):
    """What a kit's page says above its description: PERMISSION for a
    security kit (ADR-S05), else None."""
    if app.get("kit") and KIT_CATEGORIES["security"] in app.get("cats", ()):
        return PERMISSION
    return None


def kit_setup_argv(app):
    """The command of an installed kit's Set Up…: the Tool Kits window on its row."""
    return [KITS, "window", "--kit", app["kit"]]


def use_args(app, how):
    """flickos-layout's arguments to try (until logout) or use a style's app;
    Use also sets the layout its package brings (ADR-014)."""
    if how == "try":
        return ("try", app["style"])
    if app.get("layout"):
        return ("set", app["layout"], "--style", app["style"])
    return ("style", "set", app["style"])


def run_layout(*args):
    """flickos-layout's output; SoftwareError with its last line when it fails."""
    try:
        done = subprocess.run([LAYOUT, *args], capture_output=True, text=True, timeout=QUERY_SECONDS)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise SoftwareError(str(error)) from None
    if done.returncode != 0:
        lines = [line.removeprefix(f"{os.path.basename(LAYOUT)}: ") for line in done.stderr.strip().splitlines()]
        raise SoftwareError(lines[-1] if lines else f"{LAYOUT} failed")
    return done.stdout


def installed_packages():
    """({installed package: version}, packages flickos-desktop Depends on), from
    dpkg-query (about 30 ms)."""
    packages, depends = {}, set()
    try:
        result = subprocess.run(DPKG_QUERY, capture_output=True, text=True, timeout=QUERY_SECONDS)
    except (OSError, subprocess.TimeoutExpired) as error:
        warn(f"can't read the installed packages ({error})")
        return packages, depends
    for line in result.stdout.splitlines():
        status, _, rest = line.partition("\t")
        name, _, rest = rest.partition("\t")
        version, _, needs = rest.partition("\t")
        if status[1:2] != "i":          # "ii", "hi": installed; "rc", "un": not
            continue
        packages[name] = version
        if name == DESKTOP_PACKAGE:
            for alternative in re.split(r"[,|]", needs):
                needed = re.sub(r"[\s(:].*", "", alternative.strip())
                if needed:
                    depends.add(needed)
    return packages, depends


def installed_flatpaks(folder=None):
    """IDs of the apps in the system Flatpak installation."""
    folder = os.path.join(folder or FLATPAK_SYSTEM, "app")
    try:
        names = os.listdir(folder)
    except OSError:
        return set()
    return {name for name in names if os.path.exists(os.path.join(folder, name, "current"))}


def choose_source(catalog, app, wanted=None):
    """The source to use for app: wanted when it has it, else the store's
    while it sells the app (its text and price, also over an installed free
    version), else the one it is installed from, else the first it offers."""
    if wanted:
        if wanted not in app["src"]:
            raise SoftwareError(f"{app['name']} isn't on {SOURCE_NAMES[wanted]}")
        return wanted
    offered = catalog.sources(app)
    if STORE in offered and app.get("paid"):
        return STORE
    return catalog.installed_from(app) or next(iter(offered), None) or \
        next(s for s in (*SOURCES, WEB) if s in app["src"])


# --- Changing the system: PackageKit and libflatpak (child commands only) -------------

class Output:
    """Prints a change's steps: JSON lines (the window) or plain lines."""

    def __init__(self, as_json):
        self.as_json = as_json
        self.lock = threading.Lock()
        self.last = None

    def emit(self, event, **fields):
        line = json.dumps({"event": event, **fields}) if self.as_json else self.plain(event, fields)
        if line is None or line == self.last:
            return
        self.last = line
        with self.lock, contextlib.suppress(OSError):
            # The window may have gone; the change goes on regardless.
            print(line, flush=True)

    @staticmethod
    def plain(event, fields):
        if event == "progress":
            percent = fields.get("percent")
            words = STATUS_TEXT.get(fields.get("status"), "Preparing…")
            return f"{words} {percent}%" if percent is not None else words
        if event == "done":
            return "Done."
        if event == "cancelled":
            return "Cancelled."
        if event == "item":
            return f"{fields.get('status')}\t{os.path.basename(fields.get('path', ''))}\t{fields.get('message', '')}"
        if event == "error":
            return None             # main() prints it on stderr
        return None


def run_cancellable(work):
    """Run work(cancellable) in a thread while the main thread waits for
    SIGTERM or SIGINT, which cancel it. Returns work's result or raises its error."""
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    cancellable = Gio.Cancellable()
    loop = GLib.MainLoop()
    result = {}

    def worker():
        try:
            result["value"] = work(cancellable)
        except BaseException as error:      # handed to the main thread below
            result["error"] = error
        finally:
            GLib.idle_add(loop.quit)

    def cancel():
        cancellable.cancel()
        return True

    for number in (signal.SIGTERM, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, number, cancel)
    threading.Thread(target=worker, daemon=True).start()
    loop.run()
    if "error" in result:
        raise result["error"]
    if cancellable.is_cancelled():
        raise Cancelled()
    return result.get("value")


class Cancelled(Exception):
    pass


def packagekit():
    try:
        import gi
        gi.require_version("PackageKitGlib", "1.0")
        from gi.repository import GLib, PackageKitGlib
    except (ImportError, ValueError) as error:
        raise SoftwareError(f"Debian apps can't be installed here: PackageKit is not available ({error})") from None
    return PackageKitGlib, GLib


class PackageKitFailed(SoftwareError):
    """PackageKit's own error message (pk_message() turns it into words)."""


# apt's words for a package file that is no longer where its lists say
STALE_LISTS = re.compile(r"not \(yet\) available|404\s+Not Found|Hash Sum mismatch|unexpected size", re.I)


def pk_message(error, verb, name):
    """A PackageKit failure in plain words (HIG TXT-6)."""
    text = str(error)
    if STALE_LISTS.search(text):
        return (f"{name} wasn't {verb}: this computer's package lists are out of date ({text}). "
                f"Try again in a few minutes.")
    if re.search(r"not.?authori[sz]ed|authentication|dismissed", text, re.I):
        return f"{name} wasn't {verb}: the password wasn't given."
    if re.search(r"lock|another", text, re.I):
        return f"{name} wasn't {verb}: another installation is running. Try again when it has finished."
    if re.search(r"network|download|resolve|fetch|connect", text, re.I):
        return f"{name} wasn't {verb}: a download failed ({text}). Check the network connection and try again."
    return f"{name} wasn't {verb}: {text}"


def pk_run(Pk, GLib, call, *args, progress=None, cancellable=None):
    """Call a PackageKit client method; raises PackageKitFailed with its error."""
    client = Pk.Client()
    try:
        result = getattr(client, call)(*args, cancellable, progress or (lambda *_: None), None)
    except GLib.Error as error:
        if cancellable is not None and cancellable.is_cancelled():
            raise Cancelled() from None
        raise PackageKitFailed(error.message) from None
    code = result.get_error_code()
    if code is not None:
        raise PackageKitFailed(code.get_details() or Pk.error_enum_to_string(code.get_code()))
    return result


def pk_resolve(Pk, GLib, package, installed, arch=None):
    """PackageKit's ids for package: of this computer's architecture, or of arch."""
    flags = ("installed" if installed else "newest;~installed") + ("" if arch else ";arch")
    result = pk_run(Pk, GLib, "resolve", Pk.filter_bitfield_from_string(flags), [package])
    ids = [p.get_id() for p in result.get_package_array()]
    return [i for i in ids if arch is None or i.split(";")[2] == arch]


def foreign_architectures():
    try:
        result = subprocess.run(["dpkg", "--print-foreign-architectures"], capture_output=True, text=True,
                                timeout=QUERY_SECONDS, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return result.stdout.split()


def asked_for(arch):
    """The installed packages of arch someone asked for (apt's manual mark;
    dpkg's name:arch), or None when they can't be read. The ones only
    installed for others go with the architecture (control-helper i386-off)."""
    try:
        result = subprocess.run(DPKG_ARCHES, capture_output=True, text=True, timeout=QUERY_SECONDS, check=False)
        manual = subprocess.run(APT_MANUAL, capture_output=True, text=True, timeout=QUERY_SECONDS, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0 or manual.returncode != 0:
        return None
    asked = set(manual.stdout.split())
    found = set()
    for line in result.stdout.splitlines():
        status, _, rest = line.partition("\t")
        name, _, package_arch = rest.partition("\t")
        name = name if ":" in name else f"{name}:{arch}"
        if package_arch == arch and status[1:2] not in ("n", "c") and name in asked:
            found.add(name)
    return found


def other_parts(package, installed):
    """(package's OTHER_ARCH entry or None, its packages that aren't installed)."""
    extra = OTHER_ARCH.get(package)
    if extra is None:
        return None, []
    return extra, [p for p in extra["packages"] if p.partition(":")[0] not in installed]


def resolve_parts(extra, parts, foreign, resolve):
    """PackageKit ids for parts (resolve(name, arch) -> ids); a part of an
    architecture that isn't on yet is left out (its lists aren't there)."""
    ids = []
    for part in parts:
        name, _, arch = part.partition(":")
        if not arch or arch in foreign:
            ids += resolve(name, arch or None)
    return ids


def turns_off(extra, foreign, installed, removing):
    """Whether removing (PackageKit ids) leaves nothing of extra's architecture
    that someone asked for, so its setting goes off too. installed:
    asked_for() (None: unknown)."""
    if extra is None or extra["arch"] not in foreign or installed is None:
        return False
    gone = {f"{i.split(';')[0]}:{i.split(';')[2]}" for i in removing if i.split(";")[2] == extra["arch"]}
    return installed <= gone


def control_setting(extra, value, name, verb):
    """flickos-control's system setting for extra's architecture on or off: it
    asks for the password (pkexec) and records the change for History."""
    try:
        result = subprocess.run([CONTROL, "system", extra["setting"], value], stdin=subprocess.DEVNULL,
                                capture_output=True, text=True, check=False)
    except OSError as error:
        raise SoftwareError(f"{name} wasn't {verb}: {error}") from None
    if result.returncode != 0:
        reason = last_line(result.stderr).removeprefix(f"{CONTROL}: ")
        if re.search(r"not.?authori[sz]ed|dismissed|authentication", reason, re.I):
            raise SoftwareError(f"{name} wasn't {verb}: the password wasn't given.")
        raise SoftwareError(f"{name} wasn't {verb}: {extra['what']} couldn't be turned {value} "
                            f"({reason or 'no reason given'}).")


def apt_plan(catalog, app, remove, source="debian"):
    """What installing or removing app's package from an apt source changes
    (a simulation, no password)."""
    Pk, GLib = packagekit()
    package = app["src"][source]["pkg"]
    simulate = Pk.transaction_flag_bitfield_from_string("simulate")
    verb = "removed" if remove else "installed"
    extra, missing = other_parts(package, catalog.packages)
    foreign = foreign_architectures() if extra else []
    # Installed, but without its other architecture's part: install only that.
    only_parts = not remove and package in catalog.packages and bool(missing)
    try:
        ids = [] if only_parts else pk_resolve(Pk, GLib, package, installed=remove)
        if extra and (ids or only_parts):
            ids += resolve_parts(extra, extra["packages"] if remove else missing, foreign,
                                 lambda name, arch: pk_resolve(Pk, GLib, name, remove, arch))
    except PackageKitFailed as error:
        raise SoftwareError(pk_message(error, verb, app["name"])) from None
    if not ids and not only_parts:
        if remove:
            raise SoftwareError(f"{app['name']} isn't installed from {SOURCE_NAMES[source]}.")
        if package in catalog.packages:
            raise SoftwareError(f"{app['name']} is already installed.")
        raise SoftwareError(f"{app['name']} isn't in {SOURCE_NAMES[source]}'s package lists for this computer.")
    adds = None
    if not remove and any(":" in p for p in missing):
        on = extra["arch"] in foreign
        adds = {"what": extra["what"], "on": on, "size": 0 if on else extra["size"],
                "download": 0 if on else extra["download"]}
    if not ids:             # only the parts, and their architecture's lists aren't there yet
        return {"source": source, "action": "install", "app": app["name"], "package": package, "items": [],
                "packages": [], "removes": [], "protected": [], "ids": [], "size": 0, "download": 0,
                "only_parts": True, "adds": adds, "turns_off": False}
    try:
        if remove:
            # allow dependents, and take the packages only this app needed (autoremove)
            result = pk_run(Pk, GLib, "remove_packages", simulate, ids, True, True)
        else:
            result = pk_run(Pk, GLib, "install_packages", simulate, ids)
    except PackageKitFailed as error:
        raise SoftwareError(pk_message(error, verb, app["name"])) from None
    changes = {}
    for item in result.get_package_array():
        info = Pk.info_enum_to_string(item.get_info())
        changes.setdefault(info, []).append(item.get_id())
    removing = changes.get("removing", [])
    installing = changes.get("installing", [])
    plan = {"source": source, "action": "remove" if remove else "install", "app": app["name"],
            "package": package, "items": [], "packages": sorted({i.split(";")[0] for i in (removing if remove else installing)}),
            "removes": sorted({i.split(";")[0] for i in removing}), "ids": ids, "only_parts": only_parts,
            "adds": adds,
            "turns_off": remove and turns_off(extra, foreign, asked_for(extra["arch"]) if extra else None,
                                              removing)}
    plan["protected"] = [p for p in plan["removes"] if catalog.is_protected(p)]
    sized = removing if remove else installing
    size = download = 0
    if sized:
        with contextlib.suppress(PackageKitFailed):
            for details in pk_run(Pk, GLib, "get_details", sized).get_details_array():
                size += details.get_size() or 0
                download += details.get_download_size() or 0
    plan["size"] = size
    plan["download"] = 0 if remove else download
    return plan


def apt_change(catalog, app, remove, out, source="debian"):
    plan = apt_plan(catalog, app, remove, source)
    refuse_protected(plan)
    Pk, GLib = packagekit()
    package = plan["package"]
    verb = "removed" if remove else "installed"
    extra = OTHER_ARCH.get(package)
    if plan["adds"] and not plan["adds"]["on"]:
        # The architecture first (its own password), then its package lists,
        # then the plan again: now with the parts.
        out.emit("progress", status="arch-on", percent=None, cancel=False)
        control_setting(extra, "on", app["name"], verb)
        try:
            pk_run(Pk, GLib, "refresh_cache", False)        # the running daemon sees the new architecture
        except PackageKitFailed as error:
            raise SoftwareError(pk_message(error, verb, app["name"])) from None
        plan = apt_plan(catalog, app, remove, source)
        refuse_protected(plan)
        if not plan["adds"]["on"] or not plan["ids"]:
            raise SoftwareError(f"{app['name']} wasn't {verb}: {extra['what']} is on, but its packages "
                                f"aren't in the package lists. Try again in a few minutes.")
    current = {"plan": plan}

    def progress(status, _kind, *_):
        percent = status.get_percentage()
        out.emit("progress", status=Pk.status_enum_to_string(status.get_status()),
                 percent=percent if 0 <= percent <= 100 else None, cancel=bool(status.get_allow_cancel()))

    def work(cancellable):
        ids = current["plan"]["ids"]
        if remove:
            pk_run(Pk, GLib, "remove_packages", 0, ids, True, True, progress=progress, cancellable=cancellable)
        else:
            trusted = Pk.transaction_flag_bitfield_from_string("only-trusted")
            pk_run(Pk, GLib, "install_packages", trusted, ids, progress=progress, cancellable=cancellable)

    try:
        try:
            run_cancellable(work)
        except PackageKitFailed as error:
            if remove or not STALE_LISTS.search(str(error)):
                raise
            # The lists name a version the repository has replaced (FlickOS's
            # keeps only the newest): fetch them again and try once more.
            pk_run(Pk, GLib, "refresh_cache", False)
            current["plan"] = apt_plan(catalog, app, remove, source)
            refuse_protected(current["plan"])
            run_cancellable(work)
    except PackageKitFailed as error:
        raise SoftwareError(pk_message(error, verb, app["name"])) from None
    # PackageKit reports a cancelled transaction as a success: check the result.
    packages, _ = installed_packages()
    wanted = [i.split(";")[0] for i in current["plan"]["ids"]]
    if (package in packages) == remove or not remove and not all(p in packages for p in wanted):
        raise Cancelled()
    if remove and current["plan"]["turns_off"]:
        out.emit("progress", status="arch-off", percent=None, cancel=False)
        try:
            control_setting(extra, "off", app["name"], verb)
        except SoftwareError as error:
            # The app is gone; only the architecture stays (Settings' History can undo it).
            warn(f"{extra['what'].capitalize()} stays on: {error}")


def refuse_protected(plan):
    if plan["protected"]:
        raise SoftwareError(f"{plan['app']} is part of the FlickOS desktop, so it can't be "
                            f"{'removed' if plan['action'] == 'remove' else 'installed'} here: "
                            f"{', '.join(plan['protected'])} would be removed.")


def libflatpak():
    try:
        import gi
        gi.require_version("Flatpak", "1.0")
        from gi.repository import Flatpak, Gio, GLib
    except (ImportError, ValueError) as error:
        raise SoftwareError(f"Flathub apps can't be installed here: libflatpak is not available ({error})") from None
    return Flatpak, Gio, GLib


def flatpak_ref(app):
    return app["src"]["flathub"]["ref"]


def flatpak_installed_ref(Flatpak, GLib, installation, ref):
    _kind, name, arch, branch = ref.split("/")
    try:
        return installation.get_installed_ref(Flatpak.RefKind.APP, name, arch, branch, None)
    except GLib.Error:
        return None


def flatpak_transaction(Flatpak, installation):
    transaction = Flatpak.Transaction.new_for_installation(installation, None)
    # A runtime that more than one remote has comes from Flathub.
    transaction.connect("choose-remote-for-ref",
                        lambda _t, _ref, _runtime, remotes: remotes.index(FLATHUB) if FLATHUB in remotes else 0)
    return transaction


def flatpak_plan(catalog, app, remove):
    """What installing app from Flathub brings (a transaction stopped before it
    starts, no password), or what removing it frees."""
    Flatpak, _Gio, GLib = libflatpak()
    ref = flatpak_ref(app)
    plan = {"source": "flathub", "action": "remove" if remove else "install", "app": app["name"],
            "ref": ref, "packages": [], "removes": [], "protected": [], "items": [], "size": 0, "download": 0}
    try:
        installation = Flatpak.Installation.new_system(None)
    except GLib.Error as error:
        raise SoftwareError(f"Flathub apps can't be installed here: {error.message}") from None
    installed = flatpak_installed_ref(Flatpak, GLib, installation, ref)
    if remove:
        if installed is None:
            raise SoftwareError(f"{app['name']} isn't installed from Flathub.")
        plan["size"] = installed.get_installed_size()
        return plan
    if installed is not None:
        raise SoftwareError(f"{app['name']} is already installed.")
    transaction = flatpak_transaction(Flatpak, installation)

    def ready(transaction):
        for op in transaction.get_operations():
            item = {"ref": op.get_ref(), "type": op.get_operation_type().value_nick,
                    "download": op.get_download_size(), "size": op.get_installed_size(),
                    "name": runtime_name(op.get_ref())}
            # A translations runtime reports its full size (the GNOME one 386 MB
            # and 1.6 GB), but only the configured languages come: 32 kB in a
            # VM, 2026-10-08. Left out of the totals.
            if item["ref"].split("/")[1].endswith(".Locale"):
                item["download"] = item["size"] = 0
            plan["items"].append(item)
            plan["download"] += item["download"]
            plan["size"] += item["size"]
        return False                # stop here: nothing is downloaded

    transaction.connect("ready", ready)
    try:
        transaction.add_install(FLATHUB, ref, None)
        transaction.run(None)
    except GLib.Error as error:
        if not error.matches(Flatpak.error_quark(), Flatpak.Error.ABORTED):
            raise SoftwareError(flatpak_message(error, "installed", app["name"])) from None
    return plan


def flatpak_message(error, verb, name):
    text = error.message
    if re.search(r"not.?authori[sz]ed|authentication|dismissed", text, re.I):
        return f"{name} wasn't {verb}: the password wasn't given."
    if re.search(r"resolve|network|connect|timed? ?out|summary", text, re.I):
        return f"{name} wasn't {verb}: Flathub couldn't be reached ({text}). Check the network connection and try again."
    if re.search(r"space|ENOSPC", text, re.I):
        return f"{name} wasn't {verb}: the disk is full."
    return f"{name} wasn't {verb}: {text}"


def flatpak_change(catalog, app, remove, out):
    Flatpak, Gio, GLib = libflatpak()
    ref = flatpak_ref(app)
    verb = "removed" if remove else "installed"
    try:
        installation = Flatpak.Installation.new_system(None)
    except GLib.Error as error:
        raise SoftwareError(f"Flathub apps can't be installed here: {error.message}") from None

    def work(cancellable):
        transaction = flatpak_transaction(Flatpak, installation)
        done = {"ops": -1, "count": 1}     # operations finished: one less than started

        def ready(transaction):
            done["count"] = max(1, len(transaction.get_operations()))
            return True

        def new_operation(_transaction, op, progress):
            # Counted here: libflatpak's operation-done hands PyGObject a
            # result it can't read (a GLib warning on every operation).
            done["ops"] += 1
            progress.set_update_frequency(300)
            words = runtime_name(op.get_ref())
            status = "remove" if remove else "download"

            def changed(progress):
                percent = (done["ops"] * 100 + progress.get_progress()) // done["count"]
                out.emit("progress", status=status, percent=min(100, percent), cancel=not remove,
                         detail=words or "")

            progress.connect("changed", changed)

        transaction.connect("ready", ready)
        transaction.connect("new-operation", new_operation)
        if remove:
            transaction.add_uninstall(ref)
        else:
            transaction.add_install(FLATHUB, ref, None)
        try:
            transaction.run(cancellable)
        except GLib.Error as error:
            if cancellable.is_cancelled() or error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.CANCELLED):
                raise Cancelled() from None
            raise SoftwareError(flatpak_message(error, verb, app["name"])) from None

    if not remove and flatpak_installed_ref(Flatpak, GLib, installation, ref) is not None:
        raise SoftwareError(f"{app['name']} is already installed.")
    run_cancellable(work)


# --- Files from outside: .deb, .flatpak, .flatpakref, .flatpakrepo (ADR-012) ---------
#
# `open FILE...` shows one page for the files; `plan --file` and `install --file`
# are the children it runs. Reading a file never runs anything from it: dpkg-deb
# reads a package's control data, libflatpak a bundle's header, and the link
# files are plain text. A `.deb` installs through PackageKit (its untrusted-file
# action asks for the password every time), Flatpak files through libflatpak
# into the system installation.

FLATHUB_URL = "https://dl.flathub.org/repo/"
FLATHUB_REPO_FILE = "https://dl.flathub.org/repo/flathub.flatpakrepo"
OPEN_FOLDER = os.path.join("software", "open")      # under runtime_dir(): one small file per path to open
FILE_SECONDS = 20                   # reading one file is given up after
FILE_LIMIT = 1 << 20                # a link file is never bigger than this
FILE_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.+-]*$")
KIND_WORDS = {"deb": "Debian package", "ref": "Flatpak app", "bundle": "Flatpak app", "repo": "Flatpak source"}

# What a Flatpak's [Context] says, in words (ADR-012: the page shows it before Install).
FS_WORDS = {
    "home": "your home folder", "host": "all your files", "host-os": "the system's program files",
    "host-etc": "the system's settings files", "xdg-download": "your Downloads folder",
    "xdg-documents": "your Documents folder", "xdg-pictures": "your Pictures folder",
    "xdg-music": "your Music folder", "xdg-videos": "your Videos folder", "xdg-desktop": "your Desktop folder",
    "xdg-config": "your settings folders", "xdg-data": "your data folders", "xdg-cache": "your cache folders",
}


def native_architecture():
    try:
        result = subprocess.run(["dpkg", "--print-architecture"], capture_output=True, text=True,
                                timeout=QUERY_SECONDS, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return "amd64"
    return result.stdout.strip() or "amd64"


def read_small(path, limit=FILE_LIMIT):
    base = os.path.basename(path)
    try:
        with open(path, "rb") as f:
            data = f.read(limit + 1)
    except OSError as error:
        raise SoftwareError(f"{base} can't be read: {error.strerror or error}") from None
    if len(data) > limit:
        raise SoftwareError(f"{base} is too big to be a link file.")
    return data.decode("utf-8", "replace")


def keyfile(text, section):
    """One section of a key file (a .flatpakref, a .flatpakrepo, a bundle's metadata) as a dict."""
    parser = configparser.RawConfigParser(strict=False, delimiters=("=",))
    parser.optionxform = str
    try:
        parser.read_string(text)
    except configparser.Error:
        return {}
    return dict(parser[section]) if parser.has_section(section) else {}


def file_kind(path):
    """deb, ref, bundle or repo, from what the file starts with (a bundle's by its name)."""
    base = os.path.basename(path)
    try:
        with open(path, "rb") as f:
            head = f.read(512)
    except OSError as error:
        raise SoftwareError(f"{base} can't be read: {error.strerror or error}") from None
    if head.startswith(b"!<arch>\n"):
        return "deb"
    text = head.lstrip(b"\xef\xbb\xbf \t\r\n")
    if text.startswith(b"[Flatpak Ref]"):
        return "ref"
    if text.startswith(b"[Flatpak Repo]"):
        return "repo"
    if base.endswith(".flatpak") and not text.startswith(b"["):
        return "bundle"
    raise SoftwareError(f"{base} isn't a Debian package or a Flatpak file.")


def friendly_name(app_id):
    """Calculator for org.gnome.Calculator (a file has no better name than its ID)."""
    return app_id.rsplit(".", 1)[-1] or app_id


def split_list(value):
    return [part for part in (value or "").split(";") if part]


def permission_words(metadata):
    """(sentences, risky) for a Flatpak's metadata: what the app may reach.
    Risky: the whole home folder or all files for writing, or a way out of the
    sandbox. Devices are listed but never risky: games ask for all of them
    so controllers work (ADR-012)."""
    context = keyfile(metadata, "Context")
    words, risky = [], False
    sockets = split_list(context.get("sockets"))
    devices = split_list(context.get("devices"))
    features = split_list(context.get("features"))
    if "network" in split_list(context.get("shared")):
        words.append("Use the network")
    if "pulseaudio" in sockets:
        words.append("Play and record sound")
    if "all" in devices:
        words.append("Use all devices, such as game controllers and cameras")
    if "cups" in sockets:
        words.append("Print")
    if "ssh-auth" in sockets:
        words.append("Use your SSH keys")
    if "gpg-agent" in sockets:
        words.append("Use your GPG keys")
    if "pcsc" in sockets:
        words.append("Use smart cards")
    if "bluetooth" in features:
        words.append("Use Bluetooth")
    for entry in split_list(context.get("filesystems")):
        if entry.startswith("!"):
            continue
        path, _, mode = entry.partition(":")
        where = FS_WORDS.get(path) or (f"the folder {path}" if path.startswith(("~", "/")) else None)
        if where is None:
            continue
        if mode == "ro":
            words.append(f"Read {where}")
        else:
            words.append(f"Read and write {where}")
            risky = risky or path in ("home", "host", "host-os", "host-etc")
    if "session-bus" in sockets or "system-bus" in sockets:
        words.append("Talk to every program on the desktop (it can leave the sandbox)")
        risky = True
    for key, value in keyfile(metadata, "Session Bus Policy").items():
        if key == "org.freedesktop.Flatpak" and value in ("talk", "own"):
            words.append("Start programs outside the sandbox")
            risky = True
        elif key == "org.freedesktop.secrets" and value in ("talk", "own"):
            words.append("Use your saved passwords")
    return words, risky


def control_fields(text):
    """dpkg-deb -f's output as a dict (a continuation line starts with a space)."""
    fields, last = {}, None
    for line in text.splitlines():
        if line[:1] in (" ", "\t") and last:
            fields[last] += "\n" + line.strip()
        elif ":" in line:
            last, _, value = line.partition(":")
            fields[last] = value.strip()
    return fields


class Reason:
    """A bare message with .message, what flatpak_message() reads from a GLib.Error."""

    def __init__(self, message):
        self.message = message


def cant(item, reason):
    """A refusal as a sentence."""
    return f"{item['name']} can't be installed: {' '.join(str(reason).split())}"


def new_item(path):
    path = os.path.abspath(path)
    return {"path": path, "file": os.path.basename(path), "kind": None, "name": "", "version": "", "arch": "",
            "summary": "", "size": 0, "download": 0, "maker": "", "homepage": "", "notes": [],
            "permissions": [], "risky": False, "refused": None, "catalog": None, "adds": None}


def inspect_deb(item):
    try:
        result = subprocess.run(["dpkg-deb", "-f", item["path"], "Package", "Version", "Architecture",
                                 "Installed-Size", "Maintainer", "Homepage", "Description"],
                                capture_output=True, text=True, timeout=FILE_SECONDS, check=False)
    except (OSError, subprocess.TimeoutExpired):
        raise SoftwareError(f"{item['file']} can't be read.") from None
    fields = control_fields(result.stdout)
    if result.returncode != 0 or not FILE_NAME.match(fields.get("Package", "")) or not fields.get("Version"):
        raise SoftwareError(f"{item['file']} isn't a valid Debian package.")
    size = fields.get("Installed-Size", "")
    item.update(name=fields["Package"], version=fields["Version"], arch=fields.get("Architecture", ""),
                summary=fields.get("Description", "").partition("\n")[0], maker=fields.get("Maintainer", ""),
                homepage=fields.get("Homepage", ""), size=int(size) * 1024 if size.isdigit() else 0)
    supported = {"all", native_architecture(), *foreign_architectures()}
    if item["arch"] not in supported:
        raise SoftwareError(f"{item['file']} is for {item['arch']} computers; this one runs "
                            f"{native_architecture()}.")


def inspect_bundle(item):
    Flatpak, Gio, GLib = libflatpak()
    try:
        bundle = Flatpak.BundleRef.new(Gio.File.new_for_path(item["path"]))
    except GLib.Error:
        raise SoftwareError(f"{item['file']} isn't a valid Flatpak file.") from None
    if bundle.get_kind() != Flatpak.RefKind.APP:
        raise SoftwareError(f"{item['file']} is a runtime, not an app.")
    if bundle.get_arch() != FLATPAK_ARCH:
        raise SoftwareError(f"{item['file']} is for {bundle.get_arch()} computers; this one runs {FLATPAK_ARCH}.")
    app_id = bundle.get_name()
    item.update(app_id=app_id, name=friendly_name(app_id), version=bundle.get_branch(), arch=bundle.get_arch(),
                ref=bundle.format_ref(), size=bundle.get_installed_size(), url=bundle.get_origin() or "",
                runtime_repo=bundle.get_runtime_repo_url() or "")
    with contextlib.suppress(OSError):
        item["download"] = os.path.getsize(item["path"])
    metadata = bundle.get_metadata()
    if metadata is not None:
        text = bytes(metadata.get_data()).decode("utf-8", "replace")
        item["permissions"], item["risky"] = permission_words(text)
        runtime = keyfile(text, "Application").get("runtime", "")
        if re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_]+/[A-Za-z0-9_.-]+", runtime):
            item["runtime_ref"] = f"runtime/{runtime}"
    # A bundle exported with appstream data names the app properly.
    with contextlib.suppress(Exception):
        data = bundle.get_appstream()
        if data is not None:
            root = ET.fromstring(gzip.decompress(bytes(data.get_data())))
            name = root.findtext(".//component/name")
            if name:
                item["name"] = tidy(name)[:80]
    if not item["url"]:
        item["notes"].append("It won't update by itself: the file doesn't say where updates come from.")


def inspect_ref(item):
    fields = keyfile(read_small(item["path"]), "Flatpak Ref")
    app_id, branch, url = fields.get("Name", ""), fields.get("Branch") or "master", fields.get("Url", "")
    if not FILE_NAME.match(app_id) or not FILE_NAME.match(branch):
        raise SoftwareError(f"{item['file']} isn't a valid Flatpak link file.")
    if fields.get("IsRuntime", "false").lower() == "true":
        raise SoftwareError(f"{item['file']} is a runtime, not an app.")
    parts = urllib.parse.urlsplit(url)
    if parts.scheme != "https" or not parts.netloc:
        raise SoftwareError(f"{item['file']} names a source that isn't an https address.")
    flathub = url.rstrip("/") + "/" == FLATHUB_URL
    item.update(app_id=app_id, name=friendly_name(app_id), version=branch, arch=FLATPAK_ARCH,
                ref=f"app/{app_id}/{FLATPAK_ARCH}/{branch}", url=url, flathub=flathub, host=parts.netloc,
                gpg_key=bool(fields.get("GPGKey")), summary=fields.get("Comment", "")[:200],
                homepage=fields.get("Homepage", ""),
                suggested=re.sub(r"[^A-Za-z0-9_.-]", "", fields.get("SuggestRemoteName", ""))[:40])
    if not flathub and not item["gpg_key"]:
        raise SoftwareError(f"{item['file']} names a source ({parts.netloc}) with no signing key.")


def inspect_repo(item):
    fields = keyfile(read_small(item["path"]), "Flatpak Repo")
    url = fields.get("Url", "")
    parts = urllib.parse.urlsplit(url)
    if parts.scheme != "https" or not parts.netloc:
        raise SoftwareError(f"{item['file']} names a source that isn't an https address.")
    if not fields.get("GPGKey"):
        raise SoftwareError(f"{item['file']} names a source ({parts.netloc}) with no signing key.")
    title = tidy(fields.get("Title", "")) or parts.netloc
    item.update(name=title[:80], url=url, host=parts.netloc, summary=(fields.get("Comment")
                                                                      or fields.get("Description") or "")[:200],
                homepage=fields.get("Homepage", ""))


INSPECT = {"deb": inspect_deb, "bundle": inspect_bundle, "ref": inspect_ref, "repo": inspect_repo}


def inspect_file(path):
    """What a file is, from the file alone. A file that can't be used says why in item["refused"]."""
    item = new_item(path)
    try:
        item["kind"] = file_kind(item["path"])
        INSPECT[item["kind"]](item)
    except SoftwareError as error:
        item["refused"] = str(error)
    item["name"] = item["name"] or item["file"]
    return item


def compare_versions(first, second):
    """1, 0 or -1 as dpkg orders the versions."""
    for operator, result in (("gt", 1), ("eq", 0)):
        try:
            if subprocess.run(["dpkg", "--compare-versions", first, operator, second],
                              timeout=QUERY_SECONDS, check=False).returncode == 0:
                return result
        except (OSError, subprocess.TimeoutExpired):
            return 0
    return -1


def catalog_app_for_package(catalog, package):
    for app in catalog.apps:
        for source in APT_SOURCES:
            entry = app["src"].get(source)
            if entry and entry.get("pkg") == package:
                return app
    return None


def deb_simulation(paths):
    """What installing the files changes (a simulation, no password):
    {PackageKit's info: [ids]}."""
    Pk, GLib = packagekit()
    simulate = Pk.transaction_flag_bitfield_from_string("simulate")
    result = pk_run(Pk, GLib, "install_files", simulate, paths)
    changes = {}
    for item in result.get_package_array():
        changes.setdefault(Pk.info_enum_to_string(item.get_info()), []).append(item.get_id())
    return changes, Pk, GLib


def plan_debs(debs, catalog, plan):
    """Fill the .deb items and plan["deb"] from one simulation of all of them."""
    installed = catalog.packages
    for item in debs:
        have = installed.get(item["name"])
        if have:
            relation = compare_versions(item["version"], have)
            if relation == 0:
                item["refused"] = f"{item['name']} {have} is already installed."
            elif relation < 0:
                item["notes"].append(f"It is older than the installed version ({have}); installing it replaces it.")
            else:
                item["notes"].append(f"It replaces the installed version ({have}).")
        app = catalog_app_for_package(catalog, item["name"])
        if app is not None:
            item["catalog"] = app["id"]
        if catalog.is_protected(item["name"]) and not have:
            item["refused"] = f"{item['name']} has a name only FlickOS's own packages use, so a file can't install it."
        item["summary"] = item["summary"] or "Debian package"
    todo = [i for i in debs if not i["refused"]]
    plan["deb"] = {"packages": [], "removes": [], "download": 0, "size": 0}
    if not todo:
        return

    def simulate(items):
        return deb_simulation([i["path"] for i in items])

    try:
        changes, Pk, GLib = simulate(todo)
    except PackageKitFailed as error:
        # Find the file at fault; the rest are planned together.
        ok = []
        for item in todo:
            try:
                simulate([item])
                ok.append(item)
            except PackageKitFailed as single:
                item["refused"] = cant(item, pk_message(single, "installed", "").split(": ", 1)[-1])
        if len(ok) == len(todo):
            plan["error"] = pk_message(error, "installed", "").split(": ", 1)[-1]
            return
        todo = ok
        if not todo:
            return
        try:
            changes, Pk, GLib = simulate(todo)
        except PackageKitFailed as again:
            plan["error"] = pk_message(again, "installed", "").split(": ", 1)[-1]
            return
    own = {i["name"] for i in todo}
    adds = [i for key in ("installing", "updating", "downgrading", "reinstalling") for i in changes.get(key, [])]
    removes = [i for key in ("removing", "obsoleting") for i in changes.get(key, [])]
    plan["deb"]["packages"] = sorted({i.split(";")[0] for i in adds} - own)
    plan["deb"]["removes"] = sorted({i.split(";")[0] for i in removes})
    protected = [p for p in plan["deb"]["removes"] if catalog.is_protected(p)]
    if protected:
        for item in todo:
            item["refused"] = (f"Installing {item['name']} would remove part of the FlickOS desktop ("
                               + ", ".join(protected) + ").")
        plan["deb"]["removes"] = []
        return
    sized = [i for i in adds if i.split(";")[0] not in own]
    if sized:
        with contextlib.suppress(PackageKitFailed):
            for details in pk_run(Pk, GLib, "get_details", sized).get_details_array():
                plan["deb"]["size"] += details.get_size() or 0
                plan["deb"]["download"] += details.get_download_size() or 0


def remote_by_url(installation, url):
    """The name of the system remote that has this address, or None."""
    wanted = url.rstrip("/")
    for remote in installation.list_remotes():
        if (remote.get_url() or "").rstrip("/") == wanted:
            return remote.get_name()
    return None


def plan_flatpaks(items, catalog, plan):
    """Fill the Flatpak items, and plan["flatpak"] from one transaction stopped
    before it starts (no password)."""
    Flatpak, Gio, GLib = libflatpak()
    plan["flatpak"] = {"runtimes": [], "size": 0, "download": 0}
    try:
        installation = Flatpak.Installation.new_system(None)
    except GLib.Error as error:
        for item in items:
            item["refused"] = f"Flatpak apps can't be installed here: {error.message}"
        return
    transaction = flatpak_transaction(Flatpak, installation)
    flathub_here = flathub_configured()
    planned, refs = 0, {}
    for item in items:
        if flatpak_installed_ref(Flatpak, GLib, installation, item["ref"]) is not None:
            item["refused"] = f"{item['name']} is already installed."
            continue
        if item["kind"] == "bundle":
            # Not a transaction of the bundle: libflatpak sets up its remote (and asks for the
            # password) before it stops at the plan. Only the runtime it needs is planned.
            runtime = item.get("runtime_ref")
            if runtime and not runtime_installed(Flatpak, GLib, installation, runtime):
                if flathub_here:
                    transaction.add_install(FLATHUB, runtime, None)
                    planned += 1
                else:
                    item["notes"].append(f"It needs {runtime_name(runtime) or runtime.split('/')[1]}, "
                                         "which isn't installed, and Flathub isn't added.")
            continue
        app = catalog.find(item["app_id"]) if catalog.loaded else None
        if app is not None and "flathub" in app["src"]:
            item["catalog"] = app["id"]
            item["name"] = app["name"]
            item["summary"] = item["summary"] or app["summary"]
        if item["flathub"]:
            if not flathub_here:
                item["adds"] = {"what": "Flathub", "host": "dl.flathub.org"}
                item["notes"].append("This also adds Flathub, the place the app comes from.")
                continue
            remote = FLATHUB
        else:
            remote = remote_by_url(installation, item["url"])
            if remote is None:
                item["adds"] = {"what": item["host"], "host": item["host"]}
                item["notes"].append(f"This also adds the source {item['host']}. Only add a source you trust.")
                continue
        try:
            transaction.add_install(remote, item["ref"], None)
        except GLib.Error as error:
            item["refused"] = cant(item, flatpak_message(error, "installed", "").split(": ", 1)[-1])
            continue
        refs[item["ref"]] = item
        planned += 1
    if not planned:
        return

    def ready(transaction):
        for op in transaction.get_operations():
            ref = op.get_ref()
            if ref.split("/")[1].endswith(".Locale"):
                continue            # reports its full size; only the chosen languages come
            if ref in refs:
                refs[ref]["download"] = op.get_download_size()
                refs[ref]["size"] = op.get_installed_size()
                continue
            plan["flatpak"]["download"] += op.get_download_size()
            plan["flatpak"]["size"] += op.get_installed_size()
            name = runtime_name(ref)
            if name and name not in plan["flatpak"]["runtimes"]:
                plan["flatpak"]["runtimes"].append(name)
        return False

    transaction.connect("ready", ready)
    transaction.connect("add-new-remote", lambda *_args: False)     # a plan adds nothing
    try:
        transaction.run(None)
    except GLib.Error as error:
        if not error.matches(Flatpak.error_quark(), Flatpak.Error.ABORTED):
            plan["error"] = flatpak_message(error, "installed", "").split(": ", 1)[-1]


def runtime_installed(Flatpak, GLib, installation, ref):
    _kind, name, arch, branch = ref.split("/")
    try:
        return installation.get_installed_ref(Flatpak.RefKind.RUNTIME, name, arch, branch, None)
    except GLib.Error:
        return None


def plan_repos(items):
    Flatpak, _Gio, GLib = libflatpak()
    try:
        installation = Flatpak.Installation.new_system(None)
    except GLib.Error as error:
        for item in items:
            item["refused"] = f"Sources can't be added here: {error.message}"
        return
    for item in items:
        have = remote_by_url(installation, item["url"])
        if have:
            item["refused"] = f"{item['host']} is already a source ({have})."
        elif item["url"].rstrip("/") + "/" == FLATHUB_URL:
            item["notes"].append("This is Flathub, the source Software already lists apps from.")
        else:
            item["notes"].append("Adding a source trusts its signing key. Apps from it don't appear in Software; "
                                 "install them from the link files its website gives.")


def plan_files(paths, catalog):
    """The plan for opening paths: one item per file, and what the Debian and
    Flatpak files need together. Nothing is changed and no password is asked."""
    seen, items = set(), []
    for path in paths:
        full = os.path.abspath(path)
        if full not in seen:
            seen.add(full)
            items.append(inspect_file(full))
    plan = {"items": items, "deb": None, "flatpak": None, "error": None, "live": live_session()}
    debs = [i for i in items if i["kind"] == "deb" and not i["refused"]]
    flats = [i for i in items if i["kind"] in ("ref", "bundle") and not i["refused"]]
    repos = [i for i in items if i["kind"] == "repo" and not i["refused"]]
    if debs:
        try:
            plan_debs(debs, catalog, plan)
        except SoftwareError as error:
            for item in debs:
                item["refused"] = str(error)
    if flats:
        try:
            plan_flatpaks(flats, catalog, plan)
        except SoftwareError as error:
            for item in flats:
                item["refused"] = str(error)
    if repos:
        try:
            plan_repos(repos)
        except SoftwareError as error:
            for item in repos:
                item["refused"] = str(error)
    return plan


def files_plan_words(plan, size=human_size):
    """The sentences under the file rows (HIG TXT-8)."""
    items = [i for i in plan["items"] if not i["refused"]]
    parts = []
    own = sum(i["size"] for i in items if i["kind"] in ("deb", "bundle", "ref"))
    deb, flat = plan.get("deb"), plan.get("flatpak")
    need = own + (deb["size"] if deb else 0) + (flat["size"] if flat else 0)
    download = (deb["download"] if deb else 0) + (flat["download"] if flat else 0) \
        + sum(i["download"] for i in items if i["kind"] in ("bundle", "ref"))
    if need:
        text = f"Needs {size(need)} of disk space"
        if download:
            text += f" ({size(download)} to download or copy)"
        parts.append(text + ".")
    if deb and deb["packages"]:
        count = len(deb["packages"])
        parts.append(f"It brings {count} other package from Debian." if count == 1
                     else f"It brings {count} other packages from Debian.")
    if flat and flat["runtimes"]:
        parts.append(f"It also needs {join_words(flat['runtimes'])} from Flathub.")
    if deb and deb["removes"]:
        parts.append(f"Installing it removes {', '.join(deb['removes'])}.")
    kinds = {i["kind"] for i in items}
    if "deb" in kinds:
        parts.append("Debian packages ask for your password"
                     + (", and so do Flatpak files" if "bundle" in kinds else "")
                     + ". A package nobody at FlickOS has checked runs its scripts as the administrator.")
    elif "bundle" in kinds:
        parts.append("Installing from a Flatpak file asks for your password.")
    if plan.get("live"):
        parts.append("This is the live session: what you install here is gone after you restart.")
    if plan.get("error"):
        parts.append(f"What it needs couldn't be checked: {plan['error']}")
    return " ".join(parts)


def remote_name_for(installation, wanted, host):
    """A name for a new remote that no remote has yet."""
    base = re.sub(r"[^A-Za-z0-9_.-]", "-", wanted or host).strip("-.")[:40] or "source"
    names = {r.get_name() for r in installation.list_remotes()}
    name, number = base, 1
    while name in names:
        number += 1
        name = f"{base}-{number}"
    return name


def fetch_flathub_repo():
    """Flathub's .flatpakrepo over TLS (what the image's 0150-flathub hook adds from)."""
    request = urllib.request.Request(FLATHUB_REPO_FILE, headers={"User-Agent": NAME})
    try:
        with urllib.request.urlopen(request, timeout=FILE_SECONDS) as response:
            return response.read(FILE_LIMIT)
    except (OSError, ValueError) as error:
        raise SoftwareError(f"Flathub couldn't be added: {error}") from None


def add_flathub(Flatpak, GLib, installation):
    data = fetch_flathub_repo()
    try:
        remote = Flatpak.Remote.new_from_file(FLATHUB, GLib.Bytes.new(data))
        installation.add_remote(remote, True, None)
    except GLib.Error as error:
        raise SoftwareError(f"Flathub couldn't be added: {error.message}") from None


def add_repo_item(item, out):
    Flatpak, _Gio, GLib = libflatpak()
    try:
        installation = Flatpak.Installation.new_system(None)
        name = remote_name_for(installation, item.get("suggested") or item["host"], item["host"])
        with open(item["path"], "rb") as f:
            remote = Flatpak.Remote.new_from_file(name, GLib.Bytes.new(f.read(FILE_LIMIT)))
        installation.add_remote(remote, True, None)
    except (GLib.Error, OSError) as error:
        raise SoftwareError(f"{item['host']} wasn't added: {getattr(error, 'message', error)}") from None
    out.emit("item", path=item["path"], status="done", message=f"{item['host']} was added as a source.")


def flatpak_files_change(items, out):
    """Install the Flatpak files in one transaction. Returns how many failed."""
    Flatpak, Gio, GLib = libflatpak()
    try:
        installation = Flatpak.Installation.new_system(None)
    except GLib.Error as error:
        for item in items:
            out.emit("item", path=item["path"], status="error",
                     message=f"Flatpak apps can't be installed here: {error.message}")
        return len(items)
    allowed = {FLATHUB_URL} | {i["url"].rstrip("/") + "/" for i in items if i.get("adds")}
    errors = {}

    def work(cancellable):
        if any(i["kind"] == "ref" and i["flathub"] for i in items) and not flathub_configured():
            add_flathub(Flatpak, GLib, installation)
        transaction = flatpak_transaction(Flatpak, installation)
        transaction.connect("add-new-remote",
                            lambda _t, _reason, _from, _name, url: url.rstrip("/") + "/" in allowed)
        done = {"ops": -1, "count": 1}

        def ready(transaction):
            done["count"] = max(1, len(transaction.get_operations()))
            return True

        def new_operation(_transaction, op, progress):
            done["ops"] += 1
            progress.set_update_frequency(300)
            words = runtime_name(op.get_ref())

            def changed(progress):
                percent = (done["ops"] * 100 + progress.get_progress()) // done["count"]
                out.emit("progress", status="download", percent=min(100, percent), cancel=True,
                         detail=words or "")

            progress.connect("changed", changed)

        def operation_error(_transaction, op, error, _details):
            errors[op.get_ref()] = error.message
            return True                     # the other apps go on

        transaction.connect("ready", ready)
        transaction.connect("new-operation", new_operation)
        transaction.connect("operation-error", operation_error)
        for item in items:
            if item["kind"] == "bundle":
                transaction.add_install_bundle(Gio.File.new_for_path(item["path"]), None)
            elif item["flathub"]:
                transaction.add_install(FLATHUB, item["ref"], None)
            else:
                remote = remote_by_url(installation, item["url"])
                if remote:
                    transaction.add_install(remote, item["ref"], None)
                else:
                    with open(item["path"], "rb") as f:
                        transaction.add_install_flatpakref(GLib.Bytes.new(f.read(FILE_LIMIT)))
        try:
            transaction.run(cancellable)
        except GLib.Error as error:
            if cancellable.is_cancelled() or error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.CANCELLED):
                raise Cancelled() from None
            if not errors:
                errors["*"] = error.message

    try:
        run_cancellable(work)
    except SoftwareError as error:
        errors["*"] = str(error)
    failed = 0
    for item in items:
        if flatpak_installed_ref(Flatpak, GLib, installation, item["ref"]) is not None:
            out.emit("item", path=item["path"], status="done", message=f"{item['name']} is installed.")
        else:
            failed += 1
            reason = errors.get(item["ref"]) or errors.get("*") or "it wasn't installed"
            out.emit("item", path=item["path"], status="error",
                     message=flatpak_message(Reason(reason), "installed", item["name"]))
    return failed


def deb_files_change(items, out):
    """Install the .deb files in one PackageKit transaction. Returns how many failed."""
    Pk, GLib = packagekit()
    paths = [i["path"] for i in items]

    def progress(status, _kind, *_):
        percent = status.get_percentage()
        out.emit("progress", status=Pk.status_enum_to_string(status.get_status()),
                 percent=percent if 0 <= percent <= 100 else None, cancel=bool(status.get_allow_cancel()))

    def work(cancellable):
        pk_run(Pk, GLib, "install_files", 0, paths, progress=progress, cancellable=cancellable)

    reason = None
    try:
        run_cancellable(work)
    except PackageKitFailed as error:
        reason = pk_message(error, "installed", "It")
    # PackageKit reports a cancelled transaction as a success: look at what is installed.
    packages, _ = installed_packages()
    failed = 0
    for item in items:
        if packages.get(item["name"]) == item["version"]:
            out.emit("item", path=item["path"], status="done", message=f"{item['name']} is installed.")
        else:
            failed += 1
            out.emit("item", path=item["path"], status="error",
                     message=(reason or "It wasn't installed.").replace("It wasn't", f"{item['name']} wasn't", 1))
    return failed


def files_change(paths, out):
    """Install what plan_files() found usable. Raises SoftwareError when nothing was."""
    catalog = open_catalog()
    plan = plan_files(paths, catalog)
    usable = []
    for item in plan["items"]:
        if item["refused"]:
            out.emit("item", path=item["path"], status="error", message=item["refused"])
        else:
            usable.append(item)
    if not usable:
        raise SoftwareError("None of the files can be installed.")
    failed = len(plan["items"]) - len(usable)
    for item in (i for i in usable if i["kind"] == "repo"):
        try:
            add_repo_item(item, out)
        except SoftwareError as error:
            failed += 1
            out.emit("item", path=item["path"], status="error", message=str(error))
    flats = [i for i in usable if i["kind"] in ("ref", "bundle")]
    if flats:
        failed += flatpak_files_change(flats, out)
    debs = [i for i in usable if i["kind"] == "deb"]
    if debs:
        failed += deb_files_change(debs, out)
    return failed


def spool_folder():
    return os.path.join(runtime_dir(), OPEN_FOLDER)


def spool_files(paths):
    """Hand paths to the open window: one small file each, written atomically."""
    folder = spool_folder()
    for path in paths:
        name = f"{time.time_ns():020d}-{secrets.token_hex(4)}"
        write_atomic(os.path.join(folder, name), os.path.abspath(path) + "\n", mode=0o600)


def take_spool():
    """The paths handed over since the last call, oldest first; the files are deleted."""
    folder = spool_folder()
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        return []
    paths = []
    for name in names:
        if name.endswith(".tmp"):
            continue                # write_atomic()'s file, not renamed yet
        full = os.path.join(folder, name)
        try:
            with open(full, encoding="utf-8") as f:
                text = f.read().strip()
            os.unlink(full)
        except OSError:
            continue
        if text:
            paths.append(text)
    return paths


def refresh(force=False):
    """Fetch the catalogs fetch_needed() names (all with force): apt's lists
    through PackageKit, which runs the appstream hook, and Flathub's through
    libflatpak. Polkit allows both without a password in an active session.
    Returns the sources fetched; a failure is only a warning."""
    needed = ["debian", "flathub"] if force else fetch_needed()
    fetched = []
    if "debian" in needed:
        try:
            Pk, GLib = packagekit()
            pk_run(Pk, GLib, "refresh_cache", False)
            fetched.append("debian")
        except SoftwareError as error:
            warn(f"Debian's package lists weren't updated: {error}")
    if "flathub" in needed and flathub_usable():
        try:
            Flatpak, _Gio, GLib = libflatpak()
            try:
                installation = Flatpak.Installation.new_system(None)
                installation.update_appstream_sync(FLATHUB, None, None)
                fetched.append("flathub")
            except GLib.Error as error:
                warn(f"Flathub's catalog wasn't updated: {error.message}")
        except SoftwareError as error:
            warn(str(error))
    shop = fetch_shop(force)
    fetched += [name for name, changed in shop.items() if changed]
    return fetched


# --- Commands ------------------------------------------------------------------------

def open_catalog(installed=True):
    """The Catalog for a command, built first when there is none or it is
    stale; installed: also read what is installed."""
    catalog = Catalog()
    with contextlib.suppress(SoftwareError):
        catalog.load()
    if catalog.stale():
        with index_lock():
            build_index()
        catalog.load()
    if installed:
        catalog.read_installed()
    catalog.set_paid(load_featured()[1])
    catalog.show_paid = paid_setting()[0] == "on"
    return catalog


@contextlib.contextmanager
def index_lock():
    """One index build at a time; a second waits for the first."""
    folder = cache_dir()
    os.makedirs(folder, exist_ok=True)
    with open(os.path.join(folder, INDEX_LOCK), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def app_or_error(catalog, name):
    app = catalog.find(name)
    if app is None:
        raise SoftwareError(f"no app {name} (try: {NAME} search WORDS)")
    return app


def print_apps(catalog, apps):
    for app in apps:
        installed = catalog.installed_from(app) or ""
        print("\t".join([app["id"], ",".join(s for s in SOURCES if s in app["src"]), installed,
                         app["name"], app["summary"]]))


def cmd_search(opts):
    catalog = open_catalog()
    print_apps(catalog, catalog.search(opts.words))
    return 0


def cmd_list(opts):
    catalog = open_catalog(installed=bool(opts.installed or opts.category))
    if opts.shelves:
        for shelf_id, _name, apps in catalog.shelves(read_featured()):
            for app in apps:
                print(f"{shelf_id}\t{app['id']}\t{app['name']}")
    elif opts.installed:
        print_apps(catalog, catalog.installed())
    elif opts.category:
        print_apps(catalog, catalog.category(opts.category))
    else:
        counts = catalog.category_counts()
        for category_id, name, _icon, _names in CATEGORIES:
            if category_id != "web":        # web apps are the window's only
                print(f"{category_id}\t{name}\t{counts[category_id]}")
    return 0


def print_item(item):
    """A file's page as `field<TAB>value` lines (cmd_info --file)."""
    for field in ("file", "kind", "name", "version", "arch", "summary", "size", "maker", "homepage", "url",
                  "refused"):
        if item.get(field):
            print(f"{field}\t{item[field]}")
    for note in item["notes"]:
        print(f"note\t{note}")
    for words in item["permissions"]:
        print(f"can\t{words}")


def cmd_info(opts):
    if opts.file:
        for path in opts.file:
            print_item(inspect_file(path))
        return 0
    catalog = open_catalog()
    app = app_or_error(catalog, opts.app)
    source = choose_source(catalog, app, opts.source)
    page = catalog.page(app, source)
    lines = [("id", app["id"]), ("name", app["name"]), ("summary", app["summary"]),
             ("sources", ",".join(s for s in SOURCES if s in app["src"])), ("source", source),
             ("installed", catalog.installed_from(app) or ""),
             ("package" if source in APT_SOURCES else "ref",
              app["src"][source].get("pkg") or app["src"][source].get("ref")),
             ("developer", page["dev"]), ("license", page["license"]), ("homepage", page["home"]),
             ("version", page["version"])]
    paid = app.get("paid")
    if paid:
        lines += [("price", paid["price"]), ("buy", paid["buy"])] + \
            ([("product", paid["product"])] if paid["product"] else [])
    lines += [("screenshot", shot["url"]) for shot in page["shots"]]
    if kit_note(app):
        lines.append(("note", kit_note(app)))
    lines += [("description", text) for text in page["desc"]]
    for key, value in lines:
        print(f"{key}\t{value}")
    return 0


def cmd_index(opts):
    catalog = Catalog()
    with contextlib.suppress(SoftwareError):
        catalog.load()
    if not opts.force and not catalog.stale():
        return 0
    with index_lock():
        counts = build_index()
    for key, value in counts.items():
        print(f"{key}\t{value}")
    return 0


def cmd_refresh(opts):
    for source in refresh(opts.force):
        print(f"fetched\t{source}")
    return cmd_index(argparse.Namespace(force=False))


def cmd_plan_files(opts):
    plan = plan_files(opts.file, open_catalog())
    if opts.json:
        print(json.dumps(plan))
        return 1 if all(i["refused"] for i in plan["items"]) else 0
    for item in plan["items"]:
        print_item(item)
        print()
    words = files_plan_words(plan, human_size)
    if words:
        print(words)
    return 1 if all(i["refused"] for i in plan["items"]) else 0


def cmd_plan(opts):
    if opts.file:
        return cmd_plan_files(opts)
    if not opts.app:
        raise SoftwareError("plan needs an app or --file FILE")
    catalog = open_catalog()
    app = app_or_error(catalog, opts.app)
    source = choose_source(catalog, app, opts.source)
    if source in APT_SOURCES:
        plan = apt_plan(catalog, app, opts.remove, source)
    else:
        plan = flatpak_plan(catalog, app, opts.remove)
    if opts.json:
        print(json.dumps(plan))
        return 0
    action = "remove" if opts.remove else "install"
    print(f"{action}\t{plan['app']}\t{SOURCE_NAMES[source]}")
    for package in plan["packages"]:
        print(f"package\t{package}")
    for item in plan["items"]:
        print(f"{item['type']}\t{item['ref']}\t{human_size(item['download'])}\t{human_size(item['size'])}")
    if plan["download"]:
        print(f"download\t{human_size(plan['download'])}")
    print(f"{'frees' if opts.remove else 'size'}\t{human_size(plan['size'])}")
    adds = plan.get("adds")
    if adds and not adds["on"]:
        print(f"adds\t{adds['what']}\t{human_size(adds['download'])}\t{human_size(adds['size'])}")
    if plan.get("turns_off"):
        print(f"turns off\t{OTHER_ARCH[plan['package']]['what']}")
    for package in plan["protected"]:
        print(f"refused\t{package} is part of the FlickOS desktop")
    return 1 if plan["protected"] else 0


def cmd_change(opts):
    remove = opts.command == "remove"
    out = Output(opts.json)
    if opts.file:
        if remove:
            raise SoftwareError("--file works with install only")
        return cmd_install_files(opts, out)
    if not opts.app:
        raise SoftwareError(f"{opts.command} needs an app or --file FILE")
    try:
        catalog = open_catalog()
        app = app_or_error(catalog, opts.app)
        source = choose_source(catalog, app, opts.source)
        if source == STORE and not remove and catalog.locked(app):
            raise SoftwareError(f"{app['name']} is sold in the FlickOS Store: buy it first ({app['paid']['buy']})")
        if source in APT_SOURCES:
            apt_change(catalog, app, remove, out, source)
        else:
            flatpak_change(catalog, app, remove, out)
    except Cancelled:
        out.emit("cancelled")
        return 1
    except SoftwareError as error:
        out.emit("error", message=str(error))
        raise
    out.emit("done")
    return 0


def cmd_install_files(opts, out):
    try:
        failed = files_change(opts.file, out)
    except Cancelled:
        out.emit("cancelled")
        return 1
    except SoftwareError as error:
        out.emit("error", message=str(error))
        raise
    out.emit("done", failed=failed)
    return 1 if failed else 0


def cmd_open(opts):
    """Open the window on files, or hand them to the window that is open."""
    paths = [os.path.abspath(p) for p in opts.files]
    try:
        with single_instance() as first:
            if not first:
                spool_files(paths)
                return 0
            opts.app = opts.search = None
            opts.installed = False
            return window(opts)
    except SoftwareError as error:
        warn(str(error))
        return 1


def cmd_paid(opts):
    if opts.paid_command == "set":
        set_paid(opts.value)
    else:
        print(paid_setting()[0])
    return 0


def cmd_show(opts):
    try:
        with single_instance() as first:
            if not first:
                print(f"{TITLE} is already open.")
                return 0
            return window(opts)
    except SoftwareError as error:
        warn(str(error))
        return 1


def main(argv=None):
    parser = argparse.ArgumentParser(prog=NAME, description="Find, install and remove apps.")
    commands = parser.add_subparsers(dest="command", metavar="COMMAND")
    show = commands.add_parser("show", help="open the window")
    show_what = show.add_mutually_exclusive_group()
    show_what.add_argument("--search", metavar="WORDS", help="start with a search")
    show_what.add_argument("--app", metavar="ID", help="start on an app's page")
    show_what.add_argument("--installed", action="store_true", help="start on the installed apps")
    show.set_defaults(func=cmd_show)
    search = commands.add_parser("search", help="print matching apps")
    search.add_argument("words", nargs="+")
    search.set_defaults(func=cmd_search)
    listing = commands.add_parser("list", help="print the categories, or apps")
    which = listing.add_mutually_exclusive_group()
    which.add_argument("--installed", action="store_true")
    which.add_argument("--category", choices=[c[0] for c in CATEGORIES if c[0] != "web"])
    which.add_argument("--shelves", action="store_true", help="the front page's shelves")
    listing.set_defaults(func=cmd_list)
    info = commands.add_parser("info", help="print an app's page")
    info.add_argument("--source", choices=SOURCES)
    info.add_argument("app", metavar="ID", nargs="?")
    info.add_argument("--file", action="append", metavar="FILE", help="a package or Flatpak file, not an app")
    info.set_defaults(func=cmd_info)
    index = commands.add_parser("index", help="rebuild the index when a catalog changed")
    index.add_argument("--force", action="store_true")
    index.set_defaults(func=cmd_index)
    fetch = commands.add_parser("refresh", help="fetch missing or old catalogs, then index")
    fetch.add_argument("--force", action="store_true")
    fetch.set_defaults(func=cmd_refresh)
    plan = commands.add_parser("plan", help="what installing or removing an app changes")
    plan.add_argument("--remove", action="store_true")
    plan.set_defaults(func=cmd_plan)
    install = commands.add_parser("install", help="install an app")
    install.set_defaults(func=cmd_change)
    remove = commands.add_parser("remove", help="remove an app")
    remove.set_defaults(func=cmd_change)
    for sub in (plan, install, remove):
        sub.add_argument("--json", action="store_true", help="print JSON")
        sub.add_argument("--source", choices=SOURCES)
        sub.add_argument("app", metavar="ID", nargs="?")
        sub.add_argument("--file", action="append", metavar="FILE",
                         help=".deb, .flatpak, .flatpakref or .flatpakrepo file (repeat for more)")
    open_files = commands.add_parser("open", help="show .deb and Flatpak files, to install them")
    open_files.add_argument("files", nargs="+", metavar="FILE")
    open_files.set_defaults(func=cmd_open)
    paid = commands.add_parser("paid", help="whether apps with a price show")
    paid_commands = paid.add_subparsers(dest="paid_command", metavar="COMMAND", required=True)
    paid_commands.add_parser("current", help="print on or off")
    paid_set = paid_commands.add_parser("set", help="show apps with a price or not")
    paid_set.add_argument("value", choices=CHOICES + (DEFAULT_CHOICE,))
    paid.set_defaults(func=cmd_paid)
    argv = list(sys.argv[1:] if argv is None else argv)
    # No command, or only show's options: show.
    if not argv or argv[0].startswith("--") and argv[0] not in ("-h", "--help"):
        argv.insert(0, "show")
    opts = parser.parse_args(argv)
    try:
        return opts.func(opts)
    except SoftwareError as error:
        warn(str(error))
        return 1
    finally:
        fire_changed()        # the change is applied now (ADR-007)


# --- The window ----------------------------------------------------------------------

def load_gtk():
    """(GLib, Gio, Gtk, Gdk, GdkPixbuf, Pango), or None without GTK 3 or a display."""
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("GdkPixbuf", "2.0")
        gi.require_version("Pango", "1.0")
        from gi.repository import GLib
        GLib.set_prgname(APP_ID)
        from gi.repository import Gdk, GdkPixbuf, Gio, Gtk, Pango
    except (ImportError, ValueError) as error:
        warn(f"GTK 3 is not available ({error})")
        return None
    if not Gtk.init_check(sys.argv[:1])[0]:
        warn("cannot open a window (no display)")
        return None
    return GLib, Gio, Gtk, Gdk, GdkPixbuf, Pango


def image_path(url):
    """Where a downloaded icon or screenshot is kept."""
    digest = hashlib.sha256(url.encode()).hexdigest()[:32]
    return os.path.join(cache_dir(), "images", digest)


def fetch(url):
    """Download url into the image cache (once); returns the file's path.
    Raises OSError or ValueError."""
    path = image_path(url)
    if os.path.exists(path):
        return path
    if not url.startswith(("https://", "http://")):
        raise ValueError(f"not a web address: {url}")
    request = urllib.request.Request(url, headers={"User-Agent": "FlickOS-Software"})
    with urllib.request.urlopen(request, timeout=FETCH_SECONDS) as response:
        data = response.read(IMAGE_BYTES + 1)
    if len(data) > IMAGE_BYTES:
        raise ValueError(f"{url} is larger than {IMAGE_BYTES} bytes")
    write_atomic(path, data)
    return path


def window(opts):
    gtk = load_gtk()
    if gtk is None:
        return 1
    with contextlib.suppress(locale.Error):
        locale.setlocale(locale.LC_ALL, "")
    app = Software(gtk, opts)
    app.run()
    return 0


class Software:
    """The window: Explore (categories and picks), a list (a category, a
    search, the installed apps) and an app's page, with Back between them."""

    def __init__(self, gtk, opts):
        self.GLib, self.Gio, self.Gtk, self.Gdk, self.GdkPixbuf, self.Pango = gtk
        Gtk = self.Gtk
        self.opts = opts
        self.catalog = Catalog()
        self.history = []           # views to go back to: (kind, argument)
        self.view = None
        self.icons = {}             # (icon specs, size) -> GdkPixbuf or None while fetching
        self.fetching = set()
        self.fetch_lock = threading.Lock()
        self.fetch_queue = []
        self.fetchers = 0
        self.child = None           # the running install/remove: (process, app, action)
        self.claim = None           # Buy… waiting for the payment's key: (process, app, {"stopped": bool})
        self.adding_key = False     # Add Key… running
        self.lookup = None          # the running flickos-switch lookup
        # Web apps (phase 3b): only with Firefox and flickos-switch.
        self.web_on = bool(shutil.which(FIREFOX) and shutil.which(SWITCH))
        self.web_read = None        # the running webapp list
        self.web_text = None        # its last answer, to show again only when it changed
        self.web_rows = []          # web_rows() of it, set again in each new catalog
        self.child_can_cancel = False
        self.files = []             # the files page (ADR-012): their items (plan_files()), in order
        self.file_status = {}       # path -> what happened to it: (kind, message)
        self.files_plan = None
        self.queued_files = []      # opened before the catalog or while another install ran
        self.files_busy = False     # a files plan is being read
        self.catalog_shown = False  # the first catalog was read: queued files may open now
        self.spool_monitor = None
        self.page_app = None
        self.page_source = None
        self.featured = []          # read_featured()'s shelves
        self.reads = {}
        self.theme = Gtk.IconTheme.get_default()

        win = self.win = Gtk.Window(title=TITLE, icon_name=ICON)
        win.set_default_size(*DEFAULT_SIZE)
        win.connect("delete-event", self.on_delete)
        win.connect("destroy", lambda _w: Gtk.main_quit())
        win.connect("key-press-event", self.on_key)
        win.connect("notify::is-active", self.on_active)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        win.add(outer)
        bar = Gtk.Box(spacing=6, margin=6)
        outer.pack_start(bar, False, False, 0)
        outer.pack_start(Gtk.Separator(), False, False, 0)

        self.back = Gtk.Button.new_from_icon_name("go-previous-symbolic", Gtk.IconSize.BUTTON)
        self.back.set_tooltip_text("Back (Alt+Left)")
        self.back.get_accessible().set_name("Back")
        self.back.connect("clicked", lambda _b: self.go_back())
        self.back.set_sensitive(False)
        bar.pack_start(self.back, False, False, 0)

        sections = Gtk.Box()
        sections.get_style_context().add_class("linked")
        self.explore_button = Gtk.RadioButton.new_with_mnemonic(None, "_Explore")
        self.installed_button = Gtk.RadioButton.new_with_mnemonic_from_widget(self.explore_button, "Installe_d")
        for button, kind in ((self.explore_button, "explore"), (self.installed_button, "installed")):
            button.set_mode(False)
            button.connect("toggled", self.on_section, kind)
            sections.pack_start(button, False, False, 0)
        bar.set_center_widget(sections)

        # The window's menu: the setting Software owns (ADR-007).
        menu = Gtk.Menu()
        self.paid_item = Gtk.CheckMenuItem.new_with_mnemonic("Show _Paid Apps")
        self.paid_item.set_active(paid_setting()[0] == "on")
        self.paid_item.connect("toggled", self.on_paid_toggled)
        menu.append(self.paid_item)
        menu.show_all()
        menu_button = Gtk.MenuButton(popup=menu)
        menu_button.add(Gtk.Image.new_from_icon_name("open-menu-symbolic", Gtk.IconSize.BUTTON))
        menu_button.set_tooltip_text("Menu")
        menu_button.get_accessible().set_name("Menu")
        bar.pack_end(menu_button, False, False, 0)

        self.search = Gtk.SearchEntry(placeholder_text="Search apps")
        self.search.set_tooltip_text("Search (Ctrl+F)")
        self.search.get_accessible().set_name("Search apps")
        self.search.set_width_chars(24)
        self.search.connect("search-changed", self.on_search)
        self.search.connect("stop-search", lambda _e: self.search.set_text(""))
        bar.pack_end(self.search, False, False, 0)

        self.notice = Gtk.InfoBar(message_type=Gtk.MessageType.ERROR, no_show_all=True, show_close_button=True)
        self.notice.connect("response", lambda bar, _r: bar.hide())
        self.notice_text = Gtk.Label(xalign=0, wrap=True, selectable=True)
        self.notice.get_content_area().add(self.notice_text)
        self.notice_text.show()
        outer.pack_start(self.notice, False, False, 0)

        self.stack = Gtk.Stack(homogeneous=False, transition_type=Gtk.StackTransitionType.CROSSFADE)
        outer.pack_start(self.stack, True, True, 0)
        self.stack.add_named(self.build_loading(), "loading")
        self.stack.add_named(self.build_explore(), "explore")
        self.stack.add_named(self.build_list(), "list")
        self.stack.add_named(self.build_page(), "app")
        self.stack.add_named(self.build_files(), "files")

        self.status = Gtk.Label(xalign=0, margin=6, wrap=True, selectable=True, no_show_all=True)
        self.status.get_style_context().add_class("dim-label")
        outer.pack_start(self.status, False, False, 0)

    # --- Starting -------------------------------------------------------------------

    def run(self):
        self.win.show_all()
        self.stack.set_visible_child_name("loading")
        self.background(self.read_catalog, self.catalog_read, key="catalog")
        self.read_web()
        self.queued_files += list(getattr(self.opts, "files", None) or [])
        self.watch_spool()
        self.Gtk.main()

    def read_catalog(self):
        """In a thread: the index, what is installed and the shelves. Returns a
        new Catalog (or the error when there is no usable index)."""
        catalog = Catalog()
        with contextlib.suppress(SoftwareError):    # no index yet: update_catalogs() makes one
            catalog.load()
            catalog.prepare_search()
        catalog.read_installed()
        catalog.featured, paid = load_featured()
        catalog.set_paid(paid)
        catalog.show_paid = paid_setting()[0] == "on"
        return catalog

    def catalog_read(self, catalog, error, updated=False):
        """The catalog read in a thread: show it. updated: after update_catalogs()."""
        if error:
            self.show_error(f"The list of apps couldn't be read: {error}")
            self.catalog_shown = True
            self.open_queued_files()
            return
        first = not self.catalog.loaded
        self.catalog_shown = True
        if self.catalog is not catalog:
            self.catalog.close()
        self.catalog = catalog
        catalog.set_web(self.web_rows)
        self.featured = catalog.featured
        if catalog.loaded and catalog.apps:
            self.show_catalog(first)
        elif updated:
            self.loading_spinner.hide()
            self.loading_text.set_text("No apps are known yet: the lists of apps couldn't be fetched. "
                                       "Check the network connection and open Software again.")
        if first and not updated and self.update_catalogs() != "refresh":
            self.update_featured()      # refresh fetches it too
        self.open_queued_files()

    def update_catalogs(self):
        """Fetch missing or old catalogs, or rebuild a stale index, in a child.
        Returns the command it runs, or None."""
        if fetch_needed():
            command, words = "refresh", "Getting the list of apps…"
        elif self.catalog.stale():
            command, words = "index", "Updating the list of apps…"
        else:
            return None
        if not self.catalog.loaded:
            self.loading_text.set_text(words)
        else:
            self.set_status(words)

        def done(ok, _stdout, stderr):
            self.set_status("")
            if not ok and not self.catalog.loaded:
                self.loading_spinner.hide()
                self.loading_text.set_text("The list of apps couldn't be made. " + last_line(stderr)
                                           + " Check the network connection and open Software again.")
                return
            self.background(self.read_catalog, lambda c, e: self.catalog_read(c, e, updated=True), key="catalog")

        self.run_child([command], done)
        return command

    def update_featured(self):
        """Fetch featured.json and the store's catalog in a thread when they
        are old; show the new shelves and prices when they changed, and index
        the store's apps again when its catalog did."""
        if not featured_stale() and not store_catalog_stale():
            return

        def done(changed, error):
            if error:
                warn(f"The front page's shelves weren't updated: {error}")
                return
            if changed["featured"]:
                self.featured, paid = load_featured()
                self.catalog.set_paid(paid)
                if self.catalog.loaded:
                    self.fill_explore()
                    self.refresh_view()
            if changed[STORE] and self.child is None:
                self.update_catalogs()

        self.background(fetch_shop, done, key="featured")

    def read_web(self):
        """Firefox's web apps and the list's web versions (`flickos-switch
        webapp list --json --known`) in a child, one at a time; the view is
        shown again when they changed."""
        Gio, GLib = self.Gio, self.GLib
        if not self.web_on or self.web_read is not None:
            return
        try:
            process = Gio.Subprocess.new([SWITCH, "webapp", "list", "--json", "--known"],
                                         Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            return
        self.web_read = process

        def finished(_process, result):
            self.web_read = None
            try:
                _, stdout, _ = process.communicate_utf8_finish(result)
            except GLib.Error:
                return
            if not process.get_successful() or stdout == self.web_text:
                return
            try:
                rows = web_rows(json.loads(stdout or "[]"))
            except ValueError as error:
                warn(f"{SWITCH} webapp list's answer wasn't understood: {error}")
                return
            self.web_text, self.web_rows = stdout, rows
            self.catalog.set_web(rows)
            if self.catalog.loaded:
                self.refresh_view()

        process.communicate_utf8_async(None, None, finished)

    def on_active(self, win, _pspec):
        """Back in the window: the user may have made or removed a web app in
        Firefox, changed the paid setting elsewhere (History's Undo), added or
        removed a key in Settings, or installed an app in a terminal."""
        if win.is_active():
            self.read_web()
            self.show_paid(paid_setting()[0] == "on")
            if self.catalog.loaded and self.child is None:
                self.background(self.read_installed, self.installed_changed, key="installed")

    def on_paid_toggled(self, item):
        try:
            set_paid("on" if item.get_active() else "off")
        except SoftwareError as error:
            self.show_error(str(error))
        self.show_paid(paid_setting()[0] == "on")
        fire_changed()              # shown now (hooks, ADR-007)

    def show_paid(self, on):
        """The paid setting in force: the menu's check item and the lists."""
        if self.paid_item.get_active() != on:
            self.paid_item.handler_block_by_func(self.on_paid_toggled)
            self.paid_item.set_active(on)
            self.paid_item.handler_unblock_by_func(self.on_paid_toggled)
        if self.catalog.show_paid == on:
            return
        self.catalog.show_paid = on
        if self.catalog.loaded:
            self.fill_explore()
            self.refresh_view()

    def show_catalog(self, first):
        self.fill_explore()
        if first:
            if self.opts.app and self.catalog.find(self.opts.app):
                self.go("explore", None, remember=False)
                self.go("app", self.catalog.find(self.opts.app)["id"])
            elif self.opts.search:
                self.go("explore", None, remember=False)
                self.search.set_text(self.opts.search)
            elif self.opts.installed:
                self.installed_button.set_active(True)
            else:
                self.go("explore", None, remember=False)
            self.search.grab_focus()
        else:
            self.refresh_view()

    # --- Helpers --------------------------------------------------------------------

    def background(self, work, done, key=None):
        """work() in a thread, then done(result, error) in the main loop; of
        calls with the same key only the newest one's done() runs."""
        number = self.reads[key] = self.reads.get(key, 0) + 1

        def finish(result, error):
            if self.reads[key] == number:
                done(result, error)
            return False

        def thread():
            try:
                result, error = work(), None
            except (SoftwareError, OSError, ValueError) as failure:
                result, error = None, str(failure)
            except Exception as failure:    # a bug: say so instead of loading forever
                traceback.print_exc()
                result, error = None, f"{type(failure).__name__}: {failure}"
            self.GLib.idle_add(finish, result, error)

        threading.Thread(target=thread, daemon=True).start()

    def run_child(self, args, done, lines=None):
        """Run this program with args, without blocking the window; lines(line)
        for each line of its output when given; then done(ok, stdout, stderr)."""
        Gio, GLib = self.Gio, self.GLib
        command = [sys.executable, os.path.abspath(sys.argv[0])] if os.path.exists(sys.argv[0]) else [NAME]
        flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE
        try:
            process = Gio.Subprocess.new(command + list(args), flags)
        except GLib.Error as error:
            done(False, "", error.message)
            return None
        if lines is None:
            def finished(process, result):
                try:
                    _, stdout, stderr = process.communicate_utf8_finish(result)
                    ok = process.get_successful()
                except GLib.Error as error:
                    stdout, stderr, ok = "", error.message, False
                done(ok, stdout or "", stderr or "")
            process.communicate_utf8_async(None, None, finished)
            return process
        stream = Gio.DataInputStream.new(process.get_stdout_pipe())
        errors = []

        def read_errors(stream_, result):
            try:
                data = stream_.read_bytes_finish(result)
            except GLib.Error:
                return
            if data.get_size():
                errors.append(data.get_data().decode("utf-8", "replace"))
                stream_.read_bytes_async(65536, GLib.PRIORITY_DEFAULT, None, read_errors)

        process.get_stderr_pipe().read_bytes_async(65536, GLib.PRIORITY_DEFAULT, None, read_errors)

        def wait_done(process, result):
            try:
                process.wait_finish(result)
                ok = process.get_successful()
            except GLib.Error:
                ok = False
            done(ok, "", "".join(errors))

        def read_line(stream_, result):
            try:
                line, _length = stream_.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:
                process.wait_async(None, wait_done)
                return
            lines(line)
            stream_.read_line_async(GLib.PRIORITY_DEFAULT, None, read_line)

        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, read_line)
        return process

    def label(self, text="", dim=False, wrap=True, markup=False, selectable=False):
        label = self.Gtk.Label(xalign=0, wrap=wrap, selectable=selectable)
        if wrap:
            label.set_line_wrap_mode(self.Pango.WrapMode.WORD_CHAR)
        if markup:
            label.set_markup(text)
        else:
            label.set_text(text)
        if dim:
            label.get_style_context().add_class("dim-label")
        return label

    def heading(self, text):
        return self.label(f"<b>{self.GLib.markup_escape_text(text)}</b>", markup=True)

    def spinner(self):
        """A spinner that turns while it is on screen (shown, its page shown).
        GTK 3 keeps animating an active spinner on a stack page that isn't
        shown, 60 redraws a second (HIG CODE-10)."""
        spinner = self.Gtk.Spinner()
        spinner.connect("map", lambda s: s.start())
        spinner.connect("unmap", lambda s: s.stop())
        return spinner

    def scrolled(self, child):
        scrolled = self.Gtk.ScrolledWindow(hscrollbar_policy=self.Gtk.PolicyType.NEVER)
        scrolled.add(child)
        return scrolled

    def set_status(self, text):
        self.status.set_text(text)
        self.status.set_visible(bool(text))

    def show_error(self, text):
        self.notice_text.set_text(text)
        self.notice.show()

    # --- Icons ----------------------------------------------------------------------

    def icon(self, specs, size, redraw):
        """A pixbuf for an app's icon specs at size: the theme's icon by name,
        then a catalog file, then a download (started here; redraw() runs when
        it arrives). The generic app icon meanwhile and when none works."""
        key = (tuple(specs), size)
        if key not in self.icons:
            self.icons[key] = self.find_icon(list(specs), size, redraw, key)
        return self.icons[key] or self.generic_icon(size)

    def find_icon(self, specs, size, redraw, key):
        """The first of specs that gives a pixbuf; None while one downloads."""
        GdkPixbuf, GLib = self.GdkPixbuf, self.GLib
        while specs:
            kind, _, value = specs.pop(0).partition(":")
            try:
                if kind == "stock" and self.theme.has_icon(value):
                    return self.theme.load_icon(value, size, self.Gtk.IconLookupFlags.FORCE_SIZE)
                if kind == "flathub":
                    kind, value = "file", os.path.join(FLATHUB_CATALOG, "icons", value)
                if kind == "file" and os.path.exists(value):
                    return GdkPixbuf.Pixbuf.new_from_file_at_size(value, size, size)
                if kind == "url":
                    path = image_path(value)
                    if os.path.exists(path):
                        return GdkPixbuf.Pixbuf.new_from_file_at_size(path, size, size)
                    rest = list(specs)
                    self.queue_fetch(value, lambda path, k=key, r=rest: self.icon_fetched(k, path, r, redraw))
                    return None
            except GLib.Error:
                continue
        return self.generic_icon(size)

    def icon_fetched(self, key, path, rest, redraw):
        pixbuf = None
        if path:
            with contextlib.suppress(self.GLib.Error):
                pixbuf = self.GdkPixbuf.Pixbuf.new_from_file_at_size(path, key[1], key[1])
        # Not downloaded: the specs after it (they may download in turn).
        self.icons[key] = pixbuf or self.find_icon(rest, key[1], redraw, key)
        redraw()

    def generic_icon(self, size):
        key = ("generic", size)
        if key not in self.icons:
            self.icons[key] = self.theme.load_icon("application-x-executable", size,
                                                   self.Gtk.IconLookupFlags.FORCE_SIZE)
        return self.icons[key]

    def queue_fetch(self, url, done):
        """Download url in one of a few threads, newest request first (the rows
        just scrolled to); done(path or None) in the main loop."""
        with self.fetch_lock:
            if url in self.fetching:
                return
            self.fetching.add(url)
            self.fetch_queue.append((url, done))
            if self.fetchers >= 4:
                return
            self.fetchers += 1

        def thread():
            while True:
                with self.fetch_lock:
                    if not self.fetch_queue:
                        self.fetchers -= 1
                        return
                    url, done = self.fetch_queue.pop()
                try:
                    path = fetch(url)
                except (OSError, ValueError) as error:
                    warn(f"{url}: {error}")
                    path = None
                self.GLib.idle_add(lambda d=done, p=path, u=url: (self.fetching.discard(u), d(p), False)[2])

        threading.Thread(target=thread, daemon=True).start()

    # --- Navigation -----------------------------------------------------------------

    def go(self, kind, argument, remember=True):
        """Show a view: explore, category ID, search WORDS, installed, app ID."""
        if remember and self.view is not None and self.view != (kind, argument):
            if self.view[0] == "search" and kind == "search":
                pass                # typing doesn't fill the history
            else:
                self.history.append(self.view)
        self.view = (kind, argument)
        self.back.set_sensitive(bool(self.history))
        if kind == "explore":
            self.stack.set_visible_child_name("explore")
        elif kind == "app":
            app = self.catalog.find(argument)
            if app is None:
                self.go_back()
                return
            self.show_page(app)
            self.stack.set_visible_child_name("app")
        elif kind == "files":
            self.stack.set_visible_child_name("files")
        else:
            self.fill_list(kind, argument)
            self.stack.set_visible_child_name("list")
        section = self.installed_button if kind == "installed" else self.explore_button
        if not section.get_active() and kind in ("explore", "installed"):
            section.handler_block_by_func(self.on_section)
            section.set_active(True)
            section.handler_unblock_by_func(self.on_section)

    def go_back(self):
        if not self.history:
            return
        kind, argument = self.history.pop()
        if kind == "search" and self.search.get_text() != argument:
            self.search.handler_block_by_func(self.on_search)
            self.search.set_text(argument)
            self.search.handler_unblock_by_func(self.on_search)
        elif kind != "search" and self.search.get_text():
            self.search.handler_block_by_func(self.on_search)
            self.search.set_text("")
            self.search.handler_unblock_by_func(self.on_search)
        self.go(kind, argument, remember=False)

    def refresh_view(self):
        """Show the current view again (the catalog or what's installed changed)."""
        if self.view is None:
            return
        kind, argument = self.view
        if kind == "app":
            app = self.catalog.find(argument)
            if app is not None:
                self.show_page(app, keep_source=True)
            elif self.history:
                self.go_back()      # a web app removed in Firefox
            else:
                self.go("explore", None, remember=False)
        elif kind not in ("explore", "files"):
            self.fill_list(kind, argument)

    def on_section(self, button, kind):
        if not button.get_active() or not self.catalog.loaded:
            return
        if self.search.get_text():
            self.search.handler_block_by_func(self.on_search)
            self.search.set_text("")
            self.search.handler_unblock_by_func(self.on_search)
        self.go(kind, None)

    def on_search(self, entry):
        if not self.catalog.loaded:
            return
        text = entry.get_text().strip()
        if text:
            self.go("search", text)
        elif self.view and self.view[0] == "search":
            self.go_back() if self.history else self.go("explore", None, remember=False)

    def on_key(self, _widget, event):
        Gdk = self.Gdk
        state = event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK
                               | Gdk.ModifierType.SHIFT_MASK)
        if event.keyval == Gdk.KEY_Escape:
            # HIG A11Y-2: clear the search first, then go back.
            if self.search.get_text():
                self.search.set_text("")
            else:
                self.go_back()
            return True
        if state == Gdk.ModifierType.MOD1_MASK and event.keyval == Gdk.KEY_Left:
            self.go_back()
            return True
        if state == Gdk.ModifierType.CONTROL_MASK and event.keyval in (Gdk.KEY_f, Gdk.KEY_F):
            self.search.grab_focus()
            return True
        # Typing anywhere searches (like the start menu).
        if not self.search.has_focus() and self.search.handle_event(event):
            self.search.grab_focus_without_selecting()
            return True
        return False

    def on_delete(self, _win, _event):
        """Closing while an app installs, or while Buy… waits for a payment,
        asks first: closing stops it."""
        if self.claim is not None:
            Gtk = self.Gtk
            app = self.claim[1]
            dialog = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.QUESTION,
                                       text=f"Stop Waiting for the Payment of {app['name']}?")
            dialog.format_secondary_text("Software is waiting for the key of your purchase. If you have paid, "
                                         "the receipt email's order number gets the key from the store's page; "
                                         "then Add Key… adds it.")
            dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
            stop = dialog.add_button("_Stop and Close", Gtk.ResponseType.ACCEPT)
            stop.get_style_context().add_class("destructive-action")
            dialog.set_default_response(Gtk.ResponseType.CANCEL)
            answer = dialog.run()
            dialog.destroy()
            if answer != Gtk.ResponseType.ACCEPT:
                return True
            self.stop_claim()
        if self.child is None:
            return False
        Gtk = self.Gtk
        _process, app, action = self.child
        words = {"install": ("Stop Installing", "installed"), "remove": ("Stop Removing", "removed")}[action]
        dialog = Gtk.MessageDialog(transient_for=self.win, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   text=f"{words[0]} {app['name']}?")
        dialog.format_secondary_text(f"{app['name']} is still being {words[1]}. "
                                     "Closing Software stops it where it can be stopped.")
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        stop = dialog.add_button("_Stop and Close", Gtk.ResponseType.ACCEPT)
        stop.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        answer = dialog.run()
        dialog.destroy()
        if answer != Gtk.ResponseType.ACCEPT:
            return True
        with contextlib.suppress(Exception):
            self.child[0].send_signal(signal.SIGTERM)
        return False

    # --- Loading view ---------------------------------------------------------------

    def build_loading(self):
        Gtk = self.Gtk
        box = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, margin=24)
        self.loading_spinner = self.spinner()
        box.pack_start(self.loading_spinner, False, False, 0)
        self.loading_text = self.label("Loading apps…", dim=True)
        self.loading_text.set_max_width_chars(60)
        box.pack_start(self.loading_text, False, False, 0)
        return box

    # --- Explore --------------------------------------------------------------------

    def build_explore(self):
        Gtk = self.Gtk
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=24)
        box.pack_start(self.heading("Categories"), False, False, 0)
        categories = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                                 column_spacing=12, row_spacing=12, min_children_per_line=2,
                                 max_children_per_line=5)
        for category_id, name, icon, _names in CATEGORIES:
            if category_id == "web" and not self.web_on:
                continue
            button = Gtk.Button()
            inner = Gtk.Box(spacing=10, margin=6)
            inner.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DND), False, False, 0)
            inner.pack_start(self.label(name, wrap=True), False, False, 0)
            button.add(inner)
            button.get_accessible().set_name(name)
            button.connect("clicked", lambda _b, c=category_id: self.go("category", c))
            categories.add(button)
        box.pack_start(categories, False, False, 0)
        # featured.json's shelves (Made for FlickOS, Apps to start with), in its order.
        self.shelves_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.shelves_box, False, False, 0)
        return self.scrolled(box)

    def fill_explore(self):
        Gtk = self.Gtk
        for child in self.shelves_box.get_children():
            child.destroy()
        for _shelf_id, name, apps in self.catalog.shelves(self.featured):
            heading = self.heading(name)
            heading.set_margin_top(6)
            self.shelves_box.pack_start(heading, False, False, 0)
            tiles = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                                column_spacing=12, row_spacing=12, min_children_per_line=1,
                                max_children_per_line=3)
            self.shelves_box.pack_start(tiles, False, False, 0)
            self.fill_shelf(tiles, apps)
        self.shelves_box.show_all()

    def fill_shelf(self, tiles, apps):
        Gtk = self.Gtk
        for app in apps:
            button = Gtk.Button()
            inner = Gtk.Box(spacing=12, margin=6)
            image = Gtk.Image()

            def redraw(image=image, specs=app["icons"]):
                image.set_from_pixbuf(self.icon(specs, TILE_ICON, lambda: None))

            image.set_from_pixbuf(self.icon(app["icons"], TILE_ICON, redraw))
            inner.pack_start(image, False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER)
            text.pack_start(self.label(f"<b>{self.GLib.markup_escape_text(app['name'])}</b>", markup=True),
                            False, False, 0)
            summary = self.label(app["summary"], dim=True)
            summary.set_max_width_chars(30)
            summary.set_lines(2)
            summary.set_ellipsize(self.Pango.EllipsizeMode.END)
            text.pack_start(summary, False, False, 0)
            inner.pack_start(text, True, True, 0)
            button.add(inner)
            button.get_accessible().set_name(app["name"])
            button.set_tooltip_text(app["summary"])
            button.connect("clicked", lambda _b, a=app["id"]: self.go("app", a))
            tiles.add(button)

    # --- Lists ----------------------------------------------------------------------

    def build_list(self):
        """A category, a search or the installed apps: a heading and a list of
        rows. A TreeView with fixed row heights, so only the rows on screen
        are drawn and only their icons are loaded (a category has up to 1,200)."""
        Gtk = self.Gtk
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=24)
        top = Gtk.Box(spacing=12)
        self.list_title = self.heading("")
        top.pack_start(self.list_title, True, True, 0)
        # The Web Apps category's: a web app of any address.
        self.new_web_button = Gtk.Button.new_with_mnemonic("_New Web App…")
        self.new_web_button.connect("clicked", lambda _b: self.new_web_app())
        self.new_web_button.set_no_show_all(True)
        top.pack_end(self.new_web_button, False, False, 0)
        box.pack_start(top, False, False, 0)
        # A category's sentence (CATEGORY_NOTES): Security Tools' permission.
        self.list_note = self.label("", selectable=True)
        self.list_note.set_no_show_all(True)
        box.pack_start(self.list_note, False, False, 0)
        self.list_store = Gtk.ListStore(str, str)        # app id, text (markup)
        tree = self.tree = Gtk.TreeView(model=self.list_store, headers_visible=False, fixed_height_mode=True,
                                        activate_on_single_click=True, enable_search=False)
        tree.get_selection().set_mode(Gtk.SelectionMode.SINGLE)
        icon_cell = Gtk.CellRendererPixbuf(xpad=6, ypad=6)
        column = Gtk.TreeViewColumn("Icon", icon_cell)
        column.set_sizing(Gtk.TreeViewColumnSizing.FIXED)
        column.set_fixed_width(LIST_ICON + 24)
        column.set_cell_data_func(icon_cell, self.draw_list_icon)
        tree.append_column(column)
        text_cell = Gtk.CellRendererText(ellipsize=self.Pango.EllipsizeMode.END, xpad=6)
        column = Gtk.TreeViewColumn("App", text_cell, markup=1)
        column.set_sizing(Gtk.TreeViewColumnSizing.FIXED)
        column.set_expand(True)
        tree.append_column(column)
        tree.get_accessible().set_name("Apps")
        tree.connect("row-activated", self.on_row)
        self.list_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, shadow_type=Gtk.ShadowType.IN)
        self.list_scroll.add(tree)
        box.pack_start(self.list_scroll, True, True, 0)
        self.list_empty = self.label("", dim=True)
        self.list_empty.set_no_show_all(True)
        box.pack_start(self.list_empty, False, False, 0)
        # A search's answer about a Windows program (windows_answer).
        self.windows_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, no_show_all=True)
        box.pack_start(self.windows_box, False, False, 0)
        box.reorder_child(self.windows_box, 1)
        return box

    def draw_list_icon(self, _column, cell, model, it, _data):
        app = self.catalog.find(model[it][0])
        specs = app["icons"] if app else []
        cell.set_property("pixbuf", self.icon(specs, LIST_ICON, self.tree.queue_draw))

    def fill_list(self, kind, argument):
        GLib = self.GLib
        if kind == "category":
            title = next(c[1] for c in CATEGORIES if c[0] == argument)
            apps = self.catalog.category(argument)
            empty = "No apps in this category."
        elif kind == "search":
            title = f"Results for “{argument}”"
            apps = self.catalog.search(argument.split())
            empty = "No apps found. Try other words."
        else:
            title = "Installed apps"
            apps = self.catalog.installed()
            empty = "None of the apps Software knows is installed."
        shown = apps[:SEARCH_LIMIT] if kind == "search" else apps
        self.list_title.set_markup(f"<b>{GLib.markup_escape_text(title)}</b>")
        note = CATEGORY_NOTES.get(argument) if kind == "category" else None
        self.list_note.set_text(note or "")
        self.list_note.set_visible(bool(note))
        self.new_web_button.set_visible(kind == "category" and argument == "web")
        self.tree.set_model(None)       # filling a detached model is much faster
        self.list_store.clear()
        for app in shown:
            status = self.row_note(app, kind == "installed")
            text = f"<b>{GLib.markup_escape_text(app['name'])}</b>"
            if status:
                text += f"   <small>{GLib.markup_escape_text(status)}</small>"
            text += f"\n<small>{GLib.markup_escape_text(app['summary'])}</small>"
            self.list_store.append([app["id"], text])
        self.tree.set_model(self.list_store)
        self.list_scroll.set_visible(bool(shown))
        more = len(apps) - len(shown)
        self.list_empty.set_text(empty if not apps else
                                 f"{more} more. Type more words to narrow the search." if more > 0 else "")
        self.list_empty.set_visible(bool(self.list_empty.get_text()))
        self.list_scroll.get_vadjustment().set_value(0)
        self.lookup_windows(argument if kind == "search" else None, {app["id"] for app in apps})

    def lookup_windows(self, words, found):
        """Ask flickos-switch which Windows program the search names and show
        the answer above the results; nothing when it is missing, fails or
        takes over LOOKUP_MS (PERF-2: a Gio.Subprocess, the one before it
        stopped)."""
        Gio, GLib = self.Gio, self.GLib
        for child in self.windows_box.get_children():
            child.destroy()
        self.windows_box.hide()
        if self.lookup is not None:
            self.lookup.force_exit()
            self.lookup = None
        if not words:
            return
        try:
            process = Gio.Subprocess.new([SWITCH, "lookup", "--json", "--", *words.split()],
                                         Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            return                  # flickos-switch isn't installed
        self.lookup = process

        def late():
            timer.clear()
            process.force_exit()
            return False

        timer = [GLib.timeout_add(LOOKUP_MS, late)]

        def finished(_process, result):
            if timer:
                GLib.source_remove(timer.pop())
            if self.lookup is not process:
                return              # a newer search
            self.lookup = None
            try:
                _, stdout, _ = process.communicate_utf8_finish(result)
            except GLib.Error:
                return
            if not process.get_successful():    # also when late() stopped it
                return
            try:
                answer = windows_answer(json.loads(stdout or "[]"), self.catalog, found)
            except (ValueError, TypeError, AttributeError, KeyError) as error:
                warn(f"{SWITCH} lookup's answer wasn't understood: {error}")
                return
            if answer:
                self.show_windows(*answer)

        process.communicate_utf8_async(None, None, finished)

    def show_windows(self, sentence, rows):
        Gtk = self.Gtk
        self.windows_box.pack_start(self.label(sentence), False, False, 0)
        if rows:
            actions = []
            listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            listbox.get_accessible().set_name("Instead of the Windows program")
            listbox.connect("row-activated", lambda _l, row: actions[row.get_index()]())
            for kind, what, text in rows:
                image = Gtk.Image()
                if kind == "app":
                    def redraw(image=image, specs=what["icons"]):
                        image.set_from_pixbuf(self.icon(specs, LIST_ICON, lambda: None))

                    image.set_from_pixbuf(self.icon(what["icons"], LIST_ICON, redraw))
                    name = what["name"]
                    actions.append(lambda a=what["id"]: self.go("app", a))
                else:
                    image.set_from_icon_name("web-browser", Gtk.IconSize.DIALOG)
                    image.set_pixel_size(LIST_ICON)
                    name, url = what, text
                    text = "Opens in the web browser. Nothing to install."
                    actions.append(lambda u=url: self.open_web(u))
                inner = Gtk.Box(spacing=12, margin=6)
                inner.pack_start(image, False, False, 0)
                words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, valign=Gtk.Align.CENTER)
                words.pack_start(self.label(f"<b>{self.GLib.markup_escape_text(name)}</b>", markup=True),
                                 False, False, 0)
                words.pack_start(self.label(text, dim=True), False, False, 0)
                inner.pack_start(words, True, True, 0)
                row = Gtk.ListBoxRow()
                row.add(inner)
                row.get_accessible().set_name(name)
                listbox.add(row)
            frame = Gtk.Frame()
            frame.add(listbox)
            self.windows_box.pack_start(frame, False, False, 0)
        for child in self.windows_box.get_children():
            child.show_all()
        self.windows_box.show()

    def open_web(self, url):
        try:
            self.Gtk.show_uri_on_window(self.win, url, self.Gtk.get_current_event_time())
        except self.GLib.Error as error:
            self.show_error(f"{url} couldn't be opened: {error.message}")

    def status_word(self, app, installed_list=False):
        """Next to a row's name: installed, from which source when the app has
        more than one, and a source other than Debian (Flathub's apps bring
        runtimes; community apps are other developers')."""
        installed = self.catalog.installed_from(app)
        if WEB in app["src"]:
            return "Installed" if installed and not installed_list else "Web app"
        default = next(iter(self.catalog.sources(app)), "debian")
        if installed and installed != default:
            name = SOURCE_NAMES[installed]
            return f"From {name}" if installed_list else f"Installed from {name}"
        if installed:
            return "" if installed_list else "Installed"
        return "" if default == "debian" else SOURCE_NAMES[default]

    def row_note(self, app, installed_list=False):
        """status_word, and Paid · price for an app with a price that isn't installed."""
        words = [self.status_word(app, installed_list)]
        paid = app.get("paid")
        if paid and paid["product"] and paid["product"] in self.catalog.bought and \
                self.catalog.installed_from(app) is None:
            words.append("Bought")
        elif paid and not self.catalog.installed_from(app):
            words.append(f"Paid · {paid['price']}")
        return " · ".join(word for word in words if word)

    def on_row(self, _tree, path, _column):
        self.go("app", self.list_store[path][0])

    # --- An app's page --------------------------------------------------------------

    def build_page(self):
        Gtk = self.Gtk
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin=24)
        top = Gtk.Box(spacing=18)
        self.page_icon = Gtk.Image(valign=Gtk.Align.START)
        top.pack_start(self.page_icon, False, False, 0)
        names = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.page_name = self.label("", selectable=True)
        self.page_summary = self.label("", selectable=True)
        self.page_developer = self.label("", dim=True, selectable=True)
        for label in (self.page_name, self.page_summary, self.page_developer):
            names.pack_start(label, False, False, 0)
        top.pack_start(names, True, True, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, valign=Gtk.Align.START)
        buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END)
        self.install_button = Gtk.Button.new_with_mnemonic("_Install")
        self.install_button.get_style_context().add_class("suggested-action")
        self.install_button.connect("clicked", lambda _b: self.change("install"))
        self.open_button = Gtk.Button.new_with_mnemonic("_Open")
        self.open_button.connect("clicked", lambda _b: self.open_app())
        self.remove_button = Gtk.Button.new_with_mnemonic("_Remove")
        self.remove_button.connect("clicked", lambda _b: self.change("remove"))
        # An installed kit: the Tool Kits window on its row (flickos-dev.md, ADR-002).
        self.setup_button = Gtk.Button.new_with_mnemonic("_Set Up…")
        self.setup_button.connect("clicked", lambda _b: self.set_up())
        # An app installed without its other architecture's part (OTHER_ARCH): add it.
        self.parts_button = Gtk.Button.new_with_mnemonic("")
        self.parts_button.get_style_context().add_class("suggested-action")
        self.parts_button.connect("clicked", lambda _b: self.change("install"))
        self.cancel_button = Gtk.Button.new_with_mnemonic("_Cancel")
        self.cancel_button.connect("clicked", lambda _b: self.cancel_change())
        # An app with a price (featured.json): its buy address, in the browser.
        self.buy_button = Gtk.Button.new_with_mnemonic("_Buy…")
        self.buy_button.connect("clicked", lambda _b: self.buy())
        # Bought on the website or another computer (phase 3c): its key.
        self.key_button = Gtk.Button.new_with_mnemonic("Add _Key…")
        self.key_button.set_tooltip_text("Bought it? Add the key from the page or the email of your purchase")
        self.key_button.connect("clicked", lambda _b: self.add_key())
        # An installed style: Try (until logout) and Use (flickos-layout, ADR-012).
        self.try_button = Gtk.Button.new_with_mnemonic("_Try")
        self.try_button.set_tooltip_text("Use it until you log out")
        self.try_button.connect("clicked", lambda _b: self.use_style("try"))
        self.use_button = Gtk.Button.new_with_mnemonic("_Use")
        self.use_button.get_style_context().add_class("suggested-action")
        self.use_button.connect("clicked", lambda _b: self.use_style("set"))
        self.style_in_use = None        # flickos-layout's style in use, read when a style's page shows
        for button in (self.try_button, self.use_button, self.open_button, self.setup_button, self.remove_button,
                       self.install_button, self.buy_button, self.key_button, self.parts_button, self.cancel_button):
            button.set_no_show_all(True)
            buttons.pack_start(button, False, False, 0)
        actions.pack_start(buttons, False, False, 0)
        source_row = Gtk.Box(spacing=6, halign=Gtk.Align.END)
        source_label = Gtk.Label.new_with_mnemonic("_Source")
        self.source_combo = Gtk.ComboBoxText()
        source_label.set_mnemonic_widget(self.source_combo)
        self.source_combo.connect("changed", self.on_source)
        source_row.pack_start(source_label, False, False, 0)
        source_row.pack_start(self.source_combo, False, False, 0)
        self.source_row = source_row
        source_row.set_no_show_all(True)
        source_label.show()
        self.source_combo.show()
        actions.pack_start(source_row, False, False, 0)
        top.pack_end(actions, False, False, 0)
        box.pack_start(top, False, False, 0)

        plan = Gtk.Box(spacing=8)
        self.plan_spinner = self.spinner()
        self.plan_spinner.set_no_show_all(True)
        plan.pack_start(self.plan_spinner, False, False, 0)
        self.plan_text = self.label("", dim=True, selectable=True)
        plan.pack_start(self.plan_text, True, True, 0)
        box.pack_start(plan, False, False, 0)
        self.source_note = self.label("", dim=True, selectable=True)
        self.source_note.set_no_show_all(True)
        box.pack_start(self.source_note, False, False, 0)
        self.paid_note = self.label("", dim=True, selectable=True)
        self.paid_note.set_no_show_all(True)
        box.pack_start(self.paid_note, False, False, 0)
        self.progress = Gtk.ProgressBar(show_text=True, no_show_all=True)
        box.pack_start(self.progress, False, False, 0)

        shots = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.shot_image = Gtk.Image()
        self.shot_image.set_size_request(-1, SHOT_HEIGHT)
        shots.pack_start(self.shot_image, False, False, 0)
        shot_bar = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
        self.shot_previous = Gtk.Button.new_from_icon_name("go-previous-symbolic", Gtk.IconSize.BUTTON)
        self.shot_previous.set_tooltip_text("Previous Screenshot")
        self.shot_previous.get_accessible().set_name("Previous screenshot")
        self.shot_previous.connect("clicked", lambda _b: self.show_shot(self.shot_number - 1))
        self.shot_next = Gtk.Button.new_from_icon_name("go-next-symbolic", Gtk.IconSize.BUTTON)
        self.shot_next.set_tooltip_text("Next Screenshot")
        self.shot_next.get_accessible().set_name("Next screenshot")
        self.shot_next.connect("clicked", lambda _b: self.show_shot(self.shot_number + 1))
        self.shot_caption = self.label("", dim=True, selectable=True)
        self.shot_caption.set_justify(self.Gtk.Justification.CENTER)
        self.shot_caption.set_xalign(0.5)
        shot_bar.pack_start(self.shot_previous, False, False, 0)
        shot_bar.pack_start(self.shot_caption, False, False, 0)
        shot_bar.pack_start(self.shot_next, False, False, 0)
        shots.pack_start(shot_bar, False, False, 0)
        self.shots_box = shots
        shots.show_all()
        shots.set_no_show_all(True)     # shown while the page has screenshots
        box.pack_start(shots, False, False, 0)
        self.shot_number = 0
        self.shots = []

        # A security kit's permission sentence (kit_note), before its description.
        self.kit_note = self.label("", selectable=True)
        self.kit_note.set_no_show_all(True)
        box.pack_start(self.kit_note, False, False, 0)
        self.description = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.description, False, False, 0)
        box.pack_start(self.heading("Details"), False, False, 0)
        self.details = Gtk.Grid(column_spacing=18, row_spacing=6)
        box.pack_start(self.details, False, False, 0)
        self.page_scroll = self.scrolled(box)
        return self.page_scroll

    def show_page(self, app, keep_source=False):
        Gtk, GLib = self.Gtk, self.GLib
        same = self.page_app is not None and self.page_app["id"] == app["id"]
        self.page_app = app
        if not (keep_source and same and self.page_source in app["src"]):
            self.page_source = choose_source(self.catalog, app)
        self.page_icon.set_from_pixbuf(self.icon(app["icons"], PAGE_ICON, lambda: self.refresh_page_icon(app)))
        self.page_name.set_markup(f"<span size='x-large' weight='bold'>{GLib.markup_escape_text(app['name'])}</span>")
        self.page_summary.set_text(app["summary"])
        self.source_combo.handler_block_by_func(self.on_source)
        self.source_combo.remove_all()
        offered = self.catalog.sources(app)
        for source in offered:
            self.source_combo.append(source, SOURCE_NAMES[source])
        self.source_combo.set_active_id(self.page_source)
        self.source_combo.handler_unblock_by_func(self.on_source)
        self.source_row.set_visible(len(offered) > 1)
        self.source_combo.set_sensitive(self.catalog.installed_from(app) is None)
        if not same or not keep_source:
            self.page_scroll.get_vadjustment().set_value(0)
        self.fill_page_source()

    def refresh_page_icon(self, app):
        if self.page_app is app:
            self.page_icon.set_from_pixbuf(self.icon(app["icons"], PAGE_ICON, lambda: None))

    def on_source(self, combo):
        source = combo.get_active_id()
        if source and self.page_app and source != self.page_source:
            self.page_source = source
            self.fill_page_source()

    def fill_page_source(self):
        """The parts of the page that depend on the source: text, pictures, plan, buttons."""
        Gtk, GLib = self.Gtk, self.GLib
        app, source = self.page_app, self.page_source
        if source == WEB:
            self.fill_web_page(app)
            return
        page = self.catalog.page(app, source)
        self.page_developer.set_text(f"By {page['dev']}" if page["dev"] else "")
        self.page_developer.set_visible(bool(page["dev"]))
        for child in self.description.get_children():
            child.destroy()
        for text in page["desc"] or [app["summary"]]:
            label = self.label(text, selectable=True)
            label.set_max_width_chars(90)
            self.description.pack_start(label, False, False, 0)
        self.description.show_all()

        for child in self.details.get_children():
            child.destroy()
        info = self.catalog.installed_from(app)
        rows = [("Source", SOURCE_NAMES[source])]
        if source in APT_SOURCES:
            version = self.catalog.packages.get(app["src"][source]["pkg"]) if info == source else None
            rows.append(("Package", app["src"][source]["pkg"]))
        else:
            version = None
            rows.append(("Flatpak", app["src"]["flathub"]["id"]))
        if version:
            rows.append(("Installed version", version))
        if page["version"]:
            rows.append(("Version", page["version"]))
        if page["date"]:
            rows.append(("Released", time.strftime("%x", time.localtime(page["date"]))))
        if page["license"]:
            rows.append(("License", page["license"]))
        if app.get("paid"):
            rows.append(("Price", app["paid"]["price"]))
        for number, (key, value) in enumerate(rows):
            self.details.attach(self.label(key, dim=True, wrap=False), 0, number, 1, 1)
            self.details.attach(self.label(value, selectable=True), 1, number, 1, 1)
        if page["home"].startswith(("https://", "http://")):
            host = urllib.parse.urlsplit(page["home"]).hostname or page["home"]
            link = Gtk.LinkButton.new_with_label(page["home"], host)
            link.set_halign(Gtk.Align.START)
            self.details.attach(self.label("Website", dim=True, wrap=False), 0, len(rows), 1, 1)
            self.details.attach(link, 1, len(rows), 1, 1)
        self.details.show_all()
        self.source_note.set_text(SOURCE_NOTES.get(source, ""))
        self.source_note.set_visible(source in SOURCE_NOTES)
        self.paid_note.set_text(paid_words(app["paid"], self.catalog, live_session()) if app.get("paid") else "")
        self.paid_note.set_visible(bool(app.get("paid")))
        note = kit_note(app)
        self.kit_note.set_text(note or "")
        self.kit_note.set_visible(bool(note))

        # trixie's catalog names screenshots that appstream.debian.org has since
        # replaced (404, 2026-10): an app that is also on Flathub shows Flathub's.
        self.shots = list(page["shots"])
        if source == "debian" and "flathub" in app["src"]:
            self.shots = list(self.catalog.page(app, "flathub")["shots"]) or self.shots
        self.shots_box.set_visible(bool(self.shots))
        if self.shots:
            self.show_shot(0)
        self.update_actions()
        self.plan()
        if app.get("style"):
            self.read_style_in_use()

    def fill_web_page(self, app):
        """A web app's page: what it is, its address, the buttons."""
        Gtk = self.Gtk
        self.page_developer.hide()
        for child in self.description.get_children():
            child.destroy()
        label = self.label(WEB_ABOUT, selectable=True)
        label.set_max_width_chars(90)
        self.description.pack_start(label, False, False, 0)
        self.description.show_all()
        for child in self.details.get_children():
            child.destroy()
        url = app["src"][WEB]["url"]
        self.details.attach(self.label("Source", dim=True, wrap=False), 0, 0, 1, 1)
        self.details.attach(self.label(SOURCE_NAMES[WEB], selectable=True), 1, 0, 1, 1)
        link = Gtk.LinkButton.new_with_label(url, urllib.parse.urlsplit(url).hostname or url)
        link.set_halign(Gtk.Align.START)
        self.details.attach(self.label("Address", dim=True, wrap=False), 0, 1, 1, 1)
        self.details.attach(link, 1, 1, 1, 1)
        self.details.show_all()
        self.source_note.hide()
        self.paid_note.hide()
        self.kit_note.hide()
        self.shots = []
        self.shots_box.hide()
        self.update_actions()
        self.plan()

    def read_style_in_use(self):
        """flickos-layout's style in use, so a style's page can say it is in use."""
        def done(current, _error):
            self.style_in_use = current
            if self.page_app and self.page_app.get("style"):
                self.update_actions()
                if self.page_app["style"] == current and self.catalog.installed_from(self.page_app):
                    self.set_status(f"{self.page_app['name']} is the style in use.")
        self.background(lambda: run_layout("style", "current").strip() or None, done, key="style")

    def use_style(self, how):
        """Try (until logout) or use the page's style, through flickos-layout.
        Use also sets the layout a style package brings (ADR-014)."""
        app = self.page_app
        args = use_args(app, how)
        self.set_status(f"Trying {app['name']}…" if how == "try" else f"Using {app['name']}…")

        def done(_output, error):
            self.set_status("")
            if error:
                self.show_error(f"{app['name']} couldn't be {'tried' if how == 'try' else 'used'}: {error}")
                return
            self.set_status(f"Trying {app['name']} until you log out. Use keeps it." if how == "try"
                            else f"{app['name']} is the style and layout in use." if app.get("layout")
                            else f"{app['name']} is the style in use.")
            self.read_style_in_use()
        self.background(lambda: run_layout(*args), done, key="use-style")

    def show_shot(self, number):
        if not self.shots:
            return
        number %= len(self.shots)
        self.shot_number = number
        shot = self.shots[number]
        self.shot_previous.set_visible(len(self.shots) > 1)
        self.shot_next.set_visible(len(self.shots) > 1)
        words = shot["caption"] or ""
        position = f"{number + 1} of {len(self.shots)}"
        self.shot_caption.set_text(f"{words}\n{position}" if words else position)
        self.shot_image.set_from_icon_name("image-loading", self.Gtk.IconSize.DIALOG)
        url = shot["url"]
        GdkPixbuf, GLib = self.GdkPixbuf, self.GLib

        def load():
            path = fetch(url)
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, -1, SHOT_HEIGHT, True)

        def loaded(pixbuf, error):
            if not self.shots or self.shots[self.shot_number]["url"] != url:
                return
            if pixbuf is not None:
                self.shot_image.set_from_pixbuf(pixbuf)
                return
            # A screenshot that can't be loaded is left out; none left, no pictures.
            warn(f"{url}: {error}")
            del self.shots[self.shot_number]
            self.shots_box.set_visible(bool(self.shots))
            if self.shots:
                self.show_shot(self.shot_number)

        def work():
            try:
                return load()
            except GLib.Error as error:
                raise ValueError(error.message) from None

        self.background(work, loaded, key="shot")
        # The next one, so paging is quick.
        if len(self.shots) > 1:
            following = self.shots[(number + 1) % len(self.shots)]["url"]
            self.queue_fetch(following, lambda _p: None)

    def update_actions(self):
        """The page's buttons for what is installed and what is running."""
        app, source = self.page_app, self.page_source
        installed = self.catalog.installed_from(app)
        busy = self.child is not None and source != WEB     # Firefox doesn't wait for PackageKit
        mine = busy and self.child[1]["id"] == app["id"]
        package = app["src"][installed].get("pkg") if installed in APT_SOURCES else None
        removable = installed and not (package and self.catalog.is_protected(package))
        paid = app.get("paid") if source != WEB else None
        locked = bool(paid) and self.catalog.locked(app)
        waiting = self.claim is not None and self.claim[1]["id"] == app["id"]
        self.install_button.set_visible(not installed and not mine and not locked)
        # Buy…: FlickOS's store's app until bought (in place of Install, or
        # for the newer one next to an installed free version), and always
        # another developer's (its key).
        self.buy_button.set_visible(bool(paid) and not mine and not waiting and (locked or not paid["product"]))
        # Add Key…: the store's app until bought, never in the live session.
        self.key_button.set_visible(locked and bool(paid["product"]) and not mine and not waiting
                                    and not live_session())
        self.key_button.set_sensitive(not self.adding_key)
        buy_style = self.buy_button.get_style_context()
        if locked and not installed:
            buy_style.add_class("suggested-action")
        else:
            buy_style.remove_class("suggested-action")
        style = app.get("style")
        self.open_button.set_visible(bool(installed) and not mine and not style and not app.get("kit")
                                     and (bool(self.launch_id(app, installed)) or installed == WEB))
        self.setup_button.set_visible(bool(installed) and not mine and bool(app.get("kit"))
                                      and shutil.which(KITS) is not None)
        for button in (self.try_button, self.use_button):
            button.set_visible(bool(installed) and not mine and bool(style) and style != self.style_in_use)
        self.remove_button.set_visible(bool(removable) and not mine)
        extra, missing = self.missing_parts(app, installed)
        self.parts_button.set_visible(bool(missing) and not mine)
        if extra:
            self.parts_button.set_label(extra["button"])
            self.parts_button.set_tooltip_text(f"Add {extra['what']} to {app['name']}")
        self.cancel_button.set_visible(mine or waiting)
        self.cancel_button.set_sensitive(waiting or (mine and self.child_can_cancel))
        for button in (self.install_button, self.remove_button, self.parts_button):
            button.set_sensitive(not busy)
            button.set_tooltip_text(f"Wait until {self.child[1]['name']} is done." if busy and not mine else None)
        self.progress.set_visible(mine)
        self.source_combo.set_sensitive(not installed and not busy)

    def missing_parts(self, app, installed):
        """(OTHER_ARCH entry, its packages missing) for an app installed from an apt source."""
        if installed not in APT_SOURCES:
            return None, []
        return other_parts(app["src"][installed]["pkg"], self.catalog.packages)

    def plan(self):
        """What installing (removing) would change, from `plan --json` in a child."""
        app, source = self.page_app, self.page_source
        if self.child is not None and self.child[1]["id"] == app["id"]:
            return
        installed = self.catalog.installed_from(app)
        if source == WEB:
            self.show_plan(WEB_REMOVE if installed else WEB_INSTALL)
            return
        if self.claim is not None and self.claim[1]["id"] == app["id"]:
            self.plan_spinner.show()
            self.plan_text.set_text("Waiting for your payment… Pay in your web browser; the key comes here by "
                                    "itself, and adding it asks for your password.")
            return
        if installed in APT_SOURCES and self.catalog.is_protected(app["src"][installed]["pkg"]):
            self.show_plan(f"{app['name']} is part of the FlickOS desktop, so it can't be removed here.")
            return
        if installed and installed != source:
            if source == STORE and self.catalog.locked(app):
                self.show_plan(f"The free version from {SOURCE_NAMES[installed]} is installed. Buy… gets the "
                               "newest one, which updates with the rest.")
            else:
                self.show_plan(f"Installed from {SOURCE_NAMES[installed]}.")
            return
        if not installed and app.get("paid") and self.catalog.locked(app):
            self.show_plan("")          # the paid note says what Buy… does
            return
        removing = installed and not self.missing_parts(app, installed)[1]
        args = ["plan", "--json", "--source", source] + (["--remove"] if removing else []) + [app["id"]]
        self.plan_spinner.show()
        self.plan_text.set_text("" if removing else "Checking what it needs…")
        number = self.reads["plan"] = self.reads.get("plan", 0) + 1

        def done(ok, stdout, stderr):
            if self.reads["plan"] != number:
                return
            self.plan_spinner.hide()
            if not ok:
                self.show_plan(last_line(stderr) or "What it needs couldn't be checked.")
                return
            try:
                self.show_plan(plan_words(json.loads(stdout), self.GLib.format_size))
            except ValueError:
                self.show_plan("")

        process = self.run_child(args, done)
        if process is not None:
            # PackageKit can wait for another program's lock for a long time.
            self.GLib.timeout_add_seconds(PLAN_SECONDS, lambda: (process.force_exit(), False)[1])

    def show_plan(self, text):
        self.plan_spinner.hide()
        self.plan_text.set_text(text)

    def launch_id(self, app, installed):
        launch = app["src"][installed].get("launch") or []
        return launch[0] if launch else None

    def open_app(self):
        app = self.page_app
        installed = self.catalog.installed_from(app)
        desktop_id = self.launch_id(app, installed)
        info = self.Gio.DesktopAppInfo.new(desktop_id) if desktop_id else None
        if info is None and installed == WEB:
            # Its launcher is gone: add opens the web app Firefox has for the address.
            self.run_web(["add", app["src"][WEB]["url"]], app["name"], f"{app['name']} is open in Firefox.")
            return
        if info is None:
            self.show_error(f"{app['name']} couldn't be started from here. Open it from the menu.")
            return
        try:
            info.launch([], None)
        except self.GLib.Error as error:
            self.show_error(f"{app['name']} couldn't be started: {error.message}")

    def set_up(self):
        """Open the Tool Kits window on this kit; it lives on after Software closes."""
        app = self.page_app
        try:
            subprocess.Popen(kit_setup_argv(app), stdin=subprocess.DEVNULL, start_new_session=True)
        except OSError as error:
            self.show_error(f"Tool Kits couldn't be opened: {error}")

    def change(self, action):
        """Install or remove the page's app in a child (`install --json`)."""
        app, source = self.page_app, self.page_source
        if source == WEB:
            # The page and flickos-switch's notification say which button to press.
            web = app["src"][WEB]
            args = ["add", web["url"], "--name", app["name"]] if action == "install" else ["remove", web["webapp"]]
            self.run_web(args, app["name"], f"{app['name']} is open in Firefox.")
            return
        self.notice.hide()
        self.child_can_cancel = action == "install"
        self.progress.set_fraction(0)
        self.progress.set_text("Preparing…")
        args = [action, "--json", "--source", source, app["id"]]
        outcome = {"event": None, "message": ""}

        def line(text):
            try:
                event = json.loads(text)
            except ValueError:
                return
            outcome["event"] = event.get("event")
            if event.get("event") == "progress":
                self.child_progress(app, event)
            elif event.get("event") == "error":
                outcome["message"] = event.get("message", "")

        def done(ok, _stdout, stderr):
            self.child = None
            self.set_status("")
            if outcome["event"] == "cancelled":
                self.set_status(f"{app['name']} wasn't {'installed' if action == 'install' else 'removed'}.")
            elif not ok:
                self.show_error(outcome["message"] or last_line(stderr) or
                                f"{app['name']} couldn't be {'installed' if action == 'install' else 'removed'}.")
            # What's installed changed: read it again, then show the page anew.
            self.background(self.read_installed, self.installed_read, key="installed")

        process = self.run_child(args, done, lines=line)
        if process is None:
            return
        self.child = (process, app, action)
        extra, missing = self.missing_parts(app, self.catalog.installed_from(app))
        if action == "install" and missing:
            self.set_status(f"Adding {extra['what']} to {app['name']}…")
        else:
            self.set_status(f"Installing {app['name']}…" if action == "install" else f"Removing {app['name']}…")
        self.update_actions()
        self.progress.show()
        self.plan_text.set_text("")

    def run_web(self, args, name, status):
        """flickos-switch webapp ARGS, which opens Firefox and returns; then
        the status line says status (what to press there)."""
        Gio, GLib = self.Gio, self.GLib
        self.notice.hide()
        try:
            process = Gio.Subprocess.new([SWITCH, "webapp", *args],
                                         Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as error:
            self.show_error(f"{name} couldn't be opened in Firefox: {error.message}")
            return

        def finished(_process, result):
            try:
                _, _, stderr = process.communicate_utf8_finish(result)
            except GLib.Error as error:
                stderr = error.message
            if process.get_successful():
                self.set_status(status)
            else:
                self.show_error(f"{name} couldn't be opened in Firefox: "
                                + (last_line(stderr).removeprefix(f"{SWITCH}: ") or "flickos-switch failed."))

        process.communicate_utf8_async(None, None, finished)

    def new_web_app(self):
        """The Web Apps category's New Web App…: an address, opened in Firefox."""
        Gtk = self.Gtk
        dialog = Gtk.Dialog(title="New Web App", transient_for=self.win, modal=True)
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        ok = dialog.add_button("_Open in Firefox", Gtk.ResponseType.ACCEPT)
        ok.get_style_context().add_class("suggested-action")
        ok.set_sensitive(False)
        dialog.set_default_response(Gtk.ResponseType.ACCEPT)
        box = dialog.get_content_area()
        box.set_spacing(12)
        box.set_border_width(18)
        words = self.label("Firefox opens the website. To keep it as a web app, press the button at the right "
                           "of its address bar, next to the star.")
        words.set_max_width_chars(50)
        box.pack_start(words, False, False, 0)
        row = Gtk.Box(spacing=6)
        label = Gtk.Label.new_with_mnemonic("_Address")
        entry = Gtk.Entry(activates_default=True, placeholder_text="https://", width_chars=36)
        label.set_mnemonic_widget(entry)
        entry.connect("changed", lambda e: ok.set_sensitive(web_address(e.get_text()) is not None))
        row.pack_start(label, False, False, 0)
        row.pack_start(entry, True, True, 0)
        box.pack_start(row, False, False, 0)
        dialog.show_all()
        answer = dialog.run()
        url = web_address(entry.get_text())
        dialog.destroy()
        if answer == Gtk.ResponseType.ACCEPT and url:
            host = urllib.parse.urlsplit(url).hostname
            self.run_web(["add", url], host, f"{host} is open in Firefox. To keep it as a web app, press the "
                         "button at the right of its address bar, next to the star.")

    def child_progress(self, app, event):
        status = event.get("status")
        words = STATUS_TEXT.get(status, "Preparing…")
        if event.get("detail"):
            words = f"{words[:-1]} {event['detail']}…"
        percent = event.get("percent")
        if percent is None:
            self.progress.pulse()
        else:
            self.progress.set_fraction(percent / 100)
        self.progress.set_text(words if percent is None else f"{words} {percent}%")
        self.child_can_cancel = bool(event.get("cancel"))
        if self.page_app is app:
            self.cancel_button.set_sensitive(self.child_can_cancel)

    def cancel_change(self):
        if self.claim is not None and self.page_app is not None and self.claim[1]["id"] == self.page_app["id"]:
            self.stop_claim()
            return
        if self.child is not None:
            with contextlib.suppress(Exception):
                self.child[0].send_signal(signal.SIGTERM)
            self.cancel_button.set_sensitive(False)
            self.progress.set_text("Cancelling…")

    # --- Files: .deb, .flatpak, .flatpakref, .flatpakrepo (ADR-012) ---------------------

    def build_files(self):
        Gtk = self.Gtk
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin=24)
        self.files_title = self.label("", markup=True)
        box.pack_start(self.files_title, False, False, 0)
        self.files_rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.pack_start(self.files_rows, False, False, 0)
        plan = Gtk.Box(spacing=8)
        self.files_spinner = self.spinner()
        self.files_spinner.set_no_show_all(True)
        plan.pack_start(self.files_spinner, False, False, 0)
        self.files_text = self.label("", dim=True, selectable=True)
        plan.pack_start(self.files_text, True, True, 0)
        box.pack_start(plan, False, False, 0)
        self.files_progress = Gtk.ProgressBar(show_text=True, no_show_all=True)
        box.pack_start(self.files_progress, False, False, 0)
        buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END)
        self.files_install = Gtk.Button.new_with_mnemonic("_Install")
        self.files_install.get_style_context().add_class("suggested-action")
        self.files_install.set_can_default(True)
        self.files_install.connect("clicked", lambda _b: self.install_files())
        self.files_cancel = Gtk.Button.new_with_mnemonic("_Cancel")
        self.files_cancel.connect("clicked", lambda _b: self.cancel_change())
        self.files_close = Gtk.Button.new_with_mnemonic("_Close")
        self.files_close.connect("clicked", lambda _b: self.close_files())
        for button in (self.files_install, self.files_cancel, self.files_close):
            button.set_no_show_all(True)
            buttons.pack_start(button, False, False, 0)
        box.pack_start(buttons, False, False, 0)
        return self.scrolled(box)

    def watch_spool(self):
        """Files opened while this window is open arrive as small files in a folder."""
        try:
            folder = spool_folder()
            os.makedirs(folder, exist_ok=True)
            self.spool_monitor = self.Gio.File.new_for_path(folder).monitor_directory(
                self.Gio.FileMonitorFlags.NONE, None)
        except (SoftwareError, OSError, self.GLib.Error) as error:
            warn(f"files opened later won't reach this window ({error})")
            return
        self.spool_monitor.connect("changed", lambda *_args: self.take_files())
        self.take_files()

    def take_files(self):
        paths = take_spool()
        if paths:
            self.queued_files += paths
            self.open_queued_files()
            self.win.present()

    def open_queued_files(self):
        """Open the queued files once the catalog is read and nothing installs."""
        if not self.queued_files or not self.catalog_shown:
            return
        if self.child is not None or self.files_busy:
            self.set_status("The files open as soon as this is done.")
            return
        paths, self.queued_files = self.queued_files, []
        if self.view == ("files", None) and self.files and not self.file_status:
            # More files while the page still waits for Install: one page for all of them.
            paths = [i["path"] for i in self.files] + paths
        self.open_files(paths)

    def open_files(self, paths):
        paths = [os.path.abspath(p) for p in dict.fromkeys(paths)]
        self.notice.hide()
        self.files = [new_item(p) for p in paths]
        for item in self.files:
            item["name"] = item["file"]
        self.file_status = {}
        self.files_plan = None
        self.files_busy = True
        self.fill_files()
        self.files_title.set_markup("<big><b>Checking the files</b></big>")
        self.files_text.set_text("")
        self.files_spinner.show()
        self.files_install.hide()
        self.files_cancel.hide()
        self.files_close.show()
        self.files_progress.hide()
        self.go("files", None)
        args = ["plan", "--json"] + [a for p in paths for a in ("--file", p)]
        number = self.reads["files"] = self.reads.get("files", 0) + 1

        def done(ok, stdout, stderr):
            if self.reads["files"] != number:
                return
            self.files_busy = False
            self.files_spinner.hide()
            self.set_status("")
            try:
                plan = json.loads(stdout)
            except ValueError:
                self.files_text.set_text(last_line(stderr) or "The files couldn't be checked.")
                return
            self.show_files_plan(plan)
            self.open_queued_files()

        process = self.run_child(args, done)
        if process is not None:
            self.GLib.timeout_add_seconds(PLAN_SECONDS, lambda: (process.force_exit(), False)[1])

    def heading_text(self, plan):
        items = plan["items"]
        usable = [i for i in items if not i["refused"]]
        kinds = {i["kind"] for i in usable}
        if not usable:
            words = "This file can't" if len(items) == 1 else "These files can't"
            return f"<big><b>{words} be installed</b></big>"
        if kinds == {"repo"} and len(usable) == 1:
            return "<big><b>Add this source?</b></big>"
        if len(usable) == 1:
            return f"<big><b>Install this {'package' if 'deb' in kinds else 'app'}</b></big>"
        if kinds <= {"ref", "bundle"}:
            return f"<big><b>Install {len(usable)} apps</b></big>"
        return f"<big><b>Install {len(usable)} files</b></big>"

    def show_files_plan(self, plan):
        self.files_plan = plan
        self.files = plan["items"]
        self.fill_files()
        self.files_title.set_markup(self.heading_text(plan))
        self.files_text.set_text(files_plan_words(plan, self.GLib.format_size))
        usable = [i for i in plan["items"] if not i["refused"]]
        self.files_install.set_visible(bool(usable))
        if len(usable) == 1 and usable[0]["kind"] == "repo":
            self.files_install.set_label("_Add Source")
        else:
            self.files_install.set_label("_Install anyway" if any(i["risky"] for i in usable) else "_Install")
        self.files_install.set_use_underline(True)
        self.files_install.grab_default()
        self.files_install.grab_focus()

    def fill_files(self):
        Gtk = self.Gtk
        for child in self.files_rows.get_children():
            self.files_rows.remove(child)
        for item in self.files:
            row = Gtk.Box(spacing=14)
            icon = Gtk.Image(valign=Gtk.Align.START)
            icon.set_from_icon_name("package-x-generic" if self.theme.has_icon("package-x-generic")
                                    else "application-x-executable", Gtk.IconSize.DIALOG)
            icon.set_pixel_size(48)
            row.pack_start(icon, False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            version = f" {item['version']}" if item["version"] and item["kind"] == "deb" else ""
            text.pack_start(self.label(f"<b>{self.GLib.markup_escape_text(item['name'] + version)}</b>",
                                       markup=True, selectable=True), False, False, 0)
            sub = KIND_WORDS.get(item["kind"], "")
            if item["summary"]:
                sub = f"{item['summary']} · {sub}" if sub else item["summary"]
            if sub:
                text.pack_start(self.label(sub, dim=True, selectable=True), False, False, 0)
            if item["refused"]:
                text.pack_start(self.label(item["refused"], selectable=True), False, False, 0)
            else:
                for note in item["notes"]:
                    text.pack_start(self.label(note, dim=True, selectable=True), False, False, 0)
                if item["permissions"]:
                    can = "It can: " + "; ".join(w[0].lower() + w[1:] for w in item["permissions"]) + "."
                    text.pack_start(self.label(can, dim=True, selectable=True), False, False, 0)
                elif item["kind"] == "bundle":
                    text.pack_start(self.label("It asks for no access beyond the sandbox.", dim=True),
                                    False, False, 0)
            status = self.file_status.get(item["path"])
            if status:
                text.pack_start(self.label(status[1], selectable=True), False, False, 0)
            row.pack_start(text, True, True, 0)
            if item["catalog"] and not self.file_status.get(item["path"]):
                button = Gtk.Button.new_with_label("Show in Software")
                button.set_valign(Gtk.Align.START)
                button.set_tooltip_text("Software has this app: it updates by itself")
                button.connect("clicked", lambda _b, app_id=item["catalog"]: self.go("app", app_id))
                row.pack_end(button, False, False, 0)
            self.files_rows.pack_start(row, False, False, 0)
        self.files_rows.show_all()

    def install_files(self):
        if self.child is not None or not self.files_plan:
            return
        usable = [i for i in self.files_plan["items"] if not i["refused"]]
        if not usable:
            return
        self.notice.hide()
        self.file_status = {}
        args = ["install", "--json"] + [a for i in usable for a in ("--file", i["path"])]
        outcome = {"event": None, "message": "", "failed": 0}
        self.files_progress.set_fraction(0)
        self.files_progress.set_text("Preparing…")

        def line(text):
            try:
                event = json.loads(text)
            except ValueError:
                return
            kind = event.get("event")
            outcome["event"] = kind
            if kind == "progress":
                self.files_progress_event(event)
            elif kind == "item":
                self.file_status[event.get("path")] = (event.get("status"), event.get("message", ""))
                self.fill_files()
            elif kind == "error":
                outcome["message"] = event.get("message", "")
            elif kind == "done":
                outcome["failed"] = event.get("failed", 0)

        def done(ok, _stdout, stderr):
            self.child = None
            self.set_status("")
            self.files_progress.hide()
            self.files_cancel.hide()
            self.files_close.show()
            installed_any = any(s[0] == "done" for s in self.file_status.values())
            if outcome["event"] == "cancelled":
                self.files_text.set_text("Cancelled. What was already installed stays.")
            elif outcome["event"] == "done" and not outcome["failed"]:
                self.files_text.set_text("Done.")
            elif not ok:
                self.files_text.set_text(outcome["message"] or last_line(stderr) or "It wasn't installed.")
            else:
                self.files_text.set_text("Some of the files weren't installed.")
            self.fill_files()
            if installed_any:
                self.background(self.read_installed, self.installed_read, key="installed")
            self.open_queued_files()

        process = self.run_child(args, done, lines=line)
        if process is None:
            return
        self.child = (process, {"id": "files", "name": "the files"}, "install")
        self.child_can_cancel = True
        self.files_install.hide()
        self.files_close.hide()
        self.files_cancel.show()
        self.files_cancel.set_sensitive(True)
        self.files_progress.show()
        self.files_text.set_text("")
        self.set_status("Installing…")

    def files_progress_event(self, event):
        words = STATUS_TEXT.get(event.get("status"), "Preparing…")
        if event.get("detail"):
            words = f"{words[:-1]} {event['detail']}…"
        percent = event.get("percent")
        if percent is None:
            self.files_progress.pulse()
        else:
            self.files_progress.set_fraction(percent / 100)
        self.files_progress.set_text(words if percent is None else f"{words} {percent}%")
        self.child_can_cancel = bool(event.get("cancel"))
        self.files_cancel.set_sensitive(self.child_can_cancel)

    def close_files(self):
        self.files, self.files_plan, self.file_status = [], None, {}
        if self.history:
            self.go_back()
        else:
            self.go("explore", None, remember=False)

    def read_installed(self):
        packages, depends = installed_packages()
        return packages, depends, installed_flatpaks(), read_purchases()

    def installed_read(self, result, error):
        if error:
            self.show_error(error)
            return
        self.catalog.packages, self.catalog.protected, self.catalog.flatpaks, purchases = result
        self.catalog.bought, self.catalog.key_off = purchases
        self.refresh_view()

    def installed_changed(self, result, error):
        """installed_read, only when something differs (no page redrawn, no
        plan asked again, for a window that merely got the focus back)."""
        catalog = self.catalog
        if error or result != (catalog.packages, catalog.protected, catalog.flatpaks,
                               (catalog.bought, catalog.key_off)):
            self.installed_read(result, error)

    # --- Bought apps: Buy… with a claim code, Add Key… (phase 3c) ---------------------

    def run_command(self, command, done, stdin=None):
        """Run another program without blocking the window, text on its
        standard input; then done(ok, stdout, stderr). Returns the process."""
        Gio, GLib = self.Gio, self.GLib
        flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE | Gio.SubprocessFlags.STDIN_PIPE
        try:
            process = Gio.Subprocess.new(list(command), flags)
        except GLib.Error as error:
            done(False, "", error.message)
            return None

        def finished(process, result):
            try:
                _, stdout, stderr = process.communicate_utf8_finish(result)
                ok = process.get_successful()
            except GLib.Error as error:
                stdout, stderr, ok = "", error.message, False
            done(ok, stdout or "", stderr or "")

        process.communicate_utf8_async(stdin, None, finished)
        return process

    def buy(self):
        """Buy…: for the store's app, a claim code in the checkout's address,
        and `flickos-control purchases claim` waiting for the key (ADR-011);
        another developer's, or in the live session, only the address."""
        app = self.page_app
        paid = app["paid"]
        if not paid["product"] or live_session() or self.claim is not None or not shutil.which(CONTROL):
            self.open_web(paid["buy"])
            return
        code = secrets.token_urlsafe(CLAIM_BYTES)
        state = {"stopped": False}

        def done(ok, stdout, stderr):
            self.claim = None
            messages = [line for line in output_lines(stdout, stderr) if not line.startswith("Waiting for ")]
            if state["stopped"]:
                self.set_status(f"Stopped waiting for the payment of {app['name']}. If you paid, the receipt "
                                "email's order number gets the key from the store's page; then Add Key….")
            elif ok:
                self.set_status(" ".join(messages))
                self.key_added()
            else:
                self.show_error(" ".join(messages) or f"The key of {app['name']} didn't come.")
            if self.page_app is app:
                self.update_actions()
                self.plan()

        process = self.run_command([CONTROL, "purchases", "claim", "--stdin"], done, code + "\n")
        if process is None:
            return
        self.claim = (process, app, state)
        self.notice.hide()
        self.open_web(claim_address(paid["buy"], code))
        self.update_actions()
        self.plan()

    def stop_claim(self):
        """Stop waiting for the payment (Cancel, closing the window): the code is lost."""
        if self.claim is None:
            return
        process, _app, state = self.claim
        state["stopped"] = True
        with contextlib.suppress(Exception):
            process.send_signal(signal.SIGTERM)

    def add_key(self):
        """Add Key…: a key typed or pasted, given to `flickos-control purchases
        add --stdin`, which checks it, asks for the password and adds it."""
        Gtk = self.Gtk
        dialog = Gtk.Dialog(title="Add Key", transient_for=self.win, modal=True)
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        ok = dialog.add_button("_Add", Gtk.ResponseType.ACCEPT)
        ok.get_style_context().add_class("suggested-action")
        ok.set_sensitive(False)
        dialog.set_default_response(Gtk.ResponseType.ACCEPT)
        box = dialog.get_content_area()
        box.set_spacing(12)
        box.set_border_width(18)
        words = self.label("The key from the page or the email of your purchase. Adding it needs an "
                           "administrator's password.")
        words.set_max_width_chars(50)
        box.pack_start(words, False, False, 0)
        row = Gtk.Box(spacing=6)
        label = Gtk.Label.new_with_mnemonic("_Key")
        entry = Gtk.Entry(activates_default=True, width_chars=40)
        label.set_mnemonic_widget(entry)
        entry.connect("changed", lambda e: ok.set_sensitive(key_shaped(e.get_text())))
        row.pack_start(label, False, False, 0)
        row.pack_start(entry, True, True, 0)
        box.pack_start(row, False, False, 0)
        dialog.show_all()
        answer = dialog.run()
        key = entry.get_text().strip()
        dialog.destroy()
        if answer != Gtk.ResponseType.ACCEPT or not key_shaped(key):
            return

        def done(ok, stdout, stderr):
            self.adding_key = False
            messages = output_lines(stdout, stderr)
            if ok:
                self.set_status(" ".join(messages))
                self.key_added()
            else:
                self.set_status("")
                self.show_error(" ".join(messages) or "The key wasn't added.")
            self.update_actions()

        if self.run_command([CONTROL, "purchases", "add", "--stdin"], done, key + "\n") is not None:
            self.adding_key = True
            self.notice.hide()
            self.set_status("Adding the key…")
            self.update_actions()

    def key_added(self):
        """A key was added: the store's lists came through apt, so the index
        and what is bought are read again, and the page shows Install."""
        if self.update_catalogs() is None:
            self.background(self.read_catalog, lambda c, e: self.catalog_read(c, e, updated=True), key="catalog")


def paid_words(paid, catalog=None, live=False):
    """The page's line about an app's price, and for the store's app what its
    key bought (catalog.bought, catalog.key_off)."""
    if paid["product"]:
        if catalog is not None and paid["product"] in catalog.bought:
            return f"Bought ({paid['price']}). It installs and updates like FlickOS's own apps."
        words = f"{paid['price']}. Buy… opens the checkout in your web browser."
        if catalog is not None and catalog.key_off:
            words += (" The key on this computer was turned off, so the apps bought with it no longer update "
                      "(Settings > Updates).")
        if live:
            return words + " Add your key after installing FlickOS: a key added in the live session is lost."
        return words + " Bought it on the website or another computer? Add Key… adds its key."
    return (f"Free to download; a key from the developer unlocks it ({paid['price']}). "
            "Buy… opens the developer's page in your web browser.")


def plan_words(plan, size=human_size):
    """A plan (`plan --json`) in sentences for the page (HIG TXT-8: whole
    sentences, two strings for plurals). size: bytes -> text (GLib.format_size)."""
    name = plan["app"]
    if plan["protected"]:
        return (f"{name} can't be {'removed' if plan['action'] == 'remove' else 'installed'} here: "
                f"it would remove part of the FlickOS desktop ({', '.join(plan['protected'])}).")
    others = [p for p in plan["packages"] if p != plan.get("package")]
    adds = plan.get("adds")
    if plan["action"] == "remove":
        frees = f"Removing it frees {size(plan['size'])}." if plan["size"] else ""
        if plan["source"] == "flathub":
            return frees
        also = ("" if not others else
                f" It also removes {len(others)} package that only {name} used." if len(others) == 1 else
                f" It also removes {len(others)} packages that only {name} used.")
        password = (" Removing asks for your password, then again to turn off support for 32-bit programs."
                    if plan.get("turns_off") else " Removing asks for your password.")
        return (frees + also + password).strip()
    if plan.get("only_parts"):
        what = adds["what"] if adds else "the rest"
        if adds and not adds["on"]:
            return (f"{name} is installed without {what}, which most Windows programs need. Adding it needs "
                    f"about {size(adds['size'])} of disk space ({size(adds['download'])} to download) and asks "
                    f"for your password twice: once to allow 32-bit programs, once to install them.")
        text = f"{name} is installed without {what}, which most Windows programs need. Adding it needs " \
               f"{size(plan['size'])} of disk space"
        text += f" ({size(plan['download'])} to download)." if plan["download"] else "."
        return text + " It asks for your password."
    if plan["source"] in APT_SOURCES:
        if not others:
            text = f"Needs {size(plan['size'])} of disk space"
        elif len(others) == 1:
            text = f"Needs {size(plan['size'])} of disk space, with 1 other package"
        else:
            text = f"Needs {size(plan['size'])} of disk space, with {len(others)} other packages"
        text += f" ({size(plan['download'])} to download)." if plan["download"] else "."
        if plan["removes"]:
            text += f" Installing it removes {', '.join(plan['removes'])}."
        if adds and not adds["on"]:
            return text + (f" It comes with {adds['what']}, which most Windows programs need: about "
                           f"{size(adds['size'])} more ({size(adds['download'])} to download). Installing it "
                           f"asks for your password twice: once to allow 32-bit programs, once to install.")
        if adds:
            text += f" That includes {adds['what']}, which most Windows programs need."
        return text + f" {SOURCE_NAMES[plan['source']]} apps are installed for the whole system and need your password."
    brings = []
    for item in plan["items"]:
        if item["name"] and item["name"] not in brings:
            brings.append(item["name"])
    # Runtimes share files between branches, so the sizes are an upper bound.
    text = f"Needs up to {size(plan['download'])} to download and {size(plan['size'])} of disk space"
    if brings:
        text += f", including {join_words(brings)}"
    return text + "."


def windows_answer(entries, catalog, found):
    """What a search shows above its results, from flickos-switch lookup's
    entries: (sentence, rows) for the first entry with something to say, or
    None. A row is ("app", app, why) or ("web", name, url). found: the IDs
    of the apps the search found (an entry's Linux version among them needs
    no word). Matches by the list's words count only when there are few
    (WORD_MATCHES): "excel" names a program, "music" many."""
    entries = [e for e in entries if isinstance(e, dict) and isinstance(e.get("name"), str)]
    by_words = [e for e in entries if e.get("by") != "name"]
    for entry in entries:
        if entry.get("by") != "name" and len(by_words) > WORD_MATCHES:
            continue
        name = entry["name"]
        linux = entry.get("linux")
        if isinstance(linux, dict):
            app = catalog.find(str(linux.get("app", "")))
            if app is None or app["id"] in found:
                continue
            return f"{name} is made for FlickOS too.", [("app", app, app["summary"])]
        rows = []
        for similar in entry.get("similar") or []:
            app = catalog.find(str(similar.get("app", ""))) if isinstance(similar, dict) else None
            if app is not None and all(row[1] is not app for row in rows):
                rows.append(("app", app, similar.get("why") or app["summary"]))
        web = entry.get("web")
        if isinstance(web, dict) and str(web.get("url", "")).startswith("https://"):
            # Its web app's page while Software has web apps (phase 3b), else the browser.
            webapp = catalog.find(f"web:{entry['id']}") if isinstance(entry.get("id"), str) else None
            if webapp is not None and WEB in webapp["src"]:
                rows.append(("app", webapp, WEB_WHY))
            else:
                rows.append(("web", web.get("name") or name, web["url"]))
        note = entry.get("note") or ""
        if entry.get("group"):
            sentence = note or f"{name[:1].upper()}{name[1:]} for Windows doesn't work on FlickOS."
        else:
            sentence = f"{name} is a Windows program and isn't made for FlickOS. {note}".strip()
        return sentence, rows
    return None


def join_words(words):
    """"a, b and c" (English only, like the rest of the window)."""
    if len(words) < 2:
        return "".join(words)
    return ", ".join(words[:-1]) + " and " + words[-1]


def output_lines(stdout, stderr):
    """What a child printed, as lines to show, without the programs' names."""
    lines = []
    for line in ((stdout or "") + "\n" + (stderr or "")).splitlines():
        line = re.sub(r"^(flickos-control|flickos-software|control-helper): ", "", line.strip())
        if line and line not in lines:
            lines.append(line)
    return lines


def last_line(text):
    """The last line a child printed on stderr, without our name prefix."""
    lines = [line for line in (text or "").splitlines() if line.strip()]
    if not lines:
        return ""
    line = lines[-1]
    return line[len(NAME) + 2:] if line.startswith(NAME + ": ") else line


if __name__ == "__main__":
    sys.exit(main())
