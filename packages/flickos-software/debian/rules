#!/usr/bin/make -f

# The tests import usr/bin/flickos-software; no bytecode next to installed files.
export PYTHONDONTWRITEBYTECODE = 1

%:
	dh $@

# Skipped with DEB_BUILD_OPTIONS=nocheck.
override_dh_auto_test:
	python3 -m unittest discover -s tests -v

# Enable the timer, start nothing: it runs at its time (Persistent=true), never
# while a package is being installed.
override_dh_installsystemd:
	dh_installsystemd --name=flickos-software-update --no-start
