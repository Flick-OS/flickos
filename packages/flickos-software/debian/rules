#!/usr/bin/make -f

# The tests import usr/bin/flickos-software; no bytecode next to installed files.
export PYTHONDONTWRITEBYTECODE = 1

%:
	dh $@

# Skipped with DEB_BUILD_OPTIONS=nocheck.
override_dh_auto_test:
	python3 -m unittest discover -s tests -v

# The update itself runs at its time (Persistent=true), never while a package
# is being installed; the timer is enabled, and started again after an
# upgrade: --no-start on the timer too stopped it at every upgrade until the
# next boot, so automatic app updates stopped after Software updated itself.
override_dh_installsystemd:
	dh_installsystemd --name=flickos-software-update --no-start flickos-software-update.service
	dh_installsystemd --name=flickos-software-update flickos-software-update.timer
