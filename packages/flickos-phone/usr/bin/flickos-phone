import termios
import threading
import time
import urllib.parse
import uuid

# FLICKOS_PHONE_PREFIX: run from a source tree, e.g. packages/flickos-phone.
PREFIX = os.environ.get("FLICKOS_PHONE_PREFIX", "")
SYSTEM_CONF = PREFIX + "/etc/xdg/flickos/phone.conf"
# flickos-control's: [History] Enabled=, then the user's ~/.config/flickos/history.
HISTORY_CONF = PREFIX + "/etc/xdg/flickos/history.conf"
UFW_CONF = "/etc/ufw/ufw.conf"
PROC = "/proc"
DMI_CHASSIS = "/sys/class/dmi/id/chassis_type"
MACHINE_INFO = "/etc/machine-info"
SECTION = "Phone"

# The protocol (kdeconnect-kde core/backends/lan/lanlinkprovider.h).
UDP_PORT = 1716
TCP_PORT = 1716
PAYLOAD_PORTS = range(1739, 1765)
PROTOCOL_VERSION = 8
MAX_IDENTITY = 8192             # bytes in an identity line, as kdeconnect-kde
MAX_PACKET = 1 << 20            # bytes in any other line, from a paired phone
MAX_UNPAIRED = 8                # connections of phones that aren't paired
HELLO_SECONDS = 5               # to identify itself and finish TLS
# A phone that leaves the network says nothing, and an idle link reads
# nothing: without TCP keepalive it stays "connected" for hours, and the
# daemon neither announces nor answers that phone. kdeconnect-kde's values
# (its bug 476747): idle seconds, seconds between probes, probes, about 60 s.
KEEPALIVE = (30, 10, 3)
PAIR_CLOCK_SECONDS = 1800       # kdeconnect-kde's ALLOWED_TIMESTAMP_TIME_DIFFERENCE
DEVICE_ID = re.compile(r"^[A-Za-z0-9_]{32,38}$")
NAME_JUNK = re.compile(r"[\"',;:.!?()\[\]<>]")   # kdeconnect-kde's filterName
# What this computer takes from a phone and sends to it; the phone's app
# hides everything else. The battery only fills the panel button's tooltip;
# findmyphone rings the phone (Ring My Phone). sftp is Browse Phone: this
# computer asks, and the phone answers with a one-time login (ADR-015).
# mpris in and mpris.request out are what the phone plays (ADR-018).
INCOMING = ["kdeconnect.share.request", "kdeconnect.clipboard", "kdeconnect.ping", "kdeconnect.battery",
            "kdeconnect.sftp", "kdeconnect.mpris"]
OUTGOING = ["kdeconnect.share.request", "kdeconnect.clipboard", "kdeconnect.ping",
            "kdeconnect.findmyphone.request", "kdeconnect.sftp.request", "kdeconnect.mpris.request"]
# The phone's notifications (ADR-013). capabilities() adds these only while
# the setting is on, so the phone's app hides them until then. Replying and
# the app's own buttons are a later step: those packet types are never announced.
NOTIFICATION_IN = "kdeconnect.notification"
NOTIFICATION_OUT = "kdeconnect.notification.request"
# Calls (ADR-014). The same: announced only while the setting is on. Mute is
# the one packet this computer sends. The old kdeconnect.telephony.request
# and the sms event are not this step.
CALL_IN = "kdeconnect.telephony"
CALL_OUT = "kdeconnect.telephony.request_mute"
CALL_EVENTS = ("ringing", "talking", "missedCall")
# Media control from the phone (ADR-016). Announced only while the setting is
# on. This computer's players go out; play, pause, seek and volume come in.
# The cover is a file on a payload port, and only the file the player is
# already showing, so the phone can't ask for some other file.
MEDIA_IN = "kdeconnect.mpris.request"
MEDIA_OUT = "kdeconnect.mpris"
MEDIA_SLOP_MS = 4000            # a position jump beyond playback, over this, is a seek
ART_BYTES = 8 << 20             # a cover larger than this is not sent
MEDIA_TEXT = 300                # characters of a title, artist or album sent to the phone
ART_URL_LIMIT = 2000
MEDIA_DAY_MS = 24 * 60 * 60 * 1000
# What the phone plays (ADR-018): the same two packet types the other way
# round. The phone's app (its media control receiver) sends kdeconnect.mpris
# about its own players, and this computer asks and controls them with
# kdeconnect.mpris.request. Always announced while the connection is on:
# nothing here acts on the computer. The phone popup shows one player.
PHONE_MEDIA_IN = "kdeconnect.mpris"
PHONE_MEDIA_OUT = "kdeconnect.mpris.request"
PHONE_PLAYERS = 10              # players kept per phone; the app names one per app
# `player ACTION`: the word the app takes for each.
PHONE_PLAYER_ACTIONS = {"play": "Play", "pause": "Pause", "play-pause": "PlayPause",
                        "next": "Next", "previous": "Previous"}
# Named commands the phone may run (ADR-017). capabilities() adds these only
# while the list has one, so the phone's app hides them until then. The phone
# is sent the names and asks for one by its key. The command line is never in
# a packet, and a command line the phone sends is never run.
COMMAND_IN = "kdeconnect.runcommand.request"
COMMAND_OUT = "kdeconnect.runcommand"
MAX_COMMANDS = 20               # how many the page keeps; the packet stays small
COMMAND_NAME = 40               # characters of the name the phone is sent
COMMAND_TEXT = 300              # characters of the command line, which stays here
# Browse Phone (ADR-015). The phone's SSH server uses the same key as its
# certificate (its RsaHelper key, EC P-256 on current Android, RSA on old
# ones), so the key ssh-keyscan reads is compared to the pinned certificate
# and a different one is never logged into. GVfs runs ssh, which asks before
# trusting a new host; the password goes to that prompt's stdin.
SFTP_IN = "kdeconnect.sftp"
SFTP_OUT = "kdeconnect.sftp.request"
SFTP_SECONDS = 45               # the phone may be asking the user for file access
KEYSCAN_SECONDS = 8
MOUNT_SECONDS = 30
# gvfs-backends ships this; the menu entry is hidden without it, as the
# screenshot entry is hidden without grim.
GVFS_SFTP = ("/usr/libexec/gvfsd-sftp", "/usr/lib/gvfs/gvfsd-sftp")
NOT_THE_PHONE = "this isn't the phone that paired, so nothing was opened"
# The phone's answer to Browse Phone was missing a part (TXT-6: what to do).
NO_PHONE_FILES = "the phone didn't open its files. Open its app, then try again"

ANNOUNCE_SECONDS = 60           # broadcast while no phone is connected
PAIR_SECONDS = 120              # how long `pair` waits for a phone to ask
PAIR_ANSWER_SECONDS = 30        # the phone gives up on a request after 30 s
OFFER_SECONDS = 60              # how long a file sent to the phone is offered
TRANSFER_SECONDS = 30           # a file transfer that stalls this long fails
# A phone that was idle a few seconds may take no bytes at all on a new
# payload connection for about 10 s, and its app gives up after 10 s
# (kdeconnect-android's socket timeout); an offer made again right after
# mostly goes through. Tries per file sent to a phone.
SEND_TRIES = 3
TRANSFER_EVENT_SECONDS = 0.5    # a moving transfer's `watch` line at most this often (PERF-5)
# Text sent to the phone lands on its clipboard, and the app's clipboard sync
# sends it straight back (at once, or when the app next comes to the front).
# A clipboard that only repeats what was sent this long ago is dropped.
ECHO_SECONDS = 600
NOTIFY_MS = 30000               # mako's 5 s default is too short to click
ICON_BYTES = 1 << 20            # a notification's icon; a larger payload is ignored
ICON_FILES = 200                # cached icons kept (some apps send each contact's photo)
ICON_SECONDS = 5                # the phone is on the LAN; an icon must not stall the link
SYNC_SECONDS = 3                # after asking, silent notifications are the ones already there
NOTIFY_BODY = 300               # characters of a phone notification shown here
APP_NAME_LIMIT = 80
SEEN_APPS = 50                  # app names kept for the Settings list
# Each phone notification shown here stays until it's dismissed, and holds a
# waiting notify-send (about 0.7 MB). Past this many the oldest is closed here;
# it stays on the phone.
MAX_PHONE_NOTES = 20
HINT_BODY = "Its notifications stay off until you allow them in Phone settings."
IMAGE_PNG = b"\x89PNG\r\n\x1a\n"
IMAGE_JPEG = b"\xff\xd8\xff"
FREE_MARGIN = 100 * 1024 * 1024 # a file is refused if it leaves less free
RECEIVED_ITEMS = 20
RECEIVED_DAYS = 7
NETWORK_TYPES = ("802-11-wireless", "802-3-ethernet")
LAPTOP_CHASSIS = {"8", "9", "10", "14", "31", "32"}
# The notification's click opens only files like these; anything else (a
# script, a .desktop file, a program) only shows its folder.
OPENABLE = ("image/", "audio/", "video/", "text/plain", "application/pdf",
            "application/vnd.oasis.opendocument.", "application/msword",
            "application/vnd.openxmlformats-officedocument.", "application/vnd.ms-")
URL_IN_TEXT = re.compile(r"https?://[^\s\"'<>]+")
# Addresses another package opens (an app's way back from its own phone
# app, docs/design/flickos-phone.md ADR-006): a received text that is exactly one
# address, nothing else, whose scheme has a file here holding the app's name
# for the notification. A click opens it with xdg-open; nothing opens by
# itself, and this program names no app.
OPEN_SCHEMES = PREFIX + "/usr/share/flickos/phone/open-schemes"
SCHEME_ADDRESS = re.compile(r"([A-Za-z][A-Za-z0-9+.-]*):\S+")
NEVER_OPENED = ("file", "http", "https", "javascript", "data")    # whatever a folder says
APP_NAME_CHARS = 40
# xdg-open gets the address as one argument: Linux refuses longer ones.
MAX_ARG_BYTES = 131071
# Other programs offer Send to Phone while this name is found on PATH
# (flickos-screenshot's markup window). The daemon keeps it as a link in
# $XDG_RUNTIME_DIR/flickos/bin, which flickos-settings' flickos-session puts
# last on PATH, so it is there exactly while the phone connection is on.
ON_LINK = "flickos-phone-on"
# The panel button (custom/phone in flickos-layouts' common/modules.jsonc,
# in the panel only while this is on): waybar runs `status --panel` again
# when it gets SIGRTMIN+PANEL_SIGNAL, which the daemon sends when a phone
# connects or goes away. flick-tiler's button uses 8.
PANEL_SIGNAL = 9
MENU_RECEIVED = 5               # the newest received items in the button's menu
SCREENSHOT_DELAY = 0.4          # seconds for the menu to leave the screen before grim
# The Phone window (window.py), loaded only by `window`. A second `window`
# writes the page here and signals the PID in the lock (HIG WIN-2).
WINDOW_CODE = PREFIX + "/usr/share/flickos/phone/window.py"
WINDOW_LOCK = "window.lock"
WINDOW_REQUEST = "window-request"
WINDOW_PAGES = ("overview", "received")
# watch keeps a control connection open: the window, and later the popup.
MAX_WATCHERS = 8
TRANSFER_FIELDS = ("id", "direction", "name", "device", "done", "size", "state")
# Show Phone Screen runs this, with --to ID while one phone is connected; only
# shown while it is installed (the add-on's design, ADR-008, Q8: the menu
# never offers what isn't there).
SCREEN_COMMAND = "flickos-phone-screen"
# The same add-on's second screen (its docs/design/flickos-second-screen.md,
# ADR-007): SCREEN_COMMAND's argv for on and off, and the file in
# $XDG_RUNTIME_DIR that exists while it is on.
SECOND_SCREEN_ON = ("second-screen", "on", "--notify")
SECOND_SCREEN_OFF = ("second-screen", "off", "--notify")
SECOND_SCREEN_FILE = os.path.join("flickos", "second-screen", "on")


@dataclasses.dataclass(frozen=True)
class Action:
    """One action the Phone window, the popup and the menu share (ADR-012).
    label is the menu's words. short is the tile's, in the window and the
    popup, where everything is about the phone. command is a flickos-phone
    argv. needs is "" (a connected phone is enough), "grim", "files"
    (gvfsd-sftp), "screen" (SCREEN_COMMAND on PATH), "second-off" or
    "second-on" (SCREEN_COMMAND on PATH and the second screen off or on)."""

    id: str
    label: str
    short: str
    icon: str
    command: tuple
    needs: str = ""


# In menu order. The command line stays out of anything a phone sent: each
# argv is this program, or SCREEN_COMMAND for the screen add-on.
ACTIONS = (
    Action("files", "Send Files to Phone…", "Send Files…", "document-send",
           ("flickos-phone", "send", "--choose", "--notify")),
    Action("text", "Send Text to Phone…", "Send Text…", "document-edit",
           ("flickos-phone", "send", "--type-text", "--notify")),
    Action("clipboard", "Send Clipboard to Phone", "Send Clipboard", "edit-copy",
           ("flickos-phone", "send", "--clipboard", "--notify")),
    Action("screenshot", "Send Screenshot to Phone", "Send Screenshot", "applets-screenshooter",
           ("flickos-phone", "send", "--screenshot", "--notify"), "grim"),
    Action("ring", "Ring My Phone", "Ring Phone", "phone", ("flickos-phone", "ring", "--notify")),
    Action("browse", "Browse Phone", "Browse Files", "folder",
           ("flickos-phone", "browse", "--notify"), "files"),
    Action("screen", "Show Phone Screen", "Show Screen", "video-display", (), "screen"),
    Action("second-screen", "Use as Second Screen", "Second Screen", "video-joined-displays",
           SECOND_SCREEN_ON, "second-off"),
    Action("second-screen-stop", "Stop Second Screen", "Stop Second Screen", "video-joined-displays",
           SECOND_SCREEN_OFF, "second-on"),
)
# The actions that run SCREEN_COMMAND, with the argv after it.
SCREEN_NEEDS = ("screen", "second-off", "second-on")


class PhoneError(Exception):
    pass


class ProtocolError(Exception):
    pass


def warn(message):
    print(f"flickos-phone: {message}", file=sys.stderr, flush=True)


# --- Places ---------------------------------------------------------------------

def home_dir(variable, *default):
    return os.environ.get(variable) or os.path.join(os.path.expanduser("~"), *default)


def config_home():
    return home_dir("XDG_CONFIG_HOME", ".config")


def data_dir():
    return os.path.join(home_dir("XDG_DATA_HOME", ".local", "share"), "flickos", "phone")


def state_home():
    return home_dir("XDG_STATE_HOME", ".local", "state")


def state_dir():
    return os.path.join(state_home(), "flickos", "phone")


def user_conf():
    return os.path.join(config_home(), "flickos", "phone")


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base or not os.path.isabs(base) or not os.path.isdir(base):
        raise PhoneError("XDG_RUNTIME_DIR is not set")
    return os.path.join(base, "flickos", "phone")


def control_path():
    return os.path.join(runtime_dir(), "control")


def on_link_path():
    return os.path.join(os.path.dirname(runtime_dir()), "bin", ON_LINK)


def make_on_link(target):
    path = on_link_path()
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with contextlib.suppress(FileNotFoundError):
        os.unlink(tmp)
    os.symlink(target, tmp)
    os.replace(tmp, path)


def remove_on_link():
    with contextlib.suppress(FileNotFoundError, PhoneError):
        os.unlink(on_link_path())


def live_session():
    try:
        with open(os.path.join(PROC, "cmdline"), encoding="utf-8") as f:
            return "boot=live" in f.read().split()
    except OSError:
        return False


def write_atomic(path, text, mode=0o644):
    folder = os.path.dirname(path)
    os.makedirs(folder, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def write_bytes(path, data, mode=0o644):
    folder = os.path.dirname(path)
    os.makedirs(folder, mode=0o700, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".", suffix=".tmp")
    try:
        os.write(fd, data)
    except BaseException:
        os.close(fd)
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    os.close(fd)
    try:
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


# --- Settings -------------------------------------------------------------------

@dataclasses.dataclass
class Settings:
    enabled: bool = False
    name: str = ""              # empty: the computer's name
    networks: tuple = ()
    notifications: bool = False # the phone's notifications on this computer
    notification_apps: tuple = ()  # app names that may show; none until allowed
    calls: bool = False         # a ringing phone, and pausing what is playing
    media: bool = False         # the phone controls what's playing here
    commands: tuple = ()        # Command, named commands the phone may run


@dataclasses.dataclass(frozen=True)
class Command:
    """A command the user named. The phone is sent the key and the name."""

    key: str
    name: str
    command: str


KEYS = {"enabled": "Enabled", "name": "Name", "networks": "Networks",
        "notifications": "Notifications", "notification_apps": "NotificationApps",
        "calls": "Calls", "media": "Media", "commands": "Commands"}


def read_ini(path):
    ini = configparser.ConfigParser(interpolation=None)
    try:
        ini.read(path, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError) as error:
        warn(f"{path}: {error}")
        return {}
    return dict(ini[SECTION]) if ini.has_section(SECTION) else {}


def parse_settings(values):
    settings = Settings()
    if "enabled" in values:
        settings.enabled = values["enabled"].strip().lower() in ("yes", "true", "1", "on")
    if values.get("name", "").strip():
        settings.name = clean_name(values["name"])
    if "networks" in values:
        settings.networks = tuple(dict.fromkeys(values["networks"].split()))
    if "notifications" in values:
        settings.notifications = values["notifications"].strip().lower() in ("yes", "true", "1", "on")
    if "calls" in values:
        settings.calls = values["calls"].strip().lower() in ("yes", "true", "1", "on")
    if "media" in values:
        settings.media = values["media"].strip().lower() in ("yes", "true", "1", "on")
    if values.get("notificationapps", "").strip():
        settings.notification_apps = parse_app_list(values["notificationapps"])
    if values.get("commands", "").strip():
        settings.commands = commands_from_text(values["commands"])
    return settings


def parse_app_list(text):
    """App names from the user's NotificationApps value (a JSON list). A broken
    value means none are allowed."""
    try:
        data = json.loads(text)
    except ValueError:
        warn("notification apps: not a list, so none are allowed")
        return ()
    if not isinstance(data, list):
        return ()
    names = []
    for item in data:
        name = clean_app_name(item if isinstance(item, str) else "")
        if name and name not in names:
            names.append(name)
    return tuple(names[:SEEN_APPS])


def capabilities(settings):
    """What the identity packet announces. The phone's notifications, calls
    and media control are added only while that setting is on. Named commands
    are added only while the list has one."""
    incoming, outgoing = list(INCOMING), list(OUTGOING)
    if settings.notifications:
        incoming.append(NOTIFICATION_IN)
        outgoing.append(NOTIFICATION_OUT)
    if settings.calls:
        incoming.append(CALL_IN)
        outgoing.append(CALL_OUT)
    if settings.media:
        incoming.append(MEDIA_IN)
        outgoing.append(MEDIA_OUT)
    if settings.commands:
        incoming.append(COMMAND_IN)
        outgoing.append(COMMAND_OUT)
    return incoming, outgoing


def load_settings():
    values = read_ini(SYSTEM_CONF)
    values.update(read_ini(user_conf()))
    return parse_settings(values)


def system_settings():
    return parse_settings(read_ini(SYSTEM_CONF))


def setting_text(settings, key):
    value = getattr(settings, key)
    if key == "enabled":
        return "yes" if value else "no"
    if key == "networks":
        return " ".join(value)
    if key in ("notifications", "calls", "media"):
        return "yes" if value else "no"
    if key == "notification_apps":
        return "\n".join(value)
    if key == "commands":
        return commands_text(value)
    return value


def save_settings(**changes):
    """Write settings to the user's file, keeping its other keys. None removes
    one, so the system's applies again. A change that shows is recorded."""
    before = load_settings()
    ini = configparser.ConfigParser(interpolation=None)
    ini.optionxform = str
    with contextlib.suppress(configparser.Error, UnicodeDecodeError):
        ini.read(user_conf(), encoding="utf-8")
    if not ini.has_section(SECTION):
        ini.add_section(SECTION)
    for key, value in changes.items():
        for existing in list(ini[SECTION]):
            if existing.lower() == KEYS[key].lower():
                ini.remove_option(SECTION, existing)
        if value is None:
            continue
        if key == "enabled":
            value = "yes" if value else "no"
        elif key == "networks":
            value = " ".join(value)
        elif key == "notification_apps":
            value = json.dumps(list(value), ensure_ascii=False)
        elif key == "commands":
            value = commands_text(value) or "[]"
        elif key in ("notifications", "calls", "media"):
            value = "yes" if value else "no"
        ini[SECTION][KEYS[key]] = str(value)
    out = [f"[{SECTION}]"] + [f"{key}={value}" for key, value in ini[SECTION].items()]
    write_atomic(user_conf(), "\n".join(out) + "\n")
    after = load_settings()
    for key in changes:
        old, new = setting_text(before, key), setting_text(after, key)
        if key == "name":
            old, new = old or DEFAULT_CHOICE, new or DEFAULT_CHOICE
        # notification-apps is the command's word; the field can't be hyphenated.
        record({"notification_apps": "notification-apps"}.get(key, key), old, new)
    return after


def clean_name(name):
    """A name the phone accepts: no "',;:.!?()[]<>, at most 32 characters."""
    return NAME_JUNK.sub("", name).strip()[:32].strip()


def clean_app_name(name):
    """An app name from the phone, or from the command that allows one: one
    line, no extra spaces, short enough to be a setting."""
    if not isinstance(name, str):
        return ""
    name = " ".join(name.split())
    return name[:APP_NAME_LIMIT].strip()


def checked_command(name, command):
    """A name and command line the page will keep. Raises PhoneError when
    either is missing, too long, or the command isn't one line."""
    name = " ".join(name.split()) if isinstance(name, str) else ""
    if not name:
        raise PhoneError("commands add: a name")
    if len(name) > COMMAND_NAME:
        raise PhoneError(f"the name can be at most {COMMAND_NAME} characters")
    if not isinstance(command, str) or any(char in command for char in "\n\r\t\x00"):
        raise PhoneError("the command has to be one line")
    command = command.strip()
    if not command:
        raise PhoneError("commands add: the command to run")
    if len(command) > COMMAND_TEXT:
        raise PhoneError(f"the command can be at most {COMMAND_TEXT} characters")
    return name, command


def command_key(key):
    """Whether key is a command's id, the form uuid4 stores."""
    if not isinstance(key, str):
        return False
    try:
        return str(uuid.UUID(key)) == key
    except ValueError:
        return False


def command_from_json(item):
    """One stored command, or None when the entry can't be kept."""
    if not isinstance(item, dict):
        return None
    try:
        name, command = checked_command(item.get("name"), item.get("command"))
    except PhoneError:
        return None
    key = item.get("key")
    if not command_key(key):
        return None
    return Command(key, name, command)


def parse_command_list(text):
    """Commands from a JSON list. None when the text isn't that list, so a
    broken value is never half-applied."""
    try:
        data = json.loads(text)
    except ValueError:
        return None
    if not isinstance(data, list) or len(data) > MAX_COMMANDS:
        return None
    commands = []
    for item in data:
        command = command_from_json(item)
        if command is None or any(old.key == command.key or old.name == command.name for old in commands):
            return None
        commands.append(command)
    return tuple(commands)


def commands_from_text(text):
    """Commands from the user's Commands value. A broken value means none."""
    parsed = parse_command_list(text)
    if parsed is None:
        warn("commands: not a list of named commands, so none are kept")
        return ()
    return parsed


def commands_text(commands):
    """The list as one line, for the user's file and for History. Empty when
    there are none, so the default reads as nothing."""
    if not commands:
        return ""
    return json.dumps([{"key": item.key, "name": item.name, "command": item.command} for item in commands],
                      ensure_ascii=False, separators=(",", ":"))


def commands_packet(commands):
    """What the phone is sent: each command's key and name. The command line
    is not in it. commandList is a JSON string, as the app reads it, and the
    command field repeats the name so the app has one to show."""
    listed = {item.key: {"name": item.name, "command": item.name} for item in commands}
    return {"commandList": json.dumps(listed, ensure_ascii=False, separators=(",", ":")),
            "canAddCommand": False}


def run_named_command(command):
    """Run a command the user named, as this user. It is not waited on: a
    command that keeps running must not stall the phone's link. The argument
    list is the shell and the stored line, so nothing the phone sent is part
    of it."""
    try:
        subprocess.Popen(["/bin/sh", "-c", command.command], cwd=os.path.expanduser("~"),
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as error:
        warn(f"{command.name}: {error}")


def computer_name():
    """The pretty host name (hostnamectl set-hostname --pretty), else the host name."""
    try:
        with open(MACHINE_INFO, encoding="utf-8") as f:
            for line in f:
                key, _, value = line.strip().partition("=")
                if key == "PRETTY_HOSTNAME" and value.strip().strip("\"'"):
                    return clean_name(value.strip().strip("\"'")) or "FlickOS"
    except OSError:
        pass
    return clean_name(socket.gethostname()) or "FlickOS"


def device_name(settings):
    return settings.name or computer_name()


def device_type():
    try:
        with open(DMI_CHASSIS, encoding="utf-8") as f:
            return "laptop" if f.read().strip() in LAPTOP_CHASSIS else "desktop"
    except OSError:
        return "desktop"


# --- History ------------------------------------------------------------------------
# Every change of a setting is recorded for Settings > History. One JSON line per
# change, appended; the format is shared with flickos-control, flickos-layout and
# flick-tiler (docs/design/flickos-history.md, ADR-002).

HISTORY_OWNER = "flickos-phone"
HISTORY_FILE = "history.jsonl"      # in $XDG_STATE_HOME/flickos
HISTORY_LOCK = "history.lock"
HISTORY_BYTES = 256 * 1024          # above this, the older half is dropped
DEFAULT_CHOICE = "default"


def history_enabled():
    enabled = True
    for path in (HISTORY_CONF, os.path.join(config_home(), "flickos", "history")):
        ini = configparser.ConfigParser(interpolation=None)
        try:
            ini.read(path, encoding="utf-8")
            value = ini.get("History", "Enabled", fallback=None)
        except (configparser.Error, UnicodeDecodeError):
            continue
        if value is not None:
            enabled = value.strip().lower() not in ("no", "false", "off", "0")
    return enabled


def record(key, old, new):
    """Add a change to the history. It never stops the change itself: a
    history that can't be written is only a warning."""
    if old == new or not history_enabled():
        return
    now = time.time_ns()
    entry = {"v": 1, "id": str(now),
             "time": datetime.datetime.fromtimestamp(now / 1e9).astimezone().isoformat(timespec="seconds"),
             "owner": HISTORY_OWNER, "key": key, "old": old, "new": new}
    folder = os.path.join(state_home(), "flickos")
    try:
        os.makedirs(folder, mode=0o700, exist_ok=True)
        with open(os.path.join(folder, HISTORY_LOCK), "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            path = os.path.join(folder, HISTORY_FILE)
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a", encoding="utf-8") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
                size = os.fstat(f.fileno()).st_size
            if size > HISTORY_BYTES:
                trim_history(path)
    except OSError as error:
        warn(f"the history can't be written: {error}")


def trim_history(path):
    """Keep the newest lines that fit in half of HISTORY_BYTES (under the lock)."""
    with open(path, encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    kept, size = [], 0
    for line in reversed(lines):
        size += len(line.encode())
        if size > HISTORY_BYTES // 2:
            break
        kept.append(line)
    write_atomic(path, "".join(reversed(kept)), mode=0o600)


# --- Identity and certificates ----------------------------------------------------

@dataclasses.dataclass
class Identity:
    id: str
    cert: str       # paths
    key: str
    der: bytes


def ensure_identity():
    """This computer's device id and certificate, made at the first use: a UUID
    without dashes and a self-signed EC P-256 certificate whose common name is
    the id, as kdeconnect-kde makes them (core/sslhelper.cpp)."""
    folder = data_dir()
    os.makedirs(os.path.join(folder, "devices"), mode=0o700, exist_ok=True)
    os.chmod(folder, 0o700)
    id_path = os.path.join(folder, "device_id")
    cert, key = os.path.join(folder, "cert.pem"), os.path.join(folder, "key.pem")
    if not os.path.exists(id_path):
        write_atomic(id_path, uuid.uuid4().hex + "\n")
    with open(id_path, encoding="utf-8") as f:
        device_id = f.read().strip()
    if not DEVICE_ID.match(device_id):
        raise PhoneError(f"{id_path}: not a device id")
    if not (os.path.exists(cert) and os.path.exists(key)):
        old_umask = os.umask(0o077)
        try:
            result = subprocess.run(
                ["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1",
                 "-noenc", "-keyout", key, "-out", cert, "-sha512", "-days", "3650",
                 "-subj", f"/O=KDE/OU=KDE Connect/CN={device_id}"],
                capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.TimeoutExpired) as error:
            raise PhoneError(f"can't make a certificate: {error}") from None
        finally:
            os.umask(old_umask)
        if result.returncode != 0:
            raise PhoneError(f"can't make a certificate: {result.stderr.strip()}")
    with open(cert, encoding="ascii") as f:
        der = ssl.PEM_cert_to_DER_cert(f.read())
    return Identity(device_id, cert, key, der)


def der_item(data, pos):
    """(tag, start of the value, end) of the DER item at pos."""
    if pos + 2 > len(data):
        raise ProtocolError("certificate cut short")
    tag, length = data[pos], data[pos + 1]
    pos += 2
    if length & 0x80:
        count = length & 0x7F
        if not 1 <= count <= 4 or pos + count > len(data):
            raise ProtocolError("bad certificate length")
        length = int.from_bytes(data[pos:pos + count], "big")
        pos += count
    if pos + length > len(data):
        raise ProtocolError("certificate cut short")
    return tag, pos, pos + length


def der_children(data, start, end):
    items, pos = [], start
    while pos < end:
        tag, value, pos = der_item(data, pos)
        items.append((tag, value, pos))
    return items


def cert_fields(der):
    """(common name of the subject, SubjectPublicKeyInfo DER) of a certificate.

    tbsCertificate is: [0] version, serial, signature, issuer, validity,
    subject, subjectPublicKeyInfo, ... (RFC 5280)."""
    _, cert, _ = der_item(der, 0)
    _, tbs, tbs_end = der_item(der, cert)
    fields = der_children(der, tbs, tbs_end)
    if fields and fields[0][0] == 0xA0:
        fields = fields[1:]
    if len(fields) < 6:
        raise ProtocolError("not a certificate")
    _, subject, subject_end = fields[4]
    # The whole item, header and all: it starts where the subject ends.
    spki = der[subject_end:fields[5][2]]
    common_name = None
    for _, rdn, rdn_end in der_children(der, subject, subject_end):
        for _, pair, pair_end in der_children(der, rdn, rdn_end):
            parts = der_children(der, pair, pair_end)
            if len(parts) == 2 and der[parts[0][1]:parts[0][2]] == b"\x55\x04\x03":
                common_name = der[parts[1][1]:parts[1][2]].decode("utf-8", "replace")
    return common_name, spki


def verification_key(my_der, their_der, timestamp):
    """The key both screens show while pairing (kdeconnect-kde's
    PairingHandler::verificationKey): SHA-256 of the larger public key, the
    smaller one and the timestamp, the first 8 hex digits in capitals."""
    a, b = cert_fields(my_der)[1], cert_fields(their_der)[1]
    if a < b:
        a, b = b, a
    return hashlib.sha256(a + b + str(timestamp).encode()).hexdigest()[:8].upper()


# SubjectPublicKeyInfo algorithm OIDs (the value, without the DER tag).
_EC_OID = bytes.fromhex("2a8648ce3d0201")          # 1.2.840.10045.2.1 ecPublicKey
_P256_OID = bytes.fromhex("2a8648ce3d030107")      # 1.2.840.10045.3.1.7 prime256v1
_RSA_OID = bytes.fromhex("2a864886f70d010101")     # 1.2.840.113549.1.1.1 rsaEncryption


def _ssh_string(data):
    return len(data).to_bytes(4, "big") + data


def _mpint(data):
    """An SSH mpint's contents: a big-endian integer, with a leading zero when
    the high bit is set so it stays positive."""
    data = data.lstrip(b"\x00") or b"\x00"
    if data[0] & 0x80:
        data = b"\x00" + data
    return data


def _der_integer(data, item):
    return data[item[1]:item[2]].lstrip(b"\x00") or b"\x00"


def ssh_public_blob(spki):
    """The SSH public key blob of a certificate's subject public key.

    The phone's SFTP server presents this key as its host key. Anything else
    (another curve, a key that doesn't parse) is refused: an unseen key is
    never trusted."""
    tag, start, end = der_item(spki, 0)
    if tag != 0x30:
        raise ProtocolError("not a public key")
    fields = der_children(spki, start, end)
    if len(fields) < 2 or fields[1][0] != 0x03:
        raise ProtocolError("not a public key")
    unused = spki[fields[1][1]:fields[1][2]]
    if not unused or unused[0] != 0:
        raise ProtocolError("not a public key")
    raw = unused[1:]
    algorithm = der_children(spki, fields[0][1], fields[0][2])
    if not algorithm or algorithm[0][0] != 0x06:
        raise ProtocolError("not a public key")
    oid = spki[algorithm[0][1]:algorithm[0][2]]
    if oid == _EC_OID:
        if len(algorithm) < 2 or spki[algorithm[1][1]:algorithm[1][2]] != _P256_OID:
            raise ProtocolError("the phone's key isn't a kind this can check")
        if len(raw) != 65 or raw[0] != 4:
            raise ProtocolError("the phone's key isn't a kind this can check")
        return _ssh_string(b"ecdsa-sha2-nistp256") + _ssh_string(b"nistp256") + _ssh_string(raw)
    if oid == _RSA_OID:
        inner, inner_start, inner_end = der_item(raw, 0)
        if inner != 0x30:
            raise ProtocolError("not a public key")
        numbers = der_children(raw, inner_start, inner_end)
        if len(numbers) < 2 or numbers[0][0] != 0x02 or numbers[1][0] != 0x02:
            raise ProtocolError("not a public key")
        modulus, exponent = _der_integer(raw, numbers[0]), _der_integer(raw, numbers[1])
        return _ssh_string(b"ssh-rsa") + _ssh_string(_mpint(exponent)) + _ssh_string(_mpint(modulus))
    raise ProtocolError("the phone's key isn't a kind this can check")


def host_fingerprint(blob):
    """OpenSSH's SHA256 fingerprint of a public key blob, without the trailing
    padding its prompt leaves off."""
    digest = base64.b64encode(hashlib.sha256(blob).digest()).decode("ascii").rstrip("=")
    return "SHA256:" + digest


def parse_keyscan(text):
    """Public key blobs from ssh-keyscan. Comment and hashed lines are left out."""
    blobs = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 3 or parts[0].startswith("#") or parts[0].startswith("|"):
            continue
        try:
            blob = base64.b64decode(parts[2] + "=" * (-len(parts[2]) % 4), validate=False)
        except (ValueError, IndexError):
            continue
        if blob:
            blobs.append(blob)
    return blobs


def files_available():
    """Whether the file manager can open an SFTP folder (gvfs-backends)."""
    return any(os.path.isfile(path) and os.access(path, os.X_OK) for path in GVFS_SFTP)


def clean_remote_path(path):
    """A folder the phone offered, or None. Only an absolute path, with no
    parent segments and no characters that would change the address."""
    if not isinstance(path, str) or not path.startswith("/") or len(path) > 500:
        return None
    if any(ord(char) < 32 or char in "\\?#%" for char in path):
        return None
    if ".." in path.split("/"):
        return None
    return path


def folder_label(name, path):
    """The name shown for a folder. The phone's name when it is short and
    plain, otherwise the last part of the path."""
    text = name if isinstance(name, str) else ""
    text = "".join(char for char in text if char.isprintable()).strip()
    text = text[:60]
    if text:
        return text
    base = path.rstrip("/").rsplit("/", 1)[-1]
    return base or "Phone"


def _json_list(value):
    if isinstance(value, str):
        try:
            value = json.loads(value)
        except ValueError:
            return []
    return value if isinstance(value, list) else []


def phone_folders(body):
    """The folders the phone offered: multiPaths with its names, or the single
    path when that is all it sent. Nothing it didn't name."""
    paths, names = _json_list(body.get("multiPaths")), _json_list(body.get("pathNames"))
    folders = []
    for index, path in enumerate(paths):
        clean = clean_remote_path(path)
        if clean is None:
            continue
        name = names[index] if index < len(names) else ""
        folders.append({"path": clean, "name": folder_label(name, clean)})
    if folders:
        return folders
    path = clean_remote_path(body.get("path"))
    if path is None:
        return []
    return [{"path": path, "name": folder_label("", path)}]


def sftp_offer(body, host, device_id):
    """What Browse Phone needs from a kdeconnect.sftp packet, checked. The
    address is the paired connection's, never the address in the packet."""
    if not isinstance(body, dict):
        raise PhoneError(NO_PHONE_FILES)
    message = body.get("errorMessage")
    if isinstance(message, str) and message.strip():
        raise PhoneError("the phone didn't open its files. Allow file access in its app, then try again")
    port = body.get("port")
    if isinstance(port, str) and port.isdigit():
        port = int(port)
    if isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535:
        raise PhoneError(NO_PHONE_FILES)
    user = body.get("user")
    if not isinstance(user, str) or not re.fullmatch(r"[A-Za-z0-9._-]{1,32}", user):
        raise PhoneError(NO_PHONE_FILES)
    password = body.get("password")
    if (not isinstance(password, str) or not 1 <= len(password) <= 200
            or any(char in password for char in "\r\n\x00")):
        raise PhoneError(NO_PHONE_FILES)
    try:
        ipaddress.ip_address(host)
    except ValueError:
        raise PhoneError(NO_PHONE_FILES) from None
    folders = phone_folders(body)
    if not folders:
        raise PhoneError("the phone didn't offer any folders. Allow file access in its app, then try again")
    return {"id": device_id, "host": host, "port": port, "user": user, "password": password,
            "folders": folders}


def sftp_uri(host, port, user, path):
    """An SFTP address with the password left out (it would show in the
    process list)."""
    where = f"[{host}]" if ":" in host else host
    return "sftp://{user}@{host}:{port}{path}".format(
        user=urllib.parse.quote(user, safe=""), host=where, port=port,
        path=urllib.parse.quote(path, safe="/"))


class MountDialogue:
    """What to answer gio mount. A new host's fingerprint must be the paired
    phone's before 'yes'; the password is sent only after that, or when ssh
    already knows the key and asks for the password straight away (the caller
    compared that key first)."""

    def __init__(self, fingerprint, password):
        self.fingerprint, self.password = fingerprint, password
        self.buffer = ""
        self.shown = ""
        self.checked = False
        self.failed = False
        self.password_sent = False
        self.choice_sent = False

    def public(self):
        return self.shown.replace(self.password, "")

    def feed(self, chunk):
        self.buffer += chunk
        self.shown += chunk
        reply = ""
        if not self.choice_sent and "Choice:" in self.buffer:
            before, _, self.buffer = self.buffer.partition("Choice:")
            self.choice_sent = True
            if self.fingerprint in before:
                self.checked = True
                reply += "1\n"
            else:
                self.failed = True
                reply += "2\n"
        if not self.password_sent and not self.failed and "Password:" in self.buffer:
            _, _, self.buffer = self.buffer.partition("Password:")
            self.checked = True
            self.password_sent = True
            reply += self.password + "\n"
        return reply


def keep_alive(sock):
    """Drop a link whose phone went away (KEEPALIVE); the kernel sends the
    probes, the daemon never wakes for them."""
    idle, interval, count = KEEPALIVE
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
    sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPIDLE, idle)
    sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPINTVL, interval)
    sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_KEEPCNT, count)


def unacknowledged(sock):
    """Bytes written to sock that the other end's TCP hasn't acknowledged."""
    count = bytearray(4)
    fcntl.ioctl(sock.fileno(), termios.TIOCOUTQ, count)
    return int.from_bytes(count, sys.byteorder)


def wait_acknowledged(sock, seconds, stopped=lambda: False):
    """Until the other end has every byte written to sock. sendall returns
    once the bytes are in our send buffer, which holds a small file whole:
    without this, a phone that drops the connection before it has them
    would count as sent, and never be offered the file again. OSError when
    the connection breaks, stalls for seconds or stopped() is true."""
    deadline = time.monotonic() + seconds
    while unacknowledged(sock):
        if error := sock.getsockopt(socket.SOL_SOCKET, socket.SO_ERROR):
            raise OSError(error, os.strerror(error))
        if stopped():
            raise OSError("cancelled")
        if time.monotonic() >= deadline:
            raise TimeoutError("the phone stopped taking the file")
        time.sleep(0.05)


def client_context(identity):
    """TLS client with our certificate. The phone's certificate isn't verified
    by ssl: the caller compares it (pairing, or the pinned one)."""
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    ctx.load_cert_chain(identity.cert, identity.key)
    return ctx


def pinned_server_context(identity, phone_der):
    """TLS server that accepts only this phone's certificate."""
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.load_cert_chain(identity.cert, identity.key)
    ctx.verify_mode = ssl.CERT_REQUIRED
    ctx.verify_flags |= ssl.VERIFY_X509_PARTIAL_CHAIN
    ctx.load_verify_locations(cadata=ssl.DER_cert_to_PEM_cert(phone_der))
    return ctx


# --- Paired phones ---------------------------------------------------------------

def devices_file():
    return os.path.join(data_dir(), "devices.json")


def cert_path(device_id):
    return os.path.join(data_dir(), "devices", device_id + ".pem")


def load_devices():
    """{id: {"name": ..., "paired": iso time}} of the paired phones."""
    try:
        with open(devices_file(), encoding="utf-8") as f:
            devices = json.load(f)
    except (OSError, ValueError):
        return {}
    return {key: value for key, value in devices.items()
            if DEVICE_ID.match(key) and isinstance(value, dict) and os.path.exists(cert_path(key))}


def save_devices(devices):
    write_atomic(devices_file(), json.dumps(devices, indent=1, ensure_ascii=False) + "\n", mode=0o600)


def paired_der(device_id):
    try:
        with open(cert_path(device_id), encoding="ascii") as f:
            return ssl.PEM_cert_to_DER_cert(f.read())
    except (OSError, ValueError):
        return None


def trust_device(device_id, name, der):
    os.makedirs(os.path.dirname(cert_path(device_id)), mode=0o700, exist_ok=True)
    write_atomic(cert_path(device_id), ssl.DER_cert_to_PEM_cert(der), mode=0o600)
    devices = load_devices()
    devices[device_id] = {"name": name, "paired": datetime.datetime.now().astimezone().isoformat(timespec="seconds")}
    save_devices(devices)
    record(f"device.{device_id}", "absent", name)


def rename_device(device_id, name):
    devices = load_devices()
    if device_id in devices and devices[device_id].get("name") != name:
        devices[device_id]["name"] = name
        save_devices(devices)


def forget_device(device_id):
    devices = load_devices()
    name = devices.pop(device_id, {}).get("name")
    with contextlib.suppress(FileNotFoundError):
        os.unlink(cert_path(device_id))
    save_devices(devices)
    if name is not None:
        record(f"device.{device_id}", name, "absent")
    return name


# --- What came from a phone ----------------------------------------------------------

def received_path():
    return os.path.join(state_dir(), "received.jsonl")


def read_received(now=None):
    now = time.time() if now is None else now
    items = []
    try:
        with open(received_path(), encoding="utf-8") as f:
            for line in f:
                with contextlib.suppress(ValueError):
                    item = json.loads(line)
                    if isinstance(item, dict) and now - item.get("time", 0) <= RECEIVED_DAYS * 86400:
                        items.append(item)
    except OSError:
        pass
    return items[-RECEIVED_ITEMS:]


def add_received(kind, device, value, now=None):
    item = {"time": time.time() if now is None else now, "device": device, "kind": kind, "value": value}
    items = read_received(item["time"]) + [item]
    os.makedirs(state_dir(), mode=0o700, exist_ok=True)
    write_atomic(received_path(), "".join(json.dumps(i, ensure_ascii=False) + "\n"
                                          for i in items[-RECEIVED_ITEMS:]), mode=0o600)


# --- Helpers the daemon runs -------------------------------------------------------

def spawn(argv):
    """Start a program that outlives nothing of ours (an app, xdg-open)."""
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as error:
        warn(f"{argv[0]}: {error}")


def copy_text(text):
    try:
        subprocess.run(["wl-copy", "--", text], check=False, timeout=10,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        warn(f"wl-copy: {error}")


def clipboard_text():
    try:
        result = subprocess.run(["wl-paste", "--no-newline", "--type", "text"], capture_output=True,
                                text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise PhoneError(f"wl-paste: {error}") from None
    if result.returncode != 0:
        raise PhoneError("the clipboard has no text")
    return result.stdout


def plain_body(text):
    """A notification body shown as written. The body is Pango markup (mako
    escapes only the title), and much of it is someone else's text: a chat
    message could otherwise restyle itself into a fake alert."""
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def notify(title, body, action=None, on_click=None):
    """A notification; a click runs on_click (mako shows no buttons, so a
    notification has at most the one action a click runs)."""
    argv = ["notify-send", "--app-name=Phone", "--icon=phone", f"--expire-time={NOTIFY_MS}", "--", title,
            plain_body(body)]
    if action and on_click:
        argv[1:1] = [f"--action=default={action}"]

    def run():
        try:
            result = subprocess.run(argv, capture_output=True, text=True, timeout=NOTIFY_MS / 1000 + 60)
        except (OSError, subprocess.TimeoutExpired):
            return
        if on_click and result.stdout.strip() == "default":
            on_click()

    threading.Thread(target=run, daemon=True).start()


# Phone notifications stay until the user dismisses them (expire time 0; mako
# then draws no timer). Each one is a notify-send that waits, so its closing
# is the process exiting. Closing it ourselves is marked first, and that is
# not a dismiss. The id is read from a terminal so it arrives before the wait
# ends (a pipe would hold it until the process exits).
_shown = {}
_shown_lock = threading.Lock()


def post_notification(summary, body, icon=None, replace=None, on_close=None, action=None, on_action=None):
    """Show a notification that stays until it is closed. Its id, or None.
    on_close runs when the user closes it, not when close_notification does.
    replace is an id of ours to update in place. action is the click (mako
    shows no buttons): on_action runs when the user clicks it."""
    if replace:
        mark_closed(replace)
    argv = ["notify-send", "--app-name=Phone", "--print-id", "--wait", "--expire-time=0",
            f"--icon={icon or 'phone'}", "--", summary, plain_body(body)]
    if action:
        argv[1:1] = [f"--action=default={action}"]
    if replace:
        argv[1:1] = [f"--replace-id={replace}"]
    master, slave = pty.openpty()
    try:
        proc = subprocess.Popen(argv, stdout=slave, stderr=subprocess.DEVNULL, close_fds=True)
    except OSError as error:
        os.close(master)
        os.close(slave)
        warn(f"notify-send: {error}")
        return None
    os.close(slave)
    proc.flickos_closed = False
    line = _read_line(master, 5)
    nid = line.decode(errors="replace").strip()
    if not nid.isdigit():
        proc.kill()
        with contextlib.suppress(OSError):
            proc.wait(timeout=2)
        os.close(master)
        return None
    with _shown_lock:
        _shown[nid] = proc

    def wait():
        with contextlib.suppress(OSError):
            proc.wait()
        # The id was the first line. A click prints the action's name after it.
        extra = b""
        if action:
            while True:
                readable, _, _ = select.select([master], [], [], 0)
                if not readable:
                    break
                try:
                    chunk = os.read(master, 256)
                except OSError:
                    break
                if not chunk:
                    break
                extra += chunk
        with contextlib.suppress(OSError):
            os.close(master)
        with _shown_lock:
            if _shown.get(nid) is proc:
                _shown.pop(nid, None)
        if proc.flickos_closed:
            return
        if action and b"default" in extra and on_action:
            on_action()
        elif on_close:
            on_close()

    threading.Thread(target=wait, daemon=True).start()
    return nid


def _read_line(fd, seconds):
    data = b""
    deadline = time.monotonic() + seconds
    while b"\n" not in data and time.monotonic() < deadline:
        readable, _, _ = select.select([fd], [], [], max(0.0, min(0.5, deadline - time.monotonic())))
        if not readable:
            continue
        try:
            chunk = os.read(fd, 256)
        except OSError:
            break
        if not chunk:
            break
        data += chunk
    return data.split(b"\n", 1)[0]


def mark_closed(nid):
    """The notification is being replaced or closed by us, so its ending is
    not the user dismissing it."""
    with _shown_lock:
        proc = _shown.get(str(nid))
    if proc is not None:
        proc.flickos_closed = True


def close_notification(nid):
    """Close a notification we showed. Nothing, if it is already gone.
    gdbus, not busctl: busctl 257 rejects a method whose signature is only
    `u` ("too few parameters"), which is CloseNotification."""
    mark_closed(nid)
    try:
        subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                        "--object-path", "/org/freedesktop/Notifications",
                        "--method", "org.freedesktop.Notifications.CloseNotification", str(nid)],
                       check=False, timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        warn(f"gdbus: {error}")


def screen_locked(proc=PROC):
    """Whether the screen is locked: FlickOS's lock program is running, or
    logind says this session is locked. Checked when a notification arrives,
    so nothing from the phone is put on a locked screen."""
    if process_named("swaylock", proc):
        return True
    return locked_hint()


def process_named(name, proc=PROC):
    try:
        entries = os.listdir(proc)
    except OSError:
        return False
    uid = os.getuid()
    for entry in entries:
        if not entry.isdigit():
            continue
        folder = os.path.join(proc, entry)
        try:
            if os.stat(folder).st_uid != uid:
                continue
            with open(os.path.join(folder, "comm"), encoding="utf-8") as f:
                if f.read().strip() == name:
                    return True
        except OSError:
            continue
    return False


def locked_hint():
    """logind's LockedHint for this session. False when it can't be asked."""
    try:
        result = subprocess.run(
            ["busctl", "get-property", "org.freedesktop.login1",
             "/org/freedesktop/login1/session/auto", "org.freedesktop.login1.Session", "LockedHint"],
            capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and result.stdout.strip().endswith("true")


def seen_apps_path():
    return os.path.join(state_dir(), "apps")


def read_seen_apps():
    """App names that have sent a notification, oldest first. The message is
    never stored: only the name, so Settings can offer it."""
    try:
        with open(seen_apps_path(), encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        return []
    names = []
    for line in lines:
        name = clean_app_name(line)
        if name and name not in names:
            names.append(name)
    return names


def remember_app(name):
    names = read_seen_apps()
    if name in names:
        return
    names.append(name)
    write_atomic(seen_apps_path(), "\n".join(names[-SEEN_APPS:]) + "\n", mode=0o600)


def notification_apps(settings):
    """Every app Settings lists: ones that have sent a notification, then any
    the user allowed before one arrived."""
    names = read_seen_apps()
    for name in settings.notification_apps:
        if name not in names:
            names.append(name)
    return names


def packet_flag(value):
    """A packet's boolean. JSON true, or the string "true" the Android app sends
    for isCancel."""
    return value is True or (isinstance(value, str) and value.strip().lower() == "true")


def caller_text(body):
    """Who is calling, for the notification: the contact's name, the number
    when there is no name, and both when they differ."""
    name = clean_app_name(body.get("contactName") if isinstance(body.get("contactName"), str) else "")
    number = clean_app_name(body.get("phoneNumber") if isinstance(body.get("phoneNumber"), str) else "")
    if name and number and name != number:
        shown = name + "\n" + number
    else:
        shown = name or number or "Unknown number"
    if len(shown) > NOTIFY_BODY:
        shown = shown[:NOTIFY_BODY - 1] + "…"
    return shown


# playerctl is a Recommends of flickos-desktop, so it may be absent. An
# instance name is what `--player` takes (playerInstance in its format).
PLAYER_NAME = re.compile(r"^[A-Za-z0-9._-]{1,200}$")
_playerctl_missing = False


def playing_players():
    """MPRIS players that are playing. Empty when playerctl isn't installed."""
    global _playerctl_missing
    if _playerctl_missing:
        return []
    try:
        result = subprocess.run(
            ["playerctl", "--all-players", "--format", "{{playerInstance}}\t{{status}}", "status"],
            capture_output=True, text=True, timeout=3)
    except FileNotFoundError:
        _playerctl_missing = True
        warn("playerctl is not installed, so nothing is paused during a call")
        return []
    except (OSError, subprocess.TimeoutExpired) as error:
        warn(f"playerctl: {error}")
        return []
    names = []
    for line in result.stdout.splitlines():
        name, sep, status = line.partition("\t")
        if sep and status.strip() == "Playing" and PLAYER_NAME.fullmatch(name) and name not in names:
            names.append(name)
    return names


def control_player(name, command):
    """pause or play one player. False when that didn't work."""
    if command not in ("pause", "play") or not PLAYER_NAME.fullmatch(name or ""):
        return False
    try:
        result = subprocess.run(["playerctl", "--player", name, command],
                                capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired) as error:
        warn(f"playerctl: {error}")
        return False
    return result.returncode == 0


# What the phone may ask a player to do. The word is the MPRIS method the KDE
# Connect app sends; playerctl's command is the value. Anything else is ignored,
# so a phone can't pass an arbitrary command through.
MEDIA_ACTIONS = {"Play": "play", "Pause": "pause", "PlayPause": "play-pause",
                 "Next": "next", "Previous": "previous", "Stop": "stop"}
MEDIA_CHANGES = ("action", "setVolume", "Seek", "SetPosition", "setLoopStatus", "setShuffle")
LOOP_VALUES = ("None", "Track", "Playlist")
# One line per player. playerctl 2.4 prints microseconds for position and
# mpris:length, and a 0.0–1.0 volume. A field may contain a newline; the
# unit separator is how the line is split back apart.
MEDIA_FORMAT = "\x1f".join(("{{playerInstance}}", "{{playerName}}", "{{status}}", "{{volume}}",
                            "{{position}}", "{{mpris:length}}", "{{artist}}", "{{title}}",
                            "{{album}}", "{{mpris:artUrl}}"))
MEDIA_COLUMNS = 10
# The players are read again when `playerctl --follow` prints a change, never
# on a timer (HIG PERF-5). Position isn't in this format: with it, playerctl
# prints every second while something plays. The phone moves its own slider,
# and a seek made on this computer reaches it with the next change.
FOLLOW_FORMAT = "\x1f".join(("{{playerInstance}}", "{{status}}", "{{volume}}", "{{mpris:length}}",
                             "{{artist}}", "{{title}}", "{{album}}", "{{mpris:artUrl}}"))


@dataclasses.dataclass(frozen=True)
class Player:
    """One MPRIS player, named the way the phone's app shows it."""

    instance: str               # what playerctl --player takes
    name: str                   # unique on the phone
    title: str
    artist: str
    album: str
    art_url: str
    length: int                 # milliseconds, or -1 when the player doesn't say
    position: int               # milliseconds
    playing: bool
    volume: int = -1            # 0–100, or -1 when the player doesn't say

    def body(self, now=True, volume=True):
        """The kdeconnect.mpris body. now is the track; volume is the level.
        The phone keeps a field it doesn't receive, so a full update always
        includes the cover address, empty when there isn't one."""
        data = {"player": self.name}
        if now:
            data.update({"title": self.title, "artist": self.artist, "album": self.album,
                         "albumArtUrl": self.art_url, "isPlaying": self.playing,
                         "pos": self.position, "length": self.length,
                         "canPlay": True, "canPause": True, "canGoNext": True,
                         "canGoPrevious": True, "canSeek": self.length > 0})
        if volume and self.volume >= 0:
            data["volume"] = self.volume
        return data

    def changed_from(self, old, elapsed_ms):
        """Whether the phone should hear about this. Position advancing with
        playback is not a change: the phone moves the slider itself."""
        if old is None:
            return True
        if (self.title, self.artist, self.album, self.art_url, self.length, self.playing) != (
                old.title, old.artist, old.album, old.art_url, old.length, old.playing):
            return True
        if self.volume != old.volume:
            return True
        if self.length <= 0:
            return False
        if not self.playing:
            return abs(self.position - old.position) > 1500
        return abs(self.position - old.position - max(0, elapsed_ms)) > MEDIA_SLOP_MS


def media_players():
    """The computer's MPRIS players. Empty when playerctl isn't installed."""
    global _playerctl_missing
    if _playerctl_missing:
        return []
    try:
        result = subprocess.run(["playerctl", "--all-players", "--format", MEDIA_FORMAT, "metadata"],
                                capture_output=True, text=True, timeout=3)
    except FileNotFoundError:
        _playerctl_missing = True
        warn("playerctl is not installed, so the phone can't control what's playing")
        return []
    except (OSError, subprocess.TimeoutExpired) as error:
        warn(f"playerctl: {error}")
        return []
    return parse_media(result.stdout)


def follow_players():
    """A playerctl that prints a line whenever a player starts, changes or
    goes away. None when playerctl isn't installed."""
    global _playerctl_missing
    if _playerctl_missing:
        return None
    try:
        return subprocess.Popen(["playerctl", "--all-players", "--follow", "--format", FOLLOW_FORMAT, "metadata"],
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except FileNotFoundError:
        _playerctl_missing = True
        warn("playerctl is not installed, so the phone can't control what's playing")
    except OSError as error:
        warn(f"playerctl: {error}")
    return None


def parse_media(text):
    """Players from playerctl's formatted metadata. playerctld is left out:
    it only repeats another player, so the phone would show everything twice.
    So is a name that also has an instance (VLC owns vlc and vlc.instancePID):
    it is the same player."""
    rows, pending = [], ""
    for line in text.splitlines():
        pending = f"{pending} {line}" if pending else line
        if pending.count("\x1f") >= MEDIA_COLUMNS - 1:
            rows.append(pending.split("\x1f"))
            pending = ""
    used, players = set(), []
    instances = {fields[0].strip() for fields in rows}
    for fields in rows:
        fields = (fields + [""] * MEDIA_COLUMNS)[:MEDIA_COLUMNS]
        instance = fields[0].strip()
        if instance == "playerctld" or not PLAYER_NAME.fullmatch(instance):
            continue
        if any(other.startswith(instance + ".instance") for other in instances):
            continue
        players.append(Player(
            instance=instance, name=unique_player_name(clean_media_text(fields[1]) or instance, used),
            playing=fields[2].strip() == "Playing", volume=parse_volume(fields[3]),
            position=parse_ms(fields[4], 0), length=parse_ms(fields[5], -1),
            artist=clean_media_text(fields[6]), title=clean_media_text(fields[7]),
            album=clean_media_text(fields[8]), art_url=clean_art_url(fields[9])))
    return players


def unique_player_name(base, used):
    """The first player keeps its name; the next with the same name is " [2]"."""
    name, number = base, 2
    while name in used:
        name = f"{base} [{number}]"
        number += 1
    used.add(name)
    return name


def clean_media_text(text):
    return " ".join(text.split())[:MEDIA_TEXT]


def clean_art_url(url):
    """A cover address the phone can use. Anything else (a data: blob, a
    huge line) is left out."""
    url = url.strip()
    if len(url) > ART_URL_LIMIT or not url.startswith(("https://", "http://", "file:")):
        return ""
    return url


def parse_volume(text):
    """playerctl's 0.0–1.0 as a percent, or -1 when it didn't say."""
    try:
        value = float(text)
    except (TypeError, ValueError):
        return -1
    if value < 0:
        return -1
    return max(0, min(100, round(value * 100)))


def parse_ms(text, missing):
    """playerctl's microseconds as milliseconds."""
    text = text.strip()
    if not text:
        return missing
    try:
        return max(0, int(float(text)) // 1000)
    except ValueError:
        return missing


def whole_number(value, low, high):
    """value as an int in range, or None. A JSON boolean is an int in Python
    and is not a number here."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    if isinstance(value, float) and not value.is_integer():
        return None
    value = int(value)
    return value if low <= value <= high else None


def offset_arg(seconds):
    """playerctl's relative position: 1.5+ or 1.5-."""
    if seconds == 0:
        return None
    return f"{abs(seconds):.3f}" + ("-" if seconds < 0 else "+")


def art_file(url):
    """The local path of a file:// cover, or None."""
    if not isinstance(url, str) or not url.startswith("file:"):
        return None
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme != "file" or parsed.netloc not in ("", "localhost"):
        return None
    path = urllib.parse.unquote(parsed.path)
    if not path.startswith("/") or "\x00" in path:
        return None
    return path


def media_command(instance, *args):
    """One playerctl command for one player. False when it didn't work."""
    if not PLAYER_NAME.fullmatch(instance or "") or not args:
        return False
    try:
        result = subprocess.run(["playerctl", "--player", instance, *args],
                                capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired) as error:
        warn(f"playerctl: {error}")
        return False
    return result.returncode == 0


def apply_media(player, body):
    """Do what the phone asked. Seek is microseconds, as MPRIS Seek takes
    them; SetPosition is milliseconds, as KDE Connect sends it. playerctl's
    position is seconds."""
    command = MEDIA_ACTIONS.get(body.get("action"))
    if command:
        media_command(player.instance, command)
    loop = body.get("setLoopStatus")
    if isinstance(loop, str) and loop in LOOP_VALUES:
        media_command(player.instance, "loop", loop)
    shuffle = body.get("setShuffle")
    if isinstance(shuffle, bool):
        media_command(player.instance, "shuffle", "On" if shuffle else "Off")
    volume = whole_number(body.get("setVolume"), 0, 100)
    if volume is not None:
        media_command(player.instance, "volume", f"{volume / 100:.2f}")
    seek = whole_number(body.get("Seek"), -MEDIA_DAY_MS * 1000, MEDIA_DAY_MS * 1000)
    if seek:
        arg = offset_arg(seek / 1_000_000)
        if arg:
            media_command(player.instance, "position", arg)
    position = whole_number(body.get("SetPosition"), 0, MEDIA_DAY_MS)
    if position is not None:
        media_command(player.instance, "position", f"{position / 1000:.3f}")


@dataclasses.dataclass
class PhonePlayer:
    """One of the phone's players, as its app describes it (ADR-018). The app
    names a player after its app (Spotify, YouTube)."""

    name: str
    title: str = ""
    artist: str = ""
    playing: bool = False
    volume: int = -1            # 0–100, or -1 before the phone says
    changed: int = 0            # the daemon's count at its last change: the newest wins


def phone_player_name(value):
    """A player's name from the phone, cleaned, or ""."""
    return clean_media_text(value)[:APP_NAME_LIMIT] if isinstance(value, str) else ""


def update_phone_player(player, body):
    """Fold one kdeconnect.mpris from the phone into player. The app sends
    every field each time; a missing one keeps its value."""
    if isinstance(body.get("title"), str):
        player.title = clean_media_text(body["title"])
    if isinstance(body.get("artist"), str):
        player.artist = clean_media_text(body["artist"])
    if isinstance(body.get("isPlaying"), bool):
        player.playing = body["isPlaying"]
    volume = whole_number(body.get("volume"), 0, 100)
    if volume is not None:
        player.volume = volume


def shown_player(players):
    """The player the popup shows: one that plays, the newest change first,
    else the newest that has a title. None while none has one."""
    known = [player for player in players if player.title or player.artist]
    return max(known, key=lambda player: (player.playing, player.changed), default=None)


def notification_text(body):
    """The title and the text, for the notification shown here."""
    title = body.get("title") if isinstance(body.get("title"), str) else ""
    text = body.get("text") if isinstance(body.get("text"), str) else ""
    title, text = " ".join(title.split()), " ".join(text.split())
    if title and text and title != text:
        shown = title + "\n" + text
    else:
        shown = title or text
        if not shown and isinstance(body.get("ticker"), str):
            shown = " ".join(body["ticker"].split())
    if len(shown) > NOTIFY_BODY:
        shown = shown[:NOTIFY_BODY - 1] + "…"
    return shown


def image_bytes(data):
    return data.startswith(IMAGE_PNG) or data.startswith(IMAGE_JPEG)


def payload_offer(data):
    """(size, port) of a file the packet offers, or None."""
    info = data.get("payloadTransferInfo")
    port = info.get("port") if isinstance(info, dict) else None
    size = data.get("payloadSize")
    if isinstance(size, bool) or not isinstance(size, int) or size < 0:
        return None
    if isinstance(port, bool) or not isinstance(port, int) or not 1 <= port <= 65535:
        return None
    return size, port


def icon_cache_path(digest):
    return os.path.join(home_dir("XDG_CACHE_HOME", ".cache"), "flickos", "phone", "icons", digest)


def prune_icons(keep=ICON_FILES):
    """Delete all but the newest `keep` cached icons. A hit refreshes an
    icon's time (icon_for), so the ones still in use stay."""
    folder = os.path.dirname(icon_cache_path("x"))
    try:
        entries = sorted(os.scandir(folder), key=lambda entry: entry.stat().st_mtime, reverse=True)
    except OSError:
        return
    for entry in entries[keep:]:
        with contextlib.suppress(OSError):
            os.unlink(entry.path)


def downloads_dir():
    try:
        result = subprocess.run(["xdg-user-dir", "DOWNLOAD"], capture_output=True, text=True, timeout=5)
        folder = result.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        folder = ""
    home = os.path.expanduser("~")
    if not folder or os.path.realpath(folder) == os.path.realpath(home):
        folder = os.path.join(home, "Downloads")
    return folder


def signal_panel():
    """Make waybar show the phone button's new state. waybar ignores real-time
    signals no module uses, so a panel without the button is unaffected."""
    try:
        subprocess.run(["pkill", f"-RTMIN+{PANEL_SIGNAL}", "-u", str(os.getuid()), "-x", "waybar"],
                       check=False, timeout=5, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass


def reload_panel():
    """The phone button is in the panel only while this is on: have
    flickos-layout generate the panel again (only inside the session)."""
    if not os.environ.get("WAYLAND_DISPLAY") or shutil.which("flickos-layout") is None:
        return
    try:
        subprocess.run(["flickos-layout", "reload-panel"], check=False, timeout=30,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass


def firewall_on():
    try:
        with open(UFW_CONF, encoding="utf-8") as f:
            return any(line.strip().lower() == "enabled=yes" for line in f)
    except OSError:
        return False


def active_networks():
    """UUIDs of the active Wi-Fi and wired NetworkManager connections, or None
    if NetworkManager can't be asked."""
    try:
        result = subprocess.run(["nmcli", "-t", "-f", "UUID,TYPE", "connection", "show", "--active"],
                                capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    return parse_active(result.stdout)


def parse_active(text):
    uuids = []
    for line in text.splitlines():
        uuid_, _, kind = line.partition(":")
        if kind in NETWORK_TYPES and uuid_:
            uuids.append(uuid_)
    return uuids


def network_names():
    try:
        result = subprocess.run(["nmcli", "-t", "-f", "UUID,NAME", "connection", "show"],
                                capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return {}
    names = {}
    for line in result.stdout.splitlines():
        uuid_, _, name = line.partition(":")
        names[uuid_] = name.replace("\\:", ":")
    return names


# --- Packets ------------------------------------------------------------------------

def packet(ptype, body, **extra):
    data = {"id": int(time.time() * 1000), "type": ptype, "body": body}
    data.update(extra)
    return (json.dumps(data, ensure_ascii=False) + "\n").encode()


class LineReader:
    def __init__(self, sock, limit):
        self.sock, self.limit, self.buffer = sock, limit, b""

    def packet(self):
        while b"\n" not in self.buffer:
            if len(self.buffer) > self.limit:
                raise ProtocolError(f"a line longer than {self.limit} bytes")
            data = self.sock.recv(65536)
            if not data:
                raise EOFError
            self.buffer += data
        line, _, self.buffer = self.buffer.partition(b"\n")
        if len(line) > self.limit:
            raise ProtocolError(f"a line longer than {self.limit} bytes")
        try:
            data = json.loads(line)
        except ValueError:
            raise ProtocolError("not JSON") from None
        if not isinstance(data, dict) or not isinstance(data.get("body", {}), dict):
            raise ProtocolError("not a packet")
        return data


def check_identity(data):
    """The body of an identity packet, or ProtocolError."""
    body = data.get("body", {})
    if data.get("type") != "kdeconnect.identity":
        raise ProtocolError(f"expected an identity, got {data.get('type')!r}")
    if not isinstance(body.get("deviceId"), str) or not DEVICE_ID.match(body["deviceId"]):
        raise ProtocolError("bad device id")
    if body.get("protocolVersion") != PROTOCOL_VERSION:
        raise ProtocolError(f"protocol version {body.get('protocolVersion')!r}, not {PROTOCOL_VERSION}")
    name = body.get("deviceName")
    body["deviceName"] = clean_name(name) if isinstance(name, str) and clean_name(name) else "Phone"
    return body


# --- What comes in -------------------------------------------------------------------

def clean_address(url):
    """Some apps share an address HTML-escaped (Facebook's browser: &amp;)."""
    return url.strip().replace("&amp;", "&")


def web_address(url):
    try:
        parts = urllib.parse.urlsplit(url)
    except ValueError:
        return False
    return parts.scheme in ("http", "https") and bool(parts.netloc)


def app_address(text):
    """(app's name, address) when a received text is exactly one address of
    a scheme a package registered in OPEN_SCHEMES; None for any other text."""
    address = text.strip()
    found = SCHEME_ADDRESS.fullmatch(address)
    if not found or len(address.encode()) > MAX_ARG_BYTES:
        return None
    scheme = found.group(1).lower()
    if scheme in NEVER_OPENED:
        return None
    try:
        with open(os.path.join(OPEN_SCHEMES, scheme), encoding="utf-8") as f:
            line = f.readline(APP_NAME_CHARS * 4)
    except (OSError, UnicodeDecodeError):
        return None
    name = " ".join("".join(c for c in line if c.isprintable()).split())[:APP_NAME_CHARS].strip()
    return (name, address) if name else None


def short_address(url, limit=60):
    """Host and path, for a notification: the rest is mostly tracking."""
    parts = urllib.parse.urlsplit(url)
    text = parts.netloc + parts.path
    text = text[4:] if text.startswith("www.") else text
    return text if len(text) <= limit else text[:limit - 1] + "…"


def clean_filename(name):
    """The last part of a name, without a leading dot, control characters or
    slashes, so a file lands in the folder and isn't hidden."""
    name = str(name).replace("\\", "/").rsplit("/", 1)[-1]
    name = "".join(ch for ch in name if ch.isprintable()).strip().lstrip(".").strip()
    while len(name.encode()) > 200:
        stem, ext = os.path.splitext(name)
        name = stem[:-1] + ext if len(stem) > 1 else name[:100]
    return name or "file"


def free_name(folder, name):
    """A path in folder for name that isn't taken: name, name (2), name (3)..."""
    stem, ext = os.path.splitext(name)
    path, n = os.path.join(folder, name), 2
    while os.path.lexists(path):
        path, n = os.path.join(folder, f"{stem} ({n}){ext}"), n + 1
    return path


def openable(path):
    kind = mimetypes.guess_type(path)[0] or ""
    return kind.startswith(OPENABLE) and not kind.startswith(("text/x-", "application/x-"))


# --- The daemon ---------------------------------------------------------------------

class Link:
    """A connected phone, after the handshake."""

    def __init__(self, tls, reader, device_id, name, der, address, paired):
        self.tls, self.reader, self.id, self.name = tls, reader, device_id, name
        self.der, self.address, self.paired = der, address, paired
        self.send_lock = threading.Lock()
        self.counted = not paired        # holds one of the MAX_UNPAIRED places
        self.battery = None             # (percent, charging) from kdeconnect.battery

    def send(self, ptype, body, **extra):
        with self.send_lock:
            self.tls.sendall(packet(ptype, body, **extra))

    def hang_up(self):
        """End the link from another thread: the reading thread's read ends,
        and that thread closes it. Never close it from here: OpenSSL in the
        reading thread goes on using the number, and once the number is
        reused (a pipe, a file) its alert lands in that."""
        with contextlib.suppress(OSError):
            self.tls.shutdown(socket.SHUT_RDWR)

    def close(self):
        """Only the thread that reads the link (handle_connection)."""
        self.hang_up()
        with self.send_lock, contextlib.suppress(OSError):
            self.tls.close()


class PairSession:
    """`flickos-phone pair`: phones may ask to pair until it ends."""

    def __init__(self):
        self.requests = queue.Queue()
        self.deadline = time.monotonic() + PAIR_SECONDS


class Transfer:
    """A file going to a phone ("out") or coming from one ("in"). `watch`
    lines `transfer` show it in the Phone window; `cancel ID` stops it."""

    def __init__(self, direction, name, device, size):
        self.id = uuid.uuid4().hex[:12]
        self.direction, self.name, self.device, self.size = direction, name, device, size
        self.done = 0
        self.state = "waiting"          # waiting (for the phone to fetch it), moving, then done/failed/cancelled
        self.cancelled = False
        self.sock = None                # shut down to cancel: wakes accept(), recv() and sendall()
        self.reported = 0.0             # monotonic time of the last watch line

    def details(self):
        return {"id": self.id, "direction": self.direction, "name": self.name, "device": self.device,
                "done": self.done, "size": self.size, "state": self.state}

    def use(self, sock):
        """The socket bytes move on now: the listening one, then the TLS one
        (wrap_socket detaches the plain socket it was given, which then
        can't be shut down). Shut at once when already cancelled."""
        self.sock = sock
        if self.cancelled:
            self.shut()

    def shut(self):
        sock = self.sock
        if sock is not None:
            with contextlib.suppress(OSError):
                # The descriptor itself: SSLSocket.shutdown would also drop
                # the TLS state under the thread that is reading or writing.
                socket.socket.shutdown(sock, socket.SHUT_RDWR)


class Daemon:
    def __init__(self, identity, settings, bind="", tcp_port=TCP_PORT, payload_ports=PAYLOAD_PORTS,
                 udp=True, networks=active_networks):
        self.identity, self.settings = identity, settings
        self.bind, self.tcp_port, self.payload_ports = bind, tcp_port, payload_ports
        self.use_udp, self.networks = udp, networks
        self.lock = threading.RLock()
        self.links = {}
        self.unpaired = 0
        self.pairing = None
        self.tcp = self.udp = None
        self.allowed = False            # on a network in settings.networks
        self.next_announce = 0.0
        self.recheck_at = None
        self.failed = False
        self.stopping = threading.Event()
        self.selector = selectors.DefaultSelector()
        self.wake_r, self.wake_w = socket.socketpair()
        self.last_answer = {}
        self.sent_texts = {}            # device id -> [(monotonic time, text)], for echoes
        self.phone_notes = {}           # (device id, phone notification id) -> desktop id
        self.hinted = set()             # apps we've already pointed at Phone settings
        self.calls = {}                 # device id -> "ringing" or "talking"
        self.callers = {}               # device id -> who is calling, while ringing
        self.call_notes = {}            # device id -> the ringing notification's id
        self.paused_players = set()     # players this call paused, to play again
        self.sftp_waits = {}            # device id -> the Browse Phone that is waiting for the answer
        self.media = {}                 # player name -> Player, the last read
        self.media_sent = {}            # player name -> Player, the last one told to a phone
        self.media_names = None         # the list last sent, or None before the first
        self.media_at = 0.0             # when media was last read
        self.media_follower = None      # playerctl --follow, while media_waiting()
        self.media_follow_ended = False # it failed or exited: not again until the phone reconnects
        self.phone_media = {}           # device id -> {name: PhonePlayer}, what the phone plays
        self.phone_media_count = 0      # PhonePlayer.changed
        self.playing_lock = threading.Lock()  # one `playing` line at a time, in order
        self.playing_told = None        # the last `playing` told to watchers
        self.watchers = []              # control connections reading `watch` (at most MAX_WATCHERS)
        self.transfers = {}             # id -> Transfer, while a file goes to or comes from a phone

    # -- identity packets
    def name(self):
        return device_name(self.settings)

    def full_identity(self):
        incoming, outgoing = capabilities(self.settings)
        return {"deviceId": self.identity.id, "deviceName": self.name(), "deviceType": device_type(),
                "protocolVersion": PROTOCOL_VERSION, "incomingCapabilities": incoming,
                "outgoingCapabilities": outgoing}

    def discovery(self):
        return packet("kdeconnect.identity", {
            "deviceId": self.identity.id, "deviceName": self.name(), "deviceType": device_type(),
            "protocolVersion": PROTOCOL_VERSION, "tcpPort": self.tcp.getsockname()[1]})

    # -- main loop
    def wake(self):
        with contextlib.suppress(OSError):
            self.wake_w.send(b"x")

    def recheck(self):
        """From another thread: have the main loop look at the network again
        (only the main loop opens and closes the listening sockets)."""
        self.recheck_at = time.monotonic()
        self.wake()

    def run(self, control=None, session_socket=None, monitor=None):
        """Until SIGTERM, `stop`, or the compositor going away."""
        self.selector.register(self.wake_r, selectors.EVENT_READ, "wake")
        if control is not None:
            self.selector.register(control, selectors.EVENT_READ, "control")
        if session_socket is not None:
            self.selector.register(session_socket, selectors.EVENT_READ, "session")
        if monitor is not None:
            self.selector.register(monitor.stdout, selectors.EVENT_READ, "monitor")
        self.check_network()
        try:
            while not self.stopping.is_set():
                for key, _ in self.selector.select(self.timeout()):
                    self.handle_event(key)
                self.timers()
        finally:
            self.close_all()
        return 1 if self.failed else 0

    def handle_event(self, key):
        kind = key.data
        if kind == "wake":
            with contextlib.suppress(OSError):
                self.wake_r.recv(4096)
            self.update_listening()
        elif kind == "control":
            conn, _ = key.fileobj.accept()
            threading.Thread(target=self.serve_control, args=(conn,), daemon=True).start()
        elif kind == "session":
            with contextlib.suppress(OSError):
                if key.fileobj.recv(4096):
                    return
            self.stopping.set()
        elif kind == "monitor":
            if not key.fileobj.readline():
                self.selector.unregister(key.fileobj)
            # NetworkManager says a lot at once: look again a moment later.
            self.recheck_at = time.monotonic() + 1
        elif kind == "tcp":
            try:
                sock, address = key.fileobj.accept()
            except OSError:
                return
            threading.Thread(target=self.handle_connection, args=(sock, address), daemon=True).start()
        elif kind == "udp":
            self.handle_broadcast()
        elif kind == "media":
            try:
                changed = os.read(key.fileobj.fileno(), 65536)  # all lines at once: one read
            except OSError:
                changed = b""
            if not changed:
                self.stop_media_follower()
                self.media_follow_ended = True
                return
            self.poll_media()

    def timeout(self):
        deadlines = []
        if self.recheck_at is not None:
            deadlines.append(self.recheck_at)
        if self.tcp is not None and not self.links:
            deadlines.append(self.next_announce)
        if not deadlines:
            return None
        return max(0.0, min(deadlines) - time.monotonic())

    def timers(self):
        now = time.monotonic()
        if self.recheck_at is not None and now >= self.recheck_at:
            self.recheck_at = None
            self.check_network()
        if self.tcp is not None and not self.links and now >= self.next_announce:
            self.announce()
        self.update_media_follower()

    # -- where it listens
    def check_network(self):
        active = self.networks()
        with self.lock:
            was = self.allowed
            self.allowed = bool(active) and any(uuid_ in self.settings.networks for uuid_ in active)
        self.update_listening(changed=was != self.allowed)

    def update_listening(self, changed=False):
        with self.lock:
            want = self.allowed or self.pairing is not None
        if want and self.tcp is None:
            self.open_sockets()
            self.announce()
        elif not want and self.tcp is not None:
            self.close_sockets()
        elif want and changed:
            self.announce()

    def open_sockets(self):
        tcp = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        tcp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            tcp.bind((self.bind, self.tcp_port))
        except OSError as error:
            tcp.close()
            warn(f"can't listen on TCP {self.tcp_port}: {error} (KDE Connect or GSConnect running?)")
            self.failed = True
            self.stopping.set()
            return
        tcp.listen(8)
        self.tcp = tcp
        self.selector.register(tcp, selectors.EVENT_READ, "tcp")
        if self.use_udp:
            udp = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            udp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            udp.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
            try:
                udp.bind((self.bind, UDP_PORT))
            except OSError as error:
                warn(f"can't listen on UDP {UDP_PORT}: {error}")
                udp.close()
            else:
                self.udp = udp
                self.selector.register(udp, selectors.EVENT_READ, "udp")

    def close_sockets(self):
        for sock in (self.tcp, self.udp):
            if sock is not None:
                with contextlib.suppress(KeyError, ValueError):
                    self.selector.unregister(sock)
                sock.close()
        self.tcp = self.udp = None
        with self.lock:
            links = list(self.links.values())
        for link in links:
            link.hang_up()              # its thread closes it

    def close_all(self):
        self.stop_media_follower()
        self.close_watchers()
        self.close_sockets()
        self.stopping.set()
        self.selector.close()
        self.wake_r.close()
        self.wake_w.close()

    def announce(self):
        """Broadcast who we are. Every phone that hears it opens a connection,
        even one already connected, so this happens only while none is."""
        self.next_announce = time.monotonic() + ANNOUNCE_SECONDS
        if self.udp is None:
            return
        with contextlib.suppress(OSError):
            self.udp.sendto(self.discovery(), ("255.255.255.255", UDP_PORT))

    def handle_broadcast(self):
        """A phone announced itself: answer straight back so that it connects
        to us (we stay the TLS client, ADR-003)."""
        try:
            data, (address, _) = self.udp.recvfrom(MAX_IDENTITY)
            body = check_identity(json.loads(data))
        except (OSError, ValueError, ProtocolError, AttributeError):
            return
        if not self.answers_broadcast(body["deviceId"]):
            return
        now = time.monotonic()
        if now - self.last_answer.get(address, 0) < 2:
            return
        self.last_answer[address] = now
        with contextlib.suppress(OSError):
            self.udp.sendto(self.discovery(), (address, UDP_PORT))

    def answers_broadcast(self, device_id):
        """A phone broadcasts when it joins a network or its app starts, so
        it has no link to us even if we still hold one (it left without a
        word): answer, and its new connection replaces ours. Not while an
        unpaired link may be pairing, since a new one would lose the request."""
        if device_id == self.identity.id:
            return False
        with self.lock:
            link = self.links.get(device_id)
        return link is None or link.paired

    # -- a phone's connection (one thread each)
    def handle_connection(self, sock, address):
        with self.lock:
            if self.unpaired >= MAX_UNPAIRED:
                sock.close()
                return
            self.unpaired += 1
        link = None
        try:
            link = self.handshake(sock, address[0])
            self.serve_link(link)
        except (OSError, EOFError, ProtocolError, ssl.SSLError, ValueError):
            pass
        finally:
            with self.lock:
                if link is None or link.counted:
                    self.unpaired -= 1
                # A new connection replaces this one before the old thread gets
                # here. That one already said the phone is connected; this one
                # must not then say it went away.
                current = link is not None and self.links.get(link.id) is link
                if current:
                    del self.links[link.id]
            if link is not None:
                self.end_call(link.id)  # a phone that went away is no longer in a call
                link.close()
                if link.paired and current:
                    signal_panel()
                    self.watch_disconnected(link.id)
                if current:
                    self.drop_phone_media(link.id)
            with contextlib.suppress(OSError):
                sock.close()
            self.wake()

    def handshake(self, sock, address):
        if sock.family in (socket.AF_INET, socket.AF_INET6):
            keep_alive(sock)
        sock.settimeout(HELLO_SECONDS)
        reader = LineReader(sock, MAX_IDENTITY)
        hello = check_identity(reader.packet())
        if hello.get("targetDeviceId") not in (None, self.identity.id):
            raise ProtocolError("for another device")
        if reader.buffer:
            raise ProtocolError("data before TLS")
        # From here the TLS socket owns the connection: close it on failure.
        tls = client_context(self.identity).wrap_socket(sock, server_side=False)
        try:
            der = tls.getpeercert(binary_form=True)
            if not der or cert_fields(der)[0] != hello["deviceId"]:
                raise ProtocolError("the certificate isn't this device's")
            tls.sendall(packet("kdeconnect.identity", self.full_identity()))
            reader = LineReader(tls, MAX_IDENTITY)
            body = check_identity(reader.packet())
            if body["deviceId"] != hello["deviceId"]:
                raise ProtocolError("the device id changed")
        except BaseException:
            tls.close()
            raise
        paired = paired_der(body["deviceId"]) == der
        link = Link(tls, reader, body["deviceId"], body["deviceName"], der, address, paired)
        if paired:
            reader.limit = MAX_PACKET
            rename_device(link.id, link.name)
        with self.lock:
            if paired:
                self.unpaired -= 1
            old = self.links.get(link.id)
            self.links[link.id] = link
        if old is not None:
            old.hang_up()               # its thread closes it
        tls.settimeout(None)
        self.wake()
        if paired:
            signal_panel()
            self.watch_connected(link)
            self.sync_notifications(link)
            self.sync_media(link)
            self.sync_commands(link)
            self.sync_phone_media(link)
        return link

    def serve_link(self, link):
        while not self.stopping.is_set():
            data = link.reader.packet()
            ptype, body = data.get("type"), data.get("body", {})
            if ptype == "kdeconnect.pair":
                self.on_pair(link, body)
            elif not link.paired:
                continue        # nothing but pairing before pairing
            elif ptype == "kdeconnect.share.request":
                self.on_share(link, data)
            elif ptype == "kdeconnect.clipboard" and isinstance(body.get("content"), str):
                if self.is_echo(link.id, body["content"]):
                    continue
                copy_text(body["content"])
                self.note_received("clipboard", link.name, body["content"])
                notify(f"Clipboard from {link.name}", body["content"][:200])
            elif ptype == "kdeconnect.ping":
                notify(f"Ping from {link.name}", body.get("message", "") if isinstance(body.get("message"), str) else "")
            elif ptype == "kdeconnect.battery":
                self.on_battery(link, body)
            elif ptype == NOTIFICATION_IN:
                self.on_notification(link, data)
            elif ptype == CALL_IN and isinstance(body, dict):
                self.on_telephony(link, body)
            elif ptype == SFTP_IN and isinstance(body, dict):
                self.on_sftp(link, body)
            elif ptype == MEDIA_IN and isinstance(body, dict):
                self.on_media(link, body)
            elif ptype == PHONE_MEDIA_IN:
                self.on_phone_media(link, data)
            elif ptype == COMMAND_IN and isinstance(body, dict):
                self.on_runcommand(link, body)

    def remember_sent(self, device_id, text):
        now = time.monotonic()
        with self.lock:
            recent = [(when, old) for when, old in self.sent_texts.get(device_id, [])
                      if now - when < ECHO_SECONDS and old != text]
            self.sent_texts[device_id] = (recent + [(now, text)])[-5:]

    def is_echo(self, device_id, text):
        """The phone's clipboard sending back what this computer just sent it."""
        now = time.monotonic()
        with self.lock:
            return any(now - when < ECHO_SECONDS and old.strip() == text.strip()
                       for when, old in self.sent_texts.get(device_id, []))

    def on_battery(self, link, body):
        charge = body.get("currentCharge")
        if not isinstance(charge, int) or isinstance(charge, bool) or not 0 <= charge <= 100:
            return
        battery = (charge, body.get("isCharging") is True)
        if battery != link.battery:
            link.battery = battery
            signal_panel()
            self.notify_watchers({"event": "battery", "id": link.id, "battery": list(battery)})

    # -- the phone's notifications
    def sync_notifications(self, link):
        """Ask for the notifications the phone is showing. For the next few
        seconds a silent one is that list, not an update to hide."""
        if not self.settings.notifications or not link.paired:
            return
        link.sync_until = time.monotonic() + SYNC_SECONDS
        with contextlib.suppress(OSError):
            link.send(NOTIFICATION_OUT, {"request": True})

    def syncing(self, link):
        return time.monotonic() < getattr(link, "sync_until", 0)

    def drop_paired_links(self):
        with self.lock:
            links = [link for link in self.links.values() if link.paired]
        for link in links:
            link.hang_up()

    def close_phone_notes(self):
        with self.lock:
            ids = list(self.phone_notes.values())
            self.phone_notes.clear()
        for desktop in ids:
            close_notification(desktop)

    def on_notification(self, link, data):
        if not self.settings.notifications:
            return
        body = data.get("body", {})
        nid = body.get("id")
        if not isinstance(nid, str) or not nid.strip() or len(nid) > 300:
            return
        nid = nid.strip()
        if body.get("isCancel") is True:
            self.dismiss_local(link, nid)
            return
        app = clean_app_name(body.get("appName")) or "App"
        remember_app(app)
        if screen_locked():
            self.discard_payload(link, data)
            return
        allowed = app in self.settings.notification_apps
        silent = body.get("silent") is True
        key = (link.id, nid)
        with self.lock:
            shown = key in self.phone_notes
        if not allowed:
            self.discard_payload(link, data)
            if not silent and app not in self.hinted:
                self.hinted.add(app)
                notify(app, HINT_BODY, "Phone Settings",
                       lambda: spawn(["flickos-control", "--page", "phone"]))
            return
        if silent and not shown and not self.syncing(link):
            self.discard_payload(link, data)
            return
        text = notification_text(body)
        icon = self.icon_for(link, data)
        clearable = body.get("isClearable") is not False
        self.show_phone_note(link, nid, app, text, icon, clearable)

    def discard_payload(self, link, data):
        """Take a file the phone is waiting to send and throw it away, so its
        notification plugin isn't stuck until the offer times out."""
        if payload_offer(data) is None:
            return
        threading.Thread(target=self.take_payload, args=(link, data, ICON_BYTES), daemon=True).start()

    def show_phone_note(self, link, nid, app, text, icon, clearable):
        key = (link.id, nid)
        with self.lock:
            replace = self.phone_notes.get(key)

        def dismissed(k=key, clear=clearable, device=link.id, note=nid):
            with self.lock:
                if self.phone_notes.get(k) == holder.get("id"):
                    self.phone_notes.pop(k, None)
            if clear:
                self.cancel_on_phone(device, note)

        holder = {}
        desktop = post_notification(app, text or app, icon, replace, dismissed)
        holder["id"] = desktop
        if not desktop:
            return
        with self.lock:
            self.phone_notes.pop(key, None)         # to the end: the newest
            self.phone_notes[key] = desktop
            oldest = [self.phone_notes.pop(k) for k in list(self.phone_notes)[:-MAX_PHONE_NOTES]]
        for old in oldest:
            close_notification(old)                 # ours closing it, not a dismiss

    def dismiss_local(self, link, nid):
        with self.lock:
            desktop = self.phone_notes.pop((link.id, nid), None)
        if desktop:
            close_notification(desktop)

    def cancel_on_phone(self, device_id, nid):
        with self.lock:
            link = self.links.get(device_id)
        if link is None or not link.paired:
            return
        with contextlib.suppress(OSError):
            link.send(NOTIFICATION_OUT, {"cancel": nid})

    def icon_for(self, link, data):
        """The notification's icon, cached by its real MD5. None when there
        isn't one, or it isn't a picture. A hash we already have is used, and
        the phone's offer is still accepted so it isn't left waiting."""
        claimed = data.get("body", {}).get("payloadHash")
        digest = claimed.lower() if isinstance(claimed, str) and re.fullmatch(r"[0-9a-fA-F]{32}", claimed) else ""
        cached = icon_cache_path(digest) if digest else ""
        if cached and os.path.isfile(cached):
            with contextlib.suppress(OSError):
                os.utime(cached)
            self.discard_payload(link, data)
            return cached
        if payload_offer(data) is None:
            return None
        blob = self.take_payload(link, data, ICON_BYTES)
        if not blob or not image_bytes(blob):
            return None
        real = hashlib.md5(blob).hexdigest()
        path = icon_cache_path(real)
        if not os.path.isfile(path):
            write_bytes(path, blob)
            prune_icons()
        return path

    def take_payload(self, link, data, limit):
        """The bytes of a file the phone is offering on a port. None when it
        isn't, it's too big, or the connection isn't this phone's."""
        offer = payload_offer(data)
        if offer is None:
            return None
        size, port = offer
        if size > limit:
            return None
        try:
            with socket.create_connection((link.address, port), timeout=ICON_SECONDS) as raw:
                raw.settimeout(ICON_SECONDS)
                with client_context(self.identity).wrap_socket(raw, server_side=False) as tls:
                    if tls.getpeercert(binary_form=True) != link.der:
                        raise ProtocolError("another certificate on the icon connection")
                    got = b""
                    while len(got) < size:
                        chunk = tls.recv(min(65536, size - len(got)))
                        if not chunk:
                            break
                        got += chunk
        except (OSError, ProtocolError, ssl.SSLError) as error:
            warn(f"an icon from {link.name}: {error}")
            return None
        return got if len(got) == size else None

    # -- calls
    def on_telephony(self, link, body):
        """A call on the phone. Ringing shows who is calling, and Mute silences
        the ringer. What is playing pauses until the call ends."""
        if not self.settings.calls:
            return
        event = body.get("event")
        if event not in CALL_EVENTS:
            return
        if event == "missedCall" or packet_flag(body.get("isCancel")):
            self.end_call(link.id)
            return
        caller = caller_text(body) if event == "ringing" else ""
        with self.lock:
            self.calls[link.id] = event
            if event == "ringing":
                self.callers[link.id] = caller
            else:
                self.callers.pop(link.id, None)
        self.pause_for_call()
        self.notify_watchers({"event": "call", "id": link.id, "state": event, "caller": caller})
        if event == "ringing":
            self.show_call(link, body)
        else:
            # Answered, or a call this computer made: the ringer has stopped.
            self.close_call_note(link.id)

    def show_call(self, link, body):
        """The ringing notification. Not while the screen is locked: the
        caller's name stays off it. Pausing what is playing still happens."""
        if screen_locked():
            return
        text = caller_text(body)
        with self.lock:
            replace = self.call_notes.get(link.id)

        def mute(device=link.id):
            self.mute_ringer(device)

        nid = post_notification("Incoming call", text, replace=replace, action="Mute", on_action=mute)
        if not nid:
            return
        with self.lock:
            if self.calls.get(link.id) == "ringing":
                self.call_notes[link.id] = nid
            else:
                close_notification(nid)

    def close_call_note(self, device_id):
        with self.lock:
            note = self.call_notes.pop(device_id, None)
        if note:
            close_notification(note)

    def mute_ringer(self, device_id):
        with self.lock:
            target = self.links.get(device_id)
        if target is None or not target.paired:
            return
        with contextlib.suppress(OSError):
            target.send(CALL_OUT, {})

    def pause_for_call(self):
        """Pause players that are playing. One the user had already paused is
        left alone, and only these are played again when the call ends."""
        for name in playing_players():
            with self.lock:
                if not self.calls or name in self.paused_players:
                    continue
            if not control_player(name, "pause"):
                continue
            with self.lock:
                if self.calls:
                    self.paused_players.add(name)
                    undo = False
                else:
                    undo = True
            if undo:
                control_player(name, "play")

    def end_call(self, device_id):
        """This phone's call is over. Play again only when no call is left."""
        with self.lock:
            ended = device_id in self.calls or device_id in self.callers
            self.calls.pop(device_id, None)
            self.callers.pop(device_id, None)
            note = self.call_notes.pop(device_id, None)
            if self.calls:
                players = ()
            else:
                players = tuple(self.paused_players)
                self.paused_players.clear()
        if ended:
            self.notify_watchers({"event": "call", "id": device_id, "state": "ended", "caller": ""})
        if note:
            close_notification(note)
        for name in players:
            control_player(name, "play")

    def end_all_calls(self):
        with self.lock:
            ids = list(self.calls)
        for device_id in ids:
            self.end_call(device_id)

    # -- pairing
    def on_pair(self, link, body):
        if body.get("pair") is True:
            if link.paired:
                # The phone forgot us and asks again: the old pairing is gone.
                self.unpair(link)
            timestamp = body.get("timestamp")
            with self.lock:
                session = self.pairing
            if (session is None or not isinstance(timestamp, int)
                    or abs(timestamp - time.time()) > PAIR_CLOCK_SECONDS):
                link.send("kdeconnect.pair", {"pair": False})
                return
            session.requests.put((link, timestamp))
        elif body.get("pair") is False and link.paired:
            self.unpair(link)

    def unpair(self, link):
        forget_device(link.id)
        with self.lock:
            link.paired = False
            link.reader.limit = MAX_IDENTITY
            if not link.counted:
                link.counted = True
                self.unpaired += 1
        signal_panel()
        self.notify_watchers({"event": "forgotten", "id": link.id})
        self.drop_phone_media(link.id)

    def accept_pairing(self, link):
        link.send("kdeconnect.pair", {"pair": True})
        trust_device(link.id, link.name, link.der)
        with self.lock:
            link.paired = True
            link.reader.limit = MAX_PACKET
            if link.counted:
                link.counted = False
                self.unpaired -= 1
        # From now on it listens on this network without `pair`.
        active = self.networks() or []
        added = tuple(dict.fromkeys(self.settings.networks + tuple(active)))
        if added != self.settings.networks:
            self.settings = save_settings(networks=added)
        self.recheck()
        signal_panel()
        self.watch_connected(link)
        self.sync_notifications(link)
        self.sync_media(link)
        self.sync_commands(link)
        self.sync_phone_media(link)

    def pair_session(self, conn):
        with self.lock:
            if self.pairing is not None:
                reply(conn, {"error": "another pairing is waiting"})
                return
            session = self.pairing = PairSession()
        self.wake()
        try:
            reply(conn, {"event": "waiting", "name": self.name(), "firewall": firewall_on()})
            while True:
                remaining = session.deadline - time.monotonic()
                if remaining <= 0:
                    reply(conn, {"event": "timeout"})
                    return
                try:
                    link, timestamp = session.requests.get(timeout=min(remaining, 1))
                except queue.Empty:
                    if gone(conn):
                        return          # `pair` was cancelled: close the window now
                    continue
                key = verification_key(self.identity.der, link.der, timestamp)
                reply(conn, {"event": "request", "id": link.id, "name": link.name, "key": key})
                answer = read_json(conn, PAIR_ANSWER_SECONDS)
                if answer.get("answer") == "yes":
                    try:
                        self.accept_pairing(link)
                    except OSError:
                        reply(conn, {"event": "failed"})
                        return
                    reply(conn, {"event": "paired", "id": link.id, "name": link.name})
                else:
                    with contextlib.suppress(OSError):
                        link.send("kdeconnect.pair", {"pair": False})
                    reply(conn, {"event": "refused"})
                return
        finally:
            with self.lock:
                self.pairing = None
            self.wake()

    # -- what the Phone window watches
    def watch_connected(self, link):
        self.notify_watchers({"event": "connected", "phone": {
            "id": link.id, "name": link.name, "address": link.address,
            "battery": list(link.battery) if link.battery else None}})

    def watch_disconnected(self, device_id):
        self.notify_watchers({"event": "disconnected", "id": device_id})

    def note_received(self, kind, device, value):
        """Remember one thing from a phone, and tell windows that are watching."""
        add_received(kind, device, value)
        item = next((i for i in reversed(read_received())
                     if i.get("kind") == kind and i.get("value") == value and i.get("device") == device), None)
        if item:
            self.notify_watchers({"event": "received", "item": received_details(item)})

    def notify_watchers(self, event):
        line = (json.dumps(event, ensure_ascii=False) + "\n").encode()
        with self.lock:
            watchers = list(self.watchers)
        dead = []
        for conn in watchers:
            try:
                conn.sendall(line)
            except OSError:
                dead.append(conn)
        if dead:
            with self.lock:
                for conn in dead:
                    if conn in self.watchers:
                        self.watchers.remove(conn)

    def close_watchers(self):
        with self.lock:
            watchers, self.watchers = self.watchers, []
        for conn in watchers:
            with contextlib.suppress(OSError):
                conn.close()

    # -- files on the way
    def start_transfer(self, direction, name, device, size):
        transfer = Transfer(direction, name, device, size)
        with self.lock:
            self.transfers[transfer.id] = transfer
        self.report_transfer(transfer)
        return transfer

    def transfer_moved(self, transfer, count):
        """Bytes moved. A watch line only every TRANSFER_EVENT_SECONDS: no
        timer, so nothing is written while a transfer stalls (PERF-5)."""
        transfer.done += count
        transfer.state = "moving"
        if time.monotonic() - transfer.reported >= TRANSFER_EVENT_SECONDS:
            self.report_transfer(transfer)

    def end_transfer(self, transfer, state):
        with self.lock:
            self.transfers.pop(transfer.id, None)
        transfer.sock = None
        transfer.state = "cancelled" if transfer.cancelled else state
        self.report_transfer(transfer)

    def report_transfer(self, transfer):
        transfer.reported = time.monotonic()
        self.notify_watchers({"event": "transfer", **transfer.details()})

    def cancel_transfer(self, transfer_id):
        with self.lock:
            transfer = self.transfers.get(transfer_id)
        if transfer is None:
            raise PhoneError("that transfer has already ended")
        transfer.cancelled = True
        transfer.shut()
        return transfer.name

    def watch(self, conn):
        """Keep conn open and write one JSON line per change. The window
        updates from this instead of asking again (PERF-5)."""
        with self.lock:
            if len(self.watchers) >= MAX_WATCHERS:
                reply(conn, {"error": "too many windows are watching the phone"})
                return
            self.watchers.append(conn)
        try:
            conn.settimeout(None)       # read_json left a 10 s timeout on this socket
            while not self.stopping.is_set():
                # No timeout: close_watchers() closes conn when the daemon
                # stops, and that wakes this. A timer would be a wakeup a
                # second while nothing happens (PERF-5).
                try:
                    readable, _, _ = select.select([conn], [], [])
                except (OSError, ValueError):
                    break
                if not readable:
                    continue
                try:
                    if conn.recv(1, socket.MSG_PEEK) == b"":
                        break
                    conn.recv(65536)        # a client doesn't send; don't let it fill the buffer
                except OSError:
                    break
        finally:
            with self.lock:
                if conn in self.watchers:
                    self.watchers.remove(conn)

    # -- things the phone sends
    def on_share(self, link, data):
        body = data.get("body", {})
        if isinstance(body.get("url"), str):
            url = clean_address(body["url"])
            if web_address(url):
                self.note_received("page", link.name, url)
                notify(f"Page from {link.name}", short_address(url), "Open", lambda: spawn(["xdg-open", url]))
                return
            body = {"text": url}
        if isinstance(body.get("text"), str):
            text = body["text"]
            self.note_received("text", link.name, text)
            app = app_address(text)
            if app:
                name, address = app
                notify(f"For {name} from {link.name}", f"Click to open it in {name}.", "Open",
                       lambda: spawn(["xdg-open", address]))
            else:
                notify(f"Text from {link.name}", text[:200], "Copy", lambda: copy_text(text))
        elif isinstance(body.get("filename"), str):
            threading.Thread(target=self.receive_file, args=(link, data), daemon=True).start()

    def receive_file(self, link, data):
        name = clean_filename(data["body"]["filename"])
        size, port = data.get("payloadSize"), data.get("payloadTransferInfo", {}).get("port")
        if not isinstance(size, int) or size < 0 or not isinstance(port, int) or not 1 <= port <= 65535:
            return
        folder = downloads_dir()
        transfer = None
        try:
            os.makedirs(folder, exist_ok=True)
            if shutil.disk_usage(folder).free - size < FREE_MARGIN:
                notify(f"{name} from {link.name} wasn't saved", "There isn't enough free space.")
                return
            part = os.path.join(folder, f".{name}.{uuid.uuid4().hex[:8]}.part")
            transfer = self.start_transfer("in", name, link.name, size)
            with socket.create_connection((link.address, port), timeout=TRANSFER_SECONDS) as raw:
                with client_context(self.identity).wrap_socket(raw, server_side=False) as tls:
                    transfer.use(tls)
                    if tls.getpeercert(binary_form=True) != link.der:
                        raise ProtocolError("another certificate on the file connection")
                    got = 0
                    with open(part, "xb") as f:
                        while got < size and not transfer.cancelled:
                            chunk = tls.recv(min(65536, size - got))
                            if not chunk:
                                break
                            f.write(chunk)
                            got += len(chunk)
                            self.transfer_moved(transfer, len(chunk))
            if got != size:
                raise ProtocolError(f"{got} of {size} bytes")
            path = free_name(folder, name)
            os.link(part, path)             # fails instead of overwriting
            os.unlink(part)
        except (OSError, ProtocolError, ssl.SSLError) as error:
            with contextlib.suppress(OSError, UnboundLocalError):
                os.unlink(part)
            if transfer is not None:
                self.end_transfer(transfer, "failed")
            if transfer is None or not transfer.cancelled:      # a Cancel in the window needs no notification
                warn(f"receiving {name} from {link.name}: {error}")
                notify(f"{name} from {link.name} wasn't saved", "The transfer broke off.")
            return
        self.note_received("file", link.name, path)
        self.end_transfer(transfer, "done")
        if openable(path):
            notify(f"{os.path.basename(path)} from {link.name}", "Saved in Downloads.", "Open",
                   lambda: spawn(["xdg-open", path]))
        else:
            notify(f"{os.path.basename(path)} from {link.name}", "Saved in Downloads.", "Show in Folder",
                   lambda: spawn(["xdg-open", folder]))

    # -- things we send
    def pick_link(self, device_id):
        with self.lock:
            paired = [link for link in self.links.values() if link.paired]
        if device_id:
            for link in paired:
                if link.id == device_id:
                    return link
            raise PhoneError("that phone isn't connected")
        if not paired:
            raise PhoneError("no phone is connected")
        if len(paired) > 1:
            raise PhoneError("more than one phone is connected; choose one with --to")
        return paired[0]

    def send_items(self, device_id, items, cancelled=None):
        """Send items to the phone and return its name. A file cancelled with
        `cancel` is left out and its name added to cancelled; the rest go."""
        link = self.pick_link(device_id)
        for item in items:
            kind, value = item.get("kind"), item.get("value")
            if kind in ("url", "text", "clipboard"):
                self.remember_sent(link.id, value)
            if kind == "url":
                link.send("kdeconnect.share.request", {"url": value})
            elif kind == "text":
                link.send("kdeconnect.share.request", {"text": value})
            elif kind == "clipboard":
                link.send("kdeconnect.clipboard", {"content": value})
            elif kind == "file":
                try:
                    size = os.path.getsize(value)
                except OSError as error:
                    raise PhoneError(f"{os.path.basename(value)}: {error}") from None
                transfer = self.start_transfer("out", os.path.basename(value), link.name, size)
                error = self.send_file(link, value, transfer)
                for _ in range(SEND_TRIES - 1):
                    if not error or transfer.cancelled:
                        break
                    warn(f"sending {value}: {error}; trying again")
                    transfer.done, transfer.state = 0, "waiting"
                    self.report_transfer(transfer)
                    error = self.send_file(link, value, transfer)
                self.end_transfer(transfer, "failed" if error else "done")
                if transfer.cancelled:
                    if cancelled is not None:
                        cancelled.append(transfer.name)
                elif error:
                    raise PhoneError(f"{os.path.basename(value)}: {error}")
        return link.name

    def send_file(self, link, path, transfer=None):
        """Offer a file on a payload port until the phone fetches it. None, or
        what went wrong."""
        try:
            size = os.path.getsize(path)
            stat = os.stat(path)
        except OSError as error:
            return str(error)
        return self.offer_payload(link, path, "kdeconnect.share.request",
                                  {"filename": os.path.basename(path), "creationTime": int(stat.st_mtime * 1000),
                                   "lastModified": int(stat.st_mtime * 1000), "open": False,
                                   "numberOfFiles": 1, "totalPayloadSize": size}, size, transfer)

    def offer_payload(self, link, path, ptype, body, size=None, transfer=None):
        """Offer a file on a payload port until the phone fetches it. None, or
        what went wrong. The phone is the TLS client there, and only its
        pinned certificate is accepted. transfer: shown in the window and
        stopped by `cancel` (a file the user sends, not a cover or icon)."""
        try:
            if size is None:
                size = os.path.getsize(path)
            source = open(path, "rb")
        except OSError as error:
            return str(error)
        with source:
            server = None
            for port in self.payload_ports:
                candidate = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                try:
                    candidate.bind((self.bind, port))
                except OSError:
                    candidate.close()
                    continue
                server = candidate
                break
            if server is None:
                return "no free port to offer it on"
            with server:
                server.listen(1)
                server.settimeout(OFFER_SECONDS)
                if transfer is not None:
                    transfer.use(server)
                try:
                    link.send(ptype, body, payloadSize=size,
                              payloadTransferInfo={"port": server.getsockname()[1]})
                except OSError as error:
                    return str(error)
                try:
                    conn, _ = server.accept()
                except TimeoutError:
                    return "the phone didn't fetch it (is the firewall blocking ports 1739-1764?)"
                except OSError as error:
                    return "cancelled" if transfer is not None and transfer.cancelled else str(error)
                try:
                    conn.settimeout(TRANSFER_SECONDS)
                    with pinned_server_context(self.identity, link.der).wrap_socket(conn, server_side=True) as tls:
                        if transfer is not None:
                            transfer.use(tls)
                        while chunk := source.read(65536):
                            tls.sendall(chunk)
                            if transfer is not None:
                                self.transfer_moved(transfer, len(chunk))
                        wait_acknowledged(tls, TRANSFER_SECONDS,
                                          lambda: transfer is not None and transfer.cancelled)
                except (OSError, ssl.SSLError) as error:
                    if transfer is not None and transfer.cancelled:
                        return "cancelled"
                    return str(error) or type(error).__name__
                finally:
                    conn.close()
        return None

    def on_sftp(self, link, body):
        """The phone's answer to Browse Phone. Ignored when nothing asked:
        a phone doesn't get to push a login at us."""
        with self.lock:
            wait = self.sftp_waits.get(link.id)
        if wait is not None:
            wait["body"] = body
            wait["event"].set()

    def request_browse(self, device_id):
        """Ask the phone to share its folders and return the checked offer.
        The address is this connection's, not the one in the packet."""
        link = self.pick_link(device_id)
        wait = {"event": threading.Event(), "body": None}
        with self.lock:
            if link.id in self.sftp_waits:
                raise PhoneError("the phone's files are already being opened")
            self.sftp_waits[link.id] = wait
        try:
            link.send(SFTP_OUT, {"startBrowsing": True})
            if not wait["event"].wait(SFTP_SECONDS):
                raise PhoneError("the phone didn't open its files. Try again")
            offer = sftp_offer(wait["body"], link.address, link.id)
        finally:
            with self.lock:
                if self.sftp_waits.get(link.id) is wait:
                    del self.sftp_waits[link.id]
            wait["body"] = None
        offer["name"] = link.name
        return offer

    # -- what's playing, controlled from the phone
    def media_waiting(self):
        """A paired phone is connected and media control is on, so players
        are read. While off, or with no phone, nothing is."""
        if not self.settings.media:
            return False
        with self.lock:
            return any(link.paired for link in self.links.values())

    def update_media_follower(self):
        """One playerctl --follow while media_waiting(), none otherwise."""
        if not self.media_waiting():
            self.stop_media_follower()
            self.media_follow_ended = False
            return
        if self.media_follower is not None or self.media_follow_ended:
            return
        follower = follow_players()
        if follower is None:
            self.media_follow_ended = True
            return
        self.media_follower = follower
        self.selector.register(follower.stdout, selectors.EVENT_READ, "media")

    def stop_media_follower(self):
        follower, self.media_follower = self.media_follower, None
        if follower is None:
            return
        with contextlib.suppress(KeyError, ValueError):
            self.selector.unregister(follower.stdout)
        follower.terminate()
        with contextlib.suppress(subprocess.TimeoutExpired):
            follower.wait(2)
        follower.stdout.close()

    def refresh_media(self):
        players = {player.name: player for player in media_players()}
        with self.lock:
            self.media = players
            self.media_at = time.monotonic()
        return players

    def send_player_list(self, link, players):
        with contextlib.suppress(OSError):
            link.send(MEDIA_OUT, {"playerList": list(players), "supportAlbumArtPayload": True})

    def sync_media(self, link):
        """Tell a phone that just connected which players there are and what
        each is playing. The phone asks too; this is so it doesn't wait."""
        if not self.settings.media or not link.paired:
            return
        players = self.refresh_media()
        self.media_names = list(players)
        self.media_sent = dict(players)
        self.send_player_list(link, players)
        for player in players.values():
            with contextlib.suppress(OSError):
                link.send(MEDIA_OUT, player.body())

    def poll_media(self):
        """Read the players and tell connected phones what changed."""
        try:
            self._poll_media()
        except Exception as error:          # a playerctl failure must not stop the daemon
            warn(f"media: {error}")

    def _poll_media(self):
        if not self.settings.media:
            return
        now = time.monotonic()
        elapsed = int((now - self.media_at) * 1000) if self.media_at else 0
        players = self.refresh_media()
        with self.lock:
            links = [link for link in self.links.values() if link.paired]
        if not links:
            return
        names = list(players)
        if names != self.media_names:
            self.media_names = names
            for link in links:
                self.send_player_list(link, players)
            for gone in [name for name in self.media_sent if name not in players]:
                del self.media_sent[gone]
        for name, player in players.items():
            if not player.changed_from(self.media_sent.get(name), elapsed):
                continue
            body = player.body()
            for link in links:
                with contextlib.suppress(OSError):
                    link.send(MEDIA_OUT, body)
            self.media_sent[name] = player

    def on_media(self, link, body):
        """A phone asking about the players, or telling one what to do.
        Changing playback is ignored while the screen is locked: a phone
        that can press play can also be in someone else's hand."""
        if not self.settings.media:
            return
        art = body.get("albumArtUrl")
        if isinstance(art, str) and art:
            self.send_album_art(link, body.get("player") if isinstance(body.get("player"), str) else "", art)
            return
        if screen_locked() and any(key in body for key in MEDIA_CHANGES):
            body = {key: value for key, value in body.items() if key not in MEDIA_CHANGES}
            if not any(packet_flag(body.get(key))
                       for key in ("requestPlayerList", "requestNowPlaying", "requestVolume")):
                return
        players = self.refresh_media()
        name = body.get("player") if isinstance(body.get("player"), str) else ""
        player = players.get(name)
        if player is None or packet_flag(body.get("requestPlayerList")):
            self.send_player_list(link, players)
            if player is None:
                return
        apply_media(player, body)
        want_now = packet_flag(body.get("requestNowPlaying"))
        want_volume = packet_flag(body.get("requestVolume"))
        if want_now or want_volume:
            updated = self.refresh_media().get(name, player)
            with contextlib.suppress(OSError):
                link.send(MEDIA_OUT, updated.body(now=want_now, volume=want_volume or want_now))

    def send_album_art(self, link, name, url):
        """Send the cover the player is showing, when the phone asks for that
        same address. A different address is never opened."""
        with self.lock:
            player = self.media.get(name)
        if player is None or player.art_url != url:
            return
        path = art_file(url)
        if path is None or not os.path.isfile(path):
            return
        try:
            if os.path.getsize(path) > ART_BYTES:
                return
        except OSError:
            return

        def offer():
            error = self.offer_payload(link, path, MEDIA_OUT, {
                "transferringAlbumArt": True, "player": name, "albumArtUrl": url})
            if error:
                warn(f"cover for {name}: {error}")

        threading.Thread(target=offer, daemon=True).start()

    # -- what the phone plays (ADR-018)
    def sync_phone_media(self, link):
        """Ask a phone that just connected for its players. Its app sends the
        list when it starts, but not again when a new link replaces an old one."""
        if not link.paired:
            return
        with contextlib.suppress(OSError):
            link.send(PHONE_MEDIA_OUT, {"requestPlayerList": True})

    def on_phone_media(self, link, data):
        """The phone's list of players, or what one of them plays. A new
        player is asked what it plays; the app then sends every change."""
        body = data.get("body")
        if not isinstance(body, dict):
            return
        if packet_flag(body.get("transferringAlbumArt")):
            self.discard_payload(link, data)    # never asked for: no cover is shown
            return
        ask = []
        with self.lock:
            players = self.phone_media.setdefault(link.id, {})
            if isinstance(body.get("playerList"), list):
                names = list(dict.fromkeys(filter(None, map(phone_player_name, body["playerList"]))))
                names = names[:PHONE_PLAYERS]
                for gone in [name for name in players if name not in names]:
                    del players[gone]
                for name in names:
                    if name not in players:
                        players[name] = PhonePlayer(name)
                        ask.append(name)
            name = phone_player_name(body.get("player"))
            if name and (name in players or len(players) < PHONE_PLAYERS):
                player = players.setdefault(name, PhonePlayer(name))
                before = dataclasses.replace(player)
                update_phone_player(player, body)
                if player != before:
                    self.phone_media_count += 1
                    player.changed = self.phone_media_count
        for name in ask:
            with contextlib.suppress(OSError):
                link.send(PHONE_MEDIA_OUT, {"player": name, "requestNowPlaying": True, "requestVolume": True})
        self.report_playing()

    def phone_playing(self, device_id=None):
        """(device id, PhonePlayer) for the popup's row, or None: that phone's,
        or the one of every connected phone that plays, the newest first."""
        with self.lock:
            found = []
            for device, players in self.phone_media.items():
                link = self.links.get(device)
                if link is None or not link.paired or (device_id and device != device_id):
                    continue
                player = shown_player(players.values())
                if player is not None:
                    found.append((device, player))
            return max(found, key=lambda item: (item[1].playing, item[1].changed), default=None)

    def playing_details(self):
        """`state`'s and `watch`'s playing: id, player, title, artist, playing."""
        found = self.phone_playing()
        if found is None:
            return None
        device, player = found
        return {"id": device, "player": player.name, "title": player.title,
                "artist": player.artist, "playing": player.playing}

    def report_playing(self):
        """A `playing` watch line when the popup's row changed. An empty
        title says the row goes away."""
        with self.playing_lock:
            details = self.playing_details()
            if details == self.playing_told:
                return
            told, self.playing_told = self.playing_told, details
            self.notify_watchers({"event": "playing", **(details or {
                "id": (told or {}).get("id", ""), "player": "", "title": "", "artist": "", "playing": False})})

    def drop_phone_media(self, device_id):
        with self.lock:
            self.phone_media.pop(device_id, None)
        self.report_playing()

    def control_phone_player(self, device_id, action, volume=None):
        """Play, pause, skip or set the volume of what the popup shows (that
        phone's, with --to). The phone's app then sends the change."""
        if action != "volume" and action not in PHONE_PLAYER_ACTIONS:
            raise PhoneError(f"player: {', '.join(PHONE_PLAYER_ACTIONS)} or volume")
        if device_id:
            link = self.pick_link(device_id)
        else:
            found = self.phone_playing()
            link = self.pick_link(found[0] if found else None)
        found = self.phone_playing(link.id)
        if found is None:
            raise PhoneError(f"nothing is open to play on {link.name}")
        player = found[1]
        body = {"player": player.name}
        if action == "volume":
            value = whole_number(volume, 0, 100)
            if value is None:
                raise PhoneError("volume: a percent from 0 to 100")
            body["setVolume"] = value
        else:
            body["action"] = PHONE_PLAYER_ACTIONS[action]
        link.send(PHONE_MEDIA_OUT, body)
        return {"name": link.name, "player": player.name}

    # -- named commands
    def sync_commands(self, link):
        """Send the names. Nothing while the list is empty: the phone's app
        isn't showing them, and an empty packet would only be noise."""
        if not self.settings.commands or not link.paired:
            return
        with contextlib.suppress(OSError):
            link.send(COMMAND_OUT, commands_packet(self.settings.commands))

    def on_runcommand(self, link, body):
        """The phone asks for the names, or to run one command by its key.
        A command line in the packet is never read. setup, which would let
        the phone add a command, is ignored."""
        if body.get("requestCommandList") is True:
            if link.paired:
                with contextlib.suppress(OSError):
                    link.send(COMMAND_OUT, commands_packet(self.settings.commands))
            return
        key = body.get("key")
        command = next((item for item in self.settings.commands if item.key == key), None)
        if command is None:
            if isinstance(key, str) and key:
                warn("the phone asked for a command that isn't on this computer")
            return
        if screen_locked():
            return
        run_named_command(command)

    # -- the control socket (one thread per request)
    def serve_control(self, conn):
        with conn:
            try:
                request = read_json(conn, 10)
                command = request.get("command")
                if command == "pair":
                    self.pair_session(conn)
                elif command == "status":
                    reply(conn, self.status())
                elif command == "send":
                    cancelled = []
                    name = self.send_items(request.get("to"), request.get("items", []), cancelled)
                    reply(conn, {"ok": True, "name": name, "cancelled": cancelled})
                elif command == "cancel":
                    reply(conn, {"ok": True, "name": self.cancel_transfer(str(request.get("id") or ""))})
                elif command == "ring":
                    link = self.pick_link(request.get("to"))
                    link.send("kdeconnect.findmyphone.request", {})
                    reply(conn, {"ok": True, "name": link.name})
                elif command == "mute":
                    link = self.pick_link(request.get("to"))
                    self.mute_ringer(link.id)
                    reply(conn, {"ok": True, "name": link.name})
                elif command == "player":
                    reply(conn, {"ok": True, **self.control_phone_player(
                        request.get("to"), str(request.get("action") or ""), request.get("volume"))})
                elif command == "browse":
                    reply(conn, {"ok": True, **self.request_browse(request.get("to"))})
                elif command == "ping":
                    link = self.pick_link(request.get("to"))
                    text = str(request.get("text") or "")
                    link.send("kdeconnect.ping", {"message": text} if text else {})
                    reply(conn, {"ok": True, "name": link.name})
                elif command == "forget":
                    reply(conn, {"ok": True, "name": self.forget(request.get("id", ""))})
                elif command == "reload":
                    was, apps = self.settings.notifications, self.settings.notification_apps
                    was_calls, was_media = self.settings.calls, self.settings.media
                    was_commands = self.settings.commands
                    self.settings = load_settings()
                    # The phone reads capabilities only at the handshake, so one
                    # that came or went means it connects again. Commands are
                    # announced only while the list has one.
                    if (was != self.settings.notifications or was_calls != self.settings.calls
                            or was_media != self.settings.media
                            or bool(was_commands) != bool(self.settings.commands)):
                        if was != self.settings.notifications:
                            self.close_phone_notes()
                        if was_calls and not self.settings.calls:
                            self.end_all_calls()
                        if was_media and not self.settings.media:
                            self.media, self.media_sent, self.media_names = {}, {}, None
                        self.drop_paired_links()
                    else:
                        with self.lock:
                            links = [link for link in self.links.values() if link.paired]
                        if was_commands != self.settings.commands:
                            for link in links:
                                self.sync_commands(link)
                        if self.settings.notifications and apps != self.settings.notification_apps:
                            for link in links:
                                self.sync_notifications(link)
                    self.recheck()
                    reply(conn, {"ok": True})
                elif command == "stop":
                    reply(conn, {"ok": True})
                    self.stopping.set()
                    self.wake()
                elif command == "watch":
                    self.watch(conn)
                else:
                    reply(conn, {"error": f"unknown command {command!r}"})
            except PhoneError as error:
                with contextlib.suppress(OSError):
                    reply(conn, {"error": str(error)})
            except (OSError, ValueError):
                pass

    def status(self):
        with self.lock:
            links = [{"id": link.id, "name": link.name, "paired": link.paired, "address": link.address,
                      "battery": list(link.battery) if link.battery else None} for link in self.links.values()]
            calls = [{"id": device_id, "state": state, "caller": self.callers.get(device_id, "")}
                     for device_id, state in self.calls.items()]
            transfers = [transfer.details() for transfer in self.transfers.values()]
            return {"running": True, "listening": self.tcp is not None, "network": self.allowed,
                    "pairing": self.pairing is not None, "connected": links, "calls": calls,
                    "transfers": transfers, "playing": self.playing_details(), "name": self.name()}

    def forget(self, device_id):
        with self.lock:
            link = self.links.get(device_id)
        if link is not None and link.paired:
            with contextlib.suppress(OSError):
                link.send("kdeconnect.pair", {"pair": False})
            self.unpair(link)
            return link.name
        name = forget_device(device_id)
        if name is None:
            raise PhoneError("no paired phone has that id")
        return name


def gone(conn):
    """Whether the other end of a control connection has closed it."""
    try:
        readable, _, _ = select.select([conn], [], [], 0)
        return bool(readable) and conn.recv(1, socket.MSG_PEEK) == b""
    except (OSError, ValueError):       # closed here (a descriptor of -1)
        return True


def reply(conn, data):
    conn.sendall((json.dumps(data, ensure_ascii=False) + "\n").encode())


def read_json(conn, timeout):
    conn.settimeout(timeout)
    data = b""
    while b"\n" not in data:
        if len(data) > 1 << 20:
            raise ValueError("request too long")
        chunk = conn.recv(65536)
        if not chunk:
            raise ValueError("no request")
        data += chunk
    value = json.loads(data.split(b"\n", 1)[0])
    if not isinstance(value, dict):
        raise ValueError("not an object")
    return value


# --- Running the daemon --------------------------------------------------------------

def daemon_lock():
    os.makedirs(runtime_dir(), mode=0o700, exist_ok=True)
    lock = open(os.path.join(runtime_dir(), "daemon.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        return None
    return lock


def session_socket():
    """A connection to the compositor that closes when the session ends."""
    display = os.environ.get("WAYLAND_DISPLAY")
    if not display:
        return None
    path = display if os.path.isabs(display) else os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), display)
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(path)
    except OSError:
        sock.close()
        return None
    return sock


def network_monitor():
    try:
        return subprocess.Popen(["nmcli", "monitor"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True, bufsize=1)
    except OSError:
        return None


def run_daemon():
    """For the session, while the feature is on. One per session."""
    if live_session() or not load_settings().enabled:
        return 0
    lock = daemon_lock()
    if lock is None:
        return 0
    with lock:
        identity = ensure_identity()
        path = control_path()
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)
        control = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        control.bind(path)
        os.chmod(path, 0o600)
        control.listen(8)
        daemon = Daemon(identity, load_settings())
        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(signum, lambda *_: (daemon.stopping.set(), daemon.wake()))
        monitor = network_monitor()
        make_on_link(os.path.realpath(sys.argv[0]))
        signal_panel()                  # the button says it's waiting, not "not running"
        try:
            return daemon.run(control, session_socket(), monitor)
        finally:
            remove_on_link()
            signal_panel()
            if monitor is not None:
                monitor.kill()
                monitor.wait()
            control.close()
            with contextlib.suppress(FileNotFoundError):
                os.unlink(path)


def remove_runtime_dir(wait=5.0):
    """After the daemon has stopped (it holds its lock until then)."""
    with contextlib.suppress(PhoneError):
        deadline = time.monotonic() + wait
        while True:
            lock = daemon_lock()
            if lock is not None:
                lock.close()
                shutil.rmtree(runtime_dir(), ignore_errors=True)
                return
            if time.monotonic() >= deadline:
                return
            time.sleep(0.1)


def start_daemon():
    if not os.environ.get("WAYLAND_DISPLAY"):
        return
    spawn([sys.executable, os.path.abspath(sys.argv[0]), "daemon"])


# --- Commands --------------------------------------------------------------------------

def request(data, timeout=OFFER_SECONDS * SEND_TRIES + 30):
    """Ask the daemon. Its answer, or None if it isn't running."""
    try:
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        conn.connect(control_path())
    except (OSError, PhoneError):
        return None
    with conn:
        reply(conn, data)
        answer = read_json(conn, timeout)
    if "error" in answer:
        raise PhoneError(answer["error"])
    return answer


def cmd_daemon(opts):
    return run_daemon()


def cmd_get(opts):
    settings = load_settings()
    if opts.key == "name":
        print(device_name(settings))
    elif opts.key == "notification-apps":
        text = setting_text(settings, "notification_apps")
        if text:
            print(text)
    else:
        print(setting_text(settings, opts.key))
    return 0


def cmd_set(opts):
    key, value = opts.key, opts.value
    if key == "enabled":
        was = load_settings().enabled
        if value == DEFAULT_CHOICE:
            on = system_settings().enabled
            save_settings(enabled=None)
        elif value in ("yes", "no"):
            on = value == "yes"
            if on and live_session():
                raise PhoneError("not available in the live session")
            save_settings(enabled=on)
        else:
            raise PhoneError("enabled: yes, no or default")
        if on:
            ensure_identity()
            if request({"command": "status"}) is None:
                start_daemon()
        else:
            with contextlib.suppress(PhoneError, OSError, ValueError):
                request({"command": "stop"}, timeout=10)
            shutil.rmtree(state_dir(), ignore_errors=True)
            remove_runtime_dir()
            remove_on_link()            # left by a daemon that didn't get to remove it
        if on != was:
            reload_panel()              # the phone button comes or goes
    elif key == "name":
        if value == DEFAULT_CHOICE:
            save_settings(name=None)
        elif clean_name(value):
            save_settings(name=clean_name(value))
        else:
            raise PhoneError("name: some letters or digits, or default")
        with contextlib.suppress(PhoneError, OSError, ValueError):
            request({"command": "reload"}, timeout=10)
    elif key == "networks":
        # NetworkManager connection UUIDs, separated by spaces; "" for none.
        networks = tuple(dict.fromkeys(value.split()))
        if value == DEFAULT_CHOICE:
            save_settings(networks=None)
        elif all(re.fullmatch(r"[0-9A-Za-z-]{1,64}", n) for n in networks):
            save_settings(networks=networks)
        else:
            raise PhoneError("networks: NetworkManager connection UUIDs, or default")
        with contextlib.suppress(PhoneError, OSError, ValueError):
            request({"command": "reload"}, timeout=10)
    elif key == "notifications":
        if value == DEFAULT_CHOICE:
            save_settings(notifications=None)
        elif value in ("yes", "no"):
            save_settings(notifications=(value == "yes"))
        else:
            raise PhoneError("notifications: yes, no or default")
        with contextlib.suppress(PhoneError, OSError, ValueError):
            request({"command": "reload"}, timeout=10)
    elif key == "calls":
        if value == DEFAULT_CHOICE:
            save_settings(calls=None)
        elif value in ("yes", "no"):
            save_settings(calls=(value == "yes"))
        else:
            raise PhoneError("calls: yes, no or default")
        with contextlib.suppress(PhoneError, OSError, ValueError):
            request({"command": "reload"}, timeout=10)
    elif key == "media":
        if value == DEFAULT_CHOICE:
            save_settings(media=None)
        elif value in ("yes", "no"):
            save_settings(media=(value == "yes"))
        else:
            raise PhoneError("media: yes, no or default")
        with contextlib.suppress(PhoneError, OSError, ValueError):
            request({"command": "reload"}, timeout=10)
    elif key == "commands":
        if value == DEFAULT_CHOICE:
            save_settings(commands=None)
        elif not value.strip() or value.strip() == "[]":
            save_settings(commands=())
        else:
            parsed = parse_command_list(value)
            if parsed is None:
                raise PhoneError("commands: a list of named commands, or default")
            save_settings(commands=parsed)
        with contextlib.suppress(PhoneError, OSError, ValueError):
            request({"command": "reload"}, timeout=10)
    elif key == "notification-apps":
        if value == DEFAULT_CHOICE:
            save_settings(notification_apps=None)
        else:
            names = []
            for line in value.splitlines():
                name = clean_app_name(line)
                if name and name not in names:
                    names.append(name)
            if value.strip() and not names:
                raise PhoneError("notification-apps: one app name per line, or default")
            save_settings(notification_apps=tuple(names))
        with contextlib.suppress(PhoneError, OSError, ValueError):
            request({"command": "reload"}, timeout=10)
    return 0


def cmd_notifications(opts):
    """Which apps may show their notifications: list, allow NAME, block NAME."""
    settings = load_settings()
    if opts.action == "list":
        allowed = set(settings.notification_apps)
        for name in notification_apps(settings):
            print(f"{name}\t{'yes' if name in allowed else 'no'}")
        return 0
    name = clean_app_name(opts.name or "")
    if not name:
        raise PhoneError("notifications allow|block NAME")
    apps = list(settings.notification_apps)
    if opts.action == "allow" and name not in apps:
        apps.append(name)
    elif opts.action == "block":
        apps = [app for app in apps if app != name]
    if tuple(apps) != settings.notification_apps:
        save_settings(notification_apps=tuple(apps))
    remember_app(name)
    with contextlib.suppress(PhoneError, OSError, ValueError):
        request({"command": "reload"}, timeout=10)
    return 0


def panel_status():
    """The panel button: connected, or dimmed while no phone is."""
    if not load_settings().enabled:
        return {"text": ""}             # waybar hides a module without text
    try:
        status = request({"command": "status"}, timeout=5)
    except (PhoneError, OSError, ValueError):
        status = None
    connected = [link for link in (status or {}).get("connected", []) if link["paired"]]
    if connected:
        state, text = "connected", "Connected to " + ", ".join(
            link["name"] + battery_text(link.get("battery")) for link in connected)
    elif status:
        state, text = "waiting", "No phone connected"
    else:
        state, text = "waiting", "The phone connection isn't running"
    return {"text": " ", "alt": state, "class": [state],
            "tooltip": f"{text}\nClick: Phone"}


def battery_text(battery):
    """ · 80 %, charging: a phone's battery for the tooltip, or nothing."""
    if not battery:
        return ""
    charge, charging = battery
    return f" · {charge} %" + (", charging" if charging else "")


# The menu still runs these itself (cmd_menu). The window and `actions --json`
# run the Action's argv. The SCREEN_NEEDS ones are ("run", argv) because they
# aren't this program.
MENU_KINDS = {
    "files": ("send-files",), "text": ("send-text",), "clipboard": ("send-clipboard",),
    "screenshot": ("send-screenshot",), "ring": ("ring",), "browse": ("browse",),
}


def second_screen_on():
    """The add-on's second screen is on (SECOND_SCREEN_FILE exists)."""
    base = os.environ.get("XDG_RUNTIME_DIR")
    return bool(base) and os.path.exists(os.path.join(base, SECOND_SCREEN_FILE))


def action_list(connected, device_id=None, screenshot=True, files=False, screen=None, second_on=None):
    """The actions ACTIONS describes, in order. Each is id, label, short, icon,
    command (an argv) and shown (a phone is connected, and grim, the file
    manager's network folders or SCREEN_COMMAND when the action needs it).
    device_id adds --to, for a window that has chosen one of several phones.
    screen is Show Phone Screen's argv, or None while it isn't installed; the
    second screen's commands get its --to. second_on: the second screen is on
    (None: second_screen_on()); only one of its two actions is shown."""
    if second_on is None:
        second_on = second_screen_on()
    rows = []
    for action in ACTIONS:
        shown = bool(connected)
        if action.needs == "grim":
            shown = shown and bool(screenshot)
        elif action.needs == "files":
            shown = shown and bool(files)
        elif action.needs in SCREEN_NEEDS:
            shown = shown and bool(screen)
            if action.needs != "screen":
                shown = shown and second_on == (action.needs == "second-on")
        if action.needs == "screen":
            command = list(screen or [SCREEN_COMMAND])
        elif action.needs in SCREEN_NEEDS:
            command = [SCREEN_COMMAND, *action.command, *(screen or [SCREEN_COMMAND])[1:]]
        else:
            command = list(action.command)
        if device_id and "--to" not in command:
            command += ["--to", device_id]
        rows.append({"id": action.id, "label": action.label, "short": action.short, "icon": action.icon,
                     "command": command, "shown": shown})
    return rows


def menu_entries(connected, received, control, screenshot=True, screen=None, files=False):
    """(label, action) for the button's menu: action is ("send-files",),
    ("send-text",), ("send-clipboard",), ("send-screenshot",), ("ring",),
    ("browse",), ("run", ARGV) or ("copy", TEXT). The actions are action_list's,
    so the menu, the window and `actions --json` stay the same list. screen:
    Show Phone Screen's ARGV, or None while SCREEN_COMMAND isn't installed.
    files: Browse Phone, while the file manager can open a network folder."""
    entries = []
    for row in action_list(bool(connected), screenshot=screenshot, files=files, screen=screen):
        if not row["shown"]:
            continue
        if row["command"][0] == SCREEN_COMMAND:
            entries.append((row["label"], ("run", row["command"])))
        else:
            entries.append((row["label"], MENU_KINDS[row["id"]]))
    for item in reversed(received[-MENU_RECEIVED:]):
        kind, value = item.get("kind"), item.get("value", "")
        if kind == "page":
            entries.append((f"Open {short_address(value)}", ("run", ["xdg-open", value])))
        elif kind == "file" and os.path.isfile(value):
            if openable(value):
                entries.append((f"Open {os.path.basename(value)}", ("run", ["xdg-open", value])))
            else:
                entries.append((f"Show {os.path.basename(value)} in Folder",
                                ("run", ["xdg-open", os.path.dirname(value)])))
        elif kind == "text" and app_address(value):
            name, address = app_address(value)
            entries.append((f"Open in {name}", ("run", ["xdg-open", address])))
        elif kind in ("text", "clipboard") and value.strip():
            first = value.strip().splitlines()[0]
            first = first if len(first) <= 50 else first[:49] + "…"
            entries.append((f"Copy \u201c{first}\u201d", ("copy", value)))
    if control:
        entries.append(("Phone Settings", ("run", ["flickos-control", "--page", "phone"])))
    return entries


def phone_line(phone):
    """(name, status) for the Phone window's phone line. phone is a state
    entry, or None when none is paired."""
    if not phone:
        return "No phone paired", "Add one in Phone Settings"
    name = phone.get("name") or "Phone"
    if phone.get("connected"):
        return name, "Connected" + battery_text(phone.get("battery"))
    return name, "Not connected"


def received_actions(item):
    """(title, note, actions) for one received item in the Phone window.
    note is extra status ("", "Clipboard", "no longer there"). actions is
    (label, accessible name, argv)."""
    kind, value = item.get("kind"), item.get("value", "")
    note, actions = "", []
    if kind == "page":
        title = short_address(value)
        actions.append(("Open", f"Open {title}", ["xdg-open", value]))
    elif kind == "file":
        title = os.path.basename(value) or "File"
        exists = item["exists"] if "exists" in item else os.path.isfile(value)
        if not exists:
            note = "no longer there"
        else:
            can_open = item["openable"] if "openable" in item else openable(value)
            if can_open:
                actions.append(("Open", f"Open {title}", ["xdg-open", value]))
            folder = os.path.dirname(value) or "."
            actions.append(("Show in Folder", f"Show {title} in its folder", ["xdg-open", folder]))
    else:
        app = item.get("app")
        if app is None:
            found = app_address(value) if kind == "text" else None
            app = found[0] if found else ""
        if app:                 # an address an app registered: opened in it, its gibberish not shown
            title = f"For {app}"
            actions.append(("Open", f"Open in {app}", ["xdg-open", value.strip()]))
            actions.append(("Copy", "Copy the address", ["wl-copy", "--", value]))
            return title, note, actions
        lines = value.strip().splitlines()
        title = (lines[0] if lines else "") or "Text"
        title = title if len(title) <= 60 else title[:59] + "…"
        if kind == "clipboard":
            note = "Clipboard"
        actions.append(("Copy", f"Copy {title}", ["wl-copy", "--", value]))
        address = item.get("address")
        if address is None:
            found = URL_IN_TEXT.search(value)
            address = found.group(0) if found else ""
        if address:
            actions.append(("Open", f"Open the address in {title}", ["xdg-open", address]))
    return title, note, actions


def received_icons(item):
    """Icon names for a received item's row, the first the theme has wins:
    the file's type (image/jpeg: image-jpeg, then image-x-generic), a page,
    or text. The window and the popup show the same (flickos-menu's phone.py
    has a copy); the window puts a picture's thumbnail over it."""
    kind, value = item.get("kind"), item.get("value") or ""
    if kind == "page":
        return ["text-html", "text-x-generic"]
    if kind == "file":
        mime = mimetypes.guess_type(value)[0] or ""
        names = [mime.replace("/", "-"), mime.split("/")[0] + "-x-generic"] if "/" in mime else []
        return names + ["application-octet-stream", "unknown"]
    return ["text-x-generic"]


def apply_watch(state, event):
    """Fold one `watch` line into the state object the Phone window shows."""
    phones = state.setdefault("phones", [])
    kind = event.get("event")
    if kind == "connected":
        phone = event.get("phone") if isinstance(event.get("phone"), dict) else {}
        device_id = phone.get("id")
        if not device_id:
            return state
        found = next((item for item in phones if item.get("id") == device_id), None)
        row = {"id": device_id, "name": phone.get("name") or (found or {}).get("name", ""),
               "connected": True, "address": phone.get("address") or "",
               "battery": phone.get("battery"), "paired": (found or {}).get("paired", "")}
        if found:
            found.update(row)
        else:
            phones.append(row)
    elif kind == "disconnected":
        for phone in phones:
            if phone.get("id") == event.get("id"):
                phone["connected"] = False
                phone["address"] = ""
                phone["battery"] = None
    elif kind == "forgotten":
        state["phones"] = [phone for phone in phones if phone.get("id") != event.get("id")]
    elif kind == "battery":
        for phone in phones:
            if phone.get("id") == event.get("id") and phone.get("connected"):
                phone["battery"] = event.get("battery")
    elif kind == "received":
        item = event.get("item")
        if isinstance(item, dict):
            items = state.setdefault("received", [])
            items.append(item)
            del items[:-RECEIVED_ITEMS]
    elif kind == "call":
        device_id = event.get("id")
        ringing = [row for row in (state.get("ringing") or []) if row.get("id") != device_id]
        if event.get("state") == "ringing" and device_id:
            name = next((phone.get("name") or "Phone" for phone in phones if phone.get("id") == device_id), "Phone")
            ringing.append({"id": device_id, "name": name, "caller": event.get("caller") or ""})
        state["ringing"] = ringing
    elif kind == "transfer":
        transfer_id = event.get("id")
        transfers = [row for row in (state.get("transfers") or []) if row.get("id") != transfer_id]
        if transfer_id and event.get("state") in ("waiting", "moving"):
            transfers.append({key: event.get(key) for key in TRANSFER_FIELDS})
        state["transfers"] = transfers
    elif kind == "playing":
        # What the phone plays (ADR-018). The phone popup draws it.
        title, artist = event.get("title") or "", event.get("artist") or ""
        if title or artist:
            state["playing"] = {"id": event.get("id") or "", "title": title, "artist": artist,
                                "playing": bool(event.get("playing", True))}
        else:
            state["playing"] = None
    return state


def iter_watch(stop):
    """Yield `watch` events until a byte is written to stop (the read end of
    a pipe) or the daemon closes. Raises PhoneError when it isn't running
    or refuses another window. Blocks: nothing polls."""
    try:
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        conn.connect(control_path())
    except (OSError, PhoneError):
        raise PhoneError("the phone connection isn't running") from None
    with conn:
        reply(conn, {"command": "watch"})
        conn.settimeout(None)
        buf = b""
        while True:
            try:
                readable, _, _ = select.select([conn, stop], [], [])
            except (OSError, ValueError):
                break
            if stop in readable:
                break
            try:
                chunk = conn.recv(65536)
            except OSError:
                break
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(event, dict):
                    continue
                if event.get("error") and "event" not in event:
                    raise PhoneError(event["error"])
                yield event


def load_window():
    """The Phone window's code (WINDOW_CODE). Only `window` loads it: this
    script has no .pyc, and compiling the window too would cost the daemon
    and every panel update."""
    import importlib.machinery
    import importlib.util
    sys.dont_write_bytecode = True
    loader = importlib.machinery.SourceFileLoader("flickos_phone_window", WINDOW_CODE)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def window_pid(path):
    """The PID in the Phone window's lock, while a flickos-phone process holds
    it. None when the window isn't open."""
    try:
        with open(path, encoding="utf-8") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
                return None
            except BlockingIOError:
                text = lock.read().strip()
    except OSError:
        return None
    if not text.isdigit():
        return None
    pid = int(text)
    try:
        with open(os.path.join(PROC, str(pid), "cmdline"), "rb") as f:
            argv = f.read().split(b"\0")
    except OSError:
        return None
    if not any(os.path.basename(arg.decode(errors="replace")) == "flickos-phone" for arg in argv):
        return None
    return pid


def take_window_request():
    """The page a second `window` asked for, once, or None."""
    path = os.path.join(runtime_dir(), WINDOW_REQUEST)
    try:
        with open(path, encoding="utf-8") as f:
            page = f.read().strip()
    except OSError:
        return None
    with contextlib.suppress(OSError):
        os.unlink(path)
    return page if page in WINDOW_PAGES else None


def raise_phone_window(page):
    """Ask the open Phone window to show page and come forward. False when
    none is open, or it isn't this program."""
    pid = window_pid(os.path.join(runtime_dir(), WINDOW_LOCK))
    if pid is None:
        return False
    write_atomic(os.path.join(runtime_dir(), WINDOW_REQUEST), page + "\n", mode=0o600)
    try:
        os.kill(pid, signal.SIGUSR1)
    except OSError:
        return False
    return True


def cmd_window(opts):
    """The Phone window. A second one shows its page in the open window."""
    # Until the window has its handler, a second start's signal does nothing;
    # the page is in WINDOW_REQUEST and read when the window starts.
    signal.signal(signal.SIGUSR1, signal.SIG_IGN)
    page = opts.page if opts.page in WINDOW_PAGES else "overview"
    if not os.environ.get("XDG_RUNTIME_DIR"):
        raise PhoneError("no session folder (XDG_RUNTIME_DIR is not set)")
    os.makedirs(runtime_dir(), mode=0o700, exist_ok=True)
    lock = open(os.path.join(runtime_dir(), WINDOW_LOCK), "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        if raise_phone_window(page):
            print("Phone is already open.")
            return 0
        raise PhoneError("Phone is already open")
    lock.seek(0)
    lock.truncate()
    lock.write(str(os.getpid()))
    lock.flush()
    try:
        try:
            window = load_window()
        except OSError as error:
            raise PhoneError(f"the Phone window isn't installed ({error})") from None
        return window.run(page, sys.modules[__name__], lock)
    finally:
        lock.close()


def cmd_actions(opts):
    """The shared action list, as JSON. --to marks the commands for that phone
    and hides them while it isn't the one connected."""
    try:
        status = request({"command": "status"}, timeout=5) or {}
    except (PhoneError, OSError, ValueError):
        status = {}
    links = [link for link in status.get("connected", []) if link.get("paired")]
    connected = any(link["id"] == opts.to for link in links) if opts.to else bool(links)
    screen = [SCREEN_COMMAND] if shutil.which(SCREEN_COMMAND) else None
    rows = action_list(connected, device_id=opts.to or None, screenshot=shutil.which("grim") is not None,
                       files=files_available(), screen=screen)
    print(json.dumps(rows, ensure_ascii=False))
    return 0


def cmd_menu(opts):
    """The panel button's menu, with fuzzel."""
    if shutil.which("fuzzel") is None:
        raise PhoneError("fuzzel is not installed")
    try:
        status = request({"command": "status"}, timeout=5) or {}
    except (PhoneError, OSError, ValueError):
        status = {}
    links = [link for link in status.get("connected", []) if link["paired"]]
    connected = [link["name"] for link in links]
    screen = None
    if shutil.which(SCREEN_COMMAND):
        # With several phones connected, its window asks which.
        screen = [SCREEN_COMMAND, *(["--to", links[0]["id"]] if len(links) == 1 else [])]
    entries = menu_entries(connected, read_received(), shutil.which("flickos-control") is not None,
                           shutil.which("grim") is not None, screen, files_available())
    if not entries:
        return 0
    prompt = f"{connected[0]}: " if len(connected) == 1 else "Phone: "
    # --index: fuzzel answers with the entry's number (flick-tiler's menu does the same).
    result = subprocess.run(["fuzzel", "--dmenu", "--index", "--prompt", prompt, "--lines", str(len(entries))],
                            input="\n".join(label.replace("\n", " ") for label, _ in entries) + "\n",
                            capture_output=True, text=True, check=False)
    try:
        index = int(result.stdout.strip())
    except ValueError:
        return 0                        # nothing chosen
    if not 0 <= index < len(entries):
        return 0
    action = entries[index][1]
    sends = {"send-files": "choose", "send-text": "type_text", "send-clipboard": "clipboard",
             "send-screenshot": "screenshot"}
    if action[0] in sends:
        what = {flag: flag == sends[action[0]] for flag in sends.values()}
        return cmd_send(argparse.Namespace(things=[], to=None, text=None, notify=True, **what))
    if action[0] == "ring":
        return cmd_ring(argparse.Namespace(to=None, notify=True))
    if action[0] == "browse":
        return cmd_browse(argparse.Namespace(to=None, notify=True))
    if action[0] == "copy":
        copy_text(action[1])
    else:
        spawn(action[1])
    return 0


def cmd_status(opts):
    if opts.panel:
        print(json.dumps(panel_status(), ensure_ascii=False), flush=True)
        return 0
    settings = load_settings()
    try:
        answer = request({"command": "status"}, timeout=10)
    except (OSError, ValueError):
        answer = None
    data = answer or {"running": False, "listening": False, "connected": []}
    data.update({"enabled": settings.enabled, "name": device_name(settings), "firewall": firewall_on(),
                 "paired": len(load_devices())})
    if opts.json:
        print(json.dumps(data, ensure_ascii=False))
        return 0
    print(f"Phone connection: {'on' if settings.enabled else 'off'}"
          + ("" if not settings.enabled or data["running"] else " (not running)"))
    print(f"This computer's name on the phone: {data['name']}")
    if settings.enabled:
        print(f"Listening: {'yes' if data['listening'] else 'no (not on a network where a phone was paired)'}")
        for link in data["connected"]:
            print(f"Connected: {link['name']}{'' if link['paired'] else ' (not paired)'}")
        if data["firewall"]:
            print("The firewall is on: phones can connect only if it lets them (TCP 1716 and 1739-1764, UDP 1716).")
    return 0


def cmd_state(opts):
    """Everything the Settings page shows, as one JSON object."""
    settings = load_settings()
    try:
        status = request({"command": "status"}, timeout=10) or {}
    except (PhoneError, OSError, ValueError):
        status = {}
    # A connected phone's address: what flickos-phone-screen looks for on the network.
    connected = {}
    batteries = {}
    for link in status.get("connected", []):
        if link["paired"]:
            connected[link["id"]] = link.get("address", "")
            batteries[link["id"]] = link.get("battery")
    active = active_networks() or []
    names = network_names() if settings.networks or active else {}
    phones = [{"id": key, "name": value.get("name", ""), "paired": value.get("paired", ""),
               "connected": key in connected, "address": connected.get(key, ""),
               "battery": batteries.get(key)}
              for key, value in load_devices().items()]
    data = {
        "enabled": settings.enabled, "running": bool(status.get("running")),
        "listening": bool(status.get("listening")), "pairing": bool(status.get("pairing")),
        "name": device_name(settings), "own_name": settings.name, "computer_name": computer_name(),
        "firewall": firewall_on(), "live": live_session(),
        # Not running because something else has KDE Connect's port.
        "blocked": settings.enabled and not status.get("running") and port_taken(),
        "phones": phones,
        "networks": [{"uuid": uuid_, "name": names.get(uuid_, ""), "active": uuid_ in active}
                     for uuid_ in settings.networks],
        "active": [{"uuid": uuid_, "name": names.get(uuid_, "")} for uuid_ in active],
        "received": [received_details(item) for item in read_received()],
        "transfers": status.get("transfers") or [],
        "notifications": settings.notifications,
        "notification_apps": [{"name": name, "allowed": name in settings.notification_apps}
                              for name in notification_apps(settings)],
        "calls": settings.calls,
        "ringing": ringing_phones(status, phones),
        # What the phone plays, for the popup's row (ADR-018); None while nothing.
        "playing": status.get("playing"),
        "media": settings.media,
        "commands": [{"key": item.key, "name": item.name, "command": item.command}
                     for item in settings.commands],
    }
    print(json.dumps(data, ensure_ascii=False))
    return 0


def ringing_phones(status, phones):
    """Phones that are ringing, for the phone popup's Mute row: id, name, caller."""
    names = {phone.get("id"): phone.get("name") or "Phone" for phone in phones}
    ringing = []
    for call in status.get("calls") or []:
        if call.get("state") != "ringing" or not call.get("id"):
            continue
        ringing.append({"id": call["id"], "name": names.get(call["id"]) or "Phone",
                        "caller": call.get("caller") or ""})
    return ringing


def port_taken(port=TCP_PORT):
    """Whether another program (KDE Connect, GSConnect) listens on the port."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
        probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            probe.bind(("", port))
        except OSError:
            return True
    return False


def received_details(item):
    """What the page may do with an item: open a file that is still there
    and is a document, picture, sound or video; open an address in a text;
    open a text that is an address an app registered in that app ("app", its
    name, else "")."""
    item = dict(item)
    if item.get("kind") == "file":
        item["exists"] = os.path.isfile(item.get("value", ""))
        item["openable"] = item["exists"] and openable(item["value"])
    elif item.get("kind") in ("text", "clipboard"):
        found = URL_IN_TEXT.search(item.get("value", ""))
        item["address"] = found.group(0) if found else ""
        app = app_address(item.get("value", "")) if item["kind"] == "text" else None
        item["app"] = app[0] if app else ""
    return item


def cmd_devices(opts):
    devices = load_devices()
    try:
        answer = request({"command": "status"}, timeout=10)
    except (OSError, ValueError):
        answer = None
    connected = {link["id"] for link in (answer or {}).get("connected", []) if link["paired"]}
    rows = [{"id": key, "name": value.get("name", ""), "paired": value.get("paired", ""),
             "connected": key in connected} for key, value in devices.items()]
    if opts.json:
        print(json.dumps(rows, ensure_ascii=False))
    for row in [] if opts.json else rows:
        print(f"{row['name']}\t{row['id']}\t{'connected' if row['connected'] else 'not connected'}")
    return 0


def cmd_forget(opts):
    answer = request({"command": "forget", "id": opts.id}, timeout=10)
    name = answer["name"] if answer else forget_device(opts.id)
    if name is None:
        raise PhoneError("no paired phone has that id")
    print(f"Forgot {name}.")
    return 0


def cmd_pair(opts):
    """Wait for a phone to ask, show its key, answer. With --json: one JSON
    event per line (waiting, request, paired, refused, failed, timeout), and
    the answer, yes or no, is read as a line from standard input."""
    say = print_event if opts.json else None
    if not load_settings().enabled:
        raise PhoneError("the phone connection is off (flickos-phone set enabled yes)")
    try:
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        conn.connect(control_path())
    except OSError:
        raise PhoneError("the phone connection isn't running") from None
    with conn:
        reply(conn, {"command": "pair"})
        event = read_json(conn, 10)
        if "error" in event:
            raise PhoneError(event["error"])
        if say:
            say(event)
        else:
            print(f'In the KDE Connect app on the phone, choose "{event["name"]}" and tap Pair.')
            if event.get("firewall"):
                print("The firewall is on: the phone can only connect if it lets phones in\n"
                      "(Settings > Phone, or flickos-control system firewall.phones on).")
            print(f"Waiting {PAIR_SECONDS // 60} minutes...")
        event = read_json(conn, PAIR_SECONDS + 30)
        if event.get("event") != "request":
            if say:
                say(event)
                return 1
            raise PhoneError("no phone asked to pair")
        if say:
            say(event)
            answer = sys.stdin.readline().strip().lower()
        else:
            print(f"{event['name']} asks to pair. Verification key: {event['key']}")
            answer = input("Does the phone show the same key? [y/N] ").strip().lower()
        reply(conn, {"answer": "yes" if answer in ("y", "yes") else "no"})
        event = read_json(conn, 10)
    if say:
        say(event)
        return 0 if event.get("event") == "paired" else 1
    if event.get("event") != "paired":
        raise PhoneError("not paired")
    print(f"Paired with {event['name']}.")
    return 0


def print_event(event):
    print(json.dumps(event, ensure_ascii=False), flush=True)


def cmd_send(opts):
    """Send to the phone. --notify (the file manager's Send to Phone, which
    shows no output, and is there even while the phone connection is off):
    say so with a notification while sending and after."""
    note = None
    shot = None
    try:
        items = []
        if opts.choose:
            chosen = choose_files()
            if not chosen:
                return 0                # cancelled
            items.extend({"kind": "file", "value": path} for path in chosen)
        if opts.type_text:
            typed = type_text()
            if not typed:
                return 0                # cancelled
            items.append({"kind": "text", "value": typed})
        if opts.screenshot:
            shot = take_screenshot()
            items.append({"kind": "file", "value": shot})
        if opts.clipboard:
            # A web address goes as a page, so the phone offers to open it.
            text = clipboard_text()
            address = text.strip()
            if "\n" not in address and web_address(address):
                items.append({"kind": "url", "value": address})
            else:
                items.append({"kind": "clipboard", "value": text})
        if opts.text is not None:
            items.append({"kind": "text", "value": opts.text})
        for thing in opts.things:
            if re.match(r"^[a-z][a-z0-9+.-]*://", thing, re.I):
                items.append({"kind": "url", "value": thing})
            elif os.path.isfile(thing):
                items.append({"kind": "file", "value": os.path.abspath(thing)})
            else:
                raise PhoneError(f"{thing}: not a file or an address")
        if not items:
            raise PhoneError("nothing to send")
        if opts.notify:
            note = progress_note("Sending to your phone…", sent_names(items))
        # No timeout: a large file takes as long as it takes, and the daemon
        # gives up on one that stalls (TRANSFER_SECONDS) or isn't fetched.
        answer = request({"command": "send", "to": opts.to, "items": items}, timeout=None)
        if answer is None:
            raise PhoneError(not_running_reason())
        cancelled = answer.get("cancelled") or []
        if cancelled and len(cancelled) == len(items):
            raise PhoneError("cancelled")
    except (PhoneError, OSError, ValueError) as error:
        if opts.notify:
            progress_note("Not sent to your phone", f"{str(error)[:1].upper()}{str(error)[1:]}.", note)
        raise
    finally:
        if shot:
            with contextlib.suppress(OSError):
                os.unlink(shot)
    if cancelled:
        print(f"Sent to {answer['name']}, except {', '.join(cancelled)} (cancelled).")
        items = [item for item in items
                 if item["kind"] != "file" or os.path.basename(item["value"]) not in cancelled]
    else:
        print(f"Sent to {answer['name']}.")
    if opts.notify:
        progress_note(f"Sent to {answer['name']}", sent_names(items), note)
    return 0


def not_running_reason():
    """Why the daemon didn't answer, in words for a notification."""
    if live_session():
        return "phones can't connect in the live session"
    if not load_settings().enabled:
        return "the phone connection is off: turn it on in Settings > Phone"
    return "the phone connection isn't running"


def choose_files():
    """The files picked in GTK's file chooser; [] when it's cancelled. GTK is
    imported only here, so nothing else in this program needs it."""
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk
    except (ImportError, ValueError) as error:
        raise PhoneError(f"the file chooser needs GTK 3: {error}") from None
    dialog = Gtk.FileChooserDialog(title="Send Files to Phone", action=Gtk.FileChooserAction.OPEN)
    dialog.add_buttons("_Cancel", Gtk.ResponseType.CANCEL, "_Send", Gtk.ResponseType.ACCEPT)
    dialog.set_default_response(Gtk.ResponseType.ACCEPT)
    dialog.set_select_multiple(True)
    dialog.set_local_only(True)
    try:
        if dialog.run() != Gtk.ResponseType.ACCEPT:
            return []
        return [path for path in dialog.get_filenames() if os.path.isfile(path)]
    finally:
        dialog.destroy()
        while Gtk.events_pending():         # let the window go before sending
            Gtk.main_iteration()


def type_text():
    """A line typed into fuzzel (a box like the menu's, without a list);
    "" when it's cancelled."""
    if shutil.which("fuzzel") is None:
        raise PhoneError("fuzzel is not installed")
    result = subprocess.run(["fuzzel", "--dmenu", "--prompt-only", "Text to send: "],
                            stdin=subprocess.DEVNULL, capture_output=True, text=True, check=False)
    return result.stdout.strip() if result.returncode == 0 else ""


def take_screenshot():
    """The whole screen as a PNG in the runtime folder (deleted after sending)."""
    if shutil.which("grim") is None:
        raise PhoneError("grim is not installed")
    # The menu that asked for it has just closed: let it leave the screen.
    time.sleep(SCREENSHOT_DELAY)
    folder = runtime_dir()
    os.makedirs(folder, mode=0o700, exist_ok=True)
    path = os.path.join(folder, datetime.datetime.now().strftime("Screenshot %Y-%m-%d %H-%M-%S.png"))
    try:
        result = subprocess.run(["grim", path], capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise PhoneError(f"grim: {error}") from None
    if result.returncode != 0 or not os.path.isfile(path):
        raise PhoneError(f"the screenshot failed: {result.stderr.strip() or 'grim gave nothing'}")
    return path


def scan_host_keys(host, port):
    """The SSH host keys of the phone's file server. ssh-keyscan only reads
    them; it doesn't log in and it doesn't write the user's known hosts."""
    if shutil.which("ssh-keyscan") is None:
        raise PhoneError("the phone's identity couldn't be checked, so nothing was opened")
    argv = ["ssh-keyscan", "-T", str(KEYSCAN_SECONDS), "-p", str(port), "-t", "ecdsa,rsa,ed25519", "--", host]
    blobs = []
    for _ in range(2):
        try:
            result = subprocess.run(argv, capture_output=True, text=True, timeout=KEYSCAN_SECONDS + 5)
        except (OSError, subprocess.TimeoutExpired):
            result = None
        blobs = parse_keyscan("" if result is None else result.stdout)
        if blobs:
            break
        time.sleep(0.3)
    return blobs


def choose_phone_folder(folders):
    """The folder to open. The only one is that one; several are a fuzzel
    list of the names the phone gave. None when the list is cancelled."""
    if len(folders) == 1:
        return folders[0]
    if shutil.which("fuzzel") is None:
        raise PhoneError("fuzzel is not installed")
    result = subprocess.run(
        ["fuzzel", "--dmenu", "--index", "--prompt", "Folder: ", "--lines", str(len(folders))],
        input="\n".join(folder["name"].replace("\n", " ") for folder in folders) + "\n",
        capture_output=True, text=True, check=False)
    try:
        index = int(result.stdout.strip())
    except ValueError:
        return None
    if not 0 <= index < len(folders):
        return None
    return folders[index]


def drive_mount(argv, dialogue, seconds):
    """Run gio mount on a terminal, answering from dialogue. gio's prompts
    are in English (LC_ALL=C): the user never sees them, and another language
    would rename Choice and Password."""
    master, slave = pty.openpty()
    env = dict(os.environ)
    env["LC_ALL"] = "C"
    env["LANGUAGE"] = "C"
    try:
        proc = subprocess.Popen(argv, stdin=slave, stdout=slave, stderr=slave, env=env,
                                start_new_session=True, close_fds=True)
    except OSError as error:
        os.close(master)
        os.close(slave)
        raise PhoneError("the phone's files couldn't be opened") from error
    os.close(slave)
    deadline = time.monotonic() + seconds
    try:
        while True:
            if dialogue.failed:
                break
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise PhoneError("opening the phone's files took too long. Try again")
            if proc.poll() is not None:
                ready, _, _ = select.select([master], [], [], 0)
                if not ready:
                    break
            else:
                ready, _, _ = select.select([master], [], [], min(0.2, remaining))
                if not ready:
                    continue
            try:
                chunk = os.read(master, 4096)
            except OSError:
                break
            if not chunk:
                if proc.poll() is not None:
                    break
                continue
            reply = dialogue.feed(chunk.decode("utf-8", "replace"))
            if reply:
                with contextlib.suppress(OSError):
                    os.write(master, reply.encode())
        if dialogue.failed:
            raise PhoneError(NOT_THE_PHONE)
    finally:
        if proc.poll() is None:
            with contextlib.suppress(OSError):
                proc.kill()
        with contextlib.suppress(subprocess.TimeoutExpired, OSError):
            proc.wait(timeout=5)
        with contextlib.suppress(OSError):
            os.close(master)
    if proc.returncode not in (0, None) and "already mounted" not in dialogue.public().lower():
        raise PhoneError("the phone's files couldn't be opened. Try again")


def open_mounted_folder(uri):
    """Open a folder that is already mounted, in the file manager. gio open
    asks whatever handles folders. xdg-open would give the address to the
    web browser: on this desktop an address that isn't a file is a web page."""
    if shutil.which("gio") is None:
        raise PhoneError("the phone's files couldn't be opened")
    try:
        result = subprocess.run(["gio", "open", uri], check=False, timeout=MOUNT_SECONDS,
                                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=subprocess.PIPE, text=True)
    except subprocess.TimeoutExpired:
        raise PhoneError("opening the phone's files took too long. Try again")
    except OSError as error:
        raise PhoneError("the phone's files couldn't be opened") from error
    if result.returncode != 0:
        detail = result.stderr.strip()
        if detail:
            warn(detail)
        raise PhoneError("the phone's files couldn't be opened. Try again")


def open_phone_files(offer):
    """Check the phone's host key, mount the folder and open it. The folder's
    name, or None when the user cancels the list of folders."""
    if not files_available():
        raise PhoneError("opening the phone's files needs the file manager's network folders, "
                         "which aren't installed")
    try:
        expected = ssh_public_blob(cert_fields(paired_der(offer["id"]))[1])
    except (ProtocolError, OSError, TypeError):
        raise PhoneError("the phone's identity couldn't be checked, so nothing was opened") from None
    blobs = scan_host_keys(offer["host"], offer["port"])
    if not blobs or any(blob != expected for blob in blobs):
        raise PhoneError(NOT_THE_PHONE)
    folder = choose_phone_folder(offer["folders"])
    if folder is None:
        return None
    uri = sftp_uri(offer["host"], offer["port"], offer["user"], folder["path"])
    drive_mount(["gio", "mount", uri], MountDialogue(host_fingerprint(expected), offer["password"]),
                MOUNT_SECONDS)
    open_mounted_folder(uri)
    return folder["name"]


def said(error):
    """An error for a notification: a capital and a final period."""
    text = str(error)
    if text[:1].islower():
        text = text[:1].upper() + text[1:]
    return text if text.endswith(".") else text + "."


def cmd_browse(opts):
    """Open the phone's files in the file manager, only the folders it offers."""
    note = None
    try:
        if not files_available():
            raise PhoneError("opening the phone's files needs the file manager's network folders, "
                             "which aren't installed")
        if opts.notify:
            note = progress_note("Opening the phone's files…", "Asking the phone.")
        answer = request({"command": "browse", "to": opts.to}, timeout=SFTP_SECONDS + 20)
        if answer is None:
            raise PhoneError(not_running_reason())
        name = open_phone_files(answer)
        if name is None:
            if note:
                close_notification(note)
            return 0
    except (PhoneError, OSError, ValueError) as error:
        if opts.notify:
            progress_note("The phone's files weren't opened", said(error), note)
        raise PhoneError(str(error)) from None
    print(f"Opened {name} on {answer['name']}.")
    if opts.notify:
        progress_note(f"Opened {name}", f"On {answer['name']}.", note)
    return 0


def cmd_cancel(opts):
    """Stop a file on its way to or from a phone (the window's Cancel)."""
    answer = request({"command": "cancel", "id": opts.id}, timeout=10)
    if answer is None:
        raise PhoneError("the phone connection isn't running")
    print(f"Cancelled {answer['name']}.")
    return 0


def cmd_mute(opts):
    """Silence a ringing phone's ringer. The call goes on; the sound stops."""
    answer = request({"command": "mute", "to": opts.to}, timeout=10)
    if answer is None:
        raise PhoneError("the phone connection isn't running")
    print(f"Muted {answer['name']}'s ringer.")
    return 0


PLAYER_WORDS = {"play": "play", "pause": "pause", "play-pause": "play or pause",
                "next": "skip to the next", "previous": "go back"}


def cmd_player(opts):
    """Play, pause or skip what the phone plays, or set its volume (ADR-018).
    The player is the one the phone popup shows."""
    data = {"command": "player", "to": opts.to, "action": opts.action}
    if opts.action == "volume":
        if opts.percent is None or not opts.percent.isdigit() or int(opts.percent) > 100:
            raise PhoneError("player volume PERCENT: a number from 0 to 100")
        data["volume"] = int(opts.percent)
        words = f"set the volume to {int(opts.percent)}%"
    elif opts.percent is not None:
        raise PhoneError("only volume takes a number")
    else:
        words = PLAYER_WORDS[opts.action]
    answer = request(data, timeout=10)
    if answer is None:
        raise PhoneError("the phone connection isn't running")
    print(f"Asked {answer['player']} on {answer['name']} to {words}.")
    return 0


def cmd_ring(opts):
    """Ring the phone, even when it's silenced, until it's picked up."""
    try:
        answer = request({"command": "ring", "to": opts.to}, timeout=10)
        if answer is None:
            raise PhoneError("the phone connection isn't running")
    except (PhoneError, OSError, ValueError) as error:
        if opts.notify:
            progress_note("Your phone can't ring", f"{str(error)[:1].upper()}{str(error)[1:]}.")
        raise PhoneError(str(error)) from None
    print(f"{answer['name']} is ringing.")
    if opts.notify:
        progress_note(f"{answer['name']} is ringing", "Tap it on the phone to stop it.")
    return 0


def cmd_ping(opts):
    """A notification on the phone with TEXT, titled with this computer's name."""
    answer = request({"command": "ping", "to": opts.to, "text": opts.text}, timeout=10)
    if answer is None:
        raise PhoneError("the phone connection isn't running")
    print(f"Sent to {answer['name']}.")
    return 0


def sent_names(items):
    names = [os.path.basename(i["value"]) if i["kind"] == "file" else
             "the clipboard" if i["kind"] == "clipboard" else i["value"][:60] for i in items]
    return ", ".join(names[:3]) + (f" and {len(names) - 3} more" if len(names) > 3 else "")


def progress_note(title, body, replace=None):
    """A notification that replaces the one with id replace; its id."""
    argv = ["notify-send", "--app-name=Phone", "--icon=phone", "--print-id", title, body]
    if replace:
        argv.insert(1, f"--replace-id={replace}")
    try:
        result = subprocess.run(argv, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return replace
    return result.stdout.strip() or replace


def cmd_received(opts):
    items = read_received()
    if opts.json:
        print(json.dumps(items, ensure_ascii=False))
        return 0
    for item in items:
        when = datetime.datetime.fromtimestamp(item["time"]).strftime("%Y-%m-%d %H:%M")
        print(f"{when}\t{item['device']}\t{item['kind']}\t{item['value']}")
    return 0


def cmd_commands(opts):
    """Named commands the phone may run: list, add NAME COMMAND, remove KEY."""
    if opts.action == "list":
        for item in load_settings().commands:
            print(f"{item.key}\t{item.name}\t{item.command}")
        return 0
    settings = load_settings()
    if opts.action == "add":
        name, command = checked_command(opts.name, opts.command)
        if any(item.name == name for item in settings.commands):
            raise PhoneError(f"a command is already called {name}")
        if len(settings.commands) >= MAX_COMMANDS:
            raise PhoneError(f"at most {MAX_COMMANDS} commands")
        save_settings(commands=settings.commands + (Command(str(uuid.uuid4()), name, command),))
    else:
        if not any(item.key == opts.key for item in settings.commands):
            raise PhoneError("no command has that key")
        save_settings(commands=tuple(item for item in settings.commands if item.key != opts.key))
    with contextlib.suppress(PhoneError, OSError, ValueError):
        request({"command": "reload"}, timeout=10)
    return 0


def cmd_network(opts):
    settings = load_settings()
    if opts.action == "list":
        names, active = network_names(), active_networks() or []
        for uuid_ in settings.networks:
            here = "\tthis network" if uuid_ in active else ""
            print(f"{names.get(uuid_, '?')}\t{uuid_}{here}")
        return 0
    if opts.action == "add":
        added = [opts.uuid] if opts.uuid else (active_networks() or [])
        if not added:
            raise PhoneError("not connected to a Wi-Fi or wired network")
        networks = tuple(dict.fromkeys(settings.networks + tuple(added)))
    else:
        if not opts.uuid:
            raise PhoneError("network remove UUID")
        networks = tuple(n for n in settings.networks if n != opts.uuid)
    save_settings(networks=networks)
    with contextlib.suppress(PhoneError, OSError, ValueError):
        request({"command": "reload"}, timeout=10)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="flickos-phone",
                                     description="Send pages, files and text between a phone and this computer.")
    commands = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")
    commands.add_parser("daemon", help="the session daemon (autostart; only while on)").set_defaults(func=cmd_daemon)
    get = commands.add_parser("get", help="print a setting: enabled, name, networks, notifications, notification-apps, calls, media, commands")
    get.add_argument("key", choices=("enabled", "name", "networks", "notifications", "notification-apps", "calls", "media", "commands"))
    get.set_defaults(func=cmd_get)
    set_ = commands.add_parser("set", help="enabled yes|no|default, name NAME|default, "
                               "networks 'UUID ...'|default, notifications yes|no|default, "
                               "notification-apps 'one name per line'|default, calls yes|no|default, "
                               "media yes|no|default, commands JSON|default")
    set_.add_argument("key", choices=("enabled", "name", "networks", "notifications", "notification-apps", "calls", "media", "commands"))
    set_.add_argument("value")
    set_.set_defaults(func=cmd_set)
    notes = commands.add_parser("notifications", help="which apps may show notifications: list, allow NAME, block NAME")
    notes.add_argument("action", choices=("list", "allow", "block"))
    notes.add_argument("name", nargs="?")
    notes.set_defaults(func=cmd_notifications)
    run = commands.add_parser("commands", help="named commands the phone may run")
    run_action = run.add_subparsers(dest="action", required=True, metavar="ACTION")
    run_action.add_parser("list", help="key, name and command line").set_defaults(func=cmd_commands)
    add = run_action.add_parser("add", help="add one: NAME COMMAND (use -- before a command that starts with -)")
    add.add_argument("name")
    add.add_argument("command")
    add.set_defaults(func=cmd_commands)
    remove = run_action.add_parser("remove", help="remove the command with this key")
    remove.add_argument("key")
    remove.set_defaults(func=cmd_commands)
    status = commands.add_parser("status", help="on or off, running, connected phones")
    status.add_argument("--json", action="store_true")
    status.add_argument("--panel", action="store_true", help="the panel button's JSON (waybar)")
    commands.add_parser("menu", help="the panel button's menu (fuzzel)").set_defaults(func=cmd_menu)
    actions = commands.add_parser("actions", help="the actions the window, the popup and the menu share")
    actions.add_argument("--json", action="store_true", help="print them as JSON (the only form)")
    actions.add_argument("--to", metavar="ID", help="the phone, when more than one is paired")
    actions.set_defaults(func=cmd_actions)
    window = commands.add_parser("window", help="the Phone window")
    window.add_argument("--page", choices=WINDOW_PAGES, default="overview", help="the page to show")
    window.set_defaults(func=cmd_window)
    ring = commands.add_parser("ring", help="ring the phone, even when it's silenced")
    ring.add_argument("--to", metavar="ID", help="the phone, when more than one is connected")
    ring.add_argument("--notify", action="store_true", help="say what happened in a notification")
    ring.set_defaults(func=cmd_ring)
    mute = commands.add_parser("mute", help="silence a ringing phone's ringer")
    mute.add_argument("--to", metavar="ID", help="the phone, when more than one is connected")
    mute.set_defaults(func=cmd_mute)
    player = commands.add_parser("player", help="play, pause or skip what the phone plays, or set its volume")
    player.add_argument("action", choices=(*PHONE_PLAYER_ACTIONS, "volume"))
    player.add_argument("percent", nargs="?", help="the volume, 0 to 100 (only for volume)")
    player.add_argument("--to", metavar="ID", help="the phone, when more than one is connected")
    player.set_defaults(func=cmd_player)
    cancel = commands.add_parser("cancel", help="stop a file on its way to or from a phone")
    cancel.add_argument("id", help="the transfer's id, from `watch` or `state`")
    cancel.set_defaults(func=cmd_cancel)
    browse = commands.add_parser("browse", help="open the phone's files in the file manager")
    browse.add_argument("--to", metavar="ID", help="the phone, when more than one is connected")
    browse.add_argument("--notify", action="store_true", help="say what happened in a notification")
    browse.set_defaults(func=cmd_browse)
    status.set_defaults(func=cmd_status)
    ping = commands.add_parser("ping", help="show TEXT as a notification on the phone")
    ping.add_argument("text", nargs="?", default="")
    ping.add_argument("--to", metavar="ID", help="the phone, when more than one is connected")
    ping.set_defaults(func=cmd_ping)
    devices = commands.add_parser("devices", help="paired phones: name, id, connected")
    devices.add_argument("--json", action="store_true")
    devices.set_defaults(func=cmd_devices)
    pair = commands.add_parser("pair", help="let a phone pair: wait for it to ask, show its key")
    pair.add_argument("--json", action="store_true", help="events as JSON lines, the answer on stdin")
    pair.set_defaults(func=cmd_pair)
    commands.add_parser("state", help="everything the Settings page shows, as JSON").set_defaults(func=cmd_state)
    forget = commands.add_parser("forget", help="forget a paired phone")
    forget.add_argument("id")
    forget.set_defaults(func=cmd_forget)
    send = commands.add_parser("send", help="send files or addresses to the phone")
    send.add_argument("things", nargs="*", metavar="FILE|URL")
    send.add_argument("--to", metavar="ID", help="the phone, when more than one is connected")
    send.add_argument("--text", help="send this text")
    send.add_argument("--clipboard", action="store_true",
                      help="send the clipboard's text (a web address goes as a page)")
    send.add_argument("--screenshot", action="store_true", help="send a screenshot of the whole screen")
    send.add_argument("--choose", action="store_true", help="choose the files in a window")
    send.add_argument("--type-text", action="store_true", help="type the text to send in a box")
    send.add_argument("--notify", action="store_true", help="say what happened in a notification "
                      "(the file manager's Send to Phone)")
    send.set_defaults(func=cmd_send)
    received = commands.add_parser("received", help="what came from a phone recently")
    received.add_argument("--json", action="store_true")
    received.set_defaults(func=cmd_received)
    network = commands.add_parser("network", help="the networks where it listens: list, add [UUID], remove UUID")
    network.add_argument("action", choices=("list", "add", "remove"))
    network.add_argument("uuid", nargs="?")
    network.set_defaults(func=cmd_network)
    opts = parser.parse_args(argv)
    try:
        return opts.func(opts)
    except (PhoneError, OSError, ValueError) as error:
        warn(str(error))
        return 1
    except (KeyboardInterrupt, EOFError):
        return 1


if __name__ == "__main__":
    sys.exit(main())
