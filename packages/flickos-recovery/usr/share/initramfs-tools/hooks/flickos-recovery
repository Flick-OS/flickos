#!/bin/sh
# flickos-recovery: the overlay module for starting a restore point with a
# writable layer in memory (scripts/local-bottom/flickos-recovery).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in prereqs) prereqs; exit 0 ;; esac

. /usr/share/initramfs-tools/hook-functions
manual_add_modules overlay
