#!/usr/bin/make -f

# The tests import usr/bin/flickos-recovery; no bytecode next to installed files.
export PYTHONDONTWRITEBYTECODE = 1

%:
	dh $@

# Skipped with DEB_BUILD_OPTIONS=nocheck.
override_dh_auto_test:
	python3 -m unittest discover -s tests -v

# Enabled, started at none: they act only while the computer starts (starting
# `start begin` from an install would count a start that didn't happen), so
# --no-start is right here, and the preinst's stop at an upgrade is harmless
# (good-watch ends seconds after the login screen shows).
override_dh_installsystemd:
	dh_installsystemd --no-start flickos-recovery-start.service flickos-recovery-good.service \
		flickos-recovery-settle.service
