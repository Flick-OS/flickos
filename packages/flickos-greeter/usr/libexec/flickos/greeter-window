class GreeterError(Exception):
    """An expected failure, shown as one line."""


def warn(text):
    print(f"{NAME}: {text}", file=sys.stderr, flush=True)


# --- users ----------------------------------------------------------------------------

def login_defs(path=None):
    """(UID_MIN, UID_MAX) from login.defs, UID_RANGE where it doesn't say."""
    low, high = UID_RANGE
    with contextlib.suppress(OSError, UnicodeDecodeError):
        with open(path or LOGIN_DEFS, encoding="utf-8") as f:
            for line in f:
                words = line.split()
                if len(words) >= 2 and words[0] in ("UID_MIN", "UID_MAX"):
                    with contextlib.suppress(ValueError):
                        if words[0] == "UID_MIN":
                            low = int(words[1])
                        else:
                            high = int(words[1])
    return low, high


def display_name(entry):
    """The full name of a passwd entry (GECOS up to the first comma), else the login name."""
    return entry.pw_gecos.split(",")[0].strip() or entry.pw_name


def users(entries, uid_range):
    """The passwd entries to list, by full name."""
    low, high = uid_range
    found = [e for e in entries if low <= e.pw_uid <= high
             and os.path.basename(e.pw_shell or "") not in NO_SHELLS]
    return sorted(found, key=lambda e: (display_name(e).casefold(), e.pw_name))


def picture_file(name):
    """accountsservice's picture of a user, or None: home folders are 0700,
    so ~/.face isn't readable here (G4)."""
    path = os.path.join(ICONS_DIR, name)
    return path if os.path.isfile(path) and os.access(path, os.R_OK) else None


def initial(entry):
    """The letter on a user's circle without a picture."""
    return display_name(entry)[:1].upper() or "?"


# --- sessions --------------------------------------------------------------------------

def sessions(folder=None):
    """[(id, name, command, XDG_SESSION_DESKTOP, XDG_CURRENT_DESKTOP)]:
    SESSIONS, then the other desktop files in the folder by name."""
    found = [(key, *value) for key, value in SESSIONS.items()]
    folder = folder or SESSIONS_DIR
    with contextlib.suppress(OSError):
        names = sorted(os.listdir(folder))
        others = []
        for name in names:
            if not name.endswith(".desktop") or name in HIDDEN_SESSIONS:
                continue
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            parser.optionxform = str
            try:
                parser.read(os.path.join(folder, name), encoding="utf-8")
                entry = parser["Desktop Entry"]
            except (configparser.Error, KeyError, UnicodeDecodeError):
                continue
            if entry.get("Hidden") == "true" or entry.get("NoDisplay") == "true":
                continue
            try_exec = entry.get("TryExec", "")
            if try_exec and not shutil.which(try_exec):
                continue
            words = session_words(entry.get("Exec", ""))
            if not words:
                continue
            desktops = entry.get("DesktopNames", "").strip(";").replace(";", ":")
            others.append((name[:-len(".desktop")], entry.get("Name", name), shlex.join(words),
                           name[:-len(".desktop")], desktops))
        found += sorted(others, key=lambda s: s[1].casefold())
    return found


def session_words(command):
    """A desktop file's Exec as an argument list, field codes (%f…) left out."""
    try:
        return [word for word in shlex.split(command) if not re.fullmatch(r"%[a-zA-Z]", word)]
    except ValueError:
        return []


def session_request(session):
    """greetd's start_session for a session: the command is the session's,
    never anything typed (ADR-004)."""
    _id, _name, command, desktop, current = session
    env = ["XDG_SESSION_TYPE=wayland", f"XDG_SESSION_DESKTOP={desktop}"]
    if current:
        env.append(f"XDG_CURRENT_DESKTOP={current}")
    return {"type": "start_session", "cmd": shlex.split(command), "env": env}


def find_session(found, key):
    """The session with this id, else FlickOS (a session that went away)."""
    return next((s for s in found if s[0] == key), None) or next(s for s in found if s[0] == DEFAULT_SESSION)


# --- the administrator's choices -----------------------------------------------------

def read_config(paths=None):
    """{"background": FILE or None, "position": PLACE} from CONF_FILES:
    KEY=value lines, # starts a comment, the later file wins. A missing or
    broken file, or a value that can't be, is the default (SET-4)."""
    found = {"background": None, "position": DEFAULT_POSITION}
    for path in paths or CONF_FILES:
        try:
            with open(path, encoding="utf-8") as f:
                lines = f.read().splitlines()
        except FileNotFoundError:
            continue
        except (OSError, UnicodeDecodeError) as error:
            warn(f"{path}: {error}")
            continue
        for line in lines:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = (part.strip() for part in line.split("=", 1))
            value = value.strip("\"'")
            if key == "Background":
                found["background"] = value if os.path.isabs(value) else None
            elif key == "Position":
                if value in POSITIONS:
                    found["position"] = value
                else:
                    warn(f"{path}: Position={value}: not one of {', '.join(POSITIONS)}")
    return found


def background_file(config):
    """The picture to draw: the chosen one while it can be read and is a PNG
    or a JPEG, else the Dark wallpaper (ADR-014)."""
    chosen = config.get("background")
    if not chosen:
        return WALLPAPER
    path = PREFIX + chosen if PREFIX else chosen
    if not os.path.isfile(path):            # also never a FIFO or a device: open() could wait
        warn(f"Background={chosen}: not a file: the Dark wallpaper instead")
        return WALLPAPER
    try:
        with open(path, "rb") as f:
            start = f.read(8)
    except OSError as error:
        warn(f"Background={chosen}: {error.strerror}: the Dark wallpaper instead")
        return WALLPAPER
    if not start.startswith(PICTURE_MAGIC):
        warn(f"Background={chosen}: not a PNG or JPEG picture: the Dark wallpaper instead")
        return WALLPAPER
    return path


# --- what is remembered -------------------------------------------------------------

def read_state(path=None):
    """{"last": NAME, "sessions": {NAME: ID}, "zoom": PERCENT}; a missing or
    broken file is empty."""
    try:
        with open(path or STATE, encoding="utf-8") as f:
            state = json.load(f)
    except (OSError, ValueError):
        state = None
    if not isinstance(state, dict):
        return {"last": None, "sessions": {}, "zoom": ZOOM_STEPS[0]}
    sessions_ = state.get("sessions")
    return {"last": state.get("last") if isinstance(state.get("last"), str) else None,
            "sessions": {k: v for k, v in sessions_.items() if isinstance(k, str) and isinstance(v, str)}
            if isinstance(sessions_, dict) else {},
            "zoom": state.get("zoom") if state.get("zoom") in ZOOM_STEPS else ZOOM_STEPS[0]}


def remember(name, session_id, zoom, path=None):
    """After greetd accepted the session: the last user, their session and
    the zoom, written atomically (SET-6) in a folder only _greetd reads."""
    path = path or STATE
    state = read_state(path)
    state["last"] = name
    state["sessions"][name] = session_id
    state["zoom"] = zoom
    folder = os.path.dirname(path)
    os.makedirs(folder, mode=0o700, exist_ok=True)
    temporary = os.path.join(folder, f".{os.path.basename(path)}.{os.getpid()}.tmp")
    with open(temporary, "w", encoding="utf-8") as f:
        json.dump(state, f)
        f.write("\n")
    os.replace(temporary, path)


# --- the clock ----------------------------------------------------------------------

def clock_format(t_fmt):
    """flickos-lock's 12h or 24h format, as the system's locale writes times
    (en_US's T_FMT is %r, en_GB's and de_DE's %T)."""
    return CLOCK_FORMATS["12h" if TWELVE_HOUR.search(t_fmt or "") else "24h"]


# --- zoom ---------------------------------------------------------------------------

def next_zoom(current, step):
    """The zoom after Super+= (step 1), Super+- (-1) or Super+0 (0)."""
    if step == 0:
        return ZOOM_STEPS[0]
    index = min(range(len(ZOOM_STEPS)), key=lambda i: abs(ZOOM_STEPS[i] - current))
    return ZOOM_STEPS[max(0, min(len(ZOOM_STEPS) - 1, index + step))]


def zoom_css(percent):
    """On the whole window, so the bottom row and the menus grow with the card."""
    return f".flickos-greeter {{ font-size: {percent}%; }}\n"


# --- power --------------------------------------------------------------------------

class TwoStep:
    """Which power button waits for its second click (CONFIRM). GTK-free:
    show_armed shows it, and it is disarmed after CONFIRM_SECONDS."""

    def __init__(self):
        self.armed = None

    def click(self, item_id):
        """"arm" for the first click of a CONFIRM item, else "run"; a click on
        any other button disarms the armed one."""
        if item_id in CONFIRM and item_id != self.armed:
            self.armed = item_id
            return "arm"
        self.armed = None
        return "run"

    def disarm(self):
        self.armed = None


def blocked_by(inhibitors):
    """(who, why) of the first block inhibitor of a shutdown, or None, from
    logind's ListInhibitors: (what, who, why, mode, uid, pid) with WHAT a
    colon-separated list."""
    for what, who, why, mode, _uid, _pid in inhibitors:
        if mode == "block" and "shutdown" in what.split(":"):
            return who, why
    return None


# --- the keyboard layout ------------------------------------------------------------

def xkb_names(root):
    """From evdev.xml's root: {(layout, variant): (short name, name)} and
    {option: name}. A variant without a short name has its layout's."""
    layouts, options = {}, {}
    for layout in root.iterfind("layoutList/layout"):
        name = layout.findtext("configItem/name")
        short = layout.findtext("configItem/shortDescription") or name
        layouts[(name, "")] = (short, layout.findtext("configItem/description") or name)
        for variant in layout.iterfind("variantList/variant"):
            layouts[(name, variant.findtext("configItem/name"))] = (
                variant.findtext("configItem/shortDescription") or short,
                variant.findtext("configItem/description") or name)
    for option in root.iterfind("optionList/group/option"):
        options[option.findtext("configItem/name")] = option.findtext("configItem/description")
    return layouts, options


def keyboard(layout, variant, options, path=None):
    """([(short name, name)] of cage's layouts, the key that switches them)
    from XKB_DEFAULT_*: nothing with a single layout, which needs no label.
    The names are xkeyboard-config's, in its translations; a layout or option
    its rules don't know shows as it is written."""
    codes = [code.strip() for code in layout.split(",")]
    if len(codes) < 2:
        return [], ""
    import xml.etree.ElementTree                  # only with two layouts: the usual start needs none
    try:
        names, option_names = xkb_names(xml.etree.ElementTree.parse(path or XKB_RULES).getroot())
    except (OSError, xml.etree.ElementTree.ParseError) as error:
        warn(f"can't read the keyboard layouts' names ({error})")
        names, option_names = {}, {}
    variants = [word.strip() for word in variant.split(",")] + [""] * len(codes)
    found = []
    for code, word in zip(codes, variants):
        short, name = names.get((code, word)) or names.get((code, "")) or (code, code)
        found.append((short.upper(), gettext.dgettext("xkeyboard-config", name)))
    option = next((word.strip() for word in options.split(",") if word.strip().startswith("grp:")), "")
    key = option_names.get(option) or option.removeprefix("grp:")
    return found, gettext.dgettext("xkeyboard-config", key) if key else ""


def group_after(name, shown, group, count):
    """The layout to show after a key press: GDK's GROUP, which it learns
    only at the next key, so a key that switches layouts moves SHOWN on
    instead (G6). A group it can't be is left out: the first key's can be
    anything."""
    if name == "ISO_Next_Group":
        return (shown + 1) % count
    if name == "ISO_Prev_Group":
        return (shown - 1) % count
    if name == "ISO_First_Group":
        return 0
    if name == "ISO_Last_Group":
        return count - 1
    return group if group < count else shown


# --- screens -----------------------------------------------------------------------

def builtin_sizes(folder=None):
    """[(width mm, height mm)] of the connected built-in screens, from their
    EDID (bytes 21 and 22, in cm): GTK 3 has no connector names (G2)."""
    found = []
    folder = folder or DRM_DIR
    with contextlib.suppress(OSError):
        for name in sorted(os.listdir(folder)):
            connector = name.split("-", 1)[1] if name.startswith("card") and "-" in name else ""
            if not connector.startswith(BUILTIN_CONNECTORS):
                continue
            try:
                with open(os.path.join(folder, name, "status"), encoding="ascii") as f:
                    if f.read().strip() != "connected":
                        continue
                with open(os.path.join(folder, name, "edid"), "rb") as f:
                    edid = f.read(128)
            except (OSError, UnicodeDecodeError):
                continue
            if len(edid) >= 23 and edid[21] and edid[22]:
                found.append((edid[21] * 10, edid[22] * 10))
    return found


def choose_monitor(sizes, builtin):
    """The index of the monitor for the card: the one whose size (mm) matches
    a built-in screen's; the first when none or more than one does."""
    matches = [index for index, (width, height) in enumerate(sizes)
               if any(abs(width - w) <= MM_TOLERANCE and abs(height - h) <= MM_TOLERANCE
                      for w, h in builtin)]
    return matches[0] if len(matches) == 1 else 0


def card_position(monitors, chosen, size, place=DEFAULT_POSITION):
    """(x, y) in the window of a child of SIZE on monitor CHOSEN, its middle
    at a quarter, a half or three quarters of the screen's width (PLACE,
    ADR-015), centered from top to bottom. Left and right keep MARGIN from
    the screen's edge, or are in the middle when the card is wider. MONITORS are (x, y, width, height); cage's window
    covers them all, from their top-left corner."""
    left = min(m[0] for m in monitors)
    top = min(m[1] for m in monitors)
    x, y, width, height = monitors[chosen]
    if place in ("left", "right") and size[0] + 2 * MARGIN <= width:
        offset = (width * POSITIONS[place] - 2 * size[0]) // 4
        offset = max(min(offset, width - size[0] - MARGIN), MARGIN)
    else:                                   # also a card wider than its screen
        offset = (width - size[0]) // 2
    return (max(0, x - left + offset), max(0, y - top + (height - size[1]) // 2))


def bottom_position(monitors, chosen, size):
    """(x, y) of the session button: the bottom-left corner of monitor CHOSEN."""
    left = min(m[0] for m in monitors)
    top = min(m[1] for m in monitors)
    x, y, _width, height = monitors[chosen]
    return (x - left + MARGIN, max(0, y - top + height - size[1] - MARGIN))


def corner_position(monitors, chosen, size):
    """(x, y) of the layout and power buttons: the bottom-right corner of
    monitor CHOSEN."""
    left = min(m[0] for m in monitors)
    top = min(m[1] for m in monitors)
    x, y, width, height = monitors[chosen]
    return (max(0, x - left + width - size[0] - MARGIN), max(0, y - top + height - size[1] - MARGIN))


# --- greetd -------------------------------------------------------------------------

class Greetd:
    """greetd-ipc: a 32-bit length in native byte order, then UTF-8 JSON, both ways."""

    def __init__(self, path=None, sock=None):
        if sock is None:
            path = path or os.environ.get("GREETD_SOCK")
            if not path:
                raise GreeterError("GREETD_SOCK is not set: greetd starts the login screen")
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                sock.connect(path)
            except OSError as error:
                sock.close()
                raise GreeterError(f"can't reach greetd at {path} ({error.strerror})") from None
        self.sock = sock

    def _read(self, size):
        data = b""
        while len(data) < size:
            chunk = self.sock.recv(size - len(data))
            if not chunk:
                raise GreeterError("greetd closed the connection")
            data += chunk
        return data

    def call(self, request):
        payload = json.dumps(request).encode("utf-8")
        self.sock.sendall(struct.pack("=I", len(payload)) + payload)
        size, = struct.unpack("=I", self._read(4))
        return json.loads(self._read(size).decode("utf-8"))


class Conversation:
    """One login: what to send greetd next, and what to show, for each reply
    (ADR-004). greetd's messages lead; nothing assumes how many there are.

    The typed password answers PAM's first secret prompt; anything after it
    is asked on the card. After an auth_error the session is cancelled, so
    the next try starts clean (greetd answers that cancel with an error that
    still clears its state, G1). Events: ("ask", "secret"|"visible", text),
    ("info", text), ("wrong",), ("expired",), ("denied",), ("error", text),
    ("started",), None."""

    def __init__(self, name, password, session):
        self.name, self.password, self.session = name, password, session
        self.password_used = False
        self.waiting = None                  # the prompt the card shows, while it waits
        self.finished = False

    def first(self):
        return {"type": "create_session", "username": self.name}

    def answer(self, text):
        """The card's answer to the prompt it showed."""
        self.waiting = None
        return {"type": "post_auth_message_response", "response": text}

    def cancel(self):
        self.finished = True
        return {"type": "cancel_session"}

    def reply(self, request, reply):
        """(next request or None, event or None) for greetd's REPLY to REQUEST."""
        kind = reply.get("type")
        if request["type"] == "cancel_session":
            self.finished = True
            return None, None
        if kind == "auth_message":
            message_type, text = reply.get("auth_message_type"), reply.get("auth_message", "")
            if message_type == "secret" and not self.password_used:
                self.password_used = True
                return self.answer(self.password), None
            if message_type in ("secret", "visible"):
                self.waiting = message_type
                return None, ("ask", message_type, text)
            return {"type": "post_auth_message_response"}, ("info", text)
        if kind == "success":
            if request["type"] == "start_session":
                self.finished = True
                return None, ("started",)
            return session_request(self.session), None
        description = reply.get("description", "")
        if reply.get("error_type") == "auth_error":
            if "NEW_AUTHTOK_REQD" in description:
                event = ("expired",)
            elif description.startswith("pam_authenticate"):
                event = ("wrong",)
            else:
                event = ("denied",)
        else:
            event = ("error", description)
        return self.cancel(), event


