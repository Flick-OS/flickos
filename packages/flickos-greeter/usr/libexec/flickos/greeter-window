    # Reading users, pictures, sessions and the state, off the main loop.

    def read(self, sizes):
        found = users(pwd.getpwall(), login_defs())
        pictures = {}
        size = PICTURE_PIXELS * ZOOM_STEPS[-1] // 100      # sharp at every zoom, in the list too
        for entry in found:
            path = picture_file(entry.pw_name)
            if path:
                with contextlib.suppress(self.GLib.Error):
                    pictures[entry.pw_name] = self.GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True)
        result = (found, pictures, sessions(), read_state(), builtin_sizes(), keyboard_from_environment())
        self.GLib.idle_add(self.have_read, result)
        self.load_wallpaper(sizes)

    def have_read(self, result):
        self.users, self.pictures, self.sessions, self.state, self.builtin, (self.layouts, self.switch_key) = result
        for entry in [*self.users, None]:
            self.user_list.add(self.user_row(entry))
        self.user_list.show_all()
        self.fill_session_menu()
        self.set_zoom(self.state["zoom"])
        self.show_layout()
        last = next((e for e in self.users if e.pw_name == self.state["last"]), None)
        if last:
            self.pick(last)
        else:
            self.show_list()
        self.place_later()
        return False

    def load_wallpaper(self, sizes):
        """The chosen picture or the Dark wallpaper (ADR-014), decoded at the
        size it covers the largest screen at, never larger than the file
        (G8). A chosen picture that can't be decoded: the Dark wallpaper."""
        chosen = background_file(self.config)
        for path in dict.fromkeys((chosen, WALLPAPER)):
            pixbuf = self.decode_wallpaper(path, sizes)
            if pixbuf is not None:
                self.GLib.idle_add(self.wallpaper_loaded, pixbuf)
                return

    def decode_wallpaper(self, path, sizes):
        GdkPixbuf = self.GdkPixbuf
        try:
            _info, width, height = GdkPixbuf.Pixbuf.get_file_info(path)
            if not width:
                warn(f"{path}: not a picture")
                return None
            need = max((max(w / width, h / height) for w, h in sizes), default=1.0)
            scale = min(1.0, need)
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, max(1, round(width * scale)),
                                                           max(1, round(height * scale)), True)
        except (self.GLib.Error, TypeError) as error:
            warn(f"{path}: {getattr(error, 'message', error)}")
            return None

    def wallpaper_loaded(self, pixbuf):
        self.wallpaper = pixbuf
        self.area.queue_draw()
        return False

    # Screens: where the card and the bottom row go.

    def monitors(self):
        display = self.Gdk.Display.get_default()
        found = []
        for index in range(display.get_n_monitors()):
            monitor = display.get_monitor(index)
            geometry = monitor.get_geometry()
            found.append((geometry.x, geometry.y, geometry.width, geometry.height,
                          monitor.get_width_mm(), monitor.get_height_mm()))
        return [m for m in found if m[2] > 0 and m[3] > 0]   # a new monitor has no size yet (G2)

    def monitor_sizes(self):
        display = self.Gdk.Display.get_default()
        return [(m[2] * display.get_monitor(i).get_scale_factor(), m[3] * display.get_monitor(i).get_scale_factor())
                for i, m in enumerate(self.monitors())]

    def on_monitor_added(self, _display, monitor):
        monitor.connect("notify::geometry", lambda *_a: self.screens_changed())
        self.screens_changed()

    def screens_changed(self):
        self.area.queue_draw()
        self.set_zoom(self.zoom)            # the pictures' limit is the screen's

    def place_later(self):
        self.GLib.idle_add(self.place)

    def card_screen(self):
        """(the screens' rectangles, the index of the card's), or ([], 0)."""
        monitors = self.monitors()
        if not monitors:
            return [], 0
        return [m[:4] for m in monitors], choose_monitor([(m[4], m[5]) for m in monitors], self.builtin)

    def fit_clock(self, height):
        """At a big zoom on a small screen the card can't hold everything:
        the clock and date go first, so the password box stays on the screen.
        A hidden label measures 0, so their room is kept from when they showed."""
        _minimum, natural = self.card.get_preferred_size()
        used = natural.height - self.card.get_margin_top() - self.card.get_margin_bottom()
        labels = (self.clock, self.date)
        if self.clock.get_visible():
            self.clock_room[self.zoom] = sum(label.get_preferred_height()[1] + CARD_SPACING for label in labels)
        else:
            used += self.clock_room[self.zoom]
        for label in labels:
            label.set_visible(used <= height)

    def place(self):
        rectangles, chosen = self.card_screen()
        if not rectangles:
            return False
        self.fit_clock(rectangles[chosen][3])
        row = ROW_PIXELS * self.zoom // 100
        rows = max(2, min(LIST_MAX, (rectangles[chosen][3] - 6 * row) // row))
        if self.scroller.get_max_content_height() != rows * row:
            self.scroller.set_max_content_height(rows * row)
        place = self.config["position"]
        for child, position in ((self.card, lambda *a: card_position(*a, place)), (self.bottom, bottom_position),
                                (self.corner, corner_position)):
            _minimum, natural = child.get_preferred_size()     # margins included: taken off
            size = (natural.width - child.get_margin_start() - child.get_margin_end(),
                    natural.height - child.get_margin_top() - child.get_margin_bottom())
            where = position(rectangles, chosen, size)
            if (child.get_margin_start(), child.get_margin_top()) != where:
                child.set_margin_start(where[0])
                child.set_margin_top(where[1])
        return False

    def draw_background(self, widget, cr):
        """The wallpaper covering each screen, under DIM of the theme's
        background; the background alone until it is loaded."""
        _found, bg = widget.get_style_context().lookup_color("theme_bg_color")
        cr.set_source_rgba(bg.red, bg.green, bg.blue, 1)
        cr.paint()
        pixbuf = self.wallpaper
        monitors = self.monitors()
        if pixbuf is None or not monitors:
            return False
        left, top = min(m[0] for m in monitors), min(m[1] for m in monitors)
        for x, y, width, height, _w, _h in monitors:
            scale = max(width / pixbuf.get_width(), height / pixbuf.get_height())
            cr.save()
            cr.rectangle(x - left, y - top, width, height)
            cr.clip()
            cr.translate(x - left + (width - pixbuf.get_width() * scale) / 2,
                         y - top + (height - pixbuf.get_height() * scale) / 2)
            cr.scale(scale, scale)
            self.Gdk.cairo_set_source_pixbuf(cr, pixbuf, 0, 0)
            cr.paint()
            cr.restore()
        cr.set_source_rgba(bg.red, bg.green, bg.blue, DIM)
        cr.paint()
        return False

    # Sessions.

    def fill_session_menu(self):
        Gtk = self.Gtk
        menu = Gtk.Menu()
        menu.get_style_context().add_class("flickos-greeter")     # a window of its own: for the zoom
        group = None
        for session in self.sessions:
            item = Gtk.RadioMenuItem.new_with_label_from_widget(group, _(session[1]))
            group = group or item
            item.set_active(session[0] == self.session[0])
            item.connect("toggled", lambda i, s=session: i.get_active() and self.set_session(s))
            menu.append(item)
        menu.show_all()
        self.session_button.set_popup(menu)
        self.session_menu = menu

    def set_session(self, session):
        self.session = session
        other = session[0] != DEFAULT_SESSION
        self.session_label.set_text(_(session[1]) if other else "")
        self.session_label.set_visible(other)            # WIN-9: only when it isn't FlickOS
        for item in self.session_menu.get_children():
            if item.get_label() == _(session[1]) and not item.get_active():
                item.set_active(True)
        self.place_later()

    # The two pages.

    def show_list(self):
        self.end_conversation()
        self.say("")
        self.stack.set_visible_child_name("list")
        row = next((r for r in self.user_list.get_children()
                    if self.user is not None and r.entry is not None and r.entry.pw_name == self.user.pw_name), None)
        row = row or self.user_list.get_row_at_index(0)
        if row:
            self.user_list.select_row(row)
            row.grab_focus()
        self.place_later()

    def pick(self, entry):
        """A user from the list (None: Someone Else): the password box."""
        self.end_conversation()
        self.user = entry
        self.entry.set_text("")
        self.set_shown(False)
        self.say("")
        self.someone.set_visible(entry is None)
        self.face.area.set_visible(entry is not None)
        self.name.set_visible(entry is not None)
        self.name_entry.set_visible(entry is None)
        self.name_entry.set_text("")
        if entry is not None:
            self.face.show(self.pictures.get(entry.pw_name), initial(entry))
            self.name.set_text(display_name(entry))
            self.set_session(find_session(self.sessions, self.state["sessions"].get(entry.pw_name)))
        else:
            self.set_session(find_session(self.sessions, DEFAULT_SESSION))
        self.stack.set_visible_child_name("picked")
        (self.name_entry if entry is None else self.entry).grab_focus()
        self.place_later()

    # Logging in (ADR-004).

    def log_in(self):
        if self.busy_now:
            return
        if self.conversation is not None and self.conversation.waiting:
            self.send(self.conversation.answer(self.entry.get_text()))
            return
        name = self.user.pw_name if self.user is not None else self.name_entry.get_text().strip()
        if not name:
            self.say(_(TEXT["no name"]))
            self.name_entry.grab_focus()
            return
        self.conversation = Conversation(name, self.entry.get_text(), self.session)
        self.say(_(TEXT["checking"]))
        self.send(self.conversation.first())

    def end_conversation(self):
        """Another user, or back to the list, halfway through a login."""
        conversation, self.conversation = self.conversation, None
        if conversation is not None and not conversation.finished:
            request = conversation.cancel()
            threading.Thread(target=self.call_quietly, args=(request,), daemon=True).start()

    def call_quietly(self, request):
        with contextlib.suppress(OSError, GreeterError, ValueError):
            self.greetd.call(request)

    def send(self, request):
        self.busy(True)
        conversation = self.conversation

        def run():
            try:
                reply = self.greetd.call(request)
            except (OSError, GreeterError, ValueError) as error:
                reply = {"type": "error", "error_type": "error", "description": str(error)}
            self.GLib.idle_add(self.replied, conversation, request, reply)
        threading.Thread(target=run, daemon=True).start()

    def replied(self, conversation, request, reply):
        if conversation is not self.conversation:
            return False                    # given up while greetd answered
        following, event = conversation.reply(request, reply)
        if event:
            self.show_event(event)
        if following is not None:
            self.send(following)
        else:
            self.busy(False)
            if conversation.finished and not self.started:
                self.conversation = None
                self.entry.grab_focus()
        return False

    def show_event(self, event):
        kind = event[0]
        if kind == "ask":
            _kind, how, text = event
            self.entry.set_text("")
            self.set_shown(how == "visible")
            self.say("" if text.strip() == PASSWORD_PROMPT else pam_text(text.strip()))
        elif kind == "info":
            self.say(pam_text(event[1].strip()))
        elif kind == "started":
            self.started = True
            name = self.conversation.name
            with contextlib.suppress(OSError):
                remember(name, self.session[0], self.zoom)
            self.Gtk.main_quit()
        else:
            self.entry.set_text("")
            self.set_shown(False)
            if kind == "error":
                warn(f"greetd: {event[1]}")
                self.say(_(TEXT["error"]).format(error=event[1]))
            else:
                self.say(_(TEXT[kind]))

    def busy(self, busy):
        self.busy_now = busy
        for widget in (self.entry, self.go, self.name_entry, self.back):
            widget.set_sensitive(not busy)
        self.spinner.set_visible(busy)
        (self.spinner.start if busy else self.spinner.stop)()

    def say(self, text):
        self.message.set_text(text)
        self.message.set_visible(bool(text))

    # Showing the password, Caps Lock.

    def set_eye(self):
        position = self.Gtk.EntryIconPosition.SECONDARY
        self.entry.set_icon_from_icon_name(position, "view-conceal-symbolic" if self.shown
                                           else "view-reveal-symbolic")
        self.entry.set_icon_tooltip_text(position, _(TEXT["hide"] if self.shown else TEXT["show"]))

    def set_shown(self, shown):
        self.shown = shown
        self.entry.set_visibility(shown)
        self.set_eye()
        if self.reveal_timer:
            self.GLib.source_remove(self.reveal_timer)
            self.reveal_timer = None
        if shown:
            self.reveal_timer = self.GLib.timeout_add_seconds(REVEAL_SECONDS, self.hide_after_wait)

    def hide_after_wait(self):
        self.reveal_timer = None
        self.set_shown(False)
        return False

    def show_caps(self):
        on = self.Gdk.Keymap.get_for_display(self.Gdk.Display.get_default()).get_caps_lock_state()
        self.caps.set_visible(on)

    # Shut Down and Restart (ADR-009).

    def power_click(self, item):
        if self.step.click(item[0]) == "arm":
            self.show_armed()
            if self.step_timer is not None:
                self.GLib.source_remove(self.step_timer)
            self.step_timer = self.GLib.timeout_add_seconds(CONFIRM_SECONDS, self.step_timeout)
            return
        self.disarm()
        self.power_menu.popdown()
        self.power_button.set_sensitive(False)     # logind takes it from here, or answers power_refused
        self.say(_(TEXT[f"going {item[0]}"]))
        self.bus.call(LOGIND[0], LOGIND[1], LOGIND[2], item[3], self.GLib.Variant("(b)", (False,)), None,
                      self.Gio.DBusCallFlags.NONE, -1, None, self.power_answered, item)

    def power_answered(self, bus, result, item):
        try:
            bus.call_finish(result)
        except self.GLib.Error as error:
            warn(f"logind refused {item[3]}: {error.message}")
            bus.call(LOGIND[0], LOGIND[1], LOGIND[2], "ListInhibitors", None, None,
                     self.Gio.DBusCallFlags.NONE, -1, None, self.power_refused, (item, error.message))

    def power_refused(self, bus, result, refusal):
        """What logind refused for: another user's block inhibitor (G3), or
        whatever it said."""
        (key, *_rest), message = refusal
        try:
            blocked = blocked_by(bus.call_finish(result).unpack()[0])
        except self.GLib.Error:
            blocked = None
        self.power_button.set_sensitive(True)
        if blocked:
            self.say(_(TEXT[f"blocked {key}"]).format(who=blocked[0], why=blocked[1]))
        else:
            self.say(_(TEXT[f"failed {key}"]).format(error=message))

    def step_timeout(self):
        self.step_timer = None
        self.disarm()
        return False                        # GLib timeout: once

    def disarm(self):
        if self.step_timer is not None:
            self.GLib.source_remove(self.step_timer)
            self.step_timer = None
        self.step.disarm()
        self.show_armed()

    def show_armed(self):
        for key, (button, label, text) in self.power_items.items():
            context = button.get_style_context()
            if key == self.step.armed:
                context.add_class("destructive-action")
                label.set_text(_(CONFIRM[key]))
            else:
                context.remove_class("destructive-action")
                label.set_text(text)

    # The keyboard layout (ADR-009).

    def show_layout(self):
        if not self.layouts:
            return
        short, name = self.layouts[self.group]
        text = (_(TEXT["layout key"]).format(layout=name, key=self.switch_key) if self.switch_key
                else _(TEXT["layout"]).format(layout=name))
        self.layout_label.set_text(short)
        self.layout_text.set_text(text)
        self.layout_button.set_tooltip_text(text)
        self.layout_button.show()

    def set_group(self, group):
        if group != self.group:
            self.group = group
            self.show_layout()

    # Zoom (ADR-007).

    def set_zoom(self, percent):
        self.zoom = percent
        self.zoom_provider.load_from_data(zoom_css(percent).encode())
        if percent not in self.clock_room:  # shown once to measure it (fit_clock)
            self.clock.show()
            self.date.show()
        rectangles, chosen = self.card_screen()
        limit = rectangles[chosen][3] // PICTURE_SHARE if rectangles else PICTURE_PIXELS
        for setter, size in self.zoomed:
            setter(min(size * percent // 100, max(size, limit)))
        self.place_later()

    def on_scroll(self, _window, event):
        Gdk = self.Gdk
        if not event.state & (Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.MOD4_MASK):
            return False
        if event.direction == Gdk.ScrollDirection.UP:
            step = 1
        elif event.direction == Gdk.ScrollDirection.DOWN:
            step = -1
        elif event.direction == Gdk.ScrollDirection.SMOOTH and event.delta_y:
            step = -1 if event.delta_y > 0 else 1
        else:
            return True
        self.set_zoom(next_zoom(self.zoom, step))
        return True

    # Keys (ADR-011).

    def on_key_release(self, _window, event):
        """The key that switched layouts, let go: GDK has the new group by now."""
        if self.layouts:
            self.set_group(group_after("", self.group, event.group, len(self.layouts)))
        return False

    def on_key(self, _window, event):
        Gdk = self.Gdk
        name = Gdk.keyval_name(event.keyval) or ""
        if self.layouts:
            self.set_group(group_after(name, self.group, event.group, len(self.layouts)))
        if event.state & (Gdk.ModifierType.SUPER_MASK | Gdk.ModifierType.MOD4_MASK):
            step = ZOOM_KEYS.get(name)
            if step is not None:
                self.set_zoom(next_zoom(self.zoom, step))
            return True                     # never into the box (flickos-lock's ADR-019)
        if self.power_menu.get_visible() or self.layout_button.get_popover().get_visible():
            return False                    # the pop-up's keys: Escape closes it
        picked = self.stack.get_visible_child_name() == "picked"
        if picked and event.state & Gdk.ModifierType.MOD1_MASK and name in ("v", "V"):
            self.set_shown(not self.shown)
            return True
        if picked and name == "Escape":
            self.show_list()
            return True
        if not picked and event.string and event.string.isprintable() and not event.string.isspace() \
                and not event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK):
            letter = event.string.casefold()
            row = next((r for r in self.user_list.get_children() if r.name.casefold().startswith(letter)), None)
            if row:
                self.user_list.select_row(row)
                row.grab_focus()
            return True
        return False

    # The clock, once a minute on the minute, and again after sleep.

    def tick(self):
        now = time.localtime()
        self.clock.set_text(time.strftime(self.clock_format, now))
        self.date.set_text(time.strftime(_(DATE_FORMAT), now))
        self.GLib.timeout_add_seconds(60 - int(time.time()) % 60 or 60, self.tick)
        return False

    def connect_bus(self):
        """The system bus, for logind: Shut Down and Restart (no bus, no power
        button), and PrepareForSleep, since GLib's timeouts don't count time asleep."""
        try:
            self.bus = self.Gio.bus_get_sync(self.Gio.BusType.SYSTEM, None)
            self.bus.signal_subscribe(LOGIND[0], LOGIND[2], "PrepareForSleep", LOGIND[1], None,
                                      self.Gio.DBusSignalFlags.NONE, self.on_sleep)
        except self.GLib.Error as error:
            warn(f"no system bus ({error.message}): no power button, and the clock may lag after sleep")
            self.power_button.set_no_show_all(True)
            self.power_button.hide()

    def on_sleep(self, *args):
        if not args[-1].unpack()[0]:
            now = time.localtime()
            self.clock.set_text(time.strftime(self.clock_format, now))
            self.date.set_text(time.strftime(_(DATE_FORMAT), now))


def keyboard_from_environment():
    """keyboard() for the XKB_DEFAULT_* the greeter script gave cage and this window."""
    return keyboard(*(os.environ.get(f"XKB_DEFAULT_{name}", "") for name in ("LAYOUT", "VARIANT", "OPTIONS")))


def _locale_t_fmt():
    import locale
    with contextlib.suppress(locale.Error):
        locale.setlocale(locale.LC_ALL, "")
    return locale.nl_langinfo(locale.T_FMT)


# --- commands -----------------------------------------------------------------------

def cmd_check():
    """What the login screen would offer, for the boot test (it can't show
    the login screen: the live session has none)."""
    load_gtk()
    for entry in users(pwd.getpwall(), login_defs()):
        print(f"user\t{entry.pw_name}\t{display_name(entry)}")
    for key, name, command, _desktop, _current in sessions():
        print(f"session\t{key}\t{_(name)}\t{command}")
    config = read_config()
    print(f"background\t{background_file(config)}")
    print(f"position\t{config['position']}")
    layouts, key = keyboard_from_environment()
    for short, name in layouts:
        print(f"layout\t{short}\t{name}")
    if layouts:
        print(f"switch\t{key}")
    return 0


def cmd_run():
    greetd = Greetd()                       # before GTK: no greetd, nothing to show

    def loud(kind, value, tb):              # CODE-6: a bug ends the window, gtkgreet takes over
        import traceback
        traceback.print_exception(kind, value, tb)
        os._exit(1)
    sys.excepthook = loud
    threading.excepthook = lambda args: loud(args.exc_type, args.exc_value, args.exc_traceback)
    gtk = load_gtk()
    if not gtk[0].init_check(sys.argv[:1])[0]:
        raise GreeterError("cannot open the display")
    screen = LoginScreen(gtk, greetd)
    screen.build()
    gtk[0].main()
    return 0 if screen.started else 1


def main(argv=None):
    parser = argparse.ArgumentParser(prog="greeter-window", description="The FlickOS login screen's window.")
    parser.add_argument("--check", action="store_true", help="print the users and sessions it would offer")
    opts = parser.parse_args(argv)
    try:
        return cmd_check() if opts.check else cmd_run()
    except GreeterError as error:
        warn(str(error))
        return 1


if __name__ == "__main__":
    sys.exit(main())
