class Face:
    """A user's round picture, or their initial on a circle in the theme's
    selected color; avatar-default's place for Someone Else."""

    def __init__(self, ui, size):
        self.ui = ui
        self.pixbuf, self.letter = None, "?"
        self.area = ui.Gtk.DrawingArea()
        self.set_size(size)
        self.area.set_halign(ui.Gtk.Align.CENTER)
        self.area.connect("draw", self.draw)

    def set_size(self, size):
        self.area.set_size_request(size, size)

    def show(self, pixbuf, letter):
        self.pixbuf, self.letter = pixbuf, letter
        self.area.queue_draw()

    def draw(self, widget, cr):
        width, height = widget.get_allocated_width(), widget.get_allocated_height()
        radius = min(width, height) / 2
        cr.arc(width / 2, height / 2, radius, 0, 6.283185307179586)
        cr.clip()
        if self.pixbuf is not None:
            pixbuf = self.pixbuf                # one size for every zoom: it covers the circle
            scale = max(width / pixbuf.get_width(), height / pixbuf.get_height())
            cr.translate((width - pixbuf.get_width() * scale) / 2, (height - pixbuf.get_height() * scale) / 2)
            cr.scale(scale, scale)
            self.ui.Gdk.cairo_set_source_pixbuf(cr, pixbuf, 0, 0)
            cr.paint()
            return True
        context = widget.get_style_context()
        _found, back = context.lookup_color("theme_selected_bg_color")
        _found, fore = context.lookup_color("theme_selected_fg_color")
        cr.set_source_rgba(back.red, back.green, back.blue, 1)
        cr.paint()
        Pango, PangoCairo = self.ui.Pango, self.ui.PangoCairo
        font = context.get_property("font", context.get_state()).copy()
        font.set_absolute_size(radius * 0.9 * Pango.SCALE)
        font.set_weight(Pango.Weight.BOLD)
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(font)
        layout.set_text(self.letter, -1)
        text_width, text_height = layout.get_pixel_size()
        cr.set_source_rgba(fore.red, fore.green, fore.blue, 1)
        cr.move_to((width - text_width) / 2, (height - text_height) / 2)
        PangoCairo.show_layout(cr, layout)
        return True


