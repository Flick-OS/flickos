<?xml version="1.0" encoding="UTF-8"?>
<!-- A FlickOS kit is an AppStream add-on of the Tool Kits window
     (docs/design/flickos-dev.md, ADR-001 and ADR-002): Software lists add-ons
     that extend flickos-kits.desktop under Developer Tools, and FlickOS::kit
     names the kit. The category is a custom value because appstreamcli
     ignores an X-FlickOS-* category. -->
<component type="addon">
  <id>io.github.dvbondoy.flickos.kits.c</id>
  <extends>flickos-kits.desktop</extends>
  <name>C and C++</name>
  <summary>CMake, Meson, Ninja, Clang and Valgrind</summary>
  <description>
    <p>
      Build systems and a second compiler for C and C++ projects: CMake, Meson,
      Ninja, Clang, the Valgrind memory checker and pkgconf. The GNU compiler
      and make come with Developer Basics.
    </p>
  </description>
  <icon type="stock">applications-development</icon>
  <url type="homepage">https://flickos.org/</url>
  <developer id="io.github.dvbondoy">
    <name>FlickOS</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <custom>
    <value key="FlickOS::kit">c</value>
    <value key="FlickOS::kit-category">development</value>
  </custom>
</component>
