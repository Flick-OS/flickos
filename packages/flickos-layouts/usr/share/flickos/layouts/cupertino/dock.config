#Api2
# Cupertino dock, run by sfwbar (sfwbar(1)). flickos-layout generates the
# config sfwbar reads: this file with "flickos/pinned" replaced by the
# installed apps of Pinned= (layout.ini), then the style's palette and
# dock.css (no #CSS section here). The dock reserves no screen space. It is
# shown unless the active window is maximized (or fullscreen) on its monitor;
# then it hides until the pointer touches the bottom edge.

bar {
  edge = "bottom"
  layer = "top"
  mirror = "*"
  # As wide as its icons, so only the dock itself takes clicks.
  size = "auto"
  halign = "center"
  exclusive_zone = "0"
  # Hide only over a maximized active window (a FlickOS patch to sfwbar), 600 ms
  # after the pointer leaves; show 200 ms after it touches the edge.
  sensor_maximized = true
  sensor = 600
  sensor_delay = 200
  transition = 200

  # One button per app: pinned apps first, then other running apps. Hovering
  # an app with several windows lists them.
  taskbar {
    style = "dock"
    group = popup
    pins = "flickos/pinned"
    icons = true
    labels = false
    tooltips = true
    sort = false
    rows = 1
    group cols = 1
    group icons = true
    group labels = true
  }
}
