#Api2
# Traditional's bottom panel, run by sfwbar (sfwbar(1)): the window list, then
# the desktop switcher at the right end, as in GNOME 2. Not waybar: waybar 0.12
# has no desktop switcher for labwc and doesn't shrink window buttons, so many
# windows would run past the edge of the bar. Here the titles get shorter
# instead. flickos-layout generates the config sfwbar reads: this file, then
# the style's palette and windowlist.css (no #CSS section here). The desktops
# are labwc's (Desktops= in layout.ini).

bar {
  edge = "bottom"
  layer = "top"
  mirror = "*"

  # One button per window, with the windows of every desktop: labwc doesn't
  # tell other programs which desktop a window is on. Clicking one on another
  # desktop goes there. Middle click closes, as in the other layouts. The
  # window list takes the room the switcher leaves (windowlist.css), and
  # titles get shorter as windows open. Its grid scrolls (hscroll, a grid
  # property sfwbar's man page leaves out), so when even "…" doesn't fit, the
  # last buttons are cut off instead of pushing the switcher off the bar.
  grid {
    style = "windowscroll"
    hscroll = true
    taskbar {
      style = "windowlist"
      icons = true
      labels = true
      tooltips = true
      title_width = 30
      rows = 1
      action[MiddleClick] = Close()
    }
  }

  # One button per desktop, the current one highlighted.
  pager {
    style = "desktops"
    rows = 1
  }
}
