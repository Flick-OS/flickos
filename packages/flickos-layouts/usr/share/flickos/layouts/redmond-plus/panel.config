#Api2
# Redmond+ (docs/design/flickos-panel.md): Redmond's
# whole panel, run by sfwbar as this layout's Dock=. flickos-layout writes it
# out at every login and setting change: "#if NAME" sections follow the same
# settings as the waybar panel, @flickos:runtime@ becomes the overlay folder,
# @flickos:battery@ the battery's sysfs folder, #flickos/addons the add-ons'
# buttons, and Exec("flickos/launcher") what the apps button runs. Then the
# style's palette and panel.css follow (#CSS).
#
# Like waybar, each button runs its program once, then again when the
# program signals the panel (SIGRTMIN+N: tiler 8, phone 9, recording 10,
# Trail 11, media 12, weather 13, classroom 14). A style "name.class" gives
# the widget a CSS class (sfwbar +flickos10), the way waybar's JSON
# "class" does.

module("pulsectl")

Function SfwBarInit() {
  # The clock: one trigger a minute, on the minute.
  Schedule("1970-01-01 00:00:00", 60000, "minute");
#if battery
  # sysfs sends no events: read the battery once a minute, as waybar does.
  FileTrigger("@flickos:battery@/uevent", "battery", 60000);
#endif
#if floating
  # flick-tiler writes this while a window fills the screen.
  FileTrigger("@flickos:runtime@/waybar/panel-state.css", "panel-state");
#endif
#if weather
  # The weather every 15 minutes (waybar's "interval": 900), on the quarter
  # hour; flickos-weather answers from its cache.
  Schedule("1970-01-01 00:00:00", 900000, "sigrtmin+13");
#endif
}

# --- JSON from FlickOS's programs ---------------------------------------------
# A source keeps a variable's old value when the program prints nothing or
# leaves a key out, so each source takes the whole line ("{}" when there is
# none) and these read it. A trigger runs a source again for the first widget
# that reads it; the others and the tooltips read Cached(), so each program
# runs once per change, however many widgets and screens show it.

Function JText(line, path) {
  Var found;
  found = ExtractJson(line, path);
  If ArraySize(found) > 0
    Return ArrayIndex(found, 0);
  Return "";
}

# ".a.b" from a JSON "class", a string or a list, for a style "name.a.b".
Function JClasses(line) {
  Var found, i, classes;
  found = ExtractJson(line, ".class.[]");
  classes = "";
  for(i = 0; i < ArraySize(found); i = i + 1)
    classes = classes + "." + ArrayIndex(found, i);
  Return classes;
}

# Whether a JSON "class" (a string or a list) has name. (sfwbar's ArrayFind
# doesn't find strings.)
Function JHasClass(line, name) {
  Var found, i;
  found = ExtractJson(line, ".class.[]");
  for(i = 0; i < ArraySize(found); i = i + 1)
    If ArrayIndex(found, i) = name
      Return 1;
  Return 0;
}

# A style: hidden while the text is empty (waybar hides such a module).
Function JStyle(line, name) {
  If JText(line, ".text") = ""
    Return "hidden";
  Return name + JClasses(line);
}

# custom/tiler
Exec("sh -c 'flick-tiler status 2>/dev/null || echo {}'") {
  TilerLine = RegEx("^(.*)$")
}

#if media
# custom/media-*: the follower prints the title at each change and writes
# the other buttons' files, then signals us (12).
ExecClient("flickos-media follow", "media") {
  MediaTitleLine = RegEx("^(.*)$")
}
Exec("sh -c 'cat \"@flickos:runtime@/media/panel/previous.json\" 2>/dev/null || echo {}'") {
  MediaPreviousLine = RegEx("^(.*)$")
}
Exec("sh -c 'cat \"@flickos:runtime@/media/panel/play.json\" 2>/dev/null || echo {}'") {
  MediaPlayLine = RegEx("^(.*)$")
}
Exec("sh -c 'cat \"@flickos:runtime@/media/panel/next.json\" 2>/dev/null || echo {}'") {
  MediaNextLine = RegEx("^(.*)$")
}
Exec("sh -c 'cat \"@flickos:runtime@/media/panel/spectrum.json\" 2>/dev/null || echo {}'") {
  MediaSpectrumLine = RegEx("^(.*)$")
}
#endif

#if weather
# custom/weather: every 15 minutes, and at once on a settings change (13).
Exec("sh -c 'flickos-weather panel 2>/dev/null || echo {}'") {
  WeatherLine = RegEx("^(.*)$")
}
#endif

#if phone
Exec("sh -c 'flickos-phone status --panel 2>/dev/null || echo {}'") {
  PhoneLine = RegEx("^(.*)$")
}
#endif

#if classroom
Exec("sh -c 'flickos-classroom-view student panel 2>/dev/null || echo {}'") {
  ClassroomLine = RegEx("^(.*)$")
}
#endif

# custom/recording: the recorder writes the file and signals us (10).
Exec("sh -c 'cat \"@flickos:runtime@/screenshot/panel.json\" 2>/dev/null || echo {}'") {
  RecordingLine = RegEx("^(.*)$")
}

#if floating
# The floating panel: the file imports panel-full.css while a window fills
# the screen.
Exec("sh -c 'printf \"%s\\n\" \"$(cat \"@flickos:runtime@/waybar/panel-state.css\" 2>/dev/null)\"'") {
  PanelStateLine = RegEx("^(.*)$")
}
#endif

#flickos/addons-sources

#if battery
# The battery (waybar's battery module): sysfs, read at each "battery" trigger.
File("@flickos:battery@/capacity") {
  BatLevel = Grab(First)
}
File("@flickos:battery@/status") {
  BatStatus = RegEx("^(.*)$", First)
}
File("@flickos:battery@/power_now") {
  BatPower = Grab(First)
}
File("@flickos:battery@/energy_now") {
  BatEnergy = Grab(First)
}
File("@flickos:battery@/energy_full") {
  BatEnergyFull = Grab(First)
}
File("@flickos:battery@/current_now") {
  BatCurrent = Grab(First)
}
File("@flickos:battery@/charge_now") {
  BatCharge = Grab(First)
}
File("@flickos:battery@/charge_full") {
  BatChargeFull = Grab(First)
}

Function BatteryIcon() {
  If $BatStatus = "Full" Return "battery-full-charged-symbolic";
  If $BatStatus = "Charging" | $BatStatus = "Not charging"
    Return "battery-good-charging-symbolic";
  If BatLevel <= 10 Return "battery-caution-symbolic";
  If BatLevel <= 20 Return "battery-low-symbolic";
  Return "battery-good-symbolic";
}

# waybar's classes: warning (20 %), critical (10 %), charging, plugged, full.
Function BatteryStyle() {
  Var style;
  style = "battery";
  If $BatStatus = "Charging" style = style + ".charging";
  If $BatStatus = "Not charging" style = style + ".plugged";
  If $BatStatus = "Full" style = style + ".full";
  If BatLevel <= 10 style = style + ".critical";
  If BatLevel > 10 & BatLevel <= 20 style = style + ".warning";
  Return style;
}

# Hours and minutes in words.
Function Duration(hours) {
  Var minutes;
  minutes = Val(Str(hours * 60, 0));
  If minutes < 60 Return Str(minutes, 0) + " min";
  Return Str((minutes - minutes % 60) / 60, 0) + " h " + Str(minutes % 60, 0) + " min";
}

# waybar's {timeTo}: from energy and power, or charge and current.
Function BatteryTime() {
  Var now, full, rate;
  now = If(BatEnergy > 0, BatEnergy, BatCharge);
  full = If(BatEnergyFull > 0, BatEnergyFull, BatChargeFull);
  rate = If(BatPower > 0, BatPower, BatCurrent);
  If !(rate > 0) Return $BatStatus;
  If $BatStatus = "Discharging" Return Duration(now / rate) + " until empty";
  If $BatStatus = "Charging" & full > now Return Duration((full - now) / rate) + " until full";
  Return $BatStatus;
}
#endif

Function TilerIcon() {
  If JHasClass($TilerLine, "columns") Return "view-continuous-symbolic";
  If JHasClass(Cached($TilerLine), "grid") Return "view-grid-symbolic";
  If JHasClass(Cached($TilerLine), "monocle") Return "view-fullscreen-symbolic";
  Return "view-dual-symbolic";
}

Function VolumeIcon() {
  If Volume("sink-mute") Return "audio-volume-muted-symbolic";
  If Volume("sink-volume") < 34 Return "audio-volume-low-symbolic";
  If Volume("sink-volume") < 67 Return "audio-volume-medium-symbolic";
  Return "audio-volume-high-symbolic";
}

#if weather
# base.css's sky icons by class; overcast without a forecast or a place.
Function WeatherIcon() {
  Var sky;
  sky = JText(Cached($WeatherLine), ".class.[]");
  If sky = "" | sky = "unset" | sky = "stale" Return "weather-overcast-symbolic";
  Return "weather-" + sky + "-symbolic";
}
#endif

#if quick
Function QuickSettings() {
  Exec("sh -c 'printf quick > \"$XDG_RUNTIME_DIR/flickos/menu/request\"; pkill -USR1 -U $(id -u) -x flickos-menu || flickos-menu quick'");
}
#endif

#if phone
Function PhoneMenu() {
#if phone-popup
  Exec("sh -c 'printf phone > \"$XDG_RUNTIME_DIR/flickos/menu/request\"; pkill -USR1 -U $(id -u) -x flickos-menu || flickos-menu phone || flickos-phone menu'");
#else
  Exec("flickos-phone menu");
#endif
}
#endif

# --- The calendar (waybar's clock tooltip) -------------------------------------
# A month popup from a click on the clock: scroll for the next or previous
# month, middle click back to this month; today in the selection colors.

Var CalMonth = 0;

Function CalLeapYear(year) {
  Return year % 4 = 0 & (year % 100 != 0 | year % 400 = 0);
}

Function CalDays(month) {
  Var days;
  days = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
  Return days[month % 12] + If(month % 12 = 1 & CalLeapYear((month - month % 12) / 12), 1, 0);
}

# The weekday of the 1st, Monday 0 (Sakamoto's method).
Function CalFirstDay(month) {
  Var m, y, offsets;
  offsets = [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4];
  m = month % 12;
  y = (month - m) / 12 - If(m < 2, 1, 0);
  Return ((y + (y - y % 4) / 4 - (y - y % 100) / 100 + (y - y % 400) / 400 + offsets[m] + 1) % 7 + 6) % 7;
}

Function CalShow(month) {
  Var i, day, first, days, previous, months, today, style;
  CalMonth = month;
  months = ["January", "February", "March", "April", "May", "June", "July", "August", "September",
    "October", "November", "December"];
  Config("label 'cal_title' { value = '" + GT(months[month % 12]) + " " + Str((month - month % 12) / 12, 0) + "' }");
  first = CalFirstDay(month);
  days = CalDays(month);
  previous = CalDays(month - 1);
  today = Val(Time("%Y")) * 12 + Val(Time("%m")) - 1;
  for(i = 0; i < 42; i = i + 1) {
    day = i - first + 1;
    style = "cal_day";
    if (day < 1) {
      day = day + previous;
      style = "cal_day.other";
    } else if (day > days) {
      day = day - days;
      style = "cal_day.other";
    } else if (month = today & day = Val(Time("%d"))) {
      style = "cal_day.today";
    }
    Config("grid 'cal_days' { label 'cal_day_" + Str(i, 0) + "' { value = '" + Str(day, 0) +
      "'  style = '" + style + "'  loc(" + Str(i % 7, 0) + ", " + Str((i - i % 7) / 7 + 1, 0) + ") } }");
  }
}

Function CalToday() {
  CalShow(Val(Time("%Y")) * 12 + Val(Time("%m")) - 1);
}

Function CalOpen() {
  CalToday();
  PopUp("flickos_calendar");
}

Popup("flickos_calendar") {
  style = "cal_popup"
  action[MiddleClick] = CalToday()
  action[ScrollUp] = CalShow(CalMonth - 1)
  action[ScrollDown] = CalShow(CalMonth + 1)
  grid {
    style = "cal_head"
    image {
      value = "go-previous-symbolic"
      style = "cal_arrow"
      action = CalShow(CalMonth - 1)
    }
    label "cal_title" {
      style = "cal_title"
    }
    image {
      value = "go-next-symbolic"
      style = "cal_arrow"
      action = CalShow(CalMonth + 1)
    }
  }
  grid "cal_days" {
    style = "cal_days"
    # Plain strings: a value with a function call (GT()) is polled every
    # second even while the popup is closed (RESULTS F-18).
    label { value = "Mo" style = "cal_weekday" loc(0, 0) }
    label { value = "Tu" style = "cal_weekday" loc(1, 0) }
    label { value = "We" style = "cal_weekday" loc(2, 0) }
    label { value = "Th" style = "cal_weekday" loc(3, 0) }
    label { value = "Fr" style = "cal_weekday" loc(4, 0) }
    label { value = "Sa" style = "cal_weekday" loc(5, 0) }
    label { value = "Su" style = "cal_weekday" loc(6, 0) }
  }
}

# --- The taskbar's right-click menu ----------------------------------------------
# A window's menu (Q2b), on a one-window app button and on each row of an
# app's hover list. A menu's text is worked out without the window, so the
# window's state picks one of three menus instead. Icons: the theme's
# window-*-symbolic and view-pin-symbolic, which every FlickOS icon theme has
# (Adwaita's, at least). An app's button also pins or unpins the app
# (`flickos-layout pinned`, the same list as Settings' Pinned Apps; the
# panel reads its config again): under its window's items when it has one
# window, alone when it has none (only pinned) or several (sfwbar gives no
# single window). WindowInfo("pinned") is 0 or 1 on an app's button and NA
# on a hover list's row, which has no pin item. Plain strings: a value with
# a function call is polled every second (F-18).

Function TaskbarMenu() {
  Var pin;
  pin = WindowInfo("pinned");
  If pin = NA()
    pin = "";
  Else If pin
    pin = "_unpin";
  Else
    pin = "_pin";
  If WindowInfo("title") = NA() & pin = ""
    Return;
  If WindowInfo("title") = NA()
    Menu("taskbar_app" + pin);
  Else If WindowInfo("minimized")
    Menu("taskbar_minimized" + pin);
  Else If WindowInfo("maximized")
    Menu("taskbar_maximized" + pin);
  Else
    Menu("taskbar_window" + pin);
}

menu "taskbar_window" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Maximize"  icon = "window-maximize-symbolic"  action = Maximize() }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "taskbar_window_pin" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Maximize"  icon = "window-maximize-symbolic"  action = Maximize() }
  item { value = "Pin to taskbar"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned add '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "taskbar_window_unpin" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Maximize"  icon = "window-maximize-symbolic"  action = Maximize() }
  item { value = "Unpin from taskbar"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned remove '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "taskbar_maximized" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Unmaximize"  icon = "window-restore-symbolic"  action = UnMaximize() }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "taskbar_maximized_pin" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Unmaximize"  icon = "window-restore-symbolic"  action = UnMaximize() }
  item { value = "Pin to taskbar"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned add '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "taskbar_maximized_unpin" {
  item { value = "Minimize"  icon = "window-minimize-symbolic"  action = Minimize() }
  item { value = "Unmaximize"  icon = "window-restore-symbolic"  action = UnMaximize() }
  item { value = "Unpin from taskbar"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned remove '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "taskbar_minimized" {
  item { value = "Restore"  icon = "window-restore-symbolic"  action = UnMinimize() }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "taskbar_minimized_pin" {
  item { value = "Restore"  icon = "window-restore-symbolic"  action = UnMinimize() }
  item { value = "Pin to taskbar"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned add '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "taskbar_minimized_unpin" {
  item { value = "Restore"  icon = "window-restore-symbolic"  action = UnMinimize() }
  item { value = "Unpin from taskbar"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned remove '" + WindowInfo("appid") + "'") }
  separator
  item { value = "Close"  icon = "window-close-symbolic"  action = Close() }
}

menu "taskbar_app_pin" {
  item { value = "Pin to taskbar"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned add '" + WindowInfo("appid") + "'") }
}

menu "taskbar_app_unpin" {
  item { value = "Unpin from taskbar"  icon = "view-pin-symbolic"  action = Exec("flickos-layout pinned remove '" + WindowInfo("appid") + "'") }
}

# --- The bar ---------------------------------------------------------------------
# One bar block, copied to every screen (mirror): the taskbar expands and
# pushes "right" to the end. A ":end" section would lose the copies.

bar {
  edge = "bottom"
  layer = "top"
  mirror = "*"

  # The whole bar's look; the floating panel restyles it (panel.css).
  grid "panel" {
#if floating
    style = If($PanelStateLine = "", "panel.floating", "panel.floating.full")
    trigger = "panel-state"
#else
    style = "panel"
#endif

    button "launcher" {
      value = "flickos-symbolic"
      style = "launcher"
#if menu
      tooltip = "Start menu (Super)"
#else
      tooltip = "Search and open apps (Super+D)"
#endif
      action[LeftClick] = Exec("flickos/launcher")
    }

    # One button per app, this screen's windows only; hover lists them.
    taskbar {
      style = "taskbar"
      filter = output
      group = popup
      icons = true
      labels = false
      tooltips = true
      sort = false
      # Pinned apps first, shown while they aren't running: flickos-layout
      # fills in the layout's (none) or the user's (TaskbarMenu, Settings).
      pins = "flickos/pinned"
      rows = 1
      group cols = 1
      # Not "group icons = true": with filter = output on a mirrored bar it
      # empties the first screen's taskbar (docs/design/sfwbar-panel-spike/RESULTS.md, F-4).
      group labels = true
      # Apps that don't fit go to a list behind a more button at the
      # taskbar's end, so the right side stays on the screen (sfwbar
      # +flickos10, sfwbar-panel-spike/RESULTS.md F-21).
      overflow = true
      action[MiddleClick] = Close()
      action[RightClick] = TaskbarMenu()
    }

    grid "right" {
      style = "right"

#if media
      button "media_previous" {
        value = "media-skip-backward-symbolic"
        style = JStyle($MediaPreviousLine, "media")
        trigger = "sigrtmin+12"
        tooltip = JText(Cached($MediaPreviousLine), ".tooltip")
        action[LeftClick] = Exec("flickos-media previous")
      }
      button "media_play" {
        value = If(JHasClass($MediaPlayLine, "playing"),
          "media-playback-pause-symbolic", "media-playback-start-symbolic")
        style = JStyle($MediaPlayLine, "media")
        trigger = "sigrtmin+12"
        tooltip = JText(Cached($MediaPlayLine), ".tooltip")
        action[LeftClick] = Exec("flickos-media play-pause")
      }
      button "media_next" {
        value = "media-skip-forward-symbolic"
        style = JStyle($MediaNextLine, "media")
        trigger = "sigrtmin+12"
        tooltip = JText(Cached($MediaNextLine), ".tooltip")
        action[LeftClick] = Exec("flickos-media next")
      }
      button "media_title" {
        type = label
        value = Markup(JText($MediaTitleLine, ".text"))
        style = JStyle($MediaTitleLine, "media_title")
        trigger = "media"
        tooltip = JText(Cached($MediaTitleLine), ".tooltip")
        action[LeftClick] = Exec("flickos-media play-pause")
      }
      button "media_spectrum" {
        value = "flickos-spectrum-symbolic"
        style = JStyle($MediaSpectrumLine, "spectrum")
        trigger = "sigrtmin+12"
        tooltip = JText(Cached($MediaSpectrumLine), ".tooltip")
        action[LeftClick] = Exec("flickos-media toggle spectrum")
        action[RightClick] = Exec("flickos-media toggle spectrum-layer")
      }
#endif

#if classroom
      button "classroom" {
        value = "video-display-symbolic"
        style = JStyle($ClassroomLine, "classroom")
        trigger = "sigrtmin+14"
        tooltip = JText(Cached($ClassroomLine), ".tooltip")
        action[LeftClick] = Exec("flickos-control --page classroom")
      }
#endif

#if weather
      grid "weather" {
        style = JStyle($WeatherLine, "weather")
        trigger = "sigrtmin+13"
        tooltip = JText(Cached($WeatherLine), ".tooltip")
        action[LeftClick] = Exec("flickos-control --page weather")
        image "weather_icon" {
          value = WeatherIcon()
          style = "weather_icon"
          trigger = "sigrtmin+13"
        }
        label "weather_text" {
          value = JText(Cached($WeatherLine), ".text")
          style = "weather_text"
          trigger = "sigrtmin+13"
        }
      }
#endif

#if phone
      button "phone" {
        value = "phone-symbolic"
        style = JStyle($PhoneLine, "phone")
        trigger = "sigrtmin+9"
        tooltip = JText(Cached($PhoneLine), ".tooltip")
        action[LeftClick] = PhoneMenu()
        action[RightClick] = PhoneMenu()
      }
#endif

      #flickos/addons

      button "tiler" {
        value = TilerIcon()
        style = "tiler" + JClasses($TilerLine)
        trigger = "sigrtmin+8"
        tooltip = JText(Cached($TilerLine), ".tooltip")
        action[LeftClick] = Exec("flick-tiler toggle")
        action[RightClick] = Exec("flick-tiler menu")
        action[ScrollUp] = Exec("flick-tiler mode prev")
        action[ScrollDown] = Exec("flick-tiler mode next")
      }

      tray {
        style = "tray"
      }

      grid "quick" {
        style = "quick"
        button "volume" {
          value = VolumeIcon()
          style = If(Volume("sink-mute"), "volume.muted", "volume")
          trigger = "volume"
#if quick
          tooltip = "Volume " + Str(Volume("sink-volume"), 0) +
            "%\nClick: Quick Settings (Super+A) · Right click: sound mixer"
          action[LeftClick] = QuickSettings()
          action[RightClick] = Exec("pavucontrol")
#else
          tooltip = "Volume " + Str(Volume("sink-volume"), 0) + "%"
          action[LeftClick] = Exec("pavucontrol")
#endif
          action[ScrollUp] = VolumeCtl("sink-volume +5")
          action[ScrollDown] = VolumeCtl("sink-volume -5")
        }
#if battery
        button "battery" {
          value = BatteryIcon()
          style = BatteryStyle()
          trigger = "battery"
#if quick
          tooltip = "Battery " + Str(BatLevel, 0) + "%, " + BatteryTime() + "\nClick: Quick Settings (Super+A)"
          action[LeftClick] = QuickSettings()
#else
          tooltip = "Battery " + Str(BatLevel, 0) + "%, " + BatteryTime()
#endif
        }
#endif
      }

      grid "recording" {
        style = JStyle($RecordingLine, "recording")
        trigger = "sigrtmin+10"
        tooltip = JText(Cached($RecordingLine), ".tooltip")
        action[LeftClick] = Exec("flickos-screenshot stop")
        image "recording_icon" {
          value = "media-record-symbolic"
          style = "recording_icon"
        }
        label "recording_text" {
          value = JText(Cached($RecordingLine), ".text")
          style = "recording_text"
          trigger = "sigrtmin+10"
        }
      }

      # Two labels, time over date, each centered: one two-line label would
      # justify its lines to the left (sfwbar sets no justify). A grid lights
      # under the pointer like waybar's clock (panel.css).
      grid "clock" {
        style = "clock"
        tooltip = Time("%A %d %B %Y") + "\nClick: calendar"
        action[LeftClick] = CalOpen()
        label "clock_time" {
#if clock-12h
          value = Time("%I:%M %p")
#else
          value = Time("%H:%M")
#endif
          style = "clock_time"
          trigger = "minute"
          loc(0, 0)
        }
        label "clock_date" {
          value = Time("%a %d %b")
          style = "clock_date"
          trigger = "minute"
          loc(0, 1)
        }
      }

      button "desktop" {
        value = " "
        type = label
        style = "desktop"
        tooltip = "Show Desktop (Super+Shift+D)"
        action[LeftClick] = Exec("flick-tiler show-desktop")
      }
    }
  }
}
