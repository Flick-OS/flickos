# closes when it loses the focus) wouldn't notice one: every desktop click
# closes it, and the launcher click toggles it.
CLOSE_LAUNCHER = "pkill -x fuzzel"
CLICK_ACTIONS = {
    None: [("Execute", CLOSE_LAUNCHER)],
    "menu": [("Execute", CLOSE_LAUNCHER), ("ShowMenu", "root-menu")],
    "launcher": [("Execute", "sh -c 'pkill -x fuzzel || fuzzel'")],
}


