# ~/.config/flickos/choose-layout, copied from /etc/skel into new accounts:
# `first-run` opens the chooser once, then deletes it.
FIRST_RUN_MARKER = "choose-layout"

LAYOUT_ID = re.compile(r"^[a-z0-9][a-z0-9_-]*$")
# labwc-config(5) <theme><titlebar><layout>: "left:right", comma-separated buttons.
TITLEBAR_BUTTONS = {"icon", "menu", "iconify", "max", "close", "shade", "desk"}
# Their names in GTK's button-layout, for windows that draw their own title bar.
# shade and desk have none and are left out.
GTK_BUTTONS = {"icon": "icon", "menu": "menu", "iconify": "minimize", "max": "maximize", "close": "close"}

# Wallpaper: flickos-settings' default, used when the layout and the style have none.
DEFAULT_WALLPAPER = "/usr/share/backgrounds/flickos/default.jpg"
# Around an image that doesn't fill the screen: Arc-Dark bg_color.
WALLPAPER_COLOR = "#383c4a"
# The Wallpaper app. Its choice (config.ini, or state.ini with use_xdg_state)
# wins over the layout's and the style's; `waypaper --restore` shows it at login.
WAYPAPER = "waypaper"
# The new wallpaper is drawn before the old swaybg is stopped, so the desktop
# doesn't flash the background color.
WALLPAPER_SWAP_SECONDS = 0.5


@dataclasses.dataclass
class Clicks:
    id: str
    name: str
    comment: str
    left: str | None
    right: str | None


# What a click on the empty desktop does (labwc <mouse><context name="Root">):
# None (nothing), "menu" (the desktop menu) or "launcher" (the app launcher).
# flickos-settings' rc.xml has the DEFAULT_CLICKS bindings.
CLICKS = {clicks.id: clicks for clicks in (
    Clicks("right-menu", "Menu on right click",
           "Right click opens the desktop menu, left click does nothing", None, "menu"),
    Clicks("both-menu", "Menu on any click",
           "Left and right click open the desktop menu", "menu", "menu"),
    Clicks("left-launcher", "Launcher on left click",
           "Left click opens the app launcher, right click the desktop menu", "launcher", "menu"),
)}
DEFAULT_CLICKS = "right-menu"
