    None: [("Execute", "sh -c 'pkill -x fuzzel; " + MENU_SIGNAL.format(signal="WINCH") + "'")],
    "menu": [("Execute", "sh -c 'pkill -x fuzzel; " + MENU_SIGNAL.format(signal="WINCH") + "'"),
             ("ShowMenu", "root-menu")],
    "launcher": [("Execute", "sh -c '" + MENU_TOGGLE + "'")],
}
