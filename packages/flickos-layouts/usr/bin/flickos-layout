# flickos-menu's daemon answers signals, so a click starts no Python: SIGUSR1
# toggles the menu, SIGUSR2 is a tap of Super, SIGWINCH hides it. Without a
# daemon, `flickos-menu toggle` starts one. waybar runs on-click with sh -c,
# labwc runs Execute without a shell.
MENU_SIGNAL = 'pkill -{signal} -U "$(id -u)" -x flickos-menu'
MENU_TOGGLE = MENU_SIGNAL.format(signal="USR1") + " || flickos-menu toggle"
MENU_SUPER = "sh -c '" + MENU_SIGNAL.format(signal="USR2") + " || flickos-menu super'"
MENU_KEYS = ("Super_L", "Super_R")
