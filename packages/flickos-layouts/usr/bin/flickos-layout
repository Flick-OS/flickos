EXPLAIN_PROGRAMS = ("style", "labwc", "panel", "dock", "foot", "fuzzel", "mako", "gtk", "wallpaper")
# labwc -m (docs/design/flickos-ricing.md, ADR-003, phase 2): prepare writes
# the marker at login while merge_decision() says yes; flickos-session,
