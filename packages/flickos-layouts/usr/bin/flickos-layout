IMPORT_MAX_MEMBERS = 1 + len(IMPORT_TEXT_FILES) + 1         # the folder, the text files, a wallpaper
STYLE_FILE_KEYS = {"Waybar": "waybar-colors.css", "Foot": "foot.ini", "Fuzzel": "fuzzel.ini", "Mako": "mako.conf"}
EXPORT_KEYS = ("GtkTheme", "IconTheme", "LabwcTheme", "ColorScheme", "Packages")
# watch (ADR-004, phase 3): an editor's burst of events (temp file, rename)
