# check: contrast below these (A11Y-6) is a warning. Text 4.5:1; the accent
# with its text 3:1, which Arc's own white on blue (3.1:1) meets.
TEXT_CONTRAST = 4.5
ACCENT_CONTRAST = 3.0
# common/base.css draws the bar as alpha(@wm_bg, PANEL_ALPHA). A style that
# makes a panel color see-through itself (rgba(), #rrggbbaa) gets its text
# tested over the worst wallpapers, black and white, at the alpha the panel
# draws; an opaque color is tested as it is, since FlickOS's light tint of it
# is designed for its styles' own wallpapers.
PANEL_ALPHA = 0.85
WORST_BEHIND = (("black", (0.0, 0.0, 0.0)), ("white", (1.0, 1.0, 1.0)))
