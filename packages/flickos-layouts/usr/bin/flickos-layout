}


class LayoutError(Exception):
    pass


def warn(message):
    print(f"flickos-layout: {message}", file=sys.stderr)
    log_line(message)


def log_line(message):
    """Add a line to the panel log, when one is open (open_log). The session's
    stderr goes nowhere a user can read, so that log is all a failed panel
    leaves behind."""
    if LOG_STREAM is None:
        return
    with contextlib.suppress(OSError, ValueError):
        LOG_STREAM.write(f"{time.strftime('%H:%M:%S')} flickos-layout: {message}\n")


def open_log():
    """Open $XDG_RUNTIME_DIR/flickos/panel.log for appending, and send
    warnings there too. Returns the stream (also for the supervised program's
    own output), or None without a usable runtime root."""
    global LOG_STREAM
    root = runtime_root()
    if root is None:
        return None
    path = os.path.join(root, PANEL_LOG)
    try:
        os.makedirs(root, mode=0o700, exist_ok=True)
        grown = os.path.exists(path) and os.path.getsize(path) > PANEL_LOG_BYTES
        LOG_STREAM = open(path, "w" if grown else "a", buffering=1, encoding="utf-8", errors="replace")
    except OSError as error:
        print(f"flickos-layout: cannot write {path}: {error}", file=sys.stderr)
        return None
    return LOG_STREAM


@dataclasses.dataclass
class Layout:
    id: str
    name: str
    comment: str
    order: int
    waybar: str
    style: str
    titlebar_layout: str | None = None
    pinned: list[str] = dataclasses.field(default_factory=list)
    preview: str | None = None
    wallpaper: str | None = None
    dock: str | None = None
    dock_style: str | None = None
    menu: str | None = None
    menu_style: str = "classic"
    desktops: int = 1
    quick: str | None = None
    folder: str = ""
    user: bool = False             # from the user's folder (waybar only)


def valid_titlebar_layout(value):
    if value.count(":") != 1:
        return False
    buttons = [b for side in value.split(":") for b in side.split(",") if b]
    return all(b in TITLEBAR_BUTTONS for b in buttons)


@dataclasses.dataclass
class Style:
    id: str
    name: str
    comment: str
    order: int
    gtk_theme: str
    icon_theme: str
    labwc_theme: str
    color_scheme: str
    waybar: str
    foot: str
    fuzzel: str
    mako: str
    wallpaper: str | None = None
    folder: str = ""
    parent: str | None = None      # Inherits=
    user: bool = False             # from the user's folder
    # Palette files by kind ("waybar", "foot", "fuzzel", "mako"), the
    # parent's first. waybar, foot, fuzzel and mako above are the last ones.
    chain: dict = dataclasses.field(default_factory=dict)
    # Themes that aren't installed: [(style.ini key, wanted, used instead)].
    fallbacks: list = dataclasses.field(default_factory=list)
    packages: list = dataclasses.field(default_factory=list)   # Packages=


def read_section(folder, filename, section_name, required):
    """The [section_name] of folder/filename, with the required keys, and its Order."""
    ini = configparser.ConfigParser(interpolation=None)
    path = os.path.join(folder, filename)
    try:
        if not ini.read(path, encoding="utf-8"):
            raise LayoutError(f"{path}: missing")
    except (configparser.Error, UnicodeDecodeError) as error:
        raise LayoutError(f"{path}: {error}") from None
    if not ini.has_section(section_name):
        raise LayoutError(f"{path}: no [{section_name}] section")
    section = ini[section_name]
    for key in required:
        if not section.get(key):
            raise LayoutError(f"{path}: {key}= is missing")
    try:
        order = int(section.get("Order", "100"))
    except ValueError:
        raise LayoutError(f"{path}: Order= is not a number") from None
    return path, section, order


def load_layout(folder, user=False):
    """Read folder/layout.ini. Relative file paths are relative to the folder.
    A user's layout (user) is waybar only: its Dock= is left out."""
    path, section, order = read_section(folder, "layout.ini", "Layout", ("Name", "Waybar", "Style"))
    titlebar = section.get("TitlebarLayout") or None
    if titlebar is not None and not valid_titlebar_layout(titlebar):
        warn(f"{path}: ignoring invalid TitlebarLayout={titlebar}")
        titlebar = None
    dock, dock_style = section.get("Dock") or None, section.get("DockStyle") or None
    if user and (dock or dock_style):
        warn(f"{path}: ignoring Dock=: your own layouts are waybar only")
        dock = dock_style = None
    if dock and not dock_style:
        raise LayoutError(f"{path}: DockStyle= is missing")
    menu = section.get("Menu") or None
    if menu is not None and menu not in MENU_ANCHORS:
        warn(f"{path}: ignoring invalid Menu={menu} (use {' or '.join(MENU_ANCHORS)})")
        menu = None
    quick = section.get("Quick") or None
    if quick is not None and quick not in QUICK_ANCHORS:
        warn(f"{path}: ignoring invalid Quick={quick} (use {' or '.join(QUICK_ANCHORS)})")
        quick = None
    menu_style = section.get("MenuStyle") or DEFAULT_MENU_STYLE
    if menu_style not in MENU_STYLES:
        warn(f"{path}: ignoring invalid MenuStyle={menu_style} (use {', '.join(MENU_STYLES)})")
        menu_style = DEFAULT_MENU_STYLE
    try:
        desktops = int(section.get("Desktops") or 1)
    except ValueError:
        desktops = 0
    if not 1 <= desktops <= MAX_DESKTOPS:
        warn(f"{path}: ignoring invalid Desktops={section.get('Desktops')} (use 1 to {MAX_DESKTOPS})")
        desktops = 1
    return Layout(
        id=os.path.basename(folder),
        name=section["Name"],
        comment=section.get("Comment", ""),
        order=order,
        waybar=os.path.join(folder, section["Waybar"]),
        style=os.path.join(folder, section["Style"]),
        titlebar_layout=titlebar,
        pinned=[p.strip() for p in section.get("Pinned", "").split(";") if p.strip()],
        preview=os.path.join(folder, section["Preview"]) if section.get("Preview") else None,
        wallpaper=os.path.join(folder, section["Wallpaper"]) if section.get("Wallpaper") else None,
        dock=os.path.join(folder, dock) if dock else None,
        dock_style=os.path.join(folder, dock_style) if dock else None,
        menu=menu,
        menu_style=menu_style,
        desktops=desktops,
        quick=quick,
        folder=folder,
        user=user,
    )


def data_home():
    return os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")


def system_data_dirs():
    """XDG_DATA_DIRS without the user's folder (data_dirs() below has both)."""
    return [d for d in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
            if os.path.isabs(d)]


def user_styles_dir():
    return os.path.join(data_home(), STYLES_SUBDIR)


def user_layouts_dir():
    return os.path.join(data_home(), LAYOUTS_SUBDIR)


def layout_dirs(users=None):
    """Where layouts are, most important first, as style_dirs(): the user's
    (not in the plain session, unless users is True), XDG_DATA_DIRS', then
    LAYOUTS_DIR (second when run from a source tree). Each folder once."""
    seen, result = set(), []
    system = [os.path.join(d, LAYOUTS_SUBDIR) for d in system_data_dirs()]
    users = not plain_session() if users is None else users
    mine = [user_layouts_dir()] if users else []
    order = mine + [LAYOUTS_DIR] + system if PREFIX else mine + system + [LAYOUTS_DIR]
    for folder in order:
        real = os.path.realpath(folder)
        if real not in seen:
            seen.add(real)
            result.append(folder)
    return result


def plain_session():
    """The plain session: the user's own changes are left out (ADR-010)."""
    return os.environ.get(PLAIN_ENV) == "1"


def style_dirs(users=None):
    """Where styles are, most important first: the user's (not in the plain
    session, unless users is True), XDG_DATA_DIRS', then STYLES_DIR (also
    when XDG_DATA_DIRS lacks it; second when run from a source tree). Each
    folder once."""
    seen, result = set(), []
    system = [os.path.join(d, STYLES_SUBDIR) for d in system_data_dirs()]
    users = not plain_session() if users is None else users
    mine = [user_styles_dir()] if users else []
    # Run from a source tree (FLICKOS_LAYOUT_PREFIX): its styles, not the installed ones.
    order = mine + [STYLES_DIR] + system if PREFIX else mine + system + [STYLES_DIR]
    for folder in order:
        real = os.path.realpath(folder)
        if real not in seen:
            seen.add(real)
            result.append(folder)
    return result


def theme_installed(kind, name):
    """Is a GTK ("gtk_theme"), icon ("icon_theme") or labwc ("labwc_theme")
    theme installed, for everyone or in the user's own folders?"""
    home = os.path.expanduser("~")
    data = [data_home()] + system_data_dirs()
    if kind == "icon_theme":
        bases = [os.path.join(home, ".icons")] + [os.path.join(d, "icons") for d in data]
        return any(os.path.isfile(os.path.join(base, name, "index.theme")) for base in bases)
    inside = ("gtk-3.0",) if kind == "gtk_theme" else ("labwc/themerc", "openbox-3/themerc")
    bases = [os.path.join(home, ".themes")] + [os.path.join(d, "themes") for d in data]
    return any(os.path.exists(os.path.join(base, name, part)) for base in bases for part in inside)


def raw_styles(users=None):
    """{id: (folder, style.ini path, [Style] section or None, user)}: the
    first folder with each id in style_dirs(users); section None if unreadable."""
    found = {}
    user_dir = os.path.realpath(user_styles_dir())
    for base in style_dirs(users):
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for name in names:
            folder = os.path.join(base, name)
            if name in found or not LAYOUT_ID.match(name) or not os.path.isfile(os.path.join(folder, "style.ini")):
                continue
            found[name] = raw_style(folder, os.path.realpath(base) == user_dir)
    return found


def raw_style(folder, user):
    """raw_styles' entry for one style folder."""
    path = os.path.join(folder, "style.ini")
    ini = configparser.ConfigParser(interpolation=None)
    try:
        ini.read(path, encoding="utf-8")
        section = dict(ini["Style"]) if ini.has_section("Style") else None
    except (configparser.Error, UnicodeDecodeError):
        section = None
    return folder, path, section, user


def resolve_styles(raw):
    """({id: Style}, {id: error}) from raw_styles(): Inherits= resolved, the
    palette files chained, missing themes replaced by the parent's (or the
    BASE_STYLE's)."""
    resolved, errors = {}, {}

    def build(style_id, seen):
        if style_id in resolved:
            return resolved[style_id]
        if style_id in errors:
            raise LayoutError(errors[style_id])
        folder, path, section, user = raw[style_id]
        if section is None:
            raise LayoutError(f"{path}: no readable [Style] section")
        parent = None
        parent_id = section.get("inherits") or None
        if parent_id:
            if parent_id in seen or parent_id == style_id:
                raise LayoutError(f"{path}: Inherits={parent_id} goes round in a circle "
                                  f"({' -> '.join(seen + (style_id, parent_id))})")
            if parent_id not in raw:
                raise LayoutError(f"{path}: Inherits={parent_id}, which isn't installed")
            try:
                parent = build(parent_id, seen + (style_id,))
            except LayoutError as error:
                raise LayoutError(f"{path}: Inherits={parent_id}, which is broken ({error})") from None

        def key(name, attribute, default=None):
            if section.get(name.lower()):
                return section[name.lower()]
            if parent is not None:
                return getattr(parent, attribute)
            if default is not None:
                return default
            raise LayoutError(f"{path}: {name}= is missing")

        chain = {}
        for name in PALETTE_KEYS:
            own = section.get(name.lower())
            files = [os.path.join(folder, own)] if own else []
            chain[name.lower()] = (list(parent.chain[name.lower()]) if parent else []) + files
            if not chain[name.lower()]:
                raise LayoutError(f"{path}: {name}= is missing")
        color_scheme = key("ColorScheme", "color_scheme")
        if color_scheme not in COLOR_SCHEMES:
            raise LayoutError(f"{path}: ColorScheme= must be one of {', '.join(sorted(COLOR_SCHEMES))}")
        try:
            order = int(section.get("order") or (parent.order if parent else 100))
        except ValueError:
            raise LayoutError(f"{path}: Order= is not a number") from None
        themes, fallbacks = {}, []
        for name, attribute, _what, _use in STYLE_THEMES:
            wanted = key(name, attribute)
            used = wanted
            if not theme_installed(attribute, wanted):
                base = resolved.get(BASE_STYLE) if style_id != BASE_STYLE else None
                fallback = getattr(parent or base, attribute, None) if (parent or base) else None
                if fallback and fallback != wanted:
                    used = fallback
                fallbacks.append((name, wanted, used))
            themes[attribute] = used
        wallpaper = (os.path.join(folder, section["wallpaper"]) if section.get("wallpaper")
                     else parent.wallpaper if parent else None)
        packages = [p.strip() for p in section.get("packages", "").split(";") if p.strip()]
        style = Style(id=style_id, name=key("Name", "name"), comment=key("Comment", "comment", ""), order=order,
                      color_scheme=color_scheme, waybar=chain["waybar"][-1], foot=chain["foot"][-1],
                      fuzzel=chain["fuzzel"][-1], mako=chain["mako"][-1], wallpaper=wallpaper, folder=folder,
                      parent=parent_id, user=user, chain=chain, fallbacks=fallbacks, packages=packages, **themes)
        resolved[style_id] = style
        return style

    # The BASE_STYLE first: a style without a parent falls back to its themes.
    for style_id in sorted(raw, key=lambda i: i != BASE_STYLE):
        try:
            build(style_id, ())
        except LayoutError as error:
            errors[style_id] = str(error)
    return resolved, errors


def load_all(directory, filename, loader):
    """Items in directory/ID/filename by id, sorted by Order, then id. Broken ones are skipped."""
    found = []
    try:
        names = os.listdir(directory)
    except OSError:
        names = []
    for name in names:
        folder = os.path.join(directory, name)
        if not LAYOUT_ID.match(name) or not os.path.isfile(os.path.join(folder, filename)):
            continue
        try:
            found.append(loader(folder))
        except LayoutError as error:
            warn(str(error))
    found.sort(key=lambda item: (item.order, item.id))
    return {item.id: item for item in found}


def layouts(users=None):
    """Layouts by id, FlickOS's (and other packages') first, then the user's,
    each by Order, then id. The first folder with an id wins (ADR-001)."""
    found = {}
    user_dir = os.path.realpath(user_layouts_dir())
    for base in layout_dirs(users):
        user = os.path.realpath(base) == user_dir
        for item in load_all(base, "layout.ini", lambda folder, user=user: load_layout(folder, user)).values():
            found.setdefault(item.id, item)
    return dict(sorted(found.items(), key=lambda item: (item[1].user, item[1].order, item[0])))


def styles():
    """Installed styles, FlickOS's and the user's, by id, in list order.
    Broken ones are left out with a warning (check says more)."""
    resolved, errors = resolve_styles(raw_styles())
    for message in errors.values():
        warn(message)
    # FlickOS's first, then the user's, each by Order, then id.
    return dict(sorted(resolved.items(), key=lambda item: (item[1].user, item[1].order, item[0])))


def style_fallback_messages(style):
    """What a style uses instead of themes that aren't installed."""
    messages = []
    for name, wanted, used in style.fallbacks:
        _key, _attribute, what, use = next(t for t in STYLE_THEMES if t[0] == name)
        if used != wanted:
            messages.append(f"style {style.id}: the {what} {wanted} isn't installed, so {use} {used}")
        else:
            messages.append(f"style {style.id}: the {what} {wanted} isn't installed")
    return messages


# --- Choice ---------------------------------------------------------------

def config_home():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")


def choice_path(kind="layout"):
    return os.path.join(config_home(), "flickos", kind)


def user_choice(kind):
    """The user's own choice as saved (maybe an unknown id), or DEFAULT_CHOICE."""
    return read_first_line(choice_path(kind)) or DEFAULT_CHOICE


def read_first_line(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.readline().strip() or None
    except (OSError, UnicodeDecodeError):
        return None


def system_default(key="Layout"):
    ini = configparser.ConfigParser(interpolation=None)
    try:
        ini.read(SYSTEM_CONF, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError) as error:
        warn(f"{SYSTEM_CONF}: {error}")
        return None
    return ini.get("Defaults", key, fallback=None) or None


def resolve(available, kind, default, directory, key=None):
    """The layout or style in use: user choice, system default (key in
    [Defaults], else the kind in title case), built-in default."""
    for source, item_id in ((choice_path(kind), read_first_line(choice_path(kind))),
                            (SYSTEM_CONF, system_default(key or kind.title())),
                            (None, default)):
        if item_id in available:
            return available[item_id]
        if item_id and source:
            warn(f"{source}: unknown {kind} '{item_id}', using the default")
    if available:
        return next(iter(available.values()))
    raise LayoutError(f"no {kind}s installed in {directory}")


def resolve_layout(available):
    return resolve(available, "layout", DEFAULT_LAYOUT, LAYOUTS_DIR)


def resolve_style(available):
    if plain_session():
        # A user's style in use becomes its nearest FlickOS ancestor.
        chosen, raw = read_first_line(choice_path("style")), None
        seen = set()
        while chosen and chosen not in available and chosen not in seen:
            seen.add(chosen)
            raw = raw if raw is not None else raw_styles(users=True)
            section = raw.get(chosen, (None, None, None, None))[2] or {}
            chosen = section.get("inherits")
        if chosen in available:
            return available[chosen]
    else:
        tried = tried_style_id()
        if tried in available:
            return available[tried]
    return resolve(available, "style", DEFAULT_STYLE, STYLES_DIR)


def try_path():
    root = runtime_root()
    return os.path.join(root, TRY_FILE) if root else None


def try_record_path():
    return os.path.join(state_home(), "flickos", TRY_RECORD)


def tried_style_id():
    """The style being tried (try), or None. Never in the plain session."""
    path = try_path()
    return read_first_line(path) if path and not plain_session() else None


def resolve_clicks():
    return resolve(CLICKS, "clicks", DEFAULT_CLICKS, "flickos-layout")


def available_launchers():
    """LAUNCHERS, without the start menu while flickos-menu isn't installed."""
    return {key: launcher for key, launcher in LAUNCHERS.items()
            if key != "menu" or installed(MENU_PROGRAM)}


def resolve_launcher():
    """The start menu by default; the app launcher while flickos-menu isn't
    installed (a warning only if the user chose the menu)."""
    available = available_launchers()
    if "menu" not in available:
        if read_first_line(choice_path("launcher")) == "menu":
            warn(f"{MENU_PROGRAM} is not installed; the apps button opens the app launcher")
        return LAUNCHERS[FALLBACK_LAUNCHER]
    return resolve(available, "launcher", DEFAULT_LAUNCHER, "flickos-layout")


def resolve_menu_style():
    return resolve(MENU_STYLE_CHOICES, "menu-style", DEFAULT_MENU_STYLE_CHOICE, "flickos-layout", key="MenuStyle")


def resolve_clock():
    return resolve(CLOCKS, "clock", DEFAULT_CLOCK, "flickos-layout")


def available_quick_settings():
    """QUICK_SETTINGS, without on while flickos-menu isn't installed."""
    return {key: choice for key, choice in QUICK_SETTINGS.items() if key != "on" or installed(MENU_PROGRAM)}


def resolve_quick_settings():
    """Off by default; off while flickos-menu isn't installed (a warning
    only if the user turned it on)."""
    available = available_quick_settings()
    if "on" not in available:
        if read_first_line(choice_path("quick-settings")) == "on":
            warn(f"{MENU_PROGRAM} is not installed; Quick Settings is off")
        return QUICK_SETTINGS["off"]
    return resolve(available, "quick-settings", DEFAULT_QUICK_SETTINGS, "flickos-layout", key="QuickSettings")


def menu_style(layout, choice):
    """The start menu style for layout: the user's choice, or the layout's own."""
    return layout.menu_style if choice is None or choice.id == FOLLOW_LAYOUT else choice.id


def menu_anchor(layout, launcher):
    """The start menu's corner while it is on for this layout, else None."""
    return layout.menu if launcher is not None and launcher.id == "menu" else None


def quick_anchor(layout, quick):
    """Quick Settings' corner while it is on for this layout, else None."""
    return layout.quick if quick is not None and quick.id == "on" else None


def phone_corner(layout):
    """The phone popup's corner while the phone connection is on and
    flickos-menu is installed, else None. The button then keeps the fuzzel menu."""
    if shutil.which(MENU_PROGRAM) is None or not phone_on():
        return None
    return layout.quick


# --- History --------------------------------------------------------------
# Every change of a choice is recorded for Settings > History, which can undo
# it (flickos-control history). One JSON line per change, appended; the format
# is shared with flickos-control and flick-tiler, which record their own
# settings the same way (docs/design/flickos-history.md, ADR-002).

HISTORY_OWNER = "flickos-layout"
HISTORY_FILE = "history.jsonl"      # in $XDG_STATE_HOME/flickos
HISTORY_LOCK = "history.lock"
HISTORY_BYTES = 256 * 1024          # above this, the older half is dropped
# flickos-control's: [History] Enabled=, then the user's ~/.config/flickos/history.
HISTORY_CONF = PREFIX + "/etc/xdg/flickos/history.conf"


def history_enabled():
    enabled = True
    for path in (HISTORY_CONF, os.path.join(config_home(), "flickos", "history")):
        ini = configparser.ConfigParser(interpolation=None)
        try:
            ini.read(path, encoding="utf-8")
            value = ini.get("History", "Enabled", fallback=None)
        except (configparser.Error, UnicodeDecodeError):
            continue
        if value is not None:
            enabled = value.strip().lower() not in ("no", "false", "off", "0")
    return enabled


def record(key, old, new):
    """Add a change to the history. It never stops the change itself: a
    history that can't be written is only a warning."""
    if old == new or not history_enabled():
        return
    now = time.time_ns()
    entry = {"v": 1, "id": str(now),
             "time": datetime.datetime.fromtimestamp(now / 1e9).astimezone().isoformat(timespec="seconds"),
             "owner": HISTORY_OWNER, "key": key, "old": old, "new": new}
    folder = os.path.join(state_home(), "flickos")
    try:
        os.makedirs(folder, mode=0o700, exist_ok=True)
        with open(os.path.join(folder, HISTORY_LOCK), "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            path = os.path.join(folder, HISTORY_FILE)
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a", encoding="utf-8") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
                size = os.fstat(f.fileno()).st_size
            if size > HISTORY_BYTES:
                trim_history(path)
    except OSError as error:
        warn(f"the history can't be written: {error}")


def trim_history(path):
    """Keep the newest lines that fit in half of HISTORY_BYTES (under the lock)."""
    with open(path, encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    kept, size = [], 0
    for line in reversed(lines):
        size += len(line.encode())
        if size > HISTORY_BYTES // 2:
            break
        kept.append(line)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.writelines(reversed(kept))
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


# --- Files ----------------------------------------------------------------

def write_atomic(path, text):
    """Replace path in one step, so readers never see a half-written file."""
    folder = os.path.dirname(path)
    os.makedirs(folder, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def remove(path):
    with contextlib.suppress(FileNotFoundError):
        os.unlink(path)


def runtime_root():
    """$XDG_RUNTIME_DIR/flickos, or None without a usable XDG_RUNTIME_DIR."""
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base or not os.path.isabs(base) or not os.path.isdir(base):
        return None
    return os.path.join(base, "flickos")


def overlay_xdg(root):
    return os.path.join(root, "xdg")


@contextlib.contextmanager
def locked(timeout=LOCK_SECONDS):
    """Serialize changes to the choice and the overlay (e.g. two quick `set`s).

    Never waits forever: autostart starts `panel`, `wallpaper` and the tiler at
    once, and a run that hangs while holding the lock would otherwise leave the
    session without a panel. After timeout seconds, carry on without it."""
    root = runtime_root()
    if root is None:
        yield
        return
    os.makedirs(root, mode=0o700, exist_ok=True)
    with open(os.path.join(root, "layout.lock"), "w") as lock:
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    warn(f"another flickos-layout has been busy for {timeout:.0f}s; carrying on without the lock")
                    break
                time.sleep(0.1)
        yield


# --- labwc rc.xml overlay ---------------------------------------------------

def is_below(path, folder):
    path, folder = os.path.realpath(path), os.path.realpath(folder)
    return path == folder or path.startswith(folder + os.sep)


def find_base_rcxml(root, name="rc.xml"):
    """First system labwc file (rc.xml, environment) in XDG_CONFIG_DIRS,
    skipping the overlay itself. For environment, a folder with an
    environment.d/ counts too, as it does for labwc."""
    for folder in (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":"):
        if not os.path.isabs(folder) or is_below(folder, root):
            continue
        candidate = os.path.join(folder, "labwc", name)
        if os.path.isfile(candidate) or (name == "environment" and os.path.isdir(candidate + ".d")):
            return candidate
    return None


def set_option(element, path, value, only_replace=None):
    """Set a labwc option such as ("theme", "titlebar", "layout") below element.

    labwc applies elements in order, so the last matching element is changed.
    An option written as an attribute (<theme name="…"/>) stays an attribute.
    With only_replace, the option is changed only if its current value is in
    it. Returns True if the value changed.
    """
    for name in path[:-1]:
        children = element.findall(name)
        if not children and only_replace is not None:
            return False
        element = children[-1] if children else ET.SubElement(element, name)
    leaf = path[-1]
    if leaf in element.attrib:
        current = element.get(leaf)
        if current == value or (only_replace is not None and current not in only_replace):
            return False
        element.set(leaf, value)
        return True
    children = element.findall(leaf)
    current = (children[-1].text or "").strip() if children else None
    if current == value or (only_replace is not None and current not in only_replace):
        return False
    child = children[-1] if children else ET.SubElement(element, leaf)
    child.text = value
    return True


def rcxml_changes(layout, style, style_themes):
    """(path, value, only_replace) for every option the layout and style set.

    The window theme and the title bar's icon theme are only replaced if the
    system rc.xml selects one of the styles' themes (style_themes), so an
    administrator's own theme stays. The icon theme is the one GTK uses
    (gsettings icon-theme, which the style sets unless the user chose one),
    so window icons match the apps'."""
    changes = []
    if layout.titlebar_layout:
        changes.append((("theme", "titlebar", "layout"), layout.titlebar_layout, None))
    if style is not None:
        changes.append((("theme", "name"), style.labwc_theme, style_themes | {style.labwc_theme}))
        changes.append((("theme", "icon"), current_icon_theme() or style.icon_theme,
                        style_themes | {style.icon_theme}))
    return changes


def bind_actions(bind):
    """A labwc <mousebind>'s actions as (name, command or menu) pairs."""
    actions = []
    for action in bind.findall("action"):
        name = action.get("name")
        if name == "Execute":
            value = action.get("command") or action.findtext("command") or ""
        else:
            value = action.get("menu") or action.findtext("menu") or ""
        actions.append((name, value.strip()))
    return actions


def mousebind(button, actions, indent):
    bind = ET.Element("mousebind", button=button, action="Press")
    bind.text = indent + "  "
    for i, (name, value) in enumerate(actions):
        action = ET.SubElement(bind, "action", name=name)
        if name == "Execute":
            ET.SubElement(action, "command").text = value
        else:
            action.set("menu", value)
        action.tail = indent + ("  " if i < len(actions) - 1 else "")
    return bind


def set_root_clicks(top, clicks, actions=CLICK_ACTIONS):
    """Bind left and right click on the empty desktop (labwc's Root context)
    as clicks says, with actions (CLICK_ACTIONS, or MENU_CLICK_ACTIONS while
    the start menu is on). Older bindings of the same clicks are removed, so
    the new ones apply. Returns True if the bindings changed."""
    mouse = top.findall("mouse")
    if mouse:
        mouse = mouse[-1]
    else:
        mouse = ET.SubElement(top, "mouse")
        ET.SubElement(mouse, "default")  # keep labwc's other mouse bindings
    context = next((c for c in reversed(mouse.findall("context")) if c.get("name") == "Root"), None)
    if context is None:
        context = ET.SubElement(mouse, "context", name="Root")
    changed = False
    for button, what in (("Left", clicks.left), ("Right", clicks.right)):
        wanted = actions[what]
        binds = [b for b in context.findall("mousebind") if b.get("button") == button and b.get("action") == "Press"]
        if binds and bind_actions(binds[-1]) == wanted and len(binds) == 1:
            continue
        index = list(context).index(binds[0]) if binds else len(context)
        for bind in binds:
            context.remove(bind)
        indent = "\n      "
        new = mousebind(button, wanted, indent)
        new.tail = indent
        context.insert(index, new)
        changed = True
    return changed


def set_menu_keys(top):
    """Bind a tap of Super (MENU_KEYS, on release) to the start menu. Returns
    True (the system rc.xml never has these)."""
    keyboards = top.findall("keyboard")
    keyboard = keyboards[-1] if keyboards else ET.SubElement(top, "keyboard")
    for element in list(keyboard):
        if element.tag == "keybind" and element.get("key") in MENU_KEYS:
            keyboard.remove(element)
    indent = "\n    "
    if len(keyboard) and keyboard[-1].tail is not None:
        keyboard[-1].tail = indent
    for i, key in enumerate(MENU_KEYS):
        bind = ET.SubElement(keyboard, "keybind", key=key, onRelease="yes")
        action = ET.SubElement(bind, "action", name="Execute")
        ET.SubElement(action, "command").text = MENU_SUPER
        bind.tail = indent if i < len(MENU_KEYS) - 1 else "\n  "
    return True


def set_quick_key(top):
    """Bind QUICK_KEY to Quick Settings, replacing the system's binding of
    it (labwc's default ToggleMaximize). Returns True."""
    keyboards = top.findall("keyboard")
    keyboard = keyboards[-1] if keyboards else ET.SubElement(top, "keyboard")
    for element in list(keyboard):
        if element.tag == "keybind" and element.get("key") == QUICK_KEY:
            keyboard.remove(element)
    if len(keyboard) and keyboard[-1].tail is not None:
        keyboard[-1].tail = "\n    "
    bind = ET.SubElement(keyboard, "keybind", key=QUICK_KEY)
    action = ET.SubElement(bind, "action", name="Execute")
    ET.SubElement(action, "command").text = QUICK_KEY_COMMAND
    bind.tail = "\n  "
    return True


def desktop_keys(count):
    """(key, action, to) of DESKTOP_KEYS and of Super+number (go to that
    desktop) and Super+Shift+number (move the window there) for desktops 1 to
    count."""
    numbers = [str(number) for number in range(1, count + 1)]
    return (DESKTOP_KEYS + tuple((f"W-{n}", "GoToDesktop", n) for n in numbers)
            + tuple((f"W-S-{n}", "SendToDesktop", n) for n in numbers))


def set_desktops(top, count):
    """labwc desktops named 1 to count, replacing the system rc.xml's, and
    desktop_keys(count) to go to another one and to move the window there.
    Returns True (the system rc.xml has neither)."""
    for element in top.findall("desktops"):
        top.remove(element)
    desktops = ET.Element("desktops", number=str(count))
    names = ET.SubElement(desktops, "names")
    for number in range(1, count + 1):
        ET.SubElement(names, "name").text = str(number)
    ET.indent(desktops, space="  ", level=1)
    if len(top):
        top[-1].tail = "\n  "
    desktops.tail = "\n"
    top.append(desktops)
    keyboards = top.findall("keyboard")
    keyboard = keyboards[-1] if keyboards else ET.SubElement(top, "keyboard")
    binds = desktop_keys(count)
    keys = {key for key, _, _ in binds}
    for element in list(keyboard):
        if element.tag == "keybind" and element.get("key") in keys:
            keyboard.remove(element)
    indent = "\n    "
    if len(keyboard) and keyboard[-1].tail is not None:
        keyboard[-1].tail = indent
    for i, (key, name, to) in enumerate(binds):
        bind = ET.SubElement(keyboard, "keybind", key=key)
        action = ET.SubElement(bind, "action", name=name, to=to)
        if not to.isdigit():
            action.set("wrap", "no")
        bind.tail = indent if i < len(binds) - 1 else "\n  "
    return True


def fragments(root):
    """The labwc config fragments of other programs that exist (FRAGMENTS):
    flickos-control's input settings, flick-tiler's while tiling is on."""
    found = []
    for relative, lost in FRAGMENTS:
        path = os.path.join(root, relative)
        try:
            found.append(ET.parse(path).getroot())
        except FileNotFoundError:
            pass
        except (ET.ParseError, OSError) as error:
            warn(f"cannot read {path} ({error}); {lost}")
    return found


def addons():
    """{name: folder} of the add-ons, sorted by name: the user's (ADDONS_HOME),
    else the system's (ADDONS_DIR). Folders not named like a layout id are
    left out."""
    found = {}
    homes = [] if plain_session() else [os.path.join(config_home(), ADDONS_HOME)]
    for base in homes + [ADDONS_DIR]:
        try:
            names = os.listdir(base)
        except OSError:
            continue
        for name in names:
            folder = os.path.join(base, name)
            if name not in found and LAYOUT_ID.match(name) and os.path.isdir(folder):
                found[name] = folder
    return dict(sorted(found.items()))


def addon_fragments(found):
    """The labwc fragments (ADDON_LABWC) of the add-ons found, with only their
    keybinds and window rules, and the shortcut sheet's descriptions of their
    keybinds' commands ({command: description}), which are taken out of the
    fragments."""
    result, descriptions = [], {}
    for name, folder in found.items():
        path = os.path.join(folder, ADDON_LABWC)
        try:
            parsed = ET.parse(path).getroot()
        except FileNotFoundError:
            continue
        except (ET.ParseError, OSError) as error:
            warn(f"cannot read {path} ({error}); add-on {name} has no keyboard shortcuts")
            continue
        top = ET.Element(parsed.tag)
        for section in parsed:
            if section.tag == "keyboard":
                keyboard = ET.SubElement(top, "keyboard")
                keyboard.extend(bind for bind in section if bind.tag == "keybind")
            elif section.tag in ADDON_LABWC_SECTIONS:
                top.append(section)
            elif isinstance(section.tag, str):
                warn(f"{path}: <{section.tag}> left out (add-ons have only keybinds and window rules)")
        for bind in top.iter("keybind"):
            text = (bind.attrib.pop(ADDON_DESCRIPTION, None) or "").strip()
            for action in bind.iter("action"):
                command = (action.get("command") or action.findtext("command") or "").strip()
                if text and action.get("name") == "Execute" and command:
                    descriptions[command] = text
        result.append(top)
    return result, descriptions


def update_shortcut_descriptions(root, descriptions):
    """Write the add-ons' shortcut descriptions for flickos-shortcuts, or
    delete them when there are none."""
    target = os.path.join(root, SHORTCUT_DESCRIPTIONS)
    if not descriptions:
        remove(target)
        return None
    write_atomic(target, json.dumps(descriptions, indent=1, ensure_ascii=False, sort_keys=True) + "\n")
    return target


def key_id(key):
    """A labwc key with its modifiers in any order: 'S-W-m' is 'W-S-m'."""
    *mods, name = key.split("-")
    return frozenset(mods), name


def drop_bound_keys(top, fragment):
    """Take the keybinds for keys rc.xml already binds out of an add-on's
    fragment: FlickOS's keys (and an earlier add-on's) win."""
    bound = {key_id(bind.get("key", "")) for bind in top.iter("keybind")}
    for keyboard in fragment.findall("keyboard"):
        for bind in keyboard.findall("keybind"):
            if key_id(bind.get("key", "")) in bound:
                warn(f"add-on keybind {bind.get('key')} left out: the desktop already uses that key")
                keyboard.remove(bind)


def merge_fragment(top, fragment):
    """Add a fragment to rc.xml: its regions and window rules are added, its
    keybinds replace the ones with the same key, its core, magnifier and
    keyboard options are set, and its libinput <device> categories are appended (labwc uses the
    last category of a device's type, so they win over the system rc.xml's,
    while one for a named device still wins over a type). Returns True if
    anything was added."""
    changed = False
    for section in fragment:
        if section.tag in ("core", "magnifier"):
            for option in section:
                if isinstance(option.tag, str):
                    changed |= set_option(top, (section.tag, option.tag), (option.text or "").strip())
            continue
        if section.tag not in ("regions", "windowRules", "keyboard", "libinput"):
            continue
        items = [item for item in section if isinstance(item.tag, str)]
        if section.tag == "keyboard":
            for option in [item for item in items if item.tag != "keybind"]:
                changed |= set_option(top, ("keyboard", option.tag), (option.text or "").strip())
            items = [item for item in items if item.tag == "keybind"]
            keys = {bind.get("key") for bind in items}
            for keyboard in top.findall("keyboard"):
                for bind in keyboard.findall("keybind"):
                    if bind.get("key") in keys:
                        keyboard.remove(bind)
        if not items:
            continue
        targets = top.findall(section.tag)
        (targets[-1] if targets else ET.SubElement(top, section.tag)).extend(items)
        changed = True
    return changed


def update_rcxml(root, layout, style=None, style_themes=frozenset(), clicks=None, menu=False, extra=(),
                 quick=False):
    """Write or delete the overlay rc.xml. Returns its path if written.

    The overlay is needed only if it differs from the system rc.xml. Clicks
    other than DEFAULT_CLICKS (the system rc.xml's) replace the desktop's
    click bindings. With menu (the start menu is on), a tap of Super opens it
    and every desktop click also closes it; with quick (Quick Settings is
    on), QUICK_KEY opens that and every desktop click closes it. A layout
    with more than one desktop gets them and their keys. The fragments
    (FRAGMENTS), then extra ones (the add-ons', addon_fragments), are merged
    in."""
    target = os.path.join(overlay_xdg(root), "labwc", "rc.xml")
    changes = rcxml_changes(layout, style, style_themes)
    if menu or quick:
        clicks = clicks or CLICKS[DEFAULT_CLICKS]
    elif clicks is not None and clicks.id == DEFAULT_CLICKS:
        clicks = None
    own = fragments(root)
    found = own + list(extra)
    if not changes and clicks is None and not found and not menu and not quick and layout.desktops == 1:
        remove(target)
        return None
    base = find_base_rcxml(root)
    if base is None:
        warn("no system labwc rc.xml found; window buttons, window theme, desktop clicks, desktops, tiling "
             "and input settings not changed")
        remove(target)
        return None
    try:
        parser = ET.XMLParser(target=ET.TreeBuilder(insert_comments=True))
        tree = ET.parse(base, parser)
    except (ET.ParseError, OSError) as error:
        warn(f"cannot read {base} ({error}); window buttons, window theme, desktop clicks, desktops, tiling "
             "and input settings not changed")
        remove(target)
        return None
    top = tree.getroot()
    changed = [set_option(top, path, value, only_replace) for path, value, only_replace in changes]
    if clicks is not None:
        actions = MENU_CLICK_ACTIONS if menu else QUICK_CLICK_ACTIONS if quick else CLICK_ACTIONS
        changed.append(set_root_clicks(top, clicks, actions))
    if menu:
        changed.append(set_menu_keys(top))
    if quick:
        changed.append(set_quick_key(top))
    if layout.desktops > 1:
        changed.append(set_desktops(top, layout.desktops))
    for fragment in own:
        changed.append(merge_fragment(top, fragment))
    for fragment in extra:
        drop_bound_keys(top, fragment)
        changed.append(merge_fragment(top, fragment))
    if not any(changed):
        remove(target)
        return None
    comment = ET.Comment(f" Generated by flickos-layout from {base} at every login. Do not edit. ")
    comment.tail = top.text
    top.insert(0, comment)
    out = io.BytesIO()
    tree.write(out, encoding="utf-8", xml_declaration=True)
    write_atomic(target, out.getvalue().decode("utf-8") + "\n")
    return target


def update_environment(root):
    """Write or delete the overlay labwc environment file. Returns its path if
    written.

    Needed only for flickos-control's keyboard layout (control/environment).
    labwc reads only the first environment file (or environment.d/) it finds,
    so the overlay's has the system one's lines first, then the fragment's."""
    target = os.path.join(overlay_xdg(root), "labwc", "environment")
    fragment = os.path.join(root, CONTROL_ENVIRONMENT)
    try:
        with open(fragment, encoding="utf-8") as f:
            added = f.read()
    except FileNotFoundError:
        remove(target)
        return None
    except (OSError, UnicodeDecodeError) as error:
        warn(f"cannot read {fragment} ({error}); the keyboard layout is not changed")
        remove(target)
        return None
    base = find_base_rcxml(root, "environment")
    parts = [f"# Generated by flickos-layout at every login from {base or 'no system file'} and {fragment}. "
             "Do not edit.\n"]
    if base is not None:
        sources = [base]
        if os.path.isdir(base + ".d"):
            sources += sorted(os.path.join(base + ".d", name) for name in os.listdir(base + ".d")
                              if name.endswith(".env"))
        for source in sources:
            with contextlib.suppress(OSError, UnicodeDecodeError), open(source, encoding="utf-8") as f:
                text = f.read()
                parts.append(text if text.endswith("\n") else text + "\n")
    parts.append(added if added.endswith("\n") else added + "\n")
    write_atomic(target, "".join(parts))
    return target


# --- explain: which file wins ----------------------------------------------------

def config_folders():
    """$XDG_CONFIG_HOME, then XDG_CONFIG_DIRS: where foot, fuzzel, mako and
    labwc look, in that order."""
    return [config_home()] + [d for d in (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":")
                              if os.path.isabs(d)]


def config_files(relative):
    """Every existing FOLDER/relative in config_folders() order."""
    return [os.path.join(d, relative) for d in config_folders() if os.path.exists(os.path.join(d, relative))]


def shown_path(path):
    """A path with the home folder as ~."""
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path and path.startswith(home + os.sep) else path


def is_users(path):
    return bool(path) and os.path.realpath(path).startswith(os.path.realpath(config_home()) + os.sep)


def include_chain(path, depth=0):
    """[(path, depth, exists)] of a foot, fuzzel or mako config and what it
    include=s, in reading order."""
    result = [(path, depth, os.path.isfile(path))]
    if depth >= 5 or not os.path.isfile(path):
        return result
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except (OSError, UnicodeDecodeError):
        return result
    for line in lines:
        match = re.match(r"\s*include\s*=\s*(.*?)\s*$", line)
        if match:
            result += include_chain(os.path.expanduser(match.group(1)), depth + 1)
    return result


def explain_label(path, ctx):
    """Whose a file is, for explain's lines."""
    if path == os.path.join(tweaks_folder(), TWEAKS_STYLE):
        return "your tweaks"
    if is_users(path):
        return "yours"
    for style in ctx["styles"].values():
        if style.folder and path.startswith(style.folder + os.sep):
            return f"{style.name} style's colors" + (", yours" if style.user else "")
    root = ctx["root"]
    if root and path.startswith(root + os.sep):
        return "generated for this login"
    if path in (BASE_FOOT, BASE_FUZZEL, BASE_MAKO):
        return "FlickOS's base"
    layout = ctx["layout"]
    if layout and (path in (layout.style, layout.dock_style, layout.waybar)
                   or (layout.user and path.startswith(layout.folder + os.sep))):
        return f"the {layout.name} layout" + (", yours" if layout.user else "")
    for name, folder in ctx["addons"].items():
        if path.startswith(folder + os.sep):
            return f"add-on {name}"
    return "FlickOS's" if path.startswith(("/etc/", "/usr/")) else ""


def labelled(path, ctx):
    """A path for explain, with whose it is when that is known."""
    label = explain_label(path, ctx)
    return shown_path(path) + (f" ({label})" if label else "")


def chain_lines(chain, ctx):
    lines = []
    for path, depth, exists in chain:
        label = explain_label(path, ctx) if exists else "missing"
        lines.append("  " * depth + shown_path(path) + (f" ({label})" if label else ""))
    return lines


def theme_file(name):
    """The labwc themerc of a window theme, where labwc would find it."""
    home = os.path.expanduser("~")
    for base in [os.path.join(data_home(), "themes"), os.path.join(home, ".themes")] + \
            [os.path.join(d, "themes") for d in system_data_dirs()]:
        for part in ("labwc/themerc", "openbox-3/themerc"):
            path = os.path.join(base, name, part)
            if os.path.isfile(path):
                return path
    return None


def explain_style(ctx):
    style = ctx["style"]
    lines = [f"{style.name} ({style.id})" + (f", yours, inherits {style.parent}" if style.user and style.parent
                                            else ", yours" if style.user
                                            else f", inherits {style.parent}" if style.parent else ""),
             f"from {shown_path(style.folder)}"]
    if tried_style_id() == style.id:
        lines.append("trying it until you log out (flickos-layout try --end, or style set to keep it)")
    lines += style_fallback_messages(style)
    if plain_session():
        lines.append("plain session: your own styles are left out")
    return lines


def explain_labwc(ctx):
    root, lines = ctx["root"], []
    plain = os.path.join(root, PLAIN_LABWC) if root else None
    if plain_session() and plain and os.path.isdir(plain):
        lines.append(f"plain session: labwc -C {plain}, FlickOS's files only:")
        lines += [f"  {name} -> {shown_path(os.readlink(os.path.join(plain, name)))}"
                  for name in sorted(os.listdir(plain)) if os.path.islink(os.path.join(plain, name))]
        rc_files = [os.path.join(plain, "rc.xml")]
    elif root and os.path.exists(os.path.join(root, MERGE_MARKER)):
        rc_files = config_files(os.path.join("labwc", "rc.xml"))[::-1]
        lines.append("merges every rc.xml, a later key or setting winning:")
        lines += [f"  {labelled(path, ctx)}" for path in rc_files]
    else:
        merge, why, _file = merge_decision(root)
        lines.append("not merging: " + MERGE_REASONS[why] if why else
                     "not merging until you log out and in" if merge else "not merging")
        rc_files = config_files(os.path.join("labwc", "rc.xml"))[:1]
        if not rc_files:
            lines.append("rc.xml: none found, labwc's built-in defaults")
        elif is_users(rc_files[0]):
            lines.append(f"rc.xml: {shown_path(rc_files[0])} (yours: it replaces FlickOS's, so the layout's "
                         "window buttons and theme, desktop clicks, tiling and Settings' input options don't "
                         "apply)")
        else:
            lines.append(f"rc.xml: {labelled(rc_files[0], ctx)}")
        for name in ("menu.xml", "environment", "themerc-override"):
            found = config_files(os.path.join("labwc", name))[:1]
            if found:
                lines.append(f"{name}: {labelled(found[0], ctx)}")
    theme = None
    for path in rc_files:
        with contextlib.suppress(OSError, ET.ParseError):
            theme = ET.parse(path).getroot().findtext("theme/name") or theme
    if theme:
        found = theme_file(theme)
        lines.append(f"window theme {theme}: " + (shown_path(found) if found else "not installed"))
    return lines


CSS_IMPORT = re.compile(r"""@import url\((["']?)(.*?)\1\)""")


def explain_panel(ctx):
    mine = user_waybar_config()
    if mine:
        return [f"{shown_path(mine)} (yours: layouts and styles don't change the panel)"]
    root = ctx["root"]
    config = os.path.join(root, "waybar", "config.jsonc") if root else None
    css = os.path.join(root, "waybar", "style.css") if root else None
    if not config or not os.path.isfile(config):
        return ["not generated yet: flickos-layout panel makes it at login"]
    lines = [f"{config} (generated for the {ctx['layout'].name} layout)", f"CSS {css}, imports in order:"]
    try:
        with open(css, encoding="utf-8") as f:
            imports = [m.group(2).replace('\\"', '"') for m in CSS_IMPORT.finditer(f.read())]
    except (OSError, UnicodeDecodeError):
        imports = []
    lines += [f"  {labelled(path, ctx)}" for path in imports]
    tweaks = tweaks_css()
    if tweaks and tweaks not in imports:
        lines.append(f"  {shown_path(tweaks)} (your tweaks: left out, flickos-layout check says why)")
    return lines


def explain_dock(ctx):
    layout, root = ctx["layout"], ctx["root"]
    if layout.dock is None:
        return [f"none: the {layout.name} layout has no dock"]
    config = os.path.join(root, "dock", "sfwbar.config") if root else None
    lines = [f"{config} (generated: {shown_path(layout.dock)}, then the colors and CSS copied in)"
             if config and os.path.isfile(config) else "not generated yet: flickos-layout panel makes it at login"]
    lines += [f"  {labelled(path, ctx)}" for path in palette_chain(ctx["style"], "waybar") + [layout.dock_style]]
    tweaks = tweaks_css()
    if tweaks and config and f"/* Your tweaks: {tweaks} */" in (text_of(config) or ""):
        lines.append(f"  {labelled(tweaks, ctx)}")
    return lines


def explain_config(relative, ctx, program):
    """foot's or fuzzel's config: the first found and what it includes."""
    found = config_files(relative)[:1]
    if not found:
        return ["no config: its built-in defaults"]
    lines = chain_lines(include_chain(found[0]), ctx)
    root = ctx["root"]
    stable = os.path.join(root, STYLE_PALETTES, os.path.basename(relative)) if root else None
    if is_users(found[0]) and stable and not any(path == stable for path, _d, _e in include_chain(found[0])):
        lines.append(f"styles don't change its colors: include={stable} in it to follow them")
    return lines


def explain_mako(ctx):
    mine = user_mako_config()
    root = ctx["root"]
    path = mine or (os.path.join(root, "mako", "config") if root else None)
    if not path or not os.path.isfile(path):
        return ["not generated yet: flickos-layout panel makes it at login"]
    lines = chain_lines(include_chain(path), ctx)
    if mine:
        lines.append("styles don't change notifications while you have your own config")
    return lines


def explain_gtk(ctx):
    style, available = ctx["style"], ctx["styles"]
    lines = []
    for key, attribute, what in (("gtk-theme", "gtk_theme", "theme"), ("icon-theme", "icon_theme", "icons")):
        value = gsettings_get(key)
        if value is None:
            lines.append(f"{what}: GSettings can't be read")
            continue
        if value == getattr(style, attribute):
            whose = f"the {style.name} style's"
        elif value in {getattr(s, attribute) for s in available.values()}:
            whose = "another style's"
        else:
            whose = "chosen in Appearance: styles don't change it"
        lines.append(f"{what} {value} ({whose})")
    scheme = gsettings_get("color-scheme")
    if scheme is not None:
        lines.append(f"color scheme {scheme}")
    return lines


def explain_wallpaper(ctx):
    source, image, _command = wallpaper(ctx["layout"], ctx["style"])
    whose = {"waypaper": "chosen in Wallpaper", "user": "yours, ~/.config/flickos/wallpaper",
             "layout": f"the {ctx['layout'].name} layout's", "style": f"the {ctx['style'].name} style's",
             "default": "FlickOS's default"}[source]
    return [f"{shown_path(image) if image else 'a plain color'} ({whose})"]


def explain(program=None):
    """[line] of explain's output, every program or one."""
    with contextlib.redirect_stderr(io.StringIO()):
        available = styles()
        ctx = {"styles": available, "style": resolve_style(available), "layout": resolve_layout(layouts()),
               "root": runtime_root(), "addons": addons()}
    makers = {"style": explain_style, "labwc": explain_labwc, "panel": explain_panel, "dock": explain_dock,
              "foot": lambda c: explain_config(os.path.join("foot", "foot.ini"), c, "foot"),
              "fuzzel": lambda c: explain_config(os.path.join("fuzzel", "fuzzel.ini"), c, "fuzzel"),
              "mako": explain_mako, "gtk": explain_gtk, "wallpaper": explain_wallpaper}
    lines = []
    for name in [program] if program else EXPLAIN_PROGRAMS:
        block = makers[name](ctx) or [""]
        lines.append(f"{name:<{EXPLAIN_WIDTH}}{block[0]}")
        lines += [" " * EXPLAIN_WIDTH + line for line in block[1:]]
    return lines


def cmd_explain(opts):
    for line in explain(opts.program):
        print(line)
    return 0


def text_of(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return None


def merge_decision(root):
    """(merge, why, file): whether labwc should merge the user's labwc files
    with FlickOS's (ADR-003). why is None, or "live", "plain", "copy",
    "default", "menu" or "autostart"; file the user's file it is about."""
    if live_system():
        return False, "live", None
    if plain_session():
        return False, "plain", None
    folder = os.path.join(config_home(), "labwc")
    rcxml = os.path.join(folder, "rc.xml")
    text = text_of(rcxml)
    if text is not None:
        if FLICKOS_RCXML_MARK in text:
            return False, "copy", rcxml
        if DEFAULT_ELEMENT.search(XML_COMMENT.sub("", text)):
            return False, "default", rcxml
    menu = os.path.join(folder, "menu.xml")
    text = text_of(menu)
    if text is not None and menu_conflicts(root, text):
        return False, "menu", menu
    autostart = os.path.join(folder, "autostart")
    if os.path.exists(autostart):
        return False, "autostart", autostart
    return True, None, None


def menu_conflicts(root, text):
    """The menu ids a user's menu.xml shares with the system's (labwc keeps
    the first one read, so the user's would be ignored under -m)."""
    system = text_of(find_base_rcxml(root or "/nonexistent", "menu.xml") or "")
    flickos = set(MENU_ID.findall(XML_COMMENT.sub("", system or "")))
    return sorted(flickos & set(MENU_ID.findall(XML_COMMENT.sub("", text))))


MERGE_REASONS = {
    "live": "the live session",
    "plain": "the plain session",
    "copy": "your rc.xml is a copy of FlickOS's",
    "default": "your rc.xml has <default />",
    "menu": "your menu.xml uses FlickOS's menu ids",
    "autostart": "you have your own labwc autostart",
}


# While this session merges, a <default /> added since login loads labwc's
# own keys over FlickOS's at the next reload, not only after the next login.
DEFAULT_WHILE_MERGING = ("Until then labwc's own keys replace FlickOS's (Super+Enter, Alt+F3, Super+A, the volume "
                         "keys, the desktop clicks): delete the <default /> lines and run labwc --reconfigure to "
                         "get them back now.")


def default_while_merging(root, why):
    """The <default /> case that breaks FlickOS's keys in this session."""
    return in_session() and why == "default" and labwc_merges(root)


def labwc_merges(root):
    """Does this session's labwc merge (the marker prepare wrote at login)?"""
    return bool(root) and os.path.exists(os.path.join(root, MERGE_MARKER))


def update_merge_marker(root):
    """At login (outside the session) write or delete the marker from
    merge_decision(). Inside the session labwc's -m can't change until the
    next login, so the marker stays as it is."""
    if in_session():
        return
    marker = os.path.join(root, MERGE_MARKER)
    if merge_decision(root)[0]:
        write_atomic(marker, "labwc runs with -m (flickos-layout explain labwc)\n")
    else:
        remove(marker)


# --- try, export, import ----------------------------------------------------------

def read_try_record():
    try:
        with open(try_record_path(), encoding="utf-8") as f:
            record = json.load(f)
    except (OSError, ValueError):
        return None
    return record if isinstance(record, dict) else None


def forget_try():
    for path in (try_record_path(), try_path()):
        if path:
            remove(path)


def end_try():
    """End a try: each GSettings key still holding what the try wrote gets
    its value from before the try (a key the user changed meanwhile is
    kept), and both try files go. Returns the tried style's id, or None."""
    record, path = read_try_record(), try_path()
    tried = (record or {}).get("style") or (read_first_line(path) if path else None)
    if record:
        before, wrote = record.get("before") or {}, record.get("set") or {}
        for key in TRY_KEYS:
            old, current = before.get(key), gsettings_get(key)
            if isinstance(old, str) and current is not None and current == wrote.get(key) and old != current:
                gsettings_set(key, old)
    forget_try()
    return tried


def cmd_try(opts):
    if opts.end:
        tried = end_try()
        if tried is None:
            print("Not trying a style.")
            return 0
        if in_session():
            with contextlib.redirect_stdout(io.StringIO()):
                reapply_style()
        with contextlib.redirect_stderr(io.StringIO()):
            print(f"Style '{resolve_style(styles()).name}' again.")
        return 0
    if opts.id is None:
        warn("try: give a style, or --end")
        return 2
    if plain_session():
        warn("the plain session doesn't change your choices; log in normally to try a style")
        return 1
    if not in_session():
        warn("try shows a style until you log out: run it in a terminal on the desktop")
        return 1
    errors = [problem for problem in style_problems(opts.id) if problem.level == "error"]
    with contextlib.redirect_stderr(io.StringIO()):
        available = styles()
    if errors or opts.id not in available:
        for problem in errors:
            warn(str(problem))
        warn(f"style {opts.id} can't be tried: " + ("it has errors (flickos-layout check " + opts.id + ")"
                                                   if errors else f"no such style. Available: {', '.join(available)}"))
        return 1
    record = read_try_record()
    before = record.get("before") if record and isinstance(record.get("before"), dict) else \
        {key: gsettings_get(key) for key in TRY_KEYS}
    os.makedirs(required_root("try"), mode=0o700, exist_ok=True)
    write_atomic(try_path(), opts.id + "\n")
    try:
        with contextlib.redirect_stdout(io.StringIO()):
            reapply_style()
    finally:
        os.makedirs(os.path.dirname(try_record_path()), exist_ok=True)
        write_atomic(try_record_path(), json.dumps({"v": 1, "style": opts.id, "before": before,
                                                    "set": {key: gsettings_get(key) for key in TRY_KEYS}}) + "\n")
    print(f"Trying style '{available[opts.id].name}' until you log out: flickos-layout style set {opts.id} keeps "
          "it, flickos-layout try --end ends it now.")
    return 0


class Refused(Exception):
    """An archive import refuses, with the reason."""


def user_chain(style, available):
    """The style and its parents while they are the user's own, nearest first."""
    chain = [style]
    while chain[-1].user and chain[-1].parent in available and available[chain[-1].parent] not in chain \
            and available[chain[-1].parent].user:
        chain.append(available[chain[-1].parent])
    return chain


def export_files(style, available, raw):
    """{file name: bytes} of an exported style: what the user's own styles in
    its chain set, folded together, Inherits= the nearest one that isn't theirs."""
    chain = user_chain(style, available)
    base = available.get(chain[-1].parent)
    keys = {}
    for item in reversed(chain):
        section = raw.get(item.id, (None, None, None, None))[2] or {}
        for key in EXPORT_KEYS:
            if section.get(key.lower()):
                keys[key] = section[key.lower()]
    lines = ["[Style]", f"Name={style.name}"] + ([f"Comment={style.comment}"] if style.comment else [])
    lines += [f"Inherits={base.id}"] if base else []
    lines += [f"{key}={value}" for key, value in keys.items()]
    files, folders = {}, [item.folder for item in chain]
    for key, name in STYLE_FILE_KEYS.items():
        paths = [path for path in palette_chain(style, key.lower())
                 if any(is_below(path, folder) for folder in folders)]
        if not paths:
            continue
        if key == "Waybar":
            text = "".join(f"@define-color {n} {v};\n" for n, v in merged_css(paths).items())
        else:
            text = "".join((f"[{section}]\n" if section else "") + "".join(f"{k}={v}\n" for k, v in values.items())
                           for section, values in merged_ini(paths).items())
        if not text:
            continue                    # a starter's file with every line commented out
        files[name] = text.encode()
        lines.append(f"{key}={name}")
    if style.wallpaper and any(is_below(style.wallpaper, folder) for folder in folders):
        name = "wallpaper" + os.path.splitext(style.wallpaper)[1].lower()
        if name in IMPORT_WALLPAPERS:
            with open(style.wallpaper, "rb") as f:
                files[name] = f.read()
            lines.append(f"Wallpaper={name}")
    files["style.ini"] = ("\n".join(lines) + "\n").encode()
    return files


def cmd_export(opts):
    import tarfile
    errors = [problem for problem in style_problems(opts.id) if problem.level == "error"]
    if errors:
        for problem in errors:
            warn(str(problem))
        warn(f"style {opts.id} has errors: not exported")
        return 1
    with contextlib.redirect_stderr(io.StringIO()):
        available = styles()
    style = available.get(opts.id)
    if style is None or not style.user:
        warn(f"export: {opts.id} isn't one of your own styles" + (" (FlickOS's styles are everyone's already)"
                                                               if style else ""))
        return 1
    out = opts.file or f"{opts.id}.tar.gz"
    try:
        files = export_files(style, available, raw_styles())
        with open(out, "xb") as f:
            try:
                with tarfile.open(fileobj=f, mode="w:gz") as tar:
                    folder = tarfile.TarInfo(opts.id)
                    folder.type, folder.mode = tarfile.DIRTYPE, 0o755
                    tar.addfile(folder)
                    for name, data in files.items():
                        member = tarfile.TarInfo(f"{opts.id}/{name}")
                        member.size, member.mode = len(data), 0o644
                        tar.addfile(member, io.BytesIO(data))
            except BaseException:
                remove(out)
                raise
    except FileExistsError:
        warn(f"{out} exists already; give another file name")
        return 1
    except OSError as error:
        warn(f"can't write {out}: {error.strerror or error}")
        return 1
    print(out)
    return 0


def archive_bytes(path):
    """The archive unpacked (gzip, xz, bzip2 or plain tar), refused past IMPORT_MAX_BYTES."""
    import bz2
    import gzip
    import lzma
    with open(path, "rb") as f:
        magic = f.read(6)
    opener = (gzip.open if magic[:2] == b"\x1f\x8b" else lzma.open if magic == b"\xfd7zXZ\x00"
              else bz2.open if magic[:3] == b"BZh" else open)
    data = bytearray()
    try:
        with opener(path, "rb") as f:
            while chunk := f.read(1 << 16):
                data += chunk
                if len(data) > IMPORT_MAX_BYTES:
                    raise Refused(f"it unpacks to more than {IMPORT_MAX_BYTES // (1024 * 1024)} MB; a style is "
                                  "smaller")
    except (OSError, EOFError, lzma.LZMAError, ValueError) as error:
        raise Refused(f"it isn't a style archive ({error})") from None
    return io.BytesIO(bytes(data))


def archive_members(tar):
    """Every header checked before any file is read: (style id, {file name: member})."""
    style_id, found = None, {}
    for count, member in enumerate(iter(tar.next, None), 1):
        if count > IMPORT_MAX_MEMBERS:
            raise Refused(f"it holds more than {IMPORT_MAX_MEMBERS} entries; a style has style.ini, four color "
                          "files and a wallpaper")
        name = member.name.removeprefix("./")
        parts = name.rstrip("/").split("/")
        if name.startswith("/") or ".." in parts or len(parts) > 2 or not parts[0]:
            raise Refused(f"{member.name}: only files in one folder, named after the style, may be in it")
        if style_id is None:
            style_id = parts[0]
        elif parts[0] != style_id:
            raise Refused(f"{member.name}: it holds more than one folder ({style_id}, {parts[0]})")
        if len(parts) == 1:
            if not member.isdir():
                raise Refused(f"{member.name}: the style's folder isn't a folder")
            continue
        if not member.isreg():
            kind = "link" if member.issym() or member.islnk() else "special file"
            raise Refused(f"{member.name}: a {kind}; only plain files may be in a style")
        if parts[1] not in IMPORT_TEXT_FILES + IMPORT_WALLPAPERS:
            raise Refused(f"{member.name}: not one of a style's files ({', '.join(IMPORT_TEXT_FILES)}, "
                          f"{IMPORT_WALLPAPERS[0]} or .jpg)")
        if parts[1] in found:
            raise Refused(f"{member.name}: it is in the archive twice")
        if parts[1] in IMPORT_WALLPAPERS and any(w in found for w in IMPORT_WALLPAPERS):
            raise Refused(f"{member.name}: a second wallpaper")
        limit = IMPORT_MAX_WALLPAPER if parts[1] in IMPORT_WALLPAPERS else IMPORT_MAX_TEXT
        if member.size > limit:
            raise Refused(f"{member.name}: {member.size} bytes; a style's {parts[1]} has at most {limit}")
        found[parts[1]] = member
    if style_id is None or "style.ini" not in found:
        raise Refused("it has no style.ini, so it isn't a style")
    if not LAYOUT_ID.match(style_id):
        raise Refused(f"'{style_id}' can't be a style id: lowercase letters, digits, - and _")
    return style_id, found


def keep_with_warnings(yes):
    """Ask before keeping a style with warnings (HIG A11Y-6's contrast, themes)."""
    if yes:
        return True
    if not sys.stdin.isatty():
        warn("it has warnings: add --yes to keep it anyway")
        return False
    try:
        return input("Keep it? [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        return False


def import_style(path, replace=False, yes=False):
    """Add the style in archive path to the user's folder (ADR-006): every
    header first, then the files, then check on a scratch copy. Returns its id."""
    import tarfile
    try:
        tar = tarfile.open(fileobj=archive_bytes(path))
    except tarfile.TarError as error:
        raise Refused(f"it isn't a style archive ({error})") from None
    with tar:
        try:
            style_id, members = archive_members(tar)
        except tarfile.TarError as error:
            raise Refused(f"it isn't a style archive ({error})") from None
        if style_id in raw_styles(users=False):
            raise Refused(f"{style_id} is one of FlickOS's styles; the archive's folder needs another name")
        styles_dir = user_styles_dir()
        target = os.path.join(styles_dir, style_id)
        if os.path.exists(target) and not replace:
            raise Refused(f"you have a style {style_id} already ({shown_path(target)}); add --replace to "
                          "replace it")
        os.makedirs(styles_dir, exist_ok=True)
        scratch = tempfile.mkdtemp(prefix=".import-", dir=styles_dir)
        try:
            folder = os.path.join(scratch, style_id)
            os.mkdir(folder)
            for name, member in members.items():
                data = tar.extractfile(member).read(member.size + 1)
                if len(data) != member.size:
                    raise Refused(f"{member.name}: shorter than its header says")
                with open(os.path.join(folder, name), "xb") as f:
                    f.write(data)
            entry = raw_style(folder, True)
            for key in tuple(STYLE_FILE_KEYS) + ("Wallpaper",):
                value = (entry[2] or {}).get(key.lower())
                if value and value not in members:
                    raise Refused(f"{style_id}/style.ini: {key}={value} isn't one of the style's own files")
            raw = raw_styles()
            raw[style_id] = entry
            problems = style_problems(style_id, raw)
            shown = os.path.basename(path) + ":"
            for problem in problems:
                print(str(problem).replace(scratch + os.sep, shown))
            if any(problem.level == "error" for problem in problems):
                raise Refused(f"{style_id} has errors (above)")
            if problems and not keep_with_warnings(yes):
                raise Refused(f"{style_id} not kept")
            if os.path.exists(target):
                os.rename(target, os.path.join(scratch, "replaced"))
            os.rename(folder, target)
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
    return style_id


def cmd_import(opts):
    try:
        style_id = import_style(opts.file, opts.replace, opts.yes)
    except Refused as error:
        warn(f"{opts.file} not imported: {error}")
        return 1
    except OSError as error:
        warn(f"{opts.file} not imported: {error.strerror or error}")
        return 1
    print(f"Imported the style {style_id}. Try it until you log out: flickos-layout try {style_id}")
    return 0


# --- watch: apply each save at once ------------------------------------------------

class Inotify:
    """inotify through ctypes (the standard library has no module for it):
    a blocking read while nothing happens, so the process never wakes up
    idle (PERF-5)."""

    def __init__(self):
        import ctypes
        self.libc = ctypes.CDLL(None, use_errno=True)
        self.fd = self.libc.inotify_init1(IN_CLOEXEC)
        if self.fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1 failed")
        self.folders = {}           # watch descriptor -> folder
        self.recursive = set()      # folders watched with their subfolders

    def add(self, folder, recursive=True):
        """Watch folder and, recursive, every folder below it. Returns what
        newly watched folders already hold: saved before the watch began."""
        found = set()
        for root, dirs, files in os.walk(folder) if recursive else [(folder, [], [])]:
            if root not in self.folders.values():
                wd = self.libc.inotify_add_watch(self.fd, os.fsencode(root), WATCH_MASK)
                if wd >= 0:
                    self.folders[wd] = root
                    found.update(os.path.join(root, name) for name in dirs + files)
        if recursive:
            self.recursive.add(folder)
        return {path for path in found if not watch_ignored(path)}

    def watch(self, targets):
        """Watch each target folder, or while it is missing its nearest
        existing parent alone, so that making it is seen. Returns what
        newly watched targets already hold."""
        found = set()
        for folder in targets:
            parent = folder
            while not os.path.isdir(parent) and parent != os.path.dirname(parent):
                parent = os.path.dirname(parent)
            if parent == folder:
                found |= self.add(folder)
            else:
                self.add(parent, recursive=False)
        return found

    def read_batch(self, quiet_ms=WATCH_QUIET_MS):
        """Wait for changes, then collect them until quiet_ms pass without
        one. Returns the changed paths; new folders below a recursive watch
        are watched at once."""
        import select
        import struct
        changed = set()
        data = os.read(self.fd, 65536)
        while True:
            offset = 0
            while offset + 16 <= len(data):
                wd, mask, _cookie, length = struct.unpack_from("iIII", data, offset)
                name = os.fsdecode(data[offset + 16:offset + 16 + length].split(b"\0", 1)[0])
                offset += 16 + length
                folder = self.folders.get(wd)
                if folder is None:
                    continue
                if mask & IN_IGNORED:           # the folder is gone
                    del self.folders[wd]
                    self.recursive.discard(folder)
                    continue
                path = os.path.join(folder, name) if name else folder
                if mask & IN_CREATE and os.path.isdir(path) and any(is_below(path, r) for r in self.recursive):
                    changed |= self.add(path)
                if not watch_ignored(path):
                    changed.add(path)
            ready, _, _ = select.select([self.fd], [], [], quiet_ms / 1000)
            if not ready:
                return changed
            data = os.read(self.fd, 65536)

    def close(self):
        os.close(self.fd)


def watch_ignored(path):
    """An editor's swap, backup or temp file: its save shows as the real
    file's rename or write."""
    name = os.path.basename(path)
    return name.startswith((".", "#")) or name.endswith(("~", ".swp", ".swx", ".tmp")) or name == "4913"


def watch_targets():
    """The folders watch looks at: the user's styles, layouts, add-ons and
    panel tweaks, and their labwc, foot, fuzzel and mako config folders."""
    home = config_home()
    return [user_styles_dir(), user_layouts_dir(), os.path.join(home, ADDONS_HOME), tweaks_folder()] + \
        [os.path.join(home, name) for name in ("labwc",) + WATCH_PROGRAMS + ("mako",)]


def style_lineage(style, available):
    """The style's id and its parents' ids, nearest first."""
    ids = []
    while style is not None and style.id not in ids:
        ids.append(style.id)
        style = available.get(style.parent) if style.parent else None
    return ids


def watch_actions(paths, current, available, chosen=DEFAULT_CHOICE, layout=None, chosen_layout=DEFAULT_CHOICE):
    """What a batch of changed paths needs, in the order to do it: a list of
    (action, argument). current: the style in use; available: styles();
    chosen: the user's saved style, which isn't the one in use while it
    has errors; layout and chosen_layout: the same for layouts."""
    home, styles_dir, layouts_dir = config_home(), user_styles_dir(), user_layouts_dir()
    lineage = style_lineage(current, available)
    actions, checks, layout_checks = [], [], []

    def add(action):
        if action not in actions:
            actions.append(action)
    for path in sorted(paths):
        if is_below(path, styles_dir) and not is_below(styles_dir, path):
            style_id = os.path.relpath(path, styles_dir).split(os.sep)[0]
            if style_id in lineage:
                # style.ini may name other themes, a wallpaper or a parent
                whole = os.path.basename(path) == "style.ini" or path == os.path.join(styles_dir, style_id)
                add(("style" if whole else "palette", current.id))
            elif style_id == chosen:
                add(("style", chosen))
            elif LAYOUT_ID.match(style_id) and os.path.isdir(os.path.join(styles_dir, style_id)):
                if style_id not in checks:
                    checks.append(style_id)
        elif is_below(path, layouts_dir) and not is_below(layouts_dir, path):
            layout_id = os.path.relpath(path, layouts_dir).split(os.sep)[0]
            if layout is not None and layout_id == layout.id:
                # layout.ini may change the desktops, corners or title bar buttons
                whole = os.path.basename(path) == "layout.ini" or path == os.path.join(layouts_dir, layout_id)
                add(("layout" if whole else "panel", layout_id))
            elif layout_id == chosen_layout:
                add(("layout", layout_id))
            elif LAYOUT_ID.match(layout_id) and os.path.isdir(os.path.join(layouts_dir, layout_id)):
                if layout_id not in layout_checks:
                    layout_checks.append(layout_id)
        elif is_below(path, os.path.join(home, ADDONS_HOME)):
            add(("addons", None))
        elif is_below(path, tweaks_folder()):
            add(("tweaks", None))
        elif is_below(path, os.path.join(home, "labwc")):
            add(("labwc", None))
        elif is_below(path, os.path.join(home, "mako")):
            add(("mako", None))
        else:
            for program in WATCH_PROGRAMS:
                if is_below(path, os.path.join(home, program)):
                    add(("new-windows", program))
    if ("style", current.id) in actions and ("palette", current.id) in actions:
        actions.remove(("palette", current.id))
    for action in [a for a in actions if a[0] == "panel" and ("layout", a[1]) in actions]:
        actions.remove(action)
    # the style first: it reloads mako too
    actions.sort(key=lambda action: action[0] not in ("style", "palette"))
    return actions + [("check", style_id) for style_id in checks] + \
        [("check-layout", layout_id) for layout_id in layout_checks]


def watch_say(text):
    print(f"{time.strftime('%H:%M:%S')} {text}", flush=True)


def reload_panel_programs(layout, style):
    """Regenerate the panel, dock, notification and palette files, then have
    FlickOS's waybars (SIGUSR2), docks (SIGHUP) and mako (makoctl reload)
    read them again without a restart (spike Q8b-d). Returns what was reloaded."""
    update_style_files(required_root("panel"), style)
    done = []
    for name, generate, running, how in (
            ("panel", lambda: waybar_command(layout, style), managed_waybars, signal.SIGUSR2),
            ("dock", lambda: dock_command(layout, style), managed_docks, signal.SIGHUP)):
        try:
            if not generate():
                continue
        except LayoutError as error:
            watch_say(f"{error}; the {name} is not changed")
            continue
        for pid in running():
            with contextlib.suppress(OSError):
                os.kill(pid, how)
                if name not in done:
                    done.append(name)
    try:
        mako_command(style)
    except LayoutError as error:
        watch_say(f"{error}; notifications are not changed")
    else:
        # only while running: makoctl would start a plain mako (D-Bus activation)
        if own_processes("mako"):
            run_quiet(["makoctl", "reload"])
            done.append("notifications")
    return done


def reapply_style():
    """What `style set` does for the style in use, without saving a choice:
    themes, labwc, the panel programs and the wallpaper."""
    available, available_styles = layouts(), styles()
    with locked():
        layout, style = resolve_layout(available), resolve_style(available_styles)
        warn_style_fallbacks(style)
        style_gsettings(style, available_styles)
        prepare(layout, style, labwc_themes(available_styles), resolve_clicks(), resolve_launcher(),
                resolve_menu_style(), resolve_quick_settings())
        run_quiet(["labwc", "--reconfigure"])
        done = reload_panel_programs(layout, style)
        restart_wallpaper(layout, style)
    return done


def say_problems(style_id):
    """Print a style's problems; True while it has errors."""
    problems = style_problems(style_id)
    for problem in problems:
        watch_say(str(problem))
    return any(problem.level == "error" for problem in problems)


def say_layout_problems(layout_id):
    """Print a layout's problems; True while it has errors (or is gone)."""
    folders = layout_folders()
    if layout_id not in folders:
        watch_say(f"{layout_id}: no layout.ini")
        return True
    problems = layout_problems(layout_id, folders)
    for problem in problems:
        watch_say(str(problem))
    return any(problem.level == "error" for problem in problems)


def watch_apply(action, argument):
    """Do one of watch_actions' actions and say what was done."""
    if action == "check-layout":
        if not say_layout_problems(argument):
            watch_say(f"{argument}: no errors (not the layout in use)")
    elif action in ("panel", "layout"):
        if say_layout_problems(argument):
            watch_say(f"{argument}: not applied, fix the errors above")
            return
        if action == "panel":
            root = runtime_root()
            before = desktop_buttons(root)
            with locked():
                done = reload_panel_programs(resolve_layout(layouts()), resolve_style(styles()))
            if desktop_buttons(root) == before:
                watch_say(f"{argument}: {', '.join(done) or 'nothing'} reloaded")
                return
            # waybar's supervisor follows the desktops only if the panel had
            # buttons when it started: start it again.
        with contextlib.redirect_stdout(io.StringIO()):
            status = apply_choice(layout_id=user_choice("layout"))
        watch_say(f"{argument}: applied" if status == 0 else f"{argument}: not applied (see above)")
    elif action == "check":
        if not say_problems(argument):
            watch_say(f"{argument}: no errors (not the style in use)")
    elif action in ("palette", "style"):
        if say_problems(argument):
            watch_say(f"{argument}: not applied, fix the errors above")
            return
        if action == "palette":
            with locked():
                done = reload_panel_programs(resolve_layout(layouts()), resolve_style(styles()))
        else:
            done = ["themes", "window borders"] + reapply_style()
        watch_say(f"{argument}: {', '.join(done + ['new foot and fuzzel windows'])} use it")
    elif action == "addons":
        status = cmd_reconfigure(None)
        with locked():
            done = reload_panel_programs(resolve_layout(layouts()), resolve_style(styles()))
        for problem in addon_problems():
            watch_say(str(problem))
        watch_say("add-ons: " + ", ".join(["keys and window rules"] + [d for d in done if d != "notifications"])
                  + (" reloaded" if status == 0 else " not reloaded, the overlay failed"))
    elif action == "tweaks":
        problems = tweaks_problems()
        for problem in problems:
            watch_say(str(problem))
        if problems:
            watch_say("tweaks: not applied, fix the error above; the panel is as it was")
            return
        with locked():
            done = reload_panel_programs(resolve_layout(layouts()), resolve_style(styles()))
        watch_say("tweaks: " + (", ".join(d for d in done if d != "notifications") or "nothing") + " reloaded")
    elif action == "labwc":
        for problem in labwc_problems():
            watch_say(str(problem))
        run_quiet(["labwc", "--reconfigure"])
        root = runtime_root()
        merge, why, _file = merge_decision(root)
        if merge != labwc_merges(root):
            watch_say("labwc: reloaded; whether your files are merged with FlickOS's changes at your next "
                      "login (flickos-layout explain labwc)")
            if default_while_merging(root, why):
                watch_say(DEFAULT_WHILE_MERGING)
        else:
            watch_say("labwc: reloaded")
    elif action == "mako":
        if own_processes("mako"):
            run_quiet(["makoctl", "reload"])
        watch_say("mako: reloaded")
    elif action == "new-windows":
        watch_say(f"{argument}: new windows use the changed config")


def cmd_watch(opts):
    if plain_session():
        warn("the plain session leaves your own files out: nothing to watch")
        return 1
    if not in_session():
        warn("watch applies your changes to the desktop: run it in a terminal there")
        return 1
    root = required_root("watch")
    os.makedirs(root, mode=0o700, exist_ok=True)
    with open(os.path.join(root, WATCH_LOCK), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            warn("already watching (in another terminal)")
            return 1
        try:
            inotify = Inotify()
        except OSError as error:
            warn(f"can't watch files: {error}")
            return 1
        targets = watch_targets()
        inotify.watch(targets)
        count = len(inotify.folders)
        watch_say(f"watching {count} folder{'' if count == 1 else 's'}: your styles, layouts, add-ons, panel tweaks, "
                  "labwc, foot, fuzzel and mako files; Ctrl+C to stop")
        try:
            while True:
                paths = inotify.read_batch()
                paths |= inotify.watch(targets)     # folders made since
                with contextlib.redirect_stderr(io.StringIO()):
                    available = styles()
                    current = resolve_style(available)
                    layout = resolve_layout(layouts())
                for action, argument in watch_actions(paths, current, available, user_choice("style"), layout,
                                                      user_choice("layout")):
                    try:
                        watch_apply(action, argument)
                    except LayoutError as error:
                        watch_say(str(error))
        except KeyboardInterrupt:
            return 0
        finally:
            inotify.close()


def update_plain(root):
    """In the plain session, keep root/plain/labwc/ as links to FlickOS's own
    labwc files, the overlay's where it has one (rc.xml, environment), for
    labwc -C; delete it otherwise. Run after every change to the overlay's
    labwc files: the overlay rc.xml comes and goes with the layout and style."""
    folder = os.path.join(root, PLAIN_LABWC)
    if not plain_session():
        if os.path.isdir(folder):
            shutil.rmtree(os.path.dirname(folder), ignore_errors=True)
        return None
    os.makedirs(folder, exist_ok=True)
    for name in PLAIN_FILES:
        overlay = os.path.join(overlay_xdg(root), "labwc", name)
        source = overlay if os.path.isfile(overlay) else find_base_rcxml(root, name)
        link = os.path.join(folder, name)
        if source is None or not os.path.isfile(source):
            remove(link)
            continue
        if os.path.islink(link) and os.readlink(link) == source:
            continue
        temporary = link + ".new"
        remove(temporary)
        os.symlink(source, temporary)
        os.replace(temporary, link)
    return folder


# --- Style overlay: foot, fuzzel, mako ----------------------------------------

def palette_chain(style, kind):
    """The style's palette files of a kind ("waybar", "foot", …), parent's first."""
    return style.chain.get(kind) or [getattr(style, kind)]


def include_file(style, base, palettes):
    """A config for foot, fuzzel or mako: the system config (None: none), then
    the style's colors, parent's first."""
    lines = [f"# Generated by flickos-layout at every login for the {style.name} style. Do not edit."]
    lines += [f"include={path}" for path in ([base] if base else []) + list(palettes)]
    return "\n".join(lines) + "\n"


def update_style_files(root, style):
    """Write or delete the foot and fuzzel overlay files. The BASE_STYLE needs
    none. Also write the style's palettes for users' own configs (STABLE_PALETTES)."""
    xdg = overlay_xdg(root)
    for name, base, kind in (("foot/foot.ini", BASE_FOOT, "foot"), ("fuzzel/fuzzel.ini", BASE_FUZZEL, "fuzzel")):
        target = os.path.join(xdg, name)
        palettes = palette_chain(style, kind)
        missing = [path for path in [base] + palettes if not os.path.isfile(path)]
        if style.id == BASE_STYLE:
            remove(target)
        elif missing:
            warn(f"{' and '.join(missing)} not found; {kind} keeps the default colors")
            remove(target)
        else:
            write_atomic(target, include_file(style, base, palettes))
    for name, kind in STABLE_PALETTES:
        write_atomic(os.path.join(root, STYLE_PALETTES, name), include_file(style, None, palette_chain(style, kind)))


def update_mako(root, style):
    """Generate root/mako/config for style. Returns its path."""
    for path in [BASE_MAKO] + palette_chain(style, "mako"):
        if not os.path.isfile(path):
            raise LayoutError(f"style {style.id}: {path} not found")
    target = os.path.join(root, "mako", "config")
    write_atomic(target, include_file(style, BASE_MAKO, palette_chain(style, "mako")))
    return target


def update_menu(root, anchor, style=DEFAULT_MENU_STYLE):
    """Write the start menu's corner and style to MENU_ANCHOR while it is on
    (flickos-menu reads it at every show), or delete it. Written only when it
    changes."""
    target = os.path.join(root, MENU_ANCHOR)
    if anchor is None:
        remove(target)
        return None
    text = f"{anchor}\n{style}\n"
    try:
        with open(target, encoding="utf-8") as f:
            unchanged = f.read() == text
    except (OSError, UnicodeDecodeError):
        unchanged = False
    if not unchanged:
        write_atomic(target, text)
    return target


def update_quick(root, anchor):
    """Write Quick Settings' corner to MENU_QUICK while it is on (flickos-menu
    reads it at every show), or delete it. Written only when it changes."""
    target = os.path.join(root, MENU_QUICK)
    if anchor is None:
        remove(target)
        return None
    if read_first_line(target) != anchor:
        write_atomic(target, anchor + "\n")
    return target


def menu_running_on(root):
    """True while MENU_ANCHOR exists: the start menu is on for this session."""
    return root is not None and os.path.isfile(os.path.join(root, MENU_ANCHOR))


def quick_running_on(root):
    """True while MENU_QUICK exists: Quick Settings is on for this session."""
    return root is not None and os.path.isfile(os.path.join(root, MENU_QUICK))


def update_phone(root, anchor):
    """Write the phone popup's corner to MENU_PHONE while the phone connection
    is on (flickos-menu reads it at every show), or delete it."""
    target = os.path.join(root, MENU_PHONE)
    if anchor is None:
        remove(target)
        return None
    if read_first_line(target) != anchor:
        write_atomic(target, anchor + "\n")
    return target


def phone_popup_on(root):
    """True while MENU_PHONE exists: the phone popup is on for this session."""
    return root is not None and os.path.isfile(os.path.join(root, MENU_PHONE))


def menu_daemon_wanted(root):
    """flickos-menu's daemon runs while the start menu, Quick Settings or the
    phone popup is on."""
    return menu_running_on(root) or quick_running_on(root) or phone_popup_on(root)


def prepare(layout, style, style_themes=frozenset(), clicks=None, launcher=None, style_choice=None, quick=None):
    """Regenerate the runtime overlay. False without XDG_RUNTIME_DIR.

    style_themes: the labwc and icon themes of all installed styles
    (labwc_themes). launcher: the apps
    button's choice (resolve_launcher); None is the app launcher. style_choice:
    the start menu style choice (resolve_menu_style); None follows the layout.
    quick: Quick Settings' choice (resolve_quick_settings); None is off."""
    root = runtime_root()
    if root is None:
        warn("XDG_RUNTIME_DIR is not set; no runtime overlay")
        return False
    os.makedirs(root, mode=0o700, exist_ok=True)
    os.makedirs(overlay_xdg(root), exist_ok=True)
    anchor, corner = menu_anchor(layout, launcher), quick_anchor(layout, quick)
    extra, descriptions = addon_fragments(addons())
    update_rcxml(root, layout, style, style_themes, clicks, menu=anchor is not None, extra=extra,
                 quick=corner is not None)
    update_shortcut_descriptions(root, descriptions)
    update_environment(root)
    update_plain(root)
    update_merge_marker(root)
    update_style_files(root, style)
    update_menu(root, anchor, menu_style(layout, style_choice))
    update_quick(root, corner)
    update_phone(root, phone_corner(layout))
    return True


def session_uses_overlay():
    root = runtime_root()
    if root is None:
        return False
    overlay = os.path.realpath(overlay_xdg(root))
    dirs = (os.environ.get("XDG_CONFIG_DIRS") or "").split(":")
    return any(os.path.isabs(d) and os.path.realpath(d) == overlay for d in dirs)


# --- waybar -----------------------------------------------------------------

def user_waybar_config():
    if plain_session():
        return None
    for name in ("config", "config.jsonc"):
        path = os.path.join(config_home(), "waybar", name)
        if os.path.exists(path):
            return path
    return None


def strip_jsonc(text):
    """Remove // and /* */ comments outside JSON strings."""
    out = []
    i, n = 0, len(text)
    while i < n:
        c = text[i]
        if c == '"':
            j = i + 1
            while j < n and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            out.append(text[i:j + 1])
            i = j + 1
        elif text.startswith("//", i):
            end = text.find("\n", i)
            i = n if end < 0 else end
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            if end < 0:
                raise ValueError("unterminated /* comment")
            out.append(" ")
            i = end + 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


def load_jsonc(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.loads(strip_jsonc(f.read()))
    except (OSError, UnicodeDecodeError, ValueError) as error:
        raise LayoutError(f"{path}: {error}") from None


def load_bars(layout):
    """The layout's bars as a list, with include paths made absolute."""
    data = load_jsonc(layout.waybar)
    bars = data if isinstance(data, list) else [data]
    if not bars or not all(isinstance(bar, dict) for bar in bars):
        raise LayoutError(f"{layout.waybar}: expected a bar object or a list of bars")
    folder = os.path.dirname(layout.waybar)
    for bar in bars:
        include = bar.get("include")
        if include is None:
            continue
        paths = include if isinstance(include, list) else [include]
        bar["include"] = [os.path.normpath(os.path.join(folder, p)) for p in paths]
        for path in bar["include"]:
            if not os.path.isfile(path):
                raise LayoutError(f"{layout.waybar}: include {path} not found")
    return bars


# --- Pinned apps ----------------------------------------------------------------

@dataclasses.dataclass
class PinnedApp:
    desktop_id: str
    path: str
    name: str
    icon: str | None
    css_class: str


def data_dirs():
    home = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    system = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    return [home] + [d for d in system.split(":") if os.path.isabs(d)]


def read_desktop_entry(path):
    """The [Desktop Entry] keys of a .desktop file, or None if unreadable."""
    ini = configparser.ConfigParser(interpolation=None, strict=False)
    ini.optionxform = str
    try:
        ini.read(path, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError) as error:
        warn(f"{path}: {error}")
        return None
    return dict(ini["Desktop Entry"]) if ini.has_section("Desktop Entry") else None


def installed(program):
    if os.path.isabs(program):
        return os.access(program, os.X_OK)
    return shutil.which(program) is not None


def gsettings_schema(key):
    return KEY_SCHEMAS.get(key, INTERFACE_SCHEMA)


def gsettings_get(key):
    """A string value from org.gnome.desktop.interface (KEY_SCHEMAS), or None."""
    return gsettings_read(key)


def gsettings_default(key):
    """The default string value of key (a vendor override's, else the schema's),
    or None. The memory backend has no user values."""
    return gsettings_read(key, dict(os.environ, GSETTINGS_BACKEND="memory"))


def gsettings_read(key, env=None):
    try:
        result = subprocess.run([GSETTINGS, "get", gsettings_schema(key), key],
                                capture_output=True, text=True, timeout=5, env=env)
    except (OSError, subprocess.TimeoutExpired):
        return None
    value = result.stdout.strip()
    if result.returncode == 0 and len(value) >= 2 and value[0] == value[-1] == "'":
        return value[1:-1].replace("\\'", "'").replace("\\\\", "\\")
    return None


def gsettings_set(key, value):
    """Set a string value in org.gnome.desktop.interface (KEY_SCHEMAS). Returns
    True on success."""
    quoted = "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"
    return gsettings_run("set", key, quoted)


def gsettings_reset(key):
    """Remove the user's value of key, so its default applies. Returns True on success."""
    return gsettings_run("reset", key)


def gsettings_run(verb, key, *value):
    try:
        result = subprocess.run([GSETTINGS, verb, gsettings_schema(key), key, *value],
                                capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as error:
        warn(f"gsettings {verb} {key}: {error}")
        return False
    if result.returncode != 0:
        warn(f"gsettings {verb} {key}: {result.stderr.strip()}")
    return result.returncode == 0


def current_icon_theme():
    return gsettings_get("icon-theme")


def style_gsettings(style, available):
    """Apply style's GTK settings. color-scheme is always set; gtk-theme and
    icon-theme only while they hold one of the installed styles' themes, so a
    theme the user chose (nwg-look) is kept. Returns the kept (key, value)s."""
    gsettings_set("color-scheme", style.color_scheme)
    kept = []
    for key, attribute in (("gtk-theme", "gtk_theme"), ("icon-theme", "icon_theme")):
        wanted = getattr(style, attribute)
        current = gsettings_get(key)
        if current is None or current == wanted:
            continue
        if current in {getattr(s, attribute) for s in available.values()}:
            gsettings_set(key, wanted)
        else:
            kept.append((key, current))
    return kept


def gtk_button_layout(titlebar_layout):
    """labwc's <titlebar><layout> in GTK's button-layout words, e.g.
    "close,iconify,max:" -> "close,minimize,maximize:"."""
    return ":".join(",".join(GTK_BUTTONS[b] for b in side.split(",") if b in GTK_BUTTONS)
                    for side in titlebar_layout.split(":"))


def layout_button_layouts(available, default):
    """The button-layout values layouts set: the default (layouts without a
    TitlebarLayout) and the installed layouts' TitlebarLayouts."""
    values = {gtk_button_layout(l.titlebar_layout) for l in available.values() if l.titlebar_layout}
    return values | {default} if default is not None else values


def layout_gsettings(layout, available):
    """Give windows that draw their own title bar (Firefox, GTK header bars) the
    layout's window buttons, or the default ones for a layout without a
    TitlebarLayout. Only while button-layout holds one of the layouts' values,
    so buttons the user chose are kept. Returns the kept value, or None."""
    current = gsettings_get("button-layout")
    if current is None:
        return None
    default = gsettings_default("button-layout")
    wanted = gtk_button_layout(layout.titlebar_layout) if layout.titlebar_layout else default
    if current == wanted:
        return None
    if current not in layout_button_layouts(available, default):
        return current
    if layout.titlebar_layout:
        gsettings_set("button-layout", wanted)
    else:
        gsettings_reset("button-layout")
    return None


class IconFinder:
    """Icon lookup after the freedesktop icon theme spec: the current theme,
    its parents, then FALLBACK_ICON_THEMES (hicolor last), then pixmaps."""

    def __init__(self, theme=None):
        self.bases = [os.path.join(os.path.expanduser("~"), ".icons")]
        self.bases += [os.path.join(d, "icons") for d in data_dirs()]
        self.indexes = {}
        self.themes = []
        for name in [theme] + FALLBACK_ICON_THEMES:
            self._add_theme(name)
        if "hicolor" in self.themes:
            self.themes.remove("hicolor")
            self.themes.append("hicolor")

    def _index(self, theme):
        if theme not in self.indexes:
            ini = None
            for base in self.bases:
                path = os.path.join(base, theme, "index.theme")
                if os.path.isfile(path):
                    ini = configparser.ConfigParser(interpolation=None, strict=False)
                    try:
                        ini.read(path, encoding="utf-8")
                    except (configparser.Error, UnicodeDecodeError):
                        ini = None
                    break
            self.indexes[theme] = ini
        return self.indexes[theme]

    def _add_theme(self, name):
        if not name or name in self.themes or self._index(name) is None:
            return
        self.themes.append(name)
        for parent in self._index(name).get("Icon Theme", "Inherits", fallback="").split(","):
            self._add_theme(parent.strip())

    @staticmethod
    def _distance(section, size):
        try:
            nominal = int(section.get("Size"))
            kind = section.get("Type", "Threshold")
            if kind == "Fixed":
                return abs(nominal - size)
            if kind == "Scalable":
                low, high = int(section.get("MinSize", nominal)), int(section.get("MaxSize", nominal))
            else:
                threshold = int(section.get("Threshold", "2"))
                low, high = nominal - threshold, nominal + threshold
        except (TypeError, ValueError):
            return None
        return low - size if size < low else size - high if size > high else 0

    def _in_theme(self, theme, name, size):
        index = self._index(theme)
        best = None
        for directory in index.get("Icon Theme", "Directories", fallback="").split(","):
            directory = directory.strip()
            if not index.has_section(directory) or index.get(directory, "Scale", fallback="1") != "1":
                continue
            distance = self._distance(index[directory], size)
            if distance is None or (best and distance >= best[0]):
                continue
            path = self._file(theme, directory, name)
            if path:
                best = (distance, path)
                if distance == 0:
                    break
        return best[1] if best else None

    def _file(self, theme, directory, name):
        for base in self.bases:
            for ext in ICON_EXTENSIONS:
                path = os.path.join(base, theme, directory, name + ext)
                if os.path.isfile(path):
                    return path
        return None

    def find(self, name, size=ICON_SIZE):
        if os.path.isabs(name):
            return name if os.path.isfile(name) else None
        for ext in ICON_EXTENSIONS:  # Icon=foo.png isn't valid, but common
            if name.endswith(ext):
                name = name[:-len(ext)]
        for theme in self.themes:
            path = self._in_theme(theme, name, size)
            if path:
                return path
        for base in data_dirs():
            for ext in ICON_EXTENSIONS:
                path = os.path.join(base, "pixmaps", name + ext)
                if os.path.isfile(path):
                    return path
        return None


def installed_apps(desktop_ids):
    """(desktop id, path, [Desktop Entry] keys) of the installed apps among
    desktop ids, in order. Missing or hidden apps are skipped."""
    found = []
    for desktop_id in desktop_ids:
        path = next((p for p in (os.path.join(d, "applications", desktop_id) for d in data_dirs())
                     if os.path.isfile(p)), None)
        entry = read_desktop_entry(path) if path else None
        if (not entry or entry.get("Type", "Application") != "Application"
                or entry.get("Hidden") == "true"
                or (entry.get("TryExec") and not installed(entry["TryExec"]))):
            continue
        found.append((desktop_id, path, entry))
    return found


def pinned_apps(desktop_ids, icons=None):
    """Installed apps for desktop ids, in order. Missing or hidden apps are skipped."""
    apps = []
    classes = set()
    for desktop_id, path, entry in installed_apps(desktop_ids):
        if icons is None:
            icons = IconFinder(current_icon_theme())
        icon = icons.find(entry["Icon"]) if entry.get("Icon") else None
        base = "app-" + re.sub(r"[^a-z0-9]+", "-", desktop_id.removesuffix(".desktop").lower()).strip("-")
        css_class, n = base, 2
        while css_class in classes:
            css_class, n = f"{base}-{n}", n + 1
        classes.add(css_class)
        name = entry.get("Name") or desktop_id.removesuffix(".desktop")
        apps.append(PinnedApp(desktop_id, path, name, icon, css_class))
    return apps


def expand_pinned(bars, apps):
    """Replace PINNED_MODULE with one launcher module per app (bars change in place)."""
    names = [f"{PIN_MODULE}#{app.css_class}" for app in apps]
    for bar in bars:
        used = False
        for key in ("modules-left", "modules-center", "modules-right"):
            modules = bar.get(key)
            if isinstance(modules, list) and PINNED_MODULE in modules:
                bar[key] = [m for module in modules for m in (names if module == PINNED_MODULE else [module])]
                used = True
        if used:
            for app, name in zip(apps, names):
                # tooltip-format is Pango markup and a format string.
                tooltip = html.escape(app.name, quote=False).replace("{", "{{").replace("}", "}}")
                bar[name] = {
                    "format": " ",
                    "tooltip-format": tooltip,
                    "on-click": f"gio launch {shlex.quote(app.path)}",
                }


# --- Desktop buttons ------------------------------------------------------------

def expand_desktops(bars, count):
    """Replace DESKTOPS_MODULE with one DESK_MODULE#N per desktop, none for a
    single desktop (bars change in place). Returns True when a bar has them."""
    names = [f"{DESK_MODULE}#{number}" for number in range(1, count + 1)] if count > 1 else []
    found = False
    for bar in bars:
        used = False
        for key in ("modules-left", "modules-center", "modules-right"):
            modules = bar.get(key)
            if isinstance(modules, list) and DESKTOPS_MODULE in modules:
                bar[key] = [m for module in modules for m in (names if module == DESKTOPS_MODULE else [module])]
                used = True
        if used:
            helper = shlex.quote(DESKTOP_HELPER)
            for number, name in enumerate(names, 1):
                bar[name] = {
                    "exec": f'cat "$XDG_RUNTIME_DIR/flickos/{DESKTOPS_DIR}/{number}.json" 2>/dev/null',
                    "return-type": "json",
                    "interval": "once",
                    "signal": DESKTOPS_SIGNAL,
                    "on-click": f"{helper} {number}",
                    "on-scroll-up": f"{helper} previous",
                    "on-scroll-down": f"{helper} next",
                }
            found = found or bool(names)
    return found


def desktop_json(name, active):
    """One desktop button's text for waybar (return-type json)."""
    return json.dumps({"text": name, "class": ["active"] if active else [],
                       "tooltip": f"Desktop {name}"}, ensure_ascii=False) + "\n"


def update_desktop_files(root, count):
    """The desktop buttons' folder for a panel with count buttons (0: none,
    and the folder is deleted). A button's file is written only where it is
    missing: the supervisor of a running panel keeps them up to date, and a
    regenerated panel must not lose which desktop is the current one."""
    folder = os.path.join(root, DESKTOPS_DIR)
    if count <= 0:
        shutil.rmtree(folder, ignore_errors=True)
        return
    write_atomic(os.path.join(folder, DESKTOPS_COUNT), f"{count}\n")
    for number in range(1, count + 1):
        path = os.path.join(folder, f"{number}.json")
        if not os.path.exists(path):
            write_atomic(path, desktop_json(str(number), False))
    for entry in os.listdir(folder):
        number = entry.removesuffix(".json")
        if entry.endswith(".json") and number.isdigit() and int(number) > count:
            remove(os.path.join(folder, entry))


def desktop_buttons(root):
    """How many desktop buttons the generated panel has (0 without)."""
    text = read_first_line(os.path.join(root, DESKTOPS_DIR, DESKTOPS_COUNT)) if root else None
    return int(text) if text and text.isdigit() else 0


def write_desktops(root, desktops, count):
    """Rewrite the buttons' files from labwc's desktops [(name, active)], in
    the order labwc announced them. A button without a desktop (labwc has
    fewer than count) gets an empty text, which waybar hides; desktops beyond
    count have no button. Nothing while the folder is gone: the panel no
    longer has the buttons."""
    folder = os.path.join(root, DESKTOPS_DIR)
    if not os.path.isdir(folder):
        return False
    for number in range(1, count + 1):
        name, active = desktops[number - 1] if number <= len(desktops) else ("", False)
        write_atomic(os.path.join(folder, f"{number}.json"), desktop_json(name, active))
    return True


def css_string(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def use_start_menu(bars):
    """Point the apps button (LAUNCHER_MODULE) of bars at the start menu
    (bars change in place). The bar's own settings win over the included
    modules.jsonc, so these replace its fuzzel command."""
    for bar in bars:
        if any(isinstance(bar.get(key), list) and LAUNCHER_MODULE in bar[key]
               for key in ("modules-left", "modules-center", "modules-right")):
            settings = bar.get(LAUNCHER_MODULE)
            settings = dict(settings) if isinstance(settings, dict) else {}
            settings.update({"on-click": MENU_TOGGLE, "tooltip-format": MENU_TOOLTIP})
            bar[LAUNCHER_MODULE] = settings


def use_quick_settings(bars):
    """Point the volume and battery icons (QUICK_MODULES) of bars at Quick
    Settings (bars change in place): a click opens it, the volume icon's right
    click the sound mixer, scrolling still changes the volume. waybar 0.12
    never runs a group's own on-click, so each icon gets one; the group
    (QUICK_GROUP, where the first of them was) makes them one button to the
    pointer (base.css's #quick:hover). The bar's own settings win over the
    included ones, which keep the rest (format, scroll step)."""
    for bar in bars:
        for key in ("modules-left", "modules-center", "modules-right"):
            modules = bar.get(key)
            if not isinstance(modules, list):
                continue
            members = [module for module in QUICK_MODULES if module in modules]
            if not members:
                continue
            index = modules.index(members[0])
            for module in members:
                modules.remove(module)
            modules.insert(index, QUICK_GROUP)
            bar[QUICK_GROUP] = {"orientation": "horizontal", "modules": members}
            for module in members:
                own = bar.get(module)
                settings = dict(own) if isinstance(own, dict) else {}
                settings["on-click"] = QUICK_TOGGLE
                if module == "wireplumber":
                    settings["on-click-right"] = QUICK_MIXER
                tooltip = settings.get("tooltip-format", included_module(bar, module).get("tooltip-format"))
                if isinstance(tooltip, str):
                    hint = ("Click: Quick Settings (Super+A) · Right click: sound mixer" if module == "wireplumber"
                            else "Click: Quick Settings (Super+A)")
                    settings["tooltip-format"] = f"{tooltip}\n{hint}"
                bar[module] = settings


def phone_on():
    """Whether the phone connection is on: flickos-phone owns the setting."""
    if live_system() or shutil.which(PHONE) is None:
        return False
    try:
        result = subprocess.run([PHONE, "get", "enabled"], capture_output=True, text=True, timeout=5,
                                check=False)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0 and result.stdout.strip() == "yes"


def insert_module(bars, module):
    """Put module in the first bar that has one of MODULE_BEFORE, just before
    it (bars change in place). Returns that bar, or None without one."""
    for before in MODULE_BEFORE:
        for bar in bars:
            for key in ("modules-left", "modules-center", "modules-right"):
                modules = bar.get(key)
                if isinstance(modules, list) and before in modules:
                    if module not in modules:
                        modules.insert(modules.index(before), module)
                    return bar
    return None


def use_phone(bars, popup=False):
    """Put the phone button into the panel (bars change in place). With
    popup, a click opens the phone popup; the shared module's fuzzel menu
    stays the click otherwise, and is also the popup command's fallback."""
    bar = insert_module(bars, PHONE_MODULE)
    if not popup or bar is None:
        return bar
    settings = dict(included_module(bar, PHONE_MODULE))
    own = bar.get(PHONE_MODULE)
    if isinstance(own, dict):
        settings.update(own)
    settings["on-click"] = PHONE_TOGGLE
    settings["on-click-right"] = PHONE_TOGGLE
    bar[PHONE_MODULE] = settings
    return bar


def module_taken(bars, module):
    """Whether the layout already has module: in a bar, or its settings in a
    bar or in an include (the phone's, while it is off)."""
    return any(module in bar or included_module(bar, module)
               or any(isinstance(bar.get(key), list) and module in bar[key]
                      for key in ("modules-left", "modules-center", "modules-right"))
               for bar in bars)


def use_addons(bars, found):
    """Put the add-ons' panel buttons (ADDON_WAYBAR) into the panel, after the
    phone's, with their settings in the bar that gets them (bars change in
    place). Returns the add-ons' stylesheets to import."""
    styles = []
    for name, folder in found.items():
        path = os.path.join(folder, ADDON_WAYBAR)
        if os.path.isfile(path):
            try:
                modules = load_jsonc(path)
                if not isinstance(modules, dict):
                    raise LayoutError(f"{path}: not an object of modules")
            except LayoutError as error:
                warn(f"{error}; add-on {name} has no panel button")
                modules = {}
            for module, settings in modules.items():
                if not module.startswith(ADDON_MODULE_PREFIX) or not isinstance(settings, dict):
                    warn(f"{path}: {module} left out (only {ADDON_MODULE_PREFIX}NAME modules with settings)")
                    continue
                if module_taken(bars, module):
                    warn(f"{path}: {module} left out: the panel already has it")
                    continue
                bar = insert_module(bars, module)
                if bar is None:
                    warn(f"add-on {name}: the layout has no place for {module}")
                    continue
                bar[module] = settings
        style = os.path.join(folder, ADDON_STYLE)
        if os.path.isfile(style):
            styles.append(style)
    return styles


def twelve_hour(fmt):
    """A waybar clock format with 12-hour times: %H:%M[:%S] -> %I:%M[:%S] %p."""
    return re.sub(r"%H:%M(:%S)?", lambda m: f"%I:%M{m.group(1) or ''} %p", fmt)


def included_module(bar, module):
    """A module's settings from the bar's includes (first one that has it)."""
    for path in bar.get("include") or []:
        try:
            data = load_jsonc(path)
        except LayoutError:
            continue
        if isinstance(data, dict) and isinstance(data.get(module), dict):
            return data[module]
    return {}


def pango_color(rgb):
    """#rrggbb of (r, g, b) in 0…1."""
    return "#" + "".join(f"{round(channel * 255):02x}" for channel in rgb)


def calendar_today(style):
    """The calendar's today format in style's selection colors, see-through
    ones as shown over the tooltip; None when the palette doesn't have them
    as color values."""
    colors = palette_rgba(palette_chain(style, "waybar"))
    if not all(name in colors for name in TODAY_COLORS):
        return None
    background, foreground = (colors[name] for name in TODAY_COLORS)
    behind = colors.get(TOOLTIP_COLOR, (0.0, 0.0, 0.0, 1.0))[:3]
    shown = blend(background[:3], behind, background[3])
    return CALENDAR_TODAY.format(background=pango_color(shown),
                                 foreground=pango_color(blend(foreground[:3], shown, foreground[3])))


def calendar_formats(settings):
    """The calendar's format settings of clock settings ({} if none)."""
    calendar = settings.get("calendar")
    formats = calendar.get("format") if isinstance(calendar, dict) else None
    return formats if isinstance(formats, dict) else {}


def use_clock(bars, clock, today=None):
    """Give the clocks of bars the chosen hours, and the calendar's today the
    format today (calendar_today) unless the bar or its include has one (bars
    change in place). The bar's own clock settings win over the included
    ones, so the changes go there; waybar merges the rest in."""
    for bar in bars:
        if not any(isinstance(bar.get(key), list) and CLOCK_MODULE in bar[key]
                   for key in ("modules-left", "modules-center", "modules-right")):
            continue
        own = bar.get(CLOCK_MODULE)
        settings = dict(own) if isinstance(own, dict) else {}
        included = included_module(bar, CLOCK_MODULE)
        if clock.id == "12h":
            for key in CLOCK_FORMAT_KEYS:
                fmt = settings.get(key, included.get(key, WAYBAR_CLOCK_FORMAT if key == "format" else None))
                if isinstance(fmt, str):
                    settings[key] = twelve_hour(fmt)
        if today and "today" not in calendar_formats(settings) and "today" not in calendar_formats(included):
            calendar = settings.get("calendar")
            calendar = dict(calendar) if isinstance(calendar, dict) else {}
            calendar["format"] = {**calendar_formats(settings), "today": today}
            settings["calendar"] = calendar
        if settings:
            bar[CLOCK_MODULE] = settings


# --- Users' CSS (ADR-015) ------------------------------------------------------

@dataclasses.dataclass
class CssError:
    """Where GTK's parser stopped in a CSS file, or in a file it imports."""
    file: str
    line: int             # 0: not known
    column: int
    message: str


def cache_home():
    return os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")


def tweaks_folder():
    return os.path.join(config_home(), TWEAKS_HOME)


def tweaks_css():
    """The user's tweaks of the panel, or None (always in the plain session)."""
    if plain_session():
        return None
    path = os.path.join(tweaks_folder(), TWEAKS_STYLE)
    return path if os.path.isfile(path) else None


def css_import_chain(path, found=None):
    """[path] of a CSS file and every file it @imports, each once, in reading
    order; missing ones too."""
    found = [] if found is None else found
    if path in found or len(found) >= 50:
        return found
    found.append(path)
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = CSS_COMMENT.sub("", f.read())
    except OSError:
        return found
    for match in CSS_IMPORT.finditer(text):
        css_import_chain(absolute(match.group(2).removeprefix("file://"), os.path.dirname(path)), found)
    return found


def gtk_version():
    """GTK 3's library file name, which has its version; a GTK update may
    change what its parser accepts."""
    for path in sorted(glob.glob(GTK_LIBRARY)):
        return os.path.basename(os.path.realpath(path))
    return ""


def css_fingerprint(path, gtk):
    digest = hashlib.sha256(gtk.encode())
    for each in css_import_chain(path):
        digest.update(b"\0" + each.encode() + b"\0")
        try:
            with open(each, "rb") as f:
                digest.update(f.read())
        except OSError:
            digest.update(b"\0missing")
    return digest.hexdigest()


CSS_RESULTS = {}      # fingerprint: CssError or None, for this run


def css_errors(paths):
    """{path: CssError} of the CSS files in paths that GTK can't load, with
    what they import. A file whose fingerprint passed before (CSS_CHECKED)
    isn't parsed again, and nothing runs when none is left. When the checker
    can't run, nothing is reported: the files are used unchecked."""
    paths = list(dict.fromkeys(path for path in paths if path))
    if not paths:
        return {}
    cache_file = os.path.join(cache_home(), CSS_CHECKED)
    try:
        with open(cache_file, encoding="utf-8") as f:
            cache = json.load(f)
        cache = cache if isinstance(cache, dict) else {}
    except (OSError, ValueError):
        cache = {}
    gtk = gtk_version()
    prints = {path: css_fingerprint(path, gtk) for path in paths}
    errors = {path: CSS_RESULTS[prints[path]] for path in paths
              if CSS_RESULTS.get(prints[path]) is not None}
    todo = [path for path in paths if cache.get(path) != prints[path] and prints[path] not in CSS_RESULTS]
    if not todo:
        return errors
    try:
        done = subprocess.run([CSS_CHECKER, *todo], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True,
                              timeout=CSS_CHECK_SECONDS, check=False)
    except FileNotFoundError:
        return errors
    except (OSError, subprocess.SubprocessError) as error:
        warn(f"can't check your CSS ({error}); using it unchecked")
        return errors
    passed = []
    for line in done.stdout.splitlines():
        try:
            result = json.loads(line)
        except ValueError:
            continue
        path = result.get("path") if isinstance(result, dict) else None
        if path not in todo:
            continue
        error = result.get("error")
        if isinstance(error, dict):
            errors[path] = CssError(str(error.get("file") or path), int(error.get("line") or 0),
                                    int(error.get("column") or 0), str(error.get("message") or "can't read it"))
        else:
            passed.append(path)
        CSS_RESULTS[prints[path]] = errors.get(path)
    if not passed and not errors:
        warn(f"can't check your CSS ({CSS_CHECKER} said nothing); using it unchecked")
    if passed or any(path in cache for path in errors):
        cache.update({path: prints[path] for path in passed})
        cache = {path: value for path, value in cache.items() if path not in errors and os.path.exists(path)}
        with contextlib.suppress(OSError):
            write_atomic(cache_file, json.dumps(cache, indent=1) + "\n")
    return errors


def css_error_text(path, error):
    """What GTK said about path, where: FILE:LINE:COLUMN: MESSAGE."""
    where = shown_path(error.file) + (f":{error.line}" if error.line else "") + \
        (f":{error.column}" if error.line and error.column else "")
    imported = "" if error.file == path else f" (imported by {shown_path(path)})"
    return f"{where}: {error.message}{imported}"


def user_addon_styles(found):
    """The style.css files of the user's own add-ons among found."""
    home = os.path.join(config_home(), ADDONS_HOME)
    return [os.path.join(folder, ADDON_STYLE) for folder in found.values()
            if folder.startswith(home + os.sep) and os.path.isfile(os.path.join(folder, ADDON_STYLE))]


def panel_css_errors(layout, found, tweaks):
    """{path: CssError} of the user's CSS the panel would read: their own
    layout's, their add-ons' and the tweaks."""
    return css_errors(([layout.style] if layout.user else []) + user_addon_styles(found) + [tweaks])


def update_waybar(root, layout, style, menu=False, phone=False, found=None, quick=False, popup=False):
    """Generate the panel files in root/waybar/. Returns the waybar command.
    With menu, the apps button opens the start menu; with phone, the panel
    has the phone connection's button (with popup, that button opens the
    phone popup); found (addons()) adds the add-ons' buttons and stylesheets;
    with quick, the volume and battery icons open Quick Settings."""
    for path in [layout.style] + palette_chain(style, "waybar"):
        if not os.path.isfile(path):
            raise LayoutError(f"layout {layout.id}, style {style.id}: {path} not found")
    bars = load_bars(layout)
    apps = pinned_apps(layout.pinned) if layout.pinned else []
    expand_pinned(bars, apps)
    desktops = expand_desktops(bars, layout.desktops)
    if menu:
        use_start_menu(bars)
    if quick:
        use_quick_settings(bars)
    if phone:
        use_phone(bars, popup=popup)
    addon_styles = use_addons(bars, found or {})
    use_clock(bars, resolve_clock(), calendar_today(style))
    tweaks = tweaks_css()
    broken = panel_css_errors(layout, found or {}, tweaks)
    for path, error in broken.items():
        warn(f"{css_error_text(path, error)}: {shown_path(path)} is left out of the panel, which would stop")
    layout_css = layout.style
    if layout_css in broken:
        # The bar still needs FlickOS's shared rules.
        base = os.path.join(LAYOUTS_DIR, "common", "base.css")
        layout_css = base if os.path.isfile(base) else None

    folder = os.path.join(root, "waybar")
    config = os.path.join(folder, "config.jsonc")
    css = os.path.join(folder, "style.css")
    note = "Generated by flickos-layout at every login. Do not edit."
    write_atomic(config, f"// {note} Layout: {layout.waybar}\n"
                         + json.dumps(bars, indent=4, ensure_ascii=False) + "\n")
    lines = [f"/* {note} */",
             *[f"@import url({css_string(path)});" for path in palette_chain(style, "waybar")]]
    lines += [f"@import url({css_string(layout_css)});"] if layout_css else []
    lines += [f"@import url({css_string(path)});" for path in addon_styles if path not in broken]
    lines += [f"#custom-pin.{app.css_class} {{ background-image: url({css_string(app.icon)}); }}"
              for app in apps if app.icon]
    if tweaks and tweaks not in broken:
        # Last, so they win over everything at the same strength (GTK takes a late @import).
        lines += ["/* Your tweaks (flickos-layout tweaks new) */", f"@import url({css_string(tweaks)});"]
    write_atomic(css, "\n".join(lines) + "\n")
    update_desktop_files(root, layout.desktops if desktops else 0)
    return ["waybar", "-c", config, "-s", css]


# --- Dock (sfwbar) -------------------------------------------------------------

def update_dock(root, layout, style, menu=False):
    """Generate root/dock/sfwbar.config, or delete it when the layout has no
    dock. Returns the sfwbar command, or None. With menu, DOCK_LAUNCHER opens
    the start menu, else fuzzel.

    sfwbar reads the CSS after a #CSS line from a string, so the palette and
    the layout's CSS are copied in (an @import couldn't find them). Pins are
    the installed apps' desktop ids without .desktop, which is how sfwbar
    matches windows (app id) and finds the desktop file."""
    target = os.path.join(root, "dock", "sfwbar.config")
    if layout.dock is None:
        remove(target)
        return None
    texts = []
    for path in [layout.dock] + palette_chain(style, "waybar") + [layout.dock_style]:
        try:
            with open(path, encoding="utf-8") as f:
                texts.append(f.read())
        except (OSError, UnicodeDecodeError) as error:
            raise LayoutError(f"layout {layout.id}, style {style.id}: {path}: {error}") from None
    config, *palettes, css = texts
    palette = "\n".join(text.rstrip() for text in palettes)
    if re.search(r"^#CSS", config, re.MULTILINE):
        raise LayoutError(f"{layout.dock}: has a #CSS section; the dock's CSS belongs in DockStyle=")
    apps = installed_apps(layout.pinned) if layout.pinned else []
    pins = ", ".join(css_string(desktop_id.removesuffix(".desktop")) for desktop_id, _path, _entry in apps)
    config = DOCK_PINS.sub(lambda m: m.group(1) + pins if pins else "", config)
    launcher = "sh -c " + shlex.quote(MENU_TOGGLE if menu else f"{CLOSE_LAUNCHER} || {FALLBACK_LAUNCHER}")
    config = DOCK_LAUNCHER_EXEC.sub(lambda m: f"Exec({css_string(launcher)})", config)
    # "#Api2" must be the first line: the config syntax used by sfwbar 1.0beta17 and later.
    config = re.sub(r"\A#api2[ \t]*\n", "", config, flags=re.IGNORECASE)
    tweaks = tweaks_css()
    if tweaks and not css_errors([tweaks]):
        # sfwbar reads its CSS from a string: the tweaks' own imports and pictures need absolute paths.
        text = text_of(tweaks)
        if text is not None:
            css = f"{css.rstrip()}\n/* Your tweaks: {tweaks} */\n{absolute_urls(text, os.path.dirname(tweaks))}"
    write_atomic(target, f"#Api2\n# Generated by flickos-layout at every login. Do not edit. Layout: {layout.dock}\n"
                         f"{config.rstrip()}\n\n#CSS\n/* Style: {style.waybar} */\n{palette.rstrip()}\n"
                         f"/* Layout: {layout.dock_style} */\n{css.rstrip()}\n")
    return ["sfwbar", "-f", target]


def required_root(purpose):
    root = runtime_root()
    if root is None:
        raise LayoutError(f"XDG_RUNTIME_DIR is not set; cannot generate the {purpose}")
    os.makedirs(root, mode=0o700, exist_ok=True)
    return root


def waybar_command(layout, style):
    """Generate the panel; the start menu is on while prepare wrote MENU_ANCHOR,
    Quick Settings while it wrote MENU_QUICK."""
    root = required_root("panel")
    return update_waybar(root, layout, style, menu=menu_running_on(root), phone=phone_on(), found=addons(),
                         quick=quick_running_on(root), popup=phone_popup_on(root))


def dock_command(layout, style):
    """Generate the dock; its apps button opens the start menu while prepare wrote MENU_ANCHOR."""
    root = required_root("dock")
    return update_dock(root, layout, style, menu=menu_running_on(root))


def mako_command(style):
    return ["mako", "-c", update_mako(required_root("notification settings"), style)]


def option_arg(args, short, long):
    """The value of option short/long (e.g. -c/--config) in a command line, or None."""
    value = None
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in (short, long) and i + 1 < len(args):
            value = args[i + 1]
            i += 1
        elif arg.startswith(long + "="):
            value = arg.split("=", 1)[1]
        elif arg.startswith(short) and not arg.startswith("--") and len(arg) > 2:
            value = arg[2:]
        i += 1
    return value


def waybar_config_arg(args):
    """The -c/--config value from a waybar command line, or None."""
    return option_arg(args, "-c", "--config")


def own_processes(name):
    """(pid, arguments) of this user's processes called name, by pid."""
    found = []
    for entry in os.listdir(PROC):
        if not entry.isdigit():
            continue
        proc = os.path.join(PROC, entry)
        try:
            if os.stat(proc).st_uid != os.getuid():
                continue
            with open(os.path.join(proc, "comm"), encoding="utf-8", errors="replace") as f:
                if f.read().strip() != name:
                    continue
            with open(os.path.join(proc, "cmdline"), "rb") as f:
                args = [a.decode(errors="surrogateescape") for a in f.read().split(b"\0")]
        except OSError:
            continue
        found.append((int(entry), args[1:]))
    return sorted(found)


def managed(pairs, short, long, dirs):
    """PIDs whose option short/long is a path below one of dirs."""
    pids = []
    for pid, args in pairs:
        value = option_arg(args, short, long)
        if value and os.path.isabs(value) and any(is_below(value, d) for d in dirs):
            pids.append(pid)
    return pids


def managed_waybars():
    """PIDs of this user's waybar processes that run a FlickOS config."""
    dirs = list(MANAGED_DIRS)
    root = runtime_root()
    if root:
        dirs.append(root)
    return managed(own_processes("waybar"), "-c", "--config", dirs)


def managed_docks():
    """PIDs of this user's sfwbar processes that run a FlickOS dock."""
    root = runtime_root()
    return managed(own_processes("sfwbar"), "-f", "--config", [root]) if root else []


def managed_menus():
    """PIDs of this user's start menu daemons (flickos-menu daemon)."""
    return [pid for pid, args in own_processes(MENU_PROGRAM) if "daemon" in args]


def menu_command():
    return [MENU_PROGRAM, "daemon"]


def process_environ(pid):
    try:
        with open(os.path.join(PROC, str(pid), "environ"), "rb") as f:
            data = f.read()
    except OSError:
        return None
    env = {}
    for item in data.split(b"\0"):
        key, sep, value = item.decode(errors="surrogateescape").partition("=")
        if sep and key:
            env[key] = value
    return env or None


def running(pid):
    try:
        with open(os.path.join(PROC, str(pid), "stat"), encoding="utf-8") as f:
            # "PID (comm) STATE ...": comm may contain spaces and parentheses.
            return f.read().rpartition(")")[2].split()[0] != "Z"
    except (OSError, IndexError):
        return False


def stop(pids):
    """SIGTERM, then SIGKILL after a while. Waiting lets waybar release the
    tray's StatusNotifierWatcher name, so the new waybar can take it over."""
    for pid in pids:
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, signal.SIGTERM)
    deadline = time.monotonic() + WAYBAR_STOP_SECONDS
    while any(running(pid) for pid in pids) and time.monotonic() < deadline:
        time.sleep(0.1)
    for pid in pids:
        if running(pid):
            with contextlib.suppress(ProcessLookupError):
                os.kill(pid, signal.SIGKILL)


def start_detached(command, env):
    """Start command in its own session, not as a child of this process
    (setsid -f), so it outlives this command and nobody has to reap it."""
    try:
        subprocess.run(["setsid", "-f", *command], env=env, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as error:
        warn(f"cannot start {command[0]}: {error}")


def supervised_command(command):
    """command, run by a supervisor of this program (`supervise`)."""
    return [SELF, "supervise", "--", *command]


def start_supervised(command, env):
    """Start command detached, with a supervisor that restarts it."""
    start_detached(supervised_command(command), env)


def compositor_gone(env):
    """True once the session's Wayland socket is gone: the compositor ended,
    and restarting a panel program would only fail."""
    display = env.get("WAYLAND_DISPLAY")
    if not display:
        return False
    if not os.path.isabs(display):
        base = env.get("XDG_RUNTIME_DIR")
        if not base:
            return False
        display = os.path.join(base, display)
    return not os.path.exists(display)


def wayland_path(env):
    """The compositor's socket of env, or None."""
    display, base = env.get("WAYLAND_DISPLAY"), env.get("XDG_RUNTIME_DIR")
    if not display or not (os.path.isabs(display) or base):
        return None
    return display if os.path.isabs(display) else os.path.join(base, display)


class ScreenWatch:
    """A Wayland connection that listens for screens (wl_output globals)
    coming and going. The ones there at start (until the compositor answers
    a sync) are the baseline; after that, every change restarts a quiet
    period, and changed() runs once it is over. Blocks in select while
    nothing happens: no wakeups (PERF-5).

    With desktops (a function), it also binds labwc's ext_workspace_manager_v1
    and calls desktops([(name, active)]) at each of its `done` events: the
    desktops in the order the compositor announced them. labwc reuses the ids
    of removed desktops out of order, so the order is never the ids'."""

    REGISTRY, SYNC, WORKSPACES = 2, 3, 4
    # ext-workspace-v1 opcodes (usr/libexec/flickos/desktop has the same).
    MANAGER_WORKSPACE, MANAGER_DONE = 1, 2                     # events
    WORKSPACE_NAME, WORKSPACE_STATE, WORKSPACE_REMOVED = 1, 3, 5
    WORKSPACE_DESTROY = 0                                      # request
    STATE_ACTIVE = 1

    def __init__(self, sock, changed, settle=SCREENS_SETTLE_SECONDS, desktops=None):
        import struct
        self.struct = struct
        self.sock, self.changed, self.settle, self.desktops = sock, changed, settle, desktops
        self.buffer, self.screens, self.ready, self.due = b"", set(), False, None
        self.bound = False
        self.workspaces = {}           # id: [announced, name, active]
        self.announced = 0
        self.send(1, 1, struct.pack("=I", self.REGISTRY))      # wl_display.get_registry
        self.send(1, 0, struct.pack("=I", self.SYNC))          # wl_display.sync: the baseline's end

    def send(self, object_id, opcode, payload=b""):
        self.sock.sendall(self.struct.pack("=II", object_id, (8 + len(payload)) << 16 | opcode) + payload)

    def bind_workspaces(self, name):
        interface = WORKSPACE_MANAGER + b"\0"
        self.send(self.REGISTRY, 0, self.struct.pack("=II", name, len(interface)) + interface
                  + b"\0" * (-len(interface) % 4) + self.struct.pack("=II", 1, self.WORKSPACES))
        self.bound = True

    def listed_desktops(self):
        return [(name, active) for _, name, active in sorted(self.workspaces.values())]

    def handle(self, object_id, opcode, payload):
        unpack = self.struct.unpack_from
        if object_id == self.SYNC and opcode == 0:             # wl_callback.done
            self.ready = True
        elif object_id == self.REGISTRY and opcode == 0:       # global: name, interface, version
            name, size = unpack("=II", payload)
            interface = payload[8:8 + size - 1]
            if interface == b"wl_output":
                self.screens.add(name)
                self.touch()
            elif interface == WORKSPACE_MANAGER and self.desktops is not None and not self.bound:
                self.bind_workspaces(name)
        elif object_id == self.REGISTRY and opcode == 1:       # global_remove: name
            name = unpack("=I", payload)[0]
            if name in self.screens:
                self.screens.discard(name)
                self.touch()
        elif object_id == self.WORKSPACES and opcode == self.MANAGER_WORKSPACE:
            self.announced += 1
            self.workspaces[unpack("=I", payload)[0]] = [self.announced, "", False]
        elif object_id == self.WORKSPACES and opcode == self.MANAGER_DONE:
            self.desktops(self.listed_desktops())
        elif object_id in self.workspaces:
            workspace = self.workspaces[object_id]
            if opcode == self.WORKSPACE_NAME:
                size = unpack("=I", payload)[0]
                workspace[1] = payload[4:4 + size - 1].decode(errors="replace")
            elif opcode == self.WORKSPACE_STATE:
                workspace[2] = bool(unpack("=I", payload)[0] & self.STATE_ACTIVE)
            elif opcode == self.WORKSPACE_REMOVED:
                del self.workspaces[object_id]
                self.send(object_id, self.WORKSPACE_DESTROY)
        elif object_id == 1 and opcode == 0:                   # wl_display.error
            raise OSError("Wayland error")

    def touch(self):
        if self.ready:
            self.due = time.monotonic() + self.settle

    def read(self):
        """Handle what arrived; False when the compositor is gone."""
        try:
            data = self.sock.recv(65536)
        except ConnectionResetError:
            return False
        if not data:
            return False
        self.buffer += data
        while len(self.buffer) >= 8:
            object_id, word = self.struct.unpack_from("=II", self.buffer)
            size = word >> 16
            if size < 8:
                raise OSError("bad Wayland message")
            if len(self.buffer) < size:
                break
            payload, self.buffer = self.buffer[8:size], self.buffer[size:]
            self.handle(object_id, word & 0xFFFF, payload)
        return True

    def run(self):
        import select
        while True:
            wait = None if self.due is None else max(0.0, self.due - time.monotonic())
            readable, _, _ = select.select([self.sock], [], [], wait)
            if readable and not self.read():
                return
            if self.due is not None and time.monotonic() >= self.due:
                self.due = None
                self.changed()


def catches_signal(pid, signum):
    """Whether process pid has a handler for signum (SigCgt in its status)."""
    try:
        with open(os.path.join(PROC, str(pid), "status"), encoding="utf-8") as f:
            for line in f:
                if line.startswith("SigCgt:"):
                    return bool(int(line.split()[1], 16) >> (signum - 1) & 1)
    except (OSError, ValueError, IndexError):
        pass
    return False


def watch_screens(env, changed, desktops=None):
    """Run a ScreenWatch for env's compositor in a daemon thread (with
    desktops, it also follows the desktops); nothing when there is none to
    reach."""
    import socket
    import threading
    path = wayland_path(env)
    if path is None:
        return

    def run():
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.connect(path)
                ScreenWatch(sock, changed, desktops=desktops).run()
        except OSError as error:
            log_line(f"not watching the screens: {error}")
    threading.Thread(target=run, daemon=True).start()


def supervise(command, env, stream=None):
    """Run command until it stops for good; return 0 when it ended cleanly.

    autostart runs once, so nothing would bring the panel back if waybar
    exited by itself, which it does when an output changes under it (common
    in the first seconds of a session, in a VM or with a second monitor).
    Restart it, waiting longer each time, and give up after RESTART_LIMIT
    failures in a row. A program that ended on purpose is left alone: one that
    exited cleanly (how `set` stops the old panel), one that was killed, and
    any of them once the session is over."""
    state = {"child": None, "stopping": False}

    def stop_child(signum, frame):
        state["stopping"] = True
        if state["child"] is not None:
            with contextlib.suppress(OSError):
                state["child"].terminate()

    name = os.path.basename(command[0])
    handlers = [(sig, signal.signal(sig, stop_child))
                for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)]
    if name in RELOAD_ON_SCREENS:
        def screens_changed():
            child = state["child"]
            if child is not None and child.poll() is None:
                log_line(f"the screens changed: reloading {name}")
                with contextlib.suppress(OSError):
                    child.send_signal(RELOAD_ON_SCREENS[name])
        base = env.get("XDG_RUNTIME_DIR")
        root = os.path.join(base, "flickos") if base and os.path.isabs(base) else None
        count = desktop_buttons(root)

        def desktops_changed(desktops):
            child = state["child"]
            if not write_desktops(root, desktops, count) or child is None or child.poll() is not None:
                return
            # A waybar still starting would die of a signal it doesn't
            # handle yet; it reads the files itself once its modules exist.
            if catches_signal(child.pid, signal.SIGRTMIN + DESKTOPS_SIGNAL):
                with contextlib.suppress(OSError):
                    child.send_signal(signal.SIGRTMIN + DESKTOPS_SIGNAL)
        watch_screens(env, screens_changed, desktops_changed if count else None)
    failures, status, deliberate = 0, 0, False
    try:
        while True:
            started = time.monotonic()
            try:
                state["child"] = subprocess.Popen(command, env=env, stdin=subprocess.DEVNULL,
                                                  stdout=stream or subprocess.DEVNULL,
                                                  stderr=subprocess.STDOUT)
            except OSError as error:
                warn(f"cannot start {name}: {error}")
                return 1
            if state["stopping"]:  # a signal between starting it and storing it
                with contextlib.suppress(OSError):
                    state["child"].terminate()
            status = state["child"].wait()
            state["child"] = None
            if state["stopping"]:
                deliberate = True
                break
            # waybar, mako and sfwbar exit 0 when they are asked to stop, so a
            # clean exit is a program that was meant to end, like a crash isn't.
            if status == 0 or (status < 0 and -status in (signal.SIGTERM, signal.SIGKILL)):
                log_line(f"{name} was stopped; not restarting it")
                deliberate = True
                break
            if compositor_gone(env):
                log_line(f"{name} stopped with the session")
                deliberate = True
                break
            failures = failures + 1 if time.monotonic() - started < RESTART_HEALTHY_SECONDS else 1
            if failures > RESTART_LIMIT:
                warn(f"{name} failed {RESTART_LIMIT} times in a row (status {status}); giving up")
                break
            delay = min(RESTART_SECONDS * 2 ** (failures - 1), RESTART_SECONDS_MAX)
            warn(f"{name} stopped (status {status}); restarting it in {delay:.0f}s")
            time.sleep(delay)
    finally:
        for sig, previous in handlers:
            signal.signal(sig, previous)
    return 0 if deliberate or status == 0 else 1


def panel_environment(env, layout, style):
    env = dict(env)
    env["FLICKOS_LAYOUT"] = layout.id
    env["FLICKOS_STYLE"] = style.id
    return env


def session_environment():
    """The session's environment: the panel's, which labwc started (this
    command may run from a terminal or the Settings window)."""
    pids = managed_waybars()
    env = dict(process_environ(pids[0]) or os.environ) if pids else dict(os.environ)
    env.pop("FLICKOS_LAYOUT", None)
    env.pop("FLICKOS_STYLE", None)
    return env


def sync_menu(on):
    """Start flickos-menu's daemon when the start menu, Quick Settings or the
    phone popup is on (menu_daemon_wanted) and it isn't running, stop it when
    all three are off: nothing of them runs then. A running one gets SIGWINCH
    (hide), after which it builds the menu style of the new layout ahead of
    the next show, and builds or drops Quick Settings and the phone popup."""
    pids = managed_menus()
    if on and not pids:
        start_supervised(menu_command(), session_environment())
    elif not on and pids:
        stop(pids)
    elif on:
        for pid in pids:
            with contextlib.suppress(OSError):
                os.kill(pid, signal.SIGWINCH)


def restart_panel(layout, style, command, dock=None):
    """Replace FlickOS-managed waybar and dock processes with command (the
    new panel) and dock (the new layout's dock command, or None)."""
    pids = managed_waybars()
    if not pids:
        return False
    # The old panel was started by labwc, so its environment is the session's.
    env = panel_environment(process_environ(pids[0]) or os.environ, layout, style)
    stop(pids + managed_docks())
    start_supervised(command, env)
    if dock:
        start_supervised(dock, env)
    return True


# --- Wallpaper ----------------------------------------------------------------

def state_home():
    return os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")


def waypaper_choice():
    """(wallpaper, file it is saved in) chosen in waypaper, or None.

    waypaper saves it in its config.ini, or with use_xdg_state in state.ini;
    one line per monitor, the first is enough to know there is one."""
    config_file = os.path.join(config_home(), "waypaper", "config.ini")
    saved, section, key = config_file, "Settings", "wallpaper"
    ini = configparser.ConfigParser(interpolation=None)
    try:
        ini.read(config_file, encoding="utf-8")
        if ini.getboolean("Settings", "use_xdg_state", fallback=False):
            saved, section = os.path.join(state_home(), "waypaper", "state.ini"), "State"
            ini = configparser.ConfigParser(interpolation=None)
            ini.read(saved, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError, ValueError) as error:
        warn(f"{saved}: {error}")
        return None
    lines = [line.strip() for line in ini.get(section, key, fallback="").splitlines() if line.strip()]
    return (os.path.expanduser(lines[0]), saved) if lines else None


def swaybg_command(image):
    if image is None:
        return ["swaybg", "-c", WALLPAPER_COLOR]
    return ["swaybg", "-i", image, "-m", "fill", "-c", WALLPAPER_COLOR]


def wallpaper(layout, style=None):
    """(source, image, command) of the wallpaper to show. source is "waypaper"
    or "user" (the user's own choice), "layout", "style" or "default".

    A choice whose image is gone doesn't count, so the desktop never stays
    empty."""
    chosen = waypaper_choice()
    if chosen and os.path.isfile(chosen[0]) and shutil.which(WAYPAPER):
        return "waypaper", chosen[0], [WAYPAPER, "--restore"]
    for source, image in (("user", choice_path("wallpaper")),
                          ("layout", layout.wallpaper if layout else None),
                          ("style", style.wallpaper if style else None),
                          ("default", DEFAULT_WALLPAPER)):
        if image and os.path.isfile(image):
            return source, image, swaybg_command(image)
    return "default", None, swaybg_command(None)


def managed_wallpapers():
    """PIDs of this user's swaybg processes that show a FlickOS wallpaper: a
    layout's or a style's from any folder they are read from, the user's own
    included (also in the plain session, which may follow one), or the default."""
    dirs = layout_dirs(users=True) + style_dirs(users=True) + [os.path.dirname(DEFAULT_WALLPAPER)]
    return managed(own_processes("swaybg"), "-i", "--image", dirs)


def restart_wallpaper(layout, style=None):
    """Show the wallpaper of layout and style instead of the FlickOS one. A
    wallpaper the user chose stays. Returns True if the wallpaper was replaced."""
    source, _image, command = wallpaper(layout, style)
    if source not in ("layout", "style", "default"):
        return False
    pids = managed_wallpapers()
    if not pids:
        return False
    start_detached(command, process_environ(pids[0]) or os.environ)
    time.sleep(WALLPAPER_SWAP_SECONDS)
    stop(pids)
    return True


# --- Chooser -----------------------------------------------------------------

@contextlib.contextmanager
def single_instance(name):
    """Yields False if another process holds the lock $XDG_RUNTIME_DIR/flickos/name.

    The lock file isn't inherited by child processes (Python opens files
    non-inheritable), so a panel started by `set` never keeps it."""
    root = runtime_root()
    if root is None:
        yield True
        return
    os.makedirs(root, mode=0o700, exist_ok=True)
    with open(os.path.join(root, name), "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        yield True


def self_command(*args):
    """Command line that runs this program (also from a source tree)."""
    return [sys.executable, os.path.abspath(sys.argv[0]), *args]


def set_messages(stdout, stderr):
    """What `set` printed, for showing in a window: result line(s), then warnings."""
    lines = [line.strip() for line in stdout.splitlines() if line.strip()]
    lines += [line.strip().removeprefix("flickos-layout:").strip() for line in stderr.splitlines() if line.strip()]
    return lines


def apply_command(chosen, current):
    """The command that applies a chooser selection, or None if nothing changed.

    chosen and current are (layout, style, clicks) ids. Only what changed is
    passed, because setting a style also resets GTK settings, and an
    unchanged layout isn't saved as a choice."""
    layout_id, style_id, clicks_id = chosen
    args = [layout_id] if layout_id != current[0] else []
    if style_id != current[1]:
        args += ["--style", style_id]
    if clicks_id != current[2]:
        args += ["--clicks", clicks_id]
    return self_command("set", *args) if args else None


CSS_RGB = re.compile(r"rgba?\(\s*([\d.]+%?)\s*,\s*([\d.]+%?)\s*,\s*([\d.]+%?)\s*(?:,\s*([\d.]+%?)\s*)?\)")


def css_color(value):
    """(r, g, b, alpha) in 0…1 of a palette color: #rgb, #rrggbb, #rrggbbaa,
    rgb() or rgba(); None for anything else (a named color, @name)."""
    value = value.strip()
    if value.startswith("#"):
        digits = value[1:]
        if len(digits) == 3:
            digits = "".join(c * 2 for c in digits)
        if len(digits) not in (6, 8) or not re.fullmatch(r"[0-9a-fA-F]+", digits):
            return None
        parts = [int(digits[i:i + 2], 16) / 255 for i in range(0, len(digits), 2)]
        return tuple(parts) if len(parts) == 4 else (*parts, 1.0)
    match = CSS_RGB.fullmatch(value)
    if not match:
        return None

    def channel(text, scale):
        number = float(text[:-1]) / 100 if text.endswith("%") else float(text) / scale
        return min(max(number, 0.0), 1.0)
    try:
        return (*(channel(part, 255) for part in match.groups()[:3]),
                channel(match.group(4), 1) if match.group(4) else 1.0)
    except ValueError:
        return None


def palette_rgba(paths):
    """The @define-color values of waybar palettes (a path, or a chain: later
    files win) as (r, g, b, alpha) floats; comments and names left out."""
    colors = {}
    for path in [paths] if isinstance(paths, str) else paths:
        try:
            defines = css_defines(path)[0]
        except (OSError, UnicodeDecodeError):
            continue
        for name, value, _line in defines:
            color = css_color(value)
            if color is not None:
                colors[name] = color
    return colors


def palette_colors(paths):
    """palette_rgba without the alpha: (r, g, b)."""
    return {name: color[:3] for name, color in palette_rgba(paths).items()}


def blend(top, behind, alpha):
    """top drawn at alpha over behind, as GTK and labwc blend (sRGB values)."""
    return tuple(alpha * t + (1 - alpha) * b for t, b in zip(top, behind))


def palette_contrast(fore, back, panel_alpha=1.0):
    """(the lowest contrast of fore on back, the wallpaper it is lowest over
    or None). An opaque back is tested as it is; a see-through one (its own
    alpha, times panel_alpha) over black and over white."""
    if back[3] >= 1:
        return contrast(blend(fore[:3], back[:3], fore[3]), back[:3]), None
    alpha, worst = back[3] * panel_alpha, None
    for name, behind in WORST_BEHIND:
        shown = blend(back[:3], behind, alpha)
        ratio = contrast(blend(fore[:3], shown, fore[3]), shown)
        if worst is None or ratio < worst[0]:
            worst = (ratio, name)
    return worst


def pick_gtk(available, current, available_styles, current_style, current_clicks):
    """The GTK 3 chooser. Returns an exit code, or None if GTK can't be used."""
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GLib
        # Wayland app_id, matching flickos-layout.desktop (taskbar icon).
        GLib.set_prgname("flickos-layout")
        from gi.repository import Gdk, GdkPixbuf, Gio, Gtk
    except (ImportError, ValueError) as error:
        warn(f"GTK 3 is not available ({error})")
        return None
    if not Gtk.init_check(sys.argv[:1])[0]:
        warn("cannot open a GTK window (no display)")
        return None

    state = {"layout": current, "style": current_style, "clicks": current_clicks, "busy": False}
    rows = {}
    radios = {}
    click_radios = {}

    window = Gtk.Window(title=CHOOSER_TITLE, icon_name=CHOOSER_ICON, border_width=12)
    # Fits a 1366x768 screen with the panel and title bar (HIG WIN-3): the
    # choices scroll, the buttons below them stay in view.
    window.set_default_size(620, 680)
    window.connect("destroy", Gtk.main_quit)

    def key_pressed(_window, event):
        if event.keyval != Gdk.KEY_Escape:
            return False
        window.destroy()
        return True

    window.connect("key-press-event", key_pressed)
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    window.add(outer)
    content = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
    outer.pack_start(content, True, True, 0)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    box.set_focus_vadjustment(content.get_vadjustment())    # keep the focused choice in view
    content.add(box)

    intro = Gtk.Label(label="Choose how the panel and the window buttons are arranged, a dark or "
                            "light style, each with its own wallpaper, and what a click on the desktop does. "
                            "Apply changes the desktop right away.", xalign=0, wrap=True)
    box.pack_start(intro, False, False, 0)

    notice = Gtk.InfoBar(message_type=Gtk.MessageType.WARNING, no_show_all=True)
    notice_label = Gtk.Label(xalign=0, wrap=True, selectable=True)
    notice.get_content_area().add(notice_label)
    notice_label.show()
    box.pack_start(notice, False, False, 0)

    def heading(text):
        label = Gtk.Label(xalign=0)
        label.set_markup(f"<b>{GLib.markup_escape_text(text)}</b>")
        box.pack_start(label, False, False, 0)

    heading("Layout")
    listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE)
    frame = Gtk.Frame(shadow_type=Gtk.ShadowType.IN)
    frame.add(listbox)
    box.pack_start(frame, False, False, 0)

    def describe(name, comment, badge_text):
        """Name, description and a hidden "current" badge; returns (box, badge)."""
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, valign=Gtk.Align.CENTER)
        title = Gtk.Label(xalign=0)
        title.set_markup(f"<b>{GLib.markup_escape_text(name)}</b>")
        description = Gtk.Label(label=comment, xalign=0, wrap=True, max_width_chars=30)
        description.get_style_context().add_class("dim-label")
        badge = Gtk.Label(label=badge_text, xalign=0, no_show_all=True)
        for widget in (title, description, badge):
            text.pack_start(widget, False, False, 0)
        return text, badge

    for layout in available.values():
        row = Gtk.ListBoxRow()
        row.item_id = layout.id
        line = Gtk.Box(spacing=12, margin=8)
        row.add(line)
        image = Gtk.Image(width_request=PREVIEW_WIDTH, height_request=PREVIEW_HEIGHT)
        if layout.preview and os.path.isfile(layout.preview):
            try:
                image.set_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    layout.preview, PREVIEW_WIDTH, PREVIEW_HEIGHT, True))
            except GLib.Error as error:
                warn(f"{layout.preview}: {error.message}")
        if image.get_storage_type() == Gtk.ImageType.EMPTY:
            # No picture (a user's own layout): a plain tile with its name.
            image = Gtk.Frame(shadow_type=Gtk.ShadowType.IN, width_request=PREVIEW_WIDTH,
                              height_request=PREVIEW_HEIGHT)
            image.add(Gtk.Label(label=layout.name, wrap=True, justify=Gtk.Justification.CENTER,
                                max_width_chars=20))
            image.get_child().get_style_context().add_class("dim-label")
        line.pack_start(image, False, False, 0)
        text, row.badge = describe(layout.name, item_comment(layout), "Current layout")
        line.pack_start(text, True, True, 0)
        rows[layout.id] = row
        listbox.add(row)

    heading("Style")
    style_box = Gtk.Box(spacing=24, homogeneous=True)
    box.pack_start(style_box, False, False, 0)

    def draw_swatches(area, cr, colors):
        size = SWATCH_SIZE
        for i, name in enumerate(n for n in SWATCH_COLORS if n in colors):
            cr.set_source_rgba(*colors[name])
            cr.rectangle(i * size + 0.5, 0.5, size - 1, size - 1)
            cr.fill_preserve()
            cr.set_source_rgb(*colors.get("borders", (0.5, 0.5, 0.5, 1.0))[:3])
            cr.set_line_width(1)
            cr.stroke()
        return False

    group = None
    for style in available_styles.values():
        radio = Gtk.RadioButton.new_from_widget(group)
        group = group or radio
        radio.item_id = style.id
        line = Gtk.Box(spacing=12)
        colors = palette_rgba(palette_chain(style, "waybar"))
        swatches = Gtk.DrawingArea(width_request=SWATCH_SIZE * len(SWATCH_COLORS), height_request=SWATCH_SIZE,
                                   valign=Gtk.Align.CENTER)
        swatches.connect("draw", draw_swatches, colors)
        line.pack_start(swatches, False, False, 0)
        text, radio.badge = describe(style.name, item_comment(style), "Current style")
        line.pack_start(text, True, True, 0)
        radio.add(line)
        radios[style.id] = radio
        style_box.pack_start(radio, True, True, 0)

    heading("Desktop clicks")
    clicks_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    box.pack_start(clicks_box, False, False, 0)
    group = None
    for clicks in CLICKS.values():
        radio = Gtk.RadioButton.new_from_widget(group)
        group = group or radio
        radio.item_id = clicks.id
        text, radio.badge = describe(clicks.name, clicks.comment, "Current setting")
        radio.add(text)
        click_radios[clicks.id] = radio
        clicks_box.pack_start(radio, False, False, 0)

    status = Gtk.Label(xalign=0, wrap=True, selectable=True)
    outer.pack_start(status, False, False, 0)
    buttons = Gtk.ButtonBox(layout_style=Gtk.ButtonBoxStyle.END, spacing=6)
    if shutil.which(WAYPAPER):
        wallpaper_button = Gtk.Button.new_with_mnemonic("_Wallpaper…")
        wallpaper_button.set_tooltip_text("Choose your own wallpaper. Layouts and styles then keep it.")
        wallpaper_button.connect("clicked", lambda _b: start_detached([WAYPAPER], os.environ))
        buttons.add(wallpaper_button)
        buttons.set_child_secondary(wallpaper_button, True)
    # Apply, unlike Settings' layout page, which changes things as they are
    # chosen: this window is also what a new account sees first (first-run,
    # without flickos-welcome), and picking through the layouts one by one
    # would restart the panel at every click (HIG WIN-8).
    close = Gtk.Button.new_with_mnemonic("_Close")
    close.connect("clicked", lambda _b: window.destroy())
    apply = Gtk.Button.new_with_mnemonic("_Apply")
    apply.get_style_context().add_class("suggested-action")
    buttons.add(close)
    buttons.add(apply)
    outer.pack_start(buttons, False, False, 0)

    def selection():
        row = listbox.get_selected_row()
        style_id = next((i for i, radio in radios.items() if radio.get_active()), state["style"])
        clicks_id = next((i for i, radio in click_radios.items() if radio.get_active()), state["clicks"])
        return (row.item_id if row else state["layout"]), style_id, clicks_id

    def current_state():
        return state["layout"], state["style"], state["clicks"]

    def refresh(*_args):
        for layout_id, row in rows.items():
            row.badge.set_visible(layout_id == state["layout"])
        for style_id, radio in radios.items():
            radio.badge.set_visible(style_id == state["style"])
        for clicks_id, radio in click_radios.items():
            radio.badge.set_visible(clicks_id == state["clicks"])
        pending = apply_command(selection(), current_state())
        apply.set_sensitive(not state["busy"] and pending is not None)
        for widget in (listbox, style_box, clicks_box):
            widget.set_sensitive(not state["busy"])
        warnings = doctor_warnings()
        notice_label.set_text("\n".join(warnings))
        notice.set_visible(bool(warnings))

    def finished(process, result, chosen):
        try:
            _, stdout, stderr = process.communicate_utf8_finish(result)
            ok = process.get_successful()
        except GLib.Error as error:
            stdout, stderr, ok = "", error.message, False
        messages = set_messages(stdout or "", stderr or "")
        if ok:
            state["layout"], state["style"], state["clicks"] = chosen
        elif not messages:
            messages = ["Could not apply the change."]
        # doctor warnings are shown above the list, not twice.
        warnings = set(doctor_warnings())
        status.set_text("\n".join(m for m in messages if m not in warnings))
        state["busy"] = False
        refresh()

    def apply_selected(*_args):
        chosen = selection()
        command = apply_command(chosen, current_state())
        if state["busy"] or command is None:
            return
        state["busy"] = True
        status.set_text("Applying…")
        refresh()
        try:
            process = Gio.Subprocess.new(command, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as error:
            status.set_text(error.message)
            state["busy"] = False
            refresh()
            return
        process.communicate_utf8_async(None, None, finished, chosen)

    listbox.connect("row-selected", refresh)
    listbox.connect("row-activated", apply_selected)
    for radio in [*radios.values(), *click_radios.values()]:
        radio.connect("toggled", refresh)
    apply.connect("clicked", apply_selected)
    listbox.select_row(rows.get(current))
    for selected, group_radios in ((current_style, radios), (current_clicks, click_radios)):
        if selected in group_radios:
            group_radios[selected].set_active(True)
    refresh()
    window.show_all()
    if current in rows:
        rows[current].grab_focus()
    Gtk.main()
    return 0


def notify(summary, lines):
    """Desktop notification, or stderr without notify-send."""
    if shutil.which("notify-send"):
        with contextlib.suppress(OSError, subprocess.TimeoutExpired):
            subprocess.run(["notify-send", "-a", CHOOSER_TITLE, "-i", CHOOSER_ICON, summary, "\n".join(lines)],
                           check=False, timeout=10)
            return
    for line in [summary, *lines]:
        print(line, file=sys.stderr)


def item_comment(item):
    """An item's description in the chooser: a user's own style says so, and
    the style being tried."""
    comment = item.comment
    if getattr(item, "user", False):
        comment = f"{comment} · {YOURS}" if comment else YOURS
    if isinstance(item, Style) and item.id == tried_style_id():
        comment += f" · {TRYING}"
    return comment


def fuzzel_menu(prompt, items, current):
    """Choose one of items (layouts or styles) with fuzzel --dmenu.
    Returns the chosen item, or None if cancelled. Raises OSError without fuzzel."""
    items = list(items)
    entries = []
    for item in items:
        mark = " (current)" if item.id == current else ""
        # One line per entry; the icon uses fuzzel's (Rofi's) dmenu extension.
        text = f"{item.name}{mark}: {item_comment(item)}".replace("\n", " ")
        entries.append(f"{text}\0icon\x1f{CHOOSER_ICON}")
    index = next((i for i, item in enumerate(items) if item.id == current), 0)
    result = subprocess.run(["fuzzel", "--dmenu", "--index", f"--select-index={index}",
                             f"--prompt={prompt}: ", f"--lines={len(entries)}", "--width=90"],
                            input="\n".join(entries) + "\n", stdout=subprocess.PIPE, text=True, check=False)
    try:
        return items[int(result.stdout.strip())]
    except (ValueError, IndexError):
        return None


def pick_fuzzel(available, current, available_styles, current_style, current_clicks=None):
    """Chooser without GTK: fuzzel --dmenu, first the layout, then the style
    (desktop clicks stay). Returns an exit code, or None without fuzzel."""
    if not shutil.which("fuzzel"):
        return None
    try:
        layout = fuzzel_menu("Desktop Layout", available.values(), current)
        style = layout and fuzzel_menu("Style", available_styles.values(), current_style)
    except OSError as error:
        warn(f"fuzzel: {error}")
        return None
    if layout is None or style is None:
        return 0  # cancelled
    command = apply_command((layout.id, style.id, current_clicks), (current, current_style, current_clicks))
    if command is None:
        return 0
    done = subprocess.run(command, capture_output=True, text=True, check=False)
    summary = CHOOSER_TITLE if done.returncode == 0 else "Could not apply the change"
    notify(summary, set_messages(done.stdout, done.stderr))
    return done.returncode


# --- Doctor -------------------------------------------------------------------

def labwc_warnings(root):
    """doctor's lines about the user's own labwc files: merged (nothing to
    say), or replacing FlickOS's, why, and what to change."""
    found = []
    folder = os.path.join(config_home(), "labwc")
    rcxml, environment = os.path.join(folder, "rc.xml"), os.path.join(folder, "environment")
    autostart = os.path.join(folder, "autostart")
    merging = labwc_merges(root)
    merge, why, about = merge_decision(root)
    lost = ("layouts and styles don't change window buttons and borders"
            + (", tiling (flick-tiler) can't place windows" if installed("flick-tiler") else "")
            + (", and mouse, touchpad and keyboard settings (Settings) don't apply" if installed("flickos-control")
               else ""))
    if os.path.isfile(rcxml) and not merging:
        if why == "copy":
            found.append(f"{rcxml} is a copy of FlickOS's rc.xml, so it replaces it: {lost}. Keep only your own "
                         "changes in it, without the FlickOS comment at its top, then log out and in: it is then "
                         "added to FlickOS's instead.")
        elif why == "default":
            found.append(f"{rcxml} has <default />, which would bring labwc's own keys back over FlickOS's, so it "
                         f"replaces FlickOS's rc.xml: {lost}. Delete the <default /> lines, then log out and in: "
                         "it is then added to FlickOS's instead.")
        elif why is None:
            found.append(f"{rcxml} replaces FlickOS's rc.xml until you log out and in: {lost}. After that "
                         "labwc adds it to FlickOS's.")
        else:
            found.append(f"{rcxml} replaces FlickOS's rc.xml (labwc doesn't merge: {MERGE_REASONS[why]}): {lost}.")
    if why == "menu":
        found.append(f"{about} uses menu ids that FlickOS's menu has ({', '.join(menu_conflicts(root, text_of(about) or ''))}), "
                     "so labwc can't merge your files with FlickOS's. Give your menus ids of their own, then log "
                     "out and in.")
    if os.path.isfile(autostart):
        calls_flickos = FLICKOS_AUTOSTART in (text_of(autostart) or FLICKOS_AUTOSTART)
        found.append(f"{autostart} replaces FlickOS's autostart"
                     + ("" if calls_flickos else f" and doesn't run {FLICKOS_AUTOSTART}, so the FlickOS panel and "
                                                 "notifications aren't started")
                     + ", and keeps labwc from merging your files with FlickOS's. Start programs from Settings → "
                       "Startup Applications instead, delete it, then log out and in.")
    if (not merging and root and os.path.isfile(os.path.join(root, CONTROL_ENVIRONMENT))
            and (os.path.isfile(environment) or os.path.isdir(environment + ".d"))):
        found.append(f"{environment} exists: it replaces the system environment file, "
                     "so the keyboard layout chosen in Settings doesn't apply.")
    if in_session() and merge != merging and why not in ("live", "plain"):
        found.append("Your labwc files changed: labwc "
                     + ("merges them with FlickOS's" if merge else "stops merging them with FlickOS's")
                     + " after you log out and in."
                     + (" " + DEFAULT_WHILE_MERGING if default_while_merging(root, why) else ""))
    return found


def doctor_warnings():
    """User configuration that stops part of a layout or style from applying."""
    if plain_session():
        return ["This is the plain session: your own styles, add-ons, panel, notification settings and labwc "
                "files are left out, and choices can't be changed. Log out and in normally to use them."]
    found = []
    tried = tried_style_id()
    if tried:
        found.append(f"You are trying the style {tried} until you log out: flickos-layout style set {tried} "
                     "keeps it, flickos-layout try --end ends it now.")
    waybar = user_waybar_config()
    if waybar:
        found.append(f"{waybar} exists: waybar uses your own panel, so layouts and styles don't change it.")
    try:
        with contextlib.redirect_stderr(io.StringIO()):
            layout = resolve_layout(layouts())
    except LayoutError:
        layout = None
    mine = ([layout.style] if layout and layout.user else []) + user_addon_styles(addons()) + [tweaks_css()]
    for path in css_errors(mine):
        found.append(f"{shown_path(path)} is left out of the panel: GTK can't read it, and waybar would stop. "
                     "flickos-layout check names the line.")
    for name, other in hidden_layouts():
        found.append(f"Your layout {name} hides the one in {other}, so its updates don't reach you. Rename your "
                     "folder to keep both.")
    root = runtime_root()
    found += labwc_warnings(root)
    for name, program in (("foot/foot.ini", "the terminal"), ("fuzzel/fuzzel.ini", "the app launcher"),
                          ("mako/config", "notifications")):
        path = os.path.join(config_home(), name)
        stable = os.path.join(root, STYLE_PALETTES, os.path.basename(name)) if root else None
        follows = stable and any(p == stable for p, _d, _e in include_chain(path))
        if os.path.isfile(path) and not follows:
            found.append(f"{path} exists: styles don't change the colors of {program}."
                         + (f" To follow them, start it with include={stable}" if stable and program != "notifications"
                            else ""))
    installed_styles = None
    for key, attribute, what in (("gtk-theme", "gtk_theme", "GTK theme"), ("icon-theme", "icon_theme", "icon theme")):
        current = gsettings_get(key)
        if current is None:
            continue
        if installed_styles is None:
            with contextlib.redirect_stderr(io.StringIO()):
                installed_styles = styles()
        if installed_styles and current not in {getattr(s, attribute) for s in installed_styles.values()}:
            found.append(f"Your {what} is '{current}' (chosen in Appearance), so styles don't change it.")
    current = gsettings_get("button-layout")
    if current is not None:
        with contextlib.redirect_stderr(io.StringIO()):
            installed_layouts = layouts()
        if any(l.titlebar_layout for l in installed_layouts.values()) and \
                current not in layout_button_layouts(installed_layouts, gsettings_default("button-layout")):
            found.append(f"Your window buttons are '{current}' (org.gnome.desktop.wm.preferences button-layout), "
                         "so layouts don't change them in windows that draw their own title bar, like Firefox.")
    chosen = waypaper_choice()
    if chosen and os.path.isfile(chosen[0]) and shutil.which(WAYPAPER):
        found.append(f"Your wallpaper is {chosen[0]}, chosen in Wallpaper, so layouts and styles don't change it. "
                     f"To get FlickOS's wallpapers back, delete the wallpaper line in {chosen[1]}.")
    elif os.path.isfile(choice_path("wallpaper")):
        found.append(f"{choice_path('wallpaper')} exists: it is your wallpaper, so layouts and styles don't change it.")
    if os.environ.get("LABWC_PID") and not session_uses_overlay():
        found.append("This session started without the layout overlay: window buttons, window borders, "
                     "terminal and launcher colors change after you log out and in.")
    with contextlib.redirect_stderr(io.StringIO()):
        current_style = resolve_style(styles())
    found += [message[0].upper() + message[1:] + "." for message in style_fallback_messages(current_style)]
    return found


# --- Users' styles: check and new ----------------------------------------------

@dataclasses.dataclass
class Problem:
    """One line of `check`: FILE[:LINE]: LEVEL: MESSAGE."""
    path: str | None
    line: int | None
    level: str            # "error" or "warning"
    message: str

    def __str__(self):
        where = self.path + (f":{self.line}" if self.line else "") + ": " if self.path else ""
        return f"{where}{self.level}: {self.message}"


def ini_entries(path):
    """[(section, key, value, line)] of a foot/fuzzel/mako file; keys before
    any section have section "". Comments and blank lines are left out."""
    entries, section = [], ""
    with open(path, encoding="utf-8") as f:
        for number, line in enumerate(f, 1):
            line = line.strip()
            if not line or line[0] in "#;":
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1].strip()
            elif "=" in line:
                key, value = line.split("=", 1)
                entries.append((section, key.strip(), value.strip(), number))
            else:
                entries.append((section, line, None, number))
    return entries


CSS_COMMENT = re.compile(r"/\*.*?\*/", re.S)
DEFINE_COLOR = re.compile(r"^@define-color\s+([\w-]+)\s+(.+?)\s*;$")
CSS_COLOR = re.compile(r"^(#[0-9a-fA-F]{3}|#[0-9a-fA-F]{6}|#[0-9a-fA-F]{8}|rgba?\([\d\s.,%]+\))$")


def css_defines(path):
    """[(name, value, line)] of a waybar palette's @define-color lines, and
    [(line, text)] of anything else that isn't a comment."""
    with open(path, encoding="utf-8") as f:
        text = CSS_COMMENT.sub(lambda m: "\n" * m.group(0).count("\n"), f.read())
    defines, other = [], []
    for number, line in enumerate(text.splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        match = DEFINE_COLOR.match(line)
        if match:
            defines.append((match.group(1), match.group(2), number))
        else:
            other.append((number, line))
    return defines, other


def base_palette_keys(raw):
    """{kind: allowed keys} from the BASE_STYLE's own palette files: what
    a style's palette files may set (ADR-002, ADR-006). Empty if unreadable."""
    allowed = {}
    if BASE_STYLE not in raw or raw[BASE_STYLE][2] is None:
        return allowed
    folder, _path, section, _user = raw[BASE_STYLE]
    for name in PALETTE_KEYS:
        kind = name.lower()
        try:
            path = os.path.join(folder, section[kind])
            if kind == "waybar":
                allowed[kind] = {define[0] for define in css_defines(path)[0]}
            else:
                allowed[kind] = {(entry[0], entry[1]) for entry in ini_entries(path)}
        except (KeyError, OSError, UnicodeDecodeError):
            pass
    return allowed


def palette_file_problems(kind, path, allowed):
    """A palette file may hold only palette keys: no commands (ADR-006)."""
    problems = []
    try:
        if kind == "waybar":
            defines, other = css_defines(path)
            for number, text in other:
                problems.append(Problem(path, number, "error", f"only @define-color lines may be here, not {text!r}"))
            for name, value, number in defines:
                if allowed.get(kind) and name not in allowed[kind]:
                    problems.append(Problem(path, number, "error", f"{name} isn't one of the panel's colors "
                                                                   f"({', '.join(sorted(allowed[kind]))})"))
                if not CSS_COLOR.match(value):
                    problems.append(Problem(path, number, "error", f"{value} isn't a color (#rrggbb)"))
            return problems
        for section, key, value, number in ini_entries(path):
            if value is None:
                problems.append(Problem(path, number, "error", f"{key!r} is not a key=value line"))
            elif key == "include":
                problems.append(Problem(path, number, "error", "include= isn't allowed in a style's colors"))
            elif allowed.get(kind) and (section, key) not in allowed[kind]:
                where = f" in [{section}]" if section else ""
                problems.append(Problem(path, number, "error", f"{key}{where} isn't one of the style's keys "
                                                               f"for {kind}; only colors may be here"))
    except (OSError, UnicodeDecodeError) as error:
        problems.append(Problem(path, None, "error", f"can't be read ({error})"))
    return problems


def contrast(first, second):
    """WCAG contrast ratio of two (r, g, b) colors in 0…1."""
    def luminance(color):
        r, g, b = (c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4 for c in color)
        return 0.2126 * r + 0.7152 * g + 0.0722 * b
    light, dark = sorted((luminance(first), luminance(second)), reverse=True)
    return (light + 0.05) / (dark + 0.05)


def ini_colors(paths, section="colors"):
    """{key: (r, g, b)} of rrggbb values in a section of foot files, later ones winning."""
    colors = {}
    for path in paths:
        try:
            entries = ini_entries(path)
        except (OSError, UnicodeDecodeError):
            continue
        for entry_section, key, value, _line in entries:
            if entry_section == section and value and re.fullmatch(r"[0-9a-fA-F]{6}([0-9a-fA-F]{2})?", value):
                colors[key] = tuple(int(value[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return colors


def package_installed(name):
    try:
        result = subprocess.run([DPKG_QUERY, "-W", "-f", "${db:Status-Status}", name], capture_output=True,
                                text=True, timeout=10, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return True     # can't tell: say nothing
    return result.stdout.strip() == "installed"


def style_problems(style_id, raw=None):
    """What's wrong with one style ([] if it isn't one)."""
    raw = raw_styles() if raw is None else raw
    if style_id not in raw:
        return []
    resolved, errors = resolve_styles(raw)
    folder, path, section, _user = raw[style_id]
    if style_id in errors:
        message = errors[style_id]
        return [Problem(path, None, "error", message.removeprefix(path + ": "))]
    style, problems = resolved[style_id], []
    allowed = base_palette_keys(raw)
    for name in PALETTE_KEYS:
        own = section.get(name.lower())
        if not own:
            continue
        palette = os.path.join(folder, own)
        if not os.path.isfile(palette):
            problems.append(Problem(path, None, "error", f"{name}={own}: no such file"))
        else:
            problems += palette_file_problems(name.lower(), palette, allowed)
    if section.get("wallpaper"):
        wallpaper = os.path.join(folder, section["wallpaper"])
        if not os.path.realpath(wallpaper).startswith(os.path.realpath(folder) + os.sep):
            problems.append(Problem(path, None, "error", f"Wallpaper={section['wallpaper']} is outside the style's "
                                                         "folder"))
        elif not wallpaper.lower().endswith(WALLPAPER_EXTENSIONS) or not os.path.isfile(wallpaper):
            problems.append(Problem(path, None, "error", f"Wallpaper={section['wallpaper']}: no PNG or JPEG file "
                                                         "there"))
    problems += [Problem(path, None, "warning", message.removeprefix(f"style {style_id}: "))
                 for message in style_fallback_messages(style)]
    for package in style.packages:
        if not PACKAGE_NAME.match(package):
            problems.append(Problem(path, None, "error", f"Packages={package} isn't a package name"))
        elif not package_installed(package):
            problems.append(Problem(path, None, "warning", f"package {package} isn't installed "
                                                           f"(sudo apt install {package})"))
    colors = palette_rgba(palette_chain(style, "waybar"))
    pairs = [("fg_color", "wm_bg", TEXT_CONTRAST), ("fg_color", "bg_color", TEXT_CONTRAST),
             ("fg_color", "base_color", TEXT_CONTRAST), ("selected_fg_color", "selected_bg_color", ACCENT_CONTRAST)]
    for fore, back, wanted in pairs:
        if fore not in colors or back not in colors:
            continue
        ratio, behind = palette_contrast(colors[fore], colors[back], PANEL_ALPHA if back == "wm_bg" else 1.0)
        if ratio < wanted:
            problems.append(Problem(style.waybar, None, "warning",
                                    f"{fore} on {back} is {ratio:.1f}:1"
                                    + (f" over a {behind} wallpaper" if behind else "")
                                    + f", below {wanted:g}:1: hard to read (HIG A11Y-6)"))
    foot = ini_colors(palette_chain(style, "foot"))
    if "foreground" in foot and "background" in foot and contrast(foot["foreground"], foot["background"]) < \
            TEXT_CONTRAST:
        problems.append(Problem(style.foot, None, "warning",
                                f"the terminal's foreground on background is "
                                f"{contrast(foot['foreground'], foot['background']):.1f}:1, below "
                                f"{TEXT_CONTRAST:g}:1: hard to read (HIG A11Y-6)"))
    return problems


def xml_elements(path):
    """[(element path below the root, line, text)] of an XML file, and the
    root's name. Raises xml.parsers.expat.ExpatError."""
    elements, stack, texts = [], [], []
    root = []
    parser = xml.parsers.expat.ParserCreate()

    def start(name, _attributes):
        if not root:
            root.append(name)
        stack.append(name)
        texts.append([])
        elements.append(["/".join(stack[1:]), parser.CurrentLineNumber, None])

    def end(_name):
        text = "".join(texts.pop()).strip()
        path_now = "/".join(stack[1:])
        for element in reversed(elements):
            if element[0] == path_now and element[2] is None:
                element[2] = text
                break
        stack.pop()

    parser.StartElementHandler, parser.EndElementHandler = start, end
    parser.CharacterDataHandler = lambda data: texts[-1].append(data) if texts else None
    with open(path, "rb") as f:
        parser.ParseFile(f)
    return [tuple(e) for e in elements], (root[0] if root else None)


def labwc_problems():
    """The user's own labwc files: well-formed, known sections, numbers."""
    problems, folder = [], os.path.join(config_home(), "labwc")
    try:
        names = sorted(n for n in os.listdir(folder) if n.endswith(".xml"))
    except OSError:
        return problems
    for name in names:
        path = os.path.join(folder, name)
        try:
            elements, root = xml_elements(path)
        except xml.parsers.expat.ExpatError as error:
            consequence = (": labwc ignores the whole file and uses its own defaults, without FlickOS's keys"
                           if name == "rc.xml" else ": labwc can't read it")
            problems.append(Problem(path, error.lineno, "error",
                                    f"not well-formed XML ({xml.parsers.expat.errors.messages[error.code]})"
                                    + consequence))
            continue
        except OSError as error:
            problems.append(Problem(path, None, "error", f"can't be read ({error})"))
            continue
        if name != "rc.xml":
            continue
        for element, line, text in elements:
            if element and "/" not in element and element not in LABWC_SECTIONS:
                problems.append(Problem(path, line, "warning", f"<{element}> isn't a labwc setting: labwc "
                                                               "ignores it"))
            if element in LABWC_NUMBERS and text is not None and not re.fullmatch(r"-?\d+", text):
                problems.append(Problem(path, line, "error", f"<{element.split('/')[-1]}> is {text!r}, not a "
                                                             "number: labwc reads it as 0"))
    return problems


def addon_problems():
    """What the user's add-ons would warn about at login (only in panel.log there)."""
    problems, home = [], os.path.join(config_home(), ADDONS_HOME)
    mine = {name: folder for name, folder in addons().items() if folder.startswith(home + os.sep)}
    captured = io.StringIO()
    with contextlib.redirect_stderr(captured):
        addon_fragments(mine)
    for line in captured.getvalue().splitlines():
        problems.append(Problem(home, None, "warning", line.removeprefix("flickos-layout: ")))
    for name, folder in mine.items():
        path = os.path.join(folder, ADDON_WAYBAR)
        if os.path.isfile(path):
            try:
                load_jsonc(path)
            except LayoutError as error:
                problems.append(Problem(path, None, "error", str(error).removeprefix(path + ": ")))
    return problems + css_parse_problems(user_addon_styles(mine))


def css_parse_problems(paths, instead="the panel leaves this file out"):
    """Errors of GTK's parser in the user's CSS files: waybar would stop on them."""
    problems = []
    for path, error in css_errors(paths).items():
        imported = "" if error.file == path else f" (imported by {shown_path(path)})"
        column = f"column {error.column}: " if error.line and error.column else ""
        problems.append(Problem(error.file, error.line or None, "error",
                                f"{column}{error.message}{imported}; waybar would stop, so {instead}"))
    return problems


def tweaks_problems():
    tweaks = tweaks_css()
    return css_parse_problems([tweaks]) if tweaks else []


def include_problems():
    """include= lines in the user's foot, fuzzel and mako configs that point nowhere."""
    problems = []
    for relative, program in (("foot/foot.ini", "foot"), ("fuzzel/fuzzel.ini", "fuzzel"), ("mako/config", "mako")):
        path = os.path.join(config_home(), relative)
        try:
            with open(path, encoding="utf-8") as f:
                lines = f.readlines()
        except (OSError, UnicodeDecodeError):
            continue
        for number, line in enumerate(lines, 1):
            match = re.match(r"\s*include\s*=\s*(.*?)\s*$", line)
            if not match:
                continue
            target = os.path.expanduser(match.group(1))
            if not os.path.isabs(target):
                problems.append(Problem(path, number, "error", f"include={match.group(1)}: {program} takes only an "
                                                               "absolute path or one starting with ~/"))
            elif not os.path.isfile(target):
                if program == "mako":
                    problems.append(Problem(path, number, "error", f"include={match.group(1)}: no such file, and "
                                                                   "mako doesn't start without it: no notifications"))
                else:
                    problems.append(Problem(path, number, "warning", f"include={match.group(1)}: no such file"))
    return problems


def all_problems():
    """Everything of the user's: their styles, labwc files, add-ons,
    includes, then doctor's warnings."""
    raw, problems = raw_styles(), []
    for style_id, (_folder, _path, _section, user) in raw.items():
        if user:
            problems += style_problems(style_id, raw)
    problems += user_layout_problems()
    problems += labwc_problems() + addon_problems() + tweaks_problems() + include_problems()
    problems += [Problem(None, None, "warning", message) for message in doctor_warnings()]
    return problems


def cmd_check(opts):
    if opts.layout:
        with contextlib.redirect_stderr(io.StringIO()):
            folders = layout_folders()
        if opts.layout not in folders:
            warn(f"unknown layout '{opts.layout}'. Available: {', '.join(folders) or 'none'}")
            return 1
        problems = layout_problems(opts.layout, folders)
        for problem in problems:
            print(problem)
        return 1 if any(problem.level == "error" for problem in problems) else 0
    with contextlib.redirect_stderr(io.StringIO()):
        if opts.id:
            raw = raw_styles()
            known = opts.id in raw
            problems = style_problems(opts.id, raw) if known else []
        else:
            known, problems = True, all_problems()
    if not known:
        warn(f"unknown style '{opts.id}'. Available: {', '.join(raw) or 'none'}")
        return 1
    for problem in problems:
        print(problem)
    return 1 if any(problem.level == "error" for problem in problems) else 0


def merged_css(paths):
    """{name: value} of @define-color lines over a chain, later winning, in first-seen order."""
    values = {}
    for path in paths:
        try:
            for name, value, _line in css_defines(path)[0]:
                values[name] = value
        except (OSError, UnicodeDecodeError):
            pass
    return values


def merged_ini(paths):
    """{section: {key: value}} over a chain, later winning, in first-seen order."""
    values = {}
    for path in paths:
        try:
            entries = ini_entries(path)
        except (OSError, UnicodeDecodeError):
            continue
        for section, key, value, _line in entries:
            if value is not None:
                values.setdefault(section, {})[key] = value
    return values


def starter_files(name, parent):
    """{file name: text} of a new style that inherits parent and sets
    nothing yet: every key with the parent's value, commented out."""
    files = {"style.ini": "\n".join([
        f"# {name}: your own style (flickos-layout style new). Everything it doesn't",
        f"# set comes from {parent.id} (Inherits=), so FlickOS's updates to that style",
        "# reach this one. Uncomment a line and change it to set it here.",
        "# Check:  flickos-layout check {id}",
        "# Use:    flickos-layout style set {id}",
        "# The keys: docs/09-customizing.md, \"Your own style\".",
        "[Style]",
        f"Name={name}",
        f"Comment=Based on {parent.name}",
        f"Inherits={parent.id}",
        "Waybar=waybar-colors.css",
        "Foot=foot.ini",
        "Fuzzel=fuzzel.ini",
        "Mako=mako.conf",
        f"# GtkTheme={parent.gtk_theme}",
        f"# IconTheme={parent.icon_theme}",
        f"# LabwcTheme={parent.labwc_theme}",
        f"# ColorScheme={parent.color_scheme}",
        "# Wallpaper=wallpaper.png",
        "# Packages=",
    ]) + "\n"}
    lines = [f"/* {name}: the panel's colors, {parent.id}'s values. To change one, take",
             " * away the comment marks around its line and change the color. Only",
             " * @define-color lines with a color may be in this file. */"]
    lines += [f"/* @define-color {key} {value}; */" for key, value in merged_css(palette_chain(parent, "waybar")).items()]
    files["waybar-colors.css"] = "\n".join(lines) + "\n"
    for kind, file_name, program in (("foot", "foot.ini", "the terminal"), ("fuzzel", "fuzzel.ini", "the launcher"),
                                     ("mako", "mako.conf", "notifications")):
        lines = [f"# {name}: the colors of {program}, {parent.id}'s values. To change one,",
                 "# take away the # before its line and change it. Only these keys may",
                 "# be in this file."]
        for section, values in merged_ini(palette_chain(parent, kind)).items():
            if section:
                lines.append(f"[{section}]")
            lines += [f"# {key}={value}" for key, value in values.items()]
        files[file_name] = "\n".join(lines) + "\n"
    return files


def cmd_style_new(opts):
    style_id = opts.id
    if not LAYOUT_ID.match(style_id):
        warn(f"'{style_id}' can't be a style id: use lowercase letters, digits, - and _")
        return 1
    raw = raw_styles()
    if style_id in raw:
        warn(f"style {style_id} exists already in {raw[style_id][0]}")
        return 1
    with contextlib.redirect_stderr(io.StringIO()):
        available = styles()
        parent_id = opts.from_style or resolve_style(available).id
    if parent_id not in available:
        warn(f"unknown style '{parent_id}'. Available: {', '.join(available) or 'none'}")
        return 1
    folder = os.path.join(user_styles_dir(), style_id)
    try:
        os.makedirs(folder)
        for file_name, text in starter_files(opts.name or style_id, available[parent_id]).items():
            write_atomic(os.path.join(folder, file_name), text.replace("{id}", style_id))
    except OSError as error:
        warn(f"can't make {folder}: {error}")
        return 1
    print(folder)
    return 0


# --- Users' layouts: new and check (phase 5, step 5b) ---------------------------

JSONC_INCLUDE = re.compile(r'("include"\s*:\s*)(\[[^\]]*\]|"(?:[^"\\]|\\.)*")')
CSS_URL = re.compile(r"""url\((["']?)(.*?)\1\)""")
CSS_DECLARATION_COLOR = re.compile(r":[^;{}]*?(#[0-9a-fA-F]{3,8}\b|rgba?\([^)]*\))")
# Signals FlickOS's panel buttons use, by what they refresh.
PANEL_SIGNALS = {8: "the tiling button", 9: "the phone button", 10: "the recording time",
                 DESKTOPS_SIGNAL: "the desktop buttons"}
RECORDING_MODULE = "custom/recording"
SHOW_DESKTOP_MODULE = "custom/desktop"


def absolute(value, folder):
    return value if os.path.isabs(value) else os.path.normpath(os.path.join(folder, value))


def absolute_includes(text, folder):
    """A waybar config's text with relative include paths made absolute."""
    def paths(match):
        return match.group(1) + re.sub(r'"([^"]*)"', lambda m: '"' + absolute(m.group(1), folder) + '"',
                                       match.group(2))
    return JSONC_INCLUDE.sub(paths, text)


def absolute_urls(text, folder):
    """CSS with relative url()s (@import and pictures) made absolute."""
    def url(match):
        quote, value = match.group(1), match.group(2)
        if re.match(r"^[a-z][a-z0-9+.-]*:", value):
            return match.group(0)
        return f"url({quote}{absolute(value, folder)}{quote})"
    return CSS_URL.sub(url, text)


def starter_layout_ini(layout_id, name, source, modules):
    """layout.ini of a user's layout made from source; modules: every module
    its bars use."""
    lines = [f"# {layout_id}: your own layout (flickos-layout layout new), from {source.name}.",
             "# Its panel is waybar.jsonc and style.css in this folder. They use FlickOS's",
             "# shared modules and CSS in /usr/share/flickos/layouts/common/ by their full",
             "# paths, so FlickOS's fixes to those reach this layout.",
             f"# Check:  flickos-layout check --layout {layout_id}",
             f"# Use:    flickos-layout set {layout_id}",
             '# The keys: docs/09-customizing.md, "Your own layout".',
             "[Layout]", f"Name={name}", f"Comment=Based on {source.name}",
             "Waybar=waybar.jsonc", "Style=style.css"]
    for key, value in (("Menu", source.menu), ("MenuStyle", source.menu_style if source.menu else None),
                       ("Quick", source.quick), ("TitlebarLayout", source.titlebar_layout),
                       ("Wallpaper", source.wallpaper)):
        if value:
            lines.append(f"{key}={value}")
    if source.pinned and PINNED_MODULE in modules:
        lines.append("Pinned=" + ";".join(source.pinned))
    if source.desktops > 1 and DESKTOPS_MODULE in modules:
        lines.append(f"Desktops={source.desktops}")
    elif source.desktops > 1:
        lines += [f"# {source.name}'s {source.desktops} desktops need a switcher in your panel: add",
                  f'# "{DESKTOPS_MODULE}" to a bar\'s modules, then set Desktops={source.desktops}.']
    if source.dock:
        lines.append(f"# {source.name}'s dock is left out: your own layouts are waybar only.")
    return "\n".join(lines) + "\n"


def layout_folders(users=True):
    """{id: folder} of every layout folder, the first of each id, broken ones
    included (check reports them)."""
    found = {}
    for base in layout_dirs(users):
        try:
            names = sorted(os.listdir(base))
        except OSError:
            continue
        for name in names:
            if name not in found and LAYOUT_ID.match(name) and \
                    os.path.isfile(os.path.join(base, name, "layout.ini")):
                found[name] = os.path.join(base, name)
    return found


def is_user_layout(folder):
    return os.path.realpath(os.path.dirname(folder)) == os.path.realpath(user_layouts_dir())


def cmd_layout_new(opts):
    layout_id = opts.id
    if not LAYOUT_ID.match(layout_id):
        warn(f"'{layout_id}' can't be a layout id: use lowercase letters, digits, - and _")
        return 1
    folders = layout_folders()
    if layout_id in folders:
        warn(f"layout {layout_id} exists already in {folders[layout_id]}")
        return 1
    with contextlib.redirect_stderr(io.StringIO()):
        available = layouts(users=True)
        source_id = opts.from_layout or resolve_layout(layouts()).id
    if source_id not in available:
        warn(f"unknown layout '{source_id}'. Available: {', '.join(available) or 'none'}")
        return 1
    source = available[source_id]
    try:
        bars = load_bars(source)
        with open(source.waybar, encoding="utf-8") as f:
            waybar = f.read()
        with open(source.style, encoding="utf-8") as f:
            css = f.read()
    except (LayoutError, OSError, UnicodeDecodeError) as error:
        warn(f"can't copy layout {source_id}: {error}")
        return 1
    modules = {m for bar in bars for key in ("modules-left", "modules-center", "modules-right")
               for m in bar.get(key) or [] if isinstance(m, str)}
    files = {
        "layout.ini": starter_layout_ini(layout_id, opts.name or layout_id, source, modules),
        "waybar.jsonc": f"// {layout_id}: your own layout's panel, from {source.name} (man waybar). Its modules'\n"
                        "// settings are in the include; flickos-layout check --layout "
                        f"{layout_id} says what's wrong.\n"
                        + absolute_includes(waybar, os.path.dirname(source.waybar)),
        "style.css": f"/* {layout_id}: your own layout's panel CSS, from {source.name}. Use the\n"
                     " * style's named colors (@fg_color, @bg_color, ...) so styles change it too. */\n"
                     + absolute_urls(css, os.path.dirname(source.style)),
    }
    folder = os.path.join(user_layouts_dir(), layout_id)
    try:
        os.makedirs(folder)
        for file_name, text in files.items():
            write_atomic(os.path.join(folder, file_name), text)
    except OSError as error:
        warn(f"can't make {folder}: {error}")
        return 1
    if source.dock:
        warn(f"{source.name}'s dock is left out: your own layouts are waybar only")
    if source.desktops > 1 and DESKTOPS_MODULE not in modules:
        warn(f"{source.name}'s desktops are left out: add {DESKTOPS_MODULE} to a bar, then Desktops= "
             "(see the comment in layout.ini)")
    print(folder)
    return 0


# `tweaks new`'s examples: (what it does, selector, declarations). Each
# selector is at least as strong as every FlickOS layout's own rule for the
# same thing, so it wins (a test checks): window#waybar.top and .bottom are
# every bar (waybar's position classes), and a layout names its bar's class.
TWEAKS_EXAMPLES = (
    ("Text size in the bars", "window#waybar.top *,\nwindow#waybar.bottom *", ["font-size: 14px;"]),
    ("See-through bars: the style's panel color at 60%", "window#waybar.top,\nwindow#waybar.bottom",
     ["background: alpha(@wm_bg, 0.6);"]),
    ("Round corners on the bars", "window#waybar.top,\nwindow#waybar.bottom", ["border-radius: 8px;"]),
    ("More room around the clock", "window#waybar.top #clock,\nwindow#waybar.bottom #clock",
     ["padding: 0 12px;"]),
    ("Cupertino's dock: its corners and the room below it", "grid#dock",
     ["border-radius: 6px;", "margin-bottom: 12px;"]),
    ("Cupertino's dock: bigger icons", "button#taskbar_popup image", ["min-width: 48px;", "min-height: 48px;"]),
    ("Traditional's window list: text size", "window#sfwbar label", ["font-size: 14px;"]),
)
TWEAKS_HEADER = """/* Your tweaks of the panel's look (flickos-layout tweaks new).
 *
 * Read after everything else: the style's colors, the layout's CSS and
 * add-ons'. To use an example, delete the two lines around its rule that
 * hold only a comment mark. While flickos-layout watch runs, each save
 * shows at once.
 *
 * A rule wins over the layout's own only if its selector is as strong. The
 * examples are; for anything else, find the layout's rule (flickos-layout
 * explain panel lists the files) and use its selector.
 *
 * Colors: the style's names (@fg_color, @wm_bg, @selected_bg_color, ...)
 * follow Dark and Light; written-out ones don't. The dock reads this file
 * too, and a rule for the other program changes nothing there. A mistake
 * GTK can't read leaves the whole file out, since the panel would stop:
 * flickos-layout check names the line.
 */
"""


def tweaks_starter():
    parts = [TWEAKS_HEADER]
    for title, selector, declarations in TWEAKS_EXAMPLES:
        body = "".join(f"    {line}\n" for line in declarations)
        parts.append(f"\n/* {title} */\n/*\n{selector} {{\n{body}}}\n*/\n")
    return "".join(parts)


def cmd_tweaks_new(opts):
    path = os.path.join(tweaks_folder(), TWEAKS_STYLE)
    if os.path.exists(path) and not opts.force:
        warn(f"{path} exists already (--force replaces it)")
        return 1
    try:
        write_atomic(path, tweaks_starter())
    except OSError as error:
        warn(f"can't write {path}: {error}")
        return 1
    if plain_session():
        warn("the plain session leaves your tweaks out: they show after you log in normally")
    print(path)
    return 0


def css_problems(path):
    """A layout CSS file's missing @imports (errors) and written-out colors
    (warnings: they don't follow the style)."""
    problems = []
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError) as error:
        return [Problem(path, None, "error", f"can't read it: {error}")]
    folder = os.path.dirname(path)
    for number, line in enumerate(CSS_COMMENT.sub(lambda m: "\n" * m.group(0).count("\n"), text).splitlines(), 1):
        for match in CSS_IMPORT.finditer(line):
            target = absolute(match.group(2), folder)
            if not os.path.isfile(target):
                problems.append(Problem(path, number, "error", f"@import {match.group(2)}: no such file"))
        if "@import" in line:
            continue
        for match in CSS_DECLARATION_COLOR.finditer(line):
            problems.append(Problem(path, number, "warning", f"a color written out ({match.group(1)}) doesn't "
                                                             "change with the style: use a named one like "
                                                             "@fg_color (HIG VIS-2)"))
    return problems


def layout_problems(layout_id, folders=None):
    """`check --layout`: what is wrong with a layout, as Problems."""
    folders = layout_folders() if folders is None else folders
    folder = folders[layout_id]
    path = os.path.join(folder, "layout.ini")
    user = is_user_layout(folder)
    problems = []
    raw = configparser.ConfigParser(interpolation=None)
    with contextlib.suppress(configparser.Error, UnicodeDecodeError):
        raw.read(path, encoding="utf-8")
    if user and raw.has_section("Layout") and (raw["Layout"].get("Dock") or raw["Layout"].get("DockStyle")):
        problems.append(Problem(path, None, "error", "Dock= isn't read: your own layouts are waybar only"))
    err = io.StringIO()
    try:
        with contextlib.redirect_stderr(err):
            layout = load_layout(folder, user)
    except LayoutError as error:
        return problems + [Problem(path, None, "error", str(error).removeprefix(f"{path}: "))]
    for line in err.getvalue().splitlines():
        message = line.removeprefix("flickos-layout: ").removeprefix(f"{path}: ")
        if "waybar only" not in message:
            problems.append(Problem(path, None, "warning", message))
    try:
        bars = load_bars(layout)
    except LayoutError as error:
        return problems + [Problem(layout.waybar, None, "error", str(error).removeprefix(f"{layout.waybar}: "))]
    if os.path.isfile(layout.style):
        found = css_problems(layout.style)
        problems += found
        if user and not any(problem.level == "error" for problem in found):
            problems += css_parse_problems([layout.style], "the panel uses FlickOS's base.css in its place")
    else:
        problems.append(Problem(path, None, "error", f"Style={os.path.basename(layout.style)}: no such file"))
    where = {}          # module: [positions of the bars that have it]
    for bar in bars:
        defined = set(bar)
        for include in bar.get("include") or []:
            with contextlib.suppress(LayoutError):
                data = load_jsonc(include)
                if isinstance(data, dict):
                    defined |= set(data)
        position = bar.get("position", "top")
        for key in ("modules-left", "modules-center", "modules-right"):
            for module in bar.get(key) or []:
                if not isinstance(module, str):
                    continue
                where.setdefault(module, []).append((position, key))
                if module.startswith(ADDON_MODULE_PREFIX) and module not in defined:
                    problems.append(Problem(layout.waybar, None, "warning", f"{module} is in a bar but defined "
                                                                            "nowhere (in the bar or its include): "
                                                                            "waybar leaves it out"))
        for module, settings in bar.items():
            number = settings.get("signal") if isinstance(settings, dict) else None
            if module.startswith(ADDON_MODULE_PREFIX) and number in PANEL_SIGNALS and \
                    not (number == DESKTOPS_SIGNAL and module.startswith(DESK_MODULE + "#")):
                problems.append(Problem(layout.waybar, None, "warning",
                                        f"{module} uses signal {number}, which {PANEL_SIGNALS[number]} use: both "
                                        "refresh whenever either changes"))

    def lacks(message):
        problems.append(Problem(layout.waybar, None, "warning", message))
    launcher = where.get(LAUNCHER_MODULE)
    if not launcher and not dock_opens_apps(layout):
        lacks(f"no {LAUNCHER_MODULE}: there is no apps button, and the start menu and Super have no corner to "
              "open from")
    elif launcher and layout.menu and layout.menu != f"{launcher[0][0]}-left":
        lacks(f"Menu={layout.menu}, but the apps button is in the {launcher[0][0]} bar: the start menu opens away "
              f"from it (Menu={launcher[0][0]}-left)")
    if "tray" not in where:
        lacks("no tray: apps' status icons have nowhere to show")
    if RECORDING_MODULE not in where:
        lacks(f"no {RECORDING_MODULE}: a screen recording shows no time and no stop button (Super+Shift+R still "
              "stops it)")
    if SHOW_DESKTOP_MODULE not in where:
        lacks(f"no {SHOW_DESKTOP_MODULE}: no Show Desktop strip (Super+Shift+D still works)")
    if layout.quick:
        side = layout.quick.split("-")[0]
        if not all((side, "modules-right") in where.get(module, []) for module in QUICK_MODULES):
            lacks(f"Quick={layout.quick}, but no {side} bar has {' and '.join(QUICK_MODULES)} in modules-right: "
                  "Quick Settings has nothing to open from")
    if layout.desktops > 1 and DESKTOPS_MODULE not in where:
        lacks(f"Desktops={layout.desktops} without {DESKTOPS_MODULE} in a bar: nothing shows the desktops "
              f"(Super+1 to Super+{layout.desktops} still switch)")
    return problems


def dock_opens_apps(layout):
    """Does the layout's dock have an apps button (DOCK_LAUNCHER, Footprint's
    Show Apps)? Then the bar needs none."""
    return layout.dock is not None and DOCK_LAUNCHER_EXEC.search(text_of(layout.dock) or "") is not None


def user_layout_problems():
    folders = layout_folders()
    return [problem for layout_id, folder in folders.items() if is_user_layout(folder)
            for problem in layout_problems(layout_id, folders)]


def hidden_layouts():
    """[(id, the folder it hides)] of the user's layouts that hide another one (ADR-001)."""
    if plain_session():
        return []
    mine = {name for name, folder in layout_folders().items() if is_user_layout(folder)}
    others = layout_folders(users=False)
    return [(name, others[name]) for name in sorted(mine) if name in others]


def warn_style_fallbacks(style):
    """At login and on `set`: the style in use's themes that aren't installed."""
    for message in style_fallback_messages(style):
        warn(message)


