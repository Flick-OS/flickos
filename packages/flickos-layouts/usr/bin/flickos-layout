def state():
    """Every choice's items and the one in use, and doctor's warnings: what
    `list`, `current` and `doctor` print, in one run (flickos-control)."""
    installed_layouts, installed_styles = layouts(), styles()
    found = {}
    for kind, items, current in (
            ("layout", installed_layouts, resolve_layout(installed_layouts)),
            ("style", installed_styles, resolve_style(installed_styles)),
            ("clicks", CLICKS, resolve_clicks()),
            ("launcher", available_launchers(), resolve_launcher()),
            ("menu-style", MENU_STYLE_CHOICES, resolve_menu_style()),
            ("clock", CLOCKS, resolve_clock()),
            ("quick-settings", available_quick_settings(), resolve_quick_settings())):
        found[kind] = {"current": current.id,
                       "choices": [{"id": item.id, "name": item.name, "comment": item.comment,
                                    **({"folder": item.folder, "user": item.user, "parent": item.parent}
                                       if kind == "style" else {}),
                                    **({"folder": item.folder, "user": item.user} if kind == "layout" else {})}
                                   for item in items.values()]}
    # The defaults without the user's choice (Settings' Back to FlickOS's Look).
    found["layout"]["default"] = default_choice(installed_layouts, "Layout", DEFAULT_LAYOUT)
    found["style"]["default"] = default_choice(installed_styles, "Style", DEFAULT_STYLE)
    found["plain"] = plain_session()
    found["trying"] = found["style"]["current"] if tried_style_id() == found["style"]["current"] else None
    found["tweaks"] = tweaks_css() is not None
    found["warnings"] = doctor_warnings()
    return found


def default_choice(available, key, builtin):
    """The id in use when the user chose nothing: [Defaults] KEY=, else builtin."""
    for item_id in (system_default(key), builtin):
        if item_id in available:
            return item_id
    return next(iter(available), None)


def cmd_state(opts):
    print(json.dumps(state(), indent=1))
    return 0


def in_session():
    return bool(os.environ.get("WAYLAND_DISPLAY") and os.environ.get("LABWC_PID"))


def run_quiet(program):
    try:
        subprocess.run(program, check=False, timeout=10, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as error:
        warn(f"{' '.join(program)} failed: {error}")


def labwc_themes(available_styles):
    """The window and icon themes the styles give labwc (rcxml_changes)."""
    return frozenset(theme for style in available_styles.values() for theme in (style.labwc_theme, style.icon_theme))


def apply_choice(layout_id=None, style_id=None, clicks_id=None, launcher_id=None, menu_style_id=None,
                 clock_id=None, quick_id=None):
    """Save a layout, style, clicks, apps button, start menu style, clock
    and/or Quick Settings choice, regenerate the
    overlay and, inside the session, apply it: labwc, panel, notifications,
    the start menu's daemon, and the wallpaper for a new layout or style. GTK settings
    follow a new style even outside the session, and so do the window buttons
    of windows that draw their own title bar after a new layout."""
    if plain_session():
        warn("the plain session doesn't change your choices; log in normally to change them")
        return 1
    if style_id is not None and style_id != DEFAULT_CHOICE:
        errors = [problem for problem in style_problems(style_id) if problem.level == "error"]
        if errors:
            for problem in errors:
                warn(str(problem))
            warn(f"style {style_id} not applied: it has errors (flickos-layout check {style_id})")
            return 1
    available, available_styles, launchers = layouts(), styles(), available_launchers()
    for kind, item_id, items in (("layout", layout_id, available), ("style", style_id, available_styles),
                                 ("clicks", clicks_id, CLICKS), ("launcher", launcher_id, launchers),
                                 ("menu style", menu_style_id, MENU_STYLE_CHOICES), ("clock", clock_id, CLOCKS),
                                 ("Quick Settings choice", quick_id, available_quick_settings())):
        if item_id is not None and item_id != DEFAULT_CHOICE and item_id not in items:
            warn(f"unknown {kind} '{item_id}'. Available: {', '.join(items) or 'none'}, {DEFAULT_CHOICE}")
            return 1
    chosen = {kind: item_id for kind, item_id in (("layout", layout_id), ("style", style_id),
                                                  ("clicks", clicks_id), ("launcher", launcher_id),
                                                  ("menu-style", menu_style_id), ("clock", clock_id),
                                                  ("quick-settings", quick_id))
              if item_id is not None}
    resolvers = {"layout": lambda: resolve_layout(available), "style": lambda: resolve_style(available_styles),
                 "clicks": resolve_clicks, "launcher": resolve_launcher, "menu-style": resolve_menu_style,
                 "clock": resolve_clock, "quick-settings": resolve_quick_settings}
    if style_id is not None:
        forget_try()            # the choice is saved now: the try is over, its themes stay
    live = in_session()
    status = 0
    with locked():
        # For the history: the saved choice and the one in use before.
        before = {kind: (user_choice(kind), resolvers[kind]().id) for kind in chosen}
        for kind, item_id in chosen.items():
            if item_id == DEFAULT_CHOICE:
                remove(choice_path(kind))
            else:
                write_atomic(choice_path(kind), item_id + "\n")
        for kind, item_id in chosen.items():
            # Only a change that shows: saving the default as a choice isn't one.
            if resolvers[kind]().id != before[kind][1]:
                record(kind, before[kind][0], item_id)
        layout, style, clicks = resolve_layout(available), resolve_style(available_styles), resolve_clicks()
        if style_id is not None:
            warn_style_fallbacks(style)
        launcher, style_choice, quick = resolve_launcher(), resolve_menu_style(), resolve_quick_settings()
        command = dock = None
        # GTK settings first: the overlay's window icons follow gsettings icon-theme.
        if style_id is not None:
            style_gsettings(style, available_styles)
        if layout_id is not None:
            layout_gsettings(layout, available)
        if prepare(layout, style, labwc_themes(available_styles), clicks, launcher, style_choice, quick):
            try:
                command = waybar_command(layout, style)
            except LayoutError as error:
                warn(f"{error}; the panel is not changed")
                status = 1
            try:
                dock = dock_command(layout, style)
            except LayoutError as error:
                warn(f"{error}; no dock")
                status = 1
            try:
                mako_command(style)
            except LayoutError as error:
                warn(f"{error}; notifications are not changed")
                status = 1
        if live:
            run_quiet(["labwc", "--reconfigure"])
            if style_id is not None:
                run_quiet(["makoctl", "reload"])
            if command:
                restart_panel(layout, style, command, dock)
            sync_menu(menu_daemon_wanted(runtime_root()))
            if layout_id is not None or style_id is not None:
                restart_wallpaper(layout, style)
    names = []
    for item_id, kind, item in ((layout_id, "layout", layout), (style_id, "style", style),
                                (clicks_id, "desktop clicks", clicks), (launcher_id, "apps button", launcher),
                                (menu_style_id, "start menu style", style_choice),
                                (clock_id, "clock", resolve_clock()),
                                (quick_id, "Quick Settings", quick)):
        if item_id is not None:
            names.append(f"{kind} '{item.name}'")
    names[0] = names[0][0].upper() + names[0][1:]
    if live:
        print(f"{' and '.join(names)} applied.")
    else:
        print(f"{' and '.join(names)} saved. {'They apply' if len(names) > 1 else 'It applies'} at next login.")
    for message in doctor_warnings():
        warn(message)
    return status


def cmd_set(opts):
    if all(value is None for value in (opts.id, opts.style, opts.clicks, opts.launcher, opts.menu_style)):
        warn("set: give a layout, --style, --clicks, --launcher or --menu-style")
        return 2
    return apply_choice(layout_id=opts.id, style_id=opts.style, clicks_id=opts.clicks, launcher_id=opts.launcher,
                        menu_style_id=opts.menu_style)


def cmd_style_set(opts):
    return apply_choice(style_id=opts.id)


def cmd_clicks_set(opts):
    return apply_choice(clicks_id=opts.id)


def cmd_launcher_set(opts):
    return apply_choice(launcher_id=opts.id)


def cmd_menu_style_set(opts):
    return apply_choice(menu_style_id=opts.id)


def cmd_clock_set(opts):
    return apply_choice(clock_id=opts.id)


def cmd_quick_set(opts):
    return apply_choice(quick_id=opts.id)


def cmd_prepare(opts):
    if not in_session():
        end_try()               # every login ends a try (ADR-012)
    available_styles = styles()
    with locked():
        style = resolve_style(available_styles)
        warn_style_fallbacks(style)
        ok = prepare(resolve_layout(layouts()), style, labwc_themes(available_styles),
                     resolve_clicks(), resolve_launcher(), resolve_menu_style(), resolve_quick_settings())
    return 0 if ok else 1


def cmd_reload_panel(opts):
    """Generate the panel again and restart it (flickos-phone, when the phone
    connection is turned on or off: its button comes or goes, and the phone
    popup with it)."""
    with locked():
        layout, style = resolve_layout(layouts()), resolve_style(styles())
        root = runtime_root()
        if root is not None:
            os.makedirs(root, mode=0o700, exist_ok=True)
            update_phone(root, phone_corner(layout))
        command = waybar_command(layout, style)
        try:
            dock = dock_command(layout, style)
        except LayoutError as error:
            warn(f"{error}; no dock")
            dock = None
        if in_session():
            restart_panel(layout, style, command, dock)
            sync_menu(menu_daemon_wanted(runtime_root()))
    return 0


def cmd_reconfigure(opts):
    """prepare, then reload labwc (flick-tiler, after it changed its fragment)."""
    status = cmd_prepare(opts)
    if status == 0 and in_session():
        run_quiet(["labwc", "--reconfigure"])
    return status


def cmd_wallpaper(opts):
    """Replace this process with the wallpaper (autostart). Whatever goes wrong,
    a wallpaper must start: if waypaper can't restore the user's, the layout's
    or the style's."""
    layout = style = None
    try:
        layout, style = resolve_layout(layouts()), resolve_style(styles())
    except Exception as error:
        warn(f"{error}; using the default wallpaper")
    source, _image, command = wallpaper(layout, style)
    if source == "waypaper":
        try:
            done = subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, check=False,
                                  timeout=60)
            if done.returncode == 0:
                return 0
            warn(f"{' '.join(command)} failed; showing FlickOS's wallpaper")
        except (OSError, subprocess.TimeoutExpired) as error:
            warn(f"{' '.join(command)}: {error}; showing FlickOS's wallpaper")
        image = next((i for i in ((layout.wallpaper if layout else None), (style.wallpaper if style else None),
                                  DEFAULT_WALLPAPER)
                      if i and os.path.isfile(i)), None)
        command = swaybg_command(image)
    os.execvp(command[0], command)


def user_mako_config():
    if plain_session():
        return None
    path = os.path.join(config_home(), "mako", "config")
    return path if os.path.exists(path) else None


def cmd_panel(opts):
    """Start notifications and the layout's dock, then stay on as the panel's
    supervisor (`supervise`). Whatever goes wrong, notifications and panel must
    start: errors fall back to flickos-settings' files. A broken dock is left
    out. Everything they print goes to the panel log."""
    stream = open_log()
    log_line("starting the panel")
    env = dict(os.environ)
    style = None
    try:
        style = resolve_style(styles())
    except Exception as error:
        warn(f"{error}; using the default colors")

    if user_mako_config():
        mako = ["mako"]
    else:
        mako = ["mako", "-c", BASE_MAKO]
        try:
            if style is not None:
                with locked():
                    mako = mako_command(style)
        except Exception as error:
            warn(f"{error}; starting notifications with the default settings")
    start_supervised(mako, env)
    # The start menu, Quick Settings and the phone popup, while one is on
    # (prepare wrote its corner at login).
    if menu_daemon_wanted(runtime_root()):
        start_supervised(menu_command(), env)

    if user_waybar_config():
        return supervise(["waybar"], env, stream)
    try:
        if style is None:
            raise LayoutError("no style")
        layout = resolve_layout(layouts())
        with locked():
            command = waybar_command(layout, style)
            try:
                dock = dock_command(layout, style)
            except Exception as error:
                warn(f"{error}; starting without the dock")
                dock = None
        env = panel_environment(env, layout, style)
        if dock:
            start_supervised(dock, env)
    except Exception as error:
        warn(f"{error}; starting the default panel")
        command = ["waybar", "-c", FALLBACK_WAYBAR, "-s", FALLBACK_STYLE]
        env.pop("FLICKOS_LAYOUT", None)
        env.pop("FLICKOS_STYLE", None)
    return supervise(command, env, stream)


def cmd_pick(opts):
    available, available_styles = layouts(), styles()
    if not available:
        raise LayoutError(f"no layouts installed in {LAYOUTS_DIR}")
    if not available_styles:
        raise LayoutError(f"no styles installed in {STYLES_DIR}")
    with single_instance("pick.lock") as first:
        if not first:
            print("The layout chooser is already open.")
            return 0
        current, current_style = resolve_layout(available).id, resolve_style(available_styles).id
        current_clicks = resolve_clicks().id
        for chooser in (pick_gtk, pick_fuzzel):
            status = chooser(available, current, available_styles, current_style, current_clicks)
            if status is not None:
                return status
    warn("no chooser available (GTK 3 or fuzzel); use: flickos-layout list, flickos-layout set ID, "
         "flickos-layout style list, flickos-layout style set ID, flickos-layout clicks list, "
         "flickos-layout clicks set ID")
    return 1


def live_system():
    """True when booted from the live image (boot=live on the kernel command line)."""
    try:
        with open(os.path.join(PROC, "cmdline"), encoding="utf-8", errors="replace") as f:
            return "boot=live" in f.read().split()
    except OSError:
        return False


def cmd_supervise(opts):
    """Run a panel program under supervision (`panel` and `set` use this for
    notifications and the dock; not meant to be typed)."""
    command = list(opts.command)
    if command and command[0] == "--":
        command.pop(0)
    if not command:
        warn("supervise: give a command to run")
        return 2
    open_log()
    return supervise(command, dict(os.environ), LOG_STREAM)


def cmd_first_run(opts):
    """Open the chooser at the first login of a new account (autostart).

    Only while the marker exists, the user hasn't chosen a layout yet, and not
    in the live session. The marker is deleted first in every case, so the
    chooser never comes back, even if the session ends while it's open."""
    marker = choice_path(FIRST_RUN_MARKER)
    if not os.path.lexists(marker):
        return 0
    show = not os.path.exists(choice_path("layout")) and not live_system()
    remove(marker)
    return cmd_pick(opts) if show else 0


def cmd_addons(opts):
    """The add-ons found: name, folder and which of their files exist."""
    for name, folder in addons().items():
        files = [f for f in (ADDON_LABWC, ADDON_WAYBAR, ADDON_STYLE) if os.path.isfile(os.path.join(folder, f))]
        print(f"{name}\t{folder}\t{','.join(files) or '-'}")
    return 0


def cmd_doctor(opts):
    found = doctor_warnings()
    for message in found:
        print(message)
    if not found:
        print("No problems found.")
    return 1 if found else 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="flickos-layout",
                                     description="Choose the FlickOS desktop layout, style, desktop clicks and "
                                                 "apps button.")
    commands = parser.add_subparsers(dest="command", required=True, metavar="COMMAND")
    commands.add_parser("list", help="list layouts: id, name, description").set_defaults(func=cmd_list)
    commands.add_parser("current", help="print the layout in use").set_defaults(func=cmd_current)
    set_parser = commands.add_parser("set", help="choose a layout (style, desktop clicks) and apply it")
    set_parser.add_argument("id", nargs="?", help="layout, or default; leave out to keep the current one")
    set_parser.add_argument("--style", metavar="STYLE", help="also choose this style")
    set_parser.add_argument("--clicks", metavar="CLICKS", help="also choose what desktop clicks do")
    set_parser.add_argument("--launcher", metavar="LAUNCHER", help="also choose what the apps button opens")
    set_parser.add_argument("--menu-style", metavar="MENU_STYLE", help="also choose the start menu style")
    set_parser.set_defaults(func=cmd_set)
    style_parser = commands.add_parser("style", help="Dark/Light or your own style: list, current, set ID, "
                                                     "new ID")
    style_commands = style_parser.add_subparsers(dest="style_command", required=True, metavar="COMMAND")
    style_commands.add_parser("list", help="list styles: id, name, description").set_defaults(func=cmd_style_list)
    style_commands.add_parser("current", help="print the style in use").set_defaults(func=cmd_style_current)
    style_set = style_commands.add_parser("set", help="choose a style and apply it")
    style_set.add_argument("id")
    style_set.set_defaults(func=cmd_style_set)
    style_new = style_commands.add_parser("new", help="make your own style from one (prints its folder)")
    style_new.add_argument("id", help="the new style's id: lowercase letters, digits, - and _")
    style_new.add_argument("--from", dest="from_style", metavar="STYLE",
                           help="the style it inherits (default: the one in use)")
    style_new.add_argument("--name", help="the name shown in the chooser (default: the id)")
    style_new.set_defaults(func=cmd_style_new)
    layout_parser = commands.add_parser("layout", help="your own layout: new ID")
    layout_commands = layout_parser.add_subparsers(dest="layout_command", required=True, metavar="COMMAND")
    layout_new = layout_commands.add_parser("new", help="make your own layout from one (prints its folder)")
    layout_new.add_argument("id", help="the new layout's id: lowercase letters, digits, - and _")
    layout_new.add_argument("--from", dest="from_layout", metavar="LAYOUT",
                            help="the layout to copy (default: the one in use)")
    layout_new.add_argument("--name", help="the name shown in the chooser (default: the id)")
    layout_new.set_defaults(func=cmd_layout_new)
    tweaks_parser = commands.add_parser("tweaks", help="your own CSS for the panel's look: new")
    tweaks_commands = tweaks_parser.add_subparsers(dest="tweaks_command", required=True, metavar="COMMAND")
    tweaks_new = tweaks_commands.add_parser("new", help="write a starter with examples (prints its path)")
    tweaks_new.add_argument("--force", action="store_true", help="replace the file you have")
    tweaks_new.set_defaults(func=cmd_tweaks_new)
    check_parser = commands.add_parser("check", help="what is wrong with a style or layout, or with all your "
                                                     "styles, layouts, labwc files, add-ons, panel tweaks and "
                                                     "includes")
    check_parser.add_argument("id", nargs="?", help="a style; leave out to check everything of yours")
    check_parser.add_argument("--layout", metavar="LAYOUT", help="check this layout instead")
    check_parser.set_defaults(func=cmd_check)
    explain_parser = commands.add_parser("explain", help="for each program, the files it reads and which one wins")
    explain_parser.add_argument("program", nargs="?", choices=EXPLAIN_PROGRAMS, help="only this one")
    explain_parser.set_defaults(func=cmd_explain)
    try_parser = commands.add_parser("try", help="use a style until you log out (--end: back to yours now)")
    try_parser.add_argument("id", nargs="?", help="the style to try")
    try_parser.add_argument("--end", action="store_true", help="stop trying: your own style again")
    try_parser.set_defaults(func=cmd_try)
    export_parser = commands.add_parser("export", help="write your own style into one file to share")
    export_parser.add_argument("id", help="one of your own styles")
    export_parser.add_argument("file", nargs="?", help="the file to write (default: ID.tar.gz here)")
    export_parser.set_defaults(func=cmd_export)
    import_parser = commands.add_parser("import", help="add a style someone shared (a file from export)")
    import_parser.add_argument("file")
    import_parser.add_argument("--replace", action="store_true", help="replace your own style of the same id")
    import_parser.add_argument("--yes", action="store_true", help="keep it even with warnings (contrast, themes)")
    import_parser.set_defaults(func=cmd_import)
    commands.add_parser("watch", help="apply each save to your styles, add-ons and labwc files at once "
                                      "(Ctrl+C to stop)").set_defaults(func=cmd_watch)
    clicks_parser = commands.add_parser("clicks", help="what a click on the desktop does: list, current, set ID")
    clicks_commands = clicks_parser.add_subparsers(dest="clicks_command", required=True, metavar="COMMAND")
    clicks_commands.add_parser("list", help="list choices: id, name, description").set_defaults(func=cmd_clicks_list)
    clicks_commands.add_parser("current", help="print the choice in use").set_defaults(func=cmd_clicks_current)
    clicks_set = clicks_commands.add_parser("set", help="choose and apply")
    clicks_set.add_argument("id")
    clicks_set.set_defaults(func=cmd_clicks_set)
    launcher_parser = commands.add_parser("launcher", help="what the apps button opens (app launcher or start "
                                                           "menu): list, current, set ID")
    launcher_commands = launcher_parser.add_subparsers(dest="launcher_command", required=True, metavar="COMMAND")
    launcher_commands.add_parser("list", help="list choices: id, name, description"
                                 ).set_defaults(func=cmd_launcher_list)
    launcher_commands.add_parser("current", help="print the choice in use").set_defaults(func=cmd_launcher_current)
    launcher_set = launcher_commands.add_parser("set", help="choose and apply")
    launcher_set.add_argument("id")
    launcher_set.set_defaults(func=cmd_launcher_set)
    menu_style_parser = commands.add_parser("menu-style", help="the start menu's style (follow the layout, or one "
                                                               "for all layouts): list, current, set ID")
    menu_style_commands = menu_style_parser.add_subparsers(dest="menu_style_command", required=True,
                                                           metavar="COMMAND")
    menu_style_commands.add_parser("list", help="list choices: id, name, description"
                                   ).set_defaults(func=cmd_menu_style_list)
    menu_style_commands.add_parser("current", help="print the choice in use").set_defaults(func=cmd_menu_style_current)
    menu_style_set = menu_style_commands.add_parser("set", help="choose and apply")
    menu_style_set.add_argument("id")
    menu_style_set.set_defaults(func=cmd_menu_style_set)
    clock_parser = commands.add_parser("clock", help="the panel clock's hours (24h, 12h): list, current, set ID")
    clock_commands = clock_parser.add_subparsers(dest="clock_command", required=True, metavar="COMMAND")
    clock_commands.add_parser("list", help="list choices: id, name, example").set_defaults(func=cmd_clock_list)
    clock_commands.add_parser("current", help="print the choice in use").set_defaults(func=cmd_clock_current)
    clock_set = clock_commands.add_parser("set", help="choose and apply")
    clock_set.add_argument("id")
    clock_set.set_defaults(func=cmd_clock_set)
    quick_parser = commands.add_parser("quick-settings", help="Quick Settings behind the volume and battery icons "
                                                              "and Super+A (off, on): list, current, set ID")
    quick_commands = quick_parser.add_subparsers(dest="quick_command", required=True, metavar="COMMAND")
    quick_commands.add_parser("list", help="list choices: id, name, description").set_defaults(func=cmd_quick_list)
    quick_commands.add_parser("current", help="print the choice in use").set_defaults(func=cmd_quick_current)
    quick_set = quick_commands.add_parser("set", help="choose and apply")
    quick_set.add_argument("id")
    quick_set.set_defaults(func=cmd_quick_set)
    commands.add_parser("prepare", help="regenerate the runtime overlay (session start)").set_defaults(func=cmd_prepare)
    commands.add_parser("reload-panel", help="generate the panel again and restart it (flickos-phone)"
                        ).set_defaults(func=cmd_reload_panel)
    commands.add_parser("reconfigure", help="regenerate the runtime overlay and reload labwc (flick-tiler)"
                        ).set_defaults(func=cmd_reconfigure)
    commands.add_parser("panel", help="run mako, waybar, the dock and the start menu for the current layout and "
                                      "style (autostart)"
                        ).set_defaults(func=cmd_panel)
    commands.add_parser("wallpaper", help="show the user's or the current style's wallpaper (autostart)"
                        ).set_defaults(func=cmd_wallpaper)
    supervise_parser = commands.add_parser("supervise", help="run -- COMMAND ..., restarting it when it fails"
                                                            " (panel and dock; used by FlickOS itself)")
    supervise_parser.add_argument("command", nargs=argparse.REMAINDER, metavar="-- COMMAND ...")
    supervise_parser.set_defaults(func=cmd_supervise)
    commands.add_parser("addons", help="list the add-ons: name, folder, files (apply changes with reconfigure "
                        "and reload-panel)").set_defaults(func=cmd_addons)
    commands.add_parser("doctor", help="list your config that stops layouts and styles from applying"
                        ).set_defaults(func=cmd_doctor)
    commands.add_parser("state", help="print every choice, the ones in use and doctor's warnings as JSON"
                        ).set_defaults(func=cmd_state)
    commands.add_parser("pick", help="choose a layout and style in a window").set_defaults(func=cmd_pick)
    commands.add_parser("first-run", help="open the chooser if this is a new account's first login (autostart)"
                        ).set_defaults(func=cmd_first_run)
    opts = parser.parse_args(argv)
    try:
        return opts.func(opts)
    except (LayoutError, OSError) as error:
        warn(str(error))
        return 1


if __name__ == "__main__":
    sys.exit(main())
