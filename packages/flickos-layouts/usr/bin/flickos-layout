# This program, to run a panel program under a supervisor of its own.
SELF = PREFIX + "/usr/bin/flickos-layout"
# Supervision (`supervise`): panel, dock and notifications are restarted when
# they fail. Their output goes to PANEL_LOG in the runtime root, truncated
# above PANEL_LOG_BYTES because it stays there (in RAM) for the whole session.
PANEL_LOG = "panel.log"
