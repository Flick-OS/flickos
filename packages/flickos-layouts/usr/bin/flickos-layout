RESTART_LIMIT = 5                 # failures in a row before giving up
# waybar 0.12 can keep a second bar on a screen turned on while it runs (a
# laptop's own screen turned on next to an external one, 2026-10-13); a
# reload draws one bar per screen. So `supervise` watches the compositor's
# screens (wl_output) and reloads its waybar once they have been still for
# SCREENS_SETTLE_SECONDS: an arrangement tool may move the new screen just
# after turning it on.
SCREENS_SETTLE_SECONDS = 1.5
RELOAD_ON_SCREENS = {"waybar": signal.SIGUSR2}
# Set by open_log(): warnings then go to the panel log as well.
