    need_environments()
    start_database(opts.name)
    return 0


def cmd_doctor(_opts, which=shutil.which):
    state = snapshot()
    for name, _category, _title, _summary, installed in state["kits"]:
        print("\t".join((f"kit {name}", "ok" if installed else "not installed", "")))
    for step_id, value in state["steps"].items():
        if step_id == "git":
            name, email = value
            print("\t".join(("git", "ok" if name and email else "missing", f"{name} <{email}>" if name else "")))
        elif step_id == "ssh":
            print("\t".join(("ssh", "ok" if value else "missing", value or "")))
        elif step_id == "ports":
            print("\t".join(("ports", "ok" if value != "off" else "none", "" if value == "off" else value)))
        elif step_id == "dhcp":
            print("\t".join(("dhcp", "ok" if value == "on" else "off", "")))
        elif step_id == "capture":
            setting, active = value
            if setting == "on" and not active:
                print("\t".join(("capture", "next login", f"until then: sg {WIRESHARK_GROUP} -c wireshark")))
            else:
                print("\t".join(("capture", "ok" if setting == "on" else "off", "")))
        elif step_id == "test-adapter":
            print(test_adapter_line(value["set"], value["adapters"], True))
        else:
            print("\t".join((step_id, "ok" if value else "missing", value)))
    if "test-adapter" not in state["steps"]:
        # A system setting stays when its kit goes (ADR-S08): say so.
        value = control_value("wireless.test-adapter")
        if value not in (None, "off"):
            print(test_adapter_line(value, wifi_adapters(), False))
    vers = state.get("versions") or {}
    for entry_id, value in vers.get("upstreams", {}).items():
        print("\t".join((f"maker {entry_id}", value or "unknown", vers["packages"].get(UPSTREAMS[entry_id][0], ""))))
    mine = vers.get("mine") or {}
    for tool in vers.get("tools", ()):
        if tool[0] in mine:
            print("\t".join((f"version {tool[1]}", *tool_line(tool, mine, vers["packages"]))))
            other = comes_first(tool, which) if vers["on_path"] else None
            if other:       # doctor runs in the terminal, with its shell's PATH
                print("\t".join((f"version {tool[1]}", "not first",
                                  f"{other} comes before yours on this PATH (a shell startup file?)")))
    if mine and not vers["on_path"]:
        print("\t".join(("version path", "next login", f"{shims_folder()} is on PATH from your next login")))
    if vers.get("error"):
        print("\t".join(("version mise", "error", vers["error"])))
    return 0


def test_adapter_line(address, adapters, kit):
    """doctor's line for the test adapter: none, ok, absent, or without the wireless kit."""
    if address == "off":
        return "\t".join(("test-adapter", "none", ""))
    if not kit:
        return "\t".join(("test-adapter", "set without the wireless kit", address))
    device = next((a["device"] for a in adapters if a["address"] == address), None)
    if device is None:
        return "\t".join(("test-adapter", "absent", address))
    return "\t".join(("test-adapter", "ok", f"{address} {device}"))


# --- The window ------------------------------------------------------------------------

def window(select=None):
    """Build and show the window. Returns 0 when it is closed. Anything that
    runs a program does it in a thread, and the result comes back on the main
    loop (PERF-2)."""
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        from gi.repository import GLib
        GLib.set_prgname(APP_ID)
        from gi.repository import Gdk, Gtk, Pango
    except (ImportError, ValueError) as error:
        warn(f"can't open the window ({error}); python3-gi and gir1.2-gtk-3.0 are needed")
        return 1
    if not Gtk.init_check(sys.argv[:1])[0]:
        warn("cannot open a window (no display)")
        return 1

    win = Gtk.Window(title=_(TITLE), icon_name=ICON)
    win.set_default_size(760, 680)
    win.connect("destroy", Gtk.main_quit)
    busy = {"kit": None}            # the kit being changed, or None

    def key_pressed(_window, event):
        """Escape closes the window (A11Y-2) unless a change is running."""
        if event.keyval == Gdk.KEY_Escape and busy["kit"] is None:
            win.destroy()
            return True
        return False

    win.connect("key-press-event", key_pressed)

    def background(work, done):
        """Runs work() in a thread; done(result, error) on the main loop. An
        unexpected exception prints its traceback and reaches done too (CODE-6)."""
        def target():
            try:
                result, error = work(), None
            except KitsError as failure:
                result, error = None, str(failure)
            except Exception as failure:     # a bug: loud, and the window says so
                traceback.print_exc()
                result, error = None, f"{type(failure).__name__}: {failure}"
            GLib.idle_add(lambda: done(result, error) and False)
        threading.Thread(target=target, daemon=True).start()

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    outer.set_border_width(24)
    win.add(outer)

    # A warning bar for errors (WIN-10), with selectable text.
    notice = Gtk.InfoBar(message_type=Gtk.MessageType.WARNING, show_close_button=True, revealed=False)
    notice_label = Gtk.Label(selectable=True, wrap=True, xalign=0)
    notice.get_content_area().add(notice_label)
    notice.connect("response", lambda bar, _r: bar.set_revealed(False))
    notice.set_no_show_all(True)        # an empty bar draws a line: show it only with a message

    def show_notice(text, kind=Gtk.MessageType.WARNING):
        notice.set_message_type(kind)
        notice_label.set_text(text)
        notice.show_all()
        notice.set_revealed(True)

    outer.pack_start(notice, False, False, 0)
    if live_system():
        show_notice(_("This is the live session: what you install here is gone when you restart."),
                    Gtk.MessageType.INFO)

    scroller = Gtk.ScrolledWindow()
    scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    outer.pack_start(scroller, True, True, 0)
    content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
    scroller.add(content)

    status = Gtk.Label(xalign=0, wrap=True, selectable=True)
    status.get_style_context().add_class("dim-label")
    progress = Gtk.ProgressBar(show_text=False)

    def heading(text):
        label = Gtk.Label(xalign=0)
        label.set_markup("<b>{}</b>".format(GLib.markup_escape_text(text)))
        return label

    def framed(rows):
        frame = Gtk.Frame()
        listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        for row in rows:
            listbox.add(row)
        frame.add(listbox)
        return frame

    def row_of(title, subtitle, control):
        """A row (WIN-6): title and dimmed subtitle on the left, the control on the right."""
        row = Gtk.ListBoxRow(activatable=False)
        box = Gtk.Box(spacing=12)
        box.set_border_width(10)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        name = Gtk.Label(xalign=0)
        name.set_markup("<b>{}</b>".format(GLib.markup_escape_text(title)))
        text.pack_start(name, False, False, 0)
        sub = Gtk.Label(label=subtitle, xalign=0, wrap=True, max_width_chars=60)
        sub.get_style_context().add_class("dim-label")
        text.pack_start(sub, False, False, 0)
        box.pack_start(text, True, True, 0)
        control.set_valign(Gtk.Align.CENTER)
        box.pack_end(control, False, False, 0)
        row.add(box)
        row.sub = sub
        return row

    switches = {}

    # --- Installing and removing --------------------------------------------------------

    def set_switch(name, state):
        switch = switches[name]
        switch.handler_block_by_func(toggled)
        switch.set_active(state)
        switch.set_state(state)
        switch.handler_unblock_by_func(toggled)

    def set_sensitive_all(sensitive):
        for switch in switches.values():
            switch.set_sensitive(sensitive)

    def finish(name, message=None):
        busy["kit"] = None
        progress.hide()
        status.set_text("")
        set_sensitive_all(True)
        if message:
            show_notice(message)
        shown["state"] = None       # whatever happened, build the page from what is installed now
        refresh()

    def ask(title_text, question, body, names, verb, destructive):
        """The plan's dialog (WIN-13, WIN-14): Cancel and a verb. True to go on."""
        status.set_text("")
        dialog = Gtk.Dialog(title=title_text, transient_for=win, modal=True)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        go = dialog.add_button(verb, Gtk.ResponseType.ACCEPT)
        go.get_style_context().add_class("destructive-action" if destructive else "suggested-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL if destructive else Gtk.ResponseType.ACCEPT)
        box = dialog.get_content_area()
        box.set_spacing(12)
        box.set_border_width(18)
        asking = Gtk.Label(xalign=0, wrap=True, max_width_chars=56)
        asking.set_markup("<b>{}</b>".format(GLib.markup_escape_text(question)))
        box.pack_start(asking, False, False, 0)
        words = Gtk.Label(label=body, xalign=0, wrap=True, max_width_chars=56, selectable=True)
        box.pack_start(words, False, False, 0)
        if names:
            shown = names[:PLAN_LIST]
            more = len(names) - len(shown)
            text = ", ".join(shown) + (_(" and {count} more").format(count=more) if more else "")
            listing = Gtk.Label(label=text, xalign=0, wrap=True, max_width_chars=56, selectable=True)
            listing.get_style_context().add_class("dim-label")
            box.pack_start(listing, False, False, 0)
        dialog.show_all()
        answer = dialog.run()
        dialog.destroy()
        return answer == Gtk.ResponseType.ACCEPT

    def toggled(switch, _param):
        name = switch.kit
        want = switch.get_active()
        if busy["kit"] is not None:
            return
        busy["kit"] = name
        set_sensitive_all(False)
        title = next(_(k[2]) for k in KITS if k[0] == name)
        status.set_text(_("Loading…"))
        progress.hide()

        def planned(plan, error):
            if error:
                set_switch(name, not want)
                return finish(name, _("{kit} can't be changed: {error}").format(kit=title, error=error))
            summary, names = plan_words(plan, not want)
            if plan.get("protected"):
                set_switch(name, not want)
                return finish(name, _("{kit} can't be removed: {names} are part of the FlickOS desktop.").format(
                    kit=title, names=", ".join(plan["protected"])))
            if want:
                go = ask(_("Install Tool Kit"), _("Install {kit}?").format(kit=title), summary,
                         names, _("_Install"), False)
            else:
                go = ask(_("Remove Tool Kit"), _("Remove {kit}?").format(kit=title),
                         summary + " " + _("Your own files and projects are not touched."), names,
                         _("_Remove"), True)
            if not go:
                set_switch(name, not want)
                return finish(name)
            apply(name, want, title)

        background(lambda: get_plan(name, not want), planned)

    def apply(name, want, title):
        status.set_text(_("Installing {kit}…").format(kit=title) if want else _("Removing {kit}…").format(kit=title))
        progress.set_fraction(0)
        progress.show()
        problem = []

        def on_event(event):
            if event.get("event") == "progress" and event.get("percent") is not None:
                GLib.idle_add(lambda p=event["percent"]: progress.set_fraction(max(0, min(100, p)) / 100) and False)
            elif event.get("event") == "error":
                problem.append(event.get("message", ""))
            elif event.get("event") == "failed" and event.get("message"):
                problem.append(event["message"])

        def applied(code, error):
            if error or code:
                set_switch(name, not want)
                what = _("{kit} couldn't be installed.") if want else _("{kit} couldn't be removed.")
                text = what.format(kit=title)
                detail = error or (problem[-1] if problem else "")
                return finish(name, f"{text}\n{detail}" if detail else text)
            finish(name)

        background(lambda: change(name, not want, on_event), applied)

    # --- The page -------------------------------------------------------------------------

    shown = {"state": None}         # what the page was built from
    # A folded list's state once the user opened or closed it, kept across rebuilds.
    unfolded = {}

    def refresh():
        """Reads what is installed and set up, and builds the page again when it changed."""
        def read(state, error):
            if error:
                return show_notice(_("Couldn't read which kits are installed: {error}").format(error=error))
            if state != shown["state"]:
                shown["state"] = state
                build(state)
        background(snapshot, read)

    def build(state):
        rows = state["kits"]
        for child in content.get_children():
            content.remove(child)
        switches.clear()
        for category, title in CATEGORIES:
            in_category = [r for r in rows if r[1] == category]
            rows_here = []
            for name, kit_category, kit_title, summary, installed in rows:
                if kit_category != category:
                    continue
                switch = Gtk.Switch()
                switch.kit = name
                switch.set_active(installed)
                switch.get_accessible().set_name(kit_title)
                switch.connect("notify::active", toggled)
                switches[name] = switch
                rows_here.append(row_of(kit_title, summary, switch))
            if category not in FOLDED:
                content.pack_start(heading(_(title)), False, False, 0)
                content.pack_start(framed(rows_here), False, False, 0)
                continue
            # Folded until one of its kits is installed or the window opens on one;
            # then as the user leaves it.
            opened = unfolded.get(category, any(r[4] or r[0] == select for r in in_category))
            expander = Gtk.Expander(expanded=opened)
            expander.set_label_widget(heading(_(title)))
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            inner.set_margin_top(12)
            note = Gtk.Label(label=_(PERMISSION), xalign=0, wrap=True, max_width_chars=70, selectable=True)
            inner.pack_start(note, False, False, 0)
            inner.pack_start(framed(rows_here), False, False, 0)
            expander.add(inner)
            expander.connect("notify::expanded", lambda e, _p, c=category: unfolded.__setitem__(c, e.get_expanded()))
            content.pack_start(expander, False, False, 0)
        steps = [s for s in STEPS if s[0] in state["steps"]]
        if steps:
            content.pack_start(heading(_("Set up")), False, False, 0)
            content.pack_start(framed([step_row(s, state["steps"][s[0]]) for s in steps]), False, False, 0)
        if state.get("versions") and state["versions"]["upstreams"]:
            versions_section(state["versions"])
        if any(r[4] for r in rows):
            env_section(state["envs"])
        content.show_all()
        if select in switches:
            switches[select].grab_focus()

    def step_row(step, value):
        step_id, title, idle, _program = step
        button = Gtk.Button()
        if step_id == "git":
            name, email = value
            if name and email:
                subtitle = f"{name} <{email}>"
            elif name or email:
                subtitle = _("Git needs both a name and an email.")
            else:
                subtitle = _(idle)
            button.set_label(_("Change…"))
            button.connect("clicked", lambda _b: git_dialog())
        elif step_id == "ssh":
            path = value
            subtitle = path or _(idle)
            if path:
                button.set_label(_("Copy Public Key"))
                button.connect("clicked", lambda _b: copy_key(button))
            else:
                button.set_label(_("Make a Key…"))
                button.connect("clicked", lambda _b: make_key())
        elif step_id == "ports":
            if value == "off":
                subtitle = _(idle)
            else:
                subtitle = _("Open to devices on this network: {ports}").format(ports=value.replace(",", ", "))
            button.set_label(_("Change…"))
            button.connect("clicked", lambda _b: ports_dialog(value))
        elif step_id == "dhcp":
            subtitle = _(idle)
            switch = Gtk.Switch()
            switch.set_active(value == "on")
            switch.get_accessible().set_name(_(title))
            switch.connect("notify::active", lambda s, _p: system_step("containers.dhcp",
                                                                       "on" if s.get_active() else "off"))
            return row_of(_(title), subtitle, switch)
        elif step_id == "capture":
            setting, active = value
            # A group is read at login: until then the change waits (ADR-S02).
            subtitle = _("Applies when you log in again.") if (setting == "on") != active else _(idle)
            switch = Gtk.Switch()
            switch.set_active(setting == "on")
            switch.get_accessible().set_name(_(title))
            switch.connect("notify::active", lambda s, _p: system_step("packet-capture",
                                                                       "on" if s.get_active() else "off"))
            return row_of(_(title), subtitle, switch)
        elif step_id == "test-adapter":
            return adapter_row(title, idle, value)
        else:                       # rust
            toolchain = value
            subtitle = toolchain or _(idle)
            button.set_label(_("Install Rust…") if not toolchain else _("Update Rust…"))
            button.connect("clicked", lambda _b: rust_step(bool(toolchain)))
        button.get_accessible().set_name(_(title))
        return row_of(_(title), subtitle, button)

    def adapter_row(title, idle, value):
        """The Wi-Fi adapters other than the one online, and None (ADR-S08)."""
        chosen, adapters = value["set"], value["adapters"]
        combo = Gtk.ComboBoxText()
        combo.append("off", _("None"))
        present = None
        for adapter in adapters:
            if adapter["address"] == chosen:
                present = adapter
            elif adapter["active"]:
                continue
            combo.append(adapter["address"], adapter["label"])
        if chosen != "off" and present is None:
            combo.append(chosen, _("{address} (not plugged in)").format(address=chosen))
        combo.set_active_id(chosen)
        combo.set_sensitive(len(combo.get_model()) > 1)
        for cell in combo.get_cells():      # a long model name mustn't squeeze the row's sentence
            cell.set_property("ellipsize", Pango.EllipsizeMode.END)
            cell.set_property("max-width-chars", 30)
        if present is not None:
            # Two lines: beside the drop-down a one-line sentence wraps in the middle of the command.
            subtitle = (_("FlickOS won't connect to networks with it.") + "\n"
                        + _("Monitor mode: sudo airmon-ng start {device} (never with check kill)").format(
                            device=present["device"]))
        elif chosen != "off":
            subtitle = _("It isn't plugged in. FlickOS leaves it alone when it is.")
        elif len(combo.get_model()) > 1:
            subtitle = _(idle)
        else:
            subtitle = _("Plug in a second Wi-Fi adapter that can do monitor mode.")
        combo.get_accessible().set_name(_(title))
        combo.connect("changed", lambda c: c.get_active_id() not in (None, chosen)
                      and system_step("wireless.test-adapter", c.get_active_id()))
        return row_of(_(title), subtitle, combo)

    # --- Newer versions (flickos-dev.md ADR-007 to ADR-009) -------------------------------

    def versions_section(vers):
        content.pack_start(heading(_("Newer versions")), False, False, 0)
        rows = [upstream_row(entry_id, value, vers) for entry_id, value in vers["upstreams"].items()
                if not (entry_id == "mise" and value == "on")]
        if vers["upstreams"].get("mise") == "on":
            rows += [tool_row(tool, vers) for tool in vers["tools"]]
            rows.append(mise_row(vers))
        if vers["error"]:
            show_notice(_("mise can't say which versions are yours: {error}").format(error=vers["error"]))
        content.pack_start(framed(rows), False, False, 0)

    def upstream_name(entry_id):
        return "mise" if entry_id == "mise" else _(UPSTREAMS[entry_id][1])

    def upstream_row(entry_id, value, vers):
        package, title, about, _category, _download, _size = UPSTREAMS[entry_id]
        button = Gtk.Button(label=_("Install…"))
        if value == "on":
            subtitle = _("Version {version}, from Rapid7. Automatic updates keep it current. "
                         "Set up its database with msfdb init.").format(
                version=vers["packages"].get(package, "?"))
            button.set_label(_("Remove…"))
            button.connect("clicked", lambda _b: upstream_change(entry_id, False))
        else:
            subtitle = _(about)
            if value is None:
                subtitle = _("Settings (flickos-control) can't say whether it is installed.")
                button.set_sensitive(False)
            button.connect("clicked", lambda _b: upstream_change(entry_id, True))
        button.get_accessible().set_name(_(title))
        return row_of(_(title), subtitle, button)

    def tool_row(tool, vers):
        name, title, _kit, check, spec, debian = tool
        mine = (vers["mine"] or {}).get(name)
        computer = vers["packages"].get(debian) if debian else None
        has = _("The computer has {version} from Debian.").format(version=computer) if computer else ""
        if mine:
            version, asked = mine
            follows = {"latest": _("It follows the newest release."),
                       "lts": _("It follows the newest long-term release.")}.get(asked, _("It stays at this version."))
            words = [_("Yours: {version}, from mise.").format(version=version), follows, has]
        else:
            words = [has or _("Not on this computer.")]
        subtitle = " ".join(w for w in words if w) + "\n" + _(CHECKS[check])
        box = Gtk.Box(spacing=6)
        if not mine:
            button = Gtk.Button(label=_("Use the Latest"))
            button.connect("clicked", lambda _b: mise_work(lambda: use_tool(tool),
                                                           _("Installing {tool} for you…").format(tool=title),
                                                           _("{tool} is yours now.").format(tool=title)))
            button.get_accessible().set_name(_("Use the latest {tool}").format(tool=title))
            box.pack_start(button, False, False, 0)
            return row_of(title, subtitle, box)
        version, asked = mine
        if asked in ("latest", "lts"):
            button = Gtk.Button(label=_("Keep This Version"))
            button.connect("clicked", lambda _b: mise_work(lambda: use_tool(tool, version), "",
                                                           _("{tool} stays at {version}.").format(tool=title,
                                                                                                 version=version)))
        else:
            button = Gtk.Button(label=_("Follow the Latest"))
            button.connect("clicked", lambda _b: mise_work(lambda: use_tool(tool),
                                                           _("Installing {tool} for you…").format(tool=title),
                                                           _("{tool} follows the newest release.").format(
                                                               tool=title)))
        box.pack_start(button, False, False, 0)
        menu = Gtk.Menu()
        back = Gtk.MenuItem(label=_("Back to the Computer's Version") if computer else _("Remove Your Version"))
        back.connect("activate", lambda _i: mise_work(lambda: use_tool(tool, "system"), "",
                                                      _("{tool}: the computer's version again.").format(tool=title)
                                                      if computer else _("{tool} was removed.").format(tool=title)))
        menu.append(back)
        menu.show_all()
        more = Gtk.MenuButton(popup=menu)
        more.add(Gtk.Image.new_from_icon_name("view-more-symbolic", Gtk.IconSize.BUTTON))
        more.set_tooltip_text(_("More"))
        more.get_accessible().set_name(_("More for {tool}").format(tool=title))
        box.pack_start(more, False, False, 0)
        return row_of(title, subtitle, box)

    def mise_row(vers):
        words = []
        if vers["packages"].get("mise"):
            words.append(_("mise {version}.").format(version=vers["packages"]["mise"]))
        if vers["updated"]:
            words.append(_("Your versions were last updated {date}.").format(
                date=GLib.DateTime.new_from_unix_local(int(vers["updated"])).format("%x")))
        words.append(_("They get no restore points, History or automatic updates: update them here."))
        if vers["mine"] and not vers["on_path"]:
            words.append(_("Programs use them from your next login."))
        box = Gtk.Box(spacing=6)
        update = Gtk.Button(label=_("Update All"))
        update.set_sensitive(bool(vers["mine"]))
        update.connect("clicked", lambda _b: mise_work(update_tools, _("Updating your versions…"),
                                                       _("Your versions are up to date.")))
        box.pack_start(update, False, False, 0)
        menu = Gtk.Menu()
        remove = Gtk.MenuItem(label=_("Remove mise…"))
        remove.connect("activate", lambda _i: upstream_change("mise", False))
        menu.append(remove)
        menu.show_all()
        more = Gtk.MenuButton(popup=menu)
        more.add(Gtk.Image.new_from_icon_name("view-more-symbolic", Gtk.IconSize.BUTTON))
        more.set_tooltip_text(_("More"))
        more.get_accessible().set_name(_("More for mise"))
        box.pack_start(more, False, False, 0)
        return row_of(_("Your versions (mise)"), " ".join(words), box)

    def mise_work(work, busy_words, done_words):
        """mise as the user, in a thread: no password, a download."""
        status.set_text(busy_words)
        env_background(work, done_words)

    def upstream_change(entry_id, want):
        """A maker's repository: its sizes and what it may do first (ADR-008), then
        flickos-control asks for the password and installs or removes it."""
        _package, _title, about, _category, download, size = UPSTREAMS[entry_id]
        name = upstream_name(entry_id)
        mine = [t for t in USER_TOOLS if t[0] in (shown["state"]["versions"]["mine"] or {})] \
            if entry_id == "mise" else []
        if want:
            body = " ".join((_(about), _("About {download} is downloaded, and it takes {size}.").format(
                download=human_size(download), size=human_size(size)), _(UPSTREAM_TRUST)))
            if not ask(_("Add a Maker's Repository"), _("Install {name}?").format(name=name), body, [],
                       _("_Install"), False):
                return
            status.set_text(_("Installing {name}. The password comes first, then the download, which takes a "
                              "while.").format(name=name))
        else:
            body = _("It goes with its repository. Your own files are not touched.")
            if mine:
                body += " " + _("The tools you installed with it go back to the computer's versions first.")
            if not ask(_("Remove"), _("Remove {name}?").format(name=name), body, [t[1] for t in mine],
                       _("_Remove"), True):
                return
            status.set_text(_("Removing {name}…").format(name=name))

        def work():
            for tool in mine:
                use_tool(tool, "system")
            run_control(f"upstream.{entry_id}", "on" if want else "off")

        env_background(work, _("{name} is installed.").format(name=name) if want
                       else _("{name} was removed.").format(name=name))

    # --- Environments (flickos-dev.md 8c, flickos-security.md ADR-S03) ---------------------

    def env_section(envs):
        content.pack_start(heading(_("Environments")), False, False, 0)
        about = Gtk.Label(label=_("Newer or other software in a container that shares your home folder: "
                                  "for other software, not for keeping anything apart."),
                          xalign=0, wrap=True, max_width_chars=70)
        about.get_style_context().add_class("dim-label")
        content.pack_start(about, False, False, 0)
        if envs is None:
            button = Gtk.Button(label=_("Install Containers Kit…"))
            button.connect("clicked", lambda _b: switches["containers"].set_active(True)
                           if "containers" in switches else None)
            content.pack_start(framed([row_of(_("Environments need the Containers kit"),
                                              _("Podman and Distrobox, about {size} with Developer Basics.").format(
                                                  size=human_size(CONTAINERS_SIZE)), button)]), False, False, 0)
            return
        if isinstance(envs, str):
            show_notice(_("Couldn't list the environments: {error}").format(error=envs))
            envs = []
        rows = [env_row(env) for env in envs]
        new = Gtk.Button(label=_("New Environment…"))
        new.connect("clicked", lambda _b: new_env_dialog())
        if rows:
            content.pack_start(framed(rows), False, False, 0)
        line = Gtk.Box()
        line.pack_end(new, False, False, 0)
        content.pack_start(line, False, False, 0)

    def env_row(env):
        name = env["name"]
        kind = _("Kali Linux") if env["category"] == "security" else _("Debian testing")
        titles = ", ".join(_(k[2]) for k in KITS if k[0] in env["kits"])
        when = GLib.DateTime.new_from_unix_local(int(env["updated"])).format("%x") if env["updated"] else ""
        subtitle = " · ".join(part for part in (
            kind, titles, _("Running") if env["running"] else _("Stopped"),
            _("Updated {date}").format(date=when) if when else "") if part)
        subtitle += "\n" + _("Automatic updates don't reach it.")
        box = Gtk.Box(spacing=6)
        terminal = Gtk.Button(label=_("Open Terminal"))
        terminal.get_accessible().set_name(_("Open a terminal in {name}").format(name=name))
        terminal.connect("clicked", lambda _b: env_terminal(name))
        box.pack_start(terminal, False, False, 0)
        menu = Gtk.Menu()
        items = [(_("Update…"), lambda: env_in_terminal(["env", "update", name], _("{name} updates in the "
                                                                                   "terminal.").format(name=name)))]
        if env["running"]:
            items.append((_("Stop"), lambda: env_background(lambda: stop_environment(name))))
        items.append((_("Make a Command Available…"), lambda: export_dialog(name)))
        if "exploitation" in env["extras"]:
            items.append((_("Start Database"), lambda: env_in_terminal(["env", "database", name],
                                                                       _("The database starts in the terminal."))))
        items.append((None, None))
        items.append((_("Remove…"), lambda: remove_env(name)))
        for label, action in items:
            item = Gtk.SeparatorMenuItem() if label is None else Gtk.MenuItem(label=label)
            if action is not None:
                item.connect("activate", lambda _i, a=action: a())
            menu.append(item)
        menu.show_all()
        more = Gtk.MenuButton(popup=menu)
        more.add(Gtk.Image.new_from_icon_name("view-more-symbolic", Gtk.IconSize.BUTTON))
        more.set_tooltip_text(_("More"))
        more.get_accessible().set_name(_("More for {name}").format(name=name))
        box.pack_start(more, False, False, 0)
        return row_of(name, subtitle, box)

    def env_terminal(name):
        try:
            start_in_terminal(["distrobox", "enter", name])
        except KitsError as error:
            return show_notice(str(error))
        status.set_text(_("{name} opens in the terminal (its first start takes a while).").format(name=name))

    def env_in_terminal(args, words):
        try:
            start_in_terminal([NAME, *args])
        except KitsError as error:
            return show_notice(str(error))
        status.set_text(words)

    def env_background(work, done_words=None):
        def done(_result, error):
            if error:
                show_notice(error)
            elif done_words:
                status.set_text(done_words)
            shown["state"] = None
            refresh()
        background(work, done)

    def remove_env(name):
        if not ask(_("Remove Environment"), _("Remove {name}?").format(name=name),
                   _("Everything installed in it goes, with the commands and menu entries it made available, "
                     "and its downloaded image when nothing else uses it. Your home folder stays."),
                   [], _("_Remove"), True):
            return
        status.set_text(_("Removing {name}…").format(name=name))
        env_background(lambda: remove_environment(name), _("{name} was removed.").format(name=name))

    def export_dialog(name):
        dialog = Gtk.Dialog(title=_("Make a Command Available"), transient_for=win, modal=True)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        go = dialog.add_button(_("_Make Available"), Gtk.ResponseType.ACCEPT)
        go.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.ACCEPT)
        box = dialog.get_content_area()
        box.set_spacing(12)
        box.set_border_width(18)
        line = Gtk.Box(spacing=6)
        label = Gtk.Label.new_with_mnemonic(_("_Command"))
        entry = Gtk.Entry(activates_default=True, width_chars=24, placeholder_text="burpsuite")
        label.set_mnemonic_widget(entry)
        line.pack_start(label, False, False, 0)
        line.pack_start(entry, True, True, 0)
        box.pack_start(line, False, False, 0)
        menu = Gtk.CheckButton.new_with_mnemonic(_("Also add it to the _menu"))
        box.pack_start(menu, False, False, 0)
        hint = Gtk.Label(label=_("You can then run it like any command, and it runs in {name}.").format(name=name),
                         xalign=0, wrap=True, max_width_chars=48)
        hint.get_style_context().add_class("dim-label")
        box.pack_start(hint, False, False, 0)
        entry.connect("changed", lambda e: go.set_sensitive(bool(e.get_text().strip())))
        go.set_sensitive(False)
        dialog.show_all()
        answer = dialog.run()
        command, with_menu = entry.get_text().strip(), menu.get_active()
        dialog.destroy()
        if answer == Gtk.ResponseType.ACCEPT:
            status.set_text(_("Starting {name}…").format(name=name))
            env_background(lambda: export_command(name, command, with_menu),
                           _("{command} is available.").format(command=command))

    def new_env_dialog():
        installed = {r[0] for r in shown["state"]["kits"] if r[4]}
        taken = {e["name"] for e in shown["state"]["envs"] or [] if isinstance(e, dict)}
        dialog = Gtk.Dialog(title=_("New Environment"), transient_for=win, modal=True)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        go = dialog.add_button(_("_Make…"), Gtk.ResponseType.ACCEPT)
        go.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.ACCEPT)
        box = dialog.get_content_area()
        box.set_spacing(12)
        box.set_border_width(18)
        security_first = any(kit_of(k)[1] == "security" for k in installed)
        line = Gtk.Box(spacing=6)
        label = Gtk.Label.new_with_mnemonic(_("_Name"))
        entry = Gtk.Entry(text=free_name("kali" if security_first else "testing", taken), activates_default=True,
                          width_chars=24)
        label.set_mnemonic_widget(entry)
        line.pack_start(label, False, False, 0)
        line.pack_start(entry, True, True, 0)
        box.pack_start(line, False, False, 0)
        kinds = {}
        first = None
        for category, words in (("security", _("Security work: Kali Linux")),
                                ("development", _("Development: Debian testing"))):
            radio = Gtk.RadioButton.new_with_label_from_widget(first, words)
            first = first or radio
            kinds[category] = radio
            box.pack_start(radio, False, False, 0)
        kits_label = Gtk.Label(xalign=0)
        kits_label.set_markup("<b>{}</b>".format(GLib.markup_escape_text(_("Kits"))))
        box.pack_start(kits_label, False, False, 0)
        kits_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.pack_start(kits_box, False, False, 0)
        whole = Gtk.CheckButton.new_with_mnemonic(_("Add Kali's _whole list for these kits"))
        extras = {key: Gtk.CheckButton(label=_(value[1])) for key, value in ENV_EXTRAS.items()}
        for widget in (whole, *extras.values()):
            box.pack_start(widget, False, False, 0)
        source = Gtk.Label(xalign=0, wrap=True, max_width_chars=56)
        source.get_style_context().add_class("dim-label")
        box.pack_start(source, False, False, 0)
        hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=56)
        box.pack_start(hint, False, False, 0)
        checks = {}

        def category():
            return next(c for c, radio in kinds.items() if radio.get_active())

        def fill(_widget=None):
            for child in kits_box.get_children():
                kits_box.remove(child)
            checks.clear()
            for kit in KITS:
                if kit[1] == category() and kit[0] not in NO_ENV:
                    check = Gtk.CheckButton(label=_(kit[2]))
                    check.set_active(kit[0] in installed)
                    check.connect("toggled", validate)
                    checks[kit[0]] = check
                    kits_box.pack_start(check, False, False, 0)
            for widget in (whole, *extras.values()):
                widget.set_visible(category() == "security")
            source.set_text(_(ENV_SOURCES[category()]).format(image=ENV_IMAGES[category()]))
            kits_box.show_all()
            validate()

        def validate(_widget=None):
            name = entry.get_text().strip()
            problem = None
            if not ENV_NAME.fullmatch(name):
                problem = _("A name has lowercase letters, digits, - and _.")
            elif name in taken:
                problem = _("There is an environment named {name} already.").format(name=name)
            elif not any(c.get_active() for c in checks.values()):
                problem = _("Choose at least one kit.")
            go.set_sensitive(problem is None)
            hint.set_text(problem or _("A terminal shows the sizes and asks before anything is installed."))

        kinds["security" if security_first else "development"].set_active(True)
        for radio in kinds.values():
            radio.connect("toggled", fill)
        entry.connect("changed", validate)
        dialog.show_all()
        fill()
        answer = dialog.run()
        args = ["env", "new", entry.get_text().strip()]
        for kit, check in checks.items():
            if check.get_active():
                args += ["--kit", kit]
        if category() == "security":
            args += ["--whole"] if whole.get_active() else []
            for key, check in extras.items():
                args += ["--extra", key] if check.get_active() else []
        dialog.destroy()
        if answer == Gtk.ResponseType.ACCEPT:
            env_in_terminal(args, _("The terminal shows the sizes and asks first. Come back here when it is done."))

    def git_dialog():
        name, email = shown["state"]["steps"].get("git", ("", ""))
        dialog = Gtk.Dialog(title=_("Git Name and Email"), transient_for=win, modal=True)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        save = dialog.add_button(_("_Save"), Gtk.ResponseType.ACCEPT)
        save.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.ACCEPT)
        box = dialog.get_content_area()
        box.set_spacing(12)
        box.set_border_width(18)
        entries = []
        for label_text, value in ((_("_Name"), name), (_("_Email"), email)):
            line = Gtk.Box(spacing=6)
            label = Gtk.Label.new_with_mnemonic(label_text)
            label.set_width_chars(8)
            label.set_xalign(0)
            entry = Gtk.Entry(text=value, activates_default=True, width_chars=34)
            label.set_mnemonic_widget(entry)
            line.pack_start(label, False, False, 0)
            line.pack_start(entry, True, True, 0)
            box.pack_start(line, False, False, 0)
            entries.append(entry)
        hint = Gtk.Label(xalign=0, wrap=True)
        hint.get_style_context().add_class("dim-label")
        box.pack_start(hint, False, False, 0)

        def check(_entry=None):
            valid = all(e.get_text().strip() for e in entries)
            save.set_sensitive(valid)
            hint.set_text("" if valid else _("Both a name and an email are needed."))

        for entry in entries:
            entry.connect("changed", check)
        check()
        dialog.show_all()
        answer = dialog.run()
        values = [e.get_text().strip() for e in entries]
        dialog.destroy()
        if answer != Gtk.ResponseType.ACCEPT:
            return
        background(lambda: set_git(*values),
                   lambda _r, error: show_notice(_("Git's name and email couldn't be saved: {error}").format(
                       error=error)) if error else refresh())

    def system_step(key, value):
        """A step that changes the computer: flickos-control asks for the password. The
        page is read again afterwards, so a refused change puts the control back."""
        status.set_text(_("Waiting for the password…"))

        def changed(_result, error):
            status.set_text("")
            if error:
                show_notice(_("Not changed: {error}").format(error=error))
            shown["state"] = None
            refresh()

        background(lambda: run_control(key, value), changed)

    def ports_dialog(current):
        dialog = Gtk.Dialog(title=_("Open Ports"), transient_for=win, modal=True)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        save = dialog.add_button(_("_Save"), Gtk.ResponseType.ACCEPT)
        save.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.ACCEPT)
        box = dialog.get_content_area()
        box.set_spacing(12)
        box.set_border_width(18)
        line = Gtk.Box(spacing=6)
        label = Gtk.Label.new_with_mnemonic(_("_Ports"))
        entry = Gtk.Entry(text="" if current == "off" else current.replace(",", ", "), activates_default=True,
                          width_chars=34, placeholder_text="8000/tcp")
        label.set_mnemonic_widget(entry)
        line.pack_start(label, False, False, 0)
        line.pack_start(entry, True, True, 0)
        box.pack_start(line, False, False, 0)
        hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=48)
        hint.get_style_context().add_class("dim-label")
        box.pack_start(hint, False, False, 0)
        normal = _("Ports like 8000/tcp, separated by commas, from 1024 up. Leave it empty to close them "
                   "again. Needs an administrator's password.")

        def check(_entry=None):
            try:
                ports_value(entry.get_text())
            except KitsError as error:
                save.set_sensitive(False)
                hint.set_text(str(error))
            else:
                save.set_sensitive(True)
                hint.set_text(normal)

        entry.connect("changed", check)
        check()
        dialog.show_all()
        answer = dialog.run()
        text = entry.get_text()
        dialog.destroy()
        if answer == Gtk.ResponseType.ACCEPT:
            system_step("firewall.local-ports", ports_value(text))

    def copy_key(button):
        def copied(path, error):
            if error:
                return show_notice(error)
            status.set_text(_("The public key is copied. Paste it where the code host asks for one."))
        background(copy_public_key, copied)

    def make_key():
        try:
            os.makedirs(ssh_folder(), mode=0o700, exist_ok=True)
            start_in_terminal(["ssh-keygen", "-t", SSH_KEY_TYPE, "-f", os.path.join(ssh_folder(), SSH_KEY_FILE)])
        except (KitsError, OSError) as error:
            return show_notice(str(error))
        status.set_text(_("Answer in the terminal, then come back here."))

    def rust_step(update):
        try:
            start_in_terminal(["rustup", "update"] if update else ["rustup", "default", "stable"])
        except KitsError as error:
            return show_notice(str(error))
        status.set_text(_("Rust downloads in the terminal."))

    def focused(_window, _event):
        """Back from a terminal: read the steps again."""
        if busy["kit"] is None and switches:
            refresh()
        return False

    win.connect("focus-in-event", focused)

    footer = Gtk.Box(spacing=12)
    footer.pack_start(status, True, True, 0)
    close = Gtk.Button.new_with_mnemonic(_("_Close"))
    close.connect("clicked", lambda _b: win.destroy())
    footer.pack_end(close, False, False, 0)
    outer.pack_start(progress, False, False, 0)
    outer.pack_start(footer, False, False, 0)

    win.show_all()
    progress.hide()
    refresh()
    Gtk.main()
    return 0


def cmd_window(opts):
    with single_instance() as first:
        if not first:
            print(_("Tool Kits is already open."))
            return 0
        return window(opts.kit)


# --- Entry point -----------------------------------------------------------------------

def main(argv=None):
    parser = argparse.ArgumentParser(prog=NAME, description="Install the kits for your kind of work and set them up.")
    commands = parser.add_subparsers(dest="command", metavar="COMMAND")
    show = commands.add_parser("window", help="open the window")
    show.add_argument("--kit", metavar="NAME", help="start on a kit's row")
    show.set_defaults(func=cmd_window)
    listing = commands.add_parser("list", help="print the kits: name, installed, title, summary")
    listing.add_argument("--json", action="store_true", help="print JSON")
    listing.add_argument("--category", choices=[c[0] for c in CATEGORIES])
    listing.set_defaults(func=cmd_list)
    plan = commands.add_parser("plan", help="print what installing or removing a kit changes, as JSON")
    plan.add_argument("--remove", action="store_true")
    plan.add_argument("kit", metavar="KIT", choices=kit_names())
    plan.set_defaults(func=cmd_plan)
    for verb in ("install", "remove"):
        sub = commands.add_parser(verb, help=f"{verb} kits")
        sub.add_argument("kits", metavar="KIT", nargs="+", choices=kit_names())
        sub.set_defaults(func=cmd_change)
    setup = commands.add_parser("setup", help="set up what an installed kit needs")
    steps = setup.add_subparsers(dest="step", metavar="STEP", required=True)
    git = steps.add_parser("git", help="print git's name and email, or set them")
    git.add_argument("--name")
    git.add_argument("--email")
    git.set_defaults(func=cmd_setup_git)
    ssh = steps.add_parser("ssh", help="make an SSH key, or copy its public half")
    ssh.add_argument("--copy", action="store_true", help="copy the public key to the clipboard")
    ssh.set_defaults(func=cmd_setup_ssh)
    steps.add_parser("rust", help="install the stable Rust toolchain with rustup").set_defaults(func=cmd_setup_rust)
    ports = steps.add_parser("ports", help="print or set the ports devices on the network may reach")
    ports.add_argument("ports", metavar="PORT", nargs="*", help="8000/tcp, 5000:5010/udp, or off")
    ports.set_defaults(func=cmd_setup_ports)
    dhcp = steps.add_parser("dhcp", help="print or set whether podman's DHCP helper may run")
    dhcp.add_argument("value", nargs="?", choices=("on", "off"))
    dhcp.set_defaults(func=cmd_setup_dhcp)
    capture = steps.add_parser("capture", help="print or set whether you may capture packets without root")
    capture.add_argument("value", nargs="?", choices=("on", "off"))
    capture.set_defaults(func=cmd_setup_capture)
    adapter = steps.add_parser("test-adapter", help="print or choose the Wi-Fi adapter NetworkManager leaves alone")
    adapter.add_argument("adapter", nargs="?", metavar="DEVICE|ADDRESS|off")
    adapter.set_defaults(func=cmd_setup_test_adapter)
    env = commands.add_parser("env", help="environments: newer or other software in a container")
    envs = env.add_subparsers(dest="verb", metavar="VERB", required=True)
    sub = envs.add_parser("list", help="the environments: name, kind, kits, running or stopped, last updated")
    sub.add_argument("--json", action="store_true")
    sub.set_defaults(func=cmd_env_list)
    env_kits = [k[0] for k in KITS if k[1] in ENV_IMAGES and k[0] not in NO_ENV]
    for verb, func in (("plan", cmd_env_plan), ("new", cmd_env_new)):
        sub = envs.add_parser(verb, help="print the sizes of an environment of these kits" if verb == "plan"
                              else "make an environment of these kits (shows the sizes and asks first)")
        if verb == "new":
            sub.add_argument("name", metavar="NAME")
            sub.add_argument("--yes", action="store_true", help="don't ask")
        sub.add_argument("--kit", action="append", required=True, choices=env_kits)
        sub.add_argument("--whole", action="store_true", help="Kali's whole list for each security kit")
        sub.add_argument("--extra", action="append", choices=list(ENV_EXTRAS))
        if verb == "plan":
            sub.add_argument("--json", action="store_true")
        sub.set_defaults(func=func)
    for verb, func, words in (("update", cmd_env_update, "update everything inside (apt full-upgrade)"),
                              ("stop", cmd_env_stop, "stop it"),
                              ("remove", cmd_env_remove, "remove it and what is installed in it"),
                              ("terminal", cmd_env_terminal, "open a terminal in it"),
                              ("database", cmd_env_database, "start Kali's Metasploit database in it")):
        sub = envs.add_parser(verb, help=words)
        sub.add_argument("name", metavar="NAME")
        if verb == "remove":
            sub.add_argument("--yes", action="store_true", help="don't ask")
        sub.set_defaults(func=func)
    sub = envs.add_parser("export", help="make a command of the environment yours (~/.local/bin)")
    sub.add_argument("name", metavar="NAME")
    sub.add_argument("command", metavar="COMMAND")
    sub.add_argument("--menu", action="store_true", help="also add it to the menu")
    sub.set_defaults(func=cmd_env_export)
    version = commands.add_parser("version", help="newer versions: makers' repositories and your own (mise)")
    verbs = version.add_subparsers(dest="verb", metavar="VERB", required=True)
    sub = verbs.add_parser("list", help="what the installed kits offer: the makers' repositories, mise's tools")
    sub.add_argument("--json", action="store_true")
    sub.set_defaults(func=cmd_version_list)
    sub = verbs.add_parser("maker", help="print, or add (on) or remove (off) a maker's repository and its program")
    sub.add_argument("id", metavar="ID", choices=list(UPSTREAMS))
    sub.add_argument("value", nargs="?", choices=("on", "off"))
    sub.set_defaults(func=cmd_version_maker)
    sub = verbs.add_parser("use", help="your own version of a tool through mise: latest (default), a version, "
                                       "or system for the computer's again")
    sub.add_argument("tool", metavar="TOOL")
    sub.add_argument("version", nargs="?", metavar="VERSION|latest|system")
    sub.set_defaults(func=cmd_version_use)
    verbs.add_parser("update", help="mise upgrade: the newest release of the tools that follow the latest") \
        .set_defaults(func=cmd_version_update)
    commands.add_parser("doctor", help="print what is set up and what is missing").set_defaults(func=cmd_doctor)
    argv = list(sys.argv[1:] if argv is None else argv)
    # No command, or only window's options: window.
    if not argv or argv[0].startswith("--") and argv[0] not in ("-h", "--help"):
        argv.insert(0, "window")
    opts = parser.parse_args(argv)
    if opts.command is None:
        opts.command = "window"
    try:
        return opts.func(opts)
    except KitsError as error:
        warn(str(error))
        return 1


if __name__ == "__main__":
    sys.exit(main())
