def run_program(args, **kwargs):
    """subprocess.run, looked up when it is called: the functions below take it
    as a default argument, and the tests replace subprocess.run."""
    return subprocess.run(args, **kwargs)


def start_program(args, **kwargs):
    """subprocess.Popen, looked up when it is called."""
    return subprocess.Popen(args, **kwargs)


class KitsError(Exception):
    """An expected failure: it becomes a message for the user."""


def warn(message):
    print(f"{NAME}: {message}", file=sys.stderr)


def kit_names():
    return [kit[0] for kit in KITS]


def kit_of(name):
    kit = next((k for k in KITS if k[0] == name), None)
    if kit is None:
        raise KitsError(f"no kit named {name} (try: {', '.join(kit_names())})")
    return kit


def live_system():
    """True in the live session, where what is installed is lost at restart (INT-7)."""
    try:
        with open(PROC + "/cmdline", encoding="utf-8") as f:
            return "boot=live" in f.read().split()
    except OSError:
        return False


@contextlib.contextmanager
def single_instance():
    """Yields True for the first window of the session, False while one is open.
    Without XDG_RUNTIME_DIR there is nothing to share, so always True."""
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        yield True
        return
    folder = os.path.join(base, "flickos")
    os.makedirs(folder, exist_ok=True)
    with open(os.path.join(folder, LOCK), "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        yield True


# --- What is installed -----------------------------------------------------------------

def installed_packages(packages, run=run_program):
    """The subset of packages that dpkg has installed."""
    if not packages:
        return set()
    try:
        done = run(["dpkg-query", "-W", "-f", "${db:Status-Abbrev}\t${Package}\n", *packages],
                   capture_output=True, text=True, timeout=COMMAND_SECONDS)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise KitsError(f"couldn't read what is installed: {error}") from None
    found = set()
    for line in done.stdout.splitlines():
        state, _tab, package = line.partition("\t")
        if state.startswith("ii"):
            found.add(package)
    return found


def kit_rows(run=run_program):
    """[(name, category, title, summary, installed)] for KITS."""
    have = installed_packages([PACKAGE.format(k[0]) for k in KITS], run)
    return [(name, category, _(title), _(summary), PACKAGE.format(name) in have)
            for name, category, title, summary in KITS]


# --- Plans and changes, through flickos-software ---------------------------------------

def software_error(stderr, fallback):
    """The last line of a FlickOS program's stderr without its name, or fallback."""
    lines = [line.strip() for line in (stderr or "").splitlines() if line.strip()]
    if not lines:
        return fallback
    return re.sub(r"^((flickos-[a-z-]+|control-helper): )+", "", lines[-1])


def get_plan(name, remove=False, run=run_program):
    """flickos-software's plan for a kit as a dict (see its plan --json). Raises
    KitsError with its message when there is no plan."""
    kit_of(name)
    args = [SOFTWARE, "plan", "--json"] + (["--remove"] if remove else []) + [APP.format(name)]
    try:
        done = run(args, capture_output=True, text=True, timeout=120)
    except OSError as error:
        raise KitsError(f"{SOFTWARE} can't run: {error}") from None
    except subprocess.TimeoutExpired:
        raise KitsError("the plan took too long") from None
    if done.returncode != 0:
        raise KitsError(software_error(done.stderr, f"no plan for {name}"))
    try:
        return json.loads(done.stdout)
    except ValueError:
        raise KitsError("flickos-software printed a plan that can't be read") from None


def change(name, remove, on_event, popen=start_program):
    """Install or remove a kit through flickos-software --json, calling
    on_event(dict) for each line it prints. Returns 0, or the exit code."""
    kit_of(name)
    args = [SOFTWARE, "remove" if remove else "install", "--json", APP.format(name)]
    try:
        process = popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    except OSError as error:
        raise KitsError(f"{SOFTWARE} can't run: {error}") from None
    errors = []
    reader = threading.Thread(target=lambda: errors.append(process.stderr.read()), daemon=True)
    reader.start()
    for line in process.stdout:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        on_event(event)
    code = process.wait()
    reader.join(5)
    if code != 0:
        # A cancelled change prints its event; an error prints its message too.
        on_event({"event": "failed", "message": software_error("".join(errors), "")})
    return code


def plan_words(plan, remove, size=None):
    """A plan in sentences for the dialog: (summary, [package names])."""
    size = size or human_size
    names = plan.get("removes" if remove else "packages") or []
    count = len(names)
    if remove:
        summary = ngettext("This removes {count} package and frees {size}.",
                           "This removes {count} packages and frees {size}.", count).format(
            count=count, size=size(plan.get("size", 0)))
    else:
        summary = ngettext("This adds {count} package, which takes {size}. About {download} is downloaded.",
                           "This adds {count} packages, which take {size}. About {download} is downloaded.",
                           count).format(count=count, size=size(plan.get("size", 0)),
                                         download=size(plan.get("download", 0)))
    return summary, sorted(names)


def human_size(number):
    """Bytes as 12 MB, 1.4 GB (powers of 1000, as Software shows them)."""
    number = float(number or 0)
    for unit in ("B", "kB", "MB", "GB"):
        if number < 1000 or unit == "GB":
            return f"{number:.0f} {unit}" if unit in ("B", "kB") or number >= 100 else f"{number:.1f} {unit}"
        number /= 1000
    return f"{number:.0f} GB"


# --- Setup steps (ADR-003): the user's own programs, when asked ------------------------

def git_values(run=run_program):
    """(name, email) of ~/.gitconfig through git, "" for one that isn't set."""
    values = []
    for key in ("user.name", "user.email"):
        try:
            done = run(["git", "config", "--global", "--get", key], capture_output=True, text=True,
                       timeout=COMMAND_SECONDS)
        except (OSError, subprocess.TimeoutExpired):
            values.append("")
            continue
        values.append(done.stdout.strip() if done.returncode == 0 else "")
    return tuple(values)


def set_git(name, email, run=run_program):
    """Sets git's name and email through `git config --global`. Both are checked
    before either is written, so a refused value changes nothing."""
    values = (("user.name", name), ("user.email", email))
    for key, value in values:
        if not value or any(c in value for c in "\n\r"):
            raise KitsError(f"{key} can't be empty or span lines")
    for key, value in values:
        try:
            done = run(["git", "config", "--global", key, value], capture_output=True, text=True,
                       timeout=COMMAND_SECONDS)
        except OSError as error:
            raise KitsError(f"git can't run: {error}") from None
        except subprocess.TimeoutExpired:
            raise KitsError("git took too long") from None
        if done.returncode != 0:
            raise KitsError(software_error(done.stderr, f"git couldn't set {key}"))


def ssh_folder():
    return os.path.join(os.path.expanduser("~"), ".ssh")


def public_key_path():
    """The SSH public key that is there, or None: the one this program makes, else any ssh-keygen's."""
    folder = ssh_folder()
    for name in (SSH_KEY_FILE, "id_rsa", "id_ecdsa", "id_ed25519_sk"):
        path = os.path.join(folder, name + ".pub")
        if os.path.exists(path):
            return path
    return None


def rust_toolchain(run=run_program):
    """The default toolchain rustup reports, or "" when there is none."""
    try:
        done = run(["rustup", "show", "active-toolchain"], capture_output=True, text=True, timeout=COMMAND_SECONDS)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return done.stdout.split()[0] if done.returncode == 0 and done.stdout.strip() else ""


def step_available(step, which=shutil.which):
    return which(step[3]) is not None


def control_value(key, run=run_program):
    """flickos-control's system setting KEY as it prints it, or None when it
    can't say (ufw or podman isn't there, or no flickos-control)."""
    try:
        done = run([CONTROL, "system", key], capture_output=True, text=True, timeout=COMMAND_SECONDS)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return done.stdout.strip() if done.returncode == 0 else None


def run_control(key, value, run=run_program):
    """Changes a system setting through its owner. It asks for the
    administrator's password (pkexec), so there is no timeout: the user may
    take a while. Raises KitsError with the owner's message."""
    try:
        done = run([CONTROL, "system", key, value], capture_output=True, text=True)
    except OSError as error:
        raise KitsError(f"{CONTROL} can't run: {error}") from None
    if done.returncode != 0:
        raise KitsError(software_error(done.stderr, f"{key} wasn't changed"))


def ports_value(text):
    """A ports field as `system firewall.local-ports` takes it: "off" for an
    empty one, else the items joined by commas. Raises KitsError."""
    items = text.replace(",", " ").split()
    for item in items:
        if not PORT_ITEM.match(item):
            raise KitsError(_("'{item}' isn't a port: give ports like 8000/tcp or 5000:5010/udp.").format(item=item))
    return ",".join(items) or "off"


def capture_active(groups=None):
    """Whether this session may capture now: its groups were read at login."""
    try:
        gid = grp.getgrnam(WIRESHARK_GROUP).gr_gid
    except KeyError:
        return False
    return gid in (os.getgroups() if groups is None else groups)


def nm_unescape(value):
    """A value of nmcli -t: backslash escapes its colons and backslashes."""
    return re.sub(r"\\(.)", r"\1", value)


def wifi_adapters(run=run_program):
    """[{device, address, label, active}] of NetworkManager's Wi-Fi adapters:
    address is the permanent one (PermHwAddress; NetworkManager scans with
    random ones), label the maker's first word and the model, short enough
    for a drop-down ("Qualcomm AR9271 802.11n, USB"), active whether it is on
    a network. [] when NetworkManager doesn't answer."""
    fields = "GENERAL.DEVICE,GENERAL.TYPE,GENERAL.STATE,GENERAL.DBUS-PATH,GENERAL.VENDOR,GENERAL.PRODUCT,GENERAL.PATH"
    try:
        done = run(["nmcli", "-t", "-f", fields, "device", "show"], capture_output=True, text=True,
                   timeout=COMMAND_SECONDS)
    except (OSError, subprocess.TimeoutExpired):
        return []
    if done.returncode != 0:
        return []
    devices, current = [], {}
    for line in done.stdout.splitlines() + [""]:
        key, sep, value = line.partition(":")
        if not sep:
            if current.get("GENERAL.TYPE") == "wifi":
                devices.append(current)
            current = {}
            continue
        current[key] = nm_unescape(value)
    found = []
    for device in devices:
        try:
            got = run(["busctl", "-j", "get-property", "org.freedesktop.NetworkManager",
                       device.get("GENERAL.DBUS-PATH", ""), "org.freedesktop.NetworkManager.Device.Wireless",
                       "PermHwAddress"], capture_output=True, text=True, timeout=COMMAND_SECONDS)
            address = json.loads(got.stdout)["data"].upper() if got.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError, AttributeError):
            address = ""
        if not HW_ADDRESS.match(address):
            continue
        state = device.get("GENERAL.STATE", "").split(" ")[0]
        maker = (device.get("GENERAL.VENDOR", "").split() or [""])[0]
        label = " ".join(part for part in (maker, device.get("GENERAL.PRODUCT", "")) if part) \
            or device.get("GENERAL.DEVICE", "")
        if "-usb-" in device.get("GENERAL.PATH", ""):
            label += ", USB"
        found.append({"device": device.get("GENERAL.DEVICE", ""), "address": address, "label": label,
                      "active": state.isdigit() and int(state) in ACTIVE_STATES})
    return found


def adapter_address(text, adapters):
    """The permanent address for a test-adapter argument: a device's name or an
    address. Raises KitsError."""
    if HW_ADDRESS.match(text):
        return text.upper()
    for adapter in adapters:
        if adapter["device"] == text:
            return adapter["address"]
    raise KitsError(f"no Wi-Fi adapter named {text} (try: {', '.join(a['device'] for a in adapters) or 'none'})")


def snapshot(run=run_program, which=shutil.which):
    """Everything the page shows, read in one go (it runs git and rustup, so
    never on the main loop): {"kits": kit_rows(), "steps": {step id: value}}. A
    step's value is git's (name, email), the SSH public key's path or None, or
    the Rust toolchain's name or "", the ports devices may reach ("off" or
    "8000/tcp,..."), "on" or "off" for podman's DHCP helper, (value, active now)
    for packet capture, or {"set": address or "off", "adapters": wifi_adapters()}
    for the test adapter; only steps that apply, and only once a kit is
    installed."""
    rows = kit_rows(run)
    steps = {}
    if any(r[4] for r in rows):
        for step in STEPS:
            if not step_available(step, which):
                continue
            if step[0] == "git":
                steps["git"] = git_values(run)
            elif step[0] == "ssh":
                steps["ssh"] = public_key_path()
            elif step[0] == "rust":
                steps["rust"] = rust_toolchain(run)
            elif step[0] == "ports":
                value = control_value("firewall.local-ports", run)
                if value is not None:
                    steps["ports"] = value
            elif step[0] == "dhcp":
                # Only with the containers kit, whose drop-ins keep the helper off.
                value = control_value("containers.dhcp", run) if any(r[0] == "containers" and r[4] for r in rows) \
                    else None
                if value is not None:
                    steps["dhcp"] = value
            elif step[0] == "capture":
                value = control_value("packet-capture", run)
                if value is not None:
                    steps["capture"] = (value, capture_active())
            elif step[0] == "test-adapter":
                value = control_value("wireless.test-adapter", run)
                if value is not None:
                    steps["test-adapter"] = {"set": value, "adapters": wifi_adapters(run)}
    # Environments (8c): None without distrobox and podman (the window offers
    # the Containers kit); shown once any kit is installed, like the steps.
    envs = None
    if any(r[4] for r in rows) and environments_available(which):
        try:
            envs = environments(run)
        except KitsError as error:
            envs = str(error)
    # Newer versions (8a, 8b): the makers' repositories and mise's tools the
    # installed kits offer; None without a kit.
    installed = {r[0] for r in rows if r[4]}
    return {"kits": rows, "steps": steps, "envs": envs, "versions": versions(installed, run, which) if installed
            else None}


def copy_public_key(which=shutil.which, run=run_program):
    """Copies the SSH public key to the clipboard (wl-copy: GTK's clipboard
    forgets it when the window closes)."""
    path = public_key_path()
    if path is None:
        raise KitsError("there is no SSH key yet")
    if which("wl-copy") is None:
        raise KitsError("wl-copy isn't installed; the key is in " + path)
    with open(path, "rb") as f:
        run(["wl-copy"], input=f.read(), check=True, timeout=COMMAND_SECONDS)
    return path


def terminal_command(argv, which=shutil.which):
    """argv inside the user's terminal (xdg-terminal-exec: the terminal they chose)."""
    if which("xdg-terminal-exec") is None:
        raise KitsError("no terminal to run it in: xdg-terminal-exec isn't installed")
    return ["xdg-terminal-exec", *argv]


def start_in_terminal(argv):
    """Starts a command in a terminal that lives on after the window closes (CODE-7)."""
    try:
        subprocess.Popen(terminal_command(argv), stdin=subprocess.DEVNULL, start_new_session=True)
    except OSError as error:
        raise KitsError(f"couldn't start a terminal: {error}") from None


# --- Environments (flickos-dev.md ADR-005 and 8c; flickos-security.md ADR-S03, ADR-S04) --

def state_path(name="environments.json"):
    """This program's own records: when each environment was last updated
    (environments.json), and the account's mise versions (versions.json)."""
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local/state")
    return os.path.join(base, "flickos", "kits", name)


def read_state(name="environments.json"):
    try:
        with open(state_path(name), encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def write_state(data, name="environments.json"):
    path = state_path(name)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".", suffix=".tmp")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def mark_updated(name, when=None):
    data = read_state()
    data[name] = {"updated": int(time.time() if when is None else when)}
    write_state(data)


def forget(name):
    data = read_state()
    if data.pop(name, None) is not None:
        write_state(data)


def environments_available(which=shutil.which):
    """Environments need distrobox and podman (flickos-kit-containers, ADR-S01)."""
    return which("distrobox") is not None and which("podman") is not None


def env_category(kits):
    """The one category of these kits that has environments. Raises KitsError."""
    if not kits:
        raise KitsError("name at least one kit with --kit")
    categories = set()
    for name in kits:
        kit = kit_of(name)
        if kit[1] not in ENV_IMAGES or name in NO_ENV:
            raise KitsError(f"{name} has no environment")
        categories.add(kit[1])
    if len(categories) > 1:
        raise KitsError("security kits and developer kits need different environments (Kali, Debian)")
    return categories.pop()


def kit_depends(name, run=run_program, seen=None):
    """A developer kit's Depends from apt's lists, other kits' expanded (an
    environment gets the same lists as the system, flickos-dev.md 8c)."""
    seen = set() if seen is None else seen
    package = PACKAGE.format(name)
    if package in seen:
        return []
    seen.add(package)
    try:
        done = run(["apt-cache", "show", "--no-all-versions", package], capture_output=True, text=True,
                   timeout=COMMAND_SECONDS)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise KitsError(f"couldn't read {package}'s list: {error}") from None
    match = re.search(r"(?m)^Depends: (.*)$", done.stdout if done.returncode == 0 else "")
    if not match:
        raise KitsError(f"apt doesn't know {package}; run sudo apt update")
    found = []
    for item in match.group(1).split(","):
        first = re.sub(r"\(.*?\)", "", item.split("|")[0]).strip()
        if first.startswith("flickos-kit-"):
            found += kit_depends(first[len("flickos-kit-"):], run, seen)
        elif first and not first.startswith(("flickos-", "$")):
            found.append(first)
    return found


def env_packages(kits, whole=False, extras=(), run=run_program):
    """What goes into an environment of these kits: a security kit's
    environment list (or Kali's whole list, Q-S9), a developer kit's Depends;
    then the extras (Kali's Metasploit, section 8c)."""
    category = env_category(kits)
    packages = []
    for name in kits:
        if category == "security":
            packages += ENV_LISTS[name][1 if whole else 0]
        else:
            packages += kit_depends(name, run)
    for extra in extras:
        if category != "security" or extra not in ENV_EXTRAS:
            raise KitsError(f"no extra named {extra} for these kits")
        packages += ENV_EXTRAS[extra][0]
    return list(dict.fromkeys(packages))


def apt_size(text):
    """(download, disk) in bytes from apt-get's plan in the C locale; None for one it doesn't say."""
    units = {"B": 1, "kB": 1000, "MB": 1000 ** 2, "GB": 1000 ** 3}

    def number(match):
        if not match:
            return None
        return int(float(match.group(1).replace(",", "")) * units[match.group(2)])
    download = re.search(r"Need to get (?:[\d.,]+ [kMG]?B/)?([\d.,]+) ([kMG]?B)", text)
    disk = re.search(r"After this operation, ([\d.,]+) ([kMG]?B) of additional disk space", text)
    return number(download), number(disk)


def env_plan(kits, whole=False, extras=(), run=run_program):
    """The sizes of what an environment of these kits would install, asked of
    its own distribution today: apt-get --trivial-only in a throwaway container
    of the image (which stays for distrobox to use). Returns {image, packages,
    download, disk}. Raises KitsError (a name the distribution dropped, too)."""
    category = env_category(kits)
    packages = env_packages(kits, whole, extras, run)
    image = ENV_IMAGES[category]
    script = ("export DEBIAN_FRONTEND=noninteractive LC_ALL=C; apt-get update -qq >/dev/null "
              "&& apt-get install --trivial-only --no-install-recommends \"$@\"")
    try:
        done = run(["podman", "run", "--rm", "--pull=missing", image, "sh", "-c", script, "plan", *packages],
                   capture_output=True, text=True, timeout=1800)
    except OSError as error:
        raise KitsError(f"podman can't run: {error}") from None
    except subprocess.TimeoutExpired:
        raise KitsError("asking for the sizes took too long") from None
    missing = re.findall(r"Unable to locate package (\S+)", done.stderr + done.stdout)
    if missing:
        raise KitsError(f"{image} has no package {', '.join(missing)}")
    download, disk = apt_size(done.stdout)
    if disk is None and download is None:
        raise KitsError(software_error(done.stderr, "the image's apt didn't say what it would install"))
    return {"image": image, "packages": packages, "download": download or 0, "disk": disk or 0}


def check_env_name(name):
    if not ENV_NAME.fullmatch(name or ""):
        raise KitsError(f"'{name}' can't name an environment: lowercase letters, digits, - and _, "
                        "starting with a letter or digit, at most 40")
    return name


def environments(run=run_program):
    """[{name, category, kits, extras, running, created, updated, image}] of the
    environments this program made (podman's labels say which), by name."""
    try:
        done = run(["podman", "ps", "--all", "--filter", f"label={ENV_LABEL}", "--format", "json"],
                   capture_output=True, text=True, timeout=COMMAND_SECONDS)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise KitsError(f"couldn't list the environments: {error}") from None
    if done.returncode != 0:
        raise KitsError(software_error(done.stderr, "podman couldn't list the environments"))
    try:
        containers = json.loads(done.stdout or "[]")
    except ValueError:
        raise KitsError("podman printed a list that can't be read") from None
    updated = read_state()
    found = []
    for container in containers or []:
        labels = container.get("Labels") or {}
        names = container.get("Names") or []
        if not names or labels.get(ENV_LABEL) not in ENV_IMAGES:
            continue
        name = names[0]
        found.append({"name": name, "category": labels[ENV_LABEL],
                      "kits": [k for k in labels.get(ENV_KITS_LABEL, "").split(",") if k],
                      "extras": [e for e in labels.get(ENV_EXTRAS_LABEL, "").split(",") if e],
                      "running": container.get("State") == "running",
                      "created": container.get("Created") or 0,
                      "image": container.get("ImageID") or "",
                      "updated": (updated.get(name) or {}).get("updated") or container.get("Created") or 0})
    return sorted(found, key=lambda env: env["name"])


def environment(name, run=run_program):
    env = next((e for e in environments(run) if e["name"] == name), None)
    if env is None:
        raise KitsError(f"no environment named {name} (flickos-kits env list)")
    return env


def inside(name, script, run=run_program, **kwargs):
    """Runs sh -c SCRIPT in the environment as the user (distrobox enter
    reads stdin, so it gets none). Output goes where the caller's goes."""
    try:
        return run(["distrobox", "enter", name, "--", "sh", "-c", script], stdin=subprocess.DEVNULL, **kwargs)
    except OSError as error:
        raise KitsError(f"distrobox can't run: {error}") from None


def run_steps(steps, run=run_program):
    """Runs each argv in turn, its output on the terminal; KitsError at the first that fails."""
    for argv in steps:
        try:
            code = run(argv, stdin=subprocess.DEVNULL).returncode
        except OSError as error:
            raise KitsError(f"{argv[0]} can't run: {error}") from None
        if code != 0:
            raise KitsError(f"{' '.join(argv[:3])} failed (exit code {code})")


def create_environment(name, kits, whole=False, extras=(), packages=None, run=run_program):
    """distrobox create (rootless, no menu entry of its own: the window opens
    and removes it), the list installed inside with apt, then stopped, since
    a large install once left distrobox enter unable to find the user until
    the environment restarted (flickos-security.md phase 0)."""
    category = env_category(kits)
    packages = env_packages(kits, whole, extras, run) if packages is None else packages
    labels = {ENV_LABEL: category, ENV_KITS_LABEL: ",".join(kits), ENV_EXTRAS_LABEL: ",".join(extras)}
    flags = " ".join(f"--label {key}={value}" for key, value in labels.items() if value)
    setup = f"sudo sh -c '{ENV_SETUP[category]}' && " if category in ENV_SETUP else ""
    install = ("export DEBIAN_FRONTEND=noninteractive; " + setup + "sudo -E apt-get update "
               "&& sudo -E apt-get install -y --no-install-recommends " + " ".join(packages))
    run_steps([["distrobox", "create", "--yes", "--no-entry", "--name", name, "--image", ENV_IMAGES[category],
                "--additional-flags", flags],
               ["distrobox", "enter", name, "--", "sh", "-c", install],
               ["distrobox", "stop", "--yes", name]], run)
    mark_updated(name)


def update_environment(name, run=run_program):
    environment(name, run)
    run_steps([["distrobox", "enter", name, "--", "sh", "-c",
                "export DEBIAN_FRONTEND=noninteractive; sudo -E apt-get update && sudo -E apt-get full-upgrade -y"],
               ["distrobox", "stop", "--yes", name]], run)
    mark_updated(name)


def stop_environment(name, run=run_program):
    environment(name, run)
    done = run(["distrobox", "stop", "--yes", name], capture_output=True, text=True, timeout=120)
    if done.returncode != 0:
        raise KitsError(software_error(done.stderr, f"{name} couldn't be stopped"))


def remove_environment(name, run=run_program):
    """distrobox rm also deletes the commands and menu entries exported from it
    (export_command names its own entries so that it finds them). The image
    goes too once no container uses it, the user's own included (Kali's is
    252 MB; a new environment downloads the current one anyway)."""
    env = environment(name, run)
    done = run(["distrobox", "rm", "--force", "--yes", name], capture_output=True, text=True, timeout=300)
    if done.returncode != 0:
        raise KitsError(software_error(done.stderr, f"{name} couldn't be removed"))
    forget(name)
    if env["image"]:
        remove_unused_image(env["image"], run)


def remove_unused_image(image, run=run_program):
    """podman rmi IMAGE when no container is made from it. Quietly kept when
    podman can't say or refuses (another name for it, say): the environment
    is gone, which is what was asked."""
    try:
        users = run(["podman", "ps", "--all", "--quiet", "--filter", f"ancestor={image}"],
                    capture_output=True, text=True, timeout=COMMAND_SECONDS)
        if users.returncode == 0 and not users.stdout.strip():
            run(["podman", "rmi", image], capture_output=True, text=True, timeout=COMMAND_SECONDS)
    except (OSError, subprocess.TimeoutExpired):
        pass


def applications_folder():
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local/share")
    return os.path.join(base, "applications")


def app_entry_path(name, command):
    """Named after the environment first: distrobox rm deletes such entries."""
    return os.path.join(applications_folder(), f"{name}-{command}.desktop")


def app_entry(name, command, title):
    """A menu entry for a Kali GUI tool that ships none (they are kali-menu's,
    flickos-security.md ADR-S03), named like distrobox's own ("… (on NAME)")."""
    return ("[Desktop Entry]\nType=Application\n"
            f"Name={title} (on {name})\n"
            f"Comment=From the environment {name} (Tool Kits)\n"
            f"Exec=distrobox-enter -n {name} -- {command}\n"
            "Icon=utilities-terminal\nTerminal=false\nCategories=Development;\n")


def export_command(name, command, menu=False, run=run_program, which=shutil.which):
    """Makes COMMAND of the environment a command of the user's
    (distrobox-export --bin into ~/.local/bin) and, with menu, an entry in the
    menu: the app's own through distrobox-export --app, or for Kali's GUI
    tools (ENV_APPS) one this program writes. A command the system has too is
    refused: two versions under one name confuse (flickos-dev.md, Risks)."""
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", command):
        raise KitsError(f"'{command}' isn't a command's name")
    environment(name, run)
    local_bin = os.path.join(os.path.expanduser("~"), ".local/bin")
    there = which(command)
    if there and os.path.dirname(there) != local_bin:
        raise KitsError(f"this computer has {command} too ({there}); run it inside the environment instead")
    # Looked up in the environment's system folders only: the home folder (and
    # its PATH) is shared, so a second export would find ~/.local/bin's
    # wrapper and make one that runs itself forever (found on a real computer).
    script = (f"p=$(PATH={ENV_SYSTEM_PATH} command -v {command}) || "
              f"{{ echo '{command} is not in {name}' >&2; exit 3; }}; "
              f"distrobox-export --bin \"$p\" --export-path \"$HOME/.local/bin\"")
    if menu and command not in ENV_APPS:
        # A terminal program (msfconsole) has no entry: distrobox's own error
        # says only "a non-installed application", after the command was made.
        script += (f" && {{ distrobox-export --app {command} >/dev/null 2>&1 || "
                   f"{{ echo '{command} is available as a command, but {name} has no menu entry for it: "
                   f"run it in a terminal' >&2; exit 4; }}; }}")
    done = inside(name, script, run, capture_output=True, text=True, timeout=300)
    if done.returncode != 0:
        raise KitsError(software_error(done.stderr, f"{command} couldn't be made available"))
    if menu and command in ENV_APPS:
        path = app_entry_path(name, command)
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(app_entry(name, command, ENV_APPS[command]))


def start_database(name, run=run_program):
    """Kali's Metasploit database: PostgreSQL started by hand (no init in a
    container) and, the first time, msfdb init, both as the environment's
    root (msfdb refuses the user; flickos-security.md phase 0 S2). It stops
    with the environment."""
    env = environment(name, run)
    if "exploitation" not in env["extras"]:
        raise KitsError(f"{name} has no Metasploit (make one with --extra exploitation)")
    run_steps([["distrobox", "enter", name, "--", "sh", "-c",
                "v=$(ls /etc/postgresql | sort -V | tail -n 1) && sudo pg_ctlcluster \"$v\" main start; "
                "test -e /usr/share/metasploit-framework/config/database.yml || sudo msfdb init"]], run)


def free_name(base, taken):
    """base, or base-2, base-3… when an environment has it."""
    name, number = base, 1
    while name in taken:
        number += 1
        name = f"{base}-{number}"
    return name


# --- Newer versions (flickos-dev.md ADR-007 to ADR-009, 8a and 8b) -------------------------

def plain_version(version):
    """Debian's version without epoch and revision: 20.19.2 of 20.19.2+dfsg-1."""
    version = version.split(":", 1)[-1]
    if "-" in version:
        version = version.rsplit("-", 1)[0]
    return re.split(r"[+~]", version)[0]


def package_versions(packages, run=run_program):
    """{package: plain version} of the installed ones."""
    if not packages:
        return {}
    try:
        done = run(["dpkg-query", "-W", "-f", "${db:Status-Abbrev}\t${Package}\t${Version}\n", *packages],
                   capture_output=True, text=True, timeout=COMMAND_SECONDS)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise KitsError(f"couldn't read what is installed: {error}") from None
    found = {}
    for line in done.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) == 3 and parts[0].startswith("ii"):
            found[parts[1]] = plain_version(parts[2])
    return found


def mise_tools(run=run_program):
    """{mise's name: (version, what was asked: "latest", "lts" or a version)} of
    the account's own mise list (`mise ls --global`, offline: nothing is
    fetched to read it). Raises KitsError."""
    try:
        done = run(["mise", "ls", "--global", "--json"], capture_output=True, text=True, timeout=COMMAND_SECONDS,
                   stdin=subprocess.DEVNULL, env=dict(os.environ, MISE_OFFLINE="1"))
    except (OSError, subprocess.TimeoutExpired) as error:
        raise KitsError(f"mise can't say: {error}") from None
    if done.returncode != 0:
        raise KitsError(mise_error(done.stderr, done.returncode))
    try:
        data = json.loads(done.stdout or "{}")
    except ValueError:
        raise KitsError("mise printed a list that can't be read") from None
    found = {}
    for name, entries in (data.items() if isinstance(data, dict) else ()):
        for entry in entries if isinstance(entries, list) else ():
            if isinstance(entry, dict) and entry.get("version") and entry.get("installed", True):
                found[name] = (str(entry["version"]), str(entry.get("requested_version") or ""))
                break
    return found


def shims_folder():
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local/share")
    return os.path.join(base, "mise", "shims")


def shims_on_path():
    """flickos-session puts mise's shims on PATH at login (ADR-009): not yet
    in a session that started before mise was installed."""
    return shims_folder() in os.environ.get("PATH", "").split(os.pathsep)


def tool_command(tool):
    return TOOL_COMMANDS.get(tool[0], re.split(r"[:/]", tool[0])[-1])


def comes_first(tool, which=shutil.which):
    """The other copy that runs instead of the user's mise version on this
    process's PATH (a shell startup file's nvm or ~/.local/bin, say), or None.
    Only for a shim that exists: without one there is nothing to hide."""
    command = tool_command(tool)
    if not command:
        return None
    shim = os.path.join(shims_folder(), command)
    if not os.path.exists(shim):
        return None
    found = which(command)
    return found if found and os.path.abspath(found) != shim else None


def tool_rows(installed_kits, which=shutil.which):
    """USER_TOOLS of the installed kits (pipx's only with pipx or uv)."""
    pipx = any(which(p) for p in PIPX_PROGRAMS)
    return [t for t in USER_TOOLS if t[2] in installed_kits and (pipx or not t[0].startswith("pipx:"))]


def shown_upstreams(installed_kits):
    """The makers' repositories the installed kits offer."""
    tool_kits = {t[2] for t in USER_TOOLS}
    categories = {kit_of(k)[1] for k in installed_kits}
    return [entry_id for entry_id, entry in UPSTREAMS.items()
            if (entry[3] is None and installed_kits & tool_kits) or entry[3] in categories]


def versions(installed_kits, run=run_program, which=shutil.which):
    """What the Newer versions rows show: {"upstreams": {id: "on", "off" or
    None (can't say)}, "packages": {package: version} of the makers' and
    Debian's, "tools": [USER_TOOLS rows], "mine": mise_tools() or None
    without mise, "error": mise's error or None, "on_path", "updated"}."""
    upstreams = {entry_id: control_value(f"upstream.{entry_id}", run) for entry_id in shown_upstreams(installed_kits)}
    tools = tool_rows(installed_kits, which) if "mise" in upstreams else []
    packages = [UPSTREAMS[e][0] for e in upstreams] + [t[5] for t in tools if t[5]]
    try:
        found = package_versions(packages, run)
    except KitsError:
        found = {}
    mine, error = None, None
    if "mise" in upstreams and which("mise"):
        try:
            mine = mise_tools(run)
        except KitsError as failure:
            mine, error = {}, str(failure)
    return {"upstreams": upstreams, "packages": found, "tools": tools, "mine": mine, "error": error,
            "on_path": shims_on_path(), "updated": read_state("versions.json").get("updated")}


def user_tool(name):
    """A USER_TOOLS row by mise's name, its title or its last part (nuclei). Raises KitsError."""
    wanted = name.lower()
    for tool in USER_TOOLS:
        if wanted in (tool[0].lower(), tool[1].lower(), tool[0].rsplit("/", 1)[-1].split(":")[-1].lower()):
            return tool
    raise KitsError(f"mise isn't offered for {name} (try: {', '.join(t[1] for t in USER_TOOLS)})")


def mise_error(stderr, code):
    """mise's last line, said as mise's."""
    lines = [line.strip() for line in (stderr or "").splitlines() if line.strip()]
    line = lines[-1] if lines else f"exit code {code}"
    return line if line.startswith("mise") else f"mise: {line}"


def run_mise(args, run=run_program):
    """mise for this account, without questions; it downloads, so it may take a while."""
    try:
        done = run(["mise", *args], capture_output=True, text=True, timeout=MISE_SECONDS, stdin=subprocess.DEVNULL,
                   env=dict(os.environ, MISE_YES="1"))
    except FileNotFoundError:
        raise KitsError("mise isn't installed: flickos-kits version maker mise on") from None
    except (OSError, subprocess.TimeoutExpired) as error:
        raise KitsError(f"mise: {error}") from None
    if done.returncode != 0:
        raise KitsError(mise_error(done.stderr, done.returncode))


def mark_versions_updated(when=None):
    write_state({"updated": int(time.time() if when is None else when)}, "versions.json")


def use_tool(tool, version=None, run=run_program):
    """Your own version of a tool through mise (ADR-009): the latest (a tool's
    "latest", Node's "lts", which mise upgrade then follows), a version that
    stays (Keep This Version), or "system": back to the computer's, which
    takes mise's copy away (mise unuse)."""
    if version == "system":
        run_mise(["unuse", "--global", tool[0]], run)
        return
    if version not in (None, "latest") and not TOOL_VERSION.fullmatch(version):
        raise KitsError(f"'{version}' isn't a version")
    run_mise(["use", "--global", f"{tool[0]}@{tool[4] if version in (None, 'latest') else version}"], run)
    mark_versions_updated()


def update_tools(run=run_program):
    """mise upgrade: the newest release of each tool that follows the latest."""
    run_mise(["upgrade"], run)
    mark_versions_updated()


def plan_text(plan, category, kits, extras):
    """What env new says before anything is installed (ADR-S03: the sizes and the source)."""
    titles = ", ".join(_(kit_of(k)[2]) for k in kits)
    lines = [_("Environment of {kits}: {count} packages, {download} to download, {disk} on disk.").format(
        kits=titles, count=len(plan["packages"]), download=human_size(plan["download"]),
        disk=human_size(plan["disk"])),
        _("The environment itself (distrobox's tools inside it) takes about {size} more.").format(
            size=human_size(ENV_BASE_SIZE)),
        _(ENV_SOURCES[category]).format(image=plan["image"]),
        _("It shares your home folder: it is for other software, not for keeping anything apart."),
        _("Automatic updates don't reach it: update it from Tool Kits.")]
    return "\n".join(lines)


# --- Commands --------------------------------------------------------------------------

def cmd_list(opts):
    rows = [r for r in kit_rows() if opts.category in (None, r[1])]
    if opts.json:
        print(json.dumps([{"id": n, "package": PACKAGE.format(n), "category": c, "title": t, "summary": s,
                           "installed": i} for n, c, t, s, i in rows]))
        return 0
    for name, _category, title, summary, installed in rows:
        print("\t".join((name, "yes" if installed else "no", title, summary)))
    return 0


def cmd_plan(opts):
    plan = get_plan(opts.kit, opts.remove)
    print(json.dumps(plan))
    return 0


def cmd_change(opts):
    code = 0
    for name in opts.kits:
        kit_of(name)
    for name in opts.kits:
        def show(event):
            if event.get("event") == "failed" and event.get("message"):
                warn(event["message"])
        code = change(name, opts.command == "remove", show) or code
    return code


def cmd_setup_git(opts):
    if opts.name is None and opts.email is None:
        name, email = git_values()
        print(f"{name}\t{email}")
        return 0
    current = git_values()
    set_git(opts.name if opts.name is not None else current[0], opts.email if opts.email is not None else current[1])
    return 0


def cmd_setup_ssh(opts):
    if opts.copy:
        print(copy_public_key())
        return 0
    if public_key_path() is not None:
        raise KitsError(f"there is a key already ({public_key_path()}); --copy copies its public half")
    os.makedirs(ssh_folder(), mode=0o700, exist_ok=True)
    # ssh-keygen asks for the passphrase itself: a passphrase in an argument shows in ps (CODE-7).
    return subprocess.call(["ssh-keygen", "-t", SSH_KEY_TYPE, "-f", os.path.join(ssh_folder(), SSH_KEY_FILE)])


def cmd_setup_rust(_opts):
    if shutil.which("rustup") is None:
        raise KitsError("rustup isn't installed")
    return subprocess.call(["rustup", "default", "stable"])


def cmd_setup_ports(opts):
    if not opts.ports:
        value = control_value("firewall.local-ports")
        if value is None:
            raise KitsError("the firewall (ufw) isn't installed")
        print(value)
        return 0
    value = "off" if opts.ports == ["off"] else ports_value(" ".join(opts.ports))
    run_control("firewall.local-ports", value)
    return 0


def cmd_setup_dhcp(opts):
    if opts.value is None:
        value = control_value("containers.dhcp")
        if value is None:
            raise KitsError("podman's DHCP helper (netavark) isn't installed")
        print(value)
        return 0
    run_control("containers.dhcp", opts.value)
    return 0


def cmd_setup_capture(opts):
    if opts.value is None:
        value = control_value("packet-capture")
        if value is None:
            raise KitsError("Wireshark isn't installed")
        print(value)
        return 0
    run_control("packet-capture", opts.value)
    return 0


def cmd_setup_test_adapter(opts):
    if opts.adapter is None:
        value = control_value("wireless.test-adapter")
        if value is None:
            raise KitsError("flickos-control can't say")
        print(value)
        return 0
    value = "off" if opts.adapter == "off" else adapter_address(opts.adapter, wifi_adapters())
    run_control("wireless.test-adapter", value)
    return 0


def tool_line(tool, mine, packages):
    """version list's and doctor's words for one tool: whose version runs."""
    computer = packages.get(tool[5]) if tool[5] else None
    if tool[0] in mine:
        version, asked = mine[tool[0]]
        return "yours", f"{version} ({asked})" + (f", over the computer's {computer}" if computer else "")
    return ("computer", computer) if computer else ("none", "")


def cmd_version_list(opts):
    installed = {r[0] for r in kit_rows() if r[4]}
    state = versions(installed)
    if opts.json:
        print(json.dumps(state))
        return 0
    for entry_id, value in state["upstreams"].items():
        print("\t".join(("maker", entry_id, value or "unknown", state["packages"].get(UPSTREAMS[entry_id][0], ""))))
    for tool in state["tools"]:
        whose, detail = tool_line(tool, state["mine"] or {}, state["packages"])
        print("\t".join(("tool", tool[0], tool[2], whose, detail, tool[3])))
    if state["error"]:
        warn(state["error"])
    return 0


def cmd_version_maker(opts):
    if opts.value is None:
        value = control_value(f"upstream.{opts.id}")
        if value is None:
            raise KitsError("flickos-control can't say")
        print(value)
        return 0
    run_control(f"upstream.{opts.id}", opts.value)
    return 0


def cmd_version_use(opts):
    tool = user_tool(opts.tool)
    use_tool(tool, opts.version)
    if opts.version == "system":
        print(f"{tool[1]}: the computer's version again.")
    else:
        print(f"{tool[1]}: your own version, from mise.")
        if not shims_on_path():
            print("Programs started from the menu and new terminals use it from your next login.")
    return 0


def cmd_version_update(_opts):
    update_tools()
    return 0


def need_environments():
    if not environments_available():
        raise KitsError(f"environments need the Containers kit (about {human_size(CONTAINERS_SIZE)} with "
                        "Developer Basics): flickos-kits install containers")


def cmd_env_list(opts):
    need_environments()
    envs = environments()
    if opts.json:
        print(json.dumps(envs))
        return 0
    for env in envs:
        print("\t".join((env["name"], env["category"], ",".join(env["kits"]), "running" if env["running"] else "stopped",
                         time.strftime("%Y-%m-%d", time.localtime(env["updated"])))))
    return 0


def cmd_env_plan(opts):
    need_environments()
    category = env_category(opts.kit)
    plan = env_plan(opts.kit, opts.whole, opts.extra or ())
    if opts.json:
        print(json.dumps(plan))
    else:
        print(plan_text(plan, category, opts.kit, opts.extra or ()))
    return 0


def cmd_env_new(opts):
    need_environments()
    name = check_env_name(opts.name)
    if any(env["name"] == name for env in environments()):
        raise KitsError(f"there is an environment named {name} already")
    category = env_category(opts.kit)
    extras = opts.extra or ()
    print(_("Asking for today's sizes (this downloads the image and its package lists)…"), flush=True)
    plan = env_plan(opts.kit, opts.whole, extras)
    print(plan_text(plan, category, opts.kit, extras), flush=True)
    if not opts.yes:
        if not sys.stdin.isatty():
            raise KitsError("give --yes to make it without asking")
        if input(_("Make the environment {name}? [y/N] ").format(name=name)).strip().lower() not in ("y", "yes"):
            print(_("Nothing was made."))
            return 1
    create_environment(name, opts.kit, opts.whole, extras, plan["packages"])
    print(_("The environment {name} is ready. Open it from Tool Kits, or with: distrobox enter {name}").format(
        name=name))
    return 0


