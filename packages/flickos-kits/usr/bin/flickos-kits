    stop_environment(opts.name)
    return 0


def cmd_env_remove(opts):
    need_environments()
    environment(opts.name)
    if not opts.yes:
        if not sys.stdin.isatty():
            raise KitsError("give --yes to remove it without asking")
        answer = input(_("Remove the environment {name}, everything installed in it and its image when "
                         "nothing else uses it? Your home folder stays. [y/N] ").format(name=opts.name))
        if answer.strip().lower() not in ("y", "yes"):
            return 1
    remove_environment(opts.name)
    return 0


