# flickos-upgrade's install (docs/design/flickos-upgrade.md, ADR-002 b):
# systemd starts system-update.target instead of the desktop while
# /system-update exists (systemd.offline-updates(7)); `control-helper upgrade
# install` links it to flickos-upgrade's stage. The program removes the link
# first, does nothing when it points elsewhere (PackageKit's offline update
# does the same with ours), and always restarts the computer at the end.
[Unit]
Description=Installing the new FlickOS release
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target system-update-pre.target systemd-journald.socket
Before=shutdown.target system-update.target
ConditionPathIsSymbolicLink=/system-update

[Service]
Type=oneshot
ExecStart=/usr/bin/flickos-upgrade offline
StandardOutput=journal+console
# A crash of the program itself: restart rather than wait in this target.
FailureAction=reboot
