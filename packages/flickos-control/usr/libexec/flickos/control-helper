class HelperError(Exception):
    pass


def rules(path=None):
    """{"model": set, "layout": set, "option": set, "variant": {layout: set}}"""
    found = {"model": set(), "layout": set(), "option": set(), "variant": {}}
    section = None
    with open(path or XKB_RULES, encoding="utf-8") as f:
        for line in f:
            if line.startswith("! "):
                section = line[2:].strip()
                continue
            parts = line.split(None, 1)
            if section not in found or len(parts) != 2:
                continue
            if section == "variant":
                found["variant"].setdefault(parts[1].split(":", 1)[0].strip(), set()).add(parts[0])
            else:
                found[section].add(parts[0])
    return found


def check_keyboard(model, layout, variant, options, known):
    if model and model not in known["model"]:
        raise HelperError(f"unknown keyboard model '{model}'")
    layouts = layout.split(",")
    if not layout or any(name not in known["layout"] for name in layouts):
        raise HelperError(f"unknown keyboard layout '{layout}'")
    variants = variant.split(",") if variant else []
    if len(variants) > len(layouts):
        raise HelperError("more variants than layouts")
    for name, for_layout in zip(variants, layouts):
        if name and name not in known["variant"].get(for_layout, set()):
            raise HelperError(f"layout '{for_layout}' has no variant '{name}'")
    for name in options.split(",") if options else []:
        if name not in known["option"]:
            raise HelperError(f"unknown keyboard option '{name}'")


def rewrite(text, values):
    """The file with the XKB lines replaced (or added), other lines kept."""
    lines, done = [], set()
    for line in text.splitlines():
        match = re.match(r"^\s*(XKB[A-Z]+)=", line)
        if match and match.group(1) in values:
            if match.group(1) in done:
                continue
            line = f'{match.group(1)}="{values[match.group(1)]}"'
            done.add(match.group(1))
        lines.append(line)
    lines += [f'{name}="{values[name]}"' for name in FIELDS if name not in done]
    return "\n".join(lines) + "\n"


def write_atomic(path, text):
    folder = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def cmd_keyboard(args):
    if len(args) != 4:
        raise HelperError("keyboard: give MODEL LAYOUT VARIANT OPTIONS (empty strings for none)")
    model, layout, variant, options = args
    try:
        known = rules()
    except OSError as error:
        raise HelperError(f"cannot read the keyboard layouts: {error}") from None
    check_keyboard(model, layout, variant, options, known)
    try:
        with open(KEYBOARD_DEFAULTS, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        text = "# KEYBOARD CONFIGURATION FILE\n\n# Consult the keyboard(5) manual page.\n"
    write_atomic(KEYBOARD_DEFAULTS, rewrite(text, dict(zip(FIELDS, (model, layout, variant, options)))))
    for command in AFTER:
        with contextlib.suppress(OSError, subprocess.TimeoutExpired):
            subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, timeout=30, check=False)
    print("The login screen and the console now use this layout (the console after a restart).")
    return 0


def uid_range():
    """Regular accounts: UID_MIN..UID_MAX of login.defs (1000..60000)."""
    limits = {"UID_MIN": 1000, "UID_MAX": 60000}
    with contextlib.suppress(OSError), open(LOGIN_DEFS, encoding="utf-8") as f:
        for line in f:
            parts = line.split()
            if len(parts) == 2 and parts[0] in limits and parts[1].isdigit():
                limits[parts[0]] = int(parts[1])
    return limits["UID_MIN"], limits["UID_MAX"]


def calling_user():
    """The user who ran pkexec: only they can be logged in automatically."""
    uid = os.environ.get("PKEXEC_UID", "")
    if not uid.isdigit():
        raise HelperError("run through pkexec (PKEXEC_UID is not set)")
    low, high = uid_range()
    try:
        entry = pwd.getpwuid(int(uid))
    except KeyError:
        raise HelperError(f"no user with id {uid}") from None
    if not low <= entry.pw_uid <= high:
        raise HelperError(f"{entry.pw_name} is not a regular account")
    return entry.pw_name


def group_members():
    try:
        return grp.getgrnam(AUTOLOGIN_GROUP).gr_mem
    except KeyError:
        raise HelperError(f"group {AUTOLOGIN_GROUP} doesn't exist (is flickos-greeter installed?)") from None


def gpasswd(*args):
    result = subprocess.run(["gpasswd", *args], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.PIPE, text=True, timeout=30, check=False)
    if result.returncode != 0:
        raise HelperError(f"gpasswd {' '.join(args)}: {result.stderr.strip()}")


def cmd_autologin_on(args):
    if args:
        raise HelperError("autologin-on takes no arguments: it is for the calling user")
    user = calling_user()
    group_members()
    gpasswd("-M", user, AUTOLOGIN_GROUP)
    print(f"{user} is logged in automatically from the next start of the computer.")
    return 0


def cmd_autologin_off(args):
    if args:
        raise HelperError("autologin-off takes no arguments: it is for the calling user")
    user = calling_user()
    if user in group_members():
        gpasswd("-d", user, AUTOLOGIN_GROUP)
    print(f"{user} logs in with a password again.")
    return 0


# --- User accounts ------------------------------------------------------------------------

def run_tool(command, stdin_text=None):
    """Run an account tool; raises HelperError with what it printed."""
    result = subprocess.run(command, input=stdin_text, stdin=None if stdin_text is not None else subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=120, check=False)
    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip() or f"exit code {result.returncode}"
        raise HelperError(message if message.startswith(f"{command[0]}:") else f"{command[0]}: {message}")


def check_new_name(name):
    if not USER_NAME.match(name):
        raise HelperError(f"'{name}' is not a valid user name: lowercase letters, digits, - and _, "
                          "starting with a letter, at most 32 characters")
    with contextlib.suppress(KeyError):
        pwd.getpwnam(name)
        raise HelperError(f"user {name} already exists")
    with contextlib.suppress(KeyError):
        grp.getgrnam(name)
        raise HelperError(f"group {name} already exists")


def check_full_name(full_name):
    """The first GECOS field: no field separators, no control characters."""
    if len(full_name) > FULL_NAME_MAX:
        raise HelperError(f"the full name is longer than {FULL_NAME_MAX} characters")
    if any(c in ":,=\\" or not c.isprintable() for c in full_name):
        raise HelperError("the full name can't contain : , = \\ or control characters")


def read_password(stream=None):
    """The new password: the first line of standard input."""
    line = (stream or sys.stdin).readline(PASSWORD_MAX + 2)
    password = line[:-1] if line.endswith("\n") else line
    if not password:
        raise HelperError("no password given (on standard input)")
    if len(password) > PASSWORD_MAX or any(c in "\n\r\0" for c in password):
        raise HelperError("the password is too long or contains a line break")
    return password


def regular_account(name):
    """The passwd entry of an existing regular account."""
    low, high = uid_range()
    try:
        entry = pwd.getpwnam(name)
    except KeyError:
        raise HelperError(f"no user {name}") from None
    if not low <= entry.pw_uid <= high:
        raise HelperError(f"{name} is not a regular account")
    return entry


def yes_no(value, what):
    if value not in ("yes", "no"):
        raise HelperError(f"{what}: give yes or no, not '{value}'")
    return value == "yes"


def administrators():
    """Regular accounts in group sudo."""
    try:
        members = grp.getgrnam(ADMIN_GROUP).gr_mem
    except KeyError:
        return []
    low, high = uid_range()
    found = []
    for name in members:
        with contextlib.suppress(KeyError):
            if low <= pwd.getpwnam(name).pw_uid <= high:
                found.append(name)
    return found


def keep_an_administrator(name):
    if administrators() == [name]:
        raise HelperError(f"{name} is the only administrator; make someone else an administrator first")


def logged_in(uid):
    """Whether any process runs as uid (a session, or anything left running)."""
    with contextlib.suppress(OSError):
        for pid in os.listdir(PROC):
            if pid.isdigit():
                with contextlib.suppress(OSError):
                    if os.stat(os.path.join(PROC, pid)).st_uid == uid:
                        return True
    return False


def group_exists(name):
    try:
        grp.getgrnam(name)
    except KeyError:
        return False
    return True


def cmd_user_add(args):
    if len(args) != 3:
        raise HelperError("user-add: give NAME FULLNAME ADMIN (yes or no), the password on standard input")
    name, full_name, admin = args
    check_new_name(name)
    check_full_name(full_name)
    admin = yes_no(admin, "user-add ADMIN")
    password = read_password()
    run_tool(["adduser", "--quiet", "--disabled-password", "--comment", full_name, name])
    try:
        run_tool(["chpasswd"], f"{name}:{password}\n")
        groups = [g for g in (*DEFAULT_GROUPS, *((ADMIN_GROUP,) if admin else ())) if group_exists(g)]
        if groups:
            run_tool(["usermod", "--append", "--groups", ",".join(groups), name])
    except (HelperError, OSError, subprocess.TimeoutExpired):
        with contextlib.suppress(HelperError, OSError, subprocess.TimeoutExpired):
            run_tool(["userdel", "--remove", name])
        raise
    print(f"{name} can log in now{' and is an administrator' if admin else ''}.")
    return 0


def cmd_user_remove(args):
    if len(args) != 2 or args[1] not in ("keep", "delete"):
        raise HelperError("user-remove: give NAME and keep or delete (the home folder)")
    name, files = args
    entry = regular_account(name)
    if entry.pw_name == calling_user():
        raise HelperError("you can't remove the account you are using")
    keep_an_administrator(name)
    if logged_in(entry.pw_uid):
        raise HelperError(f"{name} is logged in or has programs running; log them out first")
    try:
        run_tool(["userdel", *(["--remove"] if files == "delete" else []), name])
    except HelperError as error:
        with contextlib.suppress(KeyError):
            pwd.getpwnam(name)
            raise
        # userdel exits 12 when the account is gone but its home folder isn't.
        raise HelperError(f"{name} was removed, but not all of their files:\n{error}") from None
    if files == "delete":
        print(f"{name} was removed, with their files.")
    else:
        print(f"{name} was removed; their files are still in {entry.pw_dir}.")
    return 0


def cmd_user_admin(args):
    if len(args) != 2:
        raise HelperError("user-admin: give NAME and yes or no")
    name = regular_account(args[0]).pw_name
    if yes_no(args[1], "user-admin"):
        gpasswd("-a", name, ADMIN_GROUP)
        print(f"{name} is an administrator from their next login.")
    else:
        keep_an_administrator(name)
        if name in administrators():
            gpasswd("-d", name, ADMIN_GROUP)
        print(f"{name} is a standard user from their next login.")
    return 0


def cmd_user_password(args):
    if len(args) != 1:
        raise HelperError("user-password: give NAME, the password on standard input")
    name = regular_account(args[0]).pw_name
    password = read_password()
    run_tool(["chpasswd"], f"{name}:{password}\n")
    print(f"The password of {name} was changed.")
    return 0


# --- Firewall -----------------------------------------------------------------------------

def ufw(*args):
    if not os.path.exists(UFW):
        raise HelperError("ufw is not installed")
    run_tool([UFW, *args])


def cmd_firewall_on(args):
    if args:
        raise HelperError("firewall-on takes no arguments")
    ufw("--force", "enable")
    print("The firewall is on: other computers can't connect to this one.")
    return 0


def cmd_firewall_off(args):
    if args:
        raise HelperError("firewall-off takes no arguments")
    ufw("disable")
    print("The firewall is off: other computers can connect to programs on this one.")
    return 0


def phones_profile_text():
    return (f"{PHONES_MARK}\n# deletes this file, with the firewall rules that use it.\n"
            f"[{PHONES_APP}]\ntitle=Phones (FlickOS)\n"
            "description=Pages, files and text from phones with the KDE Connect app (flickos-phone)\n"
            f"ports={PHONES_PORTS}\n")


def ours(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.readline().rstrip("\n") == PHONES_MARK
    except OSError:
        return False


def cmd_firewall_phones(args):
    if args not in (["on"], ["off"], ["refresh"]):
        raise HelperError("firewall-phones: give on, off or refresh")
    if args == ["refresh"]:
        return refresh_phones_profile()
    if not os.path.exists(UFW):
        raise HelperError("ufw is not installed")
    if os.path.exists(PHONES_PROFILE) and not ours(PHONES_PROFILE):
        raise HelperError(f"{PHONES_PROFILE} isn't FlickOS's; it was left as it is")
    if args == ["on"]:
        write_atomic(PHONES_PROFILE, phones_profile_text())
        # Rules from an older profile take its new ports; then add what's missing.
        ufw("app", "update", PHONES_APP)
        for network in PRIVATE_NETWORKS:
            ufw("allow", "from", network, "to", "any", "app", PHONES_APP)
        print("Phones on home and office networks can connect through the firewall.")
        return 0
    if os.path.exists(PHONES_PROFILE):
        for network in PRIVATE_NETWORKS:
            # A rule deleted by hand is already gone.
            with contextlib.suppress(HelperError):
                ufw("delete", "allow", "from", network, "to", "any", "app", PHONES_APP)
        os.unlink(PHONES_PROFILE)
    print("The firewall blocks phones again.")
    return 0


def refresh_phones_profile():
    """An upgrade (postinst): only a FlickOS profile that differs from this
    version's is rewritten, and only the rules that use it change."""
    if not os.path.exists(UFW) or not ours(PHONES_PROFILE):
        return 0
    with open(PHONES_PROFILE, encoding="utf-8") as f:
        if f.read() == phones_profile_text():
            return 0
    write_atomic(PHONES_PROFILE, phones_profile_text())
    ufw("app", "update", PHONES_APP)
    print("Phones let through the firewall now use this version's ports.")
    return 0


# --- Power button and lid ------------------------------------------------------------------

def rewrite_logind(text, key, action):
    """FlickOS's drop-in with key set to action ("default": left out) and its
    other settings kept; None when no setting is left."""
    lines = [line.strip() for line in text.splitlines()
             if line.strip() and not line.lstrip().startswith(("#", ";", "["))
             and not re.match(rf"^\s*{key}\s*=", line)]
    if action != "default":
        lines.append(f"{key}={action}")
    return LOGIND_HEADER + "\n".join(lines) + "\n" if lines else None


def cmd_power(args):
    if len(args) != 2 or args[0] not in POWER_SETTINGS or args[1] not in POWER_ACTIONS:
        raise HelperError(f"power: give one of {', '.join(POWER_SETTINGS)} and one of {', '.join(POWER_ACTIONS)}")
    setting, action = args
    try:
        with open(LOGIND_DROP_IN, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    new = rewrite_logind(text, POWER_SETTINGS[setting], action)
    if new is None:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(LOGIND_DROP_IN)
    else:
        os.makedirs(os.path.dirname(LOGIND_DROP_IN), mode=0o755, exist_ok=True)
        write_atomic(LOGIND_DROP_IN, new)
    run_tool(["systemctl", "reload", "systemd-logind"])
    print("Changed.")
    return 0


# --- Automatic updates ------------------------------------------------------------------

def updates_choices(text):
    """{setting: value} kept in FlickOS's drop-in (its mark line)."""
    for line in text.splitlines():
        if line.startswith(UPDATES_MARK):
            pairs = (word.partition("=") for word in line[len(UPDATES_MARK):].split())
            return {key: value for key, _, value in pairs if value in UPDATE_SETTINGS.get(key, ())}
    return {}


def updates_text(choices):
    """The apt.conf drop-in for the choices; None when there are none."""
    if not choices:
        return None
    lines = ["// Automatic updates, from Settings > Updates (flickos-control), which",
             "// rewrites this file. A file of your own that sorts later wins.",
             UPDATES_MARK + " " + " ".join(f"{key}={choices[key]}" for key in UPDATE_SETTINGS if key in choices)]
    if "auto" in choices:
        lines.append(f'APT::Periodic::Unattended-Upgrade "{1 if choices["auto"] == "yes" else 0}";')
    if "scope" in choices:
        lines += ["#clear Unattended-Upgrade::Origins-Pattern;", "Unattended-Upgrade::Origins-Pattern {"]
        lines += [f'        "{pattern}";' for pattern in UPDATE_SCOPES[choices["scope"]]] + ["};"]
    if "reboot" in choices:
        lines.append(f'Unattended-Upgrade::Automatic-Reboot "{"true" if choices["reboot"] == "idle" else "false"}";')
        if choices["reboot"] == "idle":
            lines.append('Unattended-Upgrade::Automatic-Reboot-WithUsers "false";')
    return "\n".join(lines) + "\n"


def refresh_updates():
    """An upgrade (postinst): FlickOS's drop-in is written again from the
    choices on its mark line, so a stored scope gets this version's origins
    (the community repository's, since 1.38). Nothing without the drop-in."""
    try:
        with open(UPDATES_DROP_IN, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        return 0
    new = updates_text(updates_choices(text))
    if new is not None and new != text:
        write_atomic(UPDATES_DROP_IN, new)
        print("Automatic updates use this version's list of repositories.")
    return 0


def cmd_updates(args):
    if args == ["refresh"]:
        return refresh_updates()
    if len(args) != 2 or args[0] not in UPDATE_SETTINGS or args[1] not in (*UPDATE_SETTINGS[args[0]], "default"):
        raise HelperError("updates: give refresh, or " + "; ".join(f"{key} {'|'.join(values)}|default"
                                                                    for key, values in UPDATE_SETTINGS.items()))
    setting, value = args
    try:
        with open(UPDATES_DROP_IN, encoding="utf-8") as f:
            choices = updates_choices(f.read())
    except FileNotFoundError:
        choices = {}
    if value == "default":
        choices.pop(setting, None)
    else:
        choices[setting] = value
    text = updates_text(choices)
    if text is None:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(UPDATES_DROP_IN)
    else:
        write_atomic(UPDATES_DROP_IN, text)
    print("Changed.")
    return 0


