# --- Languages ----------------------------------------------------------------------------

def supported_locales(path=None):
    """The UTF-8 locales glibc can generate."""
    found = set()
    with open(path or I18N_SUPPORTED, encoding="utf-8") as f:
        for line in f:
            parts = line.split()
            if len(parts) == 2 and parts[1] == "UTF-8":
                found.add(parts[0])
    return found


def enable_locale(text, locale):
    """/etc/locale.gen with locale's UTF-8 line on (uncommented or added);
    None if it already is."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        match = re.match(r"^\s*(#\s*)?(\S+)\s+(\S+)\s*$", line)
        if match and match.group(2) == locale and match.group(3) == "UTF-8":
            if not match.group(1):
                return None
            lines[i] = f"{locale} UTF-8"
            return "\n".join(lines) + "\n"
    return "\n".join(lines + [f"{locale} UTF-8"]) + "\n"


def cmd_locale_add(args):
    if len(args) != 1:
        raise HelperError("locale-add: give a locale, for example de_DE.UTF-8")
    locale = args[0]
    try:
        known = supported_locales()
    except OSError as error:
        raise HelperError(f"cannot read the languages (is the locales package installed?): {error}") from None
    if locale not in known:
        raise HelperError(f"unknown locale '{locale}': it must be a UTF-8 locale of {I18N_SUPPORTED}")
    try:
        with open(LOCALE_GEN, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    new = enable_locale(text, locale)
    if new is not None:
        write_atomic(LOCALE_GEN, new)
    try:
        subprocess.run(LOCALE_GEN_COMMAND, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.PIPE, text=True, timeout=600, check=True)
    except subprocess.CalledProcessError as error:
        raise HelperError(f"locale-gen: {error.stderr.strip() or f'exit code {error.returncode}'}") from None
    except subprocess.TimeoutExpired:
        raise HelperError("locale-gen took too long") from None
    print(f"{locale} can be used now.")
    return 0


# --- Software changes ----------------------------------------------------------

def apt_log_paths():
    """apt's log files, oldest first."""
    rotated = []
    for path in glob.glob(APT_LOG + ".*.gz"):
        number = path[len(APT_LOG) + 1:-3]
        if number.isdigit():
            rotated.append((int(number), path))
    return [path for _, path in sorted(rotated, reverse=True)] + [APT_LOG]


def parse_items(text):
    """(package, arch, version text) of a list line: "a:amd64 (1.0, automatic), ..."."""
    return PACKAGE_ITEM.findall(text)


def parse_apt_log(text):
    """The transactions of one log, oldest first: {"id", "command", "lists":
    {field: [(package, arch, version text)]}}. A stanza without Start-Date
    (cut off) is left out."""
    transactions = []
    for stanza in re.split(r"\n\s*\n", text):
        fields = {}
        for line in stanza.strip().splitlines():
            name, sep, value = line.partition(": ")
            if sep:
                fields[name.strip()] = value.strip()
        match = re.match(r"^(\d{4}-\d\d-\d\d)\s+(\d\d:\d\d:\d\d)$", fields.get("Start-Date", ""))
        if not match:
            continue
        transactions.append({"id": f"{match.group(1)}T{match.group(2)}",
                             "command": fields.get("Commandline", ""),
                             "lists": {field: parse_items(fields[field]) for field in LIST_FIELDS if field in fields}})
    return transactions


def read_apt_log(paths=None):
    transactions = []
    for path in paths or apt_log_paths():
        try:
            if path.endswith(".gz"):
                with gzip.open(path, "rt", encoding="utf-8", errors="replace") as f:
                    text = f.read()
            else:
                with open(path, encoding="utf-8", errors="replace") as f:
                    text = f.read()
        except (OSError, EOFError):
            continue
        transactions += parse_apt_log(text)
    return transactions


def live_system(path=None):
    try:
        with open(path or CMDLINE, encoding="utf-8") as f:
            return "boot=live" in f.read().split()
    except OSError:
        return False


def boot_time(path=None):
    with open(path or PROC_UPTIME, encoding="utf-8") as f:
        uptime = float(f.read().split()[0])
    return datetime.datetime.now() - datetime.timedelta(seconds=uptime)


def when(transaction):
    return datetime.datetime.fromisoformat(transaction["id"])


def after_installation(transactions, live=None):
    """The transactions a user made: in the live session, those since it
    started (its log holds the image's own build); on an installed system,
    those after the installer removed itself."""
    live = live_system() if live is None else live
    if live:
        started = boot_time()
        return [t for t in transactions if when(t) >= started]
    end = None
    for transaction in transactions:
        removed = transaction["lists"].get("Remove", []) + transaction["lists"].get("Purge", [])
        if any(name in INSTALLER_PACKAGES for name, _, _ in removed):
            end = when(transaction)
    if end is None:
        return transactions
    return [t for t in transactions if (when(t) - end).total_seconds() > INSTALL_SECONDS]


def native_arch():
    return subprocess.run(["dpkg", "--print-architecture"], capture_output=True, text=True,
                          check=True).stdout.strip()


def package_name(name, arch, native):
    """The name apt and dpkg-query use: no suffix for the native and "all"."""
    return name if arch in (native, "all") else f"{name}:{arch}"


def undo_marker(command):
    match = re.search(re.escape(UNDO_OPTION) + r"=(\S+)", command)
    return match.group(1) if match and TRANSACTION_ID.match(match.group(1)) else None


def describe_transaction(transaction, native):
    """What a transaction did, and whether it can be undone:
    {"id", "kind": install|remove|update|mixed, "packages": asked for,
    "automatic": brought in, "upgraded": count, "purged", "autoremove",
    "undo_of": the ID this transaction undid (or None), "undoable", "why": why not}."""
    lists = transaction["lists"]
    installs = [(package_name(n, a, native), "automatic" in v) for n, a, v in lists.get("Install", [])]
    asked = [name for name, auto in installs if not auto]
    automatic = [name for name, auto in installs if auto]
    removed = [package_name(n, a, native) for n, a, _ in lists.get("Remove", []) + lists.get("Purge", [])]
    upgraded = sum(len(lists.get(field, [])) for field in ("Upgrade", "Downgrade", "Reinstall"))
    autoremove = bool(re.search(r"(^|\s)(--auto-?remove|autoremove|autopurge)(\s|$)", transaction["command"]))
    if asked and not removed:
        kind, packages = "install", asked
    elif removed and not installs:
        kind, packages = "remove", removed
    elif not removed and not asked:
        kind, packages = "update", automatic
    else:
        kind, packages = "mixed", asked + removed
    why = None
    if kind == "update":
        why = "Updates can't be undone: Debian keeps only the newest version of a package."
    elif kind == "mixed":
        why = "This change both installed and removed packages. Undo it in a terminal with apt."
    elif autoremove:
        why = "These packages were no longer needed; install again the ones you want."
    return {"id": transaction["id"], "kind": kind, "packages": packages, "automatic": automatic,
            "upgraded": upgraded, "purged": bool(lists.get("Purge")), "autoremove": autoremove,
            "undo_of": undo_marker(transaction["command"]), "undoable": why is None, "why": why}


def software_changes(days=HISTORY_DAYS, transactions=None, live=None, now=None):
    transactions = after_installation(read_apt_log() if transactions is None else transactions, live)
    since = (now or datetime.datetime.now()) - datetime.timedelta(days=days)
    native = native_arch()
    return [dict(describe_transaction(t, native), time=t["id"]) for t in transactions if when(t) >= since]


def find_transaction(transaction_id, transactions=None, live=None):
    if not TRANSACTION_ID.match(transaction_id or ""):
        raise HelperError(f"not a change id: '{transaction_id}'")
    everything = read_apt_log() if transactions is None else transactions
    matching = [t for t in everything if t["id"] == transaction_id]
    if not matching:
        raise HelperError(f"There is no change {transaction_id} in apt's history.")
    if len(matching) > 1:
        raise HelperError(f"apt's history has more than one change at {transaction_id}. Undo it in a terminal.")
    if matching[0] not in after_installation(everything, live):
        raise HelperError("This change was part of installing the system and can't be undone here.")
    return matching[0]


def simulate(args):
    """apt-get's plan: (packages it would remove, packages it would install).
    Raises HelperError with apt's own errors."""
    result = subprocess.run([APT_GET, "-s", "-q", *args], capture_output=True, text=True, timeout=300,
                            env=dict(os.environ, LC_ALL="C.UTF-8"), check=False)
    if result.returncode != 0:
        errors = [line[3:] for line in result.stderr.splitlines() if line.startswith("E: ")]
        raise HelperError("apt: " + (" ".join(errors) or f"exit code {result.returncode}"))
    removed = set(re.findall(r"^Remv (\S+)", result.stdout, re.M))
    installed = set(re.findall(r"^Inst (\S+)", result.stdout, re.M))
    return removed, installed


def installed_packages(names):
    """The ones of names that are installed now."""
    if not names:
        return set()
    result = subprocess.run(["dpkg-query", "-W", "-f", "${binary:Package}\t${db:Status-Status}\n", *names],
                            capture_output=True, text=True, check=False)
    return {line.split("\t")[0] for line in result.stdout.splitlines() if line.endswith("\tinstalled")}


def desktop_dependencies():
    """flickos-desktop and every package in its Depends (alternatives too)."""
    result = subprocess.run(["dpkg-query", "-W", "-f", "${Depends}", DESKTOP_PACKAGE],
                            capture_output=True, text=True, check=False)
    if result.returncode != 0:
        return set()
    names = {DESKTOP_PACKAGE}
    for part in re.split(r"[,|]", result.stdout):
        name = re.sub(r"\(.*?\)|\[.*?\]|:any", "", part).strip()
        if name:
            names.add(name)
    return names


def base_name(package):
    return package.split(":")[0]


def undo_plan(transaction, simulate=simulate, installed=installed_packages, protected=desktop_dependencies):
    """What undoing a transaction does: {"id", "action": remove|install,
    "args": apt-get's arguments, "remove": [...], "install": [...],
    "upgraded": updates that stay, "purged"}. Raises HelperError when it
    can't be undone, saying why."""
    change = describe_transaction(transaction, native_arch())
    if not change["undoable"]:
        raise HelperError(change["why"])
    packages = change["packages"]
    if change["kind"] == "install":
        present = sorted(installed(packages))
        if not present:
            raise HelperError("Nothing to undo: none of these packages is installed now.")
        # With the packages it brought in, named: --autoremove would also take
        # whatever else is unneeded. One another package still needs makes
        # apt remove that package too, and then only the asked-for ones go.
        brought = sorted(installed(change["automatic"]))
        args = ["remove", *present, *brought]
        removed, _ = simulate(args)
        if not removed <= set(present) | set(brought):
            args = ["remove", *present]
            removed, _ = simulate(args)
            if not removed <= set(present):
                others = sorted(removed - set(present))
                raise HelperError(f"Undoing this would also remove {', '.join(others)}, so nothing was changed.")
        needed = sorted(base_name(p) for p in removed if base_name(p) in protected())
        if needed:
            raise HelperError(f"Undoing this would remove {', '.join(needed)}, which the FlickOS desktop needs, "
                              "so nothing was changed.")
        return {"id": change["id"], "action": "remove", "args": args, "remove": sorted(removed), "install": [],
                "upgraded": change["upgraded"], "purged": False}
    missing = sorted(set(packages) - installed(packages))
    if not missing:
        raise HelperError("Nothing to undo: these packages are installed again.")
    live_only = sorted(p for p in missing if base_name(p) in LIVE_PACKAGES)
    if live_only:
        raise HelperError(f"Undoing this would install {', '.join(live_only)}, which only the live session uses, "
                          "so nothing was changed.")
    args = ["install", *missing]
    removed, new = simulate(args)
    if removed:
        raise HelperError(f"Undoing this would remove {', '.join(sorted(removed))}, so nothing was changed.")
    return {"id": change["id"], "action": "install", "args": args, "remove": [], "install": sorted(new),
            "upgraded": change["upgraded"], "purged": change["purged"]}


def cmd_packages_list(args):
    if len(args) > 1 or (args and not args[0].isdigit()):
        raise HelperError("usage: packages-list [DAYS]")
    print(json.dumps(software_changes(int(args[0]) if args else HISTORY_DAYS), indent=1))
    return 0


def cmd_packages_plan(args):
    if len(args) != 1:
        raise HelperError("usage: packages-plan ID")
    print(json.dumps(undo_plan(find_transaction(args[0])), indent=1))
    return 0


def cmd_packages_undo(args):
    if len(args) != 1:
        raise HelperError("usage: packages-undo ID")
    plan = undo_plan(find_transaction(args[0]))
    command = [APT_GET, "-y", "-q", "-o", f"{UNDO_OPTION}={plan['id']}",
               "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold", *plan["args"]]
    result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                            timeout=APT_SECONDS, env=dict(os.environ, DEBIAN_FRONTEND="noninteractive"),
                            check=False)
    if result.returncode != 0:
        text = result.stdout + result.stderr
        if "Could not get lock" in text or "Unable to acquire the dpkg frontend lock" in text:
            raise HelperError("Software is being installed or updated right now. Try again in a few minutes.")
        if "Failed to fetch" in text or "Unable to fetch" in text:
            raise HelperError(f"{', '.join(plan['install'])} can't be downloaded. Check the network connection "
                              "and try again.")
        errors = [line[3:] for line in result.stderr.splitlines() if line.startswith("E: ")]
        raise HelperError("apt: " + (" ".join(errors) or f"exit code {result.returncode}"))
    if plan["action"] == "remove":
        print(f"Removed: {', '.join(plan['remove'])}.")
    else:
        print(f"Installed again: {', '.join(plan['install'])}.")
    return 0


VERBS = {"keyboard": cmd_keyboard, "autologin-on": cmd_autologin_on, "autologin-off": cmd_autologin_off,
         "user-add": cmd_user_add, "user-remove": cmd_user_remove, "user-admin": cmd_user_admin,
         "user-password": cmd_user_password, "firewall-on": cmd_firewall_on, "firewall-off": cmd_firewall_off,
         "firewall-phones": cmd_firewall_phones,
         "power": cmd_power, "locale-add": cmd_locale_add, "updates": cmd_updates,
         "firefox-memory": cmd_firefox_memory,
         "packages-undo": cmd_packages_undo, "packages-list": cmd_packages_list, "packages-plan": cmd_packages_plan}
# These only read (apt's log, and apt-get -s): no root needed.
READ_ONLY = ("packages-list", "packages-plan")


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if not argv or argv[0] not in VERBS:
        print(f"usage: control-helper {{{','.join(VERBS)}}} ARGS...", file=sys.stderr)
        return 2
    if os.geteuid() != 0 and argv[0] not in READ_ONLY:
        print("control-helper: must run as root (through pkexec)", file=sys.stderr)
        return 1
    try:
        return VERBS[argv[0]](argv[1:])
    except (HelperError, OSError, subprocess.SubprocessError) as error:
        print(f"control-helper: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
