# --- 32-bit programs ----------------------------------------------------------------------

def foreign_architectures():
    result = subprocess.run([DPKG, "--print-foreign-architectures"], capture_output=True, text=True,
                            timeout=60, check=True)
    return result.stdout.split()


def arch_packages(arch):
    """({installed package}, {package with only its config files left}) of arch."""
    result = subprocess.run([DPKG_QUERY, "-W", "-f", "${db:Status-Abbrev}\t${binary:Package}\t${Architecture}\n"],
                            capture_output=True, text=True, timeout=60, check=True)
    installed, configs = set(), set()
    for line in result.stdout.splitlines():
        status, _, rest = line.partition("\t")
        name, _, package_arch = rest.partition("\t")
        if package_arch != arch or status[1:2] == "n":
            continue
        (configs if status[1:2] == "c" else installed).add(name)
    return installed, configs


def cmd_i386_on(args):
    if args:
        raise HelperError("i386-on takes no arguments")
    if FOREIGN_ARCH not in foreign_architectures():
        run_tool([DPKG, "--add-architecture", FOREIGN_ARCH])
    print("32-bit programs can be installed.")
    return 0


def manual_packages():
    """The packages someone asked for (apt-mark showmanual: name, name:arch for a foreign one)."""
    result = subprocess.run([APT_MARK, "showmanual"], capture_output=True, text=True, timeout=60, check=True)
    return set(result.stdout.split())


def cmd_i386_off(args):
    if args:
        raise HelperError("i386-off takes no arguments")
    if FOREIGN_ARCH not in foreign_architectures():
        print("32-bit programs can't be installed.")
        return 0
    installed, configs = arch_packages(FOREIGN_ARCH)
    asked = sorted(installed & manual_packages())
    if asked:
        more = f" and {len(asked) - 3} more" if len(asked) > 3 else ""
        raise HelperError(f"32-bit packages are still installed ({', '.join(asked[:3])}{more}): "
                          f"remove them first")
    if installed:
        removed, _ = simulate(["remove", *sorted(installed)])        # -s purge prints Purg, not Remv
        others = sorted(name for name in removed if not name.endswith(f":{FOREIGN_ARCH}"))
        if others:
            raise HelperError(f"removing the 32-bit packages left would also remove {', '.join(others)}")
        result = subprocess.run([APT_GET, "-y", "-q", "--allow-remove-essential", "purge", *sorted(installed)],
                                stdin=subprocess.DEVNULL,
                                capture_output=True, text=True, timeout=APT_SECONDS,
                                env=dict(os.environ, DEBIAN_FRONTEND="noninteractive"), check=False)
        if result.returncode != 0:
            errors = [line[3:] for line in result.stderr.splitlines() if line.startswith("E: ")]
            raise HelperError("apt: " + (" ".join(errors) or f"exit code {result.returncode}"))
        configs = arch_packages(FOREIGN_ARCH)[1]
    if configs:
        run_tool([DPKG, "--purge", *sorted(configs)])
    run_tool([DPKG, "--remove-architecture", FOREIGN_ARCH])
    print("32-bit programs can't be installed any more.")
    return 0


# --- Languages ----------------------------------------------------------------------------

def supported_locales(path=None):
    """The UTF-8 locales glibc can generate."""
    found = set()
    with open(path or I18N_SUPPORTED, encoding="utf-8") as f:
        for line in f:
            parts = line.split()
            if len(parts) == 2 and parts[1] == "UTF-8":
                found.add(parts[0])
    return found


def locale_names(path=None):
    """Every locale of SUPPORTED (any charset) and the built-in ones, by
    locale_word: what a locale variable may name."""
    found = {locale_word(name) for name in BUILT_IN_LOCALES}
    with open(path or I18N_SUPPORTED, encoding="utf-8") as f:
        for line in f:
            parts = line.split()
            if len(parts) == 2:
                found.add(locale_word(parts[0]))
    return found


def locale_word(name):
    """A locale name as glibc compares it: en_US.utf8 is en_US.UTF-8."""
    base, dot, rest = name.partition(".")
    if not dot:
        return name
    charset, at, modifier = rest.partition("@")
    return base + "." + charset.lower().replace("-", "") + at + modifier


def check_locale_settings(args, known):
    """{NAME: VALUE} of `locale`'s arguments, in LOCALE_NAMES' order. Raises HelperError."""
    settings = {}
    for arg in args:
        name, equals, value = arg.partition("=")
        if not equals or name not in LOCALE_NAMES:
            raise HelperError(f"give NAME=VALUE with NAME one of {', '.join(LOCALE_NAMES)}, not '{arg}'")
        if name in settings:
            raise HelperError(f"{name} is given twice")
        if name == "LANGUAGE":
            if not LANGUAGE_LIST.fullmatch(value):
                raise HelperError(f"LANGUAGE: give names separated by colons, not '{value}'")
        elif not LOCALE_WORD.fullmatch(value) or locale_word(value) not in known:
            raise HelperError(f"unknown locale '{value}': it must be one of {I18N_SUPPORTED}")
        settings[name] = value
    if "LANG" not in settings:
        raise HelperError("give LANG=LOCALE, and any other variables")
    return {name: settings[name] for name in LOCALE_NAMES if name in settings}


def cmd_locale(args):
    try:
        known = locale_names()
    except OSError as error:
        raise HelperError(f"cannot read the languages (is the locales package installed?): {error}") from None
    settings = check_locale_settings(args, known)
    text = LOCALE_HEADER + "".join(f"{name}={value}\n" for name, value in settings.items())
    # Write each file the system reads, where the links lead (a link stays a link).
    paths = []
    for path in (LOCALE_CONF, LOCALE_DEFAULTS):
        real = os.path.realpath(path)
        if os.path.exists(path) and real not in paths:
            paths.append(real)
    for path in paths or [LOCALE_CONF]:
        write_atomic(path, text)
    print("The login screen uses it from its next start, accounts without a choice of their own from "
          "their next login.")
    return 0


def enable_locale(text, locale):
    """/etc/locale.gen with locale's UTF-8 line on (uncommented or added);
    None if it already is."""
    lines = text.splitlines()
    for i, line in enumerate(lines):
        match = re.match(r"^\s*(#\s*)?(\S+)\s+(\S+)\s*$", line)
        if match and match.group(2) == locale and match.group(3) == "UTF-8":
            if not match.group(1):
                return None
            lines[i] = f"{locale} UTF-8"
            return "\n".join(lines) + "\n"
    return "\n".join(lines + [f"{locale} UTF-8"]) + "\n"


def cmd_locale_add(args):
    if len(args) != 1:
        raise HelperError("locale-add: give a locale, for example de_DE.UTF-8")
    locale = args[0]
    try:
        known = supported_locales()
    except OSError as error:
        raise HelperError(f"cannot read the languages (is the locales package installed?): {error}") from None
    if locale not in known:
        raise HelperError(f"unknown locale '{locale}': it must be a UTF-8 locale of {I18N_SUPPORTED}")
    try:
        with open(LOCALE_GEN, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        text = ""
    new = enable_locale(text, locale)
    if new is not None:
        write_atomic(LOCALE_GEN, new)
    try:
        subprocess.run(LOCALE_GEN_COMMAND, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.PIPE, text=True, timeout=600, check=True)
    except subprocess.CalledProcessError as error:
        raise HelperError(f"locale-gen: {error.stderr.strip() or f'exit code {error.returncode}'}") from None
    except subprocess.TimeoutExpired:
        raise HelperError("locale-gen took too long") from None
    print(f"{locale} can be used now.")
    return 0


# --- Software changes ----------------------------------------------------------

def apt_log_paths():
    """apt's log files, oldest first."""
    rotated = []
    for path in glob.glob(APT_LOG + ".*.gz"):
        number = path[len(APT_LOG) + 1:-3]
        if number.isdigit():
            rotated.append((int(number), path))
    return [path for _, path in sorted(rotated, reverse=True)] + [APT_LOG]


def parse_items(text):
    """(package, arch, version text) of a list line: "a:amd64 (1.0, automatic), ..."."""
    return PACKAGE_ITEM.findall(text)


def parse_apt_log(text):
    """The transactions of one log, oldest first: {"id", "command", "lists":
    {field: [(package, arch, version text)]}}. A stanza without Start-Date
    (cut off) is left out."""
    transactions = []
    for stanza in re.split(r"\n\s*\n", text):
        fields = {}
        for line in stanza.strip().splitlines():
            name, sep, value = line.partition(": ")
            if sep:
                fields[name.strip()] = value.strip()
        match = re.match(r"^(\d{4}-\d\d-\d\d)\s+(\d\d:\d\d:\d\d)$", fields.get("Start-Date", ""))
        if not match:
            continue
        transactions.append({"id": f"{match.group(1)}T{match.group(2)}",
                             "command": fields.get("Commandline", ""),
                             "lists": {field: parse_items(fields[field]) for field in LIST_FIELDS if field in fields}})
    return transactions


def read_apt_log(paths=None):
    transactions = []
    for path in paths or apt_log_paths():
        try:
            if path.endswith(".gz"):
                with gzip.open(path, "rt", encoding="utf-8", errors="replace") as f:
                    text = f.read()
            else:
                with open(path, encoding="utf-8", errors="replace") as f:
                    text = f.read()
        except (OSError, EOFError):
            continue
        transactions += parse_apt_log(text)
    return transactions


def live_system(path=None):
    try:
        with open(path or CMDLINE, encoding="utf-8") as f:
            return "boot=live" in f.read().split()
    except OSError:
        return False


def boot_time(path=None):
    with open(path or PROC_UPTIME, encoding="utf-8") as f:
        uptime = float(f.read().split()[0])
    return datetime.datetime.now() - datetime.timedelta(seconds=uptime)


def when(transaction):
    return datetime.datetime.fromisoformat(transaction["id"])


def after_installation(transactions, live=None):
    """The transactions a user made: in the live session, those since it
    started (its log holds the image's own build); on an installed system,
    those after the installer removed itself."""
    live = live_system() if live is None else live
    if live:
        started = boot_time()
        return [t for t in transactions if when(t) >= started]
    end = None
    for transaction in transactions:
        removed = transaction["lists"].get("Remove", []) + transaction["lists"].get("Purge", [])
        if any(name in INSTALLER_PACKAGES for name, _, _ in removed):
            end = when(transaction)
    if end is None:
        return transactions
    return [t for t in transactions if (when(t) - end).total_seconds() > INSTALL_SECONDS]


def native_arch():
    return subprocess.run(["dpkg", "--print-architecture"], capture_output=True, text=True,
                          check=True).stdout.strip()


def package_name(name, arch, native):
    """The name apt and dpkg-query use: no suffix for the native and "all"."""
    return name if arch in (native, "all") else f"{name}:{arch}"


def undo_marker(command):
    match = re.search(re.escape(UNDO_OPTION) + r"=(\S+)", command)
    return match.group(1) if match and TRANSACTION_ID.fullmatch(match.group(1)) else None


def describe_transaction(transaction, native):
    """What a transaction did, and whether it can be undone:
    {"id", "kind": install|remove|update|mixed, "packages": asked for,
    "automatic": brought in, "upgraded": count, "purged", "autoremove",
    "undo_of": the ID this transaction undid (or None), "undoable", "why": why not}."""
    lists = transaction["lists"]
    installs = [(package_name(n, a, native), "automatic" in v) for n, a, v in lists.get("Install", [])]
    asked = [name for name, auto in installs if not auto]
    automatic = [name for name, auto in installs if auto]
    removed = [package_name(n, a, native) for n, a, _ in lists.get("Remove", []) + lists.get("Purge", [])]
    upgraded = sum(len(lists.get(field, [])) for field in ("Upgrade", "Downgrade", "Reinstall"))
    autoremove = bool(re.search(r"(^|\s)(--auto-?remove|autoremove|autopurge)(\s|$)", transaction["command"]))
    if asked and not removed:
        kind, packages = "install", asked
    elif removed and not installs:
        kind, packages = "remove", removed
    elif not removed and not asked:
        kind, packages = "update", automatic
    else:
        kind, packages = "mixed", asked + removed
    why = None
    if kind == "update":
        why = "Updates can't be undone: Debian keeps only the newest version of a package."
    elif kind == "mixed":
        why = "This change both installed and removed packages. Undo it in a terminal with apt."
    elif autoremove:
        why = "These packages were no longer needed; install again the ones you want."
    return {"id": transaction["id"], "kind": kind, "packages": packages, "automatic": automatic,
            "upgraded": upgraded, "purged": bool(lists.get("Purge")), "autoremove": autoremove,
            "undo_of": undo_marker(transaction["command"]), "undoable": why is None, "why": why}


def software_changes(days=HISTORY_DAYS, transactions=None, live=None, now=None):
    transactions = after_installation(read_apt_log() if transactions is None else transactions, live)
    since = (now or datetime.datetime.now()) - datetime.timedelta(days=days)
    native = native_arch()
    return [dict(describe_transaction(t, native), time=t["id"]) for t in transactions if when(t) >= since]


def find_transaction(transaction_id, transactions=None, live=None):
    if not TRANSACTION_ID.fullmatch(transaction_id or ""):
        raise HelperError(f"not a change id: '{transaction_id}'")
    everything = read_apt_log() if transactions is None else transactions
    matching = [t for t in everything if t["id"] == transaction_id]
    if not matching:
        raise HelperError(f"There is no change {transaction_id} in apt's history.")
    if len(matching) > 1:
        raise HelperError(f"apt's history has more than one change at {transaction_id}. Undo it in a terminal.")
    if matching[0] not in after_installation(everything, live):
        raise HelperError("This change was part of installing the system and can't be undone here.")
    return matching[0]


def simulate(args):
    """apt-get's plan: (packages it would remove, packages it would install).
    Raises HelperError with apt's own errors."""
    result = subprocess.run([APT_GET, "-s", "-q", *args], capture_output=True, text=True, timeout=300,
                            env=dict(os.environ, LC_ALL="C.UTF-8"), check=False)
    if result.returncode != 0:
        errors = [line[3:] for line in result.stderr.splitlines() if line.startswith("E: ")]
        raise HelperError("apt: " + (" ".join(errors) or f"exit code {result.returncode}"))
    removed = set(re.findall(r"^Remv (\S+)", result.stdout, re.M))
    installed = set(re.findall(r"^Inst (\S+)", result.stdout, re.M))
    return removed, installed


def installed_packages(names):
    """The ones of names that are installed now."""
    if not names:
        return set()
    result = subprocess.run(["dpkg-query", "-W", "-f", "${binary:Package}\t${db:Status-Status}\n", *names],
                            capture_output=True, text=True, check=False)
    return {line.split("\t")[0] for line in result.stdout.splitlines() if line.endswith("\tinstalled")}


def desktop_dependencies():
    """flickos-desktop and every package in its Depends (alternatives too)."""
    result = subprocess.run(["dpkg-query", "-W", "-f", "${Depends}", DESKTOP_PACKAGE],
                            capture_output=True, text=True, check=False)
    if result.returncode != 0:
        return set()
    names = {DESKTOP_PACKAGE}
    for part in re.split(r"[,|]", result.stdout):
        name = re.sub(r"\(.*?\)|\[.*?\]|:any", "", part).strip()
        if name:
            names.add(name)
    return names


def base_name(package):
    return package.split(":")[0]


KERNEL_PACKAGE = re.compile(r"^linux-(image|headers)-")


def package_depends(names):
    """{package: the names in its Depends (alternatives too)}, for the
    installed ones of names."""
    if not names:
        return {}
    result = subprocess.run(["dpkg-query", "-W", "-f", "${binary:Package}\t${Depends}\n", *names],
                            capture_output=True, text=True, check=False)
    found = {}
    for line in result.stdout.splitlines():
        name, _, depends = line.partition("\t")
        found[name] = {re.sub(r"\(.*?\)|\[.*?\]|:any", "", part).strip() for part in re.split(r"[,|]", depends)}
    return found


def running_kernel():
    return os.uname().release


def kernel_dependencies(present, installed, depends):
    """The installed kernel images and headers that the kernel meta-packages
    among PRESENT depend on now, except the shared "-common" headers (a
    flavour's other headers need those; apt autoremove takes them later)."""
    metas = [p for p in present if KERNEL_PACKAGE.match(base_name(p))]
    wanted = {name for names in depends(metas).values() for name in names
              if KERNEL_PACKAGE.match(name) and "-common" not in name}
    return sorted(installed(sorted(wanted)) - set(present))


def undo_plan(transaction, simulate=simulate, installed=installed_packages, protected=desktop_dependencies,
              depends=package_depends, running=running_kernel):
    """What undoing a transaction does: {"id", "action": remove|install,
    "args": apt-get's arguments, "remove": [...], "install": [...],
    "upgraded": updates that stay, "purged", "kept": kernels another package
    still needs, so they stay}. Raises HelperError when it can't be undone,
    saying why."""
    change = describe_transaction(transaction, native_arch())
    if not change["undoable"]:
        raise HelperError(change["why"])
    packages = change["packages"]
    if change["kind"] == "install":
        present = sorted(installed(packages))
        if not present:
            raise HelperError("Nothing to undo: none of these packages is installed now.")
        # With the packages it brought in, named: --autoremove would also take
        # whatever else is unneeded. One another package still needs makes
        # apt remove that package too, and then only the asked-for ones go.
        brought = sorted(installed(change["automatic"]))
        # A kernel meta-package is the exception: its dependency moves to the
        # newest kernel with every update, so the log names a kernel that is
        # long gone. What it depends on now goes too (kept: see below).
        kernels = kernel_dependencies(present, installed, depends)
        running_image = f"linux-image-{running()}"
        if running_image in {base_name(p) for p in (*present, *brought, *kernels)}:
            raise HelperError(f"{running_image} is the kernel this computer is running. Restart on another "
                              "kernel (choose it in the boot menu), then undo this. Nothing was changed.")
        previous = None
        for names in (present + brought + kernels, present + brought, present):
            names = list(dict.fromkeys(names))
            if names == previous:
                continue
            previous = names
            args = ["remove", *names]
            removed, _ = simulate(args)
            if removed <= set(names):
                break
        else:
            others = sorted(removed - set(present))
            raise HelperError(f"Undoing this would also remove {', '.join(others)}, so nothing was changed.")
        kept = [p for p in kernels if p not in args]
        needed = sorted(base_name(p) for p in removed if base_name(p) in protected())
        if needed:
            raise HelperError(f"Undoing this would remove {', '.join(needed)}, which the FlickOS desktop needs, "
                              "so nothing was changed.")
        return {"id": change["id"], "action": "remove", "args": args, "remove": sorted(removed), "install": [],
                "upgraded": change["upgraded"], "purged": False, "kept": kept}
    missing = sorted(set(packages) - installed(packages))
    if not missing:
        raise HelperError("Nothing to undo: these packages are installed again.")
    live_only = sorted(p for p in missing if base_name(p) in LIVE_PACKAGES)
    if live_only:
        raise HelperError(f"Undoing this would install {', '.join(live_only)}, which only the live session uses, "
                          "so nothing was changed.")
    args = ["install", *missing]
    removed, new = simulate(args)
    if removed:
        raise HelperError(f"Undoing this would remove {', '.join(sorted(removed))}, so nothing was changed.")
    return {"id": change["id"], "action": "install", "args": args, "remove": [], "install": sorted(new),
            "upgraded": change["upgraded"], "purged": change["purged"]}


def cmd_packages_list(args):
    if len(args) > 1 or (args and not args[0].isdigit()):
        raise HelperError("usage: packages-list [DAYS]")
    print(json.dumps(software_changes(int(args[0]) if args else HISTORY_DAYS), indent=1))
    return 0


def cmd_packages_plan(args):
    if len(args) != 1:
        raise HelperError("usage: packages-plan ID")
    print(json.dumps(undo_plan(find_transaction(args[0])), indent=1))
    return 0


def cmd_packages_undo(args):
    if len(args) != 1:
        raise HelperError("usage: packages-undo ID")
    plan = undo_plan(find_transaction(args[0]))
    run_apt(plan["args"], ", ".join(plan["install"]), options=("-o", f"{UNDO_OPTION}={plan['id']}"))
    if plan["action"] == "remove":
        print(f"Removed: {', '.join(plan['remove'])}.")
        if plan.get("kept"):
            print(f"Still installed, because something else needs it: {', '.join(plan['kept'])}.")
    else:
        print(f"Installed again: {', '.join(plan['install'])}.")
    return 0


# --- Bought apps (the FlickOS store) -------------------------------------------------------

# docs/design/flickos-store.md, ADR-004. The key is apt's login for the
# store's repository and lives only in STORE_AUTH (root, 0600); PURCHASES_FILE
# says what it holds, for everyone, without it. flickos-control has the same
# STORE_URL and PURCHASES_FILE (tests compare them).
STORE_URL = "https://store.flickos.org"
STORE_AUTH = "/etc/apt/auth.conf.d/flickos-store.conf"
STORE_SOURCES = "/etc/apt/sources.list.d/flickos-store.sources"
STORE_PINS = "/etc/apt/preferences.d/flickos-store"
PURCHASES_FILE = "/var/lib/flickos-control/purchases.json"
STORE_KEYRING = "/usr/share/keyrings/flickos-archive-keyring.asc"     # flickos-archive-keyring's
FLICKOS_RELEASE = "/usr/lib/flickos-release"    # FLICKOS_DEBIAN: the store's suite is FLICKOS_DEBIAN-store
OS_RELEASE = "/etc/os-release"
STORE_ORIGIN, STORE_LABEL = "FlickOS", "FlickOS Store"      # the store repository's Release (new-repo.sh)
# The first line of the three files: they are FlickOS's. No word of apt's
# login format (machine, login, password) in it: auth.conf ignores the rest.
STORE_MARK = "# FlickOS Store: Settings > Updates (flickos-control) writes and deletes this file."
# The store's keys (server/store/store.js makeKey): 32 bytes in base32, 13
# groups of four joined by dashes. Case, spaces and dashes typed don't matter.
KEY_PATTERN = re.compile(r"^[a-z2-7]{4}(-[a-z2-7]{4}){12}$")
KEY_CHARS = 52
KEY_LINE_MAX = 200
PRODUCT = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")
DEB_PACKAGE = re.compile(r"^[a-z0-9][a-z0-9+.-]{1,80}$")
RELEASE_NAME = re.compile(r"^[a-z]+$")
STORE_SECONDS = 20                  # each request to the store
CHECK_SECONDS = 20 * 3600           # purchases-check asks the store at most this often
ANSWER_BYTES = 65536
APT_HELPER = "/usr/lib/apt/apt-helper"
LIST_SUFFIXES = ("", ".lz4", ".gz", ".xz", ".zst", ".bz2", ".lzma")     # apt's KeepCompressed lists
KEY_REFUSED = "This key isn't valid. Check that it was copied whole."
STORE_UNREACHABLE = "The FlickOS store can't be reached. Check the network connection and try again."
KEY_TURNED_OFF = ("Your FlickOS Store key was turned off, so the apps bought with it no longer update. "
                  "Remove the key in Settings > Updates.")


class StoreUnreachable(HelperError):
    pass


def normal_key(text):
    """The key as the store writes it, or None when it isn't one."""
    plain = re.sub(r"[\s-]", "", text or "").lower()
    if len(plain) != KEY_CHARS or not re.fullmatch(r"[a-z2-7]+", plain):
        return None
    key = "-".join(plain[i:i + 4] for i in range(0, KEY_CHARS, 4))
    return key if KEY_PATTERN.fullmatch(key) else None


def read_key(stream=None):
    """The key: the first line of standard input."""
    line = (stream or sys.stdin).readline(KEY_LINE_MAX + 2)
    key = normal_key(line) if len(line.rstrip("\n")) <= KEY_LINE_MAX else None
    if not line.strip():
        raise HelperError("no key given (on standard input)")
    if key is None:
        raise HelperError(KEY_REFUSED)
    return key


def masked(key):
    """What may be shown of a key: its last four characters."""
    return key[-4:]


def store_release():
    """The Debian release the store's suite is named after."""
    for path, name in ((FLICKOS_RELEASE, "FLICKOS_DEBIAN"), (OS_RELEASE, "VERSION_CODENAME")):
        with contextlib.suppress(OSError):
            with open(path, encoding="utf-8") as f:
                for line in f:
                    match = re.match(rf'^{name}="?([a-z]+)"?\s*$', line.strip())
                    if match and RELEASE_NAME.fullmatch(match.group(1)):
                        return match.group(1)
    raise HelperError(f"the Debian release isn't known ({FLICKOS_RELEASE} and {OS_RELEASE} don't name it)")


def store_request(path, key=None, body=None):
    """(HTTP status, JSON answer) of the store's API; the key in the login,
    the body as JSON, never in the address. Raises StoreUnreachable."""
    data = None if body is None else json.dumps(body).encode()
    request = urllib.request.Request(STORE_URL + path, data=data, method="GET" if data is None else "POST",
                                     headers={"Accept": "application/json", "User-Agent": "flickos-control"})
    if data is not None:
        request.add_header("Content-Type", "application/json")
    if key is not None:
        # Unredirected: a redirect never carries the key to another address.
        request.add_unredirected_header("Authorization",
                                        "Basic " + base64.b64encode(f"key:{key}".encode()).decode())
    try:
        with urllib.request.urlopen(request, timeout=STORE_SECONDS) as response:
            status, text = response.status, response.read(ANSWER_BYTES)
    except urllib.error.HTTPError as error:
        status, text = error.code, error.read(ANSWER_BYTES)
    except (urllib.error.URLError, OSError, ValueError):
        raise StoreUnreachable(STORE_UNREACHABLE) from None
    try:
        answer = json.loads(text)
    except ValueError:
        answer = None
    return status, answer if isinstance(answer, dict) else {}


def holdings(answer):
    """(products, packages) of a valid answer of /v1/key or /v1/link, or None."""
    products, packages = answer.get("products"), answer.get("packages")
    if (answer.get("status") != "valid" or not isinstance(products, list) or not isinstance(packages, list)
            or not all(isinstance(p, str) and PRODUCT.fullmatch(p) for p in products)
            or not all(isinstance(p, str) and DEB_PACKAGE.fullmatch(p) for p in packages)):
        return None
    return sorted(set(products)), sorted(set(packages))


def stored_key():
    """The key on this computer (STORE_AUTH), or None."""
    try:
        with open(STORE_AUTH, encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        return None
    if not text.startswith(STORE_MARK + "\n"):
        raise HelperError(f"{STORE_AUTH} isn't FlickOS's; it was left as it is")
    match = re.search(r"^machine \S+ login key password (\S+)$", text, re.M)
    return normal_key(match.group(1)) if match else None


def read_purchases():
    """PURCHASES_FILE's content, or None."""
    try:
        with open(PURCHASES_FILE, encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) and data.get("v") == 1 else None


def purchases_text(key, status, products=(), packages=(), now=None):
    now = now or datetime.datetime.now().astimezone()
    return json.dumps({"v": 1, "key": masked(key), "status": status, "products": list(products),
                       "packages": list(packages), "checked": now.isoformat(timespec="seconds")},
                      indent=1) + "\n"


def write_purchases(text):
    os.makedirs(os.path.dirname(PURCHASES_FILE), mode=0o755, exist_ok=True)
    write_atomic(PURCHASES_FILE, text)


def store_auth_text(key):
    host = STORE_URL.split("://", 1)[1]
    # No protocol: the line matches https only (apt_auth.conf(5)).
    machine = host if STORE_URL.startswith("https://") else STORE_URL
    return f"{STORE_MARK}\nmachine {machine}/apt login key password {key}\n"


def store_sources_text(release):
    return (f"{STORE_MARK}\n# Apps bought from the FlickOS store; the key is in {STORE_AUTH}.\n"
            f"Types: deb\nURIs: {STORE_URL}/apt\nSuites: {release}-store\nComponents: main\n"
            f"Signed-By: {STORE_KEYRING}\n")


def remove_ours(path):
    """Delete one of the store's files, only if it is FlickOS's."""
    try:
        with open(path, encoding="utf-8") as f:
            if f.readline().rstrip("\n") != STORE_MARK:
                raise HelperError(f"{path} isn't FlickOS's; it was left as it is")
    except FileNotFoundError:
        return False
    os.unlink(path)
    return True


def store_packages():
    """Every package in the store's lists apt has (its Packages files)."""
    try:
        result = subprocess.run([APT_GET, "indextargets", "--format", "$(FILENAME)", "Created-By: Packages",
                                 f"Origin: {STORE_ORIGIN}", f"Label: {STORE_LABEL}"],
                                capture_output=True, text=True, timeout=60, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return set()
    names = set()
    for path in result.stdout.split():
        found = next((path + suffix for suffix in LIST_SUFFIXES if os.path.exists(path + suffix)), None)
        if found is None:
            continue
        with contextlib.suppress(OSError, subprocess.TimeoutExpired):
            text = subprocess.run([APT_HELPER, "cat-file", found], capture_output=True, text=True,
                                  timeout=60, check=False).stdout
            names |= {name for name in re.findall(r"^Package:\s*(\S+)", text, re.M) if DEB_PACKAGE.fullmatch(name)}
    return names


def pins_text(pinned):
    if not pinned:
        return None
    return (f"{STORE_MARK}\n# The key on this computer can't download these from the store, so their\n"
            "# installed version stays and the automatic updates go on (purchases-check).\n"
            f"Package: {' '.join(sorted(pinned))}\nPin: release o={STORE_ORIGIN},l={STORE_LABEL}\n"
            "Pin-Priority: -1\n")


def write_pins(state, available=None):
    """STORE_PINS for what the key holds: every other package of the store."""
    held = set(state.get("packages") or ()) if state.get("status") == "valid" else set()
    text = pins_text((store_packages() if available is None else available) - held)
    if text is None:
        remove_ours(STORE_PINS)
        return
    with contextlib.suppress(OSError), open(STORE_PINS, encoding="utf-8") as f:
        if f.read() == text:
            return
    if os.path.exists(STORE_PINS):
        remove_ours(STORE_PINS)         # refuses one that isn't FlickOS's
    os.makedirs(os.path.dirname(STORE_PINS), mode=0o755, exist_ok=True)
    write_atomic(STORE_PINS, text)


def check_purchases(key, force=False, now=None):
    """Ask the store what the key holds (at most every CHECK_SECONDS unless
    force) and write the pins. No answer changes nothing."""
    now = now or datetime.datetime.now().astimezone()
    state = read_purchases()
    checked = None
    if state and state.get("key") == masked(key):
        with contextlib.suppress(TypeError, ValueError):
            checked = datetime.datetime.fromisoformat(state.get("checked"))
    else:
        state = None
    if force or checked is None or not 0 <= (now - checked).total_seconds() < CHECK_SECONDS:
        try:
            status, answer = store_request("/v1/key", key)
        except StoreUnreachable:
            status, answer = None, {}
        held = holdings(answer) if status == 200 else None
        if held is not None:
            text = purchases_text(key, "valid", *held, now=now)
        elif status == 401:
            text = purchases_text(key, "revoked", now=now)
            if not state or state.get("status") != "revoked":
                print(KEY_TURNED_OFF)
        else:
            text = None                 # offline, the store down: as it was
        if text is not None:
            write_purchases(text)
            state = json.loads(text)
    if state:
        write_pins(state)
    return state


def update_store_lists():
    """apt-get update of the store's entry only (apt runs purchases-check
    after it); a warning when it fails, since the key is already written."""
    try:
        result = subprocess.run([APT_GET, "update", "-q", "-o", f"Dir::Etc::sourcelist={STORE_SOURCES}",
                                 "-o", "Dir::Etc::sourceparts=-", "-o", "APT::Get::List-Cleanup=0"],
                                stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=APT_SECONDS,
                                env=dict(os.environ, LC_ALL="C.UTF-8"), check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        print(f"control-helper: apt couldn't fetch the store's list of apps: {error}", file=sys.stderr)
        return
    if result.returncode != 0:
        errors = [line[3:] for line in (result.stdout + result.stderr).splitlines() if line.startswith(("E: ", "W: "))]
        print("control-helper: apt couldn't fetch the store's list of apps: "
              + (" ".join(errors) or f"exit code {result.returncode}"), file=sys.stderr)


def product_names(products):
    """notes, phone-screen: "Notes, Phone Screen" (the store's names, not a list of ours)."""
    return ", ".join(product.replace("-", " ").title() for product in products)


def cmd_purchases_add(args):
    if args:
        raise HelperError("purchases-add takes no arguments: give the key on standard input")
    key = read_key()
    if live_system():
        raise HelperError("A key can't be added in the live session, where it would be lost at shutdown. "
                          "Add it after installing FlickOS.")
    release = store_release()
    current = stored_key()
    keep = key
    if current is not None and current != key:
        status, answer = store_request("/v1/link", body={"key": current, "add": key})
        if status == 200:
            keep = current                  # the computer's key now also holds the new one's
        elif status == 409 and answer.get("status") == "replace":
            status, answer = store_request("/v1/key", key)
    else:
        status, answer = store_request("/v1/key", key)
    if status == 401:
        raise HelperError(KEY_REFUSED)
    held = holdings(answer) if status == 200 else None
    if held is None:
        raise HelperError(f"The FlickOS store answered {status}. Try again later.")
    for path in (STORE_AUTH, STORE_SOURCES):
        os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    write_atomic(STORE_AUTH, store_auth_text(keep), mode=0o600)
    write_atomic(STORE_SOURCES, store_sources_text(release))
    write_purchases(purchases_text(keep, "valid", *held))
    update_store_lists()
    check_purchases(keep)                   # the pins, from the lists just fetched
    linked = " It was added to the key already on this computer." if keep != key else ""
    print(f"Bought with this key: {product_names(held[0])}.{linked} Install them in Software.")
    return 0


def cmd_purchases_remove(args):
    if args:
        raise HelperError("purchases-remove takes no arguments")
    found = False
    for path in (STORE_AUTH, STORE_SOURCES, STORE_PINS):
        found = remove_ours(path) or found
    with contextlib.suppress(FileNotFoundError):
        os.unlink(PURCHASES_FILE)
    print("The key was removed. Apps bought with it stay installed but no longer update."
          if found else "There is no key on this computer.")
    return 0


def cmd_purchases_check(args):
    if args not in ([], ["--now"]):
        raise HelperError("purchases-check: give nothing, or --now to ask the store at once")
    key = stored_key()
    if key is None:
        remove_ours(STORE_PINS)
        return 0
    check_purchases(key, force=bool(args))
    return 0


