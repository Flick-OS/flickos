def classroom_profile_text():
    return (f"{CLASSROOM_MARK}\n# deletes this file, with the firewall rules that use it.\n"
            f"[{CLASSROOM_APP}]\ntitle=Classroom (FlickOS)\n"
            "description=A teacher's computer seeing and guiding this one (flickos-classroom-view)\n"
            f"ports={CLASSROOM_PORTS}\n")


def cmd_firewall_classroom(args):
    if args not in (["on"], ["off"]):
        raise HelperError("firewall-classroom: give on or off")
    if not os.path.exists(UFW):
        raise HelperError("ufw is not installed")
    if os.path.exists(CLASSROOM_PROFILE) and not ours(CLASSROOM_PROFILE, CLASSROOM_MARK):
        raise HelperError(f"{CLASSROOM_PROFILE} isn't FlickOS's; it was left as it is")
    if args == ["on"]:
        write_atomic(CLASSROOM_PROFILE, classroom_profile_text())
        ufw("app", "update", CLASSROOM_APP)
        for network in PRIVATE_NETWORKS:
            ufw("allow", "from", network, "to", "any", "app", CLASSROOM_APP)
        print("A teacher's computer on a school or home network can reach this one through the firewall.")
        return 0
    if os.path.exists(CLASSROOM_PROFILE):
        for network in PRIVATE_NETWORKS:
            with contextlib.suppress(HelperError):
                ufw("delete", "allow", "from", network, "to", "any", "app", CLASSROOM_APP)
        os.unlink(CLASSROOM_PROFILE)
    print("The firewall blocks a teacher's computer again.")
    return 0


def ours(path, mark=PHONES_MARK):
    try:
        with open(path, encoding="utf-8") as f:
            return f.readline().rstrip("\n") == mark
    except OSError:
        return False


def cmd_firewall_phones(args):
    if args not in (["on"], ["off"], ["refresh"]):
        raise HelperError("firewall-phones: give on, off or refresh")
    if args == ["refresh"]:
        return refresh_phones_profile()
    if not os.path.exists(UFW):
        raise HelperError("ufw is not installed")
    if os.path.exists(PHONES_PROFILE) and not ours(PHONES_PROFILE):
        raise HelperError(f"{PHONES_PROFILE} isn't FlickOS's; it was left as it is")
    if args == ["on"]:
        write_atomic(PHONES_PROFILE, phones_profile_text())
        # Rules from an older profile take its new ports; then add what's missing.
        ufw("app", "update", PHONES_APP)
        for network in PRIVATE_NETWORKS:
            ufw("allow", "from", network, "to", "any", "app", PHONES_APP)
        print("Phones on home and office networks can connect through the firewall.")
        return 0
    if os.path.exists(PHONES_PROFILE):
        for network in PRIVATE_NETWORKS:
            # A rule deleted by hand is already gone.
            with contextlib.suppress(HelperError):
                ufw("delete", "allow", "from", network, "to", "any", "app", PHONES_APP)
        os.unlink(PHONES_PROFILE)
    print("The firewall blocks phones again.")
    return 0


def refresh_phones_profile():
    """An upgrade (postinst): only a FlickOS profile that differs from this
    version's is rewritten, and only the rules that use it change."""
    if not os.path.exists(UFW) or not ours(PHONES_PROFILE):
        return 0
    with open(PHONES_PROFILE, encoding="utf-8") as f:
        if f.read() == phones_profile_text():
            return 0
    write_atomic(PHONES_PROFILE, phones_profile_text())
    ufw("app", "update", PHONES_APP)
    print("Phones let through the firewall now use this version's ports.")
    return 0


def parse_local_ports(text):
    """The ports of a firewall-local-ports value as sorted (start, end, protocol)
    tuples, without repeats. Raises HelperError for anything else."""
    found = set()
    for item in text.split(","):
        match = LOCAL_PORT.fullmatch(item.strip())
        if not match:
            raise HelperError(f"'{item.strip()}' isn't a port: give ports like 8000/tcp or 5000:5010/udp")
        start, end, protocol = int(match.group(1)), int(match.group(2) or match.group(1)), match.group(3)
        if start > end or end > 65535:
            raise HelperError(f"{item.strip()}: the ports must be from {FIRST_PORT} to 65535, the first below the last")
        if start < FIRST_PORT:
            raise HelperError(f"{item.strip()}: ports below {FIRST_PORT} are for system services; "
                              "use sudo ufw allow for one of those")
        found.add((start, end, protocol))
    for protocol in ("tcp", "udp"):
        weight = sum(2 if start != end else 1 for start, end, kind in found if kind == protocol)
        if weight > LOCAL_PORTS_MAX:
            raise HelperError(f"at most {LOCAL_PORTS_MAX} {protocol} ports (a range counts as two)")
    return sorted(found, key=lambda port: (port[2], port[0], port[1]))


def local_ports_profile_text(ports):
    """The ufw app profile for parse_local_ports' result: ports=8000,9000/tcp|5353/udp."""
    groups = []
    for protocol in ("tcp", "udp"):
        items = [f"{start}" if start == end else f"{start}:{end}" for start, end, kind in ports if kind == protocol]
        if items:
            groups.append(",".join(items) + "/" + protocol)
    return (f"{LOCAL_PORTS_MARK}\n# deletes this file, with the firewall rules that use it.\n"
            f"[{LOCAL_PORTS_APP}]\ntitle=Servers you run (FlickOS)\n"
            "description=Ports that devices on home and office networks may reach\n"
            f"ports={'|'.join(groups)}\n")


def cmd_firewall_local_ports(args):
    if len(args) != 1:
        raise HelperError("firewall-local-ports: give off, or ports like 8000/tcp,3000/tcp")
    ports = None if args[0] == "off" else parse_local_ports(args[0])
    if not os.path.exists(UFW):
        raise HelperError("ufw is not installed")
    if os.path.exists(LOCAL_PORTS_PROFILE) and not ours(LOCAL_PORTS_PROFILE, LOCAL_PORTS_MARK):
        raise HelperError(f"{LOCAL_PORTS_PROFILE} isn't FlickOS's; it was left as it is")
    if ports is not None:
        write_atomic(LOCAL_PORTS_PROFILE, local_ports_profile_text(ports))
        # Rules from an earlier list take its new ports; then add what's missing.
        ufw("app", "update", LOCAL_PORTS_APP)
        for network in PRIVATE_NETWORKS:
            ufw("allow", "from", network, "to", "any", "app", LOCAL_PORTS_APP)
        print("Devices on home and office networks can reach those ports through the firewall.")
        return 0
    if os.path.exists(LOCAL_PORTS_PROFILE):
        for network in PRIVATE_NETWORKS:
            # A rule deleted by hand is already gone.
            with contextlib.suppress(HelperError):
                ufw("delete", "allow", "from", network, "to", "any", "app", LOCAL_PORTS_APP)
        os.unlink(LOCAL_PORTS_PROFILE)
    print("The firewall blocks those ports again.")
    return 0


def cmd_containers_dhcp(args):
    if args not in (["on"], ["off"]):
        raise HelperError("containers-dhcp: give on or off")
    exists = os.path.exists(NETAVARK_FLAG)
    if exists and not ours(NETAVARK_FLAG, NETAVARK_MARK):
        raise HelperError(f"{NETAVARK_FLAG} isn't FlickOS's; it was left as it is")
    if args == ["on"]:
        if not os.path.exists(NETAVARK_SOCKET):
            raise HelperError("podman's DHCP helper (netavark) isn't installed")
        os.makedirs(os.path.dirname(NETAVARK_FLAG), exist_ok=True)
        write_atomic(NETAVARK_FLAG, f"{NETAVARK_MARK}\n# deletes this file.\n")
        run_tool(["systemctl", "start", "netavark-dhcp-proxy.socket"])
        print("Containers can get addresses from your router's DHCP now, and after a restart.")
        return 0
    if exists:
        os.unlink(NETAVARK_FLAG)
    for unit in NETAVARK_UNITS:
        # A unit that isn't there or isn't running has nothing to stop.
        with contextlib.suppress(HelperError):
            run_tool(["systemctl", "stop", unit])
    print("Containers can't get addresses by DHCP any more.")
    return 0


# --- Security kits: packet capture and the wireless test adapter -----------------------

def capture_override():
    """An administrator's dpkg-statoverride on DUMPCAP, as dpkg prints it, or ""."""
    result = subprocess.run(["dpkg-statoverride", "--list", DUMPCAP], stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=30, check=False)
    return result.stdout.strip() if result.returncode == 0 else ""


def set_capture_answer(allowed):
    """Debian's own answer, then its postinst does the rest (ADR-S02)."""
    run_tool(["debconf-set-selections"], f"{CAPTURE_QUESTION} {'true' if allowed else 'false'}\n")
    run_tool(["dpkg-reconfigure", "-f", "noninteractive", "wireshark-common"])


def capture_members():
    try:
        return list(grp.getgrnam(WIRESHARK_GROUP).gr_mem)
    except KeyError:
        return []


def cmd_packet_capture(args):
    if args not in (["on"], ["off"]):
        raise HelperError("packet-capture: give on or off")
    user = calling_user()
    if args == ["on"]:
        if not os.path.exists(DUMPCAP):
            raise HelperError("Wireshark's dumpcap (wireshark-common) isn't installed")
        override = capture_override()
        if override:
            raise HelperError(f"an administrator set {DUMPCAP}'s owner and mode with dpkg-statoverride "
                              f"({override}); it was left as it is")
        set_capture_answer(True)
        if user not in capture_members():
            gpasswd("-a", user, WIRESHARK_GROUP)
        print(f"{user} can capture packets after logging in again.")
        return 0
    members = capture_members()
    if user in members:
        gpasswd("-d", user, WIRESHARK_GROUP)
        members.remove(user)
    if not members and os.path.exists(DUMPCAP) and not capture_override():
        set_capture_answer(False)
    print(f"{user} can't capture packets without administrator rights any more.")
    return 0


def nm_unescape(value):
    """A value of nmcli -t: backslash escapes its colons and backslashes."""
    return re.sub(r"\\(.)", r"\1", value)


def wifi_devices():
    """[{device, state, address}] of NetworkManager's Wi-Fi devices; address is
    the permanent one (PermHwAddress, upper case: NetworkManager scans with
    random ones), "" when it can't say."""
    result = subprocess.run(["nmcli", "-t", "-f", "GENERAL.DEVICE,GENERAL.TYPE,GENERAL.STATE,GENERAL.DBUS-PATH",
                             "device", "show"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True, timeout=30, check=False)
    if result.returncode != 0:
        raise HelperError(f"nmcli: {result.stderr.strip() or 'NetworkManager does not answer'}")
    devices, current = [], {}
    for line in result.stdout.splitlines() + [""]:
        key, sep, value = line.partition(":")
        if not sep:
            if current.get("GENERAL.TYPE") == "wifi":
                devices.append(current)
            current = {}
            continue
        current[key] = nm_unescape(value)
    found = []
    for device in devices:
        state = device.get("GENERAL.STATE", "").split(" ")[0]
        address = subprocess.run(["busctl", "-j", "get-property", "org.freedesktop.NetworkManager",
                                  device.get("GENERAL.DBUS-PATH", ""),
                                  "org.freedesktop.NetworkManager.Device.Wireless", "PermHwAddress"],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                 text=True, timeout=30, check=False)
        try:
            address = json.loads(address.stdout)["data"].upper() if address.returncode == 0 else ""
        except (ValueError, KeyError, TypeError, AttributeError):
            address = ""
        found.append({"device": device.get("GENERAL.DEVICE", ""),
                      "state": int(state) if state.isdigit() else 0, "address": address})
    return found


def test_adapter_text(address):
    return (f"{TEST_ADAPTER_MARK}\n# deletes this file. NetworkManager leaves this Wi-Fi adapter alone, for "
            f"monitor mode.\n[keyfile]\nunmanaged-devices=mac:{address}\n")


def cmd_wireless_test_adapter(args):
    if len(args) != 1:
        raise HelperError("wireless-test-adapter: give off, or an adapter's address like 00:11:22:33:44:55")
    address = None if args[0] == "off" else args[0].upper()
    if address is not None and not HW_ADDRESS.fullmatch(address):
        raise HelperError(f"'{args[0]}' isn't an address like 00:11:22:33:44:55")
    exists = os.path.exists(TEST_ADAPTER_CONF)
    if exists and not ours(TEST_ADAPTER_CONF, TEST_ADAPTER_MARK):
        raise HelperError(f"{TEST_ADAPTER_CONF} isn't FlickOS's; it was left as it is")
    if address is not None:
        device = next((d for d in wifi_devices() if d["address"] == address), None)
        if device is None:
            raise HelperError(f"no Wi-Fi adapter with the address {address} is plugged in")
        if device["state"] in ACTIVE_STATES:
            raise HelperError(f"{device['device']} is on a network now; choose an adapter you don't use to "
                              "get online")
        os.makedirs(os.path.dirname(TEST_ADAPTER_CONF), exist_ok=True)
        write_atomic(TEST_ADAPTER_CONF, test_adapter_text(address))
        run_tool(["nmcli", "general", "reload"])
        print(f"NetworkManager leaves {device['device']} alone now. Start monitor mode with "
              f"sudo airmon-ng start {device['device']}, without check kill.")
        return 0
    if exists:
        os.unlink(TEST_ADAPTER_CONF)
        run_tool(["nmcli", "general", "reload"])
    print("NetworkManager manages every Wi-Fi adapter again.")
    return 0


# --- Makers' apt repositories (flickos-dev.md ADR-008; flickos-security.md ADR-S07) -----

def openpgp_fingerprint(data):
    """The fingerprint (upper-case hex) of the first key of an OpenPGP
    certificate, armored or binary: SHA-1 over its public-key packet (RFC 4880
    4.2, 12.2; version 4 only). Raises HelperError."""
    if data.lstrip().startswith(b"-----BEGIN PGP PUBLIC KEY BLOCK-----"):
        lines = [line.strip() for line in data.decode("ascii", "replace").strip().splitlines()[1:]]
        if "" not in lines:
            raise HelperError("the key's armor has no blank line before its data")
        lines = lines[lines.index("") + 1:]
        try:
            data = base64.b64decode("".join(line for line in lines if not line.startswith(("=", "-----"))),
                                    validate=True)
        except ValueError:
            raise HelperError("the key's armor isn't base64") from None
    if len(data) < 6 or not data[0] & 0x80:
        raise HelperError("not an OpenPGP key")
    first = data[0]
    if first & 0x40:                        # new packet format
        tag, octet = first & 0x3F, data[1]
        if octet < 192:
            length, start = octet, 2
        elif octet < 224:
            length, start = ((octet - 192) << 8) + data[2] + 192, 3
        elif octet == 255:
            length, start = int.from_bytes(data[2:6], "big"), 6
        else:
            raise HelperError("not an OpenPGP key")
    else:
        tag, kind = (first >> 2) & 0x0F, first & 0x03
        if kind == 3:
            raise HelperError("not an OpenPGP key")
        size = (1, 2, 4)[kind]
        length, start = int.from_bytes(data[1:1 + size], "big"), 1 + size
    body = data[start:start + length]
    if tag != 6 or not body or len(body) != length or length > 0xFFFF or body[0] != 4:
        raise HelperError("not a version 4 OpenPGP public key")
    return hashlib.sha1(b"\x99" + length.to_bytes(2, "big") + body).hexdigest().upper()


def upstream(entry_id):
    if not UPSTREAM_ID.fullmatch(entry_id) or entry_id not in UPSTREAMS:
        raise HelperError(f"no maker's repository named '{entry_id}' (there are {', '.join(UPSTREAMS)})")
    return UPSTREAMS[entry_id]


def upstream_key(entry_id):
    """The maker's key file, once its fingerprint is the listed one."""
    path = os.path.join(UPSTREAM_KEYS, f"{entry_id}.asc")
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError as error:
        raise HelperError(f"{path}: {error.strerror}") from None
    if openpgp_fingerprint(data) != UPSTREAMS[entry_id]["fingerprint"]:
        raise HelperError(f"{path} isn't the key FlickOS lists for {UPSTREAMS[entry_id]['name']}; "
                          "nothing was changed")
    return path


def upstream_paths(entry_id):
    """{path: its first line} of the files an entry writes."""
    return {UPSTREAM_SOURCES.format(entry_id): UPSTREAM_MARK, UPSTREAM_PINS.format(entry_id): UPSTREAM_MARK,
            UPSTREAM_ORIGINS.format(entry_id): UPSTREAM_ORIGINS_MARK}


def upstream_files(entry_id):
    """{path: text} of an entry's sources, pin and update origin."""
    entry = UPSTREAMS[entry_id]
    key = upstream_key(entry_id)
    packages = " ".join(entry["packages"])
    host = entry["uri"].split("://", 1)[1].split("/", 1)[0]
    sources, pins, origins = upstream_paths(entry_id)
    return {
        sources: (f"{UPSTREAM_MARK}\n# {entry['name']}'s own repository, for {packages}; "
                  f"{os.path.basename(pins)} in preferences.d keeps its other packages out.\n"
                  f"Types: deb\nURIs: {entry['uri']}\nSuites: {entry['suite']}\nComponents: {entry['component']}\n"
                  f"Architectures: {native_arch()}\nSigned-By: {key}\n"),
        pins: (f"{UPSTREAM_MARK}\n# Only {packages} may come from {host}.\n"
               f"Package: *\nPin: origin {host}\nPin-Priority: -1\n\n"
               f"Package: {packages}\nPin: origin {host}\nPin-Priority: 500\n"),
        origins: (f"{UPSTREAM_ORIGINS_MARK}\n// Automatic updates install {packages} from {entry['name']}'s "
                  f"repository too.\nUnattended-Upgrade::Origins-Pattern {{\n        \"{entry['origin']}\";\n}};\n"),
    }


def upstreams_on():
    """The entries whose sources file is FlickOS's: the ones that are on."""
    return [entry_id for entry_id in UPSTREAMS if ours(UPSTREAM_SOURCES.format(entry_id), UPSTREAM_MARK)]


def upstream_patterns():
    """The update origins of the entries that are on (updates_text adds them)."""
    return tuple(UPSTREAMS[entry_id]["origin"] for entry_id in upstreams_on())


def check_upstream_paths(entry_id):
    for path, mark in upstream_paths(entry_id).items():
        if os.path.exists(path) and not ours(path, mark):
            raise HelperError(f"{path} isn't FlickOS's; it was left as it is")


def fetch_lists(entry_id):
    """apt's lists of this one repository (the rest stay as they are)."""
    entry = UPSTREAMS[entry_id]
    result = subprocess.run([APT_GET, "update", "-q", "-o", f"Dir::Etc::SourceList={UPSTREAM_SOURCES.format(entry_id)}",
                             "-o", "Dir::Etc::SourceParts=-", "-o", "APT::Get::List-Cleanup=0"],
                            stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=600,
                            env=dict(os.environ, LC_ALL="C.UTF-8"), check=False)
    lines = (result.stdout + result.stderr).splitlines()
    problems = [line for line in lines if line.startswith(("E: ", "Err:"))
                or line.startswith("W: ") and re.search(r"fetch|GPG|sign|Release", line, re.I)]
    if result.returncode != 0 or problems:
        raise HelperError(f"{entry['name']}'s repository can't be read ({entry['uri']}). Check the network "
                          f"connection and try again." + (f" apt: {problems[-1]}" if problems else ""))


def run_apt(args, what, options=(), seconds=APT_SECONDS):
    """apt-get without questions; raises HelperError in plain words."""
    command = [APT_GET, "-y", "-q", *options,
               "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold", *args]
    result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                            timeout=seconds, env=dict(os.environ, DEBIAN_FRONTEND="noninteractive"),
                            check=False)
    if result.returncode != 0:
        text = result.stdout + result.stderr
        if "Could not get lock" in text or "Unable to acquire the dpkg frontend lock" in text:
            raise HelperError("Software is being installed or updated right now. Try again in a few minutes.")
        if "Failed to fetch" in text or "Unable to fetch" in text:
            raise HelperError(f"{what} can't be downloaded. Check the network connection and try again.")
        errors = [line[3:] for line in result.stderr.splitlines() if line.startswith("E: ")]
        raise HelperError("apt: " + (" ".join(errors) or f"exit code {result.returncode}"))


def upstream_on(entry_id):
    entry = UPSTREAMS[entry_id]
    packages = list(entry["packages"])
    check_upstream_paths(entry_id)
    files = upstream_files(entry_id)            # checks the key first
    new = [path for path in files if not os.path.exists(path)]
    try:
        for path, text in files.items():
            os.makedirs(os.path.dirname(path), exist_ok=True)
            write_atomic(path, text)
        refresh_updates(quiet=True)
        fetch_lists(entry_id)
        removed, _new = simulate(["install", *packages])
        if removed:
            raise HelperError(f"Installing {', '.join(packages)} would remove {', '.join(sorted(removed))}, "
                              "so nothing was changed.")
        run_apt(["install", *packages], ", ".join(packages), seconds=UPSTREAM_SECONDS)
    except BaseException:
        # What this run added goes again: on stays on, off stays off.
        for path in new:
            with contextlib.suppress(OSError):
                os.unlink(path)
        with contextlib.suppress(HelperError, OSError):
            refresh_updates(quiet=True)
        raise
    print(f"{', '.join(packages)} is installed from {entry['name']}'s repository; automatic updates keep it "
          "current.")
    return 0


def upstream_off(entry_id):
    entry = UPSTREAMS[entry_id]
    check_upstream_paths(entry_id)
    present = sorted(installed_packages(list(entry["packages"])))
    if present:
        removed, _new = simulate(["remove", *present])
        others = sorted(p for p in removed if p not in present and base_name(p) not in present)
        if others:
            raise HelperError(f"Removing {', '.join(present)} would also remove {', '.join(others)}, "
                              "so nothing was changed.")
        run_apt(["remove", *present], ", ".join(present))
    for path in upstream_paths(entry_id):
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)
    refresh_updates(quiet=True)
    print(f"{entry['name']}'s repository is gone" + (f", and {', '.join(present)} with it." if present else "."))
    return 0


def refresh_upstreams():
    """An upgrade (postinst): the files of the entries that are on, written
    again from this version's list (a new key, a new address)."""
    failed = 0
    for entry_id in upstreams_on():
        try:
            files = upstream_files(entry_id)
        except HelperError as error:
            print(f"control-helper: {error}", file=sys.stderr)
            failed = 1
            continue
        for path, text in files.items():
            if os.path.exists(path) and not ours(path, upstream_paths(entry_id)[path]):
                continue
            with contextlib.suppress(OSError), open(path, encoding="utf-8") as f:
                if f.read() == text:
                    continue
            write_atomic(path, text)
            print(f"{path} follows this version's list.")
    refresh_updates()
    return failed


def cmd_upstream(args):
    if args == ["refresh"]:
        return refresh_upstreams()
    if len(args) != 2 or args[1] not in ("on", "off"):
        raise HelperError(f"upstream: give ID on|off (ID: {', '.join(UPSTREAMS)}), or refresh")
    upstream(args[0])
    return upstream_on(args[0]) if args[1] == "on" else upstream_off(args[0])


