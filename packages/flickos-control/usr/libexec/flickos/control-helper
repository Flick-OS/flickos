         "containers-dhcp": cmd_containers_dhcp,
         "packet-capture": cmd_packet_capture, "wireless-test-adapter": cmd_wireless_test_adapter,
         "upstream": cmd_upstream,
         "power": cmd_power, "locale-add": cmd_locale_add, "locale": cmd_locale,
         "updates": cmd_updates,
         "firefox-memory": cmd_firefox_memory, "i386-on": cmd_i386_on, "i386-off": cmd_i386_off,
