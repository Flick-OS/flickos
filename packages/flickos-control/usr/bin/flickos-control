    "tile:displays": "screen monitor arrange resolution scale",
    "tile:network": "wifi wi-fi wireless ethernet internet vpn proxy connection network",
    "tile:sound": "sound audio volume speaker speakers headphones microphone output input",
    "tile:bluetooth": "bluetooth pair devices headphones",
    "tile:printers": "printer printers printing print scanner",
    "tile:updates": "software updates upgrade install",
}
SEARCH_RESULTS = 30                 # at most this many results


@dataclasses.dataclass
class SearchItem:
    title: str
    where: str                      # the page's name, or what the app is
    words: str                      # fold()ed: what a search looks in
    page: str = None                # the page to open
    command: tuple = None           # or the app to start
    target: object = None           # the widget to scroll to (a row, a heading)
    focus: object = None            # the widget to focus there


def fold(text):
    """Lowercase without accents, for search."""
    return "".join(c for c in unicodedata.normalize("NFKD", text or "") if not unicodedata.combining(c)).casefold()


def search_item(title, where, extra="", **fields):
    return SearchItem(title, where, fold(f"{title} {extra}"), **fields)


def find(items, query, limit=SEARCH_RESULTS):
    """The items that have every word of query, best first: the title starts
    with the query, then the title has every word, then the rest; in their
    order within each."""
    query = fold(query).strip()
    terms = query.split()
    if not terms:
        return []
    found = []
    for index, item in enumerate(items):
        if all(term in item.words for term in terms):
            title = fold(item.title)
            rank = 0 if title.startswith(query) else 1 if all(term in title for term in terms) else 2
            found.append((rank, index, item))
    return [item for _, _, item in sorted(found, key=lambda entry: entry[:2])][:limit]


def unique_items(items):
    """Of items with the same page and title, the first with a widget to focus
    (a row with its switch), else the first (a heading)."""
    chosen = {}
    for item in items:
        key = (item.page, item.command, fold(item.title))
        if key not in chosen or (chosen[key].focus is None and item.focus is not None):
            chosen[key] = item
    return [item for item in items if chosen[(item.page, item.command, fold(item.title))] is item]


class ControlError(Exception):
    pass


def warn(message):
    print(f"flickos-control: {message}", file=sys.stderr)


# --- Mouse, touchpad and keyboard settings --------------------------------------------

@dataclasses.dataclass(frozen=True)
class Setting:
    key: str                        # section.name: touchpad.natural-scroll
    kind: str                       # bool, number, choice, xkb
    labwc: tuple                    # ("libinput", category, element), ("keyboard", element), ("environment", var),
                                    # ("magnifier", element; "area" and "size" are width and height)
    default: object = None          # None: the device's or the system's own
    low: float = None
    high: float = None
    choices: tuple = ()

    @property
    def topic(self):
        """The settings file: input, keyboard or idle."""
        prefix = self.key.split(".")[0]
        return "input" if prefix in ("touchpad", "mouse") else prefix

    @property
    def section(self):
        return self.key.split(".")[0].title()

    @property
    def name(self):
        return "".join(part.title() for part in self.key.split(".")[1].split("-"))


# Only keys and values labwc 0.8.3 parses (src/config/rcxml.c; tests/ has the
# list). Categories: touchpad = pointers with tap fingers, non-touch = mice and
# trackpoints. Defaults are labwc's and libinput's.
SETTINGS = {setting.key: setting for setting in (
    Setting("touchpad.tap", "bool", ("libinput", "touchpad", "tap"), True),
    Setting("touchpad.natural-scroll", "bool", ("libinput", "touchpad", "naturalScroll"), False),
    Setting("touchpad.disable-while-typing", "bool", ("libinput", "touchpad", "disableWhileTyping"), True),
    Setting("touchpad.pointer-speed", "number", ("libinput", "touchpad", "pointerSpeed"), 0.0, -1, 1),
    Setting("touchpad.click-method", "choice", ("libinput", "touchpad", "clickMethod"),
            choices=("buttonAreas", "clickfinger")),
    Setting("mouse.left-handed", "bool", ("libinput", "non-touch", "leftHanded"), False),
    Setting("mouse.natural-scroll", "bool", ("libinput", "non-touch", "naturalScroll"), False),
    Setting("mouse.pointer-speed", "number", ("libinput", "non-touch", "pointerSpeed"), 0.0, -1, 1),
    Setting("mouse.accel-profile", "choice", ("libinput", "non-touch", "accelProfile"), "adaptive",
            choices=("adaptive", "flat")),
    Setting("keyboard.repeat-delay", "number", ("keyboard", "repeatDelay"), 600, 150, 1000),
    Setting("keyboard.repeat-rate", "number", ("keyboard", "repeatRate"), 25, 10, 60),
    Setting("keyboard.numlock", "bool", ("keyboard", "numlock"), False),
    Setting("keyboard.layout", "xkb", ("environment", "XKB_DEFAULT_LAYOUT")),
    Setting("keyboard.variant", "xkb", ("environment", "XKB_DEFAULT_VARIANT")),
    # Seconds, 0 = never (flickos-control idle, swayidle).
    Setting("idle.lock-after", "number", ("idle", "lock"), 300, 0, 7200),
    Setting("idle.suspend-after", "number", ("idle", "suspend"), 900, 0, 14400),
    Setting("idle.lock-before-sleep", "bool", ("idle", "before-sleep"), True),
    # swaylock's background (flickos-control lock).
    Setting("lock.background", "choice", ("swaylock", "-i"), "color", choices=("color", "wallpaper")),
    # Installed locales (locale -a); unset: the system's (/etc/default/locale).
    Setting("locale.language", "locale", ("environment", "LANG")),
    Setting("locale.formats", "locale", ("environment", "LC_TIME")),
    # wlsunset -t, Kelvin (flickos-control night-light).
    Setting("night-light.enabled", "bool", ("night-light", "on"), True),
    Setting("night-light.temperature", "number", ("night-light", "-t"), 4000, 2500, 6000),
    # mako's do-not-disturb mode.
    Setting("notifications.do-not-disturb", "bool", ("mako", DND_MODE), False),
    # Keep a history of changes (the History page); read by every program that records.
    Setting("history.enabled", "bool", ("history", "record"), True),
    # labwc's magnifier (screen zoom; the keys are flickos-settings'). The
    # defaults are flickos-settings' rc.xml's.
    Setting("zoom.area", "choice", ("magnifier", "area"), "screen", choices=("screen", "lens")),
    Setting("zoom.lens-size", "number", ("magnifier", "size"), 400, 200, 800),
    Setting("zoom.step", "number", ("magnifier", "increment"), 0.5, 0.25, 1),
    Setting("zoom.smooth", "bool", ("magnifier", "useFilter"), True),
)}
TOPICS = ("input", "keyboard", "idle", "locale", "night-light", "notifications", "lock", "history", "zoom")
# Numbers chosen from a list of names instead of a slider.
NAMED_CHOICES = {"night-light.temperature": NIGHT_LIGHT_CHOICES,
                 "zoom.lens-size": ((300, "Small"), (400, "Medium"), (600, "Large")),
                 "zoom.step": ((0.25, "Small"), (0.5, "Medium"), (1.0, "Large"))}
TRUE, FALSE = ("yes", "true", "on", "1"), ("no", "false", "off", "0")
XKB_NAME = re.compile(r"^[A-Za-z0-9_()+-]*$")
LOCALE_NAME = re.compile(r"^[A-Za-z]+(_[A-Za-z0-9]+)?(\.[A-Za-z0-9-]+)?(@[A-Za-z0-9]+)?$")


def normalize(setting, text):
    """The value as stored and given to labwc. Raises ControlError."""
    text = str(text).strip()
    if setting.kind == "bool":
        if text.lower() in TRUE:
            return "yes"
        if text.lower() in FALSE:
            return "no"
        raise ControlError(f"{setting.key}: give yes or no, not '{text}'")
    if setting.kind == "number":
        try:
            number = float(text)
        except ValueError:
            raise ControlError(f"{setting.key}: not a number: '{text}'") from None
        if not setting.low <= number <= setting.high:
            raise ControlError(f"{setting.key}: give a number from {setting.low} to {setting.high}")
        return str(int(round(number))) if isinstance(setting.default, int) else f"{number:.2f}"
    if setting.kind == "choice":
        for choice in setting.choices:
            if choice.lower() == text.lower():
                return choice
        raise ControlError(f"{setting.key}: give one of {', '.join(setting.choices)}, not '{text}'")
    if setting.kind == "locale":
        if not LOCALE_NAME.match(text):
            raise ControlError(f"{setting.key}: not a locale name: '{text}'")
        return text
    if not XKB_NAME.match(text):
        raise ControlError(f"{setting.key}: not an XKB name: '{text}'")
    return text


def value_of(setting, text):
    """A stored value as Python: bool, float, int or str; None if unset."""
    if text is None:
        return setting.default
    if setting.kind == "bool":
        return text == "yes"
    if setting.kind == "number":
        return int(text) if isinstance(setting.default, int) else float(text)
    return text


def config_home():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")


def user_file(topic):
    return os.path.join(config_home(), "flickos", topic)


def system_file(topic):
    return os.path.join(SYSTEM_CONF_DIR, f"{topic}.conf")


def read_values(path):
    """{key: value} of the SETTINGS in one INI file; bad values are left out."""
    ini = configparser.ConfigParser(interpolation=None)
    try:
        ini.read(path, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError) as error:
        warn(f"{path}: {error}")
        return {}
    values = {}
    for setting in SETTINGS.values():
        if ini.has_option(setting.section, setting.name):
            try:
                values[setting.key] = normalize(setting, ini.get(setting.section, setting.name))
            except ControlError as error:
                warn(f"{path}: {error}")
    return values


def load_values():
    """({key: value}, {key: "system" or "user"}) of the settings that are set."""
    values, sources = {}, {}
    for topic in TOPICS:
        for source, path in (("system", system_file(topic)), ("user", user_file(topic))):
            for key, value in read_values(path).items():
                if SETTINGS[key].topic == topic:
                    values[key], sources[key] = value, source
    return values, sources


def write_atomic(path, text):
    folder = os.path.dirname(path)
    os.makedirs(folder, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=folder, prefix=".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def effective(key, values):
    """A setting's value as stored, or its default in the same form."""
    setting = SETTINGS[key]
    if key in values:
        return values[key]
    if setting.default is None:
        return None
    return normalize(setting, "yes" if setting.default is True else "no" if setting.default is False
                     else setting.default)


def save_values(changes):
    """Write {key: value or None (remove)} to the user's files, keeping their
    other lines' values. A change that shows is recorded for History."""
    before = load_values()[0]
    saved = {key: read_values(user_file(SETTINGS[key].topic)).get(key, DEFAULT_CHOICE) for key in changes}
    for topic in {SETTINGS[key].topic for key in changes}:
        path = user_file(topic)
        ini = configparser.ConfigParser(interpolation=None)
        ini.optionxform = str
        with contextlib.suppress(configparser.Error, UnicodeDecodeError):
            ini.read(path, encoding="utf-8")
        for key, value in changes.items():
            setting = SETTINGS[key]
            if setting.topic != topic:
                continue
            if ini.has_section(setting.section):
                for existing in list(ini[setting.section]):
                    if existing.lower() == setting.name.lower():
                        ini.remove_option(setting.section, existing)
            if value is not None:
                if not ini.has_section(setting.section):
                    ini.add_section(setting.section)
                ini[setting.section][setting.name] = value
        out = []
        for section in ini.sections():
            if ini[section]:
                out += [f"[{section}]"] + [f"{name}={value}" for name, value in ini[section].items()] + [""]
        write_atomic(path, "\n".join(out))
    after = load_values()[0]
    for key, value in changes.items():
        # The history's own switch isn't a change History can undo.
        if SETTINGS[key].topic != "history" and effective(key, before) != effective(key, after):
            record(key, saved[key], DEFAULT_CHOICE if value is None else value)


# --- History ------------------------------------------------------------------
# Every change of a setting is recorded, by the program that owns it, in
# $XDG_STATE_HOME/flickos/history.jsonl: one JSON line per change, appended.
# flickos-layout and flick-tiler record theirs the same way, in the same format
# (docs/design/flickos-history.md, ADR-002). The History page and `history`
# read it, show what happened (changes of one setting close together are one)
# and undo a change by running the owner's command with the old value.

HISTORY_OWNER = "flickos-control"
HISTORY_FILE = "history.jsonl"      # in $XDG_STATE_HOME/flickos
HISTORY_LOCK = "history.lock"
HISTORY_BYTES = 256 * 1024          # above this, the older half is dropped
HISTORY_DAYS = 90                   # shown
HISTORY_ROWS = 100                  # at most this many on the page: 100 rows take 60 ms to build
MERGE_SECONDS = 120                 # changes of one setting this close are one
DEFAULT_CHOICE = "default"          # the owner's word for "remove the user's value"
LAYOUT_HISTORY_KEYS = ("layout", "style", "clicks", "launcher", "menu-style", "clock", "quick-settings")
TILER_HISTORY_KEYS = ("enabled", "mode", "ratio", "gap", "floating")
PHONE_HISTORY_KEYS = ("enabled", "name", "networks", "notifications", "notification-apps", "calls", "media",
                      "commands")
SCREENSHOT_HISTORY_KEYS = ("folder", "recordings-folder", "pointer", "sound")
# The capture bar's words for a recording's sound (flickos-screenshot's SOUNDS).
SCREENSHOT_SOUNDS = (
    ("none", "No sound"),
    ("computer", "Computer sound"),
    ("microphone", "Microphone"),
    ("both", "Computer and microphone"),
)

