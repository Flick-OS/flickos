@dataclasses.dataclass(frozen=True)
class Tile:
    id: str
    name: str
    icons: tuple                    # icon names, the first the theme has is used
    command: tuple
    start: tuple = ()               # what the tile runs, when not the app itself

    @property
    def argv(self):
        return self.start or self.command


# When the icon theme has none of a tile's icons (a theme chosen in Appearance).
TILE_FALLBACK_ICONS = ("preferences-desktop", "preferences-system", "application-x-executable")

# The same apps as the Settings menu (flickos-settings' menu.xml).
TILES = (
    Tile("wallpaper", "Wallpaper", ("preferences-desktop-wallpaper",), ("waypaper",)),
    Tile("appearance", "Appearance", ("preferences-desktop-theme",), ("nwg-look",)),
    Tile("displays", "Displays", ("preferences-desktop-display", "video-display"), ARRANGE,
         (*SELF, DISPLAYS, "arrange")),
    Tile("network", "Network", ("preferences-system-network", "network-wired"), ("nm-connection-editor",)),
    Tile("sound", "Sound", ("multimedia-volume-control", "audio-volume-high"), ("pavucontrol",)),
    Tile("bluetooth", "Bluetooth", ("bluetooth", "preferences-system-bluetooth"), ("blueman-manager",)),
    Tile("printers", "Printers", ("printer",), ("system-config-printer",)),
    Tile("updates", "Software Updates", ("system-software-update",), ("gpk-update-viewer",)),
)


