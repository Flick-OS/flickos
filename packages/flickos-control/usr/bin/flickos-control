        return "rc.xml" in warning


class KeyboardPage(SettingsPage):
    """Keyboard layout (per user, applied at once), repeat and Num Lock; the
    system layout through the helper."""

    def __init__(self, ui):
        super().__init__(ui, "The layout applies right away to your account. The login screen and the "
                             "console keep the system layout until you change it too.")
        Gtk, row = ui.Gtk, ui.row
        self.rules = xkb_rules()
        self.layouts = Gtk.ComboBoxText()
        self.layouts.set_size_request(300, -1)
        self.layouts.connect("changed", self.layout_chosen)
        self.variants = Gtk.ComboBoxText()
        self.variants.set_size_request(300, -1)
        self.variants.connect("changed", self.variant_chosen)
        self.system_label = ui.label("", dim=True)
        self.system_button = Gtk.Button.new_with_mnemonic("_Use for Login Screen and Console…")
        self.system_button.connect("clicked", self.use_for_system)
        system = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        system.pack_start(self.system_button, False, False, 0)
        try_it = Gtk.Entry(placeholder_text="Type here to try the layout")
        try_it.set_size_request(300, -1)
        self.group("Layout", None, [
            row("Layout", self.layouts), row("Variant", self.variants), row("Try it", try_it),
        ])
        self.system_row = row("Login screen and console", system, "")
        self.group("System", "Needs an administrator's password.", [self.system_row])
        self.group("Typing", None, [
            row("Repeat delay", self.control("keyboard.repeat-delay"), "How long a key is held before it repeats"),
            row("Repeat rate", self.control("keyboard.repeat-rate")),
            row("Num Lock on", self.control("keyboard.numlock"), "When you log in"),
        ])
        self.box.pack_start(self.status, False, False, 0)
        self.fill_layouts()

    def layout_name(self, layout, variant=""):
        name = self.rules["layout"].get(layout, layout or "none")
        if variant:
            name = self.rules["variant"].get(layout, {}).get(variant, f"{name} ({variant})")
        return name

    def fill_layouts(self):
        """The lists show the saved choice; "Same as the system" is no choice."""
        system = system_keyboard()
        chosen = self.values.get("keyboard.layout")
        layout = chosen or system["layout"]
        variant = self.values.get("keyboard.variant")
        if variant is None:
            variant = "" if chosen else system["variant"]
        self.quiet = True
        self.layouts.remove_all()
        self.layouts.append("default", f"Same as the system: {self.layout_name(system['layout'])}")
        for layout_id, name in sorted(self.rules["layout"].items(), key=lambda item: item[1].lower()):
            self.layouts.append(layout_id, name)
        self.layouts.set_active_id(chosen or "default")
        self.variants.remove_all()
        self.variants.append("", self.layout_name(layout))
        for variant_id, name in sorted(self.rules["variant"].get(layout, {}).items(), key=lambda i: i[1].lower()):
            self.variants.append(variant_id, name)
        self.variants.set_active_id(variant if variant in self.rules["variant"].get(layout, {}) else "")
        self.quiet = False
        in_use = (layout, variant)
        on_system = (system["layout"], system["variant"])
        self.ui.set_subtitle(self.system_row, f"Now: {self.layout_name(*on_system)}")
        self.system_button.set_sensitive(in_use != on_system and "," not in system["layout"])
        self.system_button.set_tooltip_text(None if in_use != on_system else "The system already uses this layout.")

    def layout_chosen(self, combo):
        if not self.quiet and combo.get_active_id():
            self.change("keyboard.layout", combo.get_active_id())

    def variant_chosen(self, combo):
        if not self.quiet and combo.get_active_id() is not None:
            self.change("keyboard.variant", combo.get_active_id() or "default")

    def use_for_system(self, _button):
        system = system_keyboard()
        layout = self.values.get("keyboard.layout") or system["layout"]
        variant = self.values.get("keyboard.variant") or ""
        self.system_button.set_sensitive(False)
        self.status.set_text("Waiting for the password…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            if not ok and not messages:
                messages = ["The system layout was not changed."]
            self.status.set_text("\n".join(messages))
            self.reload()

        self.ui.run_async([*SELF, "system", "keyboard.system", layout + (f"({variant})" if variant else "")], done)

    def reload(self):
        super().reload()
        self.fill_layouts()

    @staticmethod
    def affected_by(warning):
        return "keyboard layout" in warning or "rc.xml" in warning


class AppsPage:
    """Default apps: xdg-mime for file types, xdg-terminal-exec's list for
    the terminal. Super+B, Super+E, Super+Enter and the menu follow them."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label("The apps that open web links, folders and files, and the terminal. "
                                "Super+B, Super+E, Super+Enter and the menu use them too."), False, False, 0)
        frame, listbox = ui.framed_list()
        self.combos = {}
        for app_id, name, types in DEFAULT_APPS:
            combo = Gtk.ComboBoxText()
            combo.set_size_request(300, -1)
            combo.connect("changed", self.chosen, app_id)
            self.combos[app_id] = (combo, types)
            listbox.add(ui.row(name, combo))
        self.terminal = Gtk.ComboBoxText()
        self.terminal.set_size_request(300, -1)
        self.terminal.connect("changed", self.terminal_chosen)
        listbox.add(ui.row("Terminal", self.terminal))
        box.pack_start(frame, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def read(self):
        """For each file type: (default app id or None, [(id, name)]); the
        terminals [(id, name)] and the default one. GIO reads every app's
        desktop file, which takes a while the first time."""
        Gio = self.ui.Gio
        defaults = {}
        for app_id, (_combo, types) in self.combos.items():
            current = Gio.AppInfo.get_default_for_type(types[0], False)
            # get_all_for_type() reads mimeinfo.cache (update-desktop-database);
            # apps in a folder without one only say so in their MimeType=.
            candidates = list(Gio.AppInfo.get_all_for_type(types[0])) + [
                app for app in Gio.AppInfo.get_all() if types[0] in (app.get_supported_types() or [])]
            apps = {app.get_id(): app.get_display_name() for app in candidates
                    if app.get_id() and app.should_show()}
            current_id = current.get_id() if current is not None else None
            if current_id:
                apps.setdefault(current_id, current.get_display_name())
            defaults[app_id] = (current_id, sorted(apps.items(), key=lambda item: item[1].lower()))
        terminals = {}
        for app in Gio.AppInfo.get_all():
            if isinstance(app, Gio.DesktopAppInfo) and "TerminalEmulator" in (app.get_categories() or "").split(";") \
                    and not app.get_nodisplay():
                terminals[app.get_id()] = app.get_display_name()
        return defaults, sorted(terminals.items(), key=lambda item: item[1].lower()), default_terminal(terminals)

    def fill(self):
        self.ui.background(self.read, self.show_apps, key=(self, "read"))

    def show_apps(self, result, error):
        if error:
            self.status.set_text(error)
            return
        defaults, terminals, terminal = result
        self.quiet = True
        for app_id, (combo, _types) in self.combos.items():
            current_id, apps = defaults[app_id]
            combo.remove_all()
            for candidate_id, name in apps:
                combo.append(candidate_id, name)
            if current_id is None:
                combo.prepend("", "None chosen")
            combo.set_active_id(current_id or "")
        self.terminal.remove_all()
        for app_id, name in terminals:
            self.terminal.append(app_id, name)
        self.terminal.set_active_id(terminal or "")
        self.quiet = False

    def chosen(self, combo, category):
        app_id = combo.get_active_id()
        if self.quiet or not app_id:
            return

        def done(ok, stdout, stderr):
            self.status.set_text("" if ok else "\n".join(output_messages(stdout, stderr)) or "Not changed.")
            self.fill()

        self.ui.run_async([*SELF, "default-app", "set", category, app_id], done)

    def terminal_chosen(self, combo):
        self.chosen(combo, "terminal")

    def shown(self):
        self.fill()


class IdlePage(SettingsPage):
    """Lock and suspend times (flickos-control idle, swayidle)."""

    def __init__(self, ui):
        super().__init__(ui, "When the computer is not used for a while, the screen is locked and later the "
                             "computer goes to sleep.")
        if live_session():
            self.box.pack_start(ui.label("Not in the live session: locking or sleeping there could interrupt "
                                         "an installation.", dim=True), False, False, 0)
        self.group("When idle", None, [
            ui.row("Lock the screen after", self.control("idle.lock-after")),
            ui.row("Sleep after", self.control("idle.suspend-after")),
        ])
        lock_now = ui.Gtk.Button.new_with_mnemonic("_Lock Now")
        lock_now.connect("clicked", lambda _b: ui.start_app([*SELF, "lock"]))
        self.group("Lock screen", None, [
            ui.row("Lock before sleep", self.control("idle.lock-before-sleep"),
                   "Turned off, the computer wakes up without asking for the password"),
            ui.row("Background", self.control("lock.background")),
            ui.row("Lock the screen now", lock_now, "Also Super+L"),
        ])
        # Power button and lid: logind's, for everyone (the helper's power verb).
        self.power = {}
        rows = []
        lid = has_lid()
        for setting, _, title, actions in POWER_SETTINGS:
            if setting.startswith("lid") and not lid:
                continue
            combo = ui.Gtk.ComboBoxText()
            combo.set_size_request(240, -1)
            for action in actions:
                # No swayidle to lock the screen in the live session.
                if action != "lock" or not live_session():
                    combo.append(action, POWER_ACTIONS[action])
            combo.connect("changed", self.power_chosen, setting)
            combo.set_sensitive(False)          # until logind's values are read
            self.power[setting] = combo
            rows.append(ui.row(title, combo))
        self.group("Buttons and lid", "For everyone who uses this computer. Changing these needs an "
                                      "administrator's password.", rows)
        self.box.pack_start(self.status, False, False, 0)

    def power_chosen(self, combo, setting):
        action = combo.get_active_id()
        if self.quiet or not action:
            return
        self.status.set_text("Waiting for the password…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            self.read_power()

        self.ui.run_async([*SELF, "system", f"power.{setting}", action], done)

    def read_power(self):
        def show(state, error):
            if error:
                self.status.set_text(error)
                return
            self.quiet = True
            for setting, combo in self.power.items():
                action = state.get(setting, "")
                if action not in [row[1] for row in combo.get_model()]:
                    combo.append(action, POWER_ACTIONS.get(action, action))
                combo.set_active_id(action)
                combo.set_sensitive(True)
            self.quiet = False

        self.ui.background(power_state, show, key=(self, "power"))

    def reload(self):
        super().reload()
        self.read_power()

    @staticmethod
    def affected_by(warning):
        return False


class DisplaysPage(SettingsPage):
    """The screens now and the kept arrangements (`displays save|forget`,
    kanshi profiles; arranging them stays wdisplays' job), and night light
    (flickos-control's own settings)."""

    def __init__(self, ui):
        super().__init__(ui, "Change the resolution, scale and arrangement of the screens with Arrange "
                             "Screens; such changes last until you log out. Keep an arrangement to get it "
                             "back at every login and whenever the same screens are plugged in.")
        Gtk, box = ui.Gtk, self.box
        box.pack_start(ui.heading("Screens now"), False, False, 0)
        frame, self.screens = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        self.state = ui.label("", dim=True)
        box.pack_start(self.state, False, False, 0)
        buttons = Gtk.Box(spacing=12)
        self.arrange = Gtk.Button.new_with_mnemonic("_Arrange Screens…")
        self.arrange.set_tooltip_text(f"Open Displays ({ARRANGE[0]})")
        self.arrange.set_sensitive(bool(shutil.which(ARRANGE[0])))
        self.arrange.connect("clicked", self.arrange_clicked)
        buttons.pack_start(self.arrange, False, False, 0)
        self.keep = Gtk.Button.new_with_mnemonic("_Keep This Arrangement")
        self.keep.set_sensitive(False)
        self.keep.connect("clicked", self.keep_clicked)
        buttons.pack_start(self.keep, False, False, 0)
        box.pack_start(buttons, False, False, 0)
        box.pack_start(ui.heading("Kept arrangements"), False, False, 0)
        frame, self.kept = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        self.group("Night light", "Warmer colors from sunset to sunrise, timed for the time zone (Date & Time), "
                                  "so evenings are easier on the eyes.", [
            ui.row("Night light", self.control("night-light.enabled")),
            ui.row("Warmth", self.control("night-light.temperature"), "How warm the colors get at night"),
        ])
        box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        return bool(shutil.which("wlr-randr") and shutil.which("kanshi"))

    def arrange_clicked(self, _button):
        """wdisplays; the page shows its changes once it is closed."""
        Gio = self.ui.Gio
        try:
            process = Gio.Subprocess.new([*SELF, DISPLAYS, "arrange"], Gio.SubprocessFlags.NONE)
        except self.ui.GLib.Error as error:
            self.status.set_text(error.message)
            return

        def closed(process, result):
            with contextlib.suppress(self.ui.GLib.Error):
                process.wait_finish(result)
            self.shown()

        process.wait_async(None, closed)

    def run(self, command, waiting):
        self.keep.set_sensitive(False)
        self.status.set_text(waiting)

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            self.shown()

        self.ui.run_async(command, done)

    def keep_clicked(self, _button):
        self.run([*SELF, DISPLAYS, "save"], "Keeping…")

    def forget(self, name):
        self.run([*SELF, DISPLAYS, "forget", name], "Forgetting…")

    def reload(self):
        """The screens (the notice is about another kanshi, not doctor's)."""
        self.show_values()
        self.controls["night-light.temperature"][0].set_sensitive(self.value("night-light.enabled"))

        def read():
            return read_screens(), read_profiles(), display_daemons()[1]

        self.ui.background(read, self.show, key=(self, "read"))

    def show(self, result, error):
        for listbox in (self.screens, self.kept):
            for child in listbox.get_children():
                listbox.remove(child)
        if error:
            self.status.set_text(error)
            self.keep.set_sensitive(False)
            return
        screens, profiles, others = result
        for screen in screens:
            title, details = describe_screen(screen)
            self.screens.add(self.ui.row(title, None, details))
        name, text = screens_profile(screens)
        kept = {profile: profile_text for profile, _, profile_text in profiles}
        overlaps = overlapping_screens(screens)
        if overlaps:
            state = overlap_message(overlaps)
        elif name not in kept:
            state = "Not kept: this arrangement lasts until you log out."
        elif kept[name] == text:
            state = "Kept: these screens are set up this way whenever they are connected."
        else:
            state = "Kept, but changed since: keep it again to use it from now on."
        self.state.set_text(state)
        self.keep.set_sensitive(bool(screens) and not overlaps and kept.get(name) != text)
        for profile, title, _ in profiles:
            forget = self.ui.Gtk.Button.new_with_label("Forget")
            forget.connect("clicked", lambda _b, p=profile: self.forget(p))
            self.kept.add(self.ui.row(title, forget, "The screens connected now" if profile == name else None))
        if not profiles:
            self.kept.add(self.ui.row("None yet", None, "Each screen starts with its own best resolution."))
        self.screens.show_all()
        self.kept.show_all()
        self.ui.set_notice(self.notice, ["Another kanshi is running (your own setup), so FlickOS doesn't start "
                                         "its own; the arrangements kept here apply when it isn't running."]
                           if others else [])


def format_example(formats, numbers):
    """Today's date and time and a number, as the formats show them."""
    def output(command, locale):
        with contextlib.suppress(OSError, subprocess.TimeoutExpired):
            result = subprocess.run(command, capture_output=True, text=True, timeout=COMMAND_SECONDS, check=False,
                                    env=dict(os.environ, LC_ALL=locale))
            return result.stdout.strip() if result.returncode == 0 else ""
        return ""

    parts = [output(["date", "+%x %X"], formats), output(["printf", "%'.2f", "1234567.89"], numbers)]
    return "   ".join(part for part in parts if part)


class RegionPage(SettingsPage):
    """Language and formats of this account (LANG and LC_* in the labwc
    environment, `flickos-control set locale.*`), the system's through
    localectl, and adding a locale that isn't generated yet through the
    helper (locale-gen)."""

    def __init__(self, ui):
        super().__init__(ui, "The language of menus and apps, and how dates, times, numbers and money look. "
                             "Apps you open from now on use them; the panel and the apps already open use "
                             "them after you log out and in again.")
        Gtk, row = ui.Gtk, ui.row
        self.names = {}             # locale_key -> (locale, name), read the first time
        self.installed = set()
        self.system = {}
        self.language = Gtk.ComboBoxText()
        self.formats = Gtk.ComboBoxText()
        for key, combo in (("locale.language", self.language), ("locale.formats", self.formats)):
            combo.set_size_request(300, -1)
            combo.set_sensitive(False)          # until the names are read
            combo.connect("changed", self.chosen, key)
        self.example = ui.label("", dim=True, wrap=False)
        self.system_button = Gtk.Button.new_with_mnemonic("_Use for the Whole System…")
        self.system_button.set_sensitive(False)
        self.system_button.connect("clicked", self.use_for_system)
        self.group("Your account", None, [
            row("Language", self.language), row("Formats", self.formats), row("Example", self.example),
        ])
        self.system_row = row("Login screen and new accounts", self.system_button, "")
        self.group("System", "Needs an administrator's password.", [self.system_row])
        self.box.pack_start(ui.label("Some apps bring their translations in a package of their own, for example "
                                     "Firefox (firefox-esr-l10n-…) and LibreOffice (libreoffice-l10n-…).",
                                     dim=True), False, False, 0)
        self.box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        return os.path.isfile(I18N_SUPPORTED) and bool(shutil.which("localectl"))

    def name(self, locale):
        return self.names.get(locale_key(locale), (locale, locale_name(locale)))[1]

    def read(self):
        names = self.names or {locale_key(locale): (locale, locale_name(locale)) for locale in supported_locales()}
        system = system_locale()
        env = dict(locale_environment(self.values, True, system))
        return names, installed_locales(), system, format_example(env.get("LC_TIME", ""), env.get("LC_NUMERIC", ""))

    def reload(self):
        super().reload()
        self.ui.background(self.read, self.fill, key=(self, "read"))

    def fill(self, result, error):
        if error:
            self.status.set_text(error)
            return
        self.names, self.installed, self.system, example = result
        by_name = sorted(self.names.values(), key=lambda item: item[1].casefold())
        self.quiet = True
        for key, combo, default in (
                ("locale.language", self.language, f"Same as the system: {self.name(self.system.get('LANG', 'C'))}"),
                ("locale.formats", self.formats, f"Same as the system: {self.name(self.system['LC_TIME'])}"
                 if self.system.get("LC_TIME") else "Same as the language")):
            chosen = self.values.get(key)
            combo.remove_all()
            combo.append("default", default)
            for locale, name in by_name:
                combo.append(locale, name)
            if chosen and not combo.set_active_id(self.names.get(locale_key(chosen), (chosen,))[0]):
                combo.append(chosen, self.name(chosen))
                combo.set_active_id(chosen)
            if not chosen:
                combo.set_active_id("default")
            combo.set_sensitive(True)
        self.quiet = False
        self.example.set_text(example)
        language, formats = self.values.get("locale.language"), self.values.get("locale.formats")
        now = system_locale_args(self.system, None, None)
        self.system_button.set_sensitive(system_locale_args(self.system, language, formats) != now)
        described = self.name(self.system.get("LANG", "C"))
        if self.system.get("LC_TIME") and locale_key(self.system["LC_TIME"]) != locale_key(self.system.get("LANG", "")):
            described += f", formats {self.name(self.system['LC_TIME'])}"
        self.ui.set_subtitle(self.system_row, f"Now: {described}")

    def chosen(self, combo, key):
        locale = combo.get_active_id()
        if self.quiet or not locale:
            return
        if locale == "default" or locale_key(locale) in self.installed:
            self.change(key, locale)
            return
        self.status.set_text(f"Adding {self.name(locale)}: this needs an administrator's password and takes a "
                             "moment…")
        for widget in (self.language, self.formats):
            widget.set_sensitive(False)

        def done(ok, stdout, stderr):
            if ok:
                self.installed.add(locale_key(locale))
                record(f"language.{locale}", "absent", "added")
                self.change(key, locale)
                return
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) or f"{self.name(locale)} was not added.")
            self.reload()

        self.ui.run_async(["pkexec", HELPER, "locale-add", locale], done)

    def use_for_system(self, _button):
        args = system_locale_args(self.system, self.values.get("locale.language"), self.values.get("locale.formats"))
        self.system_button.set_sensitive(False)
        self.status.set_text("Waiting for the password…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("The login screen uses it from its next start, accounts without a choice of "
                                 "their own from their next login." if ok else
                                 "\n".join(messages) or "The system language was not changed.")
            self.reload()

        self.ui.run_async(["localectl", "set-locale", *args], done)

    @staticmethod
    def affected_by(warning):
        return "environment" in warning


class NotificationsPage(SettingsPage):
    """Do Not Disturb: mako's mode (flickos-control set notifications.*)."""

    def __init__(self, ui):
        super().__init__(ui, "Notifications appear at the edge of the screen for a few seconds. Click one to "
                             "close it.")
        self.group("Do Not Disturb", None, [
            ui.row("Do Not Disturb", self.control("notifications.do-not-disturb"),
                   "Notifications are not shown, except urgent ones such as a nearly empty battery. "
                   "It stays on until you turn it off."),
        ])
        self.box.pack_start(self.status, False, False, 0)

    def reload(self):
        """The notice is about the user's own mako config, not doctor's."""
        self.show_values()
        problem = mako_config_problem()
        self.ui.set_notice(self.notice, [problem] if problem else [])


class AccessibilityPage(SettingsPage):
    """Screen zoom: labwc's magnifier (flickos-control set zoom.*). Its keys
    are flickos-settings' and only shown here. Animations: GSettings'
    enable-animations (flickos-control animations)."""

    def __init__(self, ui):
        super().__init__(ui, "Zoom in to see small things larger: Super+= zooms in and Super+- zooms out, "
                             "or hold Super and scroll. Super+0 turns zoom off, and back on.")
        self.group("Zoom", None, [
            ui.row("Zoom", self.control("zoom.area"), "The part of the screen that zooms follows the pointer"),
            ui.row("Lens size", self.control("zoom.lens-size")),
            ui.row("Zoom step", self.control("zoom.step"), "How much each key press or scroll zooms"),
            ui.row("Smooth", self.control("zoom.smooth"), "Off shows sharp square pixels"),
        ])
        Gtk = ui.Gtk
        self.animations = Gtk.Switch(valign=Gtk.Align.CENTER, sensitive=False)   # until it is read
        self.animations.connect("notify::active", self.animations_switched)
        self.animations_quiet = False
        self.group("Motion", None, [
            ui.row("Animations", self.animations,
                   "The start menu and other pop-ups fade in and out, and apps animate their controls. "
                   "Off shows everything at once"),
        ])
        self.box.pack_start(self.status, False, False, 0)
        self.show_lens_size()

    def shown(self):
        super().shown()
        self.ui.background(animations, self.show_animations, key=(self, "animations"))

    def show_animations(self, value, error):
        self.animations_quiet = True
        self.animations.set_active(value == "on")
        self.animations.set_sensitive(error is None)
        self.animations_quiet = False
        if error:
            self.status.set_text(error)

    def animations_switched(self, switch, _param):
        if self.animations_quiet:
            return

        def done(_ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(m for m in messages if not m.startswith("Animations:")))
            self.ui.background(animations, self.show_animations, key=(self, "animations"))

        self.ui.run_async([*SELF, "animations", "set", "on" if switch.get_active() else "off"], done)

    def show_values(self):
        super().show_values()
        self.show_lens_size()

    def show_lens_size(self):
        self.controls["zoom.lens-size"][0].set_sensitive(self.value("zoom.area") == "lens")

    @staticmethod
    def affected_by(warning):
        return "rc.xml" in warning


class StartupPage:
    """Startup applications (`flickos-control startup`): XDG autostart entries,
    on or off, the user's own added or removed."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label("Apps that start when you log in. An app you tell to start with the desktop "
                                "in its own settings appears here too. Changes apply from the next login."),
                       False, False, 0)
        frame, self.rows = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        add = Gtk.Button.new_with_mnemonic("_Add App…")
        add.set_halign(Gtk.Align.START)
        add.connect("clicked", self.add_clicked)
        box.pack_start(add, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def run(self, command):
        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            self.shown()

        self.ui.run_async(command, done)

    def add_clicked(self, _button):
        Gtk = self.ui.Gtk
        dialog = Gtk.Dialog(title="Add a Startup App", transient_for=self.widget.get_toplevel(), modal=True)
        dialog.add_buttons("_Cancel", Gtk.ResponseType.CANCEL, "_Add", Gtk.ResponseType.OK)
        dialog.set_default_size(460, 520)
        chooser = Gtk.AppChooserWidget(content_type="application/octet-stream", show_all=True,
                                       show_default=False, show_recommended=False, show_fallback=False,
                                       show_other=False)
        chooser.connect("application-activated", lambda *_: dialog.response(Gtk.ResponseType.OK))
        dialog.get_content_area().pack_start(chooser, True, True, 0)
        dialog.show_all()
        response = dialog.run()
        app = chooser.get_app_info()
        dialog.destroy()
        if response == Gtk.ResponseType.OK and app is not None and app.get_id():
            self.run([*SELF, "startup", "add", app.get_id()])

    def switched(self, switch, _param, entry_id):
        if not self.quiet:
            self.run([*SELF, "startup", "enable" if switch.get_active() else "disable", entry_id])

    def shown(self):
        self.ui.background(startup_entries, self.show, key=(self, "read"))

    def show(self, entries, error):
        Gtk = self.ui.Gtk
        for child in self.rows.get_children():
            self.rows.remove(child)
        if error:
            self.status.set_text(error)
            return
        self.quiet = True
        for entry in entries:
            widgets = Gtk.Box(spacing=12)
            if not entry.system:
                remove = Gtk.Button.new_with_label("Remove")
                remove.connect("clicked", lambda _b, e=entry.id: self.run([*SELF, "startup", "remove", e]))
                widgets.pack_start(remove, False, False, 0)
            switch = Gtk.Switch(active=entry.enabled, valign=Gtk.Align.CENTER)
            switch.connect("notify::active", self.switched, entry.id)
            widgets.pack_start(switch, False, False, 0)
            self.rows.add(self.ui.row(entry.name, widgets, entry.comment or " ".join(
                shlex.quote(word) for word in exec_argv_or_none(entry) or [])))
        if not entries:
            self.rows.add(self.ui.row("None", None, "Only the desktop itself starts at login."))
        self.quiet = False
        self.rows.show_all()


def exec_argv_or_none(entry):
    with contextlib.suppress(ControlError):
        return exec_argv(entry.entry, entry.path)
    return None


class ScreenshotsPage:
    """Where screenshots and recordings are saved, the pointer, and a
    recording's sound (flickos-screenshot). It owns none of them: `state`
    reads them and `set` changes them. The keys are flickos-shortcuts'."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        self.state = {}
        self.folders = {}
        self.shown_shortcuts = None
        box.pack_start(ui.label("A screenshot is saved and copied. A recording is a video. "
                                "These apply to the next one."), False, False, 0)
        frame, rows = ui.framed_list()
        self.folders["folder"] = self.folder_row(
            rows, "folder", "Save screenshots in", "Save Screenshots In",
            "Pictures/Screenshots, unless you choose another folder.")
        self.folders["recordings-folder"] = self.folder_row(
            rows, "recordings-folder", "Save recordings in", "Save Recordings In",
            "Videos/Screen Recordings, unless you choose another folder.")
        self.pointer = Gtk.Switch()
        self.pointer.connect("notify::active", self.pointer_toggled)
        rows.add(ui.row("Include the pointer", self.pointer,
                        "In screenshots. A recording always shows it."))
        sound_row, self.select_sound = ui.combo_row(
            "Sound in a recording", [Item(sound, name) for sound, name in SCREENSHOT_SOUNDS],
            "none", self.choose_sound)
        rows.add(sound_row)
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.heading("Screenshot keys"), False, False, 0)
        self.shortcuts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.shortcuts, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def folder_row(self, rows, key, title, dialog_title, subtitle):
        Gtk = self.ui.Gtk
        box = Gtk.Box(spacing=6)
        choose = Gtk.Button.new_with_label("Choose…")
        choose.set_tooltip_text("Choose a folder.")
        choose.connect("clicked", self.choose_folder, key, dialog_title)
        usual = Gtk.Button.new_with_label("Usual Folder")
        usual.set_tooltip_text("The folder FlickOS uses for this computer.")
        usual.connect("clicked", lambda _b, setting=key: self.send(["set", setting, "default"]))
        box.pack_start(choose, False, False, 0)
        box.pack_start(usual, False, False, 0)
        row = self.ui.row(title, box, subtitle)
        rows.add(row)
        return row, usual

    @staticmethod
    def available():
        return shutil.which(SCREENSHOT) is not None

    def shown(self):
        def read():
            try:
                state = json.loads(run([SCREENSHOT, "state"]))
            except ValueError:
                raise ControlError("flickos-screenshot gave no settings") from None
            if not isinstance(state, dict):
                raise ControlError("flickos-screenshot gave no settings")
            try:
                sheet = run([SHORTCUTS, "list"])
            except ControlError as error:
                sheet = error
            return state, sheet

        self.ui.background(read, self.show, key=(self, "state"))

    def show(self, result, error):
        self.loading.hide()
        if error:
            self.status.set_text(error)
            return
        state, sheet = result
        self.state = state
        self.quiet = True
        for key, (row, usual) in self.folders.items():
            item = state.get(key) or {}
            value = item.get("value") or ""
            self.ui.set_subtitle(row, home_folder(value) if value else "")
            usual.set_sensitive(not item.get("default", True))
        pointer = (state.get("pointer") or {}).get("value") == "yes"
        self.pointer.set_active(pointer)
        self.select_sound((state.get("sound") or {}).get("value") or "none")
        self.quiet = False
        self.fill_shortcuts(sheet)

    def fill_shortcuts(self, sheet):
        text = str(sheet)
        if text == self.shown_shortcuts:
            return
        self.shown_shortcuts = text
        for child in self.shortcuts.get_children():
            self.shortcuts.remove(child)
        if isinstance(sheet, ControlError):
            self.ui.error(self.shortcuts, str(sheet))
        else:
            found = [section for section in parse_shortcuts(sheet) if section[0] == "Screenshots"]
            if not found:
                self.shortcuts.pack_start(self.ui.label("No screenshot keys are set.", dim=True), False, False, 0)
            for _name, rows in found:
                frame, listbox = self.ui.framed_list()
                for keys, description in rows:
                    listbox.add(self.ui.row(description, self.ui.label(keys, dim=True, wrap=False)))
                self.shortcuts.pack_start(frame, False, False, 0)
        self.shortcuts.show_all()

    def send(self, words):
        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("" if ok else "\n".join(messages))
            self.shown()

        self.ui.run_async([SCREENSHOT, *words], done)

    def pointer_toggled(self, switch, _param):
        if not self.quiet:
            self.send(["set", "pointer", "yes" if switch.get_active() else "no"])

    def choose_sound(self, sound):
        if not self.quiet:
            self.send(["set", "sound", sound])

    def choose_folder(self, _button, key, title):
        Gtk = self.ui.Gtk
        dialog = Gtk.FileChooserDialog(title=title,
                                       transient_for=self.widget.get_toplevel(), modal=True,
                                       action=Gtk.FileChooserAction.SELECT_FOLDER)
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("_Choose", Gtk.ResponseType.ACCEPT)
        current = (self.state.get(key) or {}).get("value")
        if current and os.path.isdir(current):
            dialog.set_current_folder(current)
        try:
            chosen = dialog.get_filename() if dialog.run() == Gtk.ResponseType.ACCEPT else None
        finally:
            dialog.destroy()
        if chosen:
            self.send(["set", key, chosen])


class UpdatesPage:
    """Automatic updates: unattended-upgrades' settings (read with apt-config,
    changed through the helper's updates verb)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        # flickos-software's daily timer updates Flatpak apps while these are on
        # (its software-update script reads the same apt settings).
        flatpaks = (" Apps installed from Flathub are updated with them." if shutil.which("flickos-software")
                    else "")
        box.pack_start(ui.label("Updates are installed in the background every day, so security fixes arrive "
                                "without anyone having to remember." + flatpaks + " Software Updates shows and "
                                "installs every update at any time."), False, False, 0)
        frame, listbox = ui.framed_list()
        self.auto = Gtk.Switch()
        self.auto.connect("notify::active", lambda w, _p: self.change("auto", "yes" if w.get_active() else "no"))
        self.auto_row = ui.row("Install updates automatically", self.auto, "")
        listbox.add(self.auto_row)
        self.scope = Gtk.ComboBoxText()
        self.reboot = Gtk.ComboBoxText()
        for combo, names, setting in ((self.scope, UPDATE_SCOPE_NAMES, "scope"),
                                      (self.reboot, UPDATE_REBOOT_NAMES, "reboot")):
            combo.set_size_request(300, -1)
            # "custom" and restarting while someone is logged in only show
            # when an administrator set them, an old scope while it is set.
            for key, name in names.items():
                if key not in ("custom", "always", *OLD_UPDATE_SCOPES):
                    combo.append(key, name)
            combo.connect("changed", lambda w, setting=setting: w.get_active_id()
                          and w.get_active_id() not in ("custom", *OLD_UPDATE_SCOPES)
                          and self.change(setting, w.get_active_id()))
        listbox.add(ui.row("Which updates", self.scope))
        listbox.add(ui.row("Restart when an update needs it", self.reboot,
                           "Some updates (the Linux kernel) take effect after a restart"))
        box.pack_start(frame, False, False, 0)
        # Left out while the viewer (gnome-package-updater, a Recommends that
        # upgraded systems may lack) isn't installed; shown() checks again.
        self.buttons = Gtk.Box(spacing=12)
        self.buttons.set_no_show_all(True)
        check = Gtk.Button.new_with_mnemonic("_Check for Updates Now…")
        check.set_tooltip_text(f"Open Software Updates ({UPDATE_VIEWER[0]})")
        check.connect("clicked", lambda _b: ui.start_app(UPDATE_VIEWER))
        check.show()
        self.buttons.pack_start(check, False, False, 0)
        box.pack_start(self.buttons, False, False, 0)
        box.pack_start(ui.label("Changing these needs an administrator's password.", dim=True), False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)
        for widget in (self.auto, self.scope, self.reboot):
            widget.set_sensitive(False)         # until the settings are read

    @staticmethod
    def available():
        return os.path.exists(UNATTENDED_UPGRADE) and not live_session()

    def change(self, setting, value):
        if self.quiet:
            return
        self.status.set_text("Waiting for the password…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            self.shown()

        self.ui.run_async([*SELF, "system", f"updates.{setting}", value], done)

    def shown(self):
        self.buttons.set_visible(bool(shutil.which(UPDATE_VIEWER[0])))
        self.ui.background(updates_state, self.show, key=(self, "read"))

    def show(self, state, error):
        if error:
            self.status.set_text(error)
            return
        self.quiet = True
        self.auto.set_active(state["auto"])
        for combo, value, names in ((self.scope, state["scope"], UPDATE_SCOPE_NAMES),
                                    (self.reboot, state["reboot"], UPDATE_REBOOT_NAMES)):
            if not combo.set_active_id(value):
                combo.append(value, names.get(value, value))
                combo.set_active_id(value)
        self.auto.set_sensitive(True)
        for combo in (self.scope, self.reboot):
            combo.set_sensitive(state["auto"])
        self.quiet = False
        last = time.strftime("%A %d %B, %H:%M", time.localtime(state["last"])) if state["last"] else "not yet"
        self.ui.set_subtitle(self.auto_row, f"Last run: {last}")


class DateTimePage:
    """Time zone and network time (timedatectl, with polkit's password dialog)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        self.clock = ui.label("", wrap=False, markup=True)
        box.pack_start(self.clock, False, False, 0)
        frame, listbox = ui.framed_list()
        self.regions = Gtk.ComboBoxText()
        self.regions.set_size_request(200, -1)
        self.regions.connect("changed", self.region_chosen)
        self.cities = Gtk.ComboBoxText()
        self.cities.set_size_request(260, -1)
        self.cities.connect("changed", self.city_chosen)
        self.regions.get_accessible().set_name("Time zone region")
        self.cities.get_accessible().set_name("Time zone city")
        zone_box = Gtk.Box(spacing=6)
        zone_box.pack_start(self.regions, False, False, 0)
        zone_box.pack_start(self.cities, False, False, 0)
        self.zone_row = ui.row("Time zone", zone_box, "")
        listbox.add(self.zone_row)
        self.ntp = Gtk.Switch()
        self.ntp.connect("notify::active", self.ntp_changed)
        self.ntp_row = ui.row("Set the time automatically", self.ntp, "")
        listbox.add(self.ntp_row)
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.label("Changing these needs an administrator's password.", dim=True), False, False, 0)
        # The panel clock's hours (flickos-layout clock), for this account.
        self.clock_format = Gtk.ComboBoxText()
        self.clock_format.set_size_request(200, -1)
        self.clock_format.connect("changed", self.clock_chosen)
        clock_frame, clock_list = ui.framed_list()
        self.clock_row = ui.row("Time format", self.clock_format, "The clock on the panel")
        clock_list.add(self.clock_row)
        self.clock_frame = clock_frame
        clock_frame.set_no_show_all(True)       # until flickos-layout says it has the choice
        box.pack_start(clock_frame, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)
        self.zones = {}             # read with the settings the first time
        self.twelve_hour = False    # the clock above follows the panel's
        ui.GLib.timeout_add_seconds(1, self.tick)

    def tick(self):
        hours = time.strftime("%I:%M:%S %p" if self.twelve_hour else "%H:%M:%S")
        self.clock.set_markup(f"<big><b>{hours}</b></big>   {time.strftime('%A %d %B %Y')}")
        return True

    def fill_cities(self, region, zone=None):
        self.cities.remove_all()
        for city, name in sorted(self.zones.get(region, [])):
            self.cities.append(name, city)
        if zone:
            self.cities.set_active_id(zone)

    def region_chosen(self, combo):
        if self.quiet:
            return
        self.quiet = True
        self.fill_cities(combo.get_active_id())
        self.quiet = False

    def city_chosen(self, combo):
        zone = combo.get_active_id()
        if self.quiet or not zone:
            return
        self.status.set_text("Waiting for the password…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("" if ok else "\n".join(messages) or "The time zone was not changed.")
            self.shown()

        self.ui.run_async([*SELF, "system", "timezone", zone], done)

    def ntp_changed(self, switch, _param):
        if self.quiet:
            return

        def done(ok, stdout, stderr):
            self.status.set_text("" if ok else "\n".join(output_messages(stdout, stderr)) or "Not changed.")
            self.shown()

        self.ui.run_async([*SELF, "system", "ntp", "yes" if switch.get_active() else "no"], done)

    def shown(self):
        self.tick()
        need_zones = not self.zones

        def read():
            zones = zones_by_region(run(["timedatectl", "list-timezones"]).split()) if need_zones else None
            return zones, time_settings(run(["timedatectl", "show"]))

        self.ui.background(read, self.show_settings, key=(self, "read"))

        def read_clock():
            try:
                return parse_items(run([LAYOUT, "clock", "list"])), run([LAYOUT, "clock", "current"]).strip()
            except ControlError:
                return None                 # flickos-layouts before 1.20: no choice

        self.ui.background(read_clock, self.show_clock, key=(self, "clock"))

    def show_clock(self, result, error):
        if not result:
            self.clock_frame.hide()
            return
        items, current = result
        self.quiet = True
        self.clock_format.remove_all()
        for item in items:
            self.clock_format.append(item.id, f"{item.name} ({item.comment})" if item.comment else item.name)
        self.clock_format.set_active_id(current)
        self.quiet = False
        self.twelve_hour = current == "12h"
        self.tick()
        self.clock_frame.set_no_show_all(False)
        self.clock_frame.show_all()

    def clock_chosen(self, combo):
        choice = combo.get_active_id()
        if self.quiet or not choice:
            return

        def done(ok, stdout, stderr):
            self.status.set_text("" if ok else "\n".join(output_messages(stdout, stderr)) or "Not changed.")
            self.shown()

        self.ui.run_async([LAYOUT, "clock", "set", choice], done)

    def show_settings(self, result, error):
        if error:
            self.status.set_text(error)
            return
        zones, settings = result
        if zones and not self.zones:
            self.zones = zones
            for region in sorted(zones):
                self.regions.append(region, region)
        zone = settings.get("Timezone", "")
        region, _, city = zone.partition("/")
        if not city:
            region = "Other"
        self.quiet = True
        self.regions.set_active_id(region)
        self.fill_cities(region, zone)
        can_ntp = settings.get("CanNTP") == "yes"
        self.ntp.set_active(settings.get("NTP") == "yes")
        self.ntp.set_sensitive(can_ntp)
        self.quiet = False
        self.ui.set_subtitle(self.zone_row, zone)
        synced = "synchronized" if settings.get("NTPSynchronized") == "yes" else "not synchronized yet"
        self.ui.set_subtitle(self.ntp_row, f"From time servers on the internet ({synced})" if can_ntp
                             else "Needs systemd-timesyncd, which is not installed")


class LoginPage:
    """Autologin (flickos-greeter's group) through the helper."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label("Start the desktop without asking for your password when the computer "
                                "starts. Anyone who switches the computer on gets your desktop, so only "
                                "use it on a computer nobody else uses."), False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.changed)
        self.row = ui.row("Log in automatically", self.switch, "")
        listbox.add(self.row)
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.label("Changing this needs an administrator's password.", dim=True), False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        return autologin_state()[0]

    def changed(self, switch, _param):
        if self.quiet:
            return
        self.status.set_text("Waiting for the password…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            self.shown()

        self.ui.run_async([*SELF, "system", "autologin", "on" if switch.get_active() else "off"], done)

    def shown(self):
        _, user = autologin_state()
        me = user_name()
        self.quiet = True
        self.switch.set_active(user == me)
        self.quiet = False
        self.ui.set_subtitle(self.row, f"{user} is logged in automatically now; turning this on replaces them."
                             if user and user != me else f"As {me}, once per start of the computer")


class FirewallPage:
    """The ufw firewall on or off through the helper. Its rules stay a job for
    `sudo ufw` (they need root even to read)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label("The firewall blocks connections that other computers start to this one. "
                                "Programs on this computer can still connect out and get their answers, so "
                                "the internet, updates and finding printers on the network all work with it "
                                "on."), False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.changed)
        self.row = ui.row("Firewall", self.switch, "")
        listbox.add(self.row)
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.label("Changing this needs an administrator's password. To let one program in "
                                "while the firewall is on, for example SSH, type sudo ufw allow 22/tcp in a "
                                "terminal.", dim=True), False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        return firewall_state() is not None

    def changed(self, switch, _param):
        if self.quiet:
            return
        self.status.set_text("Waiting for the password…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            self.shown()

        self.ui.run_async([*SELF, "system", "firewall", "on" if switch.get_active() else "off"], done)

    def shown(self):
        on = bool(firewall_state())
        self.quiet = True
        self.switch.set_active(on)
        self.quiet = False
        text = ("On: other computers can't connect to this one" if on
                else "Off: other computers can connect to programs that wait for them")
        if live_session():
            text += " (in the live session until it restarts)"
        self.ui.set_subtitle(self.row, text)


class PrivacyPage:
    """The anonymous weekly count (flickos-countme), shown while it is installed."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label("FlickOS counts how many computers run it, without knowing which ones. Once a "
                                "week this computer sends only the FlickOS version and roughly how long ago it "
                                "was installed: no name, no machine id, no hardware, no list of programs. The "
                                "server keeps only the weekly totals."), False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.changed)
        self.row = ui.row("Count this computer", self.switch, "")
        listbox.add(self.row)
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.heading("What is sent"), False, False, 0)
        self.request = ui.label("", dim=True)
        self.request.set_selectable(True)
        box.pack_start(self.request, False, False, 0)
        box.pack_start(ui.label("Turning it on needs an administrator's password.", dim=True), False, False, 0)
        link = Gtk.LinkButton.new_with_label(PRIVACY_URL, "Privacy details")
        link.set_halign(Gtk.Align.START)
        box.pack_start(link, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        return shutil.which(COUNTME) is not None

    def changed(self, switch, _param):
        if self.quiet:
            return
        if switch.get_active():
            self.status.set_text("Waiting for the password…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            self.shown()

        self.ui.run_async([COUNTME, "enable" if switch.get_active() else "disable"], done)

    def shown(self):
        self.ui.background(lambda: countme_state(run([COUNTME, "status"])), self.show, key=(self, "read"))

    def show(self, state, error):
        if error:
            self.status.set_text(error)
            return
        self.quiet = True
        self.switch.set_active(state.enabled)
        self.quiet = False
        if state.reason == "live session":
            subtitle = "Never sent from the live session"
        elif not state.enabled:
            subtitle = "Nothing is sent"
        elif state.reason:
            subtitle = f"Not sent now: {state.reason}"
        elif state.last_week:
            subtitle = f"Last counted in week {state.last_week}"
        else:
            subtitle = "Not counted yet"
        self.ui.set_subtitle(self.row, subtitle)
        self.request.set_text(f"GET {state.request}" if state.request else "")


class RestorePointsPage:
    """Restore points (flickos-recovery): shown on FlickOS's btrfs layout only."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label("Before every software change FlickOS takes a restore point. If an update "
                                "breaks something, put the system back to before it: the software, system "
                                "settings, passwords and accounts go back to how they were then. Your own files "
                                "stay as they are."), False, False, 0)
        box.pack_start(ui.label("A restore point is not a backup: it is on the same disk as the system. Keep "
                                "copies of your files somewhere else too.", dim=True), False, False, 0)
        # Started from a restore point (by itself after failed starts, or from the boot menu).
        self.booted = Gtk.InfoBar(message_type=Gtk.MessageType.INFO, no_show_all=True)
        self.booted_text = ui.label("")
        self.booted_text.set_max_width_chars(100)
        self.booted.get_content_area().add(self.booted_text)
        self.booted_text.show()
        self.booted.add_button("_Keep…", 1)
        self.try_again = self.booted.add_button("_Try Again", 2)
        self.booted.connect("response", self.booted_response)
        box.pack_start(self.booted, False, False, 0)
        self.notice = ui.notice()
        self.notice.add_button("_Restart Now", 1)
        self.notice.connect("response", lambda _bar, _response: self.restart())
        box.pack_start(self.notice, False, False, 0)
        # Above the list: a put back's result shows where it was clicked (WIN-10).
        self.status = ui.status_label()
        self.status.set_no_show_all(True)
        box.pack_start(self.status, False, False, 0)
        box.pack_start(ui.heading("Restore points"), False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        frame, self.points = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        self.make = Gtk.Button.new_with_mnemonic("_Make a Restore Point Now")
        self.make.set_halign(Gtk.Align.START)
        self.make.connect("clicked", lambda _b: self.change([RECOVERY, "create", "Made in Settings"],
                                                            "Making a restore point…", "Restore point made."))
        box.pack_start(self.make, False, False, 0)
        box.pack_start(ui.heading("Settings"), False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.switched)
        self.switch_row = ui.row("Take a restore point before software changes", self.switch, "")
        listbox.add(self.switch_row)
        self.delete = Gtk.Button.new_with_mnemonic("_Delete All…")
        self.delete.connect("clicked", self.ask_delete)
        self.space = ui.row("Disk space", self.delete, "")
        listbox.add(self.space)
        self.auto = Gtk.Switch()
        self.auto.connect("notify::active", self.auto_switched)
        listbox.add(ui.row("Start a restore point by itself after failed starts", self.auto,
                           "After 2 starts that didn't reach the login screen. When off, the boot menu waits "
                           "with it highlighted."))
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.label("Changing restore points needs an administrator's password.", dim=True),
                       False, False, 0)

    @staticmethod
    def available():
        return recovery_available()

    def shown(self):
        self.loading.show_all()
        self.ui.background(recovery_state, self.show, key=(self, "read"))

    def show(self, state, error):
        Gtk = self.ui.Gtk
        self.loading.hide()
        for child in self.points.get_children():
            self.points.remove(child)
        if error:
            self.say(error)
            return
        waiting = state.get("restart_needed")
        booted = state.get("booted")
        names = {point["name"]: point["description"] for point in state.get("points", [])}
        start = state.get("start") or {}
        recovered = bool(booted) and start.get("mode") == "recovering" and start.get("rp") == booted
        what = names.get(booted, booted or "")
        self.booted_text.set_text(
            f"FlickOS started from the restore point \u201c{what}\u201d because the last starts didn't reach "
            "the login screen. Nothing you change now is kept. Keep it, or try the system as it is again."
            if recovered else
            f"The computer runs from the restore point \u201c{what}\u201d. Nothing you change now is kept. "
            "Keep it to make it the system.")
        self.try_again.set_visible(recovered)
        self.booted.set_visible(bool(booted) and not waiting)
        self.ui.set_notice(self.notice, ["A restore point was put back. Restart the computer to use it; until "
                                         "then, software can't be installed or removed."] if waiting else [])
        for point in reversed(state.get("points", [])):
            when = point["description"].rsplit(", ", 1)
            button = Gtk.Button.new_with_mnemonic("Put Back…")
            button.set_sensitive(not waiting)
            button.connect("clicked", self.put_back, point["name"])
            self.points.add(self.ui.row(when[0], button, when[1] if len(when) > 1 else point["name"]))
        if not state.get("points"):
            self.points.add(self.ui.row("No restore points yet", None,
                                        "One is taken before the next software change."))
        self.points.show_all()
        self.quiet = True
        self.switch.set_active(bool(state.get("enabled")))
        self.quiet = False
        self.ui.set_subtitle(self.switch_row, f"The newest {state.get('keep', 5)} are kept" if state.get("enabled")
                             else "No restore point is taken")
        self.make.set_sensitive(bool(state.get("enabled")) and not waiting and not booted)
        self.quiet = True
        self.auto.set_active(bool(state.get("auto_recover")))
        self.quiet = False
        free, minimum = state.get("free_bytes") or 0, state.get("min_free_bytes") or 0
        self.ui.set_subtitle(self.space, f"{free / 1024 ** 3:.1f} GB free. None is taken with less than "
                                         f"{minimum / 1024 ** 3:.1f} GB free.")
        self.delete.set_sensitive(bool(state.get("points")) and not waiting)

    def say(self, text):
        self.status.set_text(text)
        self.status.set_visible(bool(text))

    def change(self, command, doing, success=None):
        self.say(doing)

        def done(ok, stdout, stderr):
            messages = output_messages(stdout if success is None else "", stderr)
            self.say(success if ok and success else "\n".join(messages) if messages or ok else "Not changed.")
            self.shown()

        self.ui.run_async(command, done)

    def switched(self, switch, _param):
        if self.quiet:
            return
        self.change([*SELF, "system", "restore-points", "on" if switch.get_active() else "off"],
                    "Waiting for the password…")

    def auto_switched(self, switch, _param):
        if self.quiet:
            return
        self.change([*SELF, "system", "restore-points.auto", "on" if switch.get_active() else "off"],
                    "Waiting for the password…")

    def booted_response(self, _bar, response):
        if response == 2:
            self.change([RECOVERY, "start", "try-again"], "Waiting for the password…",
                        "The next start uses the system as it is. Restart the computer to try it.")
            return
        if response != 1:
            return
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text="Keep this restore point?")
        dialog.format_secondary_text("The system goes back to it for good: software, system settings, "
                                     "passwords and accounts as they were then. Your own files stay as they are. "
                                     "The system as it was is kept as a restore point, so this can be undone. It "
                                     "takes effect when the computer restarts, and needs an administrator's "
                                     "password.")
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        ok = dialog.add_button("_Keep", Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        answer = dialog.run()
        dialog.destroy()
        if answer == Gtk.ResponseType.OK:
            self.change([RECOVERY, "start", "keep"], "Waiting for the password…",
                        "Kept. Restart the computer to use it.")

    def put_back(self, button, name):
        button.set_sensitive(False)
        self.say("Checking what would change…")

        def done(ok, message):
            self.say(message)
            if ok is not None:
                self.shown()

        ask_put_back(self.ui, self.widget.get_toplevel(), name, done)

    def ask_delete(self, _button):
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text="Delete all restore points?")
        dialog.format_secondary_text("This frees the space they hold. The system can then not be put back to "
                                     "before the changes made so far. A new restore point is taken before the "
                                     "next software change.")
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        ok = dialog.add_button("_Delete All", Gtk.ResponseType.OK)
        ok.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.change([RECOVERY, "delete", "--all"], "Waiting for the password…", "All restore points deleted.")

    def restart(self):
        self.ui.run_async(["systemctl", "reboot"], lambda ok, stdout, stderr: self.say(
            "" if ok else "\n".join(output_messages(stdout, stderr)) or "The computer didn't restart."))


class UsersPage:
    """User accounts: add, remove, administrator, password (the helper's
    user-* verbs). Installed systems only: live accounts are gone at reboot."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        box.pack_start(ui.label("People who can log in to this computer. Each has their own files and "
                                "settings. Administrators can install software and change settings for "
                                "everyone."), False, False, 0)
        frame, self.rows = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        buttons = Gtk.Box(spacing=12)
        add = Gtk.Button.new_with_mnemonic("_Add User…")
        add.connect("clicked", self.add)
        buttons.pack_start(add, False, False, 0)
        box.pack_start(buttons, False, False, 0)
        box.pack_start(ui.label("Changing these needs an administrator's password. A change to "
                                "administrator takes effect at that user's next login.", dim=True), False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)
        self.quiet = False

    @staticmethod
    def available():
        return not live_session()

    def helper(self, words, stdin=None):
        self.status.set_text("Waiting for the password…")
        # For History: the account's role before, and after if it works.
        name = words[1]
        before = next((("administrator" if a.admin else "standard") for a in accounts() if a.name == name), "absent")
        after = {"user-add": "administrator" if words[-1] == "yes" else "standard", "user-remove": "absent",
                 "user-admin": "administrator" if words[-1] == "yes" else "standard"}.get(words[0])

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            if ok and after is not None:
                record(f"user.{name}", before, after)
            self.shown()

        self.ui.run_async(["pkexec", HELPER, *words], done, stdin)

    def fill(self):
        Gtk = self.ui.Gtk
        for row in self.rows.get_children():
            self.rows.remove(row)
        me = user_name()
        found = accounts()
        admins = sum(account.admin for account in found)
        self.quiet = True
        for account in found:
            details = [account.name, "administrator" if account.admin else "standard user"]
            if account.name == me:
                details.append("you")
            controls = Gtk.Box(spacing=6)
            admin = Gtk.CheckButton.new_with_mnemonic("Ad_ministrator")
            admin.set_active(account.admin)
            # The helper keeps the last administrator too; this only saves a prompt.
            admin.set_sensitive(not (account.admin and admins == 1))
            admin.connect("toggled", self.admin_toggled, account)
            controls.pack_start(admin, False, False, 0)
            password = Gtk.Button.new_with_mnemonic("_Password…")
            password.connect("clicked", self.change_password, account)
            controls.pack_start(password, False, False, 0)
            remove = Gtk.Button.new_with_mnemonic("_Remove…")
            remove.connect("clicked", self.remove, account)
            if account.name == me:
                remove.set_sensitive(False)
                remove.set_tooltip_text("You can't remove the account you are using")
            controls.pack_start(remove, False, False, 0)
            self.rows.add(self.ui.row(account.full_name or account.name, controls, " · ".join(details)))
        if not found:
            self.rows.add(self.ui.row("No user accounts found"))
        self.rows.show_all()
        self.quiet = False

    def admin_toggled(self, button, account):
        if not self.quiet:
            self.helper(["user-admin", account.name, "yes" if button.get_active() else "no"])

    def dialog(self, title, action):
        """A dialog with Cancel and action; returns (dialog, grid, action button)."""
        Gtk = self.ui.Gtk
        dialog = Gtk.Dialog(title=title, transient_for=self.widget.get_toplevel(), modal=True, resizable=False)
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        button = dialog.add_button(action, Gtk.ResponseType.OK)
        button.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=8, column_spacing=12, margin=18)
        dialog.get_content_area().add(grid)
        return dialog, grid, button

    def entry(self, grid, top, title, secret=False):
        Gtk = self.ui.Gtk
        entry = Gtk.Entry(activates_default=True, hexpand=True, width_chars=28)
        if secret:
            entry.set_visibility(False)
            entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        grid.attach(Gtk.Label(label=title, xalign=1, use_underline=True, mnemonic_widget=entry), 0, top, 1, 1)
        grid.attach(entry, 1, top, 1, 1)
        return entry

    def hint(self, grid, top):
        label = self.ui.label("", dim=True)
        grid.attach(label, 1, top, 1, 1)
        return label

    def add(self, _button):
        Gtk = self.ui.Gtk
        taken = taken_names()
        dialog, grid, ok = self.dialog("Add User", "_Add")
        full_name = self.entry(grid, 0, "_Full name")
        name = self.entry(grid, 1, "_User name")
        password = self.entry(grid, 2, "_Password", secret=True)
        again = self.entry(grid, 3, "_Confirm password", secret=True)
        admin = Gtk.CheckButton.new_with_mnemonic("Ad_ministrator: can install software and change settings "
                                                  "for everyone")
        grid.attach(admin, 1, 4, 1, 1)
        hint = self.hint(grid, 5)
        edited = []

        def check(*_args):
            problem = (full_name_problem(full_name.get_text()) or user_name_problem(name.get_text(), taken)
                       or password_problem(password.get_text(), again.get_text()))
            hint.set_text(problem or "")
            ok.set_sensitive(problem is None)

        def name_from_full_name(_entry):
            if not edited:
                name.handler_block(name_changed)
                name.set_text(suggest_user_name(full_name.get_text(), taken))
                name.handler_unblock(name_changed)
            check()

        def name_typed(_entry):
            edited[:] = [True] if name.get_text() else []
            check()

        full_name.connect("changed", name_from_full_name)
        name_changed = name.connect("changed", name_typed)
        password.connect("changed", check)
        again.connect("changed", check)
        check()
        dialog.show_all()
        response = dialog.run()
        values = (name.get_text(), full_name.get_text().strip(), "yes" if admin.get_active() else "no")
        secret = password.get_text()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.helper(["user-add", *values], secret + "\n")

    def change_password(self, _button, account):
        Gtk = self.ui.Gtk
        dialog, grid, ok = self.dialog("Change Password", "C_hange")
        grid.attach(self.ui.label(f"The new password of {account.full_name or account.name} ({account.name})."),
                    0, 0, 2, 1)
        password = self.entry(grid, 1, "_New password", secret=True)
        again = self.entry(grid, 2, "_Confirm password", secret=True)
        hint = self.hint(grid, 3)

        def check(*_args):
            problem = password_problem(password.get_text(), again.get_text())
            hint.set_text(problem or "")
            ok.set_sensitive(problem is None)

        password.connect("changed", check)
        again.connect("changed", check)
        check()
        dialog.show_all()
        response = dialog.run()
        secret = password.get_text()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.helper(["user-password", account.name], secret + "\n")

    def remove(self, _button, account):
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=f"Remove {account.full_name or account.name}?")
        dialog.format_secondary_text(f"{account.name} can no longer log in. They have to be logged out.")
        files = Gtk.CheckButton.new_with_mnemonic(f"Also _delete their files ({account.home})")
        dialog.get_message_area().pack_start(files, False, False, 0)
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        button = dialog.add_button("_Remove", Gtk.ResponseType.OK)
        button.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        dialog.show_all()
        response = dialog.run()
        delete = files.get_active()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.helper(["user-remove", account.name, "delete" if delete else "keep"])

    def shown(self):
        self.fill()


class TilingPage:
    """Tiling on/off, arrangement, main window width and apps that always
    float (flick-tiler)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        self.timers = {}
        self.switch = None          # built with the first state (build)
        box.pack_start(ui.label("Arrange windows side by side automatically. Super+T turns tiling on or "
                                "off; while it is on, its keys are listed under Keyboard Shortcuts."),
                       False, False, 0)
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.content, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def build(self, modes, state):
        ui, Gtk, box = self.ui, self.ui.Gtk, self.content
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch(active=state.enabled)
        self.switch.connect("notify::active", self.toggled)
        listbox.add(ui.row("Tile windows", self.switch, "New windows are tiled; open windows with Super+Shift+T"))
        row, self.select_mode = ui.combo_row("Arrangement", modes, state.mode, self.choose_mode)
        listbox.add(row)
        self.scales = {}
        for key, title, subtitle, low, high, step, unit, default in (
                ("ratio", "Main window width", "In the arrangements with a main window",
                 RATIO_MIN, RATIO_MAX, RATIO_STEP, "%", 55),
                ("gap", "Gap", "Space between tiled windows and around them", GAP_MIN, GAP_MAX, GAP_STEP, "px", 8)):
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low, high, step)
            scale.set_size_request(240, -1)
            scale.set_value_pos(Gtk.PositionType.RIGHT)
            scale.set_digits(0)
            scale.connect("format-value", lambda _scale, value, unit=unit: f"{int(value)} {unit}")
            value = getattr(state, key)
            scale.set_value(value if value is not None else default)
            scale.connect("value-changed", self.slider_changed, key)
            self.scales[key] = scale
            listbox.add(ui.row(title, scale, subtitle))
        box.pack_start(frame, False, False, 0)

        box.pack_start(ui.heading("Apps that always float"), False, False, 0)
        box.pack_start(ui.label("Windows of these apps are never tiled. An app id can be a pattern such as "
                                "gimp*. Dialogs always float.", dim=True), False, False, 0)
        frame, self.floating = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        add = Gtk.Box(spacing=6)
        self.entry = Gtk.Entry(placeholder_text="App id, e.g. org.gnome.Calculator")
        self.entry.connect("activate", self.add_floating)
        add_button = Gtk.Button.new_with_mnemonic("_Add")
        add_button.connect("clicked", self.add_floating)
        add.pack_start(self.entry, True, True, 0)
        add.pack_start(add_button, False, False, 0)
        box.pack_start(add, False, False, 0)
        box.show_all()
        self.fill_floating()

    def send(self, words, then=None):
        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if not ok or "saved" in stdout else "")
            self.refresh()
            if then:
                then()

        self.ui.run_async([TILER, *words], done)

    def toggled(self, switch, _param):
        if not self.quiet:
            self.send(["on" if switch.get_active() else "off"])

    def choose_mode(self, mode_id):
        self.send(["mode", mode_id])

    def slider_changed(self, scale, key):
        """ratio or gap: sent once the slider rests, not for every step."""
        if self.quiet:
            return
        if self.timers.get(key):
            self.ui.GLib.source_remove(self.timers[key])

        def apply():
            self.timers[key] = None
            self.send([key, str(int(scale.get_value()))])
            return False

        self.timers[key] = self.ui.GLib.timeout_add(SLIDER_DELAY_MS, apply)

    def refresh(self):
        """Show flick-tiler's state; it also changes with Super+T and the panel."""
        first = self.switch is None

        def read():
            return parse_items(run([TILER, "modes"])) if first else None, tiler_state(run([TILER, "status"]))

        self.ui.background(read, self.show_state, key=(self, "status"))

    def show_state(self, result, error):
        self.loading.hide()
        if error:
            self.status.set_text(error if self.switch else f"Can't read the tiling settings: {error}")
            return
        modes, state = result
        if self.switch is None:
            self.build(modes, state)
            return
        self.quiet = True
        self.switch.set_active(state.enabled)
        for key, scale in self.scales.items():
            value = getattr(state, key)
            if value is not None and not self.timers.get(key):
                scale.set_value(value)
        self.select_mode(state.mode)
        self.quiet = False

    def fill_floating(self):
        self.ui.background(lambda: run([TILER, "floating", "list"]).split(), self.show_floating,
                           key=(self, "floating"))

    def show_floating(self, patterns, error):
        if error:
            self.status.set_text(error)
            patterns = []
        for row in self.floating.get_children():
            self.floating.remove(row)
        for pattern in patterns:
            remove = self.ui.Gtk.Button.new_from_icon_name("list-remove-symbolic", self.ui.Gtk.IconSize.BUTTON)
            remove.set_tooltip_text(f"Tile {pattern} again")
            remove.get_accessible().set_name(f"Tile {pattern} again")
            remove.connect("clicked", lambda _b, p=pattern: self.send(["floating", "remove", p], self.fill_floating))
            self.floating.add(self.ui.row(pattern, remove))
        if not patterns:
            self.floating.add(self.ui.row("None"))
        self.floating.show_all()

    def add_floating(self, *_args):
        pattern = self.entry.get_text().strip()
        if not pattern:
            return
        self.entry.set_text("")
        self.send(["floating", "add", pattern], self.fill_floating)

    def shown(self):
        self.refresh()


class ShortcutsPage:
    """The keyboard shortcuts labwc uses (flickos-shortcuts list)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        box.pack_start(ui.label("Hold the Super (Windows) key on its own to see these at any time."),
                       False, False, 0)
        sheet = Gtk.Button.new_with_mnemonic("_Show the Shortcut Sheet")
        sheet.set_halign(Gtk.Align.START)
        sheet.connect("clicked", lambda _b: ui.start_app([SHORTCUTS, "show"]))
        box.pack_start(sheet, False, False, 0)
        self.sections = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.sections, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.shown_text = None

    def shown(self):
        """Read again each time: the tiling keys come and go with tiling."""
        self.ui.background(lambda: run([SHORTCUTS, "list"]), self.show_sheet, key=(self, "list"))

    def show_sheet(self, text, message):
        self.loading.hide()
        text = text or ""
        if text == self.shown_text and message is None:
            return
        self.shown_text = text
        for child in self.sections.get_children():
            self.sections.remove(child)
        if message:
            self.ui.error(self.sections, message)
        for name, rows in parse_shortcuts(text):
            self.sections.pack_start(self.ui.heading(name), False, False, 0)
            frame, listbox = self.ui.framed_list()
            for keys, description in rows:
                listbox.add(self.ui.row(description, self.ui.label(keys, dim=True, wrap=False)))
            self.sections.pack_start(frame, False, False, 0)
        self.sections.show_all()


class PhonePage:
    """The phone connection (flickos-phone): on or off, the name phones see,
    pairing, the paired phones, the networks where it listens, notifications,
    calls, media control, the named commands the phone may run, what came from
    a phone, and the firewall's rule for phones (a system setting, through
    the helper). It reads everything with one `flickos-phone state`, again
    every PHONE_REFRESH_SECONDS while the page is on screen."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        self.timer = None
        self.state = None
        self.shown_lists = None     # what the lists show, so they're rebuilt only when it changes
        box.pack_start(ui.label("Share a page, a photo or some text on your phone, choose this computer, and it "
                                "arrives here. Files and addresses go the other way too. The phone needs the "
                                "KDE Connect app, from F-Droid or Google Play."), False, False, 0)
        self.notice = ui.notice()
        box.pack_start(self.notice, False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.toggled)
        self.switch_row = ui.row("Use your phone with this computer", self.switch, "")
        listbox.add(self.switch_row)
        self.name = Gtk.Entry(width_chars=20)
        self.name.connect("activate", self.rename)
        self.name.connect("focus-out-event", self.rename)
        listbox.add(ui.row("Name on the phone", self.name, "What the KDE Connect app calls this computer"))
        box.pack_start(frame, False, False, 0)

        # Only while it's on.
        self.details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, no_show_all=True)
        self.open_phone = Gtk.Button.new_with_mnemonic("_Open Phone")
        self.open_phone.set_halign(Gtk.Align.START)
        self.open_phone.connect("clicked", lambda _b: ui.start_app([PHONE, "window"]))
        self.details.pack_start(self.open_phone, False, False, 0)
        self.firewall_frame, firewall_list = ui.framed_list()
        self.firewall_frame.set_no_show_all(True)
        self.firewall_switch = Gtk.Switch()
        self.firewall_switch.connect("notify::active", self.firewall_toggled)
        firewall_list.add(ui.row("Let phones through the firewall", self.firewall_switch,
                                 "Only from home and office networks. Needs an administrator's password."))
        self.details.pack_start(self.firewall_frame, False, False, 0)
        self.details.pack_start(ui.heading("Phones"), False, False, 0)
        frame, self.phones = ui.framed_list()
        self.details.pack_start(frame, False, False, 0)
        self.add_button = Gtk.Button.new_with_mnemonic("_Add Phone…")
        self.add_button.set_halign(Gtk.Align.START)
        self.add_button.connect("clicked", self.add_phone)
        self.details.pack_start(self.add_button, False, False, 0)
        self.details.pack_start(ui.heading("Networks"), False, False, 0)
        self.details.pack_start(ui.label("Phones can connect only while this computer is on one of these "
                                         "networks. The network a phone pairs on is added.", dim=True),
                                False, False, 0)
        frame, self.networks = ui.framed_list()
        self.details.pack_start(frame, False, False, 0)
        self.use_here = Gtk.Button.new_with_mnemonic("_Use on This Network")
        self.use_here.set_halign(Gtk.Align.START)
        self.use_here.set_no_show_all(True)
        self.use_here.connect("clicked", lambda _b: self.send(["network", "add"]))
        self.details.pack_start(self.use_here, False, False, 0)
        self.details.pack_start(ui.heading("Notifications"), False, False, 0)
        self.details.pack_start(ui.label("From the apps you allow. Nothing is shown while the screen is locked.",
                                         dim=True), False, False, 0)
        frame, note_list = ui.framed_list()
        self.note_switch = Gtk.Switch()
        self.note_switch.connect("notify::active", self.notifications_toggled)
        self.note_row = ui.row("Show the phone's notifications", self.note_switch, "Off")
        note_list.add(self.note_row)
        self.details.pack_start(frame, False, False, 0)
        self.note_apps_frame, self.note_apps = ui.framed_list()
        self.note_apps_frame.set_no_show_all(True)
        self.details.pack_start(self.note_apps_frame, False, False, 0)
        self.details.pack_start(ui.heading("Calls"), False, False, 0)
        self.details.pack_start(ui.label("When the phone rings, a notification names the caller. Click it to mute "
                                         "the ringer. What is playing pauses until the call ends. Nothing is shown "
                                         "while the screen is locked.", dim=True), False, False, 0)
        frame, call_list = ui.framed_list()
        self.call_switch = Gtk.Switch()
        self.call_switch.connect("notify::active", self.calls_toggled)
        self.call_row = ui.row("Show the phone's calls", self.call_switch, "Off")
        call_list.add(self.call_row)
        self.details.pack_start(frame, False, False, 0)
        self.details.pack_start(ui.heading("Media"), False, False, 0)
        self.details.pack_start(ui.label("What's playing on this computer shows in the phone's app, with its name "
                                         "and picture. The phone can play, pause, skip and change the volume.",
                                         dim=True), False, False, 0)
        frame, media_list = ui.framed_list()
        self.media_switch = Gtk.Switch()
        self.media_switch.connect("notify::active", self.media_toggled)
        self.media_row = ui.row("Control what's playing from the phone", self.media_switch, "Off")
        media_list.add(self.media_row)
        self.details.pack_start(frame, False, False, 0)
        self.details.pack_start(ui.heading("Commands"), False, False, 0)
        self.details.pack_start(ui.label("The phone is sent these names and can run one of them. A command runs as you. "
                                         "Nothing runs while the screen is locked.", dim=True), False, False, 0)
        frame, self.command_rows = ui.framed_list()
        self.details.pack_start(frame, False, False, 0)
        self.add_command_button = Gtk.Button.new_with_mnemonic("Add _Command…")
        self.add_command_button.set_halign(Gtk.Align.START)
        self.add_command_button.connect("clicked", self.add_command)
        self.details.pack_start(self.add_command_button, False, False, 0)
        self.details.pack_start(ui.heading("Received"), False, False, 0)
        frame, self.received = ui.framed_list()
        self.details.pack_start(frame, False, False, 0)
        box.pack_start(self.details, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        # Not in the live session: there is nothing to pair with a system that's gone at the next boot.
        return shutil.which(PHONE) is not None and not live_session()

    def shown(self):
        self.refresh()
        if self.timer is None:
            self.timer = self.ui.GLib.timeout_add_seconds(PHONE_REFRESH_SECONDS, self.tick)

    def tick(self):
        """Phones come and go: read again while the page is on screen, and stop
        the timer when it isn't (shown() starts it again)."""
        if not self.widget.get_mapped():
            self.timer = None
            return False
        self.refresh()
        return True

    def refresh(self):
        def read():
            try:
                return json.loads(run([PHONE, "state"])), phones_allowed(), thunar_hides_phone_action()
            except ValueError:
                raise ControlError("flickos-phone state gave no answer") from None

        self.ui.background(read, self.show_state, key=(self, "state"))

    def show_state(self, result, error):
        self.loading.hide()
        if error:
            self.status.set_text(f"Can't read the phone connection: {error}")
            return
        state, allowed, hidden_by = result
        self.state = state
        self.ui.set_notice(self.notice, [thunar_notice(hidden_by)] if state["enabled"] and hidden_by else [])
        self.quiet = True
        self.switch.set_active(state["enabled"])
        self.firewall_switch.set_active(allowed)
        self.note_switch.set_active(bool(state.get("notifications")))
        self.call_switch.set_active(bool(state.get("calls")))
        self.media_switch.set_active(bool(state.get("media")))
        self.quiet = False
        self.ui.set_subtitle(self.note_row, "On" if state.get("notifications") else "Off")
        self.ui.set_subtitle(self.call_row, "On" if state.get("calls") else "Off")
        self.ui.set_subtitle(self.media_row, "On" if state.get("media") else "Off")
        if not self.name.has_focus():
            self.name.set_text(state["own_name"])
            self.name.set_placeholder_text(state["computer_name"])
        self.ui.set_subtitle(self.switch_row, phone_summary(state))
        if not state["enabled"]:
            self.details.hide()
            return
        if not self.details.get_visible():
            reveal(self.details)
        listed = {n["uuid"] for n in state["networks"]}
        for widget, wanted in ((self.firewall_frame, state["firewall"]),
                               (self.use_here, any(n["uuid"] not in listed for n in state["active"]))):
            if wanted and not widget.get_visible():
                reveal(widget)
            elif not wanted:
                widget.hide()
        self.add_button.set_sensitive(state["running"])
        lists = json.dumps([state["phones"], state["networks"], state["received"],
                            state.get("notifications"), state.get("notification_apps"),
                            state.get("commands")], sort_keys=True)
        if lists != self.shown_lists:
            self.shown_lists = lists
            self.fill_phones(state["phones"])
            self.fill_networks(state["networks"])
            self.fill_received(state["received"])
            self.fill_notification_apps(state.get("notification_apps") or [], state.get("notifications"))
            self.fill_commands(state.get("commands") or [])

    @staticmethod
    def clear(listbox):
        for row in listbox.get_children():
            listbox.remove(row)

    def button(self, text, name, action):
        button = self.ui.Gtk.Button(label=text)
        button.get_accessible().set_name(name)
        button.connect("clicked", lambda _b: action())
        return button

    def fill_phones(self, phones):
        ui = self.ui
        self.clear(self.phones)
        for phone in phones:
            forget = self.button("Forget", f"Forget {phone['name']}",
                                 lambda p=phone: self.send(["forget", p["id"]]))
            self.phones.add(ui.row(phone["name"], forget, "Connected" if phone["connected"] else "Not connected"))
        if not phones:
            self.phones.add(ui.row("None yet", subtitle="Add Phone pairs one"))
        self.phones.show_all()

    def fill_networks(self, networks):
        ui = self.ui
        self.clear(self.networks)
        for network in networks:
            title = network["name"] or "A network that's gone"
            forget = self.button("Forget", f"Forget {title}",
                                 lambda n=network: self.send(["network", "remove", n["uuid"]]))
            self.networks.add(ui.row(title, forget, "This network" if network["active"] else ""))
        if not networks:
            self.networks.add(ui.row("None yet", subtitle="Pairing a phone adds the network it's on"))
        self.networks.show_all()

    def fill_received(self, items):
        ui, Gtk = self.ui, self.ui.Gtk
        self.clear(self.received)
        for item in reversed(items):
            kind, value = item.get("kind"), item.get("value", "")
            subtitle = f"{item.get('device', '')} · {when_received(item.get('time', 0))}"
            buttons = Gtk.Box(spacing=6)
            if kind == "page":
                title = short_address(value)
                buttons.pack_start(self.button("Open", f"Open {title}", lambda v=value: ui.start_app(
                    ["xdg-open", v])), False, False, 0)
            elif kind == "file":
                title = os.path.basename(value)
                folder = os.path.dirname(value)
                if not item.get("exists"):
                    subtitle += " · no longer there"
                else:
                    if item.get("openable"):
                        buttons.pack_start(self.button("Open", f"Open {title}", lambda v=value: ui.start_app(
                            ["xdg-open", v])), False, False, 0)
                    buttons.pack_start(self.button("Show in Folder", f"Show {title} in its folder",
                                                   lambda f=folder: ui.start_app(["xdg-open", f])), False, False, 0)
            else:
                lines = value.strip().splitlines()
                title = (lines[0] if lines else "") or "Text"
                title = title if len(title) <= 60 else title[:59] + "…"
                if kind == "clipboard":
                    subtitle = "Clipboard · " + subtitle
                buttons.pack_start(self.button("Copy", f"Copy {title}", lambda v=value: ui.start_app(
                    ["wl-copy", "--", v])), False, False, 0)
                if item.get("address"):
                    buttons.pack_start(self.button("Open", f"Open the address in {title}", lambda a=item["address"]:
                                                   ui.start_app(["xdg-open", a])), False, False, 0)
            self.received.add(ui.row(title, buttons if buttons.get_children() else None, subtitle))
        if not items:
            self.received.add(ui.row("Nothing yet", subtitle="What a phone sends shows here for a week"))
        self.received.show_all()

    def fill_notification_apps(self, apps, on):
        ui = self.ui
        self.clear(self.note_apps)
        if not on:
            self.note_apps_frame.hide()
            return
        if not self.note_apps_frame.get_visible():
            reveal(self.note_apps_frame)
        self.quiet = True
        for app in apps:
            switch = ui.Gtk.Switch()
            switch.set_active(bool(app.get("allowed")))
            name = app.get("name", "")
            switch.connect("notify::active", lambda widget, _param, app_name=name: self.app_toggled(widget, app_name))
            self.note_apps.add(ui.row(name, switch))
        if not apps:
            self.note_apps.add(ui.row("None yet", subtitle="An app appears here after the phone sends a notification from it"))
        self.quiet = False
        self.note_apps.show_all()

    def fill_commands(self, commands):
        ui = self.ui
        self.clear(self.command_rows)
        for command in commands:
            name = command.get("name") or "Command"
            key = command.get("key") or ""
            remove = self.button("Remove", f"Remove {name}",
                                 lambda command_key=key: self.send(["commands", "remove", command_key]))
            if not key:
                remove.set_sensitive(False)
            self.command_rows.add(ui.row(name, remove, command.get("command") or ""))
        if not commands:
            self.command_rows.add(ui.row("None yet", subtitle="Add Command adds one. The phone sees the name."))
        self.command_rows.show_all()

    def add_command(self, _button):
        """Add Command…: a name and the command line. The phone is sent the name."""
        Gtk = self.ui.Gtk
        dialog = Gtk.Dialog(title="Add Command", transient_for=self.widget.get_toplevel(), modal=True,
                            resizable=False)
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        add = dialog.add_button("_Add", Gtk.ResponseType.OK)
        add.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=8, column_spacing=12, margin=18)
        grid.attach(self.ui.label("It runs as you, on this computer. The phone is sent the name, "
                                  "and can run only this command."), 0, 0, 2, 1)
        name = Gtk.Entry(activates_default=True, hexpand=True, width_chars=36)
        command = Gtk.Entry(activates_default=True, hexpand=True, width_chars=36)
        grid.attach(Gtk.Label(label="_Name", xalign=1, use_underline=True, mnemonic_widget=name), 0, 1, 1, 1)
        grid.attach(name, 1, 1, 1, 1)
        grid.attach(Gtk.Label(label="Comman_d", xalign=1, use_underline=True, mnemonic_widget=command), 0, 2, 1, 1)
        grid.attach(command, 1, 2, 1, 1)
        dialog.get_content_area().add(grid)

        def check(*_args):
            add.set_sensitive(bool(name.get_text().strip() and command.get_text().strip()))

        name.connect("changed", check)
        command.connect("changed", check)
        check()
        dialog.show_all()
        name.grab_focus()
        response = dialog.run()
        values = (name.get_text(), command.get_text())
        dialog.destroy()
        if response == Gtk.ResponseType.OK and all(part.strip() for part in values):
            self.send(["commands", "add", "--", *values])

    def notifications_toggled(self, switch, _param):
        if self.quiet:
            return
        self.send(["set", "notifications", "yes" if switch.get_active() else "no"])

    def calls_toggled(self, switch, _param):
        if self.quiet:
            return
        self.send(["set", "calls", "yes" if switch.get_active() else "no"])

    def media_toggled(self, switch, _param):
        if self.quiet:
            return
        self.send(["set", "media", "yes" if switch.get_active() else "no"])

    def app_toggled(self, switch, name):
        if self.quiet or not name:
            return
        action = "allow" if switch.get_active() else "block"
        words = ["notifications", action]
        if name.startswith("-"):
            words.append("--")
        self.send([*words, name])

    def send(self, words, then=None):
        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            self.shown_lists = None
            self.refresh()
            if then:
                then()

        self.ui.run_async([PHONE, *words], done)

    def toggled(self, switch, _param):
        if self.quiet:
            return
        # The daemon takes a moment to start: read once more a little later.
        self.send(["set", "enabled", "yes" if switch.get_active() else "no"],
                  lambda: self.ui.GLib.timeout_add(1500, lambda: self.refresh() or False))

    def rename(self, *_args):
        if self.state is None:
            return False
        text = self.name.get_text().strip()
        if text != self.state["own_name"]:
            self.send(["set", "name", text or DEFAULT_CHOICE])
        return False

    def firewall_toggled(self, switch, _param):
        if self.quiet:
            return
        self.status.set_text("Waiting for the password…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            self.refresh()

        self.ui.run_async([*SELF, "system", "firewall.phones", "on" if switch.get_active() else "off"], done)

    def add_phone(self, _button):
        """Add Phone…: `flickos-phone pair --json` until the phone asks, its key,
        and Pair or Cancel as the answer."""
        ui, Gtk, Gio, GLib = self.ui, self.ui.Gtk, self.ui.Gio, self.ui.GLib
        dialog = Gtk.Dialog(title="Add Phone", transient_for=self.widget.get_toplevel(), modal=True,
                            resizable=False)
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        pair = dialog.add_button("_Pair", Gtk.ResponseType.OK)
        pair.get_style_context().add_class("suggested-action")
        pair.set_sensitive(False)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=18)
        name = (self.state or {}).get("name") or "this computer"
        box.pack_start(ui.label("1. Install the KDE Connect app on the phone, from F-Droid or Google Play.\n"
                                "2. Connect the phone to the same network as this computer.\n"
                                f"3. In the app, choose {name} and tap Pair."), False, False, 0)
        waiting = Gtk.Box(spacing=8)
        spinner = Gtk.Spinner(active=True)
        message = ui.label("Waiting for the phone…")
        waiting.pack_start(spinner, False, False, 0)
        waiting.pack_start(message, True, True, 0)
        box.pack_start(waiting, False, False, 0)
        key = ui.label("", wrap=False)
        key.set_selectable(True)
        key.set_halign(Gtk.Align.CENTER)
        key.set_no_show_all(True)
        box.pack_start(key, False, False, 0)
        dialog.get_content_area().add(box)
        dialog.show_all()
        session = {"asked": False, "over": False, "closed": False}
        flags = Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE
        try:
            process = Gio.Subprocess.new([PHONE, "pair", "--json"], flags)
        except GLib.Error as failure:
            spinner.stop()
            message.set_text(failure.message)
            session["over"] = True
            process = None
        else:
            process.wait_async(None, None, None)        # reaped when it exits

        def finish(text=""):
            session["over"] = True
            spinner.stop()
            spinner.hide()
            pair.set_sensitive(False)
            if text:
                message.set_text(text)

        def on_line(stream, result):
            if session["closed"]:
                return
            try:
                line, _ = stream.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:                    # it has ended
                if not session["over"]:
                    finish("Pairing stopped. Try again.")
                return
            try:
                event = json.loads(line)
            except ValueError:                  # an error message instead of an event
                finish("\n".join(output_messages(line, "")))
                stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)
                return
            kind = event.get("event")
            if kind == "waiting" and event.get("firewall") and not phones_allowed():
                message.set_text("Waiting for the phone… The firewall is on, so the phone can't reach this "
                                 "computer until Let phones through the firewall is on.")
            elif kind == "request":
                session["asked"] = True
                spinner.stop()
                spinner.hide()
                message.set_text(f"{event.get('name', 'A phone')} asks to pair. Pair only if the phone shows "
                                 "the same key:")
                key.set_markup(f"<big><big><b>{GLib.markup_escape_text(event.get('key', ''))}</b></big></big>")
                key.show()
                pair.set_sensitive(True)
                pair.grab_focus()
            elif kind == "paired":
                session["over"] = session["closed"] = True
                dialog.destroy()
                self.status.set_text(f"Paired with {event.get('name', 'the phone')}.")
                self.shown_lists = None
                self.refresh()
                return
            elif kind == "timeout":
                finish(f"No phone asked to pair in {PHONE_PAIR_MINUTES} minutes. Try again.")
            elif kind == "failed":
                finish("The phone went away before pairing finished. Try again.")
            elif kind == "refused":
                finish()
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        def answer(text):
            with contextlib.suppress(GLib.Error):
                stdin = process.get_stdin_pipe()
                stdin.write_all(text.encode(), None)
                stdin.close(None)

        def response(_dialog, response_id):
            if response_id == Gtk.ResponseType.OK and session["asked"] and not session["over"]:
                answer("yes\n")
                pair.set_sensitive(False)
                message.set_text("Pairing…")
                return
            if process is not None and not session["over"]:
                if session["asked"]:
                    answer("no\n")
                else:
                    process.force_exit()        # the daemon closes the window when it goes
            session["closed"] = True
            dialog.destroy()

        dialog.connect("response", response)
        if process is not None:
            Gio.DataInputStream.new(process.get_stdout_pipe()).read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)


def reveal(widget):
    """Show a widget kept out of the window's show_all (no_show_all) with what
    is in it: show_all() alone does nothing on such a widget."""
    widget.set_no_show_all(False)
    widget.show_all()
    widget.set_no_show_all(True)


def phone_summary(state):
    """The subtitle of the Phone page's switch."""
    if not state["enabled"]:
        return "Off"
    connected = [phone["name"] for phone in state["phones"] if phone["connected"]]
    if connected:
        return "Connected to " + ", ".join(connected)
    if state.get("blocked"):
        return "KDE Connect is already running on this computer. Use it, or quit it to use this."
    if not state["running"]:
        return "Not running: turn it off and on again"
    if not state["phones"]:
        return "On. Add a phone below."
    if not state["listening"]:
        return "Waiting for a network where a phone was paired"
    return "Waiting for the phone"


def short_address(url, limit=60):
    """Host and path of an address, without the tracking after them."""
    text = re.sub(r"^[a-z][a-z0-9+.-]*://(www\.)?", "", url, flags=re.I)
    text = re.split(r"[?#]", text, maxsplit=1)[0].rstrip("/") or url
    return text if len(text) <= limit else text[:limit - 1] + "…"


def when_received(seconds, now=None):
    """14:02, Yesterday 14:02, or Tue 22 Sep: when something came from a phone."""
    moment = datetime.datetime.fromtimestamp(seconds)
    today = (now or datetime.datetime.now()).date()
    if moment.date() == today:
        return moment.strftime("%H:%M")
    if (today - moment.date()).days == 1:
        return "Yesterday " + moment.strftime("%H:%M")
    return moment.strftime("%a %d %b")


class HistoryPage:
    """The changes to the desktop's settings, one framed list per day, each
    with Undo while it can be undone (`flickos-control history`)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label("Changes to your desktop's settings and to the installed software, newest "
                                "first. Undo puts a setting back the way it was before, or removes an app that "
                                "was installed, or installs one again that was removed."), False, False, 0)
        # Above the list, which can be long: an undo's result shows where it was clicked (WIN-10).
        self.status = ui.status_label()
        self.status.set_no_show_all(True)
        box.pack_start(self.status, False, False, 0)
        self.put_back = Gtk.Button.new_with_mnemonic("_Put Back as It Was…")
        self.put_back.set_halign(Gtk.Align.START)
        self.put_back.set_tooltip_text("Put the settings back as they were on an earlier day")
        self.put_back.set_no_show_all(True)
        self.put_back.connect("clicked", self.ask_restore)
        box.pack_start(self.put_back, False, False, 0)
        self.names = {}
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.days = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.days, False, False, 0)
        box.pack_start(ui.heading("Keeping a history"), False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.switched)
        listbox.add(ui.row("Keep a history of changes", self.switch,
                           "Only for your account, and only on this computer"))
        clear = Gtk.Button.new_with_mnemonic("C_lear History…")
        clear.connect("clicked", lambda _b: self.ask_clear(off=False))
        listbox.add(ui.row("Forget the changes kept so far", clear))
        box.pack_start(frame, False, False, 0)

    def read(self):
        settings = shape_history(read_history())
        try:
            software, problem = software_changes(), None
        except ControlError as error:
            software, problem = [], f"The software changes can't be read: {error}"
        points = []
        if recovery_available():
            with contextlib.suppress(ControlError):
                points = history_restore_points(recovery_state())
        changes = sorted(settings + software + points, key=lambda change: change.when, reverse=True)
        shown = changes[:HISTORY_ROWS]
        names = history_names([c for c in shown if isinstance(c, Change)], clock=bool(changes))
        # The apps' names, looked up here, not in the main loop.
        learn_app_names([p for c in shown if isinstance(c, SoftwareChange) for p in c.packages[:APP_NAMES_SHOWN]])
        return changes, names, history_enabled(), problem

    def shown(self):
        self.loading.show_all()
        self.ui.background(self.read, self.show, key=(self, "read"))

    def show(self, result, error):
        Gtk = self.ui.Gtk
        self.loading.hide()
        for child in self.days.get_children():
            self.days.remove(child)
        if error:
            self.say(error)
            return
        changes, names, enabled, problem = result
        self.names = names
        self.put_back.set_visible(enabled and any(isinstance(change, Change) for change in changes))
        if problem:
            self.say(problem)
        self.quiet = True
        self.switch.set_active(enabled)
        self.quiet = False
        if not changes:
            self.days.pack_start(self.ui.label("Changes you make to your desktop's settings and your software "
                                               "will show here." if enabled else "The history is off.", dim=True),
                                 False, False, 0)
        today = datetime.datetime.now().astimezone().date()
        clock = "%I:%M %p" if names.get("clock") == "12h" else "%H:%M"
        listbox = day = None
        for change in changes[:HISTORY_ROWS]:
            when = change.when.astimezone()
            if when.date() != day:
                day = when.date()
                heading = ("Today" if day == today else "Yesterday" if day == today - datetime.timedelta(days=1)
                           else when.strftime("%A %x"))
                self.days.pack_start(self.ui.heading(heading), False, False, 0)
                frame, listbox = self.ui.framed_list()
                self.days.pack_start(frame, False, False, 0)
            title, detail = describe(change, names)
            details = [detail] if detail else []
            details.append(when.strftime(clock))
            if not change.newest:
                details.append("Changed again since")
            button = None
            if isinstance(change, RestorePoint):
                button = Gtk.Button.new_with_mnemonic("Put Back…")
                button.get_accessible().set_name(f"Put back: {title}")
                button.set_sensitive(not change.waiting)
                button.connect("clicked", self.put_back_point, change.name)
            elif change.undoable:
                button = Gtk.Button.new_with_label("Undo")
                button.get_accessible().set_name(f"Undo: {title}")
                if isinstance(change, SoftwareChange):
                    button.set_tooltip_text("Remove it again" if change.kind == "install" else "Install it again")
                    button.connect("clicked", self.undo_software, change)
                else:
                    old = value_name(change.owner, change.key, change.old, names)
                    button.set_tooltip_text(f"Change it back to {old}" if detail else "Change it back")
                    button.connect("clicked", self.undo, change.id)
            listbox.add(self.ui.row(title, button, " · ".join(details)))
        if len(changes) > HISTORY_ROWS:
            self.days.pack_start(self.ui.label(f"{len(changes) - HISTORY_ROWS} older changes are left out here. "
                                               "flickos-control history lists them all.", dim=True), False, False, 0)
        self.days.show_all()

    def say(self, text):
        self.status.set_text(text)
        self.status.set_visible(bool(text))

    def undo(self, button, change_id):
        button.set_sensitive(False)
        self.say("")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.say("\n".join(messages) if messages or ok else "Not undone.")
            self.shown()

        self.ui.run_async([*SELF, "history", "undo", change_id], done)

    def ask_restore(self, _button):
        """Choose a day and see what goes back before anything does."""
        Gtk, ui = self.ui.Gtk, self.ui
        entries = read_history()
        today = datetime.date.today()
        days = sorted({entry["when"].astimezone().date() for entry in entries}, reverse=True)
        dialog = Gtk.Dialog(title="Put Back as It Was", transient_for=self.widget.get_toplevel(), modal=True)
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        ok = dialog.add_button("_Put Back", Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        dialog.set_default_size(560, 480)
        area = dialog.get_content_area()
        area.set_spacing(12)
        area.set_border_width(12)
        area.pack_start(ui.label("Put your settings back as they were before the changes of:"), False, False, 0)
        choice = Gtk.ComboBoxText()
        for day in days:
            start = datetime.datetime.combine(day, datetime.time.min).astimezone()
            name = ("Today" if day == today else "Yesterday" if day == today - datetime.timedelta(days=1)
                    else start.strftime("%A %x"))
            choice.append((start - datetime.timedelta(microseconds=1)).isoformat(), name)
        choice.get_accessible().set_name("Day")
        area.pack_start(choice, False, False, 0)
        frame, listbox = ui.framed_list()
        scrolled = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, min_content_height=220)
        scrolled.add(frame)
        area.pack_start(scrolled, True, True, 0)
        area.pack_start(ui.label("System settings and software stay as they are: each has its own Undo.",
                                 dim=True), False, False, 0)

        def fill(_combo):
            for child in listbox.get_children():
                listbox.remove(child)
            plan = restore_plan(parse_when(choice.get_active_id()), entries) if choice.get_active_id() else []
            for change in plan:
                title, _ = describe(dataclasses.replace(change, old=change.new, new=change.old), self.names)
                listbox.add(ui.row(title, None, "Now " + value_name(change.owner, change.key, change.new,
                                                                     self.names)))
            if not plan:
                listbox.add(ui.row("Nothing to put back", None, "No setting that can be put back has changed "
                                                                 "since then."))
            ok.set_sensitive(bool(plan))
            listbox.show_all()

        choice.connect("changed", fill)
        choice.set_active(0)
        dialog.show_all()
        response = dialog.run()
        when = choice.get_active_id()
        dialog.destroy()
        if response != Gtk.ResponseType.OK or not when:
            return
        self.say("Putting the settings back…")

        def done(ok, stdout, stderr):
            messages = [m for m in output_messages("", stderr)]
            self.say("Settings put back. The first row below undoes it." if ok else
                     "\n".join(messages) or "Not everything was put back.")
            self.shown()

        self.ui.run_async([*SELF, "history", "restore", when], done)

    def put_back_point(self, button, name):
        button.set_sensitive(False)
        self.say("Checking what would change…")

        def done(ok, message):
            self.say(message)
            if ok is not None:
                self.shown()

        ask_put_back(self.ui, self.widget.get_toplevel(), name, done)

    def undo_software(self, button, change):
        """Ask the helper what the undo would do, show it, and only then ask
        for the password (a removal needs the network to be taken back)."""
        button.set_sensitive(False)
        self.say("Checking what would change…")
        self.ui.background(lambda: helper_json(["packages-plan", change.id]),
                           lambda plan, error: self.confirm_software(button, change, plan, error),
                           key=(self, "plan"))

    def confirm_software(self, button, change, plan, error):
        Gtk = self.ui.Gtk
        if error:
            self.say(error)
            button.set_sensitive(True)
            return
        self.say("")
        removing = plan["action"] == "remove"
        names = package_names(change.packages)
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=f"Remove {names}?" if removing else f"Install {names} again?")
        dialog.format_secondary_text("\n".join(plan_text(plan) + ["Changing the software needs an administrator's "
                                                                   "password."]))
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        ok = dialog.add_button("_Remove" if removing else "_Install", Gtk.ResponseType.OK)
        ok.get_style_context().add_class("destructive-action" if removing else "suggested-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            button.set_sensitive(True)
            return
        self.say("Waiting for the password… Installing and removing software can take a few minutes.")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.say("\n".join(messages) if messages or ok else "Not undone.")
            self.shown()

        self.ui.run_async(["pkexec", HELPER, "packages-undo", change.id], done)

    def switched(self, switch, _param):
        if self.quiet or switch.get_active() == history_enabled():
            return
        if switch.get_active():
            self.run([*SELF, "set", "history.enabled", "yes"])
        else:
            # Not inside the switch's own signal: a dialog run there sees the click again.
            self.ui.GLib.idle_add(self.ask_clear, True)

    def ask_clear(self, off):
        """Turning the history off also forgets it: both ask first (WIN-13)."""
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text="Turn off and clear the history?" if off else "Clear the history?")
        dialog.format_secondary_text("The changes made so far can no longer be undone here.")
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        button = dialog.add_button("_Turn Off" if off else "C_lear History", Gtk.ResponseType.OK)
        button.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            if off:
                self.quiet = True
                self.switch.set_active(True)
                self.quiet = False
            return False
        self.run([*SELF, "set", "history.enabled", "no"] if off else [*SELF, "history", "clear"])
        return False                # once, from idle_add

    def run(self, command):
        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.say("\n".join(messages) if messages or ok else "Not changed.")
            self.shown()

        self.ui.run_async(command, done)


class MorePage:
    """Tiles that start the apps for the other settings."""

    def __init__(self, ui):
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        box.pack_start(ui.label("These settings open in their own window."), False, False, 0)
        tiles = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, column_spacing=12,
                            row_spacing=12, max_children_per_line=4, valign=Gtk.Align.START)
        available = available_tiles()
        if not available:
            box.pack_start(ui.label("None of these apps is installed: " +
                                    ", ".join(tile.command[0] for tile in TILES) + ".", dim=True), False, False, 0)
        for tile in available:
            button = Gtk.Button(relief=Gtk.ReliefStyle.NONE)
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=6)
            # The first name the icon theme (with the themes it inherits) has:
            # GTK itself would try every name in one theme before the next.
            theme = Gtk.IconTheme.get_default()
            name = next((n for n in (*tile.icons, *TILE_FALLBACK_ICONS) if theme.has_icon(n)), tile.icons[0])
            icon = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.DIALOG)
            content.pack_start(icon, False, False, 0)
            content.pack_start(Gtk.Label(label=tile.name), False, False, 0)
            button.add(content)
            button.set_tooltip_text(f"Open {tile.name} ({tile.command[0]})")
            button.connect("clicked", lambda _b, t=tile: ui.start_app(t.argv))
            tiles.add(button)
        box.pack_start(tiles, False, False, 0)

    def shown(self):
        pass


FIREFOX_MEMORY_TEXT = ("Fewer processes: tabs of one site share one, and no spare one waits for the next tab. "
                       "For everyone on this computer. Firefox uses it the next time it starts.")


def memory_state():
    """What the Memory page shows: {"total", "used"} in kB (None when
    /proc/meminfo can't be read), "firefox" (firefox_memory_state()) and
    "old" (old_computer()'s reasons)."""
    meminfo = read_text(os.path.join(PROC, "meminfo"))
    total = memory_kb(meminfo)
    available = re.search(r"^MemAvailable:\s+(\d+) kB", meminfo, re.M)
    used = total - int(available.group(1)) if total is not None and available else None
    return {"total": total, "used": used, "firefox": firefox_memory_state(), "old": old_computer()}


class MemoryPage:
    """How much memory this computer has and uses, and what makes it use less
    (docs/design/flickos-memory.md; so far only its This computer section,
    with Firefox's system setting from docs/design/flickos-firefox.md)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label("How much memory this computer has and uses, and what can make it use less."),
                       False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        box.pack_start(ui.heading("This computer"), False, False, 0)
        self.reasons = ui.label("", dim=True)
        self.reasons.set_no_show_all(True)
        box.pack_start(self.reasons, False, False, 0)
        frame, listbox = ui.framed_list()
        self.total, self.used = ui.label("", wrap=False), ui.label("", wrap=False)
        listbox.add(ui.row("Memory", self.total))
        listbox.add(ui.row("In use", self.used, "What can't be freed without moving it to swap"))
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.changed)
        self.firefox = ui.row("Firefox: use less memory", self.switch, FIREFOX_MEMORY_TEXT)
        self.firefox.set_no_show_all(True)
        listbox.add(self.firefox)
        box.pack_start(frame, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def changed(self, switch, _param):
        if self.quiet:
            return
        self.status.set_text("Waiting for the password…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else "Not changed.")
            self.shown()

        self.ui.run_async([*SELF, "system", "firefox.memory", "on" if switch.get_active() else "off"], done)

    def shown(self):
        self.ui.background(memory_state, self.fill, key="memory")

    def fill(self, state, error):
        self.loading.hide()
        if error:
            self.status.set_text(error)
            return
        self.total.set_text(gigabytes(state["total"]) if state["total"] is not None else "Unknown")
        self.used.set_text(gigabytes(state["used"]) if state["used"] is not None else "Unknown")
        self.reasons.set_text(" ".join(state["old"]))
        self.reasons.set_visible(bool(state["old"]))
        firefox = state["firefox"]
        if firefox is None:             # no Debian firefox-esr: nothing reads the file
            self.firefox.hide()
            return
        self.firefox.set_no_show_all(False)
        self.firefox.show_all()
        self.quiet = True
        self.switch.set_active(firefox)
        self.quiet = False
        text = ("Recommended for this computer. " if state["old"] and not firefox else "") + FIREFOX_MEMORY_TEXT
        if live_session():
            text += " In the live session until it restarts."
        self.ui.set_subtitle(self.firefox, text)


class AboutPage:
    """What this system is, and a copy of it for bug reports."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        head = Gtk.Box(spacing=16)
        # flickos-branding's logo (hicolor). GTK looks for every name in a
        # theme before the next theme, so a fallback name that Numix has would
        # win over hicolor's logo: fall back only when there is no logo.
        if Gtk.IconTheme.get_default().has_icon("flickos"):
            logo = Gtk.Image.new_from_icon_name("flickos", Gtk.IconSize.DIALOG)
        else:
            logo = Gtk.Image.new_from_gicon(ui.Gio.ThemedIcon.new_from_names(
                ["distributor-logo", "computer"]), Gtk.IconSize.DIALOG)
        logo.set_pixel_size(96)
        head.pack_start(logo, False, False, 0)
        self.title = ui.label("", wrap=False, markup=True)
        self.title.set_valign(Gtk.Align.CENTER)
        head.pack_start(self.title, False, False, 0)
        box.pack_start(head, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        frame, self.rows = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        buttons = Gtk.Box(spacing=12)
        copy = Gtk.Button.new_with_mnemonic("_Copy System Info")
        copy.set_tooltip_text("For a bug report: the facts above and the versions of FlickOS's packages")
        copy.connect("clicked", self.copy)
        buttons.pack_start(copy, False, False, 0)
        buttons.pack_start(Gtk.LinkButton.new_with_label(REPORT_URL, "Report a Problem"), False, False, 0)
        box.pack_start(buttons, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)
        self.filled = False

    def copy(self, button):
        """wl-copy (wlr-data-control, as cliphist uses) keeps the text after
        this window closes and needs no input event; GTK's clipboard is the
        fallback."""
        def work():
            text = system_info_text()
            try:
                subprocess.run(["wl-copy"], input=text, text=True, timeout=COMMAND_SECONDS, check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError):
                return text
            return None

        def done(text, error):
            button.set_sensitive(True)
            if error:
                self.status.set_text(error)
                return
            if text is not None:
                from gi.repository import Gdk      # loaded with Gtk 3 (load_gtk)
                clipboard = self.ui.Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
                clipboard.set_text(text, -1)
                clipboard.store()
            self.status.set_text("Copied. Paste it into your bug report.")

        button.set_sensitive(False)
        self.ui.background(work, done)

    def shown(self):
        if self.filled:
            return
        self.filled = True
        self.ui.background(system_info, self.fill)

    def fill(self, rows, error):
        self.loading.hide()
        if error:
            self.status.set_text(error)
            return
        name = next((value for label, value in rows if label == "FlickOS"), "FlickOS")
        self.title.set_markup(f"<big><b>{self.ui.GLib.markup_escape_text(name)}</b></big>\n"
                              "A light Debian desktop")
        for label, value in rows:
            if label == "FlickOS":
                continue
            text = self.ui.label(value, wrap=True)
            text.set_selectable(True)
            text.set_xalign(1)
            self.rows.add(self.ui.row(label, text))
        self.rows.show_all()


PAGE_CLASSES = {"layout": LayoutPage, "tiling": TilingPage, "notifications": NotificationsPage,
                "accessibility": AccessibilityPage,
                "displays": DisplaysPage, "input": InputPage, "keyboard": KeyboardPage, "shortcuts": ShortcutsPage,
                "phone": PhonePage, "idle": IdlePage, "apps": AppsPage, "startup": StartupPage,
                "screenshots": ScreenshotsPage, "region": RegionPage,
                "datetime": DateTimePage, "memory": MemoryPage, "updates": UpdatesPage, "recovery": RestorePointsPage,
                "users": UsersPage,
                "login": LoginPage, "firewall": FirewallPage, "privacy": PrivacyPage, "history": HistoryPage,
                "more": MorePage, "about": AboutPage}


def page_available(page_id):
    """Pages that don't apply here (Login in the live session) are left out."""
    available = getattr(PAGE_CLASSES[page_id], "available", None)
    return available() if available else True


def group_header(page, before):
    """What goes above page in the sidebar: its group's heading when a group
    starts, a line before the pages without one, or nothing (None)."""
    if before is not None and before.group == page.group:
        return None
    return page.group or "line"


def page_list(ui, open_page, shown):
    """The sidebar: the shown pages under their group headings (GtkStackSidebar
    has no headings); selecting one runs open_page(page_id). Returns
    (scrolled window, list)."""
    Gtk = ui.Gtk
    listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE)
    listbox.get_style_context().add_class("sidebar")
    for page in shown:
        row = Gtk.ListBoxRow()
        label = ui.label(page.name, wrap=False)
        label.set_margin_top(8)
        label.set_margin_bottom(8)
        label.set_margin_start(12)
        label.set_margin_end(12)
        row.add(label)
        row.page = page
        listbox.add(row)

    def header(row, before):
        kind = group_header(row.page, before.page if before is not None else None)
        if kind is None:
            row.set_header(None)
        elif kind == "line":
            row.set_header(Gtk.Separator(margin_top=9, margin_bottom=9))
        else:
            heading = ui.label(f"<b>{ui.GLib.markup_escape_text(kind)}</b>", dim=True, wrap=False, markup=True)
            heading.set_margin_top(18 if before is not None else 6)
            heading.set_margin_bottom(6)
            heading.set_margin_start(12)
            row.set_header(heading)

    listbox.set_header_func(header)
    listbox.connect("row-selected", lambda _l, row: row is not None and open_page(row.page.id))
    scrolled = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
    scrolled.add(listbox)
    return scrolled, listbox


def select_page_row(listbox, page_id):
    for row in listbox.get_children():
        if row.page.id == page_id and listbox.get_selected_row() is not row:
            listbox.select_row(row)


def search_index(ui, pages):
    """What the search box finds: each page, the rows and headings the pages
    built (ui.index), and the tiles' apps."""
    items = []
    for page in PAGES:
        if page.id in pages:
            items.append(search_item(page.name, "Page", SEARCH_KEYWORDS.get(page.id, ""), page=page.id))
            items += [item for item in ui.index if item.page == page.id]
    for tile in available_tiles():
        items.append(search_item(tile.name, f"Opens {tile.command[0]}", SEARCH_KEYWORDS.get(f"tile:{tile.id}", ""),
                                 command=tile.argv))
    return unique_items(items)


SCROLL_TRIES, SCROLL_TRY_MS = 30, 100  # rows and controls ready once their page has read


def scroll_to(ui, page, item, tries=SCROLL_TRIES):
    """Scroll the page so item's widget is near the top and focus its control;
    tried again for a while when the widget isn't on screen or the control
    isn't enabled yet."""
    scrolled = page.widget
    if item.target is not None and isinstance(scrolled, ui.Gtk.ScrolledWindow):
        content = scrolled.get_child()
        content = content.get_child() if isinstance(content, ui.Gtk.Viewport) else content
        coordinates = item.target.translate_coordinates(content, 0, 0) if item.target.get_mapped() else None
        if coordinates is None:
            if tries > 1:
                ui.GLib.timeout_add(SCROLL_TRY_MS, scroll_to, ui, page, item, tries - 1)
            return False
        adjustment = scrolled.get_vadjustment()
        top = adjustment.get_upper() - adjustment.get_page_size()
        adjustment.set_value(max(0, min(coordinates[1] - 24, top)))
    if item.focus is not None:
        if not item.focus.is_sensitive() and tries > 1:
            # Controls are off until their page has read (the power button's).
            ui.GLib.timeout_add(SCROLL_TRY_MS, scroll_to, ui, page, item, tries - 1)
            return False
        # Into the control, or the first focusable widget of a box of them.
        if not item.focus.child_focus(ui.Gtk.DirectionType.TAB_FORWARD):
            item.focus.grab_focus()
    return False


def open_window(gtk, page_id):
    GLib, _, Gtk, _ = gtk
    from gi.repository import Gdk              # loaded with Gtk 3 (load_gtk)
    ui = Ui(gtk)
    window = Gtk.Window(title=TITLE, icon_name=ICON)
    window.set_default_size(900, 660)
    window.connect("destroy", Gtk.main_quit)
    # Not homogeneous: GTK then sizes only the shown page, not all of them.
    stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.NONE, hhomogeneous=False, vhomogeneous=False)
    available = [page for page in PAGES if page_available(page.id)]
    pages = {}
    search_items = []               # built with the last page (search_index)

    def build(page_id):
        """The page, built the first time it's needed: the opened one before the
        window shows, the others one at a time after the first frame
        (PERF-1: building all 24 took about 0.5 s)."""
        if page_id not in pages:
            page = next(p for p in available if p.id == page_id)
            ui.indexing = page
            pages[page_id] = PAGE_CLASSES[page_id](ui)
            ui.indexing = None
            stack.add_titled(pages[page_id].widget, page_id, page.name)
            pages[page_id].widget.show_all()
        return pages[page_id]

    def build_all():
        """Every page; the search needs all their rows."""
        for page in available:
            build(page.id)
        if not search_items:
            search_items.extend(search_index(ui, pages))
        return search_items

    def build_next(remaining):
        page = next(remaining, None)
        if page is None:
            build_all()
            return False
        build(page.id)
        return True

    def open_page(page_id):
        build(page_id)
        stack.set_visible_child_name(page_id)

    # Left: the search box, then the pages, or the results while searching.
    search = Gtk.SearchEntry(placeholder_text="Search settings", margin=6)
    sidebar, sidebar_list = page_list(ui, open_page, available)
    results = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE)
    results_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
    results_scroll.add(results)
    left_stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.NONE)
    left_stack.add_named(sidebar, "pages")
    left_stack.add_named(results_scroll, "results")
    left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    left.set_size_request(220, -1)
    left.pack_start(search, False, False, 0)
    left.pack_start(left_stack, True, True, 0)

    def result_row(item):
        row = Gtk.ListBoxRow()
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin=8)
        title = ui.label(item.title, wrap=False)
        title.set_ellipsize(3)              # Pango.EllipsizeMode.END
        text.pack_start(title, False, False, 0)
        text.pack_start(ui.label(item.where, dim=True, wrap=False), False, False, 0)
        row.add(text)
        row.item = item
        return row

    def changed(entry):
        for child in results.get_children():
            results.remove(child)
        query = entry.get_text()
        if not query.strip():
            left_stack.set_visible_child_name("pages")
            return
        found = find(build_all(), query)
        for item in found:
            results.add(result_row(item))
        if not found:
            empty = Gtk.ListBoxRow(activatable=False, selectable=False)
            empty.add(ui.label("No settings found", dim=True, wrap=False))
            empty.get_child().set_margin_top(8)
            empty.get_child().set_margin_start(8)
            results.add(empty)
        results.show_all()
        first = results.get_row_at_index(0)
        if found and first is not None:
            results.select_row(first)
        left_stack.set_visible_child_name("results")

    def choose(item):
        search.set_text("")
        if item.command:
            ui.start_app(item.command)
            return
        open_page(item.page)
        GLib.idle_add(scroll_to, ui, pages[item.page], item)

    def activated(_listbox, row):
        if getattr(row, "item", None):
            choose(row.item)

    def enter():
        row = results.get_selected_row() or results.get_row_at_index(0)
        if left_stack.get_visible_child_name() == "results" and row is not None and getattr(row, "item", None):
            choose(row.item)

    def key_pressed(_window, event):
        """Ctrl+F searches; a letter or digit typed outside a text field too.
        Ctrl+W closes the window."""
        if event.state & Gdk.ModifierType.CONTROL_MASK and Gdk.keyval_to_lower(event.keyval) == Gdk.KEY_f:
            search.grab_focus()
            return True
        if event.state & Gdk.ModifierType.CONTROL_MASK and Gdk.keyval_to_lower(event.keyval) == Gdk.KEY_w:
            window.destroy()
            return True
        # Enter in the search box opens the first result (handled here: the
        # entry's activate signal doesn't reach us while a search is pending).
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and search.has_focus():
            enter()
            return True
        if event.keyval == Gdk.KEY_Escape and search.get_text():
            search.set_text("")
            search.grab_focus_without_selecting()
            return True
        if event.keyval == Gdk.KEY_Down and search.has_focus() and left_stack.get_visible_child_name() == "results":
            row = results.get_selected_row() or results.get_row_at_index(0)
            if row is not None:
                row.grab_focus()
            return True
        focus = window.get_focus()
        if isinstance(focus, Gtk.Editable) or event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK):
            return False
        if not event.string or not event.string.isalnum():
            return False                # space, arrows: keep them for the focused control
        if search.handle_event(event):
            search.grab_focus_without_selecting()   # the next keys, Enter and Escape go there
            return True
        return False

    search.connect("search-changed", changed)
    search.connect("stop-search", lambda entry: entry.set_text(""))
    results.connect("row-activated", activated)
    window.connect("key-press-event", key_pressed)

    box = Gtk.Box()
    box.pack_start(left, False, False, 0)
    box.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)
    box.pack_start(stack, True, True, 0)
    window.add(box)
    build(page_id)
    window.show_all()
    stack.set_visible_child_name(page_id)
    select_page_row(sidebar_list, page_id)
    pages[page_id].shown()

    def page_changed(s, _p):
        select_page_row(sidebar_list, s.get_visible_child_name())    # after a search or --page
        pages[s.get_visible_child_name()].shown()

    stack.connect("notify::visible-child-name", page_changed)
    # Below drawing and input, so the window shows and answers first.
    GLib.idle_add(build_next, iter(available), priority=GLib.PRIORITY_LOW)
    Gtk.main()
    return 0


def cmd_open(opts):
    page_id = opts.page or PAGES[0].id
    if page_id not in PAGE_CLASSES:
        warn(f"unknown page '{page_id}'. Pages: {', '.join(page.id for page in PAGES)}")
        return 2
    if not page_available(page_id):
        warn(f"the {page_id} page doesn't apply here; opening {PAGES[0].id}")
        page_id = PAGES[0].id
    with single_instance() as first:
        if not first:
            print("Settings is already open.")
            return 0
        gtk = load_gtk()
        if gtk is None:
            return 1
        return open_window(gtk, page_id)


def cmd_get(opts):
    values, sources = load_values()
    keys = [opts.key] if opts.key else list(SETTINGS)
    for key in keys:
        if key not in SETTINGS:
            warn(f"unknown setting '{key}'. Settings: {', '.join(SETTINGS)}")
            return 2
        setting = SETTINGS[key]
        value = values.get(key)
        if value is None and setting.default is not None:
            value = normalize(setting, "yes" if setting.default is True else "no" if setting.default is False
                              else setting.default)
        print(f"{key}\t{value if value is not None else ''}\t{sources.get(key, 'default')}")
    return 0


def cmd_set(opts):
    setting = SETTINGS.get(opts.key)
    if setting is None:
        warn(f"unknown setting '{opts.key}'. Settings: {', '.join(SETTINGS)}")
        return 2
    values, _ = load_values()
    note = None
    if opts.value == "default":
        if setting.default is not None:
            # Stored, not removed: labwc keeps a value that disappears.
            text = "yes" if setting.default is True else "no" if setting.default is False else setting.default
            changes = {setting.key: normalize(setting, text)}
        else:
            changes = {setting.key: None}
            if setting.key == "keyboard.layout":
                changes["keyboard.variant"] = None      # it belonged to the layout
            if setting.topic == "input" and in_session():
                note = "The device's own default comes back at the next login."
    else:
        changes = {setting.key: normalize(setting, opts.value)}
        if setting.kind == "xkb":
            changes = check_xkb(setting.key, changes[setting.key], values, xkb_rules())
        elif setting.kind == "locale":
            check_locale(setting.key, changes[setting.key])
    save_values(changes)
    live = in_session()
    if setting.topic == "history":
        if changes[setting.key] == "no":
            clear_history()
            print("History turned off and cleared.")
        else:
            print("History turned on. Changes are kept from now on.")
        return 0
    if setting.topic == "night-light":
        if live:
            restart_night_light()
            print("Applied.")
        else:
            print("Saved. It applies at the next login.")
        return 0
    if setting.topic == "notifications":
        problem = mako_config_problem()
        if live and notifications_running():
            set_do_not_disturb(changes[setting.key] == "yes")
            print("Applied.")
        else:
            print("Saved. It applies when notifications start.")
        if problem:
            print(problem)
        return 0
    if setting.topic == "lock":
        print("Saved. The screen locks this way from now on.")
        return 0
    if setting.topic == "idle":
        if live:
            restart_idle()
            print("Applied." if not live_session() else "Saved. There is no idle lock in the live session.")
        else:
            print("Saved. It applies at the next login.")
        return 0
    write_fragments(live)
    status = 0
    if live:
        result = subprocess.run([LAYOUT, "reconfigure"], capture_output=True, text=True,
                                timeout=COMMAND_SECONDS, check=False)
        for line in output_messages(result.stdout, result.stderr):
            warn(line)
        status = 0 if result.returncode == 0 else 1
        print("Applied." if status == 0 else "Saved, but not applied.")
        if status == 0 and setting.topic == "locale":
            note = "Apps you open from now on use it; the panel and open apps after the next login."
    else:
        print("Saved. It applies at the next login.")
    if note:
        print(note)
    return status


def cmd_idle(opts):
    """autostart: swayidle with the chosen times (replaces this process)."""
    if live_session():
        print("No idle lock in the live session.")
        return 0
    if shutil.which("swayidle") is None:
        warn("swayidle is not installed; the screen is not locked when idle")
        return 1
    command = idle_command(load_values()[0])
    os.execvpe(command[0], command, dict(os.environ, **{IDLE_MARK: "1"}))


def displays_list(opts, profiles):
    for name, title, _ in profiles:
        print(f"{name}\t{title}")
    return 0


def displays_start(opts, profiles):
    """autostart: kanshi for the kept arrangements (replaces this process);
    nothing without one, or while a kanshi runs."""
    ours, others = display_daemons()
    if not profiles or ours:
        return 0
    if others:
        warn("another kanshi is running; the arrangements kept in Settings apply when it isn't")
        return 0
    if shutil.which("kanshi") is None:
        warn("kanshi is not installed; kept screen arrangements are not applied")
        return 1
    os.execvpe("kanshi", ["kanshi", "-c", displays_file()], dict(os.environ, **{DISPLAYS_MARK: "1"}))
    return 1


def displays_save(opts, profiles):
    if opts.name:
        warn("save takes no name: it keeps the screens connected now")
        return 2
    if not os.environ.get("WAYLAND_DISPLAY"):
        raise ControlError("not in a Wayland session: there are no screens to keep")
    screens = read_screens()
    if not screens:
        raise ControlError("no screens are connected")
    overlaps = overlapping_screens(screens)
    if overlaps:
        raise ControlError(f"not kept: {overlap_message(overlaps)}")
    name, text = screens_profile(screens)
    title = screens_title(screens)
    write_profiles([profile for profile in profiles if profile[0] != name] + [(name, title, text)])
    restart_displays()
    print(f"Kept: {title}. These screens are set up this way whenever they are connected.")
    return 0


def displays_forget(opts, profiles):
    if not opts.name:
        warn("forget: give the name of an arrangement (displays list) or all")
        return 2
    kept = [] if opts.name == "all" else [profile for profile in profiles if profile[0] != opts.name]
    if len(kept) == len(profiles) and opts.name != "all":
        raise ControlError(f"no kept arrangement '{opts.name}'. "
                           f"Kept: {', '.join(profile[0] for profile in profiles) or 'none'}")
    write_profiles(kept)
    restart_displays()
    print("Forgotten. The screens stay as they are until they change or you log out.")
    return 0


def displays_arrange(opts, profiles):
    """wdisplays (Arrange Screens…, the Displays tile and menu entries); while
    it is open, a screen it turns on over another moves beside them
    (place_turned_on). Nothing checks once it is closed."""
    if opts.name:
        warn("arrange takes no name")
        return 2
    if shutil.which(ARRANGE[0]) is None:
        warn(f"{ARRANGE[0]} is not installed: there is nothing to arrange the screens with")
        return 1
    try:
        on = screens_on(read_screens())
    except ControlError:
        on = None                   # not in a Wayland session: wdisplays says so itself
    process = subprocess.Popen(list(ARRANGE), stdin=subprocess.DEVNULL)
    while True:
        try:
            process.wait(timeout=ARRANGE_CHECK_SECONDS)
        except subprocess.TimeoutExpired:
            if on is not None:
                on = place_turned_on(on)
            continue
        if on is not None:
            place_turned_on(on)     # turned on just before it closed
        return process.returncode


DISPLAYS_ACTIONS = {"list": displays_list, "save": displays_save, "forget": displays_forget, "start": displays_start,
                    "arrange": displays_arrange}


def cmd_displays(opts):
    """The kept screen arrangements (kanshi profiles)."""
    return DISPLAYS_ACTIONS[opts.action](opts, read_profiles())


def cmd_lock(opts):
    """Lock the screen with the chosen background (replaces this process)."""
    if shutil.which("swaylock") is None:
        warn("swaylock is not installed")
        return 1
    command = lock_command(load_values()[0])
    os.execvp(command[0], command)
    return 1


def cmd_night_light(opts):
    """autostart: night light as chosen (replaces this process), or nothing
    while it is off."""
    command = night_light_command(load_values()[0])
    if command is None:
        return 0
    if not os.path.isfile(NIGHT_LIGHT):
        warn(f"{NIGHT_LIGHT} is missing (flickos-settings); no night light")
        return 1
    os.execve(NIGHT_LIGHT, command, dict(os.environ, **{NIGHT_LIGHT_MARK: "1"}))
    return 1


def cmd_notifications(opts):
    """autostart: Do Not Disturb on again once mako runs (a new mako starts
    without it). Nothing while it is off."""
    if not value_of(SETTINGS["notifications.do-not-disturb"], load_values()[0].get("notifications.do-not-disturb")):
        return 0
    deadline = time.monotonic() + MAKO_START_SECONDS
    while not notifications_running():
        if time.monotonic() > deadline:
            warn("notifications didn't start; Do Not Disturb is not on")
            return 1
        time.sleep(0.5)
    set_do_not_disturb(True)
    return 0


def cmd_startup(opts):
    """Startup applications: list, enable, disable, add, remove, run (autostart)."""
    if opts.action in ("list", "run") and opts.id:
        warn(f"{opts.action} takes no id")
        return 2
    if opts.action not in ("list", "run") and not opts.id:
        warn(f"{opts.action}: give a desktop file id (flickos-control startup list)")
        return 2
    if opts.action == "list":
        for entry in startup_entries():
            print(f"{entry.id}\t{'on' if entry.enabled else 'off'}\t{'system' if entry.system else 'user'}"
                  f"\t{entry.name}")
    elif opts.action == "run":
        run_startup()
    else:
        old = startup_state(opts.id)
        if opts.action in ("enable", "disable"):
            set_startup_enabled(opts.id, opts.action == "enable")
            print(f"{'On' if opts.action == 'enable' else 'Off'} from the next login.")
        elif opts.action == "add":
            print(f"{add_startup(opts.id)} starts at every login from now on.")
        else:
            print(f"{remove_startup(opts.id)} no longer starts at login.")
        record(f"startup.{opts.id}", old, startup_state(opts.id))
    return 0


def cmd_updates(opts):
    """The automatic update settings (they change through the helper)."""
    state = updates_state()
    last = time.strftime("%Y-%m-%d %H:%M", time.localtime(state["last"])) if state["last"] else "never"
    for key, value in (("auto", "yes" if state["auto"] else "no"), ("scope", state["scope"]),
                       ("reboot", state["reboot"]), ("last", last)):
        print(f"{key}\t{value}")
    return 0


def run_undo(commands):
    """Run the owner's commands of an undo; 0 when all of them worked."""
    status = 0
    for command in commands:
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=COMMAND_SECONDS, check=False)
        except (OSError, subprocess.TimeoutExpired) as error:
            warn(f"{command[0]}: {error}")
            return 1
        if result.stdout:
            print(result.stdout, end="")
        for line in output_messages("", result.stderr):
            warn(line)
        if result.returncode != 0:
            status = 1
    return status


def cmd_history(opts):
    """The changes to the desktop's settings: list, undo ID, restore WHEN, clear."""
    if (opts.action in ("undo", "restore")) != bool(opts.id):
        warn({"undo": "undo takes the id of a change (flickos-control history)",
              "restore": "restore takes a change's id, a date or a date and time"}.get(opts.action,
                                                                                     f"{opts.action} takes no id"))
        return 2
    if opts.action == "restore":
        return restore(opts.id, opts.dry_run)
    if opts.action == "clear":
        clear_history()
        print("History cleared.")
        return 0
    if opts.action == "undo" and TRANSACTION_ID.match(opts.id):
        # Software: the helper checks it again as root, and pkexec asks for the password.
        for line in plan_text(helper_json(["packages-plan", opts.id])):
            print(line)
        return run_undo([["pkexec", HELPER, "packages-undo", opts.id]])
    if opts.action == "undo":
        change = find_change(opts.id, shape_history(read_history(), days=None))
        return run_undo(undo_commands(change))
    settings = shape_history(read_history(), days=opts.days)
    names = history_names(settings)
    changes = sorted(settings + software_changes(opts.days), key=lambda c: c.when, reverse=True)
    learn_app_names([p for c in changes if isinstance(c, SoftwareChange) for p in c.packages[:APP_NAMES_SHOWN]])
    if opts.json:
        print(json.dumps([{"id": c.id, "time": c.when.isoformat(timespec="seconds"),
                           "owner": "apt" if isinstance(c, SoftwareChange) else c.owner,
                           "key": c.kind if isinstance(c, SoftwareChange) else c.key,
                           "old": "" if isinstance(c, SoftwareChange) else c.old,
                           "new": "" if isinstance(c, SoftwareChange) else c.new,
                           "undoable": c.undoable, "text": describe(c, names)[0]} for c in changes],
                         indent=1, ensure_ascii=False))
        return 0
    if not changes:
        print("No changes yet." if history_enabled() else "History is off (flickos-control set history.enabled yes).")
    for change in changes:
        title, detail = describe(change, names)
        print(f"{change.id}\t{change.when:%Y-%m-%d %H:%M}\t{'undo' if change.undoable else '-'}\t{title}"
              + (f" ({detail[0].lower()}{detail[1:]})" if detail else ""))
    return 0


def cmd_about(opts):
    print(system_info_text(), end="")
    return 0


def cmd_prepare(opts):
    """At login, before flickos-layout prepare: the fragments for labwc."""
    write_fragments(live=False)
    return 0


def cmd_list(opts):
    for page in PAGES:
        print(f"{page.id}\t{page.name}")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="flickos-control", description="Settings of the FlickOS desktop.")
    parser.add_argument("--page", metavar="ID", help="open on this page (see: flickos-control list)")
    commands = parser.add_subparsers(dest="command", metavar="COMMAND")
    commands.add_parser("list", help="print the pages: id, name").set_defaults(func=cmd_list)
    get = commands.add_parser("get", help="print settings: key, value, source (default, system or user)")
    get.add_argument("key", nargs="?")
    get.set_defaults(func=cmd_get)
    setter = commands.add_parser("set", help='change a setting and apply it ("default" for its default)')
    setter.add_argument("key")
    setter.add_argument("value")
    setter.set_defaults(func=cmd_set)
    commands.add_parser("prepare", help="write the labwc fragments for this login (flickos-session)"
                        ).set_defaults(func=cmd_prepare)
    commands.add_parser("idle", help="lock and suspend when idle, as chosen (autostart; runs swayidle)"
                        ).set_defaults(func=cmd_idle)
    commands.add_parser("lock", help="lock the screen with the chosen background").set_defaults(func=cmd_lock)
    commands.add_parser("night-light", help="run night light as chosen, or nothing while it is off (autostart)"
                        ).set_defaults(func=cmd_night_light)
    commands.add_parser("notifications", help="turn Do Not Disturb on again once notifications run (autostart)"
                        ).set_defaults(func=cmd_notifications)
    startup = commands.add_parser("startup", help="startup applications (XDG autostart)")
    startup.add_argument("action", choices=("list", "enable", "disable", "add", "remove", "run"))
    startup.add_argument("id", nargs="?", help="a desktop file id (startup list; add: an installed app's)")
    startup.set_defaults(func=cmd_startup)
    commands.add_parser("updates", help="print the automatic update settings").set_defaults(func=cmd_updates)
    displays = commands.add_parser("displays", help="kept screen arrangements (kanshi profiles)")
    displays.add_argument("action", choices=DISPLAYS_ACTIONS)
    displays.add_argument("name", nargs="?", help="forget: the arrangement's name (displays list), or all")
    displays.set_defaults(func=cmd_displays)
    commands.add_parser("about", help="print the system information (for bug reports)"
                        ).set_defaults(func=cmd_about)
    history = commands.add_parser("history", help="changes to the desktop's settings: list, undo ID, clear")
    history.add_argument("action", nargs="?", default="list", choices=("list", "undo", "restore", "clear"))
    history.add_argument("id", nargs="?", help="undo: the change's id (the first column of history); a software "
                         "change's is a date and time")
    history.add_argument("--days", type=int, default=HISTORY_DAYS, help=f"list: this many days (default "
                         f"{HISTORY_DAYS})")
    history.add_argument("--json", action="store_true", help="list: as JSON")
    history.add_argument("--dry-run", action="store_true", help="restore: only print what would go back")
    history.set_defaults(func=cmd_history)
    system = commands.add_parser("system", help="print or change a system setting (asks for the password) "
                                 "and record it for History")
    system.add_argument("key", help=", ".join(SYSTEM_LABELS))
    system.add_argument("value", nargs="?")
    system.set_defaults(func=cmd_system)
    default_apps = commands.add_parser("default-app", help="default applications: list, set CATEGORY APP")
    default_apps.add_argument("action", choices=("list", "set"))
    default_apps.add_argument("category", nargs="?", help=", ".join(DEFAULT_APP_LABELS))
    default_apps.add_argument("app", nargs="?", help="an installed app's desktop file id")
    default_apps.set_defaults(func=cmd_default_app)
    animations_command = commands.add_parser("animations", help="animations (GSettings enable-animations): "
                                             "current, set on|off|default")
    animations_command.add_argument("action", choices=("current", "set"))
    animations_command.add_argument("value", nargs="?", help="on, off or default")
    animations_command.set_defaults(func=cmd_animations)
    opts = parser.parse_args(argv)
    try:
        return getattr(opts, "func", cmd_open)(opts)
    except (ControlError, OSError, subprocess.TimeoutExpired) as error:
        warn(str(error))
        return 1
    except KeyboardInterrupt:
        return 1


if __name__ == "__main__":
    sys.exit(main())
