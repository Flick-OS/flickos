@dataclasses.dataclass(frozen=True)
class Page:
    id: str
    name: str
    group: str = ""     # the sidebar heading above it; the last pages have none


# In sidebar order: a group's pages next to each other.
PAGES = (
    Page("layout", _("Desktop Layout & Style"), _("Desktop")),
