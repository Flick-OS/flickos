def state_home():
    return os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")


def history_path():
    return os.path.join(state_home(), "flickos", HISTORY_FILE)


def history_enabled():
    """[History] Enabled= of the user's file, else the system's; on by
    default. Read the same way by flickos-layout and flick-tiler."""
    enabled = True
    for path in (system_file("history"), user_file("history")):
        ini = configparser.ConfigParser(interpolation=None)
        try:
            ini.read(path, encoding="utf-8")
            value = ini.get("History", "Enabled", fallback=None)
        except (configparser.Error, UnicodeDecodeError):
            continue
        if value is not None:
            enabled = value.strip().lower() not in FALSE
    return enabled


def record(key, old, new):
    """Add a change to the history. It never stops the change itself: a
    history that can't be written is only a warning."""
    if old == new or not history_enabled():
        return
    now = time.time_ns()
    entry = {"v": 1, "id": str(now),
             "time": datetime.datetime.fromtimestamp(now / 1e9).astimezone().isoformat(timespec="seconds"),
             "owner": HISTORY_OWNER, "key": key, "old": old, "new": new}
    folder = os.path.dirname(history_path())
    try:
        os.makedirs(folder, mode=0o700, exist_ok=True)
        with open(os.path.join(folder, HISTORY_LOCK), "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            fd = os.open(history_path(), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a", encoding="utf-8") as f:
                f.write(json.dumps(entry, ensure_ascii=False) + "\n")
                size = os.fstat(f.fileno()).st_size
            if size > HISTORY_BYTES:
                trim_history(history_path())
    except OSError as error:
        warn(f"the history can't be written: {error}")


def trim_history(path):
    """Keep the newest lines that fit in half of HISTORY_BYTES (under the lock)."""
    with open(path, encoding="utf-8", errors="replace") as f:
        lines = f.readlines()
    kept, size = [], 0
    for line in reversed(lines):
        size += len(line.encode())
        if size > HISTORY_BYTES // 2:
            break
        kept.append(line)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.writelines(reversed(kept))
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def clear_history():
    """Delete the history, and leave out apt's changes made until now (its
    log isn't ours to delete)."""
    folder = os.path.dirname(history_path())
    os.makedirs(folder, mode=0o700, exist_ok=True)
    with open(os.path.join(folder, HISTORY_LOCK), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with contextlib.suppress(FileNotFoundError):
            os.unlink(history_path())
        write_atomic(os.path.join(folder, HISTORY_CLEARED),
                     datetime.datetime.now().astimezone().isoformat(timespec="seconds") + "\n")


def read_history(path=None):
    """The entries, oldest first. A line that can't be read (the last one
    after a power cut, a format this version doesn't know) is left out."""
    try:
        with open(path or history_path(), encoding="utf-8", errors="replace") as f:
            lines = f.readlines()
    except FileNotFoundError:
        return []
    except OSError as error:
        raise ControlError(f"The history can't be read: {error}") from None
    entries = []
    for line in lines:
        try:
            entry = json.loads(line)
            if entry.get("v") != 1 or not all(isinstance(entry.get(field), str)
                                              for field in ("id", "time", "owner", "key", "old", "new")):
                continue
            entry["when"] = datetime.datetime.fromisoformat(entry["time"])
            entry["number"] = int(entry["id"])
            # The id is the time in nanoseconds (time is kept to the second):
            # a restore compares moments within one second.
            precise = datetime.datetime.fromtimestamp(entry["number"] / 1e9, entry["when"].tzinfo)
            if abs((precise - entry["when"]).total_seconds()) < 2:
                entry["when"] = precise
        except (ValueError, AttributeError, TypeError, OverflowError, OSError):
            continue
        if entry["when"].tzinfo is not None:
            entries.append(entry)
    entries.sort(key=lambda entry: entry["number"])
    return entries


@dataclasses.dataclass
class Change:
    """A change as History shows it: the entries of one setting that follow
    each other within MERGE_SECONDS, from the first one's old value to the
    last one's new value."""
    id: str                         # the last entry's (what `history undo` takes)
    when: datetime.datetime         # the last entry's
    owner: str
    key: str
    old: str
    new: str
    newest: bool = False            # no later change of the same setting
    undoable: bool = False          # newest, and History knows how


def can_undo(change):
    """Whether History knows how to put this change back (undo_commands)."""
    owner, key, old = change.owner, change.key, change.old
    if owner == LAYOUT:
        return key in LAYOUT_HISTORY_KEYS
    if owner == TILER:
        return key in TILER_HISTORY_KEYS
    if owner == PHONE:
        return key in PHONE_HISTORY_KEYS
    if owner == SCREENSHOT:
        return key in SCREENSHOT_HISTORY_KEYS
    if owner != HISTORY_OWNER:
        return False
    if key == RESTORE_KEY:
        return bool(parse_when(old, quiet=True))
    if key in SETTINGS:
        return SETTINGS[key].topic != "history"
    if key == ANIMATIONS_KEY:
        return old in ("on", "off")
    if key in SYSTEM_LABELS:
        with contextlib.suppress(ControlError):
            check_system(key, old)
            return True
        return False
    prefix, _, rest = key.partition(".")
    if prefix == "default-app":
        return bool(old) and rest in DEFAULT_APP_LABELS
    if prefix == "startup":
        return bool(DESKTOP_ID.match(rest))
    if prefix == "user":
        return {old, change.new} <= {"standard", "administrator"}
    return False


def same_value(change, value):
    """A value to compare: flickos-control's settings store their default
    ("default" and "yes" for tap to click are the same)."""
    if change.owner == HISTORY_OWNER and value == DEFAULT_CHOICE and change.key in SETTINGS:
        return effective(change.key, {}) or value
    return value


def shape_history(entries, now=None, days=HISTORY_DAYS):
    """The Changes of the last `days` days (None: all), newest first. A change
    that ends where it started (tiling on, then off again) is left out."""
    changes, last = [], {}
    for entry in entries:
        setting = (entry["owner"], entry["key"])
        change = last.get(setting)
        if change is not None and (entry["when"] - change.when).total_seconds() <= MERGE_SECONDS:
            change.id, change.when, change.new = entry["id"], entry["when"], entry["new"]
        else:
            change = last[setting] = Change(entry["id"], entry["when"], entry["owner"], entry["key"],
                                            entry["old"], entry["new"])
            changes.append(change)
    changes = [change for change in changes if same_value(change, change.old) != same_value(change, change.new)]
    changes.sort(key=lambda change: int(change.id))
    newest = {(change.owner, change.key): change for change in changes}
    for change in newest.values():
        change.newest = True
        change.undoable = can_undo(change)
    # The changes a restore made (between its start, its old value, and its
    # own entry) are shown as the restore: its Undo covers them.
    windows = [(parse_when(c.old, quiet=True), c.when) for c in changes if (c.owner, c.key) == RESTORE]
    changes = [c for c in changes if (c.owner, c.key) == RESTORE or
               not any(start and start < c.when <= end for start, end in windows)]
    if days is not None:
        now = now or datetime.datetime.now().astimezone()
        changes = [change for change in changes if now - change.when < datetime.timedelta(days=days)]
    return changes[::-1]


def undo_commands(change):
    """The owner's commands that put the old value back."""
    owner, key, old = change.owner, change.key, change.old
    if not can_undo(change):
        raise ControlError(f"{owner} {key}: History can't undo this")
    prefix, _, rest = key.partition(".")
    if owner == HISTORY_OWNER and key == RESTORE_KEY:
        return [[*SELF, "history", "restore", old]]         # as it was just before the restore
    if owner == HISTORY_OWNER and key in SETTINGS:
        return [[*SELF, "set", key, old]]
    if owner == HISTORY_OWNER and key in SYSTEM_LABELS:
        return [[*SELF, "system", key, old]]
    if owner == HISTORY_OWNER and prefix == "default-app":
        return [[*SELF, "default-app", "set", rest, old]]
    if owner == HISTORY_OWNER and key == ANIMATIONS_KEY:
        return [[*SELF, "animations", "set", old]]
    if owner == HISTORY_OWNER and prefix == "startup":
        if old == "absent":
            return [[*SELF, "startup", "remove", rest]]
        if change.new == "absent":
            return [[*SELF, "startup", "add", rest]] + ([[*SELF, "startup", "disable", rest]] if old == "off" else [])
        return [[*SELF, "startup", "enable" if old == "on" else "disable", rest]]
    if owner == HISTORY_OWNER and prefix == "user":
        return [["pkexec", HELPER, "user-admin", rest, "yes" if old == "administrator" else "no"]]
    if owner == LAYOUT and key == "layout":
        return [[LAYOUT, "set", old]]
    if owner == LAYOUT and key in LAYOUT_HISTORY_KEYS:
        return [[LAYOUT, key, "set", old]]
    if owner == TILER and key == "enabled":
        return [[TILER, "on" if old == "on" else "off"]]
    if owner == TILER and key in ("mode", "ratio", "gap"):
        return [[TILER, key, "--", old] if old.startswith("-") else [TILER, key, old]]
    if owner == TILER and key == "floating":
        before, after = old.split(), change.new.split()
        commands = [[TILER, "floating", "remove", pattern] for pattern in after
                    if pattern.lower() not in {p.lower() for p in before}]
        return commands + [[TILER, "floating", "add", pattern] for pattern in before
                           if pattern.lower() not in {p.lower() for p in after}]
    if owner == PHONE and key in PHONE_HISTORY_KEYS:
        return [[PHONE, "set", key, old]]
    if owner == SCREENSHOT and key in SCREENSHOT_HISTORY_KEYS:
        return [[SCREENSHOT, "set", key, old]]
    raise ControlError(f"{owner} {key}: History can't undo this")


def current_value(change):
    """The setting's value now, in the history's words, to compare with the
    change's new value; None where the owner can't say (then it isn't checked)."""
    owner, key = change.owner, change.key
    prefix, _, rest = key.partition(".")
    if owner == HISTORY_OWNER and key in SETTINGS:
        return read_values(user_file(SETTINGS[key].topic)).get(key, DEFAULT_CHOICE)
    if owner == HISTORY_OWNER:
        with contextlib.suppress(ControlError, OSError):
            if key in SYSTEM_LABELS:
                return None if change.new == DEFAULT_CHOICE else system_value(key)
            if prefix == "default-app":
                return default_app(rest)
            if key == ANIMATIONS_KEY:
                return animations()
            if prefix == "startup":
                return startup_state(rest)
            if prefix == "user":
                return next((("administrator" if a.admin else "standard") for a in accounts() if a.name == rest),
                            "absent")
        return None
    if change.new == DEFAULT_CHOICE:
        return None                 # the owners report the value in use, not whether it is the user's
    if owner == LAYOUT:
        try:
            return json.loads(run([LAYOUT, "state"]))[key]["current"]
        except (ValueError, KeyError, TypeError):
            return None
    if owner == TILER and key == "floating":
        return " ".join(run([TILER, "floating", "list"]).split())
    if owner == TILER and key in ("mode", "ratio", "gap"):
        value = getattr(tiler_state(run([TILER, "status"])), key)
        return None if value is None else str(value)
    if owner == PHONE and key in PHONE_HISTORY_KEYS:
        return run([PHONE, "get", key]).strip()
    if owner == SCREENSHOT and key in SCREENSHOT_HISTORY_KEYS:
        return run([SCREENSHOT, "get", key]).strip()
    return None


def find_change(change_id, changes):
    """The change to undo. Raises ControlError when it can't be undone."""
    change = next((change for change in changes if change.id == change_id), None)
    if change is None:
        raise ControlError(f"no change {change_id} in the history (flickos-control history)")
    if not change.newest:
        raise ControlError("This setting was changed again since. Only its newest change can be undone.")
    if not change.undoable:
        raise ControlError("History can't undo this change.")
    current = current_value(change)
    if current is not None and current != change.new:
        raise ControlError("This setting was changed since without FlickOS, so nothing was undone.")
    return change


# Put back as it was (`history restore WHEN`): every setting changed since
# WHEN that goes back without a password gets the value it had then. System
# settings and software aren't included: they ask for a password and are for
# everyone; each keeps its own Undo. The restore ends with an entry of its own,
# key RESTORE_KEY, old = when it started (what its Undo restores to), new = WHEN.
RESTORE_KEY = "restore"
RESTORE = (HISTORY_OWNER, RESTORE_KEY)
LAYOUT_SET_OPTIONS = {"style": "--style", "clicks": "--clicks", "launcher": "--launcher",
                      "menu-style": "--menu-style"}     # flickos-layout set's; the others have their own command
WHEN_DATE = re.compile(r"^\d{4}-\d\d-\d\d$")


def parse_when(text, quiet=False):
    """A moment: a change's id (just before it), a date (the end of that day)
    or a date and time (local unless it says otherwise). Raises ControlError,
    or with quiet gives None."""
    text = (text or "").strip()
    try:
        if text.isdigit():
            return datetime.datetime.fromtimestamp((int(text) - 1) / 1e9).astimezone()
        if WHEN_DATE.match(text):
            day = datetime.date.fromisoformat(text)
            return datetime.datetime.combine(day, datetime.time.max).astimezone()
        when = datetime.datetime.fromisoformat(text)
        return when if when.tzinfo else when.astimezone()
    except (ValueError, OverflowError, OSError):
        if quiet:
            return None
        raise ControlError(f"give a change's id, a date (2026-09-21) or a date and time (2026-09-21T18:00), "
                           f"not '{text}'") from None


def when_words(when, names):
    clock = "%I:%M %p" if names.get("clock") == "12h" else "%H:%M"
    return f"on {when.astimezone().strftime('%A %x')} at {when.astimezone().strftime(clock)}"


def restorable(change):
    """Settings a restore puts back: the ones without a password."""
    owner, key = change.owner, change.key
    if owner in (LAYOUT, TILER, PHONE, SCREENSHOT):
        return can_undo(change)
    if owner != HISTORY_OWNER or key == RESTORE_KEY or key in SYSTEM_LABELS:
        return False
    if key in SETTINGS or key == ANIMATIONS_KEY or key.partition(".")[0] in ("default-app", "startup"):
        return can_undo(change)
    return False


def restore_plan(when, entries=None):
    """The Changes that put back every setting changed after `when`: old is
    the value it had then, new the value it has now (per the history)."""
    entries = read_history() if entries is None else entries
    first, last = {}, {}
    for entry in entries:
        if entry["when"] > when:
            setting = (entry["owner"], entry["key"])
            first.setdefault(setting, entry)
            last[setting] = entry
    plan = []
    for setting, entry in first.items():
        change = Change(last[setting]["id"], last[setting]["when"], *setting, entry["old"], last[setting]["new"])
        if restorable(change) and same_value(change, change.old) != same_value(change, change.new):
            plan.append(change)
    return plan


def restore_commands(plan):
    """The owners' commands for a plan: flickos-control's settings, the
    tiler, then flickos-layout's in one `set` (labwc reloads once)."""
    commands, layout = [], {}
    for change in plan:
        if change.owner == LAYOUT:
            layout[change.key] = change.old
        else:
            commands += undo_commands(change)
    if any(key == "layout" or key in LAYOUT_SET_OPTIONS for key in layout):
        command = [LAYOUT, "set"] + ([layout["layout"]] if "layout" in layout else [])
        for key, option in LAYOUT_SET_OPTIONS.items():
            if key in layout:
                command += [option, layout[key]]
        commands.append(command)
    for key in LAYOUT_HISTORY_KEYS:
        if key in layout and key != "layout" and key not in LAYOUT_SET_OPTIONS:
            commands.append([LAYOUT, key, "set", layout[key]])
    return commands


def restore(when_text, dry_run=False):
    """`history restore`: print what goes back, then do it and record it."""
    when = parse_when(when_text)
    plan = restore_plan(when)
    names = history_names(plan)
    print(f"Putting back the settings as they were {when_words(when, names)}:" if plan else
          "Nothing to put back: no setting that can be put back has changed since then.")
    for change in plan:
        title, _ = describe(dataclasses.replace(change, old=change.new, new=change.old), names)
        print(f"  {title} (now {value_name(change.owner, change.key, change.new, names)})")
    if dry_run or not plan:
        return 0
    started = datetime.datetime.now().astimezone().isoformat(timespec="microseconds")
    status = run_undo(restore_commands(plan))
    record(RESTORE_KEY, started, when.isoformat(timespec="microseconds"))
    return status


def history_names(changes, clock=False):
    """{(owner, key): {value: name}} for the values of these changes that have
    names elsewhere (layouts, styles, tiling arrangements), and with clock the
    panel clock's hours ("clock": "12h") for showing times. The owners are
    asked only when needed, at the same time. What can't be read is shown as
    it is."""
    names = {}

    def layout_names():
        with contextlib.suppress(ControlError, ValueError):
            state = json.loads(run([LAYOUT, "state"]))
            for key in LAYOUT_HISTORY_KEYS:
                with contextlib.suppress(KeyError, TypeError):
                    names[(LAYOUT, key)] = {choice["id"]: choice["name"] for choice in state[key]["choices"]}
            with contextlib.suppress(KeyError, TypeError):
                names["clock"] = state["clock"]["current"]

    def tiler_names():
        with contextlib.suppress(ControlError):
            names[(TILER, "mode")] = {item.id: item.name for item in parse_items(run([TILER, "modes"]))}

    owners = {(change.owner, change.key) for change in changes}
    work = ([layout_names] if clock or any(owner == LAYOUT for owner, _ in owners) else []) + (
        [tiler_names] if (TILER, "mode") in owners else [])
    threads = [threading.Thread(target=function, daemon=True) for function in work]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()
    return names


def home_folder(path):
    """A folder as the user knows it: under the home folder, without it."""
    home = os.path.expanduser("~")
    try:
        if path and os.path.commonpath([os.path.abspath(path), home]) == home:
            return os.path.relpath(path, home)
    except ValueError:
        pass
    return path


def command_names(text):
    """The names in flickos-phone's commands value (a JSON list), for History."""
    text = (text or "").strip()
    if not text:
        return []
    try:
        data = json.loads(text)
    except ValueError:
        return []
    if not isinstance(data, list):
        return []
    names = []
    for item in data:
        if isinstance(item, dict) and isinstance(item.get("name"), str) and item["name"]:
            names.append(item["name"])
    return names


def value_name(owner, key, value, names):
    """A value in the words of the page that shows it."""
    if value == DEFAULT_CHOICE:
        return "the default"
    prefix = key.partition(".")[0]
    if owner == HISTORY_OWNER and key not in SETTINGS:
        if key.startswith("power."):
            return POWER_ACTIONS.get(value, value)
        if key in ("ntp", "updates.auto"):
            return "on" if value == "yes" else "off"
        if key == "updates.scope":
            return UPDATE_SCOPE_NAMES.get(value, value)
        if key == "updates.reboot":
            return UPDATE_REBOOT_NAMES.get(value, value)
        if prefix == "default-app":
            return app_name(value) if value else "none"
        if prefix in ("startup", "user"):
            return {"absent": "not in the list" if prefix == "startup" else "no account",
                    "standard": "standard user"}.get(value, value)
        return value
    setting = SETTINGS.get(key) if owner == HISTORY_OWNER else None
    try:
        if setting is not None and setting.kind == "bool" or (owner, key) in ((TILER, "enabled"),
                                                                              (PHONE, "enabled"),
                                                                              (PHONE, "notifications"),
                                                                              (PHONE, "calls"),
                                                                              (PHONE, "media"),
                                                                              (SCREENSHOT, "pointer")):
            return "on" if value.lower() in TRUE else "off"
        if setting is not None and setting.topic == "idle":
            return duration_name(value)
        if key == "night-light.temperature":
            return dict(NIGHT_LIGHT_CHOICES).get(int(value), f"{value} K")
        if setting is not None and key in NAMED_CHOICES:
            return dict(NAMED_CHOICES[key]).get(value_of(setting, value), value)
        if key == "keyboard.repeat-delay":
            return f"{value} ms"
        if key == "keyboard.repeat-rate":
            return f"{value} a second"
        if setting is not None and setting.kind == "locale":
            return locale_name(value)
    except (ValueError, ControlError):
        return value
    if (owner, key) == (PHONE, "networks"):
        count = len(value.split())
        return "none" if not count else "1 network" if count == 1 else f"{count} networks"
    if (owner, key) == (PHONE, "notification-apps"):
        names = [name for name in value.splitlines() if name]
        return "none" if not names else ", ".join(names)
    if (owner, key) == (PHONE, "commands"):
        names = command_names(value)
        return "none" if not names else ", ".join(names)
    if (owner, key) == (TILER, "ratio"):
        return f"{value} %"
    if (owner, key) == (TILER, "gap"):
        return f"{value} px"
    if (owner, key) == (SCREENSHOT, "sound"):
        return dict(SCREENSHOT_SOUNDS).get(value, value)
    if owner == SCREENSHOT and key in ("folder", "recordings-folder"):
        return home_folder(value)
    return names.get((owner, key), {}).get(value) or CHOICE_NAMES.get(value, value)


def describe(change, names):
    """(title, detail) of a change: "Desktop layout: Cupertino", "Was Redmond"."""
    if isinstance(change, SoftwareChange):
        return describe_software(change)
    if isinstance(change, RestorePoint):
        return f"Restore point: {change.description.rsplit(', ', 1)[0]}", "Put Back takes the system back to it"
    label = history_label(change.owner, change.key)
    prefix, _, rest = change.key.partition(".")
    if change.owner == HISTORY_OWNER and prefix == "user":
        if change.old == "absent":
            return f"User account added: {rest}", value_name(HISTORY_OWNER, change.key, change.new, names)
        if change.new == "absent":
            return f"User account removed: {rest}", ""
    if change.owner == HISTORY_OWNER and change.key == RESTORE_KEY:
        when = parse_when(change.new, quiet=True)
        return ("Settings put back as they were " + (when_words(when, names) if when else change.new),
                "Undo puts back what they were before")
    if change.owner == HISTORY_OWNER and prefix == "language":
        return f"Language added: {value_name(HISTORY_OWNER, 'locale.language', rest, names)}", ""
    if change.owner == PHONE and prefix == "device":
        if change.old == "absent":
            return f"Phone paired: {change.new}", ""
        return f"Phone forgotten: {change.old}", ""
    if (change.owner, change.key) == (TILER, "floating"):
        before, after = change.old.split(), change.new.split()
        added = [p for p in after if p.lower() not in {b.lower() for b in before}]
        removed = [p for p in before if p.lower() not in {a.lower() for a in after}]
        parts = ([f"{', '.join(added)} added"] if added else []) + ([f"{', '.join(removed)} removed"]
                                                                    if removed else [])
        return f"{label}: {'; '.join(parts) or 'changed'}", ""
    new, old = (value_name(change.owner, change.key, value, names) for value in (change.new, change.old))
    return f"{label}: {new}", f"Was {old}"


def history_label(owner, key):
    if (owner, key) in HISTORY_LABELS:
        return HISTORY_LABELS[(owner, key)]
    if owner == HISTORY_OWNER:
        if key == RESTORE_KEY:
            return "Settings put back"
        if key == ANIMATIONS_KEY:
            return "Animations"
        if key in SYSTEM_LABELS:
            return SYSTEM_LABELS[key]
        prefix, _, rest = key.partition(".")
        if prefix == "default-app":
            return DEFAULT_APP_LABELS.get(rest, rest)
        if prefix == "startup":
            return f"{startup_name(rest)} at login"
        if prefix == "user":
            return f"User account {rest}"
    return f"{owner} {key}"


# System settings: changed through the helper (they ask for an administrator's
# password) or timedatectl, with `system KEY VALUE`, which the pages run and
# which records the change. `system KEY` prints the value.
SYSTEM_LABELS = {
    "power.power-key": "Power button",
    "power.lid": "Closing the lid",
    "power.lid-external-power": "Closing the lid while plugged in",
    "firewall": "Firewall",
    "firewall.phones": "Firewall lets phones in",
    "firefox.memory": "Firefox uses less memory",
    "autologin": "Log in automatically",
    "updates.auto": "Install updates automatically",
    "updates.scope": "Which updates",
    "updates.reboot": "Restart when an update needs it",
    "timezone": "Time zone",
    "ntp": "Set the time automatically",
    "keyboard.system": "Keyboard layout of the login screen",
    "restore-points": "Restore points before software changes",
    "restore-points.auto": "Start a restore point by itself after failed starts",
}
HELPER_POWER_ACTIONS = ("poweroff", "suspend", "lock", "ignore", "default")
TIME_ZONE = re.compile(r"^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$")
SYSTEM_XKB = re.compile(r"^([A-Za-z0-9_,+-]+)(?:\(([A-Za-z0-9_,+-]*)\))?$")     # layout(variant)


def check_system(key, value):
    """The value as `system` takes it. Raises ControlError."""
    if key.startswith("power."):
        choices = HELPER_POWER_ACTIONS
    elif key in ("firewall", "firewall.phones", "autologin", "firefox.memory", "restore-points",
                 "restore-points.auto"):
        choices = ("on", "off")
    elif key == "ntp":
        choices = ("yes", "no")
    elif key == "updates.auto":
        choices = ("yes", "no", DEFAULT_CHOICE)
    elif key == "updates.scope":
        choices = (*(name for name in UPDATE_SCOPES), DEFAULT_CHOICE)
    elif key == "updates.reboot":
        choices = ("no", "idle", DEFAULT_CHOICE)
    elif key == "timezone":
        if not TIME_ZONE.match(value):
            raise ControlError(f"not a time zone: '{value}'")
        return value
    elif key == "keyboard.system":
        if not SYSTEM_XKB.match(value):
            raise ControlError(f"give a layout, or layout(variant), not '{value}'")
        return value
    else:
        raise ControlError(f"unknown system setting '{key}'. Settings: {', '.join(SYSTEM_LABELS)}")
    if value not in choices:
        raise ControlError(f"{key}: give one of {', '.join(choices)}, not '{value}'")
    return value


def system_value(key):
    """A system setting's value now, in `system`'s words. Raises ControlError."""
    if key.startswith("power."):
        return power_state()[key.partition(".")[2]]
    if key == "firewall":
        state = firewall_state()
        if state is None:
            raise ControlError("The firewall (ufw) isn't installed.")
        return "on" if state else "off"
    if key == "firewall.phones":
        if firewall_state() is None:
            raise ControlError("The firewall (ufw) isn't installed.")
        return "on" if phones_allowed() else "off"
    if key == "firefox.memory":
        state = firefox_memory_state()
        if state is None:
            raise ControlError("Firefox ESR isn't installed.")
        return "on" if state else "off"
    if key == "autologin":
        available, user = autologin_state()
        if not available:
            raise ControlError("Logging in automatically needs the FlickOS login screen of an installed system.")
        return "on" if user == user_name() else "off"
    if key.startswith("updates."):
        state = updates_state()
        name = key.partition(".")[2]
        return ("yes" if state["auto"] else "no") if name == "auto" else state[name]
    if key in ("timezone", "ntp"):
        found = time_settings(run(["timedatectl", "show"]))
        return found.get("Timezone", "") if key == "timezone" else ("yes" if found.get("NTP") == "yes" else "no")
    if key == "keyboard.system":
        keyboard = system_keyboard()
        return keyboard["layout"] + (f"({keyboard['variant']})" if keyboard["variant"] else "")
    if key in ("restore-points", "restore-points.auto"):
        if not shutil.which(RECOVERY):
            raise ControlError("Restore points (flickos-recovery) aren't installed.")
        name = "enabled" if key == "restore-points" else "auto-recover"
        return "on" if run([RECOVERY, "get", name]).split("\t")[1:2] == ["yes"] else "off"
    raise ControlError(f"unknown system setting '{key}'")


def system_command(key, value):
    if key.startswith("power."):
        return ["pkexec", HELPER, "power", key.partition(".")[2], value]
    if key == "firewall.phones":
        return ["pkexec", HELPER, "firewall-phones", value]
    if key in ("firewall", "autologin"):
        return ["pkexec", HELPER, f"{key}-{value}"]
    if key == "firefox.memory":
        return ["pkexec", HELPER, "firefox-memory", value]
    if key.startswith("updates."):
        return ["pkexec", HELPER, "updates", key.partition(".")[2], value]
    if key in ("restore-points", "restore-points.auto"):
        verb = "enabled" if key == "restore-points" else "auto-recover"
        return ["pkexec", RECOVERY_HELPER, verb, "yes" if value == "on" else "no"]
    if key == "timezone":
        return ["timedatectl", "set-timezone", value]
    if key == "ntp":
        return ["timedatectl", "set-ntp", "true" if value == "yes" else "false"]
    layout, variant = SYSTEM_XKB.match(value).groups()
    keyboard = system_keyboard()
    return ["pkexec", HELPER, "keyboard", keyboard["model"], layout, variant or "", keyboard["options"]]


def cmd_system(opts):
    """A system setting: print it, or change it (asking for the password) and record it."""
    if opts.key not in SYSTEM_LABELS:
        warn(f"unknown system setting '{opts.key}'. Settings: {', '.join(SYSTEM_LABELS)}")
        return 2
    if opts.value is None:
        print(system_value(opts.key))
        return 0
    value = check_system(opts.key, opts.value)
    try:
        old = system_value(opts.key)
    except ControlError:
        old = None                  # not recorded: nothing to go back to
    # No timeout: pkexec waits for the password.
    result = subprocess.run(system_command(opts.key, value), capture_output=True, text=True, check=False)
    if result.stdout:
        print(result.stdout, end="")
    for line in output_messages("", result.stderr):
        warn(line)
    if result.returncode != 0:
        return 1
    if opts.key == "timezone":
        restart_night_light()
    if old is not None:
        record(opts.key, old, value)
    return 0


# Default applications: `default-app list|set CATEGORY APP`, CATEGORY one of
# DEFAULT_APPS or terminal (xdg-terminal-exec's list).
DEFAULT_APP_LABELS = {**{app_id: name for app_id, name, _ in DEFAULT_APPS}, "terminal": "Terminal"}


def app_name(app_id):
    try:
        with open(application_file(app_id), encoding="utf-8", errors="replace") as f:
            return desktop_entry(f.read()).get("Name") or app_id
    except (ControlError, OSError):
        return app_id


def default_app(category):
    """The desktop file id that opens a category now, or ""."""
    if category == "terminal":
        installed = set()
        for path in terminal_lists():
            for desktop_id in read_terminals(path):
                with contextlib.suppress(ControlError):
                    application_file(desktop_id)
                    installed.add(desktop_id)
        return default_terminal(installed) or ""
    types = next(types for app_id, _, types in DEFAULT_APPS if app_id == category)
    return run(["xdg-mime", "query", "default", types[0]]).strip()


def cmd_default_app(opts):
    if opts.action == "list":
        if opts.category or opts.app:
            warn("list takes no category")
            return 2
        for category in DEFAULT_APP_LABELS:
            current = default_app(category)
            print(f"{category}\t{current or '-'}\t{app_name(current) if current else ''}")
        return 0
    if opts.category not in DEFAULT_APP_LABELS or not opts.app:
        warn(f"set CATEGORY APP: CATEGORY is one of {', '.join(DEFAULT_APP_LABELS)}, APP a desktop file id")
        return 2
    application_file(opts.app)          # installed?
    try:
        old = default_app(opts.category)
    except ControlError:
        old = ""
    if opts.category == "terminal":
        set_terminal(opts.app)
    else:
        types = next(types for app_id, _, types in DEFAULT_APPS if app_id == opts.category)
        run(["xdg-mime", "default", opts.app, *types])
    record(f"default-app.{opts.category}", old, opts.app)
    print(f"{DEFAULT_APP_LABELS[opts.category]}: {app_name(opts.app)}.")
    return 0


# Animations (Accessibility): GSettings' enable-animations, which GTK reads for
# its own transitions and FlickOS's pop-ups for their fades
# (docs/design/flickos-fades.md). GSettings stores it, so a change made with
# another tool (nwg-look, gsettings) shows here too; `animations set` changes
# it and records it. The default is GSettings' own (on).
GSETTINGS = "gsettings"
ANIMATIONS = ("org.gnome.desktop.interface", "enable-animations")
ANIMATIONS_KEY = "animations"       # in the history


def animations():
    """on or off: enable-animations now. Raises ControlError."""
    value = run([GSETTINGS, "get", *ANIMATIONS]).strip()
    if value not in ("true", "false"):
        raise ControlError(f"{GSETTINGS} get {' '.join(ANIMATIONS)}: '{value}'")
    return "on" if value == "true" else "off"


def cmd_animations(opts):
    if opts.action == "current":
        if opts.value:
            warn("current takes no value")
            return 2
        print(animations())
        return 0
    value = (opts.value or "").strip().lower()
    value = "on" if value in TRUE else "off" if value in FALSE else value
    if value not in ("on", "off", DEFAULT_CHOICE):
        warn(f"set on, off or {DEFAULT_CHOICE}")
        return 2
    old = animations()
    if value == DEFAULT_CHOICE:
        run([GSETTINGS, "reset", *ANIMATIONS])
    else:
        run([GSETTINGS, "set", *ANIMATIONS, "true" if value == "on" else "false"])
    new = animations()
    record(ANIMATIONS_KEY, old, new)
    print(f"Animations: {new}.")
    return 0


def startup_state(entry_id):
    """on, off, or absent: not a startup application now."""
    with contextlib.suppress(ControlError):
        return "on" if find_startup(entry_id).enabled else "off"
    return "absent"


def startup_name(entry_id):
    with contextlib.suppress(ControlError):
        return find_startup(entry_id).name
    return app_name(entry_id)


# Software: apt's transactions, read by the helper (`packages-list`, which
# leaves out the ones made while installing the system). Undoing one goes
# through `pkexec control-helper packages-undo ID`, which checks it first;
# `packages-plan ID` says beforehand what it will do.
TRANSACTION_ID = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d$")
HISTORY_CLEARED = "history.cleared"      # in $XDG_STATE_HOME/flickos: apt's changes before it are left out
APPLICATIONS_DIR = "/usr/share/applications/"
APP_NAMES_SHOWN = 3


@dataclasses.dataclass
class SoftwareChange:
    """An apt transaction as History shows it (the helper's packages-list)."""
    id: str                         # its Start-Date, 2026-09-26T10:15:30
    when: datetime.datetime
    kind: str                       # install, remove, update, mixed
    packages: list                  # what the user asked for (installs) or what went (removals)
    automatic: list                 # brought in by an install
    upgraded: int
    purged: bool
    autoremove: bool
    undo_of: str                    # the change this one undid, or None
    undoable: bool
    why: str                        # why it can't be undone, or None
    undone: bool = False
    newest: bool = True             # every transaction is a change of its own


def helper_json(args):
    """The helper's JSON answer to a read-only verb (no root). Raises
    ControlError with its message."""
    try:
        result = subprocess.run([HELPER, *args], capture_output=True, text=True, timeout=300, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ControlError(f"control-helper: {error}") from None
    if result.returncode != 0:
        raise ControlError(" ".join(output_messages("", result.stderr)) or f"control-helper: exit code "
                                                                              f"{result.returncode}")
    try:
        return json.loads(result.stdout)
    except ValueError:
        raise ControlError("control-helper gave no answer") from None


def history_cleared():
    with contextlib.suppress(OSError, ValueError):
        with open(os.path.join(os.path.dirname(history_path()), HISTORY_CLEARED), encoding="utf-8") as f:
            return datetime.datetime.fromisoformat(f.read().strip())
    return None


@dataclasses.dataclass
class RestorePoint:
    """A restore point as History shows it, next to the software change it
    was taken before (flickos-recovery state)."""
    name: str
    when: datetime.datetime
    description: str
    waiting: bool = False           # another one was put back: nothing until the restart
    undoable: bool = False
    newest: bool = True


def recovery_available():
    """Restore points apply here: flickos-recovery installed, and /.snapshots
    the @snapshots subvolume of FlickOS's btrfs layout (ADR-001). Read from
    mountinfo, not a command: the sidebar asks before the window shows."""
    if not shutil.which(RECOVERY) or live_session():
        return False
    try:
        with open(RECOVERY_MOUNTINFO, encoding="utf-8", errors="replace") as f:
            for line in f:
                head, sep, tail = line.partition(" - ")
                fields, after = head.split(), tail.split()
                if sep and len(fields) >= 5 and after and fields[4] == "/.snapshots":
                    return after[0] == "btrfs" and fields[3] == "/@snapshots"
    except OSError:
        pass
    return False


def recovery_state():
    """flickos-recovery state: {"available", "enabled", "restart_needed", "points": […], …}."""
    try:
        return json.loads(run([RECOVERY, "state"]))
    except ValueError as error:
        raise ControlError(f"{RECOVERY} state: {error}") from None


def history_restore_points(state):
    """The restore points as History rows."""
    points = []
    for point in state.get("points", []) if state.get("available") else []:
        if point.get("created"):
            when = datetime.datetime.fromtimestamp(point["created"]).astimezone()
            points.append(RestorePoint(point["name"], when, point.get("description") or point["name"],
                                       bool(state.get("restart_needed"))))
    return points


def plan_lines(plan, limit=8):
    """What putting a restore point back undoes, one line per apt run."""
    verbs = (("install", "installs"), ("upgrade", "updates"), ("remove", "removes"))
    lines = []
    for entry in plan.get("changes", []):
        parts = []
        for key, verb in verbs:
            names = entry.get(key) or []
            if names:
                shown = ", ".join(names[:APP_NAMES_SHOWN])
                more = f" and {len(names) - APP_NAMES_SHOWN} more" if len(names) > APP_NAMES_SHOWN else ""
                parts.append(f"{verb} {shown}{more}")
        if parts:
            when = entry.get("date", "")[:16]
            lines.append(f"• {when}: {'; '.join(parts)}")
    if len(lines) > limit:
        lines = lines[:limit] + [f"• and {len(lines) - limit} more software changes"]
    return lines


def ask_put_back(ui, parent, name, done):
    """Show what putting restore point NAME back undoes, then put it back
    (flickos-recovery restore, which asks for the password). DONE(ok, message)."""
    Gtk = ui.Gtk

    def confirm(plan, error):
        if error:
            done(False, error)
            return
        dialog = Gtk.MessageDialog(transient_for=parent, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.NONE,
                                   text=f"Put the system back: {plan['description']}?")
        undone = plan_lines(plan)
        dialog.format_secondary_text("\n".join(
            (["These software changes are undone:", *undone, ""] if undone else
             ["No software has changed since then.", ""]) +
            ["System settings, passwords, accounts and Wi-Fi networks changed since then go back too. "
             "Your own files stay as they are.",
             "The system as it is now is kept as a restore point, so this can be undone.",
             "It takes effect when the computer restarts. Putting back needs an administrator's password."]))
        dialog.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        ok = dialog.add_button("_Put Back", Gtk.ResponseType.OK)
        ok.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            done(False, "")
            return
        done(None, "Waiting for the password…")

        def finished(ok, stdout, stderr):
            # flickos-recovery's own lines name restore points by their folder and
            # time how long it took: shown only when something went wrong.
            if ok:
                done(True, "Put back. Restart the computer to use it. The system as it was is kept as a "
                           "restore point, so this can be undone.")
            else:
                done(False, "\n".join(output_messages("", stderr)) or "Not put back.")

        ui.run_async([RECOVERY, "restore", name], finished)

    ui.background(lambda: json.loads(run([RECOVERY, "plan", name])), confirm, key=("recovery", "plan"))


def software_changes(days=HISTORY_DAYS, items=None):
    """The software changes of the last days, newest first; none while the
    history is off, and none from before it was cleared."""
    if items is None:
        if not history_enabled() or not os.access(HELPER, os.X_OK):
            return []
        items = helper_json(["packages-list", str(days)])
    cleared = history_cleared()
    changes = []
    for item in items:
        try:
            when = datetime.datetime.fromisoformat(item["time"]).astimezone()
            change = SoftwareChange(item["id"], when, item["kind"], list(item["packages"]), list(item["automatic"]),
                                    int(item["upgraded"]), bool(item["purged"]), bool(item["autoremove"]),
                                    item.get("undo_of"), bool(item["undoable"]), item.get("why"))
        except (KeyError, TypeError, ValueError):
            continue
        if cleared is None or when > cleared:
            changes.append(change)
    undone = {change.undo_of for change in changes if change.undo_of}
    for change in changes:
        if change.id in undone:
            change.undone, change.undoable = True, False
    return sorted(changes, key=lambda change: change.when, reverse=True)


APP_NAME_CACHE = {}


def dpkg_query(args):
    """dpkg-query's output; it answers for the packages it knows even when it
    fails for others."""
    try:
        return subprocess.run(["dpkg-query", *args], capture_output=True, text=True, timeout=COMMAND_SECONDS,
                              check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def learn_app_names(packages):
    """Look up the app names of packages (APP_NAME_CACHE) with two dpkg-query
    runs: which are installed, then their files, one block each, in order."""
    wanted = [package for package in dict.fromkeys(packages) if package not in APP_NAME_CACHE]
    if not wanted:
        return
    status = dict(line.split("\t", 1) for line in dpkg_query(
        ["-W", "-f", "${binary:Package}\t${db:Status-Status}\n", *wanted]).splitlines() if "\t" in line)
    present = [package for package in wanted if status.get(package) == "installed"]
    blocks = dpkg_query(["-L", *present]).rstrip("\n").split("\n\n") if present else []
    for package in wanted:
        APP_NAME_CACHE[package] = package
    if len(blocks) != len(present):
        return                      # not one block each: keep the package names
    for package, block in zip(present, blocks):
        for path in block.splitlines():
            if not (path.startswith(APPLICATIONS_DIR) and path.endswith(".desktop")):
                continue
            with contextlib.suppress(OSError):
                with open(path, encoding="utf-8", errors="replace") as f:
                    entry = desktop_entry(f.read())
                if entry.get("Name") and entry.get("NoDisplay", "").lower() != "true":
                    APP_NAME_CACHE[package] = entry["Name"]
                    break


def package_app_name(package):
    """The name of the app a package brings (its desktop file's Name=), else
    the package name."""
    if package not in APP_NAME_CACHE:
        learn_app_names([package])
    return APP_NAME_CACHE[package]


def package_names(packages):
    names = [package_app_name(package) for package in packages[:APP_NAMES_SHOWN]]
    if len(packages) > APP_NAMES_SHOWN:
        return f"{', '.join(names)} and {len(packages) - APP_NAMES_SHOWN} more"
    return ", ".join(names)


def describe_software(change):
    """(title, detail) of a software change: "Installed: VLC media player"."""
    details = []
    if change.kind == "install":
        title = f"Installed: {package_names(change.packages)}"
        if change.automatic:
            details.append(f"And {len(change.automatic)} package{'s' if len(change.automatic) != 1 else ''} "
                           "it needed")
    elif change.kind == "remove" and change.autoremove:
        title = f"Removed {len(change.packages)} package{'s' if len(change.packages) != 1 else ''} " \
                "that were no longer needed"
    elif change.kind == "remove":
        title = f"Removed: {package_names(change.packages)}"
        if change.purged:
            details.append("Its settings were deleted too")
    elif change.kind == "update":
        title = f"Updates installed: {change.upgraded} package{'s' if change.upgraded != 1 else ''}"
    else:
        title = f"Software installed and removed: {package_names(change.packages)}"
    if change.undo_of:
        details.insert(0, "Undone from History")
    if change.undone:
        details.append("Undone")
    return title, " · ".join(details)


def plan_text(plan):
    """What an undo will do, in words (packages-plan's answer)."""
    lines = [f"Removes: {', '.join(plan['remove'])}." if plan["action"] == "remove"
             else f"Installs: {', '.join(plan['install'])}."]
    if plan.get("upgraded"):
        lines.append("Packages it updated stay updated.")
    if plan["action"] == "install":
        lines.append("They are downloaded, so the computer needs to be online.")
        if plan.get("purged"):
            lines.append("Their settings were deleted when they were removed, so they start fresh.")
    return lines


def xkb_rules(path=None):
    """{"model": {id: name}, "layout": {...}, "option": {...}, "variant": {layout: {id: name}}}
    from the XKB rules list. Empty without xkb-data."""
    rules = {"model": {}, "layout": {}, "variant": {}, "option": {}}
    section = None
    try:
        with open(path or XKB_RULES, encoding="utf-8") as f:
            for line in f:
                if line.startswith("! "):
                    section = line[2:].strip()
                    continue
                parts = line.split(None, 1)
                if section not in rules or len(parts) != 2:
                    continue
                name, description = parts[0], parts[1].strip()
                if section == "variant":
                    layout, _, description = description.partition(": ")
                    rules["variant"].setdefault(layout, {})[name] = description
                else:
                    rules[section][name] = description
    except OSError as error:
        warn(f"cannot read the keyboard layouts ({error})")
    return rules


def system_keyboard(path=None):
    """The system keyboard (/etc/default/keyboard): {"model", "layout", "variant", "options"}."""
    names = {"XKBMODEL": "model", "XKBLAYOUT": "layout", "XKBVARIANT": "variant", "XKBOPTIONS": "options"}
    found = dict.fromkeys(names.values(), "")
    with contextlib.suppress(OSError, UnicodeDecodeError), open(path or KEYBOARD_DEFAULTS, encoding="utf-8") as f:
        for line in f:
            match = re.match(r'^\s*(XKB[A-Z]+)=(.*)$', line.strip())
            if match and match.group(1) in names:
                found[names[match.group(1)]] = match.group(2).strip().strip('"\'')
    return found


def check_xkb(key, value, values, rules):
    """Raise ControlError if a layout or variant isn't one of the rules'.
    Returns the changes to save (a new layout drops a variant it hasn't)."""
    changes = {key: value}
    if not rules["layout"]:
        raise ControlError("the keyboard layouts are not installed (xkb-data)")
    if key == "keyboard.layout":
        if value not in rules["layout"]:
            raise ControlError(f"unknown keyboard layout '{value}'")
        variant = values.get("keyboard.variant")
        if variant and variant not in rules["variant"].get(value, {}):
            changes["keyboard.variant"] = None
    else:
        layout = values.get("keyboard.layout") or system_keyboard()["layout"]
        if value and value not in rules["variant"].get(layout, {}):
            raise ControlError(f"layout '{layout}' has no variant '{value}'")
    return changes


def magnifier_options(values):
    """The <magnifier> options of the zoom settings that are set, as
    [(element, value)]: the area is width and height, -1 for the whole screen."""
    options = []
    if "zoom.area" in values or "zoom.lens-size" in values:
        size = "-1" if effective("zoom.area", values) == "screen" else effective("zoom.lens-size", values)
        options += [("width", size), ("height", size)]
    for key in ("zoom.step", "zoom.smooth"):
        if key in values:
            options.append((SETTINGS[key].labwc[1], values[key]))
    return options


def labwc_fragment(values):
    """flickos-control's labwc config fragment (control/labwc.xml), or None."""
    devices, keyboard = {}, []
    for setting in SETTINGS.values():
        if setting.key not in values or setting.labwc[0] not in ("libinput", "keyboard"):
            continue
        if setting.labwc[0] == "libinput":
            devices.setdefault(setting.labwc[1], []).append((setting.labwc[2], values[setting.key]))
        else:
            keyboard.append((setting.labwc[1], values[setting.key]))
    magnifier = magnifier_options(values)
    if not devices and not keyboard and not magnifier:
        return None
    top = ET.Element("labwc_config")
    top.append(ET.Comment(" Generated by flickos-control from ~/.config/flickos. Do not edit. "))
    if devices:
        libinput = ET.SubElement(top, "libinput")
        for category, options in devices.items():
            device = ET.SubElement(libinput, "device", category=category)
            for name, value in options:
                ET.SubElement(device, name).text = value
    if keyboard:
        element = ET.SubElement(top, "keyboard")
        for name, value in keyboard:
            ET.SubElement(element, name).text = value
    if magnifier:
        element = ET.SubElement(top, "magnifier")
        for name, value in magnifier:
            ET.SubElement(element, name).text = value
    ET.indent(top)
    return ET.tostring(top, encoding="unicode") + "\n"


def keyboard_environment(values, live):
    """The keyboard layout as [(variable, value)]. All four XKB variables are
    written, since labwc keeps one that is left out. live: back to the system
    layout without logging out, so the system's values are written instead
    of nothing."""
    system = system_keyboard()
    layout, variant = values.get("keyboard.layout"), values.get("keyboard.variant")
    if layout is None and variant is None:
        if not live:
            return []
        layout, variant = system["layout"], system["variant"]
    elif variant is None:
        variant = "" if layout else system["variant"]
    layout = layout or system["layout"]
    if not layout:
        return []                   # an empty layout breaks labwc's keymap
    return [("XKB_DEFAULT_MODEL", system["model"]), ("XKB_DEFAULT_LAYOUT", layout),
            ("XKB_DEFAULT_VARIANT", variant), ("XKB_DEFAULT_OPTIONS", system["options"])]


def locale_environment(values, live, system=None):
    """The language and formats as [(variable, value)], over the system's
    (the session got those from PAM). Every variable that could hide the
    choice is written: LANGUAGE (empty: gettext then follows LC_MESSAGES) and
    LC_MESSAGES for the language, all FORMAT_VARS for the formats. A format
    the system doesn't set follows the language. live: as for the keyboard."""
    system = system_locale() if system is None else system
    language, formats = values.get("locale.language"), values.get("locale.formats")
    if language is None and formats is None and not live:
        return []
    lang = language or system.get("LANG")
    if not lang:
        return []
    lines = [("LANG", lang), ("LANGUAGE", "" if language else system.get("LANGUAGE", "")),
             ("LC_MESSAGES", lang if language else system.get("LC_MESSAGES", lang))]
    return lines + [(name, formats or system.get(name) or lang) for name in FORMAT_VARS]


def environment_fragment(values, live):
    """The keyboard layout, language and formats as labwc environment lines
    (control/environment), or None."""
    lines = keyboard_environment(values, live) + locale_environment(values, live)
    return "".join(f"{name}={value}\n" for name, value in lines) or None


# --- Language and formats: locales ----------------------------------------------------

def system_locale(path=None):
    """{variable: value} of the system locale (/etc/default/locale)."""
    return {name: value for name, value in read_shell_values(path or LOCALE_DEFAULTS).items()
            if name in LOCALE_VARS and value}


def locale_key(name):
    """A locale name as `locale -a` lists it: the codeset in lowercase without
    dashes (en_US.UTF-8 -> en_US.utf8)."""
    base, at, modifier = name.partition("@")
    base, dot, codeset = base.partition(".")
    return base + (dot + codeset.lower().replace("-", "") if dot else "") + at + modifier


def installed_locales():
    """locale_key()s of the generated locales."""
    return {locale_key(name) for name in command_output(["locale", "-a"]).split()}


def supported_locales(path=None):
    """The UTF-8 locales glibc can generate (/usr/share/i18n/SUPPORTED), as
    locale-gen names them; empty without the locales package."""
    found = []
    with contextlib.suppress(OSError, UnicodeDecodeError), open(path or I18N_SUPPORTED, encoding="utf-8") as f:
        for line in f:
            parts = line.split()
            if len(parts) == 2 and parts[1] == "UTF-8" and not parts[0].startswith("C."):
                found.append(parts[0])
    return found


def locale_name(name, folder=None):
    """"German (Germany)" from the locale's definition (its language and
    territory); the modifier after a comma ("Serbian (Serbia, latin)")."""
    base, _, modifier = name.partition("@")
    source = base.partition(".")[0] + (f"@{modifier}" if modifier else "")
    fields = {}
    with contextlib.suppress(OSError, UnicodeDecodeError), \
            open(os.path.join(folder or I18N_LOCALES, source), encoding="utf-8") as f:
        text = f.read(16384)
        for field in ("language", "territory"):
            match = re.search(rf'^{field}\s+"([^"]+)"', text, re.M)
            if match:
                fields[field] = match.group(1)
    if "language" not in fields:
        return name
    details = [part for part in (fields.get("territory"), modifier) if part]
    return f"{fields['language']} ({', '.join(details)})" if details else fields["language"]


def check_locale(key, value, installed=None):
    installed = installed_locales() if installed is None else installed
    if locale_key(value) not in installed:
        raise ControlError(f"{key}: {value} is not installed; add it on the Language & Region page "
                           f"or with: pkexec {HELPER} locale-add {value}")


def system_locale_args(system, language, formats):
    """localectl set-locale's arguments that make language and formats the
    system's (None: keep the system's). Variables that would hide the new
    language (LANGUAGE, LC_MESSAGES) are left out."""
    new = dict(system)
    if language:
        new["LANG"] = language
        new.pop("LANGUAGE", None)
        new.pop("LC_MESSAGES", None)
    if formats:
        new.update(dict.fromkeys(FORMAT_VARS, formats))
    return [f"{name}={new[name]}" for name in LOCALE_VARS if new.get(name)]


def write_fragments(live):
    """Write or delete control/labwc.xml and control/environment."""
    values, _ = load_values()
    folder = os.path.join(runtime_dir(), CONTROL_DIR)
    for name, text in (("labwc.xml", labwc_fragment(values)), ("environment", environment_fragment(values, live))):
        path = os.path.join(folder, name)
        if text is None:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(path)
        else:
            write_atomic(path, text)


def in_session():
    return bool(os.environ.get("WAYLAND_DISPLAY") and os.environ.get("LABWC_PID"))


def live_session():
    """The live image (boot=live): no idle lock, no login settings."""
    with contextlib.suppress(OSError):
        with open(os.path.join(PROC, "cmdline"), encoding="utf-8") as f:
            return "boot=live" in f.read().split()
    return False


# --- Idle: swayidle ------------------------------------------------------------------

def idle_command(values):
    """swayidle with the chosen times; the screen is locked before sleep
    (unless turned off) and when logind asks (loginctl lock-session, the lid
    set to lock)."""
    lock = value_of(SETTINGS["idle.lock-after"], values.get("idle.lock-after"))
    suspend = value_of(SETTINGS["idle.suspend-after"], values.get("idle.suspend-after"))
    before_sleep = value_of(SETTINGS["idle.lock-before-sleep"], values.get("idle.lock-before-sleep"))
    command = ["swayidle", "-w"]
    if lock:
        command += ["timeout", str(lock), LOCK_SCREEN]
    if suspend:
        command += ["timeout", str(suspend), SUSPEND]
    if before_sleep:
        command += ["before-sleep", LOCK_SCREEN]
    return command + ["lock", LOCK_SCREEN]


def wallpaper_images():
    """[(output or None, image, mode)] the user's swaybg shows: its -o groups,
    each with -i and -m (the wallpaper on screen, whoever chose it)."""
    found = []
    for pid in own_processes("swaybg"):
        try:
            with open(os.path.join(PROC, str(pid), "cmdline"), "rb") as f:
                args = [arg.decode(errors="replace") for arg in f.read().split(b"\0") if arg]
        except OSError:
            continue
        groups, group = [], {"output": None}
        pairs = iter(args[1:])
        for arg in pairs:
            value = next(pairs, None)
            if arg in ("-o", "--output"):
                group = {"output": value}
                groups.append(group)
            elif arg in ("-i", "--image"):
                group["image"] = value
            elif arg in ("-m", "--mode"):
                group["mode"] = value
            elif arg in ("-c", "--color"):
                pass
            else:
                break                   # something else: stop, don't misread
        if "image" in group and group not in groups:
            groups.append(group)
        found += [(g["output"] if g["output"] not in (None, "*") else None, g["image"], g.get("mode"))
                  for g in groups if g.get("image")]
    return found


def lock_command(values, images=None):
    """swaylock with the chosen background: the Arc-Dark color, or the
    wallpaper on screen (on the color, where there is none)."""
    command = shlex.split(SWAYLOCK)
    if value_of(SETTINGS["lock.background"], values.get("lock.background")) != "wallpaper":
        return command
    images = wallpaper_images() if images is None else images
    for output, image, _ in images:
        # swaylock reads OUTPUT:PATH; a path with a colon needs its output.
        if output:
            command += ["-i", f"{output}:{image}"]
        elif ":" not in image:
            command += ["-i", image]
    mode = next((mode for _, _, mode in images if mode in SCALING), None)
    if mode and "-i" in command:
        command += ["-s", mode]
    return command


def own_processes(name):
    """PIDs of this user's processes called name."""
    found = []
    for entry in os.listdir(PROC):
        if not entry.isdigit():
            continue
        folder = os.path.join(PROC, entry)
        try:
            if os.stat(folder).st_uid != os.getuid():
                continue
            with open(os.path.join(folder, "comm"), encoding="utf-8") as f:
                if f.read().strip() == name:
                    found.append(int(entry))
        except OSError:
            continue
    return found


def idle_daemons():
    """FlickOS's swayidle: started by `idle` (IDLE_MARK in its environment),
    or autostart's before flickos-control existed (its lock command)."""
    found = []
    for pid in own_processes("swayidle"):
        try:
            with open(os.path.join(PROC, str(pid), "environ"), "rb") as f:
                environ = f.read().split(b"\0")
            with open(os.path.join(PROC, str(pid), "cmdline"), "rb") as f:
                cmdline = f.read().split(b"\0")
        except OSError:
            continue
        if f"{IDLE_MARK}=1".encode() in environ or SWAYLOCK.encode() in cmdline:
            found.append(pid)
    return found


def restart_idle():
    """Stop FlickOS's swayidle and start it again with the saved times."""
    for pid in idle_daemons():
        with contextlib.suppress(OSError):
            os.kill(pid, signal.SIGTERM)
    if not live_session():
        subprocess.Popen([*SELF, "idle"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


# --- Power button and lid: logind -------------------------------------------------------

def parse_busctl_strings(text):
    """The values of `busctl get-property` string lines (s "suspend")."""
    values = []
    for line in text.splitlines():
        match = re.match(r'^s "(.*)"$', line.strip())
        if match:
            values.append(match.group(1))
    return values


def power_state():
    """{setting id: logind's action}; "default" for the lid while plugged in
    when logind uses the one on battery."""
    names = [logind for _, logind, _, _ in POWER_SETTINGS]
    values = parse_busctl_strings(run(["busctl", "get-property", *LOGIND, *names]))
    if len(values) != len(names):
        raise ControlError("logind gave no power button and lid settings")
    return {setting: value or "default" for (setting, _, _, _), value in zip(POWER_SETTINGS, values)}


def has_lid(folder=None):
    """Whether an input device has a lid switch (SW_LID, bit 0 of its switch
    capabilities), as logind looks for one."""
    folder = folder or SYS_INPUT
    with contextlib.suppress(OSError):
        for device in os.listdir(folder):
            words = read_text(os.path.join(folder, device, "capabilities", "sw")).split()
            with contextlib.suppress(ValueError, IndexError):
                if int(words[-1], 16) & 1:
                    return True
    return False


# --- Startup applications: XDG autostart --------------------------------------------------

DESKTOP_ESCAPES = {"s": " ", "n": "\n", "t": "\t", "r": "\r", "\\": "\\"}


def desktop_entry(text):
    """{key: value} of a desktop file's [Desktop Entry] group, unescaped;
    localized keys (Name[de]) are left out."""
    entry, group = {}, None
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("["):
            group = line
            continue
        key, sep, value = line.partition("=")
        key = key.strip()
        if group == "[Desktop Entry]" and sep and "[" not in key and key not in entry:
            entry[key] = re.sub(r"\\(.)", lambda m: DESKTOP_ESCAPES.get(m.group(1), m.group(0)), value.strip())
    return entry


def set_desktop_key(text, key, value):
    """The desktop file with key=value in its [Desktop Entry] group: the key's
    first line replaced (others dropped), or a line added at the group's end."""
    out, group, placed, entry_end = [], None, False, None
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            if group == "[Desktop Entry]" and entry_end is None:
                entry_end = len(out)
            group = stripped
        elif group == "[Desktop Entry]" and stripped.partition("=")[0].strip() == key and "=" in stripped:
            if placed:
                continue
            line, placed = f"{key}={value}", True
        out.append(line)
    if group == "[Desktop Entry]" and entry_end is None:
        entry_end = len(out)
    if not placed:
        if entry_end is None:
            out = ["[Desktop Entry]", f"{key}={value}", *out]
        else:
            while not out[entry_end - 1].strip():
                entry_end -= 1
            out.insert(entry_end, f"{key}={value}")
    return "\n".join(out) + "\n"


def autostart_folders():
    """The user's autostart folder, then the system's (XDG_CONFIG_DIRS order)."""
    dirs = (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":")
    return [os.path.join(config_home(), AUTOSTART_DIR)] + [os.path.join(d, AUTOSTART_DIR) for d in dirs if d]


def current_desktops():
    return [d for d in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":") if d]


def listed(value):
    return [item for item in value.split(";") if item]


def entry_applies(entry, desktops):
    """An application entry meant for this desktop whose program is installed."""
    if entry.get("Type", "Application") != "Application" or not entry.get("Exec"):
        return False
    only, never = listed(entry.get("OnlyShowIn", "")), listed(entry.get("NotShowIn", ""))
    if only and not set(only) & set(desktops):
        return False
    if set(never) & set(desktops):
        return False
    try_exec = entry.get("TryExec")
    return not try_exec or bool(shutil.which(try_exec))


@dataclasses.dataclass(frozen=True)
class StartupEntry:
    id: str
    path: str
    user: bool                      # the entry in use is the user's
    system: bool                    # the system has an entry with this id
    name: str
    comment: str
    enabled: bool
    entry: dict = dataclasses.field(repr=False, compare=False, default=None)


def startup_entries(folders=None, desktops=None):
    """The startup applications, by name: of each id the first file in the
    folders, without deleted (Hidden) ones and ones for other desktops."""
    folders = autostart_folders() if folders is None else folders
    desktops = current_desktops() if desktops is None else desktops
    found, system_ids = {}, set()
    for index, folder in enumerate(folders):
        try:
            names = sorted(os.listdir(folder))
        except OSError:
            continue
        for name in names:
            if not name.endswith(".desktop"):
                continue
            if index:
                system_ids.add(name)
            if name not in found:
                found[name] = (os.path.join(folder, name), index == 0)
    entries = []
    for name, (path, user) in found.items():
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                entry = desktop_entry(f.read())
        except OSError:
            continue
        if entry.get("Hidden", "").lower() == "true" or not entry_applies(entry, desktops):
            continue
        entries.append(StartupEntry(name, path, user, name in system_ids, entry.get("Name") or name[:-8],
                                    entry.get("Comment", ""), entry.get(AUTOSTART_ENABLED, "").lower() != "false",
                                    entry))
    return sorted(entries, key=lambda e: e.name.casefold())


def exec_argv(entry, path=""):
    """The command line of an entry's Exec (Desktop Entry spec: quoting, field
    codes left out or filled in). ControlError if it can't be read."""
    try:
        words = shlex.split(entry.get("Exec", ""))
    except ValueError:
        raise ControlError(f"{path or 'an entry'}: its Exec can't be read") from None
    argv = []
    for word in words:
        if word == "%i":
            argv += ["--icon", entry["Icon"]] if entry.get("Icon") else []
        elif word == "%c":
            argv.append(entry.get("Name", ""))
        elif word == "%k":
            argv.append(path)
        elif not re.fullmatch(r"%[fFuUdDnNvm]", word):
            argv.append(re.sub(r"%(.)", lambda m: "%" if m.group(1) == "%" else
                               "" if m.group(1) in "fFuUdDnNvm" else m.group(0), word))
    if not argv:
        raise ControlError(f"{path or 'an entry'}: no command in its Exec")
    if entry.get("Terminal", "").lower() == "true":
        argv = ["xdg-terminal-exec", *argv]
    return argv


def find_startup(entry_id):
    for entry in startup_entries():
        if entry.id == entry_id:
            return entry
    raise ControlError(f"no startup application '{entry_id}' (flickos-control startup list)")


def user_autostart_file(entry_id):
    if not DESKTOP_ID.match(entry_id):
        raise ControlError(f"not a desktop file id: '{entry_id}'")
    return os.path.join(config_home(), AUTOSTART_DIR, entry_id)


def set_startup_enabled(entry_id, on):
    """On or off from the next login: the user's entry gets the key; a system
    entry is copied to the user's folder first (the spec's way to change it)."""
    entry = find_startup(entry_id)
    with open(entry.path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    write_atomic(user_autostart_file(entry_id), set_desktop_key(text, AUTOSTART_ENABLED, "true" if on else "false"))


def user_styles_folder():
    """flickos-layout's folder for the user's own styles (its user_styles_dir)."""
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    return os.path.join(data_home, "flickos", "styles")


def user_layouts_folder():
    """flickos-layout's folder for the user's own layouts (its user_layouts_dir)."""
    return os.path.join(os.path.dirname(user_styles_folder()), "layouts")


def user_tweaks_folder():
    """flickos-layout's folder for the user's panel tweaks (its tweaks_folder)."""
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(config_home, "flickos", "tweaks")


def application_file(app_id):
    """An installed app's desktop file (XDG_DATA_HOME, then XDG_DATA_DIRS)."""
    if not DESKTOP_ID.match(app_id):
        raise ControlError(f"not a desktop file id: '{app_id}'")
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
    dirs = [data_home] + (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    for folder in dirs:
        # Desktop file ids of files in subfolders use "-" for "/".
        for candidate in (app_id, app_id.replace("-", "/", 1)):
            path = os.path.join(folder, "applications", candidate)
            if folder and os.path.isfile(path):
                return path
    raise ControlError(f"no installed app '{app_id}'")


def add_startup(app_id):
    with open(application_file(app_id), encoding="utf-8", errors="replace") as f:
        text = f.read()
    write_atomic(user_autostart_file(app_id), set_desktop_key(text, AUTOSTART_ENABLED, "true"))
    return desktop_entry(text).get("Name") or app_id


def remove_startup(entry_id):
    entry = find_startup(entry_id)
    if entry.system:
        raise ControlError(f"{entry.name} comes with the system: turn it off instead")
    os.unlink(user_autostart_file(entry_id))
    return entry.name


def tray_running():
    return "true" in command_output(["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                                     "org.freedesktop.DBus", "NameHasOwner", "s", TRAY_BUS_NAME])


def run_startup():
    """Start the entries that are on; each in its own session, with
    X-GNOME-Autostart-Delay honored. Returns the ids started."""
    todo = []
    for entry in startup_entries():
        if not entry.enabled:
            continue
        try:
            todo.append((entry, exec_argv(entry.entry, entry.path)))
        except ControlError as error:
            warn(str(error))
    if not todo:
        return []
    # Tray apps need the panel's tray, which starts at the same time.
    deadline = time.monotonic() + TRAY_WAIT_SECONDS
    while not tray_running() and time.monotonic() < deadline:
        time.sleep(0.5)
    started = []
    for entry, argv in todo:
        delay = entry.entry.get("X-GNOME-Autostart-Delay", "")
        if delay.isdigit() and int(delay):
            argv = ["sh", "-c", 'sleep "$0"; exec "$@"', delay, *argv]
        cwd = entry.entry.get("Path") or None
        try:
            subprocess.Popen(argv, cwd=cwd if cwd and os.path.isdir(cwd) else None, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError as error:
            warn(f"{entry.id}: {error}")
            continue
        started.append(entry.id)
    return started


# --- Automatic updates: unattended-upgrades ------------------------------------------------

def apt_config(text):
    """{key: value, or [values] for a list} from `apt-config dump`."""
    found = {}
    for line in text.splitlines():
        match = re.match(r'^(\S+?)(::)? "(.*)";$', line.strip())
        if not match:
            continue
        key, is_item, value = match.groups()
        if is_item:
            # The list's own line ("") comes first.
            if not isinstance(found.get(key), list):
                found[key] = []
            found[key].append(value)
        elif not isinstance(found.get(key), list) and (value or key not in found):
            found[key] = value
    return found


def updates_state(dump=None, stamp=None):
    """{"auto": bool, "scope": UPDATE_SCOPES or OLD_UPDATE_SCOPES id or "custom", "reboot": "no",
    "idle" or "always", "last": seconds since the epoch or None}."""
    config = apt_config(run(["apt-config", "dump"]) if dump is None else dump)
    periodic = config.get("APT::Periodic::Enable", "1") != "0"
    auto = periodic and config.get("APT::Periodic::Unattended-Upgrade", "0") not in ("0", "", "false")
    origins = config.get("Unattended-Upgrade::Origins-Pattern")
    origins = set(origins) if isinstance(origins, list) else set()
    scope = next((name for name, patterns in (*UPDATE_SCOPES.items(), *OLD_UPDATE_SCOPES.items(),
                                              *PREVIOUS_UPDATE_SCOPES.items())
                  if set(patterns) == origins), "custom")
    reboot = "no"
    if config.get("Unattended-Upgrade::Automatic-Reboot", "false").lower() in ("true", "1", "yes"):
        with_users = config.get("Unattended-Upgrade::Automatic-Reboot-WithUsers", "true").lower()
        reboot = "always" if with_users in ("true", "1", "yes") else "idle"
    try:
        last = os.stat(stamp or UPDATES_STAMP).st_mtime
    except OSError:
        last = None
    return {"auto": auto, "scope": scope, "reboot": reboot, "last": last}


# --- Displays: kanshi profiles -----------------------------------------------------------

# Screens that exist only for a program, never plugged in: labwc's
# VirtualOutputAdd ones (HEADLESS-1, or HEADLESS-PHONE for a phone or tablet
# as a second screen; docs/design/flickos-second-screen.md, ADR-007). A kept
# arrangement with one would never match without that program, and kanshi
# would fight its program over its size.
VIRTUAL_SCREEN_PREFIX = "HEADLESS-"


def read_screens():
    """The connected screens, as `wlr-randr --json` describes them, without
    virtual ones (VIRTUAL_SCREEN_PREFIX)."""
    try:
        screens = json.loads(run(["wlr-randr", "--json"]))
    except ValueError:
        raise ControlError("wlr-randr gave no list of screens") from None
    if not isinstance(screens, list):
        raise ControlError("wlr-randr gave no list of screens")
    return [screen for screen in screens
            if not (isinstance(screen, dict) and str(screen.get("name", "")).startswith(VIRTUAL_SCREEN_PREFIX))]


def screen_identity(screen):
    """kanshi's name for a screen wherever it is plugged in: "Make Model
    Serial", "Unknown" for a missing one."""
    return " ".join(screen.get(field) or "Unknown" for field in ("make", "model", "serial"))


def screen_criteria(screen, screens):
    """What a profile calls the screen: its identity, or the connector (DP-1)
    when the identity is unknown, shared with another screen or unquotable."""
    identity = screen_identity(screen)
    same = [other for other in screens if screen_identity(other) == identity]
    if identity == "Unknown Unknown Unknown" or len(same) > 1 or ('"' in identity and "'" in identity) \
            or not identity.isprintable():
        return screen.get("name") or "*"
    return identity


def kanshi_quote(text):
    if re.match(r"^[A-Za-z0-9_.:+-]+$", text):
        return text
    return f"'{text}'" if '"' in text else f'"{text}"'


def screen_mode(screen):
    return next((mode for mode in screen.get("modes") or [] if mode.get("current")), None)


def output_line(screen, screens):
    """kanshi's output directive for a screen as it is now."""
    words = ["output", kanshi_quote(screen_criteria(screen, screens))]
    if not screen.get("enabled"):
        return " ".join(words + ["disable"])
    words.append("enable")
    mode = screen_mode(screen)
    if mode:
        refresh = float(mode.get("refresh") or 0)     # 0: unknown (kanshi then takes the highest)
        words += ["mode", f"{int(mode['width'])}x{int(mode['height'])}" + (f"@{refresh:.3f}Hz" if refresh else "")]
    position = screen.get("position") or {}
    words += ["position", f"{int(position.get('x', 0))},{int(position.get('y', 0))}",
              "scale", f"{float(screen.get('scale') or 1):.6g}", "transform", screen.get("transform") or "normal"]
    if screen.get("adaptive_sync") is not None:
        words += ["adaptive_sync", "on" if screen["adaptive_sync"] else "off"]
    return " ".join(words)


def screen_box(screen):
    """(x, y, width, height) an enabled screen covers in the layout, as
    wlroots counts it: the mode turned by the transform, divided by the scale
    (truncated); None while it is off or has no mode."""
    mode = screen_mode(screen)
    if not screen.get("enabled") or not mode:
        return None
    width, height = int(mode["width"]), int(mode["height"])
    if (screen.get("transform") or "normal").endswith(("90", "270")):
        width, height = height, width
    scale = float(screen.get("scale") or 1)
    position = screen.get("position") or {}
    return int(position.get("x", 0)), int(position.get("y", 0)), int(width / scale), int(height / scale)


def overlapping_screens(screens):
    """[(screen, screen)] that partly cover each other, so one shows the
    other's panel and windows (wdisplays turns a screen back on at 0,0).
    Exactly the same area is left out: that mirrors them on purpose."""
    boxes = [(screen, screen_box(screen)) for screen in screens]
    boxes = [(screen, box) for screen, box in boxes if box]
    return [(a, b) for i, (a, (ax, ay, aw, ah)) in enumerate(boxes) for b, (bx, by, bw, bh) in boxes[i + 1:]
            if (ax, ay, aw, ah) != (bx, by, bw, bh) and ax < bx + bw and bx < ax + aw and ay < by + bh and by < ay + ah]


def screens_on(screens):
    return {screen.get("name") for screen in screens if screen_box(screen)}


def place_turned_on(before):
    """Screens turned on since `before` (the names of the screens that were
    on) that partly cover another move to the right of the others, top edges
    lined up, as labwc places a screen plugged in: a screen that is off has
    no position, so wdisplays and wlr-randr turn it on at 0,0. The names of
    the screens on now; `before` while the screens can't be read."""
    try:
        screens = read_screens()
    except ControlError:
        return before
    for screen in [screen for screen in screens if screen_box(screen) and screen.get("name") not in before]:
        if not any(screen is other for pair in overlapping_screens(screens) for other in pair):
            continue
        others = [screen_box(other) for other in screens if other is not screen and screen_box(other)]
        x, y = max(ox + ow for ox, _, ow, _ in others), min(oy for _, oy, _, _ in others)
        try:
            run(["wlr-randr", "--output", screen["name"], "--pos", f"{x},{y}"])
        except ControlError as error:
            warn(str(error))
            continue
        screen["position"] = {"x": x, "y": y}
    return screens_on(screens)


def overlap_message(pairs):
    first, second = (describe_screen(screen)[0] for screen in pairs[0])
    return (f"{first} and {second} overlap, so one shows part of the other. Move them apart with "
            "Arrange Screens, then keep the arrangement.")


def screens_title(screens):
    return ", ".join(sorted(screen_criteria(screen, screens) for screen in screens))


def screens_profile(screens):
    """(name, profile text) for the screens as they are now. The name comes
    from the set of screens, so keeping them again replaces the profile."""
    criteria = sorted(screen_criteria(screen, screens) for screen in screens)
    name = "screens-" + hashlib.sha1("\n".join(criteria).encode()).hexdigest()[:10]
    lines = [f"# {screens_title(screens)}", f"profile {name} {{"]
    lines += [f"\t{output_line(screen, screens)}" for screen in sorted(screens, key=lambda s: s.get("name") or "")]
    return name, "\n".join(lines + ["}"]) + "\n"


DISPLAYS_HEADER = ("# Screen arrangements kept in Settings > Displays (flickos-control), one\n"
                   "# kanshi profile each: kanshi applies the one whose screens are all\n"
                   "# connected. Keeping an arrangement again replaces the profile of the same\n"
                   "# screens. See kanshi(5).\n")
PROFILE_BLOCK = re.compile(r"^(?:# ([^\n]*)\n)?profile (\S+) \{\n.*?^\}\n?", re.M | re.S)


def displays_file():
    return user_file(DISPLAYS)


def read_profiles(path=None):
    """[(name, title, text)] of the kept arrangements."""
    try:
        with open(path or displays_file(), encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError):
        return []
    return [(match.group(2), match.group(1) or match.group(2), match.group(0).rstrip("\n") + "\n")
            for match in PROFILE_BLOCK.finditer(text)]


def write_profiles(profiles, path=None):
    path = path or displays_file()
    if not profiles:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(path)
        return
    write_atomic(path, DISPLAYS_HEADER + "".join(f"\n{text}" for _, _, text in profiles))


def display_daemons():
    """(FlickOS's kanshi, other kanshi) PIDs of this user: `displays start`
    puts DISPLAYS_MARK in its environment."""
    ours, others = [], []
    for pid in own_processes("kanshi"):
        try:
            with open(os.path.join(PROC, str(pid), "environ"), "rb") as f:
                environ = f.read().split(b"\0")
        except OSError:
            continue
        (ours if f"{DISPLAYS_MARK}=1".encode() in environ else others).append(pid)
    return ours, others


def restart_displays():
    """kanshi rereads the kept arrangements (SIGHUP), is started for the first
    one, and stops when none is left."""
    ours, _ = display_daemons()
    keep = bool(read_profiles())
    for pid in ours:
        with contextlib.suppress(OSError):
            os.kill(pid, signal.SIGHUP if keep else signal.SIGTERM)
    if keep and not ours:
        subprocess.Popen([*SELF, DISPLAYS, "start"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def describe_screen(screen):
    """(title, details) for the Displays page."""
    title = " ".join(part for part in (screen.get("make"), screen.get("model")) if part) or screen.get("name", "")
    name = screen.get("name", "")
    if not screen.get("enabled"):
        return title, f"{name}: off"
    parts = []
    mode = screen_mode(screen)
    if mode:
        refresh = float(mode.get("refresh") or 0)
        parts.append(f"{mode['width']}×{mode['height']}" + (f", {refresh:.0f} Hz" if refresh else ""))
    scale = float(screen.get("scale") or 1)
    if scale != 1:
        parts.append(f"scale {scale:g}")
    if (screen.get("transform") or "normal") != "normal":
        parts.append(f"turned {screen['transform']}")
    position = screen.get("position") or {}
    parts.append(f"at {position.get('x', 0)},{position.get('y', 0)}")
    return title, f"{name}: {', '.join(parts)}"


# --- Default terminal: xdg-terminal-exec ------------------------------------------------

def terminal_lists():
    """xdg-terminal-exec's lists, most important first (its own order, without
    the data dirs): per folder desktop-specific names first."""
    desktops = [d.lower() for d in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":") if d]
    folders = [config_home()] + (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":")
    return [os.path.join(folder, name) for folder in folders if folder
            for name in [f"{d}-{TERMINALS_LIST}" for d in desktops] + [TERMINALS_LIST]]


def read_terminals(path):
    """Desktop ids in a list file, without comments, exclusions (-id) and
    directives (/...)."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except (OSError, UnicodeDecodeError):
        return []
    return [line.strip() for line in lines
            if line.strip() and not line.strip().startswith(("#", "-", "/", "+"))]


def default_terminal(installed):
    """The desktop id xdg-terminal-exec starts: the first installed one listed."""
    for path in terminal_lists():
        for desktop_id in read_terminals(path):
            if desktop_id in installed:
                return desktop_id
    return None


def set_terminal(desktop_id):
    """Put desktop_id first in ~/.config/xdg-terminals.list, keeping the rest."""
    if not re.match(r"^[A-Za-z0-9_.-]+\.desktop$", desktop_id):
        raise ControlError(f"not a desktop file id: '{desktop_id}'")
    path = os.path.join(config_home(), TERMINALS_LIST)
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = ["# Terminals for xdg-terminal-exec, first one first (Settings > Default Applications)."]
    lines = [line for line in lines if line.strip() != desktop_id]
    at = next((i for i, line in enumerate(lines) if line.strip() and not line.startswith("#")), len(lines))
    lines.insert(at, desktop_id)
    write_atomic(path, "\n".join(lines) + "\n")


# --- Date and time: timedatectl ---------------------------------------------------------

def time_settings(text):
    """{key: value} from `timedatectl show` output."""
    return dict(line.split("=", 1) for line in text.splitlines() if "=" in line)


def zones_by_region(names):
    """{region: [(city, zone)]} from time zone names; ones without a region
    (UTC) go under "Other"."""
    regions = {}
    for zone in names:
        region, _, city = zone.partition("/")
        if not city:
            region, city = "Other", zone
        regions.setdefault(region, []).append((city.replace("_", " "), zone))
    return regions


def night_light_command(values):
    """flickos-settings' night-light script with the chosen warmth, or None
    while night light is off."""
    if not value_of(SETTINGS["night-light.enabled"], values.get("night-light.enabled")):
        return None
    return [NIGHT_LIGHT, "-t", str(value_of(SETTINGS["night-light.temperature"],
                                            values.get("night-light.temperature")))]


def night_light_daemons():
    """FlickOS's wlsunset: started by `night-light` (NIGHT_LIGHT_MARK in its
    environment), or by autostart's night-light script before
    flickos-control ran it (its options only: -l -L or -S -s)."""
    found = []
    for pid in own_processes("wlsunset"):
        try:
            with open(os.path.join(PROC, str(pid), "environ"), "rb") as f:
                environ = f.read().split(b"\0")
            with open(os.path.join(PROC, str(pid), "cmdline"), "rb") as f:
                args = [arg.decode(errors="replace") for arg in f.read().split(b"\0") if arg]
        except OSError:
            continue
        legacy = [arg for arg in args[1:] if arg.startswith("-")] in (["-l", "-L"], ["-S", "-s"])
        if f"{NIGHT_LIGHT_MARK}=1".encode() in environ or legacy:
            found.append(pid)
    return found


def restart_night_light():
    """Stop FlickOS's night light and start it again as chosen (a new warmth,
    a new time zone), or not while it is off."""
    for pid in night_light_daemons():
        with contextlib.suppress(OSError):
            os.kill(pid, signal.SIGTERM)
    if night_light_command(load_values()[0]):
        subprocess.Popen([*SELF, "night-light"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


# --- Notifications: mako's Do Not Disturb -------------------------------------------------

def notifications_running():
    """Whether this user's mako runs and has the notifications' bus name.
    makoctl must never run before: D-Bus would start a mako of its own
    (mako's activation file) without FlickOS's config."""
    if not own_processes("mako"):
        return False
    return "true" in command_output(["busctl", "--user", "call", "org.freedesktop.DBus", "/org/freedesktop/DBus",
                                     "org.freedesktop.DBus", "NameHasOwner", "s", NOTIFICATIONS_BUS_NAME])


def set_do_not_disturb(on):
    """Add or remove mako's mode; ControlError if makoctl fails."""
    run(["makoctl", "mode", "-a" if on else "-r", DND_MODE])


def mako_config_problem():
    """Why Do Not Disturb doesn't work with the user's own mako config, or None."""
    path = os.path.join(config_home(), "mako", "config")
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    if f"mode={DND_MODE}" in text:
        return None
    return (f"{path} replaces FlickOS's notification settings and has no [mode={DND_MODE}] section, "
            "so Do Not Disturb hides nothing. Add one with invisible=1 (man 5 mako).")


# --- Login: autologin ---------------------------------------------------------------------

def autologin_state():
    """(available, autologin user or None). Available on installed systems
    with flickos-greeter (its group exists)."""
    if live_session():
        return False, None
    try:
        members = grp.getgrnam(AUTOLOGIN_GROUP).gr_mem
    except KeyError:
        return False, None
    return True, (members[0] if members else None)


def user_name():
    return pwd.getpwuid(os.getuid()).pw_name


# --- Firewall: ufw ------------------------------------------------------------------------

def firewall_state(path=None):
    """True on, False off, None without ufw. ufw enable and disable change
    ENABLED= and the running firewall together."""
    try:
        with open(path or UFW_CONF, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return None
    match = re.search(r"^\s*ENABLED\s*=\s*[\"']?(\w+)", text, re.M)
    return bool(match) and match.group(1).lower() == "yes"


def phones_allowed(path=None):
    """Whether the helper let phones through the firewall (its profile is there)."""
    try:
        with open(path or PHONES_PROFILE, encoding="utf-8") as f:
            return f.readline().rstrip("\n") == PHONES_MARK
    except OSError:
        return False


def thunar_hides_phone_action():
    """The user's Thunar/uca.xml when it hides flickos-settings' Send to Phone,
    else None. Thunar reads only the first uca.xml, the user's first, and
    saves one there when the user edits custom actions, or when it read
    Debian's (before flickos-settings' thunar.service drop-in)."""
    if shutil.which("thunar") is None:
        return None

    def has_action(path):
        try:
            return any(e.text == THUNAR_PHONE_ACTION for e in ET.parse(path).iter("unique-id"))
        except (OSError, ET.ParseError):
            return None     # missing or unreadable

    user = os.path.join(config_home(), "Thunar", "uca.xml")
    system = any(has_action(os.path.join(d, "Thunar", "uca.xml"))
                 for d in (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":") if d)
    return user if system and has_action(user) is False else None


def thunar_notice(path):
    return (f"Send to Phone is missing from the file manager's right-click menu: {path} has right-click "
            "actions of its own, and the file manager reads only that file. If you didn't add any, delete it "
            "and run thunar -q. Otherwise add Send to Phone in the file manager's Edit → Configure custom "
            "actions, with the command flickos-phone send --notify %F.")


def firefox_memory_state(prefs=None, syspref=None):
    """True while the helper's file makes Firefox use less memory, False
    without it, None without Debian's firefox-esr (which reads the file)."""
    prefs, syspref = prefs or FIREFOX_PREFS, syspref or FIREFOX_SYSPREF
    folder = os.path.dirname(prefs)
    if not os.path.isdir(folder) or os.path.realpath(syspref) != os.path.realpath(folder):
        return None
    with contextlib.suppress(OSError, UnicodeDecodeError), open(prefs, encoding="utf-8") as f:
        return f.readline().rstrip("\n") == FIREFOX_MARK
    return False


# --- An old computer -----------------------------------------------------------------------

def gigabytes(kb):
    return f"{kb / 1024 / 1024:.1f} GB"


def memory_kb(meminfo):
    match = re.search(r"^MemTotal:\s+(\d+) kB", meminfo, re.M)
    return int(match.group(1)) if match else None


def drm_driver(device):
    """The DRM driver of a /sys/class/drm device folder's parent. A virtio
    GPU's parent is its PCI device (virtio-pci): the driver is its virtio
    child's."""
    name = os.path.basename(os.path.realpath(os.path.join(device, "driver")))
    if name == "virtio-pci":
        for child in sorted(glob.glob(os.path.join(device, "virtio*"))):
            return os.path.basename(os.path.realpath(os.path.join(child, "driver"))), child
    return name, device


def accelerated(drm=None):
    """Whether a graphics driver with 3D is there: a render node whose driver
    isn't one of SOFTWARE_DRIVERS, and for a virtio GPU, with 3D (virgl, its
    feature bit 0) turned on. Without one, wlroots and Mesa draw with the
    processor."""
    drm = drm or SYS_DRM
    for node in sorted(glob.glob(os.path.join(drm, "renderD*"))):
        name, device = drm_driver(os.path.join(node, "device"))
        if name in SOFTWARE_DRIVERS:
            continue
        if name == "virtio_gpu" and not read_text(os.path.join(device, "features")).startswith("1"):
            continue
        return True
    return False


def old_computer(proc=None, drm=None):
    """Why Settings suggests saving memory here, in the user's words; empty
    for a computer the defaults are made for (docs/design/flickos-lite.md
    ADR-004). Never turns anything on."""
    reasons = []
    kb = memory_kb(read_text(os.path.join(proc or PROC, "meminfo")))
    if kb is not None and kb <= OLD_MEMORY_KB:
        reasons.append(f"This computer has {gigabytes(kb)} of memory.")
    if not accelerated(drm):
        reasons.append("Its graphics have no acceleration, so the processor draws the screen.")
    return reasons


# --- Users: accounts -----------------------------------------------------------------------

@dataclasses.dataclass(frozen=True)
class Account:
    name: str
    full_name: str
    uid: int
    home: str
    admin: bool


def uid_range():
    """Regular accounts: UID_MIN..UID_MAX of login.defs (1000..60000)."""
    limits = {"UID_MIN": 1000, "UID_MAX": 60000}
    with contextlib.suppress(OSError), open(LOGIN_DEFS, encoding="utf-8") as f:
        for line in f:
            parts = line.split()
            if len(parts) == 2 and parts[0] in limits and parts[1].isdigit():
                limits[parts[0]] = int(parts[1])
    return limits["UID_MIN"], limits["UID_MAX"]


def accounts():
    """The regular accounts, by full name."""
    low, high = uid_range()
    try:
        admins = set(grp.getgrnam(ADMIN_GROUP).gr_mem)
    except KeyError:
        admins = set()
    found = [Account(entry.pw_name, entry.pw_gecos.split(",")[0].strip(), entry.pw_uid, entry.pw_dir,
                     entry.pw_name in admins)
             for entry in pwd.getpwall() if low <= entry.pw_uid <= high]
    return sorted(found, key=lambda account: (account.full_name or account.name).casefold())


def suggest_user_name(full_name, taken=()):
    """A user name from a full name: the first name, or all of it when that is
    taken ("Ann Lee" -> ann, annlee); accents dropped."""
    plain = unicodedata.normalize("NFKD", full_name).encode("ascii", "ignore").decode().lower()
    words = [re.sub(r"[^a-z0-9]", "", word) for word in plain.split()]
    words = [word for word in words if word]
    if not words:
        return ""
    for candidate in (words[0], "".join(words)):
        candidate = re.sub(r"^[0-9]+", "", candidate)[:32]
        if candidate and candidate not in taken:
            return candidate
    return re.sub(r"^[0-9]+", "", words[0])[:32]


def user_name_problem(name, taken):
    """Why a new account can't have this name, or None."""
    if not name:
        return "Choose a user name."
    if not USER_NAME.match(name):
        return ("A user name has lowercase letters, digits, - and _, starts with a letter "
                "and is at most 32 characters long.")
    if name in taken:
        return f"{name} is already taken."
    return None


def full_name_problem(full_name):
    if len(full_name) > FULL_NAME_MAX:
        return f"A full name is at most {FULL_NAME_MAX} characters long."
    if any(c in ":,=\\" or not c.isprintable() for c in full_name):
        return "A full name can't contain : , = or \\."
    return None


def password_problem(password, again):
    if not password:
        return "Choose a password."
    if password != again:
        return "The passwords don't match."
    return None


def taken_names():
    """User and group names in use: a new account gets a group of its name."""
    return {entry.pw_name for entry in pwd.getpwall()} | {entry.gr_name for entry in grp.getgrall()}


# --- About: system information ------------------------------------------------------------

def read_shell_values(path):
    """KEY="value" lines of a shell-style file (flickos-release, os-release)."""
    values = {}
    with contextlib.suppress(OSError, UnicodeDecodeError), open(path, encoding="utf-8") as f:
        for line in f:
            match = re.match(r"^([A-Z_][A-Z0-9_]*)=(.*)$", line.strip())
            if match:
                with contextlib.suppress(ValueError):
                    values[match.group(1)] = " ".join(shlex.split(match.group(2)))
    return values


def read_text(path):
    with contextlib.suppress(OSError, UnicodeDecodeError), open(path, encoding="utf-8") as f:
        return f.read().strip()
    return ""


def computer_name():
    vendor, product = (read_text(os.path.join(DMI, name)) for name in ("sys_vendor", "product_name"))
    parts = [part for part in (vendor, product) if part and part.lower() not in DMI_PLACEHOLDERS]
    return " ".join(parts)


def processor_name(cpuinfo):
    name = next((line.split(":", 1)[1].strip() for line in cpuinfo.splitlines()
                 if line.startswith("model name")), "")
    name = " ".join(name.split())
    count = os.cpu_count()
    return f"{name} × {count}" if name and count else name


def memory_size(meminfo):
    match = re.search(r"^MemTotal:\s+(\d+) kB", meminfo, re.M)
    return f"{int(match.group(1)) / 1024 / 1024:.1f} GiB" if match else ""


def graphics_names(lspci):
    """Display controllers from `lspci -mm`: "Vendor Device" per card."""
    names = []
    for line in lspci.splitlines():
        with contextlib.suppress(ValueError):
            fields = shlex.split(line)
            if len(fields) >= 4 and re.search(r"VGA|3D|Display", fields[1]):
                names.append(f"{fields[2]} {fields[3]}")
    return names


def disk_space(path="/"):
    with contextlib.suppress(OSError):
        stat = os.statvfs(path)
        total, free = stat.f_blocks * stat.f_frsize, stat.f_bavail * stat.f_frsize
        return f"{free / 1e9:.0f} GB free of {total / 1e9:.0f} GB"
    return ""


def command_output(command):
    with contextlib.suppress(OSError, subprocess.TimeoutExpired):
        result = subprocess.run(command, capture_output=True, text=True, timeout=COMMAND_SECONDS, check=False)
        if result.returncode == 0:
            return result.stdout
    return ""


def layout_description(state_text):
    """"layout ID, style ID" from `flickos-layout state`, with "(yours)"
    for a user's own layout (flickos-layouts 1.56), "(yours, inherits
    PARENT)" for a user's own style, "trying" for one tried until logout and
    ", panel tweaks" while the user has them (1.58), so a bug report shows it."""
    try:
        state = json.loads(state_text)
        layout_id, style_id = state["layout"]["current"], state["style"]["current"]
        layout = next((c for c in state["layout"]["choices"] if c.get("id") == layout_id), {})
        style = next((c for c in state["style"]["choices"] if c.get("id") == style_id), {})
    except (ValueError, KeyError, TypeError, AttributeError):
        return ""
    notes = [f"yours, inherits {style['parent']}" if style.get("parent") else "yours"] if style.get("user") else []
    if state.get("trying"):
        notes.append("trying")
    return (f"layout {layout_id}" + (" (yours)" if layout.get("user") else "") + f", style {style_id}"
            + (f" ({', '.join(notes)})" if notes else "") + (", panel tweaks" if state.get("tweaks") else ""))


def system_info():
    """[(label, value)] for the About page and `about`; unknown values are left out."""
    release = read_shell_values(FLICKOS_RELEASE)
    flickos = " ".join(part for part in (release.get("FLICKOS_NAME", "FlickOS"), release.get("FLICKOS_VERSION"))
                       if part)
    if live_session():
        flickos += " (live session)"
    elif os.environ.get("FLICKOS_PLAIN") == "1":
        flickos += " (plain session)"   # flickos-session-plain: the user's own changes left out
    labwc = command_output(["labwc", "--version"]).split()
    desktop = " ".join(labwc[:2]) if labwc else "labwc"
    layout_text = layout_description(command_output([LAYOUT, "state"]))
    if layout_text:
        desktop += ", " + layout_text
    rows = [
        ("FlickOS", flickos),
        ("Debian", read_text(DEBIAN_VERSION)),
        ("Linux", os.uname().release),
        ("Computer", computer_name()),
        ("Processor", processor_name(read_text(os.path.join(PROC, "cpuinfo")))),
        ("Memory", memory_size(read_text(os.path.join(PROC, "meminfo")))),
        ("Graphics", ", ".join(graphics_names(command_output(["lspci", "-mm"])))),
        ("Disk", disk_space()),
        ("Desktop", desktop),
    ]
    return [(label, value) for label, value in rows if value]


def package_versions():
    """"package version" of FlickOS's installed packages."""
    text = command_output(["dpkg-query", "-W", "-f", "${db:Status-Abbrev}\t${Package}\t${Version}\n",
                           *FLICKOS_PACKAGES])
    return [f"{fields[1]} {fields[2]}" for fields in (line.split("\t") for line in text.splitlines())
            if len(fields) == 3 and fields[0].startswith("ii")]


def system_info_text():
    """The system information as plain text, for a bug report."""
    rows = system_info()
    width = max((len(label) for label, _ in rows), default=0)
    lines = [f"{label + ':':<{width + 1}} {value}" for label, value in rows]
    packages = package_versions()
    if packages:
        lines += ["", "Packages:"] + [f"  {package}" for package in packages]
    return "\n".join(lines) + "\n"


# --- Reading the owners' output ----------------------------------------------------

@dataclasses.dataclass(frozen=True)
class Item:
    id: str
    name: str
    comment: str = ""


def parse_items(text):
    """Items from `list` output: id, name and description separated by tabs."""
    items = []
    for line in text.splitlines():
        fields = line.split("\t")
        if fields[0].strip():
            items.append(Item(fields[0].strip(), (fields[1] if len(fields) > 1 else fields[0]).strip(),
                              fields[2].strip() if len(fields) > 2 else ""))
    return items


SHORTCUT_ROW = re.compile(r"^ {2}(\S.*?) {2,}(\S.*)$")


def parse_shortcuts(text):
    """`flickos-shortcuts list` output as [(section, [(keys, description)])].
    Sections are "Name:" lines; rows are indented keys, two or more spaces,
    then the description."""
    sections = []
    for line in text.splitlines():
        if line and not line.startswith(" ") and line.endswith(":"):
            sections.append((line[:-1], []))
            continue
        match = SHORTCUT_ROW.match(line)
        if match and sections:
            sections[-1][1].append((match.group(1).strip(), match.group(2).strip()))
    return [section for section in sections if section[1]]


@dataclasses.dataclass(frozen=True)
class TilerState:
    enabled: bool
    mode: str
    ratio: int = None               # None: flick-tiler before 1.3
    gap: int = None


@dataclasses.dataclass(frozen=True)
class CountmeState:
    enabled: bool
    reason: str = None              # why nothing is sent now, e.g. "live session"
    last_week: str = None           # ISO week last counted, e.g. 2026-W39
    request: str = None             # the URL that is sent


def countme_state(text):
    """CountmeState from `flickos-countme status` JSON."""
    try:
        status = json.loads(text)
    except ValueError:
        raise ControlError("flickos-countme gave no status") from None
    if not isinstance(status, dict):
        raise ControlError("flickos-countme gave no status")
    return CountmeState(enabled=bool(status.get("enabled")), reason=status.get("reason"),
                        last_week=status.get("last_week"), request=status.get("request"))


def tiler_state(text):
    """TilerState from `flick-tiler status` JSON."""
    try:
        status = json.loads(text)
    except ValueError:
        raise ControlError("flick-tiler gave no status") from None
    classes = status.get("class") or []
    numbers = {key: status[key] for key in ("ratio", "gap") if isinstance(status.get(key), int)}
    return TilerState(enabled=status.get("alt") != "off",
                      mode=classes[1] if len(classes) > 1 else status.get("alt"), **numbers)


@dataclasses.dataclass(frozen=True)
class LayoutState:
    choices: dict                   # kind -> [Item]
    current: dict                   # kind -> id
    warnings: list                  # flickos-layout doctor's
    defaults: dict = dataclasses.field(default_factory=dict)   # layout, style -> id (flickos-layouts 1.46)
    trying: str | None = None       # the style being tried until logout (flickos-layouts 1.52)
    yours: frozenset = frozenset()  # ids of the user's own layouts (flickos-layouts 1.56)


# A user's own style (flickos-layouts 1.45, docs/design/flickos-ricing.md):
# its subtitle says so, as in the chooser.
YOURS = "Yours"
TRYING_WARNING = "You are trying the style "     # flickos-layout doctor's line while trying


LAYOUT_KINDS = ("layout", "style", "clicks", "launcher", "menu-style")
# Read when flickos-layouts has them (Quick Settings: 1.35).
OPTIONAL_LAYOUT_KINDS = ("quick-settings",)


def away_from_default(state):
    """Is the layout or the style not the default? (Unknown defaults: no.)"""
    return any(state.defaults.get(kind) not in (None, state.current.get(kind)) for kind in ("layout", "style"))


def choice_comment(choice):
    """A choice's comment; a user's own style says so."""
    comment = choice.get("comment", "")
    if choice.get("user"):
        comment = f"{comment} · {YOURS}" if comment else YOURS
    return comment


def layout_state(text):
    """LayoutState from `flickos-layout state` JSON."""
    try:
        state = json.loads(text)
        kinds = LAYOUT_KINDS + tuple(kind for kind in OPTIONAL_LAYOUT_KINDS if kind in state)
        return LayoutState(
            choices={kind: [Item(choice["id"], choice["name"], choice_comment(choice))
                            for choice in state[kind]["choices"]] for kind in kinds},
            current={kind: state[kind]["current"] for kind in kinds},
            warnings=list(state.get("warnings", [])),
            defaults={kind: state[kind]["default"] for kind in ("layout", "style") if state[kind].get("default")},
            trying=state.get("trying"),
            yours=frozenset(choice["id"] for choice in state["layout"]["choices"] if choice.get("user")))
    except (ValueError, KeyError, TypeError):
        raise ControlError("flickos-layout gave no state") from None


def available_tiles(which=shutil.which):
    """Tiles whose app is installed: most are Recommends, which users may remove."""
    return [tile for tile in TILES if which(tile.command[0])]


def output_messages(stdout, stderr):
    """What a command printed, as lines to show, without the program prefix."""
    lines = []
    for line in (stdout + "\n" + stderr).splitlines():
        line = re.sub(r"^(flickos-control|flickos-layout|flick-tiler|flickos-shortcuts|flickos-phone|"
                      r"flickos-countme|flickos-screenshot|flickos-recovery|control-helper|countme-helper|"
                      r"recovery-helper): ", "",
                      line.strip())
        if line and line not in lines:
            lines.append(line)
    return lines


def run(command):
    """Run a reading command; its stdout. Raises ControlError."""
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=COMMAND_SECONDS, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise ControlError(f"{command[0]}: {error}") from None
    if result.returncode != 0:
        message = " ".join(output_messages("", result.stderr)) or f"exit code {result.returncode}"
        raise ControlError(f"{' '.join(command)}: {message}")
    return result.stdout


def doctor_warnings():
    """flickos-layout doctor's warnings: user config that hides FlickOS's."""
    try:
        result = subprocess.run([LAYOUT, "doctor"], capture_output=True, text=True,
                                timeout=COMMAND_SECONDS, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return []
    return result.stdout.strip().splitlines() if result.returncode == 1 else []


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        raise ControlError("XDG_RUNTIME_DIR is not set")
    return os.path.join(base, "flickos")


@contextlib.contextmanager
def single_instance():
    """Yields True for the first window of the session, False while one is open."""
    folder = runtime_dir()
    os.makedirs(folder, exist_ok=True)
    with open(os.path.join(folder, LOCK), "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            yield False
            return
        yield True


# --- The window -----------------------------------------------------------------------

def load_gtk():
    """(GLib, Gio, Gtk, GdkPixbuf), or None without GTK 3 or a display."""
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GLib
        GLib.set_prgname(APP_ID)
        from gi.repository import GdkPixbuf, Gio, Gtk
    except (ImportError, ValueError) as error:
        warn(f"GTK 3 is not available ({error})")
        return None
    if not Gtk.init_check(sys.argv[:1])[0]:
        warn("cannot open a window (no display)")
        return None
    return GLib, Gio, Gtk, GdkPixbuf


class Ui:
    """Widgets shared by the pages."""

    def __init__(self, gtk):
        self.GLib, self.Gio, self.Gtk, self.GdkPixbuf = gtk
        self.reads = {}             # key -> number of the newest background() call
        self.indexing = None        # the Page being built: its rows and headings go into index
        self.index = []             # SearchItems

    def label(self, text, dim=False, wrap=True, markup=False):
        label = self.Gtk.Label(xalign=0, wrap=wrap)
        if wrap:
            label.set_max_width_chars(60)
        if markup:
            label.set_markup(text)
        else:
            label.set_text(text)
        if dim:
            label.get_style_context().add_class("dim-label")
        return label

    def heading(self, text):
        label = self.label(f"<b>{self.GLib.markup_escape_text(text)}</b>", wrap=False, markup=True)
        if self.indexing:
            self.index.append(search_item(text, self.indexing.name, page=self.indexing.id, target=label))
        return label

    def page(self):
        """A scrolled page; returns (scrolled window, content box)."""
        box = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=12, margin=24)
        scrolled = self.Gtk.ScrolledWindow(hscrollbar_policy=self.Gtk.PolicyType.NEVER)
        scrolled.add(box)
        return scrolled, box

    def framed_list(self):
        listbox = self.Gtk.ListBox(selection_mode=self.Gtk.SelectionMode.NONE)
        listbox.set_header_func(lambda row, before: row.set_header(self.Gtk.Separator() if before else None))
        frame = self.Gtk.Frame()
        frame.add(listbox)
        return frame, listbox

    def row(self, title, widget=None, subtitle=None):
        line = self.Gtk.Box(spacing=12, margin=10)
        text = self.Gtk.Box(orientation=self.Gtk.Orientation.VERTICAL, spacing=2, valign=self.Gtk.Align.CENTER)
        text.pack_start(self.label(title, wrap=False), False, False, 0)
        # Always there, hidden while empty: set_subtitle() can fill it later.
        second = self.label(subtitle or "", dim=True)
        second.set_no_show_all(not subtitle)
        text.pack_start(second, False, False, 0)
        line.pack_start(text, True, True, 0)
        if widget is not None:
            widget.set_valign(self.Gtk.Align.CENTER)
            line.pack_end(widget, False, False, 0)
            self.name_control(widget, title)
        row = self.Gtk.ListBoxRow(activatable=False)
        row.add(line)
        row.subtitle = second
        if self.indexing:
            self.index.append(search_item(title, self.indexing.name, subtitle or "", page=self.indexing.id,
                                          target=row, focus=widget))
        return row

    def name_control(self, widget, title):
        """Name a row's control after the row for screen readers (HIG A11Y-8).
        Only controls without text of their own (a switch, a list, a slider,
        a text field); in a box of several, only when it holds one of them.
        Buttons and check boxes keep their own labels."""
        Gtk = self.Gtk
        nameless = (Gtk.Switch, Gtk.ComboBox, Gtk.Scale, Gtk.SpinButton, Gtk.Entry)
        if isinstance(widget, nameless):
            controls = [widget]
        elif isinstance(widget, Gtk.Box):
            controls = [child for child in widget.get_children() if isinstance(child, nameless)]
        else:
            controls = []
        # Always set: GTK names a list after its current choice.
        if len(controls) == 1:
            controls[0].get_accessible().set_name(title)

    @staticmethod
    def set_subtitle(row, text):
        row.subtitle.set_text(text)
        row.subtitle.set_visible(bool(text))

    def status_label(self):
        label = self.label("", dim=True)
        label.set_selectable(True)
        return label

    def notice(self):
        """A warning bar, hidden until set_notice() gets lines."""
        bar = self.Gtk.InfoBar(message_type=self.Gtk.MessageType.WARNING, no_show_all=True)
        text = self.label("")
        text.set_selectable(True)
        text.set_max_width_chars(100)
        bar.get_content_area().add(text)
        text.show()
        bar.text = text
        return bar

    @staticmethod
    def set_notice(bar, lines):
        bar.text.set_text("\n".join(lines))
        bar.set_visible(bool(lines))

    def error(self, box, message):
        box.pack_start(self.label(message), False, False, 0)

    def run_async(self, command, done, stdin=None):
        """Run a changing command without blocking the window; then
        done(ok, stdout, stderr). stdin: text for its standard input."""
        flags = self.Gio.SubprocessFlags.STDOUT_PIPE | self.Gio.SubprocessFlags.STDERR_PIPE
        if stdin is not None:
            flags |= self.Gio.SubprocessFlags.STDIN_PIPE
        try:
            process = self.Gio.Subprocess.new(list(command), flags)
        except self.GLib.Error as error:
            done(False, "", error.message)
            return

        def finished(process, result):
            try:
                _, stdout, stderr = process.communicate_utf8_finish(result)
                ok = process.get_successful()
            except self.GLib.Error as error:
                stdout, stderr, ok = "", error.message, False
            done(ok, stdout or "", stderr or "")

        process.communicate_utf8_async(stdin, None, finished)

    def background(self, work, done, key=None):
        """Run work() in a thread, so the window keeps drawing while it waits
        for a command; then done(result, None) in the main loop, or
        done(None, message) when it failed. key: of several calls with the
        same key, only the newest one's done() runs."""
        number = self.reads[key] = self.reads.get(key, 0) + 1

        def finish(result, error):
            if self.reads[key] == number:
                done(result, error)
            return False

        def thread():
            try:
                result, error = work(), None
            except ControlError as failure:
                result, error = None, str(failure)
            except Exception as failure:    # a bug: say so instead of loading forever
                traceback.print_exc()
                result, error = None, f"{type(failure).__name__}: {failure}"
            self.GLib.idle_add(finish, result, error)

        threading.Thread(target=thread, daemon=True).start()

    def loading(self):
        """A spinner for a page that is still reading; hide() it when done."""
        box = self.Gtk.Box(spacing=8)
        # Turns only while on screen: GTK 3 keeps animating an active spinner
        # on a stack page that isn't shown, 60 redraws a second (HIG CODE-10).
        spinner = self.Gtk.Spinner()
        spinner.connect("map", lambda s: s.start())
        spinner.connect("unmap", lambda s: s.stop())
        box.pack_start(spinner, False, False, 0)
        box.pack_start(self.label("Loading…", dim=True, wrap=False), False, False, 0)
        return box

    def start_app(self, command):
        """Start an app of its own; it lives on after this window closes."""
        try:
            process = self.Gio.Subprocess.new(list(command), self.Gio.SubprocessFlags.NONE)
        except self.GLib.Error as error:
            warn(error.message)
            return
        process.wait_async(None, None, None)     # reaped when it exits

    def cards(self, items, current, on_choose, content=None):
        """A row of cards for items: each is a button that stays pressed while
        chosen, current one pressed. on_choose(id) when the user picks another;
        returns (box, select) where select(id) changes the chosen one without
        calling on_choose. content(item): a widget above the name, or None."""
        Gtk = self.Gtk
        box = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, column_spacing=12,
                          row_spacing=12, min_children_per_line=len(items) or 1,
                          max_children_per_line=len(items) or 1, valign=Gtk.Align.START)
        radios = {}
        quiet = []
        group = None
        for item in items:
            radio = Gtk.RadioButton.new_from_widget(group)
            group = group or radio
            radio.set_mode(False)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin=4)
            if content is not None:
                extra = content(item)
                if extra is not None:
                    text.pack_start(extra, False, False, 0)
            text.pack_start(self.label(f"<b>{self.GLib.markup_escape_text(item.name)}</b>",
                                       wrap=False, markup=True), False, False, 0)
            if item.comment:
                comment = self.label(item.comment, dim=True)
                comment.set_max_width_chars(20)
                text.pack_start(comment, False, False, 0)
            radio.add(text)
            radio.set_active(item.id == current)
            radios[item.id] = radio

            def toggled(button, item_id=item.id):
                if button.get_active() and not quiet:
                    on_choose(item_id)

            radio.connect("toggled", toggled)
            box.add(radio)

        def select(item_id):
            if item_id in radios:
                quiet.append(True)
                radios[item_id].set_active(True)
                quiet.pop()

        return box, select


    def combo_row(self, title, items, current, on_choose):
        """A row (Ui.row) with a list of items, current one chosen, its
        comment the row's subtitle. Returns (row, select) like choices()."""
        combo = self.Gtk.ComboBoxText()
        comments = {item.id: item.comment for item in items}
        for item in items:
            combo.append(item.id, item.name)
        combo.set_active_id(current)
        row = self.row(title, combo, comments.get(current, ""))
        quiet = []

        def changed(widget):
            self.set_subtitle(row, comments.get(widget.get_active_id(), ""))
            if widget.get_active_id() and not quiet:
                on_choose(widget.get_active_id())

        def select(item_id):
            quiet.append(True)
            combo.set_active_id(item_id)
            quiet.pop()

        combo.connect("changed", changed)
        return row, select


class LayoutPage:
    """Desktop layout, style, desktop clicks, the apps button, the start
    menu's style and Quick Settings (flickos-layout). The apps button's
    choice, the menu style and Quick Settings are shown only while there is a
    choice: the start menu and Quick Settings are offered while flickos-menu
    is installed. The menu style can be changed only while the apps button
    opens the start menu."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.busy = False           # a change is being applied
        self.current = {}
        self.selects = {}
        self.groups = {}
        box.pack_start(ui.label("Changes apply right away."), False, False, 0)
        self.notice = ui.notice()
        box.pack_start(self.notice, False, False, 0)
        self.choices = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.choices, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def build(self, state):
        """The groups of choices, once the first state is read. The apps
        button and the menu style only while there is a choice."""
        self.choices.pack_start(self.ui.heading("Layout"), False, False, 0)
        self.yours = state.yours
        group, self.selects["layout"] = self.ui.cards(
            state.choices["layout"], state.current["layout"], lambda item_id: self.choose("layout", item_id),
            content=self.preview)
        self.groups["layout"] = group
        self.choices.pack_start(group, False, False, 0)
        rows = [("style", "Style"), ("clicks", "Desktop clicks")]
        if len(state.choices["launcher"]) > 1:
            rows += [("launcher", "Apps button"), ("menu-style", "Start menu style")]
        frame, listbox = self.ui.framed_list()
        for kind, title in rows:
            row, self.selects[kind] = self.ui.combo_row(
                title, state.choices[kind], state.current[kind], lambda item_id, kind=kind: self.choose(kind, item_id))
            self.groups[kind] = row
            listbox.add(row)
        if any(item.id == "on" for item in state.choices.get("quick-settings", [])):
            listbox.add(self.quick_row(state))
        folders = self.ui.Gtk.Box(spacing=6)
        for label, where in (("_Styles Folder", user_styles_folder), ("_Layouts Folder", user_layouts_folder),
                             ("_Tweaks Folder", user_tweaks_folder)):
            button = self.ui.Gtk.Button.new_with_mnemonic(label)
            button.connect("clicked", lambda _button, where=where: self.open_folder(where()))
            folders.pack_start(button, False, False, 0)
        listbox.add(self.ui.row("Your own styles and layouts", folders,
                                "Their folders, and your panel tweaks' (CSS). Make one with flickos-layout "
                                "style new, layout new or tweaks new; flickos-layout watch in a terminal "
                                "applies each save"))
        buttons = self.ui.Gtk.Box(spacing=6)
        for label, command in (("_Keep", lambda: [LAYOUT, "style", "set", self.trying]),
                               ("_End", lambda: [LAYOUT, "try", "--end"])):
            button = self.ui.Gtk.Button.new_with_mnemonic(label)
            button.connect("clicked", lambda _button, command=command: self.busy or self.apply(command()))
            buttons.pack_start(button, False, False, 0)
        self.trying, self.try_row = None, self.ui.row("Trying a style", buttons, "")
        listbox.add(self.try_row)
        back = self.ui.Gtk.Button.new_with_mnemonic("_Back to FlickOS's Look")
        back.connect("clicked", lambda _button: self.back_to_default())
        self.back_row = self.ui.row("FlickOS's look", back,
                                    "The default layout and style. Settings → History can undo it")
        self.groups["back"] = self.back_row
        listbox.add(self.back_row)
        self.choices.pack_start(frame, False, False, 12)
        self.choices.show_all()
        self.back_row.hide()            # show_back shows it when there is something to go back from
        self.try_row.hide()             # show_try, while trying

    def open_folder(self, folder):
        """The folder of the user's own styles, layouts or panel tweaks, made
        if missing (docs/09 *Your own style*, *Your own layout*, *Panel tweaks*)."""
        try:
            os.makedirs(folder, exist_ok=True)
        except OSError as error:
            self.status.set_text(f"Can't make {folder}: {error.strerror}")
            return
        self.ui.start_app(["xdg-open", folder])

    def back_to_default(self):
        """The default layout and style (flickos-layout set default --style default)."""
        if self.busy:
            return
        self.apply([LAYOUT, "set", "default", "--style", "default"])

    def show_try(self, state):
        """While a style is tried (flickos-layout try): Keep saves it, End goes back."""
        self.trying = state.trying
        name = next((item.name for item in state.choices["style"] if item.id == state.trying), state.trying)
        if state.trying:
            self.ui.set_subtitle(self.try_row, f"{name} until you log out. Keep makes it your style; End goes "
                                               "back to yours now")
        self.try_row.set_visible(bool(state.trying))

    def show_back(self, state):
        """Back to FlickOS's Look only while the layout or style isn't the default."""
        self.back_row.set_visible(away_from_default(state))

    def quick_row(self, state):
        """Quick Settings: a switch (flickos-layout quick-settings set on|off)."""
        switch = self.ui.Gtk.Switch()
        self.quick_comment = next(item.comment for item in state.choices["quick-settings"] if item.id == "on")
        row = self.ui.row("Quick Settings", switch, self.quick_comment)
        quiet = []

        def switched(widget, _param):
            if not quiet:
                self.choose("quick-settings", "on" if widget.get_active() else "off")

        def select(item_id):
            quiet.append(True)
            switch.set_active(item_id == "on")
            quiet.pop()

        switch.connect("notify::active", switched)
        self.quick = row
        self.selects["quick-settings"], self.groups["quick-settings"] = select, row
        return row

    def quick_subtitle(self):
        """What it is, and what it costs while the start menu is off: then
        flickos-menu's program runs for Quick Settings alone (ADR-002)."""
        text = self.quick_comment + "."
        if self.current.get("launcher") != "menu":
            text += " While the start menu is off, it keeps a program of about 31 MB running."
        self.ui.set_subtitle(self.quick, text)

    def load(self, then=None):
        """Read the choices in use and doctor's warnings (flickos-layout
        state); then(state) once they are shown."""
        def loaded(state, error):
            self.loading.hide()
            if error:
                self.status.set_text(error if self.selects else f"Can't read the desktop layouts: {error}")
                self.set_busy(self.busy)
                return
            if not self.selects:
                self.build(state)
            if not self.busy:       # a change started meanwhile: its own load shows it
                self.current = {kind: state.current[kind] for kind in self.selects}
                for kind, select in self.selects.items():
                    select(self.current[kind])
                if "quick-settings" in self.selects:
                    self.quick_subtitle()
                self.show_back(state)
                self.show_try(state)
                self.set_busy(False)
            # The trying row says what doctor's line about it would.
            self.ui.set_notice(self.notice, [w for w in state.warnings
                                             if not (state.trying and w.startswith(TRYING_WARNING))])
            if then:
                then(state)

        self.ui.background(lambda: layout_state(run([LAYOUT, "state"])), loaded, key=(self, "state"))

    def preview(self, item):
        if item.id in self.yours:
            # A user's own layout has no picture (and FlickOS's of the same
            # id isn't it): a blank tile keeps the cards the same size.
            return self.ui.Gtk.Frame(shadow_type=self.ui.Gtk.ShadowType.IN, width_request=PREVIEW_WIDTH,
                                     height_request=PREVIEW_HEIGHT, halign=self.ui.Gtk.Align.START)
        path = os.path.join(LAYOUTS_DIR, item.id, PREVIEW)
        if not os.path.isfile(path):
            return None
        try:
            pixbuf = self.ui.GdkPixbuf.Pixbuf.new_from_file_at_scale(path, PREVIEW_WIDTH, PREVIEW_HEIGHT, True)
        except self.ui.GLib.Error as error:
            warn(f"{path}: {error.message}")
            return None
        image = self.ui.Gtk.Image.new_from_pixbuf(pixbuf)
        image.set_halign(self.ui.Gtk.Align.START)
        return image

    def choose(self, kind, item_id):
        if self.busy or item_id == self.current.get(kind):
            return
        self.apply([LAYOUT, "set", item_id] if kind == "layout" else [LAYOUT, kind, "set", item_id])

    def apply(self, command):
        """Run a flickos-layout command, then show the choices and its messages."""
        self.set_busy(True)
        self.status.set_text("Applying…")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            if not ok:
                messages = messages or ["Could not apply the change."]
            self.busy = False
            # doctor's warnings are in the bar, not twice.
            self.load(lambda state: self.status.set_text("\n".join(m for m in messages if m not in state.warnings)))

        self.ui.run_async(command, done)

    def set_busy(self, busy):
        self.busy = busy
        for kind, group in self.groups.items():
            # The start menu's style matters only while the apps button opens it.
            group.set_sensitive(not busy and (kind != "menu-style" or self.current.get("launcher") == "menu"))

    def shown(self):
        """The choices may have changed elsewhere (the chooser, a command)."""
        if not self.busy:
            self.load()


CHOICE_NAMES = {
    "color": "Dark color",
    "wallpaper": "The wallpaper",
    "buttonAreas": "Areas at the bottom of the pad",
    "clickfinger": "Number of fingers (two for a right click)",
    "adaptive": "Adaptive (faster movement goes further)",
    "flat": "Flat (no acceleration)",
    "screen": "The whole screen",
    "lens": "A lens around the pointer",
}


def duration_name(seconds):
    seconds = int(seconds)
    if seconds == 0:
        return "Never"
    if seconds % 3600 == 0:
        return f"{seconds // 3600} hour{'s' if seconds > 3600 else ''}"
    if seconds % 60 == 0:
        return f"{seconds // 60} minute{'s' if seconds > 60 else ''}"
    return f"{seconds} seconds"


class SettingsPage:
    """A page of flickos-control's own settings (SETTINGS). A change runs
    `flickos-control set KEY VALUE`, which saves it and has labwc reload."""

    def __init__(self, ui, intro):
        self.ui = ui
        self.widget, self.box = ui.page()
        self.box.pack_start(ui.label(intro), False, False, 0)
        self.notice = ui.notice()
        self.box.pack_start(self.notice, False, False, 0)
        self.controls = {}          # key -> (widget, setter)
        self.timers = {}
        self.quiet = False
        self.status = ui.status_label()
        self.values = load_values()[0]

    def value(self, key):
        setting = SETTINGS[key]
        return value_of(setting, self.values.get(key))

    def control(self, key):
        """A switch, slider or list for a setting, showing its value."""
        Gtk, setting = self.ui.Gtk, SETTINGS[key]
        if setting.kind == "bool":
            widget = Gtk.Switch()
            widget.connect("notify::active", lambda w, _p: self.change(key, "yes" if w.get_active() else "no"))
            setter = lambda value: widget.set_active(bool(value))
        elif setting.topic == "idle" or key in NAMED_CHOICES:
            # A list of named values; another saved value is added to it.
            named = NAMED_CHOICES.get(key) or [(seconds, duration_name(seconds)) for seconds in IDLE_CHOICES]
            name_of = duration_name if setting.topic == "idle" else str
            widget = Gtk.ComboBoxText()
            for value, name in named:
                widget.append(str(value), name)
            widget.connect("changed", lambda w: w.get_active_id() and self.change(key, w.get_active_id()))

            def setter(value, widget=widget, name_of=name_of):
                if widget.get_active_id() != str(value) and str(value) not in [row[1] for row in widget.get_model()]:
                    widget.append(str(value), name_of(value))
                widget.set_active_id(str(value))
        elif setting.kind == "number":
            integer = isinstance(setting.default, int)
            step = 0.1 if not integer else (50 if setting.high > 100 else 5)
            widget = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, setting.low, setting.high, step)
            widget.set_size_request(260, -1)
            if integer:
                unit = " ms" if setting.high > 100 else " per second"
                widget.set_value_pos(Gtk.PositionType.RIGHT)
                widget.connect("format-value", lambda _w, v, unit=unit: f"{int(v)}{unit}")
            else:
                widget.set_draw_value(False)
                for mark, text in ((setting.low, "Slow"), (0, "Default"), (setting.high, "Fast")):
                    widget.add_mark(mark, Gtk.PositionType.BOTTOM, text)
            widget.connect("value-changed", self.slider_changed, key)
            setter = lambda value: widget.set_value(value)
        else:
            widget = Gtk.ComboBoxText()
            if setting.default is None:
                widget.append("default", "Device default")
            for choice in setting.choices:
                widget.append(choice, CHOICE_NAMES.get(choice, choice))
            widget.connect("changed", lambda w: w.get_active_id() and self.change(key, w.get_active_id()))
            setter = lambda value: widget.set_active_id(value or "default")
        self.controls[key] = (widget, setter)
        self.quiet = True
        setter(self.value(key))
        self.quiet = False
        return widget

    def slider_changed(self, scale, key):
        """Sent once the slider rests, not for every step."""
        if self.quiet:
            return
        if self.timers.get(key):
            self.ui.GLib.source_remove(self.timers[key])

        def apply():
            self.timers[key] = None
            value = scale.get_value()
            self.change(key, str(int(value)) if isinstance(SETTINGS[key].default, int) else f"{value:.2f}")
            return False

        self.timers[key] = self.ui.GLib.timeout_add(SLIDER_DELAY_MS, apply)

    def change(self, key, text, then=None):
        if self.quiet:
            return

        def done(ok, stdout, stderr):
            messages = [m for m in output_messages(stdout, stderr) if m not in ("Applied.",)]
            self.status.set_text("\n".join(messages))
            self.reload()
            if then:
                then()

        self.ui.run_async([*SELF, "set", key, text], done)

    def show_values(self):
        """Show the saved values (after a change, or a change elsewhere)."""
        self.values = load_values()[0]
        self.quiet = True
        for key, (_widget, setter) in self.controls.items():
            if not self.timers.get(key):
                setter(self.value(key))
        self.quiet = False

    def reload(self):
        """The saved values, and doctor's warnings about user config that hides
        them."""
        self.show_values()
        self.ui.background(doctor_warnings, lambda warnings, _error: self.ui.set_notice(
            self.notice, [w for w in warnings or [] if self.affected_by(w)]), key=(self, "doctor"))

    @staticmethod
    def affected_by(warning):
        return "rc.xml" in warning or "keyboard layout" in warning

    def group(self, title, subtitle, rows):
        self.box.pack_start(self.ui.heading(title), False, False, 0)
        if subtitle:
            self.box.pack_start(self.ui.label(subtitle, dim=True), False, False, 0)
        frame, listbox = self.ui.framed_list()
        for row in rows:
            listbox.add(row)
        self.box.pack_start(frame, False, False, 0)

    def shown(self):
        self.reload()


