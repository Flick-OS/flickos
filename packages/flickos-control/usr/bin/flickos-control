class KeyboardPage(SettingsPage):
    """Keyboard layout (per user, applied at once), repeat and Num Lock; the
    system layout through the helper."""

    def __init__(self, ui):
        super().__init__(ui, _("The layout applies right away to your account. The login screen and the "
                             "console keep the system layout until you change it too."))
        Gtk, row = ui.Gtk, ui.row
        self.rules = xkb_rules()
        self.layouts = Gtk.ComboBoxText()
        self.layouts.set_size_request(300, -1)
        self.layouts.connect("changed", self.layout_chosen)
        self.variants = Gtk.ComboBoxText()
        self.variants.set_size_request(300, -1)
        self.variants.connect("changed", self.variant_chosen)
        self.system_label = ui.label("", dim=True)
        self.system_button = Gtk.Button.new_with_mnemonic(_("_Use for Login Screen and Console…"))
        self.system_button.connect("clicked", self.use_for_system)
        system = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        system.pack_start(self.system_button, False, False, 0)
        try_it = Gtk.Entry(placeholder_text=_("Type here to try the layout"))
        try_it.set_size_request(300, -1)
        self.group(_("Layout"), None, [
            row(_("Layout"), self.layouts), row(_("Variant"), self.variants), row(_("Try it"), try_it),
        ])
        self.system_row = row(_("Login screen and console"), system, "")
        self.group(_("System"), _("Needs an administrator's password. Also on the Login Screen page."),
                   [self.system_row])
        self.group(_("Typing"), None, [
            row(_("Repeat delay"), self.control("keyboard.repeat-delay"), _("How long a key is held before it repeats")),
            row(_("Repeat rate"), self.control("keyboard.repeat-rate")),
            row(_("Num Lock on"), self.control("keyboard.numlock"), _("When you log in")),
        ])
        self.box.pack_start(self.status, False, False, 0)
        self.fill_layouts()

    def layout_name(self, layout, variant=""):
        return xkb_layout_name(self.rules, layout, variant)

    def fill_layouts(self):
        """The lists show the saved choice; "Same as the system" is no choice."""
        system = system_keyboard()
        chosen = self.values.get("keyboard.layout")
        layout, variant = your_layout(self.values, system)
        self.quiet = True
        self.layouts.remove_all()
        self.layouts.append("default", _("Same as the system: {value}").format(
            value=self.layout_name(system["layout"])))
        for layout_id, name in sorted(self.rules["layout"].items(), key=lambda item: item[1].lower()):
            self.layouts.append(layout_id, name)
        self.layouts.set_active_id(chosen or "default")
        self.variants.remove_all()
        self.variants.append("", self.layout_name(layout))
        for variant_id, name in sorted(self.rules["variant"].get(layout, {}).items(), key=lambda i: i[1].lower()):
            self.variants.append(variant_id, name)
        self.variants.set_active_id(variant if variant in self.rules["variant"].get(layout, {}) else "")
        self.quiet = False
        in_use = (layout, variant)
        on_system = (system["layout"], system["variant"])
        # Translators: what the system uses now: "Now: English (US)".
        self.ui.set_subtitle(self.system_row, _("Now: {value}").format(value=self.layout_name(*on_system)))
        self.system_button.set_sensitive(in_use != on_system and "," not in system["layout"])
        self.system_button.set_tooltip_text(None if in_use != on_system else _("The system already uses this layout."))

    def layout_chosen(self, combo):
        if not self.quiet and combo.get_active_id():
            self.change("keyboard.layout", combo.get_active_id())

    def variant_chosen(self, combo):
        if not self.quiet and combo.get_active_id() is not None:
            self.change("keyboard.variant", combo.get_active_id() or "default")

    def use_for_system(self, _button):
        self.system_button.set_sensitive(False)
        use_layout_for_system(self.ui, self.values, self.status, self.reload)

    def reload(self):
        super().reload()
        self.fill_layouts()

    @staticmethod
    def affected_by(warning):
        return "keyboard layout" in warning or "rc.xml" in warning


class AppsPage:
    """Default apps: xdg-mime for file types, xdg-terminal-exec's list for
    the terminal. Super+B, Super+E, Super+Enter and the menu follow them."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label(_("The apps that open web links, folders and files, and the terminal. "
                                "Super+B, Super+E, Super+Enter and the menu use them too.")), False, False, 0)
        frame, listbox = ui.framed_list()
        self.combos = {}
        for app_id, name, types in DEFAULT_APPS:
            combo = Gtk.ComboBoxText()
            combo.set_size_request(300, -1)
            combo.connect("changed", self.chosen, app_id)
            self.combos[app_id] = (combo, types)
            listbox.add(ui.row(name, combo))
        self.terminal = Gtk.ComboBoxText()
        self.terminal.set_size_request(300, -1)
        self.terminal.connect("changed", self.terminal_chosen)
        listbox.add(ui.row(_("Terminal"), self.terminal))
        box.pack_start(frame, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def read(self):
        """For each file type: (default app id or None, [(id, name)]); the
        terminals [(id, name)] and the default one. GIO reads every app's
        desktop file, which takes a while the first time."""
        Gio = self.ui.Gio
        defaults = {}
        for app_id, (_combo, types) in self.combos.items():
            current = Gio.AppInfo.get_default_for_type(types[0], False)
            # get_all_for_type() reads mimeinfo.cache (update-desktop-database);
            # apps in a folder without one only say so in their MimeType=.
            candidates = list(Gio.AppInfo.get_all_for_type(types[0])) + [
                app for app in Gio.AppInfo.get_all() if types[0] in (app.get_supported_types() or [])]
            apps = {app.get_id(): app.get_display_name() for app in candidates
                    if app.get_id() and app.should_show()}
            current_id = current.get_id() if current is not None else None
            if current_id:
                apps.setdefault(current_id, current.get_display_name())
            defaults[app_id] = (current_id, sorted(apps.items(), key=lambda item: item[1].lower()))
        terminals = {}
        for app in Gio.AppInfo.get_all():
            if isinstance(app, Gio.DesktopAppInfo) and "TerminalEmulator" in (app.get_categories() or "").split(";") \
                    and not app.get_nodisplay():
                terminals[app.get_id()] = app.get_display_name()
        return defaults, sorted(terminals.items(), key=lambda item: item[1].lower()), default_terminal(terminals)

    def fill(self):
        self.ui.background(self.read, self.show_apps, key=(self, "read"))

    def show_apps(self, result, error):
        if error:
            self.status.set_text(error)
            return
        defaults, terminals, terminal = result
        self.quiet = True
        for app_id, (combo, _types) in self.combos.items():
            current_id, apps = defaults[app_id]
            combo.remove_all()
            for candidate_id, name in apps:
                combo.append(candidate_id, name)
            if current_id is None:
                combo.prepend("", _("None chosen"))
            combo.set_active_id(current_id or "")
        self.terminal.remove_all()
        for app_id, name in terminals:
            self.terminal.append(app_id, name)
        self.terminal.set_active_id(terminal or "")
        self.quiet = False

    def chosen(self, combo, category):
        app_id = combo.get_active_id()
        if self.quiet or not app_id:
            return

        def done(ok, stdout, stderr):
            self.status.set_text("" if ok else "\n".join(output_messages(stdout, stderr)) or _("Not changed."))
            self.fill()

        self.ui.run_async([*SELF, "default-app", "set", category, app_id], done)

    def terminal_chosen(self, combo):
        self.chosen(combo, "terminal")

    def shown(self):
        self.fill()


class IdlePage(SettingsPage):
    """Lock and suspend times (flickos-control idle, swayidle)."""

    def __init__(self, ui):
        super().__init__(ui, _("When the computer is not used for a while, the screen is locked and later the "
                             "computer goes to sleep."))
        if live_session():
            self.box.pack_start(ui.label(_("Not in the live session: locking or sleeping there could interrupt "
                                         "an installation."), dim=True), False, False, 0)
        self.group(_("When idle"), None, [
            ui.row(_("Lock the screen after"), self.control("idle.lock-after")),
            ui.row(_("Sleep after"), self.control("idle.suspend-after")),
        ])
        lock_now = ui.Gtk.Button.new_with_mnemonic(_("_Lock Now"))
        lock_now.connect("clicked", lambda _b: ui.start_app([*SELF, "lock"]))
        self.group(_("Lock screen"), None, [
            ui.row(_("Lock before sleep"), self.control("idle.lock-before-sleep"),
                   _("Turned off, the computer wakes up without asking for the password")),
            ui.row(_("Background"), self.control("lock.background")),
            ui.row(_("Lock the screen now"), lock_now, _("Also Super+L")),
        ])
        # Power button and lid: logind's, for everyone (the helper's power verb).
        self.power = {}
        rows = []
        lid = has_lid()
        for setting, _skip, title, actions in POWER_SETTINGS:
            if setting.startswith("lid") and not lid:
                continue
            combo = ui.Gtk.ComboBoxText()
            combo.set_size_request(240, -1)
            for action in actions:
                # No swayidle to lock the screen in the live session.
                if action != "lock" or not live_session():
                    combo.append(action, POWER_ACTIONS[action])
            combo.connect("changed", self.power_chosen, setting)
            combo.set_sensitive(False)          # until logind's values are read
            self.power[setting] = combo
            rows.append(ui.row(title, combo))
        self.group(_("Buttons and lid"), _("For everyone who uses this computer. Changing these needs an "
                                      "administrator's password."), rows)
        self.box.pack_start(self.status, False, False, 0)

    def power_chosen(self, combo, setting):
        action = combo.get_active_id()
        if self.quiet or not action:
            return
        self.status.set_text(_("Waiting for the password…"))

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.read_power()

        self.ui.run_async([*SELF, "system", f"power.{setting}", action], done)

    def read_power(self):
        def show(state, error):
            if error:
                self.status.set_text(error)
                return
            self.quiet = True
            for setting, combo in self.power.items():
                action = state.get(setting, "")
                if action not in [row[1] for row in combo.get_model()]:
                    combo.append(action, POWER_ACTIONS.get(action, action))
                combo.set_active_id(action)
                combo.set_sensitive(True)
            self.quiet = False

        self.ui.background(power_state, show, key=(self, "power"))

    def reload(self):
        super().reload()
        self.read_power()

    @staticmethod
    def affected_by(warning):
        return False


class DisplaysPage(SettingsPage):
    """The screens now and the kept arrangements (`displays save|forget`,
    kanshi profiles; arranging them stays wdisplays' job), and night light
    (flickos-control's own settings)."""

    def __init__(self, ui):
        super().__init__(ui, _("Change the resolution, scale and arrangement of the screens with Arrange "
                             "Screens; such changes last until you log out. Keep an arrangement to get it "
                             "back at every login and whenever the same screens are plugged in."))
        Gtk, box = ui.Gtk, self.box
        box.pack_start(ui.heading(_("Screens now")), False, False, 0)
        frame, self.screens = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        self.state = ui.label("", dim=True)
        box.pack_start(self.state, False, False, 0)
        buttons = Gtk.Box(spacing=12)
        self.arrange = Gtk.Button.new_with_mnemonic(_("_Arrange Screens…"))
        # Translators: {program} is the program's command, wdisplays.
        self.arrange.set_tooltip_text(_("Open Displays ({program})").format(program=ARRANGE[0]))
        self.arrange.set_sensitive(bool(shutil.which(ARRANGE[0])))
        self.arrange.connect("clicked", self.arrange_clicked)
        buttons.pack_start(self.arrange, False, False, 0)
        self.keep = Gtk.Button.new_with_mnemonic(_("_Keep This Arrangement"))
        self.keep.set_sensitive(False)
        self.keep.connect("clicked", self.keep_clicked)
        buttons.pack_start(self.keep, False, False, 0)
        box.pack_start(buttons, False, False, 0)
        box.pack_start(ui.heading(_("Kept arrangements")), False, False, 0)
        frame, self.kept = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        self.group(_("Night light"), _("Warmer colors from sunset to sunrise, timed for the time zone (Date & Time), "
                                  "so evenings are easier on the eyes."), [
            ui.row(_("Night light"), self.control("night-light.enabled")),
            ui.row(_("Warmth"), self.control("night-light.temperature"), _("How warm the colors get at night")),
        ])
        box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        return bool(shutil.which("wlr-randr") and shutil.which("kanshi"))

    def arrange_clicked(self, _button):
        """wdisplays; the page shows its changes once it is closed."""
        Gio = self.ui.Gio
        try:
            process = Gio.Subprocess.new([*SELF, DISPLAYS, "arrange"], Gio.SubprocessFlags.NONE)
        except self.ui.GLib.Error as error:
            self.status.set_text(error.message)
            return

        def closed(process, result):
            with contextlib.suppress(self.ui.GLib.Error):
                process.wait_finish(result)
            self.shown()

        process.wait_async(None, closed)

    def run(self, command, waiting):
        self.keep.set_sensitive(False)
        self.status.set_text(waiting)

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.shown()

        self.ui.run_async(command, done)

    def keep_clicked(self, _button):
        self.run([*SELF, DISPLAYS, "save"], _("Keeping…"))

    def forget(self, name):
        self.run([*SELF, DISPLAYS, "forget", name], _("Forgetting…"))

    def reload(self):
        """The screens (the notice is about another kanshi, not doctor's)."""
        self.show_values()
        self.controls["night-light.temperature"][0].set_sensitive(self.value("night-light.enabled"))

        def read():
            return read_screens(), read_profiles(), display_daemons()[1]

        self.ui.background(read, self.show, key=(self, "read"))

    def show(self, result, error):
        for listbox in (self.screens, self.kept):
            for child in listbox.get_children():
                listbox.remove(child)
        if error:
            self.status.set_text(error)
            self.keep.set_sensitive(False)
            return
        screens, profiles, others = result
        for screen in screens:
            title, details = describe_screen(screen)
            self.screens.add(self.ui.row(title, None, details))
        name, text = screens_profile(screens)
        kept = {profile: profile_text for profile, _skip, profile_text in profiles}
        overlaps = overlapping_screens(screens)
        if overlaps:
            state = overlap_message(overlaps)
        elif name not in kept:
            state = _("Not kept: this arrangement lasts until you log out.")
        elif kept[name] == text:
            state = _("Kept: these screens are set up this way whenever they are connected.")
        else:
            state = _("Kept, but changed since: keep it again to use it from now on.")
        self.state.set_text(state)
        self.keep.set_sensitive(bool(screens) and not overlaps and kept.get(name) != text)
        for profile, title, _skip in profiles:
            forget = self.ui.Gtk.Button.new_with_label(_("Forget"))
            forget.connect("clicked", lambda _b, p=profile: self.forget(p))
            self.kept.add(self.ui.row(title, forget, _("The screens connected now") if profile == name else None))
        if not profiles:
            self.kept.add(self.ui.row(_("None yet"), None, _("Each screen starts with its own best resolution.")))
        self.screens.show_all()
        self.kept.show_all()
        self.ui.set_notice(self.notice, [_("Another kanshi is running (your own setup), so FlickOS doesn't start "
                                         "its own; the arrangements kept here apply when it isn't running.")]
                           if others else [])


def format_example(formats, numbers):
    """Today's date and time and a number, as the formats show them."""
    def output(command, locale):
        with contextlib.suppress(OSError, subprocess.TimeoutExpired):
            result = subprocess.run(command, capture_output=True, text=True, timeout=COMMAND_SECONDS, check=False,
                                    env=dict(os.environ, LC_ALL=locale))
            return result.stdout.strip() if result.returncode == 0 else ""
        return ""

    parts = [output(["date", "+%x %X"], formats), output(["printf", "%'.2f", "1234567.89"], numbers)]
    return "   ".join(part for part in parts if part)


def use_language_for_system(ui, system, values, status, then):
    """This account's language and formats for the login screen and new
    accounts (the helper's `locale`, which asks for the password): Language &
    Region's and Login Screen's button."""
    args = your_locale_args(system, values)
    if args is None:
        then()
        return
    status.set_text(_("Waiting for the password…"))

    def done(ok, stdout, stderr):
        messages = output_messages(stdout, stderr)
        status.set_text(_("The login screen uses it from its next start, accounts without a choice of "
                          "their own from their next login.") if ok else
                        "\n".join(messages) or _("The system language was not changed."))
        then()

    ui.run_async(["pkexec", HELPER, "locale", *args], done)


def use_layout_for_system(ui, values, status, then):
    """This account's keyboard layout for the login screen and the console
    (`system keyboard.system`): Keyboard's and Login Screen's button."""
    status.set_text(_("Waiting for the password…"))

    def done(ok, stdout, stderr):
        messages = output_messages(stdout, stderr)
        if not ok and not messages:
            messages = [_("The system layout was not changed.")]
        status.set_text("\n".join(messages))
        then()

    ui.run_async([*SELF, "system", "keyboard.system", layout_value(*your_layout(values, system_keyboard()))], done)


class RegionPage(SettingsPage):
    """Language and formats of this account (LANG and LC_* in the labwc
    environment, `flickos-control set locale.*`), the system's and adding
    a locale that isn't generated yet (locale-gen) through the helper."""

    def __init__(self, ui):
        super().__init__(ui, _("The language of menus and apps, and how dates, times, numbers and money look. "
                             "Apps you open from now on use them; the panel and the apps already open use "
                             "them after you log out and in again."))
        Gtk, row = ui.Gtk, ui.row
        self.names = {}             # locale_key -> (locale, name), read the first time
        self.installed = set()
        self.system = {}
        self.language = Gtk.ComboBoxText()
        self.formats = Gtk.ComboBoxText()
        for key, combo in (("locale.language", self.language), ("locale.formats", self.formats)):
            combo.set_size_request(300, -1)
            combo.set_sensitive(False)          # until the names are read
            combo.connect("changed", self.chosen, key)
        self.example = ui.label("", dim=True, wrap=False)
        self.system_button = Gtk.Button.new_with_mnemonic(_("_Use for the Whole System…"))
        self.system_button.set_sensitive(False)
        self.system_button.connect("clicked", self.use_for_system)
        self.group(_("Your account"), None, [
            row(_("Language"), self.language), row(_("Formats"), self.formats), row(_("Example"), self.example),
        ])
        self.system_row = row(_("Login screen and new accounts"), self.system_button, "")
        self.group(_("System"), _("Needs an administrator's password. Also on the Login Screen page."),
                   [self.system_row])
        self.box.pack_start(ui.label(_("Some apps bring their translations in a package of their own, for example "
                                     "Firefox (firefox-esr-l10n-…) and LibreOffice (libreoffice-l10n-…)."),
                                     dim=True), False, False, 0)
        self.box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        return os.path.isfile(I18N_SUPPORTED)

    def name(self, locale):
        return self.names.get(locale_key(locale), (locale, locale_name(locale)))[1]

    def read(self):
        names = self.names or {locale_key(locale): (locale, locale_name(locale)) for locale in supported_locales()}
        system = system_locale()
        env = dict(locale_environment(self.values, True, system))
        return names, installed_locales(), system, format_example(env.get("LC_TIME", ""), env.get("LC_NUMERIC", ""))

    def reload(self):
        super().reload()
        self.ui.background(self.read, self.fill, key=(self, "read"))

    def fill(self, result, error):
        if error:
            self.status.set_text(error)
            return
        self.names, self.installed, self.system, example = result
        by_name = sorted(self.names.values(), key=lambda item: item[1].casefold())
        self.quiet = True
        for key, combo, default in (
                ("locale.language", self.language,
                 _("Same as the system: {value}").format(value=self.name(self.system.get("LANG", "C")))),
                ("locale.formats", self.formats,
                 _("Same as the system: {value}").format(value=self.name(self.system["LC_TIME"]))
                 if self.system.get("LC_TIME") else _("Same as the language"))):
            chosen = self.values.get(key)
            combo.remove_all()
            combo.append("default", default)
            for locale, name in by_name:
                combo.append(locale, name)
            if chosen and not combo.set_active_id(self.names.get(locale_key(chosen), (chosen,))[0]):
                combo.append(chosen, self.name(chosen))
                combo.set_active_id(chosen)
            if not chosen:
                combo.set_active_id("default")
            combo.set_sensitive(True)
        self.quiet = False
        self.example.set_text(example)
        self.system_button.set_sensitive(your_locale_args(self.system, self.values) is not None)
        self.ui.set_subtitle(self.system_row, _("Now: {value}").format(value=system_language_name(self.system)))

    def chosen(self, combo, key):
        locale = combo.get_active_id()
        if self.quiet or not locale:
            return
        if locale == "default" or locale_key(locale) in self.installed:
            self.change(key, locale)
            return
        self.status.set_text(_("Adding {language}: this needs an administrator's password and takes a "
                               "moment…").format(language=self.name(locale)))
        for widget in (self.language, self.formats):
            widget.set_sensitive(False)

        def done(ok, stdout, stderr):
            if ok:
                self.installed.add(locale_key(locale))
                record(f"language.{locale}", "absent", "added")
                fire_changed()          # added now (hooks, ADR-007)
                self.change(key, locale)
                return
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) or _("{language} was not added.").format(language=self.name(locale)))
            self.reload()

        self.ui.run_async(["pkexec", HELPER, "locale-add", locale], done)

    def use_for_system(self, _button):
        self.system_button.set_sensitive(False)
        use_language_for_system(self.ui, self.system, self.values, self.status, self.reload)

    @staticmethod
    def affected_by(warning):
        return "environment" in warning


class NotificationsPage(SettingsPage):
    """Do Not Disturb: mako's mode (flickos-control set notifications.*), and
    the volume and brightness ring (osd.enabled)."""

    def __init__(self, ui):
        super().__init__(ui, _("Notifications appear at the edge of the screen for a few seconds. Click one to "
                             "close it."))
        self.group(_("Do Not Disturb"), None, [
            ui.row(_("Do Not Disturb"), self.control("notifications.do-not-disturb"),
                   _("Notifications are not shown, except urgent ones such as a nearly empty battery. "
                   "It stays on until you turn it off.")),
        ])
        self.group(_("Volume and Brightness"), None, [
            ui.row(_("Show the level"), self.control("osd.enabled"),
                   _("A ring shows the new level for a moment when you press a volume, microphone or "
                   "brightness key.")),
        ])
        self.box.pack_start(self.status, False, False, 0)

    def reload(self):
        """The notice is about the user's own mako config, not doctor's."""
        self.show_values()
        problem = mako_config_problem()
        self.ui.set_notice(self.notice, [problem] if problem else [])


class AccessibilityPage(SettingsPage):
    """Screen zoom: labwc's magnifier (flickos-control set zoom.*). Its keys
    are flickos-settings' and only shown here. Animations: GSettings'
    enable-animations (flickos-control animations). Window shadows: labwc's
    <dropShadows> (flickos-control set windows.shadows)."""

    def __init__(self, ui):
        super().__init__(ui, _("Zoom in to see small things larger: Super+= zooms in and Super+- zooms out, "
                             "or hold Super and scroll. Super+0 turns zoom off, and back on."))
        self.group(_("Zoom"), None, [
            ui.row(_("Zoom"), self.control("zoom.area"), _("The part of the screen that zooms follows the pointer")),
            ui.row(_("Lens size"), self.control("zoom.lens-size")),
            ui.row(_("Zoom step"), self.control("zoom.step"), _("How much each key press or scroll zooms")),
            ui.row(_("Smooth"), self.control("zoom.smooth"), _("Off shows sharp square pixels")),
        ])
        Gtk = ui.Gtk
        self.animations = Gtk.Switch(valign=Gtk.Align.CENTER, sensitive=False)   # until it is read
        self.animations.connect("notify::active", self.animations_switched)
        self.animations_quiet = False
        self.group(_("Effects"), None, [
            ui.row(_("Animations"), self.animations,
                   _("The start menu and other pop-ups fade in and out, and apps animate their controls. "
                   "Off shows everything at once")),
            ui.row(_("Window shadows"), self.control("windows.shadows"),
                   _("A soft shadow shows which window is in front. Off can help on an old computer")),
        ])
        self.box.pack_start(self.status, False, False, 0)
        self.show_lens_size()

    def shown(self):
        super().shown()
        self.ui.background(animations, self.show_animations, key=(self, "animations"))

    def show_animations(self, value, error):
        self.animations_quiet = True
        self.animations.set_active(value == "on")
        self.animations.set_sensitive(error is None)
        self.animations_quiet = False
        if error:
            self.status.set_text(error)

    def animations_switched(self, switch, _param):
        if self.animations_quiet:
            return

        def done(_ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(m for m in messages if not m.startswith("Animations:")))
            self.ui.background(animations, self.show_animations, key=(self, "animations"))

        self.ui.run_async([*SELF, "animations", "set", "on" if switch.get_active() else "off"], done)

    def show_values(self):
        super().show_values()
        self.show_lens_size()

    def show_lens_size(self):
        self.controls["zoom.lens-size"][0].set_sensitive(self.value("zoom.area") == "lens")

    @staticmethod
    def affected_by(warning):
        return "rc.xml" in warning


class StartupPage:
    """Startup applications (`flickos-control startup`): XDG autostart entries,
    on or off, the user's own added or removed."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label(_("Apps that start when you log in. An app you tell to start with the desktop "
                                "in its own settings appears here too. Changes apply from the next login.")),
                       False, False, 0)
        frame, self.rows = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        add = Gtk.Button.new_with_mnemonic(_("_Add App…"))
        add.set_halign(Gtk.Align.START)
        add.connect("clicked", self.add_clicked)
        box.pack_start(add, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def run(self, command):
        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.shown()

        self.ui.run_async(command, done)

    def add_clicked(self, _button):
        Gtk = self.ui.Gtk
        dialog = Gtk.Dialog(title=_("Add a Startup App"), transient_for=self.widget.get_toplevel(), modal=True)
        dialog.add_buttons(_("_Cancel"), Gtk.ResponseType.CANCEL, _("_Add"), Gtk.ResponseType.OK)
        dialog.set_default_size(460, 520)
        chooser = Gtk.AppChooserWidget(content_type="application/octet-stream", show_all=True,
                                       show_default=False, show_recommended=False, show_fallback=False,
                                       show_other=False)
        chooser.connect("application-activated", lambda *_skip: dialog.response(Gtk.ResponseType.OK))
        dialog.get_content_area().pack_start(chooser, True, True, 0)
        dialog.show_all()
        response = dialog.run()
        app = chooser.get_app_info()
        dialog.destroy()
        if response == Gtk.ResponseType.OK and app is not None and app.get_id():
            self.run([*SELF, "startup", "add", app.get_id()])

    def switched(self, switch, _param, entry_id):
        if not self.quiet:
            self.run([*SELF, "startup", "enable" if switch.get_active() else "disable", entry_id])

    def shown(self):
        self.ui.background(startup_entries, self.show, key=(self, "read"))

    def show(self, entries, error):
        Gtk = self.ui.Gtk
        for child in self.rows.get_children():
            self.rows.remove(child)
        if error:
            self.status.set_text(error)
            return
        self.quiet = True
        for entry in entries:
            widgets = Gtk.Box(spacing=12)
            if not entry.system:
                remove = Gtk.Button.new_with_label(_("Remove"))
                remove.connect("clicked", lambda _b, e=entry.id: self.run([*SELF, "startup", "remove", e]))
                widgets.pack_start(remove, False, False, 0)
            switch = Gtk.Switch(active=entry.enabled, valign=Gtk.Align.CENTER)
            switch.connect("notify::active", self.switched, entry.id)
            widgets.pack_start(switch, False, False, 0)
            self.rows.add(self.ui.row(entry.name, widgets, entry.comment or " ".join(
                shlex.quote(word) for word in exec_argv_or_none(entry) or [])))
        if not entries:
            self.rows.add(self.ui.row(_("None"), None, _("Only the desktop itself starts at login.")))
        self.quiet = False
        self.rows.show_all()


def exec_argv_or_none(entry):
    with contextlib.suppress(ControlError):
        return exec_argv(entry.entry, entry.path)
    return None


class MediaPage:
    """Media controls in the panel, the sound spectrum, its shape, where it
    shows and its colors (flickos-media). It owns none of them: `state` reads them and `set`
    changes them. The spectrum's rows can change only while the controls are
    on: its button is in the controls. The ring is always behind windows, so
    the layer row waits while it is chosen."""

    KEYS = ("controls", "spectrum", "spectrum-shape", "spectrum-layer", "spectrum-colors")
    ON = {"controls": "on", "spectrum": "on", "spectrum-layer": "top", "spectrum-shape": "radial",
          "spectrum-colors": "rainbow"}
    OFF = {"controls": "off", "spectrum": "off", "spectrum-layer": "behind", "spectrum-shape": "strip",
           "spectrum-colors": "style"}

    def __init__(self, ui):
        self.ui = ui
        self.widget, box = ui.page()
        self.quiet = False
        self.switches, self.rows = {}, {}
        box.pack_start(ui.label(_("Changes apply right away.")), False, False, 0)
        frame, rows = ui.framed_list()
        for key, title, subtitle in (
                ("controls", _("Media controls in the panel"),
                 _("Previous, play and next, and the title of what is playing, while an app plays music or "
                 "video.")),
                ("spectrum", _("Sound spectrum"),
                 _("Bars just above the panel that move with the sound while something plays. They use about "
                 "6 % of a processor while they show. The bars button in the panel turns them on and off "
                 "too.")),
                ("spectrum-shape", _("Show the spectrum in the middle of the screen"),
                 _("As bars around a ring, instead of above the panel. It is always behind windows and clicks go "
                 "through it. It uses a little more of the processor than the bars above the panel.")),
                ("spectrum-layer", _("Show the spectrum over windows"),
                 _("Instead of behind them; a full-screen window still covers it. Clicks go through it. A right "
                 "click on the bars button in the panel switches it too. Only for the bars above the panel.")),
                ("spectrum-colors", _("Rainbow colors"),
                 _("Every color instead of the style's: round the ring from cyan at the top to red at the "
                 "bottom, or along the bars from the left, with a white ring."))):
            switch = ui.Gtk.Switch()
            switch.connect("notify::active", self.toggled, key)
            row = ui.row(title, switch, subtitle)
            rows.add(row)
            self.switches[key], self.rows[key] = switch, row
        box.pack_start(frame, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)
        self.set_sensitive(False)

    @staticmethod
    def available():
        return shutil.which(MEDIA) is not None

    def shown(self):
        def read():
            try:
                state = json.loads(run([MEDIA, "state"]))
            except ValueError:
                raise ControlError(_("flickos-media gave no settings")) from None
            if not isinstance(state, dict):
                raise ControlError(_("flickos-media gave no settings"))
            return state

        self.ui.background(read, self.show, key=(self, "state"))

    def show(self, state, error):
        self.loading.hide()
        if error:
            self.status.set_text(error)
            return
        self.quiet = True
        for key in self.KEYS:
            self.switches[key].set_active((state.get(key) or {}).get("value") == self.ON[key])
        # flickos-media before 1.6 has no colors.
        self.rows["spectrum-colors"].set_visible("spectrum-colors" in state)
        self.quiet = False
        self.set_sensitive(True)

    def set_sensitive(self, ready):
        controls = self.switches["controls"].get_active()
        self.rows["controls"].set_sensitive(ready)
        for key in ("spectrum", "spectrum-shape", "spectrum-colors"):
            self.rows[key].set_sensitive(ready and controls)
        strip = not self.switches["spectrum-shape"].get_active()
        self.rows["spectrum-layer"].set_sensitive(ready and controls and strip)

    def toggled(self, switch, _param, key):
        if self.quiet:
            return
        self.set_sensitive(False)
        value = self.ON[key] if switch.get_active() else self.OFF[key]

        def done(ok, stdout, stderr):
            self.status.set_text("" if ok else "\n".join(output_messages(stdout, stderr)))
            self.shown()

        self.ui.run_async([MEDIA, "set", key, value], done)


def weather_place_name(value):
    """The name in flickos-weather's place value LAT,LON,NAME, or ""."""
    parts = value.split(",", 2)
    return parts[2].strip() if len(parts) == 3 else ""


class WeatherPage:
    """The weather in the panel, its place and units (flickos-weather). It owns
    none of them: `state` reads them, `set` changes them, and `find` searches
    places, which asks the weather service, so only when the user searches
    (docs/design/flickos-weather.md). The place can be chosen before the
    weather is turned on."""

    def __init__(self, ui):
        Gtk = ui.Gtk
        self.ui = ui
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label(_("Changes apply right away.")), False, False, 0)
        frame, rows = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.toggled)
        self.switch_row = ui.row(_("Weather in the panel"), self.switch,
                                 _("The temperature and the sky where you are. Point at it for the next hours and "
                                 "days; click it to come here."))
        rows.add(self.switch_row)
        self.place_row = ui.row(_("Place"), None, "")
        rows.add(self.place_row)
        self.units = Gtk.ComboBoxText()
        for key, name in WEATHER_UNITS:
            self.units.append(key, name)
        self.units.connect("changed", self.units_changed)
        self.units_row = ui.row(_("Temperature"), self.units, "")
        rows.add(self.units_row)
        self.wind = Gtk.ComboBoxText()
        for key, name in WEATHER_WIND:
            self.wind.append(key, name)
        self.wind.connect("changed", self.wind_changed)
        self.wind_row = ui.row(_("Wind speed"), self.wind, "")
        rows.add(self.wind_row)
        box.pack_start(frame, False, False, 0)

        box.pack_start(ui.heading(_("Find your town or city")), False, False, 0)
        search = Gtk.Box(spacing=8)
        self.entry = Gtk.SearchEntry(placeholder_text=_("Town or city"))
        self.entry.get_accessible().set_name(_("Town or city"))
        self.entry.connect("activate", self.find)
        self.find_button = Gtk.Button(label=_("Find"))
        self.find_button.connect("clicked", self.find)
        search.pack_start(self.entry, True, True, 0)
        search.pack_start(self.find_button, False, False, 0)
        box.pack_start(search, False, False, 0)
        self.found_frame, self.found = ui.framed_list()
        self.found_frame.set_no_show_all(True)
        box.pack_start(self.found_frame, False, False, 0)

        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)
        self.privacy = ui.label("", dim=True)
        box.pack_start(self.privacy, False, False, 0)
        self.set_sensitive(False)

    @staticmethod
    def available():
        return shutil.which(WEATHER) is not None

    def shown(self):
        def read():
            try:
                state = json.loads(run([WEATHER, "state"]))
            except ValueError:
                raise ControlError(_("flickos-weather gave no settings")) from None
            if not isinstance(state, dict):
                raise ControlError(_("flickos-weather gave no settings"))
            return state

        self.ui.background(read, self.show, key=(self, "state"))

    def show(self, state, error):
        self.loading.hide()
        if error:
            self.status.set_text(error)
            return
        self.quiet = True
        self.switch.set_active((state.get("enabled") or {}).get("value") == "on")
        units = state.get("units") or {}
        self.units.set_active_id(units.get("value") or "auto")
        wind = state.get("wind") or {}
        self.wind.set_active_id(wind.get("value") or "auto")
        self.quiet = False
        name = (state.get("place") or {}).get("name") or ""
        self.ui.set_subtitle(self.place_row, name or _("None chosen yet: find yours below"))
        resolved = _("°F") if units.get("resolved") == "fahrenheit" else _("°C")
        self.ui.set_subtitle(self.units_row, _("Automatic follows your region: {units} here").format(units=resolved)
                             if units.get("value") == "auto" else "")
        wind_names = dict(WEATHER_WIND)
        self.ui.set_subtitle(self.wind_row, _("Automatic follows the temperature: {unit} here").format(
            unit=wind_names.get(wind.get("resolved"), "")) if wind.get("value") == "auto" else "")
        self.status.set_text(self.update_text(state))
        import urllib.parse
        host = urllib.parse.urlsplit(state.get("server") or "").hostname or _("the weather service")
        service = "Open-Meteo.com" if host.endswith("open-meteo.com") else host
        # Translators: {service} is the weather service's name, such as Open-Meteo.com.
        privacy = _("While the weather is on, this computer asks {service} for the forecast once an hour. It "
                    "sends only the place's position, to about 1 km; like any request, it comes from your internet "
                    "address. Finding a place sends what you type. Nothing is sent while it is off.").format(
                        service=service)
        if service == "Open-Meteo.com":
            privacy += " " + _("Weather data by Open-Meteo.com (CC BY 4.0).")
        self.privacy.set_text(privacy)
        self.set_sensitive(True)

    @staticmethod
    def update_text(state):
        if state.get("error"):
            return _("The forecast couldn't be updated: {error}").format(error=state["error"])
        try:
            updated = datetime.datetime.fromisoformat(state.get("updated") or "")
        except ValueError:
            return ""
        return _("Forecast updated at {time}.").format(time=updated.strftime("%H:%M"))

    def set_sensitive(self, ready):
        for widget in (self.switch_row, self.units_row, self.wind_row, self.entry, self.find_button):
            widget.set_sensitive(ready)

    def change(self, key, value):
        self.set_sensitive(False)

        def done(ok, stdout, stderr):
            self.status.set_text("" if ok else "\n".join(output_messages(stdout, stderr)))
            self.shown()

        self.ui.run_async([WEATHER, "set", key, value], done)

    def toggled(self, switch, _param):
        if not self.quiet:
            self.change("enabled", "on" if switch.get_active() else "off")

    def units_changed(self, combo):
        if not self.quiet and combo.get_active_id():
            self.change("units", combo.get_active_id())

    def wind_changed(self, combo):
        if not self.quiet and combo.get_active_id():
            self.change("wind", combo.get_active_id())

    def find(self, _widget):
        text = " ".join(self.entry.get_text().split())
        if len(text) < 2:
            self.status.set_text(_("Type at least two letters of the place."))
            return
        self.find_button.set_sensitive(False)
        self.status.set_text(_("Finding…"))

        def read():
            try:
                places = json.loads(run([WEATHER, "find", "--json", text]))
            except ValueError:
                raise ControlError(_("flickos-weather gave no places")) from None
            return places if isinstance(places, list) else []

        self.ui.background(read, self.show_found, key=(self, "find"))

    def show_found(self, places, error):
        self.find_button.set_sensitive(True)
        for child in self.found.get_children():
            child.destroy()
        if error:
            self.status.set_text(error)
            self.found_frame.hide()
            return
        self.status.set_text("" if places else _("No place of that name. Try the nearest town or city."))
        for place in places:
            if not isinstance(place, dict) or not place.get("value"):
                continue
            button = self.ui.Gtk.Button(label=_("Use"))
            button.connect("clicked", self.use, place["value"])
            self.found.add(self.ui.row(place.get("name") or place["value"], button))
        self.found.show_all()
        self.found_frame.set_visible(bool(places))

    def use(self, _button, value):
        self.found_frame.hide()
        self.entry.set_text("")
        self.change("place", value)


class ScreenshotsPage:
    """Where screenshots and recordings are saved, the pointer, and a
    recording's sound (flickos-screenshot). It owns none of them: `state`
    reads them and `set` changes them. The keys are flickos-shortcuts'."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        self.state = {}
        self.folders = {}
        self.shown_shortcuts = None
        box.pack_start(ui.label(_("A screenshot is saved and copied. A recording is a video. "
                                "These apply to the next one.")), False, False, 0)
        frame, rows = ui.framed_list()
        self.folders["folder"] = self.folder_row(
            rows, "folder", _("Save screenshots in"), _("Save Screenshots In"),
            _("Pictures/Screenshots, unless you choose another folder."))
        self.folders["recordings-folder"] = self.folder_row(
            rows, "recordings-folder", _("Save recordings in"), _("Save Recordings In"),
            _("Videos/Screen Recordings, unless you choose another folder."))
        self.pointer = Gtk.Switch()
        self.pointer.connect("notify::active", self.pointer_toggled)
        rows.add(ui.row(_("Include the pointer"), self.pointer,
                        _("In screenshots. A recording always shows it.")))
        sound_row, self.select_sound = ui.combo_row(
            _("Sound in a recording"), [Item(sound, name) for sound, name in SCREENSHOT_SOUNDS],
            "none", self.choose_sound)
        rows.add(sound_row)
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.heading(_("Screenshot keys")), False, False, 0)
        self.shortcuts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.shortcuts, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def folder_row(self, rows, key, title, dialog_title, subtitle):
        Gtk = self.ui.Gtk
        box = Gtk.Box(spacing=6)
        choose = Gtk.Button.new_with_label(_("Choose…"))
        choose.set_tooltip_text(_("Choose a folder."))
        choose.connect("clicked", self.choose_folder, key, dialog_title)
        usual = Gtk.Button.new_with_label(_("Usual Folder"))
        usual.set_tooltip_text(_("The folder FlickOS uses for this computer."))
        usual.connect("clicked", lambda _b, setting=key: self.send(["set", setting, "default"]))
        box.pack_start(choose, False, False, 0)
        box.pack_start(usual, False, False, 0)
        row = self.ui.row(title, box, subtitle)
        rows.add(row)
        return row, usual

    @staticmethod
    def available():
        return shutil.which(SCREENSHOT) is not None

    def shown(self):
        def read():
            try:
                state = json.loads(run([SCREENSHOT, "state"]))
            except ValueError:
                raise ControlError(_("flickos-screenshot gave no settings")) from None
            if not isinstance(state, dict):
                raise ControlError(_("flickos-screenshot gave no settings"))
            try:
                sheet = run([SHORTCUTS, "list"])
            except ControlError as error:
                sheet = error
            return state, sheet

        self.ui.background(read, self.show, key=(self, "state"))

    def show(self, result, error):
        self.loading.hide()
        if error:
            self.status.set_text(error)
            return
        state, sheet = result
        self.state = state
        self.quiet = True
        for key, (row, usual) in self.folders.items():
            item = state.get(key) or {}
            value = item.get("value") or ""
            self.ui.set_subtitle(row, home_folder(value) if value else "")
            usual.set_sensitive(not item.get("default", True))
        pointer = (state.get("pointer") or {}).get("value") == "yes"
        self.pointer.set_active(pointer)
        self.select_sound((state.get("sound") or {}).get("value") or "none")
        self.quiet = False
        self.fill_shortcuts(sheet)

    def fill_shortcuts(self, sheet):
        text = str(sheet)
        if text == self.shown_shortcuts:
            return
        self.shown_shortcuts = text
        for child in self.shortcuts.get_children():
            self.shortcuts.remove(child)
        if isinstance(sheet, ControlError):
            self.ui.error(self.shortcuts, str(sheet))
        else:
            found = [section for section in parse_shortcuts(sheet) if section[0] == "Screenshots"]
            if not found:
                self.shortcuts.pack_start(self.ui.label(_("No screenshot keys are set."), dim=True), False, False, 0)
            for _name, rows in found:
                frame, listbox = self.ui.framed_list()
                for keys, description in rows:
                    listbox.add(self.ui.row(description, self.ui.label(keys, dim=True, wrap=False)))
                self.shortcuts.pack_start(frame, False, False, 0)
        self.shortcuts.show_all()

    def send(self, words):
        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("" if ok else "\n".join(messages))
            self.shown()

        self.ui.run_async([SCREENSHOT, *words], done)

    def pointer_toggled(self, switch, _param):
        if not self.quiet:
            self.send(["set", "pointer", "yes" if switch.get_active() else "no"])

    def choose_sound(self, sound):
        if not self.quiet:
            self.send(["set", "sound", sound])

    def choose_folder(self, _button, key, title):
        Gtk = self.ui.Gtk
        dialog = Gtk.FileChooserDialog(title=title,
                                       transient_for=self.widget.get_toplevel(), modal=True,
                                       action=Gtk.FileChooserAction.SELECT_FOLDER)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        dialog.add_button(_("_Choose"), Gtk.ResponseType.ACCEPT)
        current = (self.state.get(key) or {}).get("value")
        if current and os.path.isdir(current):
            dialog.set_current_folder(current)
        try:
            chosen = dialog.get_filename() if dialog.run() == Gtk.ResponseType.ACCEPT else None
        finally:
            dialog.destroy()
        if chosen:
            self.send(["set", key, chosen])


class UpdatesPage:
    """Automatic updates: unattended-upgrades' settings (read with apt-config,
    changed through the helper's updates verb)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        # flickos-software's daily timer updates Flatpak apps while these are on
        # (its software-update script reads the same apt settings).
        intro = [_("Updates are installed in the background every day, so security fixes arrive without anyone "
                   "having to remember.")]
        if shutil.which("flickos-software"):
            intro.append(_("Apps installed from Flathub are updated with them."))
        intro.append(_("Software Updates shows and installs every update at any time."))
        box.pack_start(ui.label(" ".join(intro)), False, False, 0)
        frame, listbox = ui.framed_list()
        self.auto = Gtk.Switch()
        self.auto.connect("notify::active", lambda w, _p: self.change("auto", "yes" if w.get_active() else "no"))
        self.auto_row = ui.row(_("Install updates automatically"), self.auto, "")
        listbox.add(self.auto_row)
        self.scope = Gtk.ComboBoxText()
        self.reboot = Gtk.ComboBoxText()
        for combo, names, setting in ((self.scope, UPDATE_SCOPE_NAMES, "scope"),
                                      (self.reboot, UPDATE_REBOOT_NAMES, "reboot")):
            combo.set_size_request(300, -1)
            # "custom" and restarting while someone is logged in only show
            # when an administrator set them, an old scope while it is set.
            for key, name in names.items():
                if key not in ("custom", "always", *OLD_UPDATE_SCOPES):
                    combo.append(key, name)
            combo.connect("changed", lambda w, setting=setting: w.get_active_id()
                          and w.get_active_id() not in ("custom", *OLD_UPDATE_SCOPES)
                          and self.change(setting, w.get_active_id()))
        listbox.add(ui.row(_("Which updates"), self.scope))
        listbox.add(ui.row(_("Restart when an update needs it"), self.reboot,
                           _("Some updates (the Linux kernel) take effect after a restart")))
        box.pack_start(frame, False, False, 0)
        # The key of apps bought from the FlickOS store (purchases): for people
        # who already bought, so it names no app and links nowhere.
        key_frame, key_list = ui.framed_list()
        key_buttons = Gtk.Box(spacing=6)
        self.add_key = Gtk.Button.new_with_mnemonic(_("_Add Key…"))
        self.add_key.connect("clicked", self.ask_key)
        self.remove_key = Gtk.Button.new_with_mnemonic(_("_Remove"))
        self.remove_key.connect("clicked", self.ask_remove)
        self.remove_key.set_no_show_all(True)
        key_buttons.pack_start(self.add_key, False, False, 0)
        key_buttons.pack_start(self.remove_key, False, False, 0)
        self.key_row = ui.row(_("Purchased apps"), key_buttons, "")
        key_list.add(self.key_row)
        box.pack_start(key_frame, False, False, 0)
        # Left out while the viewer (gnome-package-updater, a Recommends that
        # upgraded systems may lack) isn't installed; shown() checks again.
        self.buttons = Gtk.Box(spacing=12)
        self.buttons.set_no_show_all(True)
        check = Gtk.Button.new_with_mnemonic(_("_Check for Updates Now…"))
        # Translators: {program} is the program's command, gpk-update-viewer.
        check.set_tooltip_text(_("Open Software Updates ({program})").format(program=UPDATE_VIEWER[0]))
        check.connect("clicked", self.check_now)
        self.check = check
        check.show()
        self.buttons.pack_start(check, False, False, 0)
        box.pack_start(self.buttons, False, False, 0)
        box.pack_start(ui.label(_("Changing these needs an administrator's password."), dim=True), False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)
        for widget in (self.auto, self.scope, self.reboot):
            widget.set_sensitive(False)         # until the settings are read

    @staticmethod
    def available():
        return os.path.exists(UNATTENDED_UPGRADE) and not live_session()

    def check_now(self, _button):
        """Refresh PackageKit's package lists (apt update; no password, polkit
        lets the person at the keyboard), then open the viewer: it shows only
        what the lists held at its last refresh, so without this it misses
        every update published since."""
        Gio, GLib = self.ui.Gio, self.ui.GLib
        self.check.set_sensitive(False)
        self.status.set_text(_("Checking for updates…"))
        finished = []

        def open_viewer(*_args):
            if finished:
                return False
            finished.append(True)
            self.check.set_sensitive(True)
            self.status.set_text("")
            self.ui.start_app(UPDATE_VIEWER)
            return False

        def refresh(bus, result):
            try:
                path = bus.call_finish(result).unpack()[0]
            except GLib.Error as error:
                warn(error.message)
                open_viewer()
                return
            # RefreshCache returns at once; the transaction's Finished signal ends the wait.
            subscription = []

            def signal(_bus, _sender, _path, _iface, _name, _params):
                bus.signal_unsubscribe(subscription[0])
                open_viewer()

            subscription.append(bus.signal_subscribe(
                PACKAGEKIT_NAME, "org.freedesktop.PackageKit.Transaction", "Finished", path, None,
                Gio.DBusSignalFlags.NONE, signal))
            bus.call(PACKAGEKIT_NAME, path, "org.freedesktop.PackageKit.Transaction", "RefreshCache",
                     GLib.Variant("(b)", (True,)), None, Gio.DBusCallFlags.NONE, -1, None,
                     lambda b, r: self.refresh_started(b, r, open_viewer))

        try:
            bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        except GLib.Error as error:
            warn(error.message)
            open_viewer()
            return
        GLib.timeout_add_seconds(UPDATE_REFRESH_SECONDS, open_viewer)
        bus.call(PACKAGEKIT_NAME, "/org/freedesktop/PackageKit", "org.freedesktop.PackageKit",
                 "CreateTransaction", None, GLib.VariantType("(o)"), Gio.DBusCallFlags.NONE, -1, None, refresh)

    @staticmethod
    def refresh_started(bus, result, open_viewer):
        try:
            bus.call_finish(result)
        except Exception as error:      # refused or not running: the viewer still opens
            warn(str(error))
            open_viewer()

    def change(self, setting, value):
        if self.quiet:
            return
        self.status.set_text(_("Waiting for the password…"))

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.shown()

        self.ui.run_async([*SELF, "system", f"updates.{setting}", value], done)

    def show_key(self):
        state = purchases_state()
        if state is None:
            text = _("No key on this computer. The key of apps you bought lets them install and update.")
        elif state.get("status") == "revoked":
            # Translators: {key} is the last four characters of the key, such as qrst.
            text = _("The key ending in {key} was turned off, so the apps bought with it no longer "
                     "update").format(key=state["key"])
        else:
            text = _("Key ending in {key}: the apps bought with it install and update").format(key=state["key"])
        self.ui.set_subtitle(self.key_row, text)
        self.remove_key.set_visible(state is not None)

    def key_done(self, ok, stdout, stderr):
        messages = output_messages(stdout, stderr)
        self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
        self.show_key()

    def ask_key(self, _button):
        Gtk = self.ui.Gtk
        dialog = Gtk.Dialog(title=_("Add Key"), transient_for=self.widget.get_toplevel(), modal=True,
                            resizable=False)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        ok = dialog.add_button(_("_Add"), Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=8, column_spacing=12, margin=18)
        dialog.get_content_area().add(grid)
        entry = Gtk.Entry(activates_default=True, hexpand=True, width_chars=40)
        grid.attach(Gtk.Label(label=_("_Key"), xalign=1, use_underline=True, mnemonic_widget=entry), 0, 0, 1, 1)
        grid.attach(entry, 1, 0, 1, 1)
        hint = self.ui.label(_("The key from the page or the email of your purchase. Adding it needs an "
                             "administrator's password."), dim=True)
        hint.set_max_width_chars(50)
        grid.attach(hint, 1, 1, 1, 1)

        def check(_entry):
            ok.set_sensitive(normal_key(entry.get_text()) is not None)

        entry.connect("changed", check)
        check(entry)
        dialog.show_all()
        response = dialog.run()
        key = normal_key(entry.get_text())
        dialog.destroy()
        if response == Gtk.ResponseType.OK and key:
            self.status.set_text(_("Waiting for the password…"))
            self.ui.run_async([*SELF, "purchases", "add", "--stdin"], self.key_done, key + "\n")

    def ask_remove(self, _button):
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=_("Remove the key?"))
        dialog.format_secondary_text(_("The apps bought with it stay installed but no longer update, and they "
                                     "can't be installed again. Adding the key again needs the key itself, "
                                     "from the page or the email of your purchase."))
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        remove = dialog.add_button(_("_Remove"), Gtk.ResponseType.OK)
        remove.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.status.set_text(_("Waiting for the password…"))
            self.ui.run_async([*SELF, "purchases", "remove"], self.key_done)

    def shown(self):
        self.buttons.set_visible(bool(shutil.which(UPDATE_VIEWER[0])))
        self.show_key()
        self.ui.background(updates_state, self.show, key=(self, "read"))

    def show(self, state, error):
        if error:
            self.status.set_text(error)
            return
        self.quiet = True
        self.auto.set_active(state["auto"])
        for combo, value, names in ((self.scope, state["scope"], UPDATE_SCOPE_NAMES),
                                    (self.reboot, state["reboot"], UPDATE_REBOOT_NAMES)):
            if not combo.set_active_id(value):
                combo.append(value, names.get(value, value))
                combo.set_active_id(value)
        self.auto.set_sensitive(True)
        for combo in (self.scope, self.reboot):
            combo.set_sensitive(state["auto"])
        self.quiet = False
        last = time.strftime("%A %d %B, %H:%M", time.localtime(state["last"])) if state["last"] else _("not yet")
        self.ui.set_subtitle(self.auto_row, _("Last run: {time}").format(time=last))


class DateTimePage:
    """Time zone and network time (timedatectl, with polkit's password dialog)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        self.clock = ui.label("", wrap=False, markup=True)
        box.pack_start(self.clock, False, False, 0)
        frame, listbox = ui.framed_list()
        self.regions = Gtk.ComboBoxText()
        self.regions.set_size_request(200, -1)
        self.regions.connect("changed", self.region_chosen)
        self.cities = Gtk.ComboBoxText()
        self.cities.set_size_request(260, -1)
        self.cities.connect("changed", self.city_chosen)
        self.regions.get_accessible().set_name(_("Time zone region"))
        self.cities.get_accessible().set_name(_("Time zone city"))
        zone_box = Gtk.Box(spacing=6)
        zone_box.pack_start(self.regions, False, False, 0)
        zone_box.pack_start(self.cities, False, False, 0)
        self.zone_row = ui.row(_("Time zone"), zone_box, "")
        listbox.add(self.zone_row)
        self.ntp = Gtk.Switch()
        self.ntp.connect("notify::active", self.ntp_changed)
        self.ntp_row = ui.row(_("Set the time automatically"), self.ntp, "")
        listbox.add(self.ntp_row)
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.label(_("Changing these needs an administrator's password."), dim=True), False, False, 0)
        # The panel clock's hours (flickos-layout clock), for this account.
        self.clock_format = Gtk.ComboBoxText()
        self.clock_format.set_size_request(200, -1)
        self.clock_format.connect("changed", self.clock_chosen)
        clock_frame, clock_list = ui.framed_list()
        self.clock_row = ui.row(_("Time format"), self.clock_format, _("The clock on the panel"))
        clock_list.add(self.clock_row)
        self.clock_frame = clock_frame
        clock_frame.set_no_show_all(True)       # until flickos-layout says it has the choice
        box.pack_start(clock_frame, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)
        self.zones = {}             # read with the settings the first time
        self.twelve_hour = False    # the clock above follows the panel's
        ui.GLib.timeout_add_seconds(1, self.tick)

    def tick(self):
        hours = time.strftime("%I:%M:%S %p" if self.twelve_hour else "%H:%M:%S")
        self.clock.set_markup(f"<big><b>{hours}</b></big>   {time.strftime('%A %d %B %Y')}")
        return True

    def fill_cities(self, region, zone=None):
        self.cities.remove_all()
        for city, name in sorted(self.zones.get(region, [])):
            self.cities.append(name, city)
        if zone:
            self.cities.set_active_id(zone)

    def region_chosen(self, combo):
        if self.quiet:
            return
        self.quiet = True
        self.fill_cities(combo.get_active_id())
        self.quiet = False

    def city_chosen(self, combo):
        zone = combo.get_active_id()
        if self.quiet or not zone:
            return
        self.status.set_text(_("Waiting for the password…"))

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("" if ok else "\n".join(messages) or _("The time zone was not changed."))
            self.shown()

        self.ui.run_async([*SELF, "system", "timezone", zone], done)

    def ntp_changed(self, switch, _param):
        if self.quiet:
            return

        def done(ok, stdout, stderr):
            self.status.set_text("" if ok else "\n".join(output_messages(stdout, stderr)) or _("Not changed."))
            self.shown()

        self.ui.run_async([*SELF, "system", "ntp", "yes" if switch.get_active() else "no"], done)

    def shown(self):
        self.tick()
        need_zones = not self.zones

        def read():
            zones = zones_by_region(run(["timedatectl", "list-timezones"]).split()) if need_zones else None
            return zones, time_settings(run(["timedatectl", "show"]))

        self.ui.background(read, self.show_settings, key=(self, "read"))

        def read_clock():
            try:
                return parse_items(run([LAYOUT, "clock", "list"])), run([LAYOUT, "clock", "current"]).strip()
            except ControlError:
                return None                 # flickos-layouts before 1.20: no choice

        self.ui.background(read_clock, self.show_clock, key=(self, "clock"))

    def show_clock(self, result, error):
        if not result:
            self.clock_frame.hide()
            return
        items, current = result
        self.quiet = True
        self.clock_format.remove_all()
        for item in items:
            self.clock_format.append(item.id, f"{item.name} ({item.comment})" if item.comment else item.name)
        self.clock_format.set_active_id(current)
        self.quiet = False
        self.twelve_hour = current == "12h"
        self.tick()
        self.clock_frame.set_no_show_all(False)
        self.clock_frame.show_all()

    def clock_chosen(self, combo):
        choice = combo.get_active_id()
        if self.quiet or not choice:
            return

        def done(ok, stdout, stderr):
            self.status.set_text("" if ok else "\n".join(output_messages(stdout, stderr)) or _("Not changed."))
            self.shown()

        self.ui.run_async([LAYOUT, "clock", "set", choice], done)

    def show_settings(self, result, error):
        if error:
            self.status.set_text(error)
            return
        zones, settings = result
        if zones and not self.zones:
            self.zones = zones
            for region in sorted(zones):
                self.regions.append(region, region)
        zone = settings.get("Timezone", "")
        region, _skip, city = zone.partition("/")
        if not city:
            region = "Other"
        self.quiet = True
        self.regions.set_active_id(region)
        self.fill_cities(region, zone)
        can_ntp = settings.get("CanNTP") == "yes"
        self.ntp.set_active(settings.get("NTP") == "yes")
        self.ntp.set_sensitive(can_ntp)
        self.quiet = False
        self.ui.set_subtitle(self.zone_row, zone)
        synced = settings.get("NTPSynchronized") == "yes"
        self.ui.set_subtitle(self.ntp_row, (_("From time servers on the internet (synchronized)") if synced else
                                            _("From time servers on the internet (not synchronized yet)"))
                             if can_ntp else _("Needs systemd-timesyncd, which is not installed"))


class LoginPage(SettingsPage):
    """Settings > Login Screen (flickos-greeter ADR-013): logging in
    automatically (flickos-greeter's group, through the helper), the login
    screen's language and keyboard layout (the same actions as Language &
    Region's and Keyboard's), its background and where its box sits
    (`system login.*`), and your picture (the Users page keeps it)."""

    def __init__(self, ui):
        super().__init__(ui, _("What everyone sees before the desktop starts. Changes here are for the whole "
                             "computer: they need an administrator's password and show from the login "
                             "screen's next start."))
        Gtk, row = ui.Gtk, ui.row
        self.system = {}
        self.keyboard = None
        self.rules = None
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.autologin_changed)
        self.autologin_row = row(_("Log in automatically"), self.switch, "")
        self.group(_("Logging in"), _("Starts the desktop without asking for your password when the computer "
                                      "starts. Anyone who switches the computer on gets your desktop, so only "
                                      "use it on a computer nobody else uses."), [self.autologin_row])

        self.language_button = Gtk.Button.new_with_mnemonic(_("Use _Your Language…"))
        self.language_button.set_sensitive(False)       # until the system's is read
        self.language_button.connect("clicked", self.use_language)
        self.language_row = row(_("Language"), self.language_button, "")
        self.layout_button = Gtk.Button.new_with_mnemonic(_("Use Your _Layout…"))
        self.layout_button.set_sensitive(False)
        self.layout_button.connect("clicked", self.use_layout)
        self.layout_row = row(_("Keyboard layout"), self.layout_button, "")
        self.group(_("Language and keyboard"), _("The login screen uses the system's. Yours become the "
                                                 "system's: also the console's and new accounts'."),
                   [self.language_row, self.layout_row])

        self.background = Gtk.ComboBoxText()
        self.background.set_size_request(240, -1)
        self.background.connect("changed", self.background_chosen)
        choose = Gtk.Button.new_with_mnemonic(_("_Choose Picture…"))
        choose.connect("clicked", self.choose_picture)
        backgrounds = Gtk.Box(spacing=6)
        backgrounds.pack_start(self.background, False, False, 0)
        backgrounds.pack_start(choose, False, False, 0)
        self.position = Gtk.ComboBoxText()
        self.position.set_size_request(240, -1)
        for place in LOGIN_POSITIONS:
            self.position.append(place, LOGIN_POSITION_NAMES[place])
        self.position.connect("changed", self.position_chosen)
        self.group(_("Look"), None, [
            row(_("Background"), backgrounds, _("Dimmed a little, so the login box stays easy to read")),
            row(_("Login box"), self.position, _("Where it sits on the screen")),
        ])

        self.face = Gtk.Image()
        users = Gtk.Button.new_with_mnemonic(_("C_hange…"))
        users.connect("clicked", lambda _b: ui.open_page and ui.open_page("users"))
        picture = Gtk.Box(spacing=12)
        picture.pack_start(self.face, False, False, 0)
        picture.pack_start(users, False, False, 0)
        self.group(_("Your picture"), None, [
            row(_("Your picture"), picture, _("Next to your name in the list of users. The Users page "
                                              "keeps it.")),
        ])
        self.box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        return autologin_state()[0]

    @staticmethod
    def affected_by(_warning):
        return False

    # Reading: the files and the layouts' names, off the main loop.

    @staticmethod
    def read():
        rules = None
        with contextlib.suppress(OSError):
            rules = xkb_rules()
        return (autologin_state()[1], system_locale(), system_keyboard(), rules, login_background_value(),
                login_position(), login_backgrounds())

    def reload(self):
        super().reload()
        self.ui.background(self.read, self.fill, key=(self, "read"))

    def fill(self, result, error):
        if error:
            self.status.set_text(error)
            return
        user, self.system, self.keyboard, self.rules, background, position, wallpapers = result
        me = user_name()
        self.quiet = True
        self.switch.set_active(user == me)
        self.ui.set_subtitle(self.autologin_row, _("{user} is logged in automatically now; turning this on "
                                                   "replaces them.").format(user=user) if user and user != me else
                             _("As {user}, once per start of the computer").format(user=me))

        self.ui.set_subtitle(self.language_row, _("Now: {value}").format(value=system_language_name(self.system)))
        self.language_button.set_sensitive(your_locale_args(self.system, self.values) is not None)
        on_system = (self.keyboard["layout"], self.keyboard["variant"])
        names = self.rules or {"layout": {}, "variant": {}}
        self.ui.set_subtitle(self.layout_row, _("Now: {value}").format(value=xkb_layout_name(names, *on_system)))
        self.layout_button.set_sensitive(your_layout(self.values, self.keyboard) != on_system and
                                         "," not in self.keyboard["layout"])

        self.background.remove_all()
        self.background.append(DEFAULT_CHOICE, background_name(DEFAULT_CHOICE))
        for path, name in wallpapers:
            self.background.append(path, name)
        if not self.background.set_active_id(background):
            self.background.append(background, background_name(background))
            self.background.set_active_id(background)
        self.position.set_active_id(position)
        self.quiet = False
        self.show_picture()

    def show_picture(self):
        path = picture_file()
        if path:
            with contextlib.suppress(self.ui.GLib.Error):
                self.face.set_from_pixbuf(self.ui.GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    path, PICTURE_PREVIEW, PICTURE_PREVIEW, True))
                return
        self.face.set_from_icon_name("avatar-default", self.ui.Gtk.IconSize.DIALOG)

    # Changing.

    def change_system(self, key, value):
        """`flickos-control system KEY VALUE`, which asks for the password and records it."""
        self.status.set_text(_("Waiting for the password…"))

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.reload()

        self.ui.run_async([*SELF, "system", key, value], done)

    def autologin_changed(self, switch, _param):
        if not self.quiet:
            self.change_system("autologin", "on" if switch.get_active() else "off")

    def use_language(self, button):
        button.set_sensitive(False)
        use_language_for_system(self.ui, self.system, self.values, self.status, self.reload)

    def use_layout(self, button):
        button.set_sensitive(False)
        use_layout_for_system(self.ui, self.values, self.status, self.reload)

    def background_chosen(self, combo):
        value = combo.get_active_id()
        if not self.quiet and value and value != CUSTOM_BACKGROUND:
            self.change_system("login.background", value)

    def position_chosen(self, combo):
        value = combo.get_active_id()
        if not self.quiet and value:
            self.change_system("login.position", value)

    def choose_picture(self, _button):
        Gtk = self.ui.Gtk
        dialog = Gtk.FileChooserDialog(title=_("Choose Picture"), transient_for=self.widget.get_toplevel(), modal=True,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        dialog.add_button(_("_Choose"), Gtk.ResponseType.ACCEPT)
        pictures = Gtk.FileFilter()
        pictures.add_pixbuf_formats()
        dialog.set_filter(pictures)
        folder = self.ui.GLib.get_user_special_dir(self.ui.GLib.UserDirectory.DIRECTORY_PICTURES)
        if folder and os.path.isdir(folder):
            dialog.set_current_folder(folder)
        try:
            chosen = dialog.get_filename() if dialog.run() == Gtk.ResponseType.ACCEPT else None
        finally:
            dialog.destroy()
        if chosen:
            self.change_system("login.background", chosen)


class FirewallPage:
    """The ufw firewall on or off through the helper. Its rules stay a job for
    `sudo ufw` (they need root even to read)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label(_("The firewall blocks connections that other computers start to this one. "
                                "Programs on this computer can still connect out and get their answers, so "
                                "the internet, updates and finding printers on the network all work with it "
                                "on.")), False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.changed)
        self.row = ui.row(_("Firewall"), self.switch, "")
        listbox.add(self.row)
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.label(_("Changing this needs an administrator's password. To let one program in "
                                "while the firewall is on, for example SSH, type sudo ufw allow 22/tcp in a "
                                "terminal."), dim=True), False, False, 0)
        # Servers the user runs (flickos-kits' ports step, ADR-006).
        box.pack_start(ui.heading(_("Servers you run")), False, False, 0)
        box.pack_start(ui.label(_("A server you start yourself, such as a website you are building, can be "
                                "reached from a phone or another computer on your home or office network "
                                "once its port is listed here. Type ports like 8000/tcp, separated by "
                                "commas, and leave it empty to close them again. Only ports from 1024 up "
                                "can be listed.")), False, False, 0)
        ports_frame, ports_list = ui.framed_list()
        self.ports_entry = Gtk.Entry(placeholder_text="8000/tcp", width_chars=24)
        self.ports_entry.get_accessible().set_name(_("Ports open to this network"))
        self.ports_entry.connect("activate", lambda _e: self.ports_apply())
        self.ports_entry.connect("focus-out-event", lambda _e, _ev: self.ports_apply())
        self.ports_row = ui.row(_("Ports open to this network"), self.ports_entry, "")
        ports_list.add(self.ports_row)
        box.pack_start(ports_frame, False, False, 0)
        self.ports_value = "off"
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        return firewall_state() is not None

    def changed(self, switch, _param):
        if self.quiet:
            return
        self.status.set_text(_("Waiting for the password…"))

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.shown()

        self.ui.run_async([*SELF, "system", "firewall", "on" if switch.get_active() else "off"], done)

    def ports_apply(self):
        """The entry's ports, through `system firewall.local-ports` (Enter or leaving the entry)."""
        text = self.ports_entry.get_text().strip()
        try:
            value = check_system("firewall.local-ports", text) if text else "off"
        except ControlError as error:
            self.status.set_text(str(error))
            return False
        if value == self.ports_value:
            return False
        self.status.set_text(_("Waiting for the password…"))

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.shown()

        self.ui.run_async([*SELF, "system", "firewall.local-ports", value], done)
        return False                    # a focus-out handler must let the event go on

    def shown(self):
        on = bool(firewall_state())
        self.quiet = True
        self.switch.set_active(on)
        self.quiet = False
        text = (_("On: other computers can't connect to this one") if on
                else _("Off: other computers can connect to programs that wait for them"))
        if live_session():
            text += " " + _("(in the live session until it restarts)")
        self.ui.set_subtitle(self.row, text)
        self.ports_value = local_ports()
        self.ports_entry.set_text(self.ports_value.replace(",", ", ") if self.ports_value != "off" else "")
        self.ui.set_subtitle(self.ports_row, _("No ports are open to other devices.") if self.ports_value == "off"
                             else _("Devices on home and office networks can reach: {ports}").format(
                                 ports=self.ports_value.replace(",", ", ")))


class PrivacyPage:
    """The anonymous weekly count (flickos-countme), shown while it is installed."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label(_("FlickOS counts how many computers run it, without knowing which ones. Once a "
                                "week this computer sends only the FlickOS version and roughly how long ago it "
                                "was installed: no name, no machine id, no hardware, no list of programs. The "
                                "server keeps only the weekly totals.")), False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.changed)
        self.row = ui.row(_("Count this computer"), self.switch, "")
        listbox.add(self.row)
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.heading(_("What is sent")), False, False, 0)
        self.request = ui.label("", dim=True)
        self.request.set_selectable(True)
        box.pack_start(self.request, False, False, 0)
        box.pack_start(ui.label(_("Turning it on needs an administrator's password."), dim=True), False, False, 0)
        link = Gtk.LinkButton.new_with_label(PRIVACY_URL, _("Privacy details"))
        link.set_halign(Gtk.Align.START)
        box.pack_start(link, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        return shutil.which(COUNTME) is not None

    def changed(self, switch, _param):
        if self.quiet:
            return
        if switch.get_active():
            self.status.set_text(_("Waiting for the password…"))

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.shown()

        self.ui.run_async([COUNTME, "enable" if switch.get_active() else "disable"], done)

    def shown(self):
        self.ui.background(lambda: countme_state(run([COUNTME, "status"])), self.show, key=(self, "read"))

    def show(self, state, error):
        if error:
            self.status.set_text(error)
            return
        self.quiet = True
        self.switch.set_active(state.enabled)
        self.quiet = False
        if state.reason == "live session":
            subtitle = _("Never sent from the live session")
        elif not state.enabled:
            subtitle = _("Nothing is sent")
        elif state.reason:
            subtitle = _("Not sent now: {reason}").format(reason=state.reason)
        elif state.last_week:
            # Translators: {week} is an ISO week, such as 2026-W45.
            subtitle = _("Last counted in week {week}").format(week=state.last_week)
        else:
            subtitle = _("Not counted yet")
        self.ui.set_subtitle(self.row, subtitle)
        self.request.set_text(f"GET {state.request}" if state.request else "")


class RestorePointsPage:
    """Restore points (flickos-recovery): shown on FlickOS's btrfs layout only."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label(_("Before every software change FlickOS takes a restore point. If an update "
                                "breaks something, put the system back to before it: the software, system "
                                "settings, passwords and accounts go back to how they were then. Your own files "
                                "stay as they are.")), False, False, 0)
        box.pack_start(ui.label(_("A restore point is not a backup: it is on the same disk as the system. Keep "
                                "copies of your files somewhere else too."), dim=True), False, False, 0)
        # Started from a restore point (by itself after failed starts, or from the boot menu).
        self.booted = Gtk.InfoBar(message_type=Gtk.MessageType.INFO, no_show_all=True)
        self.booted_text = ui.label("")
        self.booted_text.set_max_width_chars(100)
        self.booted.get_content_area().add(self.booted_text)
        self.booted_text.show()
        self.booted.add_button(_("_Keep…"), 1)
        self.try_again = self.booted.add_button(_("_Try Again"), 2)
        self.booted.connect("response", self.booted_response)
        box.pack_start(self.booted, False, False, 0)
        self.notice = ui.notice()
        self.notice.add_button(_("_Restart Now"), 1)
        self.notice.connect("response", lambda _bar, _response: self.restart())
        box.pack_start(self.notice, False, False, 0)
        # Above the list: a put back's result shows where it was clicked (WIN-10).
        self.status = ui.status_label()
        self.status.set_no_show_all(True)
        box.pack_start(self.status, False, False, 0)
        box.pack_start(ui.heading(_("Restore points")), False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        frame, self.points = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        self.make = Gtk.Button.new_with_mnemonic(_("_Make a Restore Point Now"))
        self.make.set_halign(Gtk.Align.START)
        self.make.connect("clicked", lambda _b: self.change([RECOVERY, "create", _("Made in Settings")],
                                                            _("Making a restore point…"), _("Restore point made.")))
        box.pack_start(self.make, False, False, 0)
        box.pack_start(ui.heading(_("Settings")), False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.switched)
        self.switch_row = ui.row(_("Take a restore point before software changes"), self.switch, "")
        listbox.add(self.switch_row)
        self.delete = Gtk.Button.new_with_mnemonic(_("_Delete All…"))
        self.delete.connect("clicked", self.ask_delete)
        self.space = ui.row(_("Disk space"), self.delete, "")
        listbox.add(self.space)
        self.auto = Gtk.Switch()
        self.auto.connect("notify::active", self.auto_switched)
        listbox.add(ui.row(_("Start a restore point by itself after failed starts"), self.auto,
                           _("After 2 starts that didn't reach the login screen. When off, the boot menu waits "
                           "with it highlighted.")))
        box.pack_start(frame, False, False, 0)
        box.pack_start(ui.label(_("Changing restore points needs an administrator's password."), dim=True),
                       False, False, 0)

    @staticmethod
    def available():
        return recovery_available()

    def shown(self):
        self.loading.show_all()
        self.ui.background(recovery_state, self.show, key=(self, "read"))

    def show(self, state, error):
        Gtk = self.ui.Gtk
        self.loading.hide()
        for child in self.points.get_children():
            self.points.remove(child)
        if error:
            self.say(error)
            return
        waiting = state.get("restart_needed")
        booted = state.get("booted")
        names = {point["name"]: point["description"] for point in state.get("points", [])}
        start = state.get("start") or {}
        recovered = bool(booted) and start.get("mode") == "recovering" and start.get("rp") == booted
        what = names.get(booted, booted or "")
        # Translators: {name} is a restore point's description, such as "Before installing vlc".
        self.booted_text.set_text(
            _("FlickOS started from the restore point \u201c{name}\u201d because the last starts didn't reach "
              "the login screen. Nothing you change now is kept. Keep it, or try the system as it is "
              "again.").format(name=what)
            if recovered else
            _("The computer runs from the restore point \u201c{name}\u201d. Nothing you change now is kept. "
              "Keep it to make it the system.").format(name=what))
        self.try_again.set_visible(recovered)
        self.booted.set_visible(bool(booted) and not waiting)
        self.ui.set_notice(self.notice, [_("A restore point was put back. Restart the computer to use it; until "
                                         "then, software can't be installed or removed.")] if waiting else [])
        for point in reversed(state.get("points", [])):
            when = point["description"].rsplit(", ", 1)
            button = Gtk.Button.new_with_mnemonic(_("Put Back…"))
            button.set_sensitive(not waiting)
            button.connect("clicked", self.put_back, point["name"])
            self.points.add(self.ui.row(when[0], button, when[1] if len(when) > 1 else point["name"]))
        if not state.get("points"):
            self.points.add(self.ui.row(_("No restore points yet"), None,
                                        _("One is taken before the next software change.")))
        self.points.show_all()
        self.quiet = True
        self.switch.set_active(bool(state.get("enabled")))
        self.quiet = False
        keep = state.get("keep", 5)
        self.ui.set_subtitle(self.switch_row, ngettext("The newest {count} is kept", "The newest {count} are kept",
                                                       keep).format(count=keep) if state.get("enabled")
                             else _("No restore point is taken"))
        self.make.set_sensitive(bool(state.get("enabled")) and not waiting and not booted)
        self.quiet = True
        self.auto.set_active(bool(state.get("auto_recover")))
        self.quiet = False
        free, minimum = state.get("free_bytes") or 0, state.get("min_free_bytes") or 0
        # Translators: {free} and {minimum} are numbers of gigabytes, such as 12.5.
        self.ui.set_subtitle(self.space, _("{free} GB free. None is taken with less than {minimum} GB free.").format(
            free=f"{free / 1024 ** 3:.1f}", minimum=f"{minimum / 1024 ** 3:.1f}"))
        self.delete.set_sensitive(bool(state.get("points")) and not waiting)

    def say(self, text):
        self.status.set_text(text)
        self.status.set_visible(bool(text))

    def change(self, command, doing, success=None):
        self.say(doing)

        def done(ok, stdout, stderr):
            messages = output_messages(stdout if success is None else "", stderr)
            self.say(success if ok and success else "\n".join(messages) if messages or ok else _("Not changed."))
            self.shown()

        self.ui.run_async(command, done)

    def switched(self, switch, _param):
        if self.quiet:
            return
        self.change([*SELF, "system", "restore-points", "on" if switch.get_active() else "off"],
                    _("Waiting for the password…"))

    def auto_switched(self, switch, _param):
        if self.quiet:
            return
        self.change([*SELF, "system", "restore-points.auto", "on" if switch.get_active() else "off"],
                    _("Waiting for the password…"))

    def booted_response(self, _bar, response):
        if response == 2:
            self.change([RECOVERY, "start", "try-again"], _("Waiting for the password…"),
                        _("The next start uses the system as it is. Restart the computer to try it."))
            return
        if response != 1:
            return
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=_("Keep this restore point?"))
        dialog.format_secondary_text(_("The system goes back to it for good: software, system settings, "
                                     "passwords and accounts as they were then. Your own files stay as they are. "
                                     "The system as it was is kept as a restore point, so this can be undone. It "
                                     "takes effect when the computer restarts, and needs an administrator's "
                                     "password."))
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        ok = dialog.add_button(_("_Keep"), Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        answer = dialog.run()
        dialog.destroy()
        if answer == Gtk.ResponseType.OK:
            self.change([RECOVERY, "start", "keep"], _("Waiting for the password…"),
                        _("Kept. Restart the computer to use it."))

    def put_back(self, button, name):
        button.set_sensitive(False)
        self.say(_("Checking what would change…"))

        def done(ok, message):
            self.say(message)
            if ok is not None:
                self.shown()

        ask_put_back(self.ui, self.widget.get_toplevel(), name, done)

    def ask_delete(self, _button):
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=_("Delete all restore points?"))
        dialog.format_secondary_text(_("This frees the space they hold. The system can then not be put back to "
                                     "before the changes made so far. A new restore point is taken before the "
                                     "next software change."))
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        ok = dialog.add_button(_("_Delete All"), Gtk.ResponseType.OK)
        ok.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.change([RECOVERY, "delete", "--all"], _("Waiting for the password…"), _("All restore points deleted."))

    def restart(self):
        self.ui.run_async(["systemctl", "reboot"], lambda ok, stdout, stderr: self.say(
            "" if ok else "\n".join(output_messages(stdout, stderr)) or _("The computer didn't restart.")))


class UsersPage:
    """User accounts: add, remove, administrator, password (the helper's
    user-* verbs). Installed systems only: live accounts are gone at reboot."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        box.pack_start(ui.label(_("People who can log in to this computer. Each has their own files and "
                                "settings. Administrators can install software and change settings for "
                                "everyone.")), False, False, 0)
        frame, own = ui.framed_list()
        controls = Gtk.Box(spacing=6)
        self.face = Gtk.Image(pixel_size=PICTURE_PREVIEW)
        controls.pack_start(self.face, False, False, 6)
        choose = Gtk.Button.new_with_mnemonic(_("Choose P_icture…"))
        choose.connect("clicked", self.choose_picture)
        controls.pack_start(choose, False, False, 0)
        self.no_picture = Gtk.Button.new_with_mnemonic(_("Remove Pic_ture"))
        self.no_picture.connect("clicked", lambda _button: self.send_picture(DEFAULT_CHOICE))
        controls.pack_start(self.no_picture, False, False, 0)
        own.add(ui.row(_("Your picture"), controls, _("On the login screen, the lock screen and in the start menu")))
        box.pack_start(frame, False, False, 0)
        frame, self.rows = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        buttons = Gtk.Box(spacing=12)
        add = Gtk.Button.new_with_mnemonic(_("_Add User…"))
        add.connect("clicked", self.add)
        buttons.pack_start(add, False, False, 0)
        box.pack_start(buttons, False, False, 0)
        box.pack_start(ui.label(_("Changing these needs an administrator's password. A change to "
                                "administrator takes effect at that user's next login."), dim=True), False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)
        self.quiet = False

    @staticmethod
    def available():
        return not live_session()

    def helper(self, words, stdin=None):
        self.status.set_text(_("Waiting for the password…"))
        # For History: the account's role before, and after if it works.
        name = words[1]
        before = next((("administrator" if a.admin else "standard") for a in accounts() if a.name == name), "absent")
        after = {"user-add": "administrator" if words[-1] == "yes" else "standard", "user-remove": "absent",
                 "user-admin": "administrator" if words[-1] == "yes" else "standard"}.get(words[0])

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            if ok and after is not None:
                record(f"user.{name}", before, after)
                fire_changed()          # done now (hooks, ADR-007)
            self.shown()

        self.ui.run_async(["pkexec", HELPER, *words], done, stdin)

    def show_picture(self):
        path = picture_file()
        self.no_picture.set_sensitive(path is not None)
        if path:
            with contextlib.suppress(self.ui.GLib.Error):
                self.face.set_from_pixbuf(self.ui.GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    path, PICTURE_PREVIEW, PICTURE_PREVIEW, True))
                return
        self.face.set_from_icon_name("avatar-default", self.ui.Gtk.IconSize.DIALOG)

    def choose_picture(self, _button):
        Gtk = self.ui.Gtk
        dialog = Gtk.FileChooserDialog(title=_("Choose Picture"), transient_for=self.widget.get_toplevel(), modal=True,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        dialog.add_button(_("_Choose"), Gtk.ResponseType.ACCEPT)
        pictures = Gtk.FileFilter()
        pictures.add_pixbuf_formats()
        dialog.set_filter(pictures)
        folder = self.ui.GLib.get_user_special_dir(self.ui.GLib.UserDirectory.DIRECTORY_PICTURES)
        if folder and os.path.isdir(folder):
            dialog.set_current_folder(folder)
        try:
            chosen = dialog.get_filename() if dialog.run() == Gtk.ResponseType.ACCEPT else None
        finally:
            dialog.destroy()
        if chosen:
            self.send_picture(chosen)

    def send_picture(self, value):
        def done(ok, stdout, stderr):
            self.status.set_text("" if ok else "\n".join(output_messages(stdout, stderr)) or _("Not changed."))
            self.show_picture()

        self.ui.run_async([*SELF, "picture", "set", value], done)

    def fill(self):
        Gtk = self.ui.Gtk
        self.show_picture()
        for row in self.rows.get_children():
            self.rows.remove(row)
        me = user_name()
        found = accounts()
        admins = sum(account.admin for account in found)
        self.quiet = True
        for account in found:
            details = [account.name, _("administrator") if account.admin else _("standard user")]
            if account.name == me:
                # Translators: after the account's name and role: "jon · administrator · you".
                details.append(_("you"))
            controls = Gtk.Box(spacing=6)
            admin = Gtk.CheckButton.new_with_mnemonic(_("Ad_ministrator"))
            admin.set_active(account.admin)
            # The helper keeps the last administrator too; this only saves a prompt.
            admin.set_sensitive(not (account.admin and admins == 1))
            admin.connect("toggled", self.admin_toggled, account)
            controls.pack_start(admin, False, False, 0)
            password = Gtk.Button.new_with_mnemonic(_("_Password…"))
            password.connect("clicked", self.change_password, account)
            controls.pack_start(password, False, False, 0)
            remove = Gtk.Button.new_with_mnemonic(_("_Remove…"))
            remove.connect("clicked", self.remove, account)
            if account.name == me:
                remove.set_sensitive(False)
                remove.set_tooltip_text(_("You can't remove the account you are using"))
            controls.pack_start(remove, False, False, 0)
            self.rows.add(self.ui.row(account.full_name or account.name, controls, " · ".join(details)))
        if not found:
            self.rows.add(self.ui.row(_("No user accounts found")))
        self.rows.show_all()
        self.quiet = False

    def admin_toggled(self, button, account):
        if not self.quiet:
            self.helper(["user-admin", account.name, "yes" if button.get_active() else "no"])

    def dialog(self, title, action):
        """A dialog with Cancel and action; returns (dialog, grid, action button)."""
        Gtk = self.ui.Gtk
        dialog = Gtk.Dialog(title=title, transient_for=self.widget.get_toplevel(), modal=True, resizable=False)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        button = dialog.add_button(action, Gtk.ResponseType.OK)
        button.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=8, column_spacing=12, margin=18)
        dialog.get_content_area().add(grid)
        return dialog, grid, button

    def entry(self, grid, top, title, secret=False):
        Gtk = self.ui.Gtk
        entry = Gtk.Entry(activates_default=True, hexpand=True, width_chars=28)
        if secret:
            entry.set_visibility(False)
            entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        grid.attach(Gtk.Label(label=title, xalign=1, use_underline=True, mnemonic_widget=entry), 0, top, 1, 1)
        grid.attach(entry, 1, top, 1, 1)
        return entry

    def hint(self, grid, top):
        label = self.ui.label("", dim=True)
        grid.attach(label, 1, top, 1, 1)
        return label

    def add(self, _button):
        Gtk = self.ui.Gtk
        taken = taken_names()
        dialog, grid, ok = self.dialog(_("Add User"), _("_Add"))
        full_name = self.entry(grid, 0, _("_Full name"))
        name = self.entry(grid, 1, _("_User name"))
        password = self.entry(grid, 2, _("_Password"), secret=True)
        again = self.entry(grid, 3, _("_Confirm password"), secret=True)
        admin = Gtk.CheckButton.new_with_mnemonic(_("Ad_ministrator: can install software and change settings "
                                                  "for everyone"))
        grid.attach(admin, 1, 4, 1, 1)
        hint = self.hint(grid, 5)
        edited = []

        def check(*_args):
            problem = (full_name_problem(full_name.get_text()) or user_name_problem(name.get_text(), taken)
                       or password_problem(password.get_text(), again.get_text()))
            hint.set_text(problem or "")
            ok.set_sensitive(problem is None)

        def name_from_full_name(_entry):
            if not edited:
                name.handler_block(name_changed)
                name.set_text(suggest_user_name(full_name.get_text(), taken))
                name.handler_unblock(name_changed)
            check()

        def name_typed(_entry):
            edited[:] = [True] if name.get_text() else []
            check()

        full_name.connect("changed", name_from_full_name)
        name_changed = name.connect("changed", name_typed)
        password.connect("changed", check)
        again.connect("changed", check)
        check()
        dialog.show_all()
        response = dialog.run()
        values = (name.get_text(), full_name.get_text().strip(), "yes" if admin.get_active() else "no")
        secret = password.get_text()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.helper(["user-add", *values], secret + "\n")

    def change_password(self, _button, account):
        Gtk = self.ui.Gtk
        dialog, grid, ok = self.dialog(_("Change Password"), _("C_hange"))
        grid.attach(self.ui.label(_("The new password of {name} ({user}).").format(
            name=account.full_name or account.name, user=account.name)),
                    0, 0, 2, 1)
        password = self.entry(grid, 1, _("_New password"), secret=True)
        again = self.entry(grid, 2, _("_Confirm password"), secret=True)
        hint = self.hint(grid, 3)

        def check(*_args):
            problem = password_problem(password.get_text(), again.get_text())
            hint.set_text(problem or "")
            ok.set_sensitive(problem is None)

        password.connect("changed", check)
        again.connect("changed", check)
        check()
        dialog.show_all()
        response = dialog.run()
        secret = password.get_text()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.helper(["user-password", account.name], secret + "\n")

    def remove(self, _button, account):
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=_("Remove {name}?").format(name=account.full_name or account.name))
        dialog.format_secondary_text(_("{user} can no longer log in. They have to be logged out.").format(
            user=account.name))
        files = Gtk.CheckButton.new_with_mnemonic(_("Also _delete their files ({folder})").format(folder=account.home))
        dialog.get_message_area().pack_start(files, False, False, 0)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        button = dialog.add_button(_("_Remove"), Gtk.ResponseType.OK)
        button.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        dialog.show_all()
        response = dialog.run()
        delete = files.get_active()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.helper(["user-remove", account.name, "delete" if delete else "keep"])

    def shown(self):
        self.fill()


class TilingPage:
    """Tiling on/off, arrangement, main window width and apps that always
    float (flick-tiler)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        self.timers = {}
        self.switch = None          # built with the first state (build)
        box.pack_start(ui.label(_("Arrange windows side by side automatically. Super+T turns tiling on or "
                                "off; while it is on, its keys are listed under Keyboard Shortcuts.")),
                       False, False, 0)
        self.content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.content, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def build(self, modes, state):
        ui, Gtk, box = self.ui, self.ui.Gtk, self.content
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch(active=state.enabled)
        self.switch.connect("notify::active", self.toggled)
        listbox.add(ui.row(_("Tile windows"), self.switch, _("New windows are tiled; open windows with Super+Shift+T")))
        row, self.select_mode = ui.combo_row(_("Arrangement"), modes, state.mode, self.choose_mode)
        listbox.add(row)
        # Not with flick-tiler before 1.12, which always tiles them.
        self.tile_open = None
        if state.tile_open is not None:
            self.tile_open = Gtk.Switch(active=state.tile_open)
            self.tile_open.connect("notify::active", self.tile_open_toggled)
            listbox.add(ui.row(_("Tile open windows"), self.tile_open,
                               _("Turning tiling on also tiles the windows already open, focusing each in turn")))
        self.scales = {}
        for key, title, subtitle, low, high, step, unit, default in (
                ("ratio", _("Main window width"), _("In the arrangements with a main window"),
                 RATIO_MIN, RATIO_MAX, RATIO_STEP, "%", 55),
                ("gap", _("Gap"), _("Space between tiled windows and around them"), GAP_MIN, GAP_MAX, GAP_STEP, "px", 8)):
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low, high, step)
            scale.set_size_request(240, -1)
            scale.set_value_pos(Gtk.PositionType.RIGHT)
            scale.set_digits(0)
            scale.connect("format-value", lambda _scale, value, unit=unit: f"{int(value)} {unit}")
            value = getattr(state, key)
            scale.set_value(value if value is not None else default)
            scale.connect("value-changed", self.slider_changed, key)
            self.scales[key] = scale
            listbox.add(ui.row(title, scale, subtitle))
        box.pack_start(frame, False, False, 0)

        box.pack_start(ui.heading(_("Apps that always float")), False, False, 0)
        box.pack_start(ui.label(_("Windows of these apps are never tiled. An app id can be a pattern such as "
                                "gimp*. Dialogs always float."), dim=True), False, False, 0)
        frame, self.floating = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        add = Gtk.Box(spacing=6)
        self.entry = Gtk.Entry(placeholder_text=_("App id, e.g. org.gnome.Calculator"))
        self.entry.connect("activate", self.add_floating)
        add_button = Gtk.Button.new_with_mnemonic(_("_Add"))
        add_button.connect("clicked", self.add_floating)
        add.pack_start(self.entry, True, True, 0)
        add.pack_start(add_button, False, False, 0)
        box.pack_start(add, False, False, 0)
        box.show_all()
        self.fill_floating()

    def send(self, words, then=None):
        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if not ok or "saved" in stdout else "")
            self.refresh()
            if then:
                then()

        self.ui.run_async([TILER, *words], done)

    def toggled(self, switch, _param):
        if not self.quiet:
            self.send(["on" if switch.get_active() else "off"])

    def tile_open_toggled(self, switch, _param):
        if not self.quiet:
            self.send(["tile-open", "on" if switch.get_active() else "off"])

    def choose_mode(self, mode_id):
        self.send(["mode", mode_id])

    def slider_changed(self, scale, key):
        """ratio or gap: sent once the slider rests, not for every step."""
        if self.quiet:
            return
        if self.timers.get(key):
            self.ui.GLib.source_remove(self.timers[key])

        def apply():
            self.timers[key] = None
            self.send([key, str(int(scale.get_value()))])
            return False

        self.timers[key] = self.ui.GLib.timeout_add(SLIDER_DELAY_MS, apply)

    def refresh(self):
        """Show flick-tiler's state; it also changes with Super+T and the panel."""
        first = self.switch is None

        def read():
            return parse_items(run([TILER, "modes"])) if first else None, tiler_state(run([TILER, "status"]))

        self.ui.background(read, self.show_state, key=(self, "status"))

    def show_state(self, result, error):
        self.loading.hide()
        if error:
            self.status.set_text(error if self.switch else _("Can't read the tiling settings: {error}").format(error=error))
            return
        modes, state = result
        if self.switch is None:
            self.build(modes, state)
            return
        self.quiet = True
        self.switch.set_active(state.enabled)
        if self.tile_open is not None and state.tile_open is not None:
            self.tile_open.set_active(state.tile_open)
        for key, scale in self.scales.items():
            value = getattr(state, key)
            if value is not None and not self.timers.get(key):
                scale.set_value(value)
        self.select_mode(state.mode)
        self.quiet = False

    def fill_floating(self):
        self.ui.background(lambda: run([TILER, "floating", "list"]).split(), self.show_floating,
                           key=(self, "floating"))

    def show_floating(self, patterns, error):
        if error:
            self.status.set_text(error)
            patterns = []
        for row in self.floating.get_children():
            self.floating.remove(row)
        for pattern in patterns:
            remove = self.ui.Gtk.Button.new_from_icon_name("list-remove-symbolic", self.ui.Gtk.IconSize.BUTTON)
            # Translators: {app} is an app id or a pattern, such as gimp*.
            again = _("Tile {app} again").format(app=pattern)
            remove.set_tooltip_text(again)
            remove.get_accessible().set_name(again)
            remove.connect("clicked", lambda _b, p=pattern: self.send(["floating", "remove", p], self.fill_floating))
            self.floating.add(self.ui.row(pattern, remove))
        if not patterns:
            self.floating.add(self.ui.row(_("None")))
        self.floating.show_all()

    def add_floating(self, *_args):
        pattern = self.entry.get_text().strip()
        if not pattern:
            return
        self.entry.set_text("")
        self.send(["floating", "add", pattern], self.fill_floating)

    def shown(self):
        self.refresh()


class ShortcutsPage:
    """The keyboard shortcuts labwc uses (flickos-shortcuts list)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        box.pack_start(ui.label(_("Hold the Super (Windows) key on its own to see these at any time.")),
                       False, False, 0)
        sheet = Gtk.Button.new_with_mnemonic(_("_Show the Shortcut Sheet"))
        sheet.set_halign(Gtk.Align.START)
        sheet.connect("clicked", lambda _b: ui.start_app([SHORTCUTS, "show"]))
        box.pack_start(sheet, False, False, 0)
        self.sections = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.sections, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.shown_text = None

    def shown(self):
        """Read again each time: the tiling keys come and go with tiling."""
        self.ui.background(lambda: run([SHORTCUTS, "list"]), self.show_sheet, key=(self, "list"))

    def show_sheet(self, text, message):
        self.loading.hide()
        text = text or ""
        if text == self.shown_text and message is None:
            return
        self.shown_text = text
        for child in self.sections.get_children():
            self.sections.remove(child)
        if message:
            self.ui.error(self.sections, message)
        for name, rows in parse_shortcuts(text):
            self.sections.pack_start(self.ui.heading(name), False, False, 0)
            frame, listbox = self.ui.framed_list()
            for keys, description in rows:
                listbox.add(self.ui.row(description, self.ui.label(keys, dim=True, wrap=False)))
            self.sections.pack_start(frame, False, False, 0)
        self.sections.show_all()


class PhonePage:
    """The phone connection (flickos-phone): on or off, the name phones see,
    pairing, the paired phones, the networks where it listens, notifications,
    calls, media control, the named commands the phone may run, what came from
    a phone, and the firewall's rule for phones (a system setting, through
    the helper). It reads everything with one `flickos-phone state`, again
    every PHONE_REFRESH_SECONDS while the page is on screen."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        self.timer = None
        self.state = None
        self.shown_lists = None     # what the lists show, so they're rebuilt only when it changes
        box.pack_start(ui.label(_("Share a page, a photo or some text on your phone, choose this computer, and it "
                                "arrives here. Files and addresses go the other way too. The phone needs the "
                                "KDE Connect app, from F-Droid or Google Play.")), False, False, 0)
        self.notice = ui.notice()
        box.pack_start(self.notice, False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.toggled)
        self.switch_row = ui.row(_("Use your phone with this computer"), self.switch, "")
        listbox.add(self.switch_row)
        self.name = Gtk.Entry(width_chars=20)
        self.name.connect("activate", self.rename)
        self.name.connect("focus-out-event", self.rename)
        listbox.add(ui.row(_("Name on the phone"), self.name, _("What the KDE Connect app calls this computer")))
        box.pack_start(frame, False, False, 0)

        # Only while it's on.
        self.details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, no_show_all=True)
        self.open_phone = Gtk.Button.new_with_mnemonic(_("_Open Phone"))
        self.open_phone.set_halign(Gtk.Align.START)
        self.open_phone.connect("clicked", lambda _b: ui.start_app([PHONE, "window"]))
        self.details.pack_start(self.open_phone, False, False, 0)
        self.firewall_frame, firewall_list = ui.framed_list()
        self.firewall_frame.set_no_show_all(True)
        self.firewall_switch = Gtk.Switch()
        self.firewall_switch.connect("notify::active", self.firewall_toggled)
        firewall_list.add(ui.row(_("Let phones through the firewall"), self.firewall_switch,
                                 _("Only from home and office networks. Needs an administrator's password.")))
        self.details.pack_start(self.firewall_frame, False, False, 0)
        self.details.pack_start(ui.heading(_("Phones")), False, False, 0)
        frame, self.phones = ui.framed_list()
        self.details.pack_start(frame, False, False, 0)
        self.add_button = Gtk.Button.new_with_mnemonic(_("_Add Phone…"))
        self.add_button.set_halign(Gtk.Align.START)
        self.add_button.connect("clicked", self.add_phone)
        self.details.pack_start(self.add_button, False, False, 0)
        self.details.pack_start(ui.heading(_("Networks")), False, False, 0)
        self.details.pack_start(ui.label(_("Phones can connect only while this computer is on one of these "
                                         "networks. The network a phone pairs on is added."), dim=True),
                                False, False, 0)
        frame, self.networks = ui.framed_list()
        self.details.pack_start(frame, False, False, 0)
        self.use_here = Gtk.Button.new_with_mnemonic(_("_Use on This Network"))
        self.use_here.set_halign(Gtk.Align.START)
        self.use_here.set_no_show_all(True)
        self.use_here.connect("clicked", lambda _b: self.send(["network", "add"]))
        self.details.pack_start(self.use_here, False, False, 0)
        self.details.pack_start(ui.heading(_("Notifications")), False, False, 0)
        self.details.pack_start(ui.label(_("From the apps you allow. Nothing is shown while the screen is locked."),
                                         dim=True), False, False, 0)
        frame, note_list = ui.framed_list()
        self.note_switch = Gtk.Switch()
        self.note_switch.connect("notify::active", self.notifications_toggled)
        self.note_row = ui.row(_("Show the phone's notifications"), self.note_switch, _("Off"))
        note_list.add(self.note_row)
        self.details.pack_start(frame, False, False, 0)
        self.note_apps_frame, self.note_apps = ui.framed_list()
        self.note_apps_frame.set_no_show_all(True)
        self.details.pack_start(self.note_apps_frame, False, False, 0)
        self.details.pack_start(ui.heading(_("Calls")), False, False, 0)
        self.details.pack_start(ui.label(_("When the phone rings, a notification names the caller. Click it to mute "
                                         "the ringer. What is playing pauses until the call ends. Nothing is shown "
                                         "while the screen is locked."), dim=True), False, False, 0)
        frame, call_list = ui.framed_list()
        self.call_switch = Gtk.Switch()
        self.call_switch.connect("notify::active", self.calls_toggled)
        self.call_row = ui.row(_("Show the phone's calls"), self.call_switch, _("Off"))
        call_list.add(self.call_row)
        self.details.pack_start(frame, False, False, 0)
        self.details.pack_start(ui.heading(_("Media")), False, False, 0)
        self.details.pack_start(ui.label(_("What's playing on this computer shows in the phone's app, with its name "
                                         "and picture. The phone can play, pause, skip and change the volume."),
                                         dim=True), False, False, 0)
        frame, media_list = ui.framed_list()
        self.media_switch = Gtk.Switch()
        self.media_switch.connect("notify::active", self.media_toggled)
        self.media_row = ui.row(_("Control what's playing from the phone"), self.media_switch, _("Off"))
        media_list.add(self.media_row)
        self.details.pack_start(frame, False, False, 0)
        self.details.pack_start(ui.heading(_("Commands")), False, False, 0)
        self.details.pack_start(ui.label(_("The phone is sent these names and can run one of them. A command runs as you. "
                                         "Nothing runs while the screen is locked."), dim=True), False, False, 0)
        frame, self.command_rows = ui.framed_list()
        self.details.pack_start(frame, False, False, 0)
        self.add_command_button = Gtk.Button.new_with_mnemonic(_("Add _Command…"))
        self.add_command_button.set_halign(Gtk.Align.START)
        self.add_command_button.connect("clicked", self.add_command)
        self.details.pack_start(self.add_command_button, False, False, 0)
        self.details.pack_start(ui.heading(_("Received")), False, False, 0)
        frame, self.received = ui.framed_list()
        self.details.pack_start(frame, False, False, 0)
        box.pack_start(self.details, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        # Not in the live session: there is nothing to pair with a system that's gone at the next boot.
        return shutil.which(PHONE) is not None and not live_session()

    def shown(self):
        self.refresh()
        if self.timer is None:
            self.timer = self.ui.GLib.timeout_add_seconds(PHONE_REFRESH_SECONDS, self.tick)

    def tick(self):
        """Phones come and go: read again while the page is on screen, and stop
        the timer when it isn't (shown() starts it again)."""
        if not self.widget.get_mapped():
            self.timer = None
            return False
        self.refresh()
        return True

    def refresh(self):
        def read():
            try:
                return json.loads(run([PHONE, "state"])), phones_allowed(), thunar_hides_phone_action()
            except ValueError:
                raise ControlError(_("flickos-phone state gave no answer")) from None

        self.ui.background(read, self.show_state, key=(self, "state"))

    def show_state(self, result, error):
        self.loading.hide()
        if error:
            self.status.set_text(_("Can't read the phone connection: {error}").format(error=error))
            return
        state, allowed, hidden_by = result
        self.state = state
        self.ui.set_notice(self.notice, [thunar_notice(hidden_by)] if state["enabled"] and hidden_by else [])
        self.quiet = True
        self.switch.set_active(state["enabled"])
        self.firewall_switch.set_active(allowed)
        self.note_switch.set_active(bool(state.get("notifications")))
        self.call_switch.set_active(bool(state.get("calls")))
        self.media_switch.set_active(bool(state.get("media")))
        self.quiet = False
        self.ui.set_subtitle(self.note_row, _("On") if state.get("notifications") else _("Off"))
        self.ui.set_subtitle(self.call_row, _("On") if state.get("calls") else _("Off"))
        self.ui.set_subtitle(self.media_row, _("On") if state.get("media") else _("Off"))
        if not self.name.has_focus():
            self.name.set_text(state["own_name"])
            self.name.set_placeholder_text(state["computer_name"])
        self.ui.set_subtitle(self.switch_row, phone_summary(state))
        if not state["enabled"]:
            self.details.hide()
            return
        if not self.details.get_visible():
            reveal(self.details)
        listed = {n["uuid"] for n in state["networks"]}
        for widget, wanted in ((self.firewall_frame, state["firewall"]),
                               (self.use_here, any(n["uuid"] not in listed for n in state["active"]))):
            if wanted and not widget.get_visible():
                reveal(widget)
            elif not wanted:
                widget.hide()
        self.add_button.set_sensitive(state["running"])
        lists = json.dumps([state["phones"], state["networks"], state["received"],
                            state.get("notifications"), state.get("notification_apps"),
                            state.get("commands")], sort_keys=True)
        if lists != self.shown_lists:
            self.shown_lists = lists
            self.fill_phones(state["phones"])
            self.fill_networks(state["networks"])
            self.fill_received(state["received"])
            self.fill_notification_apps(state.get("notification_apps") or [], state.get("notifications"))
            self.fill_commands(state.get("commands") or [])

    @staticmethod
    def clear(listbox):
        for row in listbox.get_children():
            listbox.remove(row)

    def button(self, text, name, action):
        button = self.ui.Gtk.Button(label=text)
        button.get_accessible().set_name(name)
        button.connect("clicked", lambda _b: action())
        return button

    def fill_phones(self, phones):
        ui = self.ui
        self.clear(self.phones)
        for phone in phones:
            forget = self.button(_("Forget"), _("Forget {name}").format(name=phone["name"]),
                                 lambda p=phone: self.send(["forget", p["id"]]))
            self.phones.add(ui.row(phone["name"], forget, _("Connected") if phone["connected"] else _("Not connected")))
        if not phones:
            self.phones.add(ui.row(_("None yet"), subtitle=_("Add Phone pairs one")))
        self.phones.show_all()

    def fill_networks(self, networks):
        ui = self.ui
        self.clear(self.networks)
        for network in networks:
            title = network["name"] or _("A network that's gone")
            forget = self.button(_("Forget"), _("Forget {name}").format(name=title),
                                 lambda n=network: self.send(["network", "remove", n["uuid"]]))
            self.networks.add(ui.row(title, forget, _("This network") if network["active"] else ""))
        if not networks:
            self.networks.add(ui.row(_("None yet"), subtitle=_("Pairing a phone adds the network it's on")))
        self.networks.show_all()

    def fill_received(self, items):
        ui, Gtk = self.ui, self.ui.Gtk
        self.clear(self.received)
        for item in reversed(items):
            kind, value = item.get("kind"), item.get("value", "")
            subtitle = f"{item.get('device', '')} · {when_received(item.get('time', 0))}"
            buttons = Gtk.Box(spacing=6)
            if kind == "page":
                title = short_address(value)
                buttons.pack_start(self.button(_("Open"), _("Open {name}").format(name=title), lambda v=value: ui.start_app(
                    ["xdg-open", v])), False, False, 0)
            elif kind == "file":
                title = os.path.basename(value)
                folder = os.path.dirname(value)
                if not item.get("exists"):
                    subtitle += " · " + _("no longer there")
                else:
                    if item.get("openable"):
                        buttons.pack_start(self.button(_("Open"), _("Open {name}").format(name=title), lambda v=value: ui.start_app(
                            ["xdg-open", v])), False, False, 0)
                    buttons.pack_start(self.button(_("Show in Folder"), _("Show {name} in its folder").format(name=title),
                                                   lambda f=folder: ui.start_app(["xdg-open", f])), False, False, 0)
            else:
                lines = value.strip().splitlines()
                title = (lines[0] if lines else "") or _("Text")
                title = title if len(title) <= 60 else title[:59] + "…"
                if kind == "clipboard":
                    subtitle = _("Clipboard") + " · " + subtitle
                buttons.pack_start(self.button(_("Copy"), _("Copy {name}").format(name=title), lambda v=value: ui.start_app(
                    ["wl-copy", "--", v])), False, False, 0)
                if item.get("address"):
                    buttons.pack_start(self.button(_("Open"), _("Open the address in {name}").format(name=title), lambda a=item["address"]:
                                                   ui.start_app(["xdg-open", a])), False, False, 0)
            self.received.add(ui.row(title, buttons if buttons.get_children() else None, subtitle))
        if not items:
            self.received.add(ui.row(_("Nothing yet"), subtitle=_("What a phone sends shows here for a week")))
        self.received.show_all()

    def fill_notification_apps(self, apps, on):
        ui = self.ui
        self.clear(self.note_apps)
        if not on:
            self.note_apps_frame.hide()
            return
        if not self.note_apps_frame.get_visible():
            reveal(self.note_apps_frame)
        self.quiet = True
        for app in apps:
            switch = ui.Gtk.Switch()
            switch.set_active(bool(app.get("allowed")))
            name = app.get("name", "")
            switch.connect("notify::active", lambda widget, _param, app_name=name: self.app_toggled(widget, app_name))
            self.note_apps.add(ui.row(name, switch))
        if not apps:
            self.note_apps.add(ui.row(_("None yet"), subtitle=_("An app appears here after the phone sends a notification from it")))
        self.quiet = False
        self.note_apps.show_all()

    def fill_commands(self, commands):
        ui = self.ui
        self.clear(self.command_rows)
        for command in commands:
            name = command.get("name") or _("Command")
            key = command.get("key") or ""
            remove = self.button(_("Remove"), _("Remove {name}").format(name=name),
                                 lambda command_key=key: self.send(["commands", "remove", command_key]))
            if not key:
                remove.set_sensitive(False)
            self.command_rows.add(ui.row(name, remove, command.get("command") or ""))
        if not commands:
            self.command_rows.add(ui.row(_("None yet"), subtitle=_("Add Command adds one. The phone sees the name.")))
        self.command_rows.show_all()

    def add_command(self, _button):
        """Add Command…: a name and the command line. The phone is sent the name."""
        Gtk = self.ui.Gtk
        dialog = Gtk.Dialog(title=_("Add Command"), transient_for=self.widget.get_toplevel(), modal=True,
                            resizable=False)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        add = dialog.add_button(_("_Add"), Gtk.ResponseType.OK)
        add.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=8, column_spacing=12, margin=18)
        grid.attach(self.ui.label(_("It runs as you, on this computer. The phone is sent the name, "
                                  "and can run only this command.")), 0, 0, 2, 1)
        name = Gtk.Entry(activates_default=True, hexpand=True, width_chars=36)
        command = Gtk.Entry(activates_default=True, hexpand=True, width_chars=36)
        grid.attach(Gtk.Label(label=_("_Name"), xalign=1, use_underline=True, mnemonic_widget=name), 0, 1, 1, 1)
        grid.attach(name, 1, 1, 1, 1)
        grid.attach(Gtk.Label(label=_("Comman_d"), xalign=1, use_underline=True, mnemonic_widget=command), 0, 2, 1, 1)
        grid.attach(command, 1, 2, 1, 1)
        dialog.get_content_area().add(grid)

        def check(*_args):
            add.set_sensitive(bool(name.get_text().strip() and command.get_text().strip()))

        name.connect("changed", check)
        command.connect("changed", check)
        check()
        dialog.show_all()
        name.grab_focus()
        response = dialog.run()
        values = (name.get_text(), command.get_text())
        dialog.destroy()
        if response == Gtk.ResponseType.OK and all(part.strip() for part in values):
            self.send(["commands", "add", "--", *values])

    def notifications_toggled(self, switch, _param):
        if self.quiet:
            return
        self.send(["set", "notifications", "yes" if switch.get_active() else "no"])

    def calls_toggled(self, switch, _param):
        if self.quiet:
            return
        self.send(["set", "calls", "yes" if switch.get_active() else "no"])

    def media_toggled(self, switch, _param):
        if self.quiet:
            return
        self.send(["set", "media", "yes" if switch.get_active() else "no"])

    def app_toggled(self, switch, name):
        if self.quiet or not name:
            return
        action = "allow" if switch.get_active() else "block"
        words = ["notifications", action]
        if name.startswith("-"):
            words.append("--")
        self.send([*words, name])

    def send(self, words, then=None):
        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.shown_lists = None
            self.refresh()
            if then:
                then()

        self.ui.run_async([PHONE, *words], done)

    def toggled(self, switch, _param):
        if self.quiet:
            return
        # The daemon takes a moment to start: read once more a little later.
        self.send(["set", "enabled", "yes" if switch.get_active() else "no"],
                  lambda: self.ui.GLib.timeout_add(1500, lambda: self.refresh() or False))

    def rename(self, *_args):
        if self.state is None:
            return False
        text = self.name.get_text().strip()
        if text != self.state["own_name"]:
            self.send(["set", "name", text or DEFAULT_CHOICE])
        return False

    def firewall_toggled(self, switch, _param):
        if self.quiet:
            return
        self.status.set_text(_("Waiting for the password…"))

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.refresh()

        self.ui.run_async([*SELF, "system", "firewall.phones", "on" if switch.get_active() else "off"], done)

    def add_phone(self, _button):
        """Add Phone…: `flickos-phone pair --json` until the phone asks, its key,
        and Pair or Cancel as the answer."""
        ui, Gtk, Gio, GLib = self.ui, self.ui.Gtk, self.ui.Gio, self.ui.GLib
        dialog = Gtk.Dialog(title=_("Add Phone"), transient_for=self.widget.get_toplevel(), modal=True,
                            resizable=False)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        pair = dialog.add_button(_("_Pair"), Gtk.ResponseType.OK)
        pair.get_style_context().add_class("suggested-action")
        pair.set_sensitive(False)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=18)
        name = (self.state or {}).get("name") or _("this computer")
        # Translators: {name} is this computer's name in the KDE Connect app; Pair
        # is that app's button (in its words in your language).
        box.pack_start(ui.label(_("1. Install the KDE Connect app on the phone, from F-Droid or Google Play.\n"
                                  "2. Connect the phone to the same network as this computer.\n"
                                  "3. In the app, choose {name} and tap Pair.").format(name=name)), False, False, 0)
        waiting = Gtk.Box(spacing=8)
        spinner = Gtk.Spinner(active=True)
        message = ui.label(_("Waiting for the phone…"))
        waiting.pack_start(spinner, False, False, 0)
        waiting.pack_start(message, True, True, 0)
        box.pack_start(waiting, False, False, 0)
        key = ui.label("", wrap=False)
        key.set_selectable(True)
        key.set_halign(Gtk.Align.CENTER)
        key.set_no_show_all(True)
        box.pack_start(key, False, False, 0)
        dialog.get_content_area().add(box)
        dialog.show_all()
        session = {"asked": False, "over": False, "closed": False}
        flags = Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE
        try:
            process = Gio.Subprocess.new([PHONE, "pair", "--json"], flags)
        except GLib.Error as failure:
            spinner.stop()
            message.set_text(failure.message)
            session["over"] = True
            process = None
        else:
            process.wait_async(None, None, None)        # reaped when it exits

        def finish(text=""):
            session["over"] = True
            spinner.stop()
            spinner.hide()
            pair.set_sensitive(False)
            if text:
                message.set_text(text)

        def on_line(stream, result):
            if session["closed"]:
                return
            try:
                line, _skip = stream.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:                    # it has ended
                if not session["over"]:
                    finish(_("Pairing stopped. Try again."))
                return
            try:
                event = json.loads(line)
            except ValueError:                  # an error message instead of an event
                finish("\n".join(output_messages(line, "")))
                stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)
                return
            kind = event.get("event")
            if kind == "waiting" and event.get("firewall") and not phones_allowed():
                message.set_text(_("Waiting for the phone… The firewall is on, so the phone can't reach this "
                                 "computer until Let phones through the firewall is on."))
            elif kind == "request":
                session["asked"] = True
                spinner.stop()
                spinner.hide()
                message.set_text(_("{phone} asks to pair. Pair only if the phone shows the same key:").format(
                    phone=event.get("name") or _("A phone")))
                key.set_markup(f"<big><big><b>{GLib.markup_escape_text(event.get('key', ''))}</b></big></big>")
                key.show()
                pair.set_sensitive(True)
                pair.grab_focus()
            elif kind == "paired":
                session["over"] = session["closed"] = True
                dialog.destroy()
                self.status.set_text(_("Paired with {phone}.").format(phone=event.get("name") or _("the phone")))
                self.shown_lists = None
                self.refresh()
                return
            elif kind == "timeout":
                finish(ngettext("No phone asked to pair in {count} minute. Try again.",
                                "No phone asked to pair in {count} minutes. Try again.",
                                PHONE_PAIR_MINUTES).format(count=PHONE_PAIR_MINUTES))
            elif kind == "failed":
                finish(_("The phone went away before pairing finished. Try again."))
            elif kind == "refused":
                finish()
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        def answer(text):
            with contextlib.suppress(GLib.Error):
                stdin = process.get_stdin_pipe()
                stdin.write_all(text.encode(), None)
                stdin.close(None)

        def response(_dialog, response_id):
            if response_id == Gtk.ResponseType.OK and session["asked"] and not session["over"]:
                answer("yes\n")
                pair.set_sensitive(False)
                message.set_text(_("Pairing…"))
                return
            if process is not None and not session["over"]:
                if session["asked"]:
                    answer("no\n")
                else:
                    process.force_exit()        # the daemon closes the window when it goes
            session["closed"] = True
            dialog.destroy()

        dialog.connect("response", response)
        if process is not None:
            Gio.DataInputStream.new(process.get_stdout_pipe()).read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)


def teacher_window_installed():
    """Settings > Classroom: whether this computer has the teacher's window."""
    return os.path.exists(CLASSROOM_TEACHER)


def reveal(widget):
    """Show a widget kept out of the window's show_all (no_show_all) with what
    is in it: show_all() alone does nothing on such a widget."""
    widget.set_no_show_all(False)
    widget.show_all()
    widget.set_no_show_all(True)


def phone_summary(state):
    """The subtitle of the Phone page's switch."""
    if not state["enabled"]:
        return _("Off")
    connected = [phone["name"] for phone in state["phones"] if phone["connected"]]
    if connected:
        return _("Connected to {phones}").format(phones=", ".join(connected))
    if state.get("blocked"):
        return _("KDE Connect is already running on this computer. Use it, or quit it to use this.")
    if not state["running"]:
        return _("Not running: turn it off and on again")
    if not state["phones"]:
        return _("On. Add a phone below.")
    if not state["listening"]:
        return _("Waiting for a network where a phone was paired")
    return _("Waiting for the phone")


def short_address(url, limit=60):
    """Host and path of an address, without the tracking after them."""
    text = re.sub(r"^[a-z][a-z0-9+.-]*://(www\.)?", "", url, flags=re.I)
    text = re.split(r"[?#]", text, maxsplit=1)[0].rstrip("/") or url
    return text if len(text) <= limit else text[:limit - 1] + "…"


def when_received(seconds, now=None):
    """14:02, Yesterday 14:02, or Tue 22 Sep: when something came from a phone."""
    moment = datetime.datetime.fromtimestamp(seconds)
    today = (now or datetime.datetime.now()).date()
    if moment.date() == today:
        return moment.strftime("%H:%M")
    if (today - moment.date()).days == 1:
        return _("Yesterday {time}").format(time=moment.strftime("%H:%M"))
    return moment.strftime("%a %d %b")


class HistoryPage:
    """The changes to the desktop's settings, one framed list per day, each
    with Undo while it can be undone (`flickos-control history`)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label(_("Changes to your desktop's settings and to the installed software, newest "
                                "first. Undo puts a setting back the way it was before, or removes an app that "
                                "was installed, or installs one again that was removed.")), False, False, 0)
        # Above the list, which can be long: an undo's result shows where it was clicked (WIN-10).
        self.status = ui.status_label()
        self.status.set_no_show_all(True)
        box.pack_start(self.status, False, False, 0)
        self.put_back = Gtk.Button.new_with_mnemonic(_("_Put Back as It Was…"))
        self.put_back.set_halign(Gtk.Align.START)
        self.put_back.set_tooltip_text(_("Put the settings back as they were on an earlier day"))
        self.put_back.set_no_show_all(True)
        self.put_back.connect("clicked", self.ask_restore)
        box.pack_start(self.put_back, False, False, 0)
        self.names = {}
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.days = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(self.days, False, False, 0)
        box.pack_start(ui.heading(_("Keeping a history")), False, False, 0)
        frame, listbox = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.switched)
        listbox.add(ui.row(_("Keep a history of changes"), self.switch,
                           _("Only for your account, and only on this computer")))
        clear = Gtk.Button.new_with_mnemonic(_("C_lear History…"))
        clear.connect("clicked", lambda _b: self.ask_clear(off=False))
        listbox.add(ui.row(_("Forget the changes kept so far"), clear))
        box.pack_start(frame, False, False, 0)

    def read(self):
        settings = shape_history(read_history())
        try:
            software, problem = software_changes(), None
        except ControlError as error:
            software, problem = [], _("The software changes can't be read: {error}").format(error=error)
        points = []
        if recovery_available():
            with contextlib.suppress(ControlError):
                points = history_restore_points(recovery_state())
        changes = sorted(settings + software + points, key=lambda change: change.when, reverse=True)
        shown = changes[:HISTORY_ROWS]
        names = history_names([c for c in shown if isinstance(c, Change)], clock=bool(changes))
        # The apps' names, looked up here, not in the main loop.
        learn_app_names([p for c in shown if isinstance(c, SoftwareChange) for p in c.packages[:APP_NAMES_SHOWN]])
        return changes, names, history_enabled(), problem

    def shown(self):
        self.loading.show_all()
        self.ui.background(self.read, self.show, key=(self, "read"))

    def show(self, result, error):
        Gtk = self.ui.Gtk
        self.loading.hide()
        for child in self.days.get_children():
            self.days.remove(child)
        if error:
            self.say(error)
            return
        changes, names, enabled, problem = result
        self.names = names
        self.put_back.set_visible(enabled and any(isinstance(change, Change) for change in changes))
        if problem:
            self.say(problem)
        self.quiet = True
        self.switch.set_active(enabled)
        self.quiet = False
        if not changes:
            self.days.pack_start(self.ui.label(_("Changes you make to your desktop's settings and your software "
                                               "will show here.") if enabled else _("The history is off."), dim=True),
                                 False, False, 0)
        today = datetime.datetime.now().astimezone().date()
        clock = "%I:%M %p" if names.get("clock") == "12h" else "%H:%M"
        listbox = day = None
        for change in changes[:HISTORY_ROWS]:
            when = change.when.astimezone()
            if when.date() != day:
                day = when.date()
                heading = (_("Today") if day == today else _("Yesterday") if day == today - datetime.timedelta(days=1)
                           else when.strftime("%A %x"))
                self.days.pack_start(self.ui.heading(heading), False, False, 0)
                frame, listbox = self.ui.framed_list()
                self.days.pack_start(frame, False, False, 0)
            title, detail = describe(change, names)
            details = [detail] if detail else []
            details.append(when.strftime(clock))
            if not change.newest:
                details.append(_("Changed again since"))
            button = None
            if isinstance(change, RestorePoint):
                button = Gtk.Button.new_with_mnemonic(_("Put Back…"))
                # Translators: a button's name for screen readers, then the restore point.
                button.get_accessible().set_name(_("Put back: {change}").format(change=title))
                button.set_sensitive(not change.waiting)
                button.connect("clicked", self.put_back_point, change.name)
            elif change.undoable:
                button = Gtk.Button.new_with_label(_("Undo"))
                # Translators: a button's name for screen readers, then the change.
                button.get_accessible().set_name(_("Undo: {change}").format(change=title))
                if isinstance(change, SoftwareChange):
                    button.set_tooltip_text(_("Remove it again") if change.kind == "install" else _("Install it again"))
                    button.connect("clicked", self.undo_software, change)
                else:
                    old = value_name(change.owner, change.key, change.old, names)
                    button.set_tooltip_text(_("Change it back to {value}").format(value=old) if detail else
                                            _("Change it back"))
                    button.connect("clicked", self.undo, change.id)
            listbox.add(self.ui.row(title, button, " · ".join(details)))
        if len(changes) > HISTORY_ROWS:
            older = len(changes) - HISTORY_ROWS
            self.days.pack_start(self.ui.label(ngettext(
                "{count} older change is left out here. {command} lists them all.",
                "{count} older changes are left out here. {command} lists them all.", older).format(
                    count=older, command="flickos-control history"), dim=True), False, False, 0)
        self.days.show_all()

    def say(self, text):
        self.status.set_text(text)
        self.status.set_visible(bool(text))

    def undo(self, button, change_id):
        button.set_sensitive(False)
        self.say("")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.say("\n".join(messages) if messages or ok else _("Not undone."))
            self.shown()

        self.ui.run_async([*SELF, "history", "undo", change_id], done)

    def ask_restore(self, _button):
        """Choose a day and see what goes back before anything does."""
        Gtk, ui = self.ui.Gtk, self.ui
        entries = read_history()
        today = datetime.date.today()
        days = sorted({entry["when"].astimezone().date() for entry in entries}, reverse=True)
        dialog = Gtk.Dialog(title=_("Put Back as It Was"), transient_for=self.widget.get_toplevel(), modal=True)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        ok = dialog.add_button(_("_Put Back"), Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        dialog.set_default_size(560, 480)
        area = dialog.get_content_area()
        area.set_spacing(12)
        area.set_border_width(12)
        area.pack_start(ui.label(_("Put your settings back as they were before the changes of:")), False, False, 0)
        choice = Gtk.ComboBoxText()
        for day in days:
            start = datetime.datetime.combine(day, datetime.time.min).astimezone()
            name = (_("Today") if day == today else _("Yesterday") if day == today - datetime.timedelta(days=1)
                    else start.strftime("%A %x"))
            choice.append((start - datetime.timedelta(microseconds=1)).isoformat(), name)
        choice.get_accessible().set_name(_("Day"))
        area.pack_start(choice, False, False, 0)
        frame, listbox = ui.framed_list()
        scrolled = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, min_content_height=220)
        scrolled.add(frame)
        area.pack_start(scrolled, True, True, 0)
        area.pack_start(ui.label(_("System settings and software stay as they are: each has its own Undo."),
                                 dim=True), False, False, 0)

        def fill(_combo):
            for child in listbox.get_children():
                listbox.remove(child)
            plan = restore_plan(parse_when(choice.get_active_id()), entries) if choice.get_active_id() else []
            for change in plan:
                title, _skip = describe(dataclasses.replace(change, old=change.new, new=change.old), self.names)
                # Translators: the value a setting has now, before it is put back.
                listbox.add(ui.row(title, None, _("Now {value}").format(
                    value=value_name(change.owner, change.key, change.new, self.names))))
            if not plan:
                listbox.add(ui.row(_("Nothing to put back"), None, _("No setting that can be put back has changed "
                                                                 "since then.")))
            ok.set_sensitive(bool(plan))
            listbox.show_all()

        choice.connect("changed", fill)
        choice.set_active(0)
        dialog.show_all()
        response = dialog.run()
        when = choice.get_active_id()
        dialog.destroy()
        if response != Gtk.ResponseType.OK or not when:
            return
        self.say(_("Putting the settings back…"))

        def done(ok, stdout, stderr):
            messages = [m for m in output_messages("", stderr)]
            self.say(_("Settings put back. The first row below undoes it.") if ok else
                     "\n".join(messages) or _("Not everything was put back."))
            self.shown()

        self.ui.run_async([*SELF, "history", "restore", when], done)

    def put_back_point(self, button, name):
        button.set_sensitive(False)
        self.say(_("Checking what would change…"))

        def done(ok, message):
            self.say(message)
            if ok is not None:
                self.shown()

        ask_put_back(self.ui, self.widget.get_toplevel(), name, done)

    def undo_software(self, button, change):
        """Ask the helper what the undo would do, show it, and only then ask
        for the password (a removal needs the network to be taken back)."""
        button.set_sensitive(False)
        self.say(_("Checking what would change…"))
        self.ui.background(lambda: helper_json(["packages-plan", change.id]),
                           lambda plan, error: self.confirm_software(button, change, plan, error),
                           key=(self, "plan"))

    def confirm_software(self, button, change, plan, error):
        Gtk = self.ui.Gtk
        if error:
            self.say(error)
            button.set_sensitive(True)
            return
        self.say("")
        removing = plan["action"] == "remove"
        names = package_names(change.packages)
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=_("Remove {apps}?").format(apps=names) if removing else
                                   _("Install {apps} again?").format(apps=names))
        dialog.format_secondary_text("\n".join(plan_text(plan) + [_("Changing the software needs an administrator's "
                                                                   "password.")]))
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        ok = dialog.add_button(_("_Remove") if removing else _("_Install"), Gtk.ResponseType.OK)
        ok.get_style_context().add_class("destructive-action" if removing else "suggested-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            button.set_sensitive(True)
            return
        self.say(_("Waiting for the password… Installing and removing software can take a few minutes."))

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.say("\n".join(messages) if messages or ok else _("Not undone."))
            self.shown()

        self.ui.run_async(["pkexec", HELPER, "packages-undo", change.id], done)

    def switched(self, switch, _param):
        if self.quiet or switch.get_active() == history_enabled():
            return
        if switch.get_active():
            self.run([*SELF, "set", "history.enabled", "yes"])
        else:
            # Not inside the switch's own signal: a dialog run there sees the click again.
            self.ui.GLib.idle_add(self.ask_clear, True)

    def ask_clear(self, off):
        """Turning the history off also forgets it: both ask first (WIN-13)."""
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=_("Turn off and clear the history?") if off else _("Clear the history?"))
        dialog.format_secondary_text(_("The changes made so far can no longer be undone here."))
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        button = dialog.add_button(_("_Turn Off") if off else _("C_lear History"), Gtk.ResponseType.OK)
        button.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            if off:
                self.quiet = True
                self.switch.set_active(True)
                self.quiet = False
            return False
        self.run([*SELF, "set", "history.enabled", "no"] if off else [*SELF, "history", "clear"])
        return False                # once, from idle_add

    def run(self, command):
        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.say("\n".join(messages) if messages or ok else _("Not changed."))
            self.shown()

        self.ui.run_async(command, done)


class MorePage:
    """Tiles that start the apps for the other settings."""

    def __init__(self, ui):
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        box.pack_start(ui.label(_("These settings open in their own window.")), False, False, 0)
        tiles = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, column_spacing=12,
                            row_spacing=12, max_children_per_line=4, valign=Gtk.Align.START)
        available = available_tiles()
        if not available:
            box.pack_start(ui.label(_("None of these apps is installed: {apps}.").format(
                apps=", ".join(tile.command[0] for tile in TILES)), dim=True), False, False, 0)
        for tile in available:
            button = Gtk.Button(relief=Gtk.ReliefStyle.NONE)
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=6)
            # The first name the icon theme (with the themes it inherits) has:
            # GTK itself would try every name in one theme before the next.
            theme = Gtk.IconTheme.get_default()
            name = next((n for n in (*tile.icons, *TILE_FALLBACK_ICONS) if theme.has_icon(n)), tile.icons[0])
            icon = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.DIALOG)
            content.pack_start(icon, False, False, 0)
            content.pack_start(Gtk.Label(label=tile.name), False, False, 0)
            button.add(content)
            # Translators: {app} is the tile's name, {program} the app's command: "Open Sound (pavucontrol)".
            button.set_tooltip_text(_("Open {app} ({program})").format(app=tile.name, program=tile.command[0]))
            button.connect("clicked", lambda _b, t=tile: ui.start_app(t.argv))
            tiles.add(button)
        box.pack_start(tiles, False, False, 0)

    def shown(self):
        pass


FIREFOX_MEMORY_TEXT = (_("Fewer processes: tabs of one site share one, and no spare one waits for the next tab. "
                       "For everyone on this computer. Firefox uses it the next time it starts."))


def memory_state():
    """What the Memory page shows: {"total", "used"} in kB (None when
    /proc/meminfo can't be read), "firefox" (firefox_memory_state()) and
    "old" (old_computer()'s reasons)."""
    meminfo = read_text(os.path.join(PROC, "meminfo"))
    total = memory_kb(meminfo)
    available = re.search(r"^MemAvailable:\s+(\d+) kB", meminfo, re.M)
    used = total - int(available.group(1)) if total is not None and available else None
    return {"total": total, "used": used, "firefox": firefox_memory_state(), "old": old_computer()}


class MemoryPage:
    """How much memory this computer has and uses, and what makes it use less
    (docs/design/flickos-memory.md; so far only its This computer section,
    with Firefox's system setting from docs/design/flickos-firefox.md)."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label(_("How much memory this computer has and uses, and what can make it use less.")),
                       False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        box.pack_start(ui.heading(_("This computer")), False, False, 0)
        self.reasons = ui.label("", dim=True)
        self.reasons.set_no_show_all(True)
        box.pack_start(self.reasons, False, False, 0)
        frame, listbox = ui.framed_list()
        self.total, self.used = ui.label("", wrap=False), ui.label("", wrap=False)
        listbox.add(ui.row(_("Memory"), self.total))
        listbox.add(ui.row(_("In use"), self.used, _("What can't be freed without moving it to swap")))
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.changed)
        self.firefox = ui.row(_("Firefox: use less memory"), self.switch, FIREFOX_MEMORY_TEXT)
        self.firefox.set_no_show_all(True)
        listbox.add(self.firefox)
        box.pack_start(frame, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    def changed(self, switch, _param):
        if self.quiet:
            return
        self.status.set_text(_("Waiting for the password…"))

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.shown()

        self.ui.run_async([*SELF, "system", "firefox.memory", "on" if switch.get_active() else "off"], done)

    def shown(self):
        self.ui.background(memory_state, self.fill, key="memory")

    def fill(self, state, error):
        self.loading.hide()
        if error:
            self.status.set_text(error)
            return
        self.total.set_text(gigabytes(state["total"]) if state["total"] is not None else _("Unknown"))
        self.used.set_text(gigabytes(state["used"]) if state["used"] is not None else _("Unknown"))
        self.reasons.set_text(" ".join(state["old"]))
        self.reasons.set_visible(bool(state["old"]))
        firefox = state["firefox"]
        if firefox is None:             # no Debian firefox-esr: nothing reads the file
            self.firefox.hide()
            return
        self.firefox.set_no_show_all(False)
        self.firefox.show_all()
        self.quiet = True
        self.switch.set_active(firefox)
        self.quiet = False
        text = (_("Recommended for this computer.") + " " if state["old"] and not firefox else "") + FIREFOX_MEMORY_TEXT
        if live_session():
            text += " " + _("In the live session until it restarts.")
        self.ui.set_subtitle(self.firefox, text)


class AboutPage:
    """What this system is, and a copy of it for bug reports."""

    def __init__(self, ui):
        self.ui = ui
        Gtk = ui.Gtk
        self.widget, box = ui.page()
        head = Gtk.Box(spacing=16)
        # flickos-branding's logo (hicolor). GTK looks for every name in a
        # theme before the next theme, so a fallback name that Numix has would
        # win over hicolor's logo: fall back only when there is no logo.
        if Gtk.IconTheme.get_default().has_icon("flickos"):
            logo = Gtk.Image.new_from_icon_name("flickos", Gtk.IconSize.DIALOG)
        else:
            logo = Gtk.Image.new_from_gicon(ui.Gio.ThemedIcon.new_from_names(
                ["distributor-logo", "computer"]), Gtk.IconSize.DIALOG)
        logo.set_pixel_size(96)
        head.pack_start(logo, False, False, 0)
        self.title = ui.label("", wrap=False, markup=True)
        self.title.set_valign(Gtk.Align.CENTER)
        head.pack_start(self.title, False, False, 0)
        box.pack_start(head, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        frame, self.rows = ui.framed_list()
        box.pack_start(frame, False, False, 0)
        self.fleet_row = None
        self.fleet = None
        if shutil.which(FLEET):
            self.add_fleet(box)
        buttons = Gtk.Box(spacing=12)
        copy = Gtk.Button.new_with_mnemonic(_("_Copy System Info"))
        copy.set_tooltip_text(_("For a bug report: the facts above and the versions of FlickOS's packages"))
        copy.connect("clicked", self.copy)
        buttons.pack_start(copy, False, False, 0)
        save = Gtk.Button.new_with_mnemonic(_("_Save Report…"))
        save.set_tooltip_text(_("For a bug report: the facts above and what the desktop logged, in a file. "
                              "Nothing is sent"))
        save.connect("clicked", self.save)
        buttons.pack_start(save, False, False, 0)
        # Reading the file is the last check on what the logs say (without_names).
        self.open_report = Gtk.Button.new_with_mnemonic(_("_Open Report"))
        self.open_report.set_no_show_all(True)
        self.open_report.connect("clicked", lambda _button: ui.start_app(["xdg-open", self.report]))
        buttons.pack_start(self.open_report, False, False, 0)
        buttons.pack_start(Gtk.LinkButton.new_with_label(REPORT_URL, _("Report a Problem")), False, False, 0)
        box.pack_start(buttons, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)
        self.report = None
        self.filled = False

    def copy(self, button):
        """wl-copy (wlr-data-control, as cliphist uses) keeps the text after
        this window closes and needs no input event; GTK's clipboard is the
        fallback."""
        def work():
            text = system_info_text()
            try:
                subprocess.run(["wl-copy"], input=text, text=True, timeout=COMMAND_SECONDS, check=True,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except (OSError, subprocess.SubprocessError):
                return text
            return None

        def done(text, error):
            button.set_sensitive(True)
            if error:
                self.status.set_text(error)
                return
            if text is not None:
                from gi.repository import Gdk      # loaded with Gtk 3 (load_gtk)
                clipboard = self.ui.Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
                clipboard.set_text(text, -1)
                clipboard.store()
            self.status.set_text(_("Copied. Paste it into your bug report."))

        button.set_sensitive(False)
        self.ui.background(work, done)

    def save(self, button):
        Gtk, GLib = self.ui.Gtk, self.ui.GLib
        dialog = Gtk.FileChooserDialog(title=_("Save Report"), transient_for=self.widget.get_toplevel(), modal=True,
                                       action=Gtk.FileChooserAction.SAVE)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        dialog.add_button(_("_Save"), Gtk.ResponseType.ACCEPT).get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.ACCEPT)
        dialog.set_do_overwrite_confirmation(True)
        folder = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS)
        dialog.set_current_folder(folder if folder and os.path.isdir(folder) else GLib.get_home_dir())
        dialog.set_current_name(f"flickos-report-{datetime.date.today():%Y-%m-%d}.txt")
        try:
            path = dialog.get_filename() if dialog.run() == Gtk.ResponseType.ACCEPT else None
        finally:
            dialog.destroy()
        if not path:
            return

        def done(_result, error):
            button.set_sensitive(True)
            if error:
                self.status.set_text(error)
                return
            self.report = path
            self.open_report.show()
            self.status.set_text(_("Saved as {path}. Nothing has been sent. "
                                   "Read it, then attach it to your bug report.").format(path=path))

        button.set_sensitive(False)
        self.open_report.hide()
        self.status.set_text(_("Saving…"))
        self.ui.background(lambda: save_report(path), done)

    def add_fleet(self, box):
        """The Organization row (flickos-fleet, ADR-005): who manages this
        computer, what is sent, and joining or leaving through pkexec."""
        Gtk = self.ui.Gtk
        frame, listbox = self.ui.framed_list()
        buttons = Gtk.Box(spacing=6)
        sent = Gtk.Button.new_with_mnemonic(_("What Is _Sent"))
        sent.set_tooltip_text(_("Everything this computer sends to the organization's service"))
        sent.connect("clicked", lambda _button: self.ui.start_app(["xdg-open", FLEET_PRIVACY]))
        buttons.pack_start(sent, False, False, 0)
        self.join_button = Gtk.Button.new_with_mnemonic(_("_Join an Organization…"))
        self.join_button.connect("clicked", self.ask_join)
        self.leave_button = Gtk.Button.new_with_mnemonic(_("_Leave…"))
        self.leave_button.connect("clicked", self.ask_leave)
        for button in (self.join_button, self.leave_button):
            button.set_no_show_all(True)
            buttons.pack_start(button, False, False, 0)
        self.fleet_row = self.ui.row(_("Organization"), buttons, " ")
        listbox.add(self.fleet_row)
        box.pack_start(frame, False, False, 0)
        self.fleet_status = self.ui.status_label()
        box.pack_start(self.fleet_status, False, False, 0)

    def read_fleet(self):
        self.ui.background(lambda: fleet_state(run([FLEET, "status", "--json"])), self.show_fleet,
                           key=(self, "fleet"))

    def show_fleet(self, state, error):
        if error:
            self.ui.set_subtitle(self.fleet_row, error)
            return
        self.fleet = state
        self.ui.set_subtitle(self.fleet_row, fleet_summary(state))
        self.join_button.set_visible(not state["joined"] and not live_session())
        self.leave_button.set_visible(state["joined"])

    def fleet_done(self, ok, stdout, stderr):
        messages = output_messages(stdout, stderr)
        self.fleet_status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
        self.read_fleet()

    def ask_join(self, _button):
        Gtk = self.ui.Gtk
        dialog = Gtk.Dialog(title=_("Join an Organization"), transient_for=self.widget.get_toplevel(), modal=True,
                            resizable=False)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        ok = dialog.add_button(_("_Next"), Gtk.ResponseType.OK)
        ok.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=8, column_spacing=12, margin=18)
        dialog.get_content_area().add(grid)
        entry = Gtk.Entry(activates_default=True, hexpand=True, width_chars=24)
        grid.attach(Gtk.Label(label=_("_Join code"), xalign=1, use_underline=True, mnemonic_widget=entry), 0, 0, 1, 1)
        grid.attach(entry, 1, 0, 1, 1)
        hint = self.ui.label(_("The code from your organization's dashboard. You'll see the organization's name "
                             "before anything changes."), dim=True)
        hint.set_max_width_chars(50)
        grid.attach(hint, 1, 1, 1, 1)
        entry.connect("changed", lambda _entry: ok.set_sensitive(bool(FLEET_CODE.match(entry.get_text().strip()))))
        ok.set_sensitive(False)
        dialog.show_all()
        response = dialog.run()
        code = entry.get_text().strip()
        dialog.destroy()
        if response != Gtk.ResponseType.OK or not FLEET_CODE.match(code):
            return
        self.fleet_status.set_text(_("Checking the code…"))
        self.ui.background(lambda: fleet_lookup(code), lambda org, error: self.confirm_join(code, org, error))

    def confirm_join(self, code, org, error):
        if error:
            self.fleet_status.set_text(error)
            return
        self.fleet_status.set_text("")
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=_("Let {org} manage this computer?").format(org=org))
        dialog.format_secondary_text(_("Its settings, apps and updates will be set from {org}'s dashboard, and it "
                                     "will send what “What Is Sent” lists. An administrator of this computer can "
                                     "leave at any time.").format(org=org))
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        join = dialog.add_button(_("_Join"), Gtk.ResponseType.OK)
        join.get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.fleet_status.set_text(_("Waiting for the password…"))
            self.ui.run_async(["pkexec", shutil.which(FLEET) or "/usr/bin/flickos-fleet", "join", code, "--yes"],
                              self.fleet_done)

    def ask_leave(self, _button):
        Gtk = self.ui.Gtk
        org = (self.fleet or {}).get("org") or _("the organization")
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=_("Stop {org} managing this computer?").format(org=org))
        dialog.format_secondary_text(_("This computer stops checking in with {org}. Its settings and apps stay as "
                                     "they are, and the desktop's defaults are FlickOS's own again.").format(org=org))
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        leave = dialog.add_button(_("_Leave"), Gtk.ResponseType.OK)
        leave.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.fleet_status.set_text(_("Waiting for the password…"))
            self.ui.run_async(["pkexec", shutil.which(FLEET) or "/usr/bin/flickos-fleet", "leave"], self.fleet_done)

    def shown(self):
        if self.fleet_row is not None:
            self.read_fleet()
        if self.filled:
            return
        self.filled = True
        self.ui.background(system_info, self.fill)

    def fill(self, rows, error):
        self.loading.hide()
        if error:
            self.status.set_text(error)
            return
        name = next((value for label, value in rows if label == "FlickOS"), "FlickOS")
        self.title.set_markup(f"<big><b>{self.ui.GLib.markup_escape_text(name)}</b></big>\n"
                              + self.ui.GLib.markup_escape_text(_("A light Debian desktop")))
        for label, value in rows:
            if label == "FlickOS":
                continue
            text = self.ui.label(value, wrap=True)
            text.set_selectable(True)
            text.set_xalign(1)
            self.rows.add(self.ui.row(_(label), text))
        self.rows.show_all()


class ClassroomPage:
    """Sharing this screen with a teacher (flickos-classroom-view, installed
    by choice). It owns nothing: `student status` reads, `student on|off`
    and `forget` change, `student pair` opens the pairing window. The
    firewall's rule for the teacher's computer is a system setting
    (firewall.classroom, through the helper), shown while ufw is on."""

    def __init__(self, ui):
        Gtk = ui.Gtk
        self.ui = ui
        self.widget, box = ui.page()
        self.quiet = False
        box.pack_start(ui.label(_("A teacher's computer you pair with can see this screen while you're on the same "
                                "network, lock it during a class, show you a message or open a web page. The icon "
                                "in the panel shows when your screen can be seen, and turns red while the teacher "
                                "is looking. Nothing is recorded.")), False, False, 0)
        frame, rows = ui.framed_list()
        self.switch = Gtk.Switch()
        self.switch.connect("notify::active", self.toggled)
        self.switch_row = ui.row(_("Share this screen with a teacher"), self.switch,
                                 _("Changes apply right away. Off: nothing of it runs."))
        rows.add(self.switch_row)
        box.pack_start(frame, False, False, 0)
        # The paired teachers, one connected at a time (classroom-view ADR-016).
        box.pack_start(ui.heading(_("Teachers")), False, False, 0)
        teachers_frame, self.teacher_rows = ui.framed_list()
        box.pack_start(teachers_frame, False, False, 0)
        self.student_buttons = buttons = Gtk.Box(spacing=8)
        self.pair_button = Gtk.Button.new_with_mnemonic(_("_Pair With a Teacher…"))
        # The pairing window: the page reads again when it closes.
        self.pair_button.connect("clicked", lambda _b: ui.run_async([CLASSROOM, "student", "pair"],
                                                                    lambda *_a: self.refresh()))
        buttons.pack_start(self.pair_button, False, False, 0)
        box.pack_start(buttons, False, False, 0)
        self.firewall_frame, firewall_list = ui.framed_list()
        self.firewall_frame.set_no_show_all(True)
        self.firewall_switch = Gtk.Switch()
        self.firewall_switch.connect("notify::active", self.firewall_toggled)
        firewall_list.add(ui.row(_("Let the teacher's computer through the firewall"), self.firewall_switch,
                                 _("Only from school and home networks. Needs an administrator's password.")))
        box.pack_start(self.firewall_frame, False, False, 0)
        box.pack_start(ui.heading(_("Lab computer")), False, False, 0)
        box.pack_start(ui.label(_("For a school's computers: every account on this computer shares its screen with "
                                "the teachers paired here, and can't turn it off. The panel still shows it."),
                                dim=True), False, False, 0)
        frame, lab_list = ui.framed_list()
        self.lab_switch = Gtk.Switch()
        self.lab_switch.connect("notify::active", self.lab_toggled)
        self.lab_row = ui.row(_("This is a lab computer"), self.lab_switch,
                              _("Needs an administrator's password."))
        lab_list.add(self.lab_row)
        box.pack_start(frame, False, False, 0)
        self.lab_buttons = Gtk.Box(spacing=8, no_show_all=True)
        pair_lab = Gtk.Button.new_with_mnemonic(_("Pair This _Computer With a Teacher…"))
        pair_lab.connect("clicked", self.pair_lab)
        self.lab_buttons.pack_start(pair_lab, False, False, 0)
        box.pack_start(self.lab_buttons, False, False, 0)
        self.teaching = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=box.get_spacing(),
                                no_show_all=True)
        self.teaching.pack_start(ui.heading(_("Teaching a class")), False, False, 0)
        self.teaching.pack_start(ui.label(_("The Classroom window shows the screens of the students who paired "
                                            "with this computer."), dim=True), False, False, 0)
        teach = Gtk.Button.new_with_mnemonic(_("_Open Classroom"))
        teach.set_halign(Gtk.Align.START)
        teach.connect("clicked", lambda _b: ui.start_app([CLASSROOM, "teacher"]))
        self.teaching.pack_start(teach, False, False, 0)
        box.pack_start(self.teaching, False, False, 0)
        self.loading = ui.loading()
        box.pack_start(self.loading, False, False, 0)
        self.status = ui.status_label()
        box.pack_start(self.status, False, False, 0)

    @staticmethod
    def available():
        # Not in the live session: a pairing would be gone at the next boot.
        return shutil.which(CLASSROOM) is not None and not live_session()

    def shown(self):
        self.refresh()

    def refresh(self):
        def read():
            found = dict(line.split("\t", 1) for line in run([CLASSROOM, "student", "status"]).splitlines()
                         if "\t" in line)
            lab = dict(line.split("\t", 1) for line in run([CLASSROOM, "lab", "status"]).splitlines()
                       if "\t" in line)
            found["lab"] = lab.get("lab", "no")
            teachers = [line.split("\t") for line in run([CLASSROOM, "student", "teachers"]).splitlines()]
            found["teachers"] = [t for t in teachers if len(t) >= 4]
            return found, firewall_state(), phones_allowed(CLASSROOM_PROFILE, CLASSROOM_MARK)

        self.ui.background(read, self.show, key=(self, "state"))

    def show(self, result, error):
        self.loading.hide()
        if error:
            self.status.set_text(error)
            return
        found, firewall, allowed = result
        if teacher_window_installed():
            reveal(self.teaching)
        else:
            self.teaching.hide()
        sharing = found.get("sharing") == "on"
        lab = found.get("lab") == "yes"
        self.quiet = True
        self.switch.set_active(sharing)
        self.firewall_switch.set_active(allowed)
        self.lab_switch.set_active(lab)
        self.quiet = False
        # A lab computer: set by its administrator, not by this account (ADR-011).
        self.switch.set_sensitive(not lab)
        self.student_buttons.set_visible(not lab)
        self.ui.set_subtitle(self.switch_row, _("On for every account on this lab computer.") if lab
                             else _("Changes apply right away. Off: nothing of it runs."))
        if lab:
            reveal(self.lab_buttons)
        else:
            self.lab_buttons.hide()
        self.ui.set_subtitle(self.lab_row, _("Every account shares with the teacher above. Set by an administrator.")
                             if lab else _("Needs an administrator's password."))
        self.show_teachers(found, lab)
        self.pair_button.set_sensitive(sharing)
        if firewall and sharing:
            if not self.firewall_frame.get_visible():
                reveal(self.firewall_frame)
        else:
            self.firewall_frame.hide()
        if firewall and sharing and not allowed:
            self.status.set_text(_("The firewall is on: the teacher's computer can't reach this one until you let "
                                   "it through."))

    def toggled(self, switch, _param):
        if self.quiet:
            return
        self.status.set_text("")

        def done(ok, stdout, stderr):
            messages = output_messages(stdout, stderr)
            self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
            self.refresh()

        self.ui.run_async([CLASSROOM, "student", "on" if switch.get_active() else "off"], done)

    def show_teachers(self, found, lab):
        """A row a paired teacher, with its own Forget…; the one connected
        now says so. Teachers set by the organization (Fleet) can't be
        forgotten here."""
        Gtk = self.ui.Gtk
        for child in self.teacher_rows.get_children():
            self.teacher_rows.remove(child)
        connected = found.get("teacher", "")
        teachers = found.get("teachers", [])
        if not teachers:
            text = _("None paired yet: pair this computer below") if lab else _("None paired yet")
            self.teacher_rows.add(self.ui.row(text))
        for fp, name, since, source, *_rest in teachers:
            if name == connected and found.get("state") == "looking":
                subtitle = _("Looking at this screen now")
            elif name == connected:
                subtitle = _("Connected now")
            elif source == "fleet":
                subtitle = _("Set by your organization")
            else:
                subtitle = _("Paired on {date}").format(date=since[:10]) if since else ""
            button = None
            if source != "fleet":
                button = Gtk.Button.new_with_mnemonic(_("_Forget…"))
                button.connect("clicked", lambda _b, f=fp, n=name: self.ask_forget(f, n, lab))
                button.get_accessible().set_name(_("Forget {name}").format(name=name))
            self.teacher_rows.add(self.ui.row(name, button, subtitle))
        self.teacher_rows.show_all()

    def ask_forget(self, fp, name, lab):
        Gtk = self.ui.Gtk
        dialog = Gtk.MessageDialog(transient_for=self.widget.get_toplevel(), modal=True,
                                   message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                                   text=_("Forget {name}?").format(name=name))
        if lab:
            dialog.format_secondary_text(_("No account on this computer shares with {name} any more until the "
                                         "computer is paired with them again.").format(name=name))
        else:
            dialog.format_secondary_text(_("Their computer can't see or lock this screen any more until you pair "
                                         "with it again, with a new code from the teacher."))
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        forget = dialog.add_button(_("_Forget"), Gtk.ResponseType.OK)
        forget.get_style_context().add_class("destructive-action")
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        if lab:
            self.status.set_text(_("Waiting for the password…"))
            self.ui.run_async(["pkexec", CLASSROOM_PKEXEC, "lab", "forget", fp], self.done)
        else:
            self.ui.run_async([CLASSROOM, "student", "forget", fp],
                              lambda ok, stdout, stderr: (self.status.set_text(
                                  "\n".join(output_messages(stdout, stderr)) if not ok else ""), self.refresh()))

    def firewall_toggled(self, switch, _param):
        if self.quiet:
            return
        self.status.set_text(_("Waiting for the password…"))
        self.ui.run_async([*SELF, "system", "firewall.classroom", "on" if switch.get_active() else "off"],
                          self.done)

    def done(self, ok, stdout, stderr):
        messages = output_messages(stdout, stderr)
        self.status.set_text("\n".join(messages) if messages or ok else _("Not changed."))
        self.refresh()

    def lab_toggled(self, switch, _param):
        if self.quiet:
            return
        self.status.set_text(_("Waiting for the password…"))
        self.ui.run_async([*SELF, "system", "classroom.lab", "on" if switch.get_active() else "off"], self.done)

    def pair_lab(self, _button):
        """The code from the teacher's Add Students, then `lab pair CODE` as root."""
        Gtk = self.ui.Gtk
        dialog = Gtk.Dialog(title=_("Pair This Computer With a Teacher"), transient_for=self.widget.get_toplevel(),
                            modal=True)
        dialog.add_button(_("_Cancel"), Gtk.ResponseType.CANCEL)
        dialog.add_button(_("_Pair"), Gtk.ResponseType.OK).get_style_context().add_class("suggested-action")
        dialog.set_default_response(Gtk.ResponseType.OK)
        area = dialog.get_content_area()
        area.set_spacing(8)
        area.set_border_width(12)
        label = Gtk.Label(label=_("Type the _code the teacher's computer shows under Add Students:"),
                          use_underline=True, xalign=0, wrap=True, max_width_chars=44)
        entry = Gtk.Entry(max_length=6, width_chars=8, activates_default=True,
                          input_purpose=Gtk.InputPurpose.DIGITS)
        label.set_mnemonic_widget(entry)
        area.pack_start(label, False, False, 0)
        area.pack_start(entry, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        code = entry.get_text().strip()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        if not (len(code) == 6 and code.isdigit()):
            self.status.set_text(_("The code has 6 digits."))
            return
        self.status.set_text(_("Waiting for the password, then for the teacher's computer…"))
        self.ui.run_async(["pkexec", CLASSROOM_PKEXEC, "lab", "pair", code], self.done)


PAGE_CLASSES = {"layout": LayoutPage, "tiling": TilingPage, "notifications": NotificationsPage, "media": MediaPage,
                "weather": WeatherPage,
                "accessibility": AccessibilityPage,
                "displays": DisplaysPage, "input": InputPage, "keyboard": KeyboardPage, "shortcuts": ShortcutsPage,
                "phone": PhonePage, "idle": IdlePage, "apps": AppsPage, "startup": StartupPage,
                "screenshots": ScreenshotsPage, "region": RegionPage,
                "datetime": DateTimePage, "memory": MemoryPage, "updates": UpdatesPage, "recovery": RestorePointsPage,
                "users": UsersPage,
                "login": LoginPage, "firewall": FirewallPage, "classroom": ClassroomPage, "privacy": PrivacyPage,
                "history": HistoryPage,
                "more": MorePage, "about": AboutPage}


def page_available(page_id):
    """Pages that don't apply here (Login in the live session) are left out."""
    available = getattr(PAGE_CLASSES[page_id], "available", None)
    return available() if available else True


def group_header(page, before):
    """What goes above page in the sidebar: its group's heading when a group
    starts, a line before the pages without one, or nothing (None)."""
    if before is not None and before.group == page.group:
        return None
    return page.group or "line"


def page_list(ui, open_page, shown):
    """The sidebar: the shown pages under their group headings (GtkStackSidebar
    has no headings); selecting one runs open_page(page_id). Returns
    (scrolled window, list)."""
    Gtk = ui.Gtk
    listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE)
    listbox.get_style_context().add_class("sidebar")
    for page in shown:
        row = Gtk.ListBoxRow()
        label = ui.label(page.name, wrap=False)
        label.set_margin_top(8)
        label.set_margin_bottom(8)
        label.set_margin_start(12)
        label.set_margin_end(12)
        row.add(label)
        row.page = page
        listbox.add(row)

    def header(row, before):
        kind = group_header(row.page, before.page if before is not None else None)
        if kind is None:
            row.set_header(None)
        elif kind == "line":
            row.set_header(Gtk.Separator(margin_top=9, margin_bottom=9))
        else:
            heading = ui.label(f"<b>{ui.GLib.markup_escape_text(kind)}</b>", dim=True, wrap=False, markup=True)
            heading.set_margin_top(18 if before is not None else 6)
            heading.set_margin_bottom(6)
            heading.set_margin_start(12)
            row.set_header(heading)

    listbox.set_header_func(header)
    listbox.connect("row-selected", lambda _l, row: row is not None and open_page(row.page.id))
    scrolled = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
    scrolled.add(listbox)
    return scrolled, listbox


def select_page_row(listbox, page_id):
    for row in listbox.get_children():
        if row.page.id == page_id and listbox.get_selected_row() is not row:
            listbox.select_row(row)


def search_index(ui, pages):
    """What the search box finds: each page, the rows and headings the pages
    built (ui.index), and the tiles' apps."""
    items = []
    for page in PAGES:
        if page.id in pages:
            items.append(search_item(page.name, _("Page"), search_words(page.id), page=page.id))
            items += [item for item in ui.index if item.page == page.id]
    for tile in available_tiles():
        # Translators: where a search result leads: "Opens pavucontrol".
        items.append(search_item(tile.name, _("Opens {program}").format(program=tile.command[0]),
                                 search_words(f"tile:{tile.id}"), command=tile.argv))
    return unique_items(items)


SCROLL_TRIES, SCROLL_TRY_MS = 30, 100  # rows and controls ready once their page has read


def scroll_to(ui, page, item, tries=SCROLL_TRIES):
    """Scroll the page so item's widget is near the top and focus its control;
    tried again for a while when the widget isn't on screen or the control
    isn't enabled yet."""
    scrolled = page.widget
    if item.target is not None and isinstance(scrolled, ui.Gtk.ScrolledWindow):
        content = scrolled.get_child()
        content = content.get_child() if isinstance(content, ui.Gtk.Viewport) else content
        coordinates = item.target.translate_coordinates(content, 0, 0) if item.target.get_mapped() else None
        if coordinates is None:
            if tries > 1:
                ui.GLib.timeout_add(SCROLL_TRY_MS, scroll_to, ui, page, item, tries - 1)
            return False
        adjustment = scrolled.get_vadjustment()
        top = adjustment.get_upper() - adjustment.get_page_size()
        adjustment.set_value(max(0, min(coordinates[1] - 24, top)))
    if item.focus is not None:
        if not item.focus.is_sensitive() and tries > 1:
            # Controls are off until their page has read (the power button's).
            ui.GLib.timeout_add(SCROLL_TRY_MS, scroll_to, ui, page, item, tries - 1)
            return False
        # Into the control, or the first focusable widget of a box of them.
        if not item.focus.child_focus(ui.Gtk.DirectionType.TAB_FORWARD):
            item.focus.grab_focus()
    return False


def open_window(gtk, page_id):
    GLib, _skip, Gtk, _skip = gtk
    from gi.repository import Gdk              # loaded with Gtk 3 (load_gtk)
    ui = Ui(gtk)
    window = Gtk.Window(title=TITLE, icon_name=ICON)
    window.set_default_size(900, 660)
    window.connect("destroy", Gtk.main_quit)
    # Not homogeneous: GTK then sizes only the shown page, not all of them.
    stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.NONE, hhomogeneous=False, vhomogeneous=False)
    available = [page for page in PAGES if page_available(page.id)]
    pages = {}
    search_items = []               # built with the last page (search_index)

    def build(page_id):
        """The page, built the first time it's needed: the opened one before the
        window shows, the others one at a time after the first frame
        (PERF-1: building all 24 took about 0.5 s)."""
        if page_id not in pages:
            page = next(p for p in available if p.id == page_id)
            ui.indexing = page
            pages[page_id] = PAGE_CLASSES[page_id](ui)
            ui.indexing = None
            stack.add_titled(pages[page_id].widget, page_id, page.name)
            pages[page_id].widget.show_all()
        return pages[page_id]

    def build_all():
        """Every page; the search needs all their rows."""
        for page in available:
            build(page.id)
        if not search_items:
            search_items.extend(search_index(ui, pages))
        return search_items

    def build_next(remaining):
        page = next(remaining, None)
        if page is None:
            build_all()
            return False
        build(page.id)
        return True

    def open_page(page_id):
        build(page_id)
        stack.set_visible_child_name(page_id)

    ui.open_page = open_page

    # Left: the search box, then the pages, or the results while searching.
    search = Gtk.SearchEntry(placeholder_text=_("Search settings"), margin=6)
    sidebar, sidebar_list = page_list(ui, open_page, available)
    results = Gtk.ListBox(selection_mode=Gtk.SelectionMode.BROWSE)
    results_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
    results_scroll.add(results)
    left_stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.NONE)
    left_stack.add_named(sidebar, "pages")
    left_stack.add_named(results_scroll, "results")
    left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    left.set_size_request(220, -1)
    left.pack_start(search, False, False, 0)
    left.pack_start(left_stack, True, True, 0)

    def result_row(item):
        row = Gtk.ListBoxRow()
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin=8)
        title = ui.label(item.title, wrap=False)
        title.set_ellipsize(3)              # Pango.EllipsizeMode.END
        text.pack_start(title, False, False, 0)
        text.pack_start(ui.label(item.where, dim=True, wrap=False), False, False, 0)
        row.add(text)
        row.item = item
        return row

    def changed(entry):
        for child in results.get_children():
            results.remove(child)
        query = entry.get_text()
        if not query.strip():
            left_stack.set_visible_child_name("pages")
            return
        found = find(build_all(), query)
        for item in found:
            results.add(result_row(item))
        if not found:
            empty = Gtk.ListBoxRow(activatable=False, selectable=False)
            empty.add(ui.label(_("No settings found"), dim=True, wrap=False))
            empty.get_child().set_margin_top(8)
            empty.get_child().set_margin_start(8)
            results.add(empty)
        results.show_all()
        first = results.get_row_at_index(0)
        if found and first is not None:
            results.select_row(first)
        left_stack.set_visible_child_name("results")

    def choose(item):
        search.set_text("")
        if item.command:
            ui.start_app(item.command)
            return
        open_page(item.page)
        GLib.idle_add(scroll_to, ui, pages[item.page], item)

    def activated(_listbox, row):
        if getattr(row, "item", None):
            choose(row.item)

    def enter():
        row = results.get_selected_row() or results.get_row_at_index(0)
        if left_stack.get_visible_child_name() == "results" and row is not None and getattr(row, "item", None):
            choose(row.item)

    def key_pressed(_window, event):
        """Ctrl+F searches; a letter or digit typed outside a text field too.
        Ctrl+W closes the window."""
        if event.state & Gdk.ModifierType.CONTROL_MASK and Gdk.keyval_to_lower(event.keyval) == Gdk.KEY_f:
            search.grab_focus()
            return True
        if event.state & Gdk.ModifierType.CONTROL_MASK and Gdk.keyval_to_lower(event.keyval) == Gdk.KEY_w:
            window.destroy()
            return True
        # Enter in the search box opens the first result (handled here: the
        # entry's activate signal doesn't reach us while a search is pending).
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and search.has_focus():
            enter()
            return True
        if event.keyval == Gdk.KEY_Escape and search.get_text():
            search.set_text("")
            search.grab_focus_without_selecting()
            return True
        if event.keyval == Gdk.KEY_Down and search.has_focus() and left_stack.get_visible_child_name() == "results":
            row = results.get_selected_row() or results.get_row_at_index(0)
            if row is not None:
                row.grab_focus()
            return True
        focus = window.get_focus()
        if isinstance(focus, Gtk.Editable) or event.state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.MOD1_MASK):
            return False
        if not event.string or not event.string.isalnum():
            return False                # space, arrows: keep them for the focused control
        if search.handle_event(event):
            search.grab_focus_without_selecting()   # the next keys, Enter and Escape go there
            return True
        return False

    search.connect("search-changed", changed)
    search.connect("stop-search", lambda entry: entry.set_text(""))
    results.connect("row-activated", activated)
    window.connect("key-press-event", key_pressed)

    box = Gtk.Box()
    box.pack_start(left, False, False, 0)
    box.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 0)
    box.pack_start(stack, True, True, 0)
    window.add(box)
    build(page_id)
    window.show_all()
    stack.set_visible_child_name(page_id)
    select_page_row(sidebar_list, page_id)
    pages[page_id].shown()

    def page_changed(s, _p):
        select_page_row(sidebar_list, s.get_visible_child_name())    # after a search or --page
        pages[s.get_visible_child_name()].shown()

    stack.connect("notify::visible-child-name", page_changed)
    # Below drawing and input, so the window shows and answers first.
    GLib.idle_add(build_next, iter(available), priority=GLib.PRIORITY_LOW)
    Gtk.main()
    return 0


def cmd_open(opts):
    page_id = opts.page or PAGES[0].id
    if page_id not in PAGE_CLASSES:
        warn(f"unknown page '{page_id}'. Pages: {', '.join(page.id for page in PAGES)}")
        return 2
    if not page_available(page_id):
        warn(f"the {page_id} page doesn't apply here; opening {PAGES[0].id}")
        page_id = PAGES[0].id
    with single_instance() as first:
        if not first:
            print("Settings is already open.")
            return 0
        gtk = load_gtk()
        if gtk is None:
            return 1
        return open_window(gtk, page_id)


def cmd_get(opts):
    values, sources = load_values()
    keys = [opts.key] if opts.key else list(SETTINGS)
    for key in keys:
        if key not in SETTINGS:
            warn(f"unknown setting '{key}'. Settings: {', '.join(SETTINGS)}")
            return 2
        setting = SETTINGS[key]
        value = values.get(key)
        if value is None and setting.default is not None:
            value = normalize(setting, "yes" if setting.default is True else "no" if setting.default is False
                              else setting.default)
        print(f"{key}\t{value if value is not None else ''}\t{sources.get(key, 'default')}")
    return 0


def cmd_set(opts):
    setting = SETTINGS.get(opts.key)
    if setting is None:
        warn(f"unknown setting '{opts.key}'. Settings: {', '.join(SETTINGS)}")
        return 2
    values, _skip = load_values()
    note = None
    if opts.value == "default":
        if setting.default is not None:
            # Stored, not removed: labwc keeps a value that disappears.
            text = "yes" if setting.default is True else "no" if setting.default is False else setting.default
            changes = {setting.key: normalize(setting, text)}
        else:
            changes = {setting.key: None}
            if setting.key == "keyboard.layout":
                changes["keyboard.variant"] = None      # it belonged to the layout
            if setting.topic == "input" and in_session():
                note = _("The device's own default comes back at the next login.")
    else:
        changes = {setting.key: normalize(setting, opts.value)}
        if setting.kind == "xkb":
            changes = check_xkb(setting.key, changes[setting.key], values, xkb_rules())
        elif setting.kind == "locale":
            check_locale(setting.key, changes[setting.key])
    save_values(changes)
    live = in_session()
    if setting.topic == "history":
        if changes[setting.key] == "no":
            clear_history()
            print(_("History turned off and cleared."))
        else:
            print(_("History turned on. Changes are kept from now on."))
        return 0
    if setting.topic == "night-light":
        if live:
            restart_night_light()
            print("Applied.")
        else:
            print(_("Saved. It applies at the next login."))
        return 0
    if setting.topic == "notifications":
        problem = mako_config_problem()
        if live and notifications_running():
            set_do_not_disturb(changes[setting.key] == "yes")
            print("Applied.")
        else:
            print(_("Saved. It applies when notifications start."))
        if problem:
            print(problem)
        return 0
    if setting.topic == "lock":
        print(_("Saved. The screen locks this way from now on."))
        return 0
    if setting.topic == "osd":
        print("Applied.")       # the ring's client reads it at every key press
        return 0
    if setting.topic == "idle":
        if live:
            restart_idle()
            print("Applied." if not live_session() else _("Saved. There is no idle lock in the live session."))
        else:
            print(_("Saved. It applies at the next login."))
        return 0
    write_fragments(live)
    status = 0
    if live:
        result = subprocess.run([LAYOUT, "reconfigure"], capture_output=True, text=True,
                                timeout=COMMAND_SECONDS, check=False)
        for line in output_messages(result.stdout, result.stderr):
            warn(line)
        status = 0 if result.returncode == 0 else 1
        print("Applied." if status == 0 else _("Saved, but not applied."))
        if status == 0 and setting.topic == "locale":
            note = _("Apps you open from now on use it; the panel and open apps after the next login.")
    else:
        print(_("Saved. It applies at the next login."))
    if note:
        print(note)
    return status


def cmd_idle(opts):
    """autostart: swayidle with the chosen times (replaces this process)."""
    if live_session():
        print("No idle lock in the live session.")
        return 0
    if shutil.which("swayidle") is None:
        warn("swayidle is not installed; the screen is not locked when idle")
        return 1
    command = idle_command(load_values()[0])
    os.execvpe(command[0], command, dict(os.environ, **{IDLE_MARK: "1"}))


def displays_list(opts, profiles):
    for name, title, _skip in profiles:
        print(f"{name}\t{title}")
    return 0


def displays_start(opts, profiles):
    """autostart: kanshi for the kept arrangements (replaces this process);
    nothing without one, or while a kanshi runs."""
    ours, others = display_daemons()
    if not profiles or ours:
        return 0
    if others:
        warn("another kanshi is running; the arrangements kept in Settings apply when it isn't")
        return 0
    if shutil.which("kanshi") is None:
        warn("kanshi is not installed; kept screen arrangements are not applied")
        return 1
    os.execvpe("kanshi", ["kanshi", "-c", displays_file()], dict(os.environ, **{DISPLAYS_MARK: "1"}))
    return 1


def displays_save(opts, profiles):
    if opts.name:
        warn("save takes no name: it keeps the screens connected now")
        return 2
    if not os.environ.get("WAYLAND_DISPLAY"):
        raise ControlError(_("not in a Wayland session: there are no screens to keep"))
    screens = read_screens()
    if not screens:
        raise ControlError(_("no screens are connected"))
    overlaps = overlapping_screens(screens)
    if overlaps:
        raise ControlError(f"not kept: {overlap_message(overlaps)}")
    name, text = screens_profile(screens)
    title = screens_title(screens)
    write_profiles([profile for profile in profiles if profile[0] != name] + [(name, title, text)])
    restart_displays()
    print(f"Kept: {title}. These screens are set up this way whenever they are connected.")
    return 0


def displays_forget(opts, profiles):
    if not opts.name:
        warn("forget: give the name of an arrangement (displays list) or all")
        return 2
    kept = [] if opts.name == "all" else [profile for profile in profiles if profile[0] != opts.name]
    if len(kept) == len(profiles) and opts.name != "all":
        raise ControlError(f"no kept arrangement '{opts.name}'. "
                           f"Kept: {', '.join(profile[0] for profile in profiles) or 'none'}")
    write_profiles(kept)
    restart_displays()
    print(_("Forgotten. The screens stay as they are until they change or you log out."))
    return 0


def displays_arrange(opts, profiles):
    """wdisplays (Arrange Screens…, the Displays tile and menu entries); while
    it is open, a screen it turns on over another moves beside them
    (place_turned_on). Nothing checks once it is closed."""
    if opts.name:
        warn("arrange takes no name")
        return 2
    if shutil.which(ARRANGE[0]) is None:
        warn(f"{ARRANGE[0]} is not installed: there is nothing to arrange the screens with")
        return 1
    try:
        on = screens_on(read_screens())
    except ControlError:
        on = None                   # not in a Wayland session: wdisplays says so itself
    process = subprocess.Popen(list(ARRANGE), stdin=subprocess.DEVNULL)
    while True:
        try:
            process.wait(timeout=ARRANGE_CHECK_SECONDS)
        except subprocess.TimeoutExpired:
            if on is not None:
                on = place_turned_on(on)
            continue
        if on is not None:
            place_turned_on(on)     # turned on just before it closed
        return process.returncode


DISPLAYS_ACTIONS = {"list": displays_list, "save": displays_save, "forget": displays_forget, "start": displays_start,
                    "arrange": displays_arrange}


def cmd_displays(opts):
    """The kept screen arrangements (kanshi profiles)."""
    return DISPLAYS_ACTIONS[opts.action](opts, read_profiles())


def cmd_lock(opts):
    """Lock the screen with the chosen background (replaces this process)."""
    command = lock_command(load_values()[0], grace=opts.grace)
    if shutil.which(command[0]) is None:
        warn(f"{command[0]} is not installed")
        return 1
    os.execvp(command[0], command)
    return 1


def cmd_night_light(opts):
    """autostart: night light as chosen (replaces this process), or nothing
    while it is off."""
    command = night_light_command(load_values()[0])
    if command is None:
        return 0
    if not os.path.isfile(NIGHT_LIGHT):
        warn(f"{NIGHT_LIGHT} is missing (flickos-settings); no night light")
        return 1
    os.execve(NIGHT_LIGHT, command, dict(os.environ, **{NIGHT_LIGHT_MARK: "1"}))
    return 1


def cmd_notifications(opts):
    """autostart: Do Not Disturb on again once mako runs (a new mako starts
    without it), and the notice of a store key turned off (purchases_notice).
    Nothing while neither is needed."""
    purchases_notice()
    if not value_of(SETTINGS["notifications.do-not-disturb"], load_values()[0].get("notifications.do-not-disturb")):
        return 0
    deadline = time.monotonic() + MAKO_START_SECONDS
    while not notifications_running():
        if time.monotonic() > deadline:
            warn("notifications didn't start; Do Not Disturb is not on")
            return 1
        time.sleep(0.5)
    set_do_not_disturb(True)
    return 0


def cmd_startup(opts):
    """Startup applications: list, enable, disable, add, remove, run (autostart)."""
    if opts.action in ("list", "run") and opts.id:
        warn(f"{opts.action} takes no id")
        return 2
    if opts.action not in ("list", "run") and not opts.id:
        warn(f"{opts.action}: give a desktop file id (flickos-control startup list)")
        return 2
    if opts.action == "list":
        for entry in startup_entries():
            print(f"{entry.id}\t{'on' if entry.enabled else 'off'}\t{'system' if entry.system else 'user'}"
                  f"\t{entry.name}")
    elif opts.action == "run":
        run_startup()
    else:
        old = startup_state(opts.id)
        if opts.action in ("enable", "disable"):
            set_startup_enabled(opts.id, opts.action == "enable")
            print(f"{'On' if opts.action == 'enable' else 'Off'} from the next login.")
        elif opts.action == "add":
            print(f"{add_startup(opts.id)} starts at every login from now on.")
        else:
            print(f"{remove_startup(opts.id)} no longer starts at login.")
        record(f"startup.{opts.id}", old, startup_state(opts.id))
    return 0


def cmd_updates(opts):
    """The automatic update settings (they change through the helper)."""
    state = updates_state()
    last = time.strftime("%Y-%m-%d %H:%M", time.localtime(state["last"])) if state["last"] else "never"
    for key, value in (("auto", "yes" if state["auto"] else "no"), ("scope", state["scope"]),
                       ("reboot", state["reboot"]), ("last", last)):
        print(f"{key}\t{value}")
    return 0


def run_undo(commands):
    """Run the owner's commands of an undo; 0 when all of them worked."""
    status = 0
    for command in commands:
        try:
            result = subprocess.run(command, capture_output=True, text=True, timeout=COMMAND_SECONDS, check=False)
        except (OSError, subprocess.TimeoutExpired) as error:
            warn(f"{command[0]}: {error}")
            return 1
        if result.stdout:
            print(result.stdout, end="")
        for line in output_messages("", result.stderr):
            warn(line)
        if result.returncode != 0:
            status = 1
    return status


def cmd_history(opts):
    """The changes to the desktop's settings: list, undo ID, restore WHEN, clear."""
    if (opts.action in ("undo", "restore")) != bool(opts.id):
        warn({"undo": "undo takes the id of a change (flickos-control history)",
              "restore": "restore takes a change's id, a date or a date and time"}.get(opts.action,
                                                                                     f"{opts.action} takes no id"))
        return 2
    if opts.action == "restore":
        return restore(opts.id, opts.dry_run)
    if opts.action == "clear":
        clear_history()
        print(_("History cleared."))
        return 0
    if opts.action == "undo" and TRANSACTION_ID.match(opts.id):
        # Software: the helper checks it again as root, and pkexec asks for the password.
        for line in plan_text(helper_json(["packages-plan", opts.id])):
            print(line)
        return run_undo([["pkexec", HELPER, "packages-undo", opts.id]])
    if opts.action == "undo":
        change = find_change(opts.id, shape_history(read_history(), days=None))
        return run_undo(undo_commands(change))
    settings = shape_history(read_history(), days=opts.days)
    names = history_names(settings)
    changes = sorted(settings + software_changes(opts.days), key=lambda c: c.when, reverse=True)
    learn_app_names([p for c in changes if isinstance(c, SoftwareChange) for p in c.packages[:APP_NAMES_SHOWN]])
    if opts.json:
        print(json.dumps([{"id": c.id, "time": c.when.isoformat(timespec="seconds"),
                           "owner": "apt" if isinstance(c, SoftwareChange) else c.owner,
                           "key": c.kind if isinstance(c, SoftwareChange) else c.key,
                           "old": "" if isinstance(c, SoftwareChange) else c.old,
                           "new": "" if isinstance(c, SoftwareChange) else c.new,
                           "undoable": c.undoable, "text": describe(c, names)[0]} for c in changes],
                         indent=1, ensure_ascii=False))
        return 0
    if not changes:
        print("No changes yet." if history_enabled() else "History is off (flickos-control set history.enabled yes).")
    for change in changes:
        title, detail = describe(change, names)
        print(f"{change.id}\t{change.when:%Y-%m-%d %H:%M}\t{'undo' if change.undoable else '-'}\t{title}"
              + (f" ({detail[0].lower()}{detail[1:]})" if detail else ""))
    return 0


def cmd_about(opts):
    print(system_info_text(), end="")
    return 0


def cmd_report(opts):
    print(report_text(), end="")
    return 0


def cmd_prepare(opts):
    """At login, before flickos-layout prepare: the fragments for labwc."""
    write_fragments(live=False)
    return 0


def cmd_apply_defaults(opts):
    """The site's defaults changed (flickos-fleet, a variant's package): apply
    this program's settings in the session again. The labwc fragments are
    rewritten (flickos-layout apply-defaults, run next, reloads labwc), and
    the idle lock and night light start again with what is now in force."""
    if not in_session():
        warn("apply-defaults: not in a desktop session; the defaults apply at the next login")
        return 1
    write_fragments(live=True)
    if not live_session():
        restart_idle()
    restart_night_light()
    return 0


def cmd_list(opts):
    for page in PAGES:
        print(f"{page.id}\t{page.name}")
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="flickos-control", description="Settings of the FlickOS desktop.")
    parser.add_argument("--page", metavar="ID", help="open on this page (see: flickos-control list)")
    commands = parser.add_subparsers(dest="command", metavar="COMMAND")
    commands.add_parser("list", help="print the pages: id, name").set_defaults(func=cmd_list)
    get = commands.add_parser("get", help="print settings: key, value, source (default, system or user)")
    get.add_argument("key", nargs="?")
    get.set_defaults(func=cmd_get)
    setter = commands.add_parser("set", help='change a setting and apply it ("default" for its default)')
    setter.add_argument("key")
    setter.add_argument("value")
    setter.set_defaults(func=cmd_set)
    commands.add_parser("prepare", help="write the labwc fragments for this login (flickos-session)"
                        ).set_defaults(func=cmd_prepare)
    commands.add_parser("apply-defaults", help="apply changed site defaults in this session (flickos-fleet; "
                        "then flickos-layout apply-defaults)").set_defaults(func=cmd_apply_defaults)
    commands.add_parser("idle", help="lock and suspend when idle, as chosen (autostart; runs swayidle)"
                        ).set_defaults(func=cmd_idle)
    lock = commands.add_parser("lock", help="lock the screen with the chosen background")
    lock.add_argument("--grace", action="store_true",
                      help="the idle lock: a key or a mouse move within a few seconds unlocks (flickos-lock)")
    lock.set_defaults(func=cmd_lock)
    commands.add_parser("night-light", help="run night light as chosen, or nothing while it is off (autostart)"
                        ).set_defaults(func=cmd_night_light)
    commands.add_parser("notifications", help="turn Do Not Disturb on again once notifications run (autostart)"
                        ).set_defaults(func=cmd_notifications)
    startup = commands.add_parser("startup", help="startup applications (XDG autostart)")
    startup.add_argument("action", choices=("list", "enable", "disable", "add", "remove", "run"))
    startup.add_argument("id", nargs="?", help="a desktop file id (startup list; add: an installed app's)")
    startup.set_defaults(func=cmd_startup)
    commands.add_parser("updates", help="print the automatic update settings").set_defaults(func=cmd_updates)
    displays = commands.add_parser("displays", help="kept screen arrangements (kanshi profiles)")
    displays.add_argument("action", choices=DISPLAYS_ACTIONS)
    displays.add_argument("name", nargs="?", help="forget: the arrangement's name (displays list), or all")
    displays.set_defaults(func=cmd_displays)
    commands.add_parser("about", help="print the system information (for bug reports)"
                        ).set_defaults(func=cmd_about)
    commands.add_parser("report", help="print the system information, the desktop check and the logs "
                                       "(for bug reports; nothing is sent)").set_defaults(func=cmd_report)
    history = commands.add_parser("history", help="changes to the desktop's settings: list, undo ID, clear")
    history.add_argument("action", nargs="?", default="list", choices=("list", "undo", "restore", "clear"))
    history.add_argument("id", nargs="?", help="undo: the change's id (the first column of history); a software "
                         "change's is a date and time")
    history.add_argument("--days", type=int, default=HISTORY_DAYS, help=f"list: this many days (default "
                         f"{HISTORY_DAYS})")
    history.add_argument("--json", action="store_true", help="list: as JSON")
    history.add_argument("--dry-run", action="store_true", help="restore: only print what would go back")
    history.set_defaults(func=cmd_history)
    system = commands.add_parser("system", help="print or change a system setting (asks for the password) "
                                 "and record it for History")
    system.add_argument("key", help=", ".join(SYSTEM_LABELS))
    system.add_argument("value", nargs="?")
    system.set_defaults(func=cmd_system)
    picture = commands.add_parser("picture", help="your picture on the login and lock screens: current, "
                                  "set FILE|default")
    picture.add_argument("action", choices=("current", "set"))
    picture.add_argument("value", nargs="?", help="a picture file, or default for none")
    picture.set_defaults(func=cmd_picture)
    default_apps = commands.add_parser("default-app", help="default applications: list, set CATEGORY APP")
    default_apps.add_argument("action", choices=("list", "set"))
    default_apps.add_argument("category", nargs="?", help=", ".join(DEFAULT_APP_LABELS))
    default_apps.add_argument("app", nargs="?", help="an installed app's desktop file id")
    default_apps.set_defaults(func=cmd_default_app)
    purchases = commands.add_parser("purchases", help="the key of apps bought from the FlickOS store: list, "
                                    "add [--stdin], remove, claim --stdin")
    purchases.add_argument("action", choices=("list", "add", "remove", "claim"))
    purchases.add_argument("--stdin", action="store_true", help="add: the key, claim: Software's claim code, "
                           "on standard input")
    purchases.set_defaults(func=cmd_purchases)
    animations_command = commands.add_parser("animations", help="animations (GSettings enable-animations): "
                                             "current, set on|off|default")
    animations_command.add_argument("action", choices=("current", "set"))
    animations_command.add_argument("value", nargs="?", help="on, off or default")
    animations_command.set_defaults(func=cmd_animations)
    opts = parser.parse_args(argv)
    try:
        return getattr(opts, "func", cmd_open)(opts)
    except (ControlError, OSError, subprocess.TimeoutExpired) as error:
        warn(str(error))
        return 1
    except KeyboardInterrupt:
        return 1
    finally:
        fire_changed()        # the change is applied now (ADR-007)


if __name__ == "__main__":
    sys.exit(main())
