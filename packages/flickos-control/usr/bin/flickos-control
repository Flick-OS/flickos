LOCK_SCREEN_IDLE = LOCK_SCREEN + " --grace"
# swayidle's after-resume (hooks design, ADR-002): the `woke` hooks. swayidle runs
# it in a shell and, with -w, waits for it, so it is only a test of the folder and
# a start that doesn't wait (setsid -f). Without a hooks folder it ends at once,
# with status 0. flickos-hooks itself leaves the plain session alone.
WOKE_COMMAND = ('if [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/flickos/hooks/woke.d" ]; '
                'then setsid -f flickos-hooks run woke; fi')
# FlickOS's lock screen, used when installed; swaylock while swaylock has a
# config of the user's or the system's (SWAYLOCK_CONFIGS: their way back, ADR-009).
FLICKOS_LOCK = "flickos-lock"
