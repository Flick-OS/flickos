HELPER = PREFIX + "/usr/libexec/flickos/control-helper"
LOCALE_DIR = PREFIX + "/usr/share/locale"
try:
    _translation = gettext.translation("flickos-control", LOCALE_DIR, fallback=True)
except Exception:       # a broken .mo (any error parsing it): English, never no login (prepare)
    _translation = gettext.NullTranslations()
_ = _translation.gettext
ngettext = _translation.ngettext


def N_(text):
    """Marks text for the translation template; _() translates it where it is shown."""
    return text


_other_domains = {}


def other_gettext(domain, text):
    """text in another project's translations: iso-codes' names of languages
    and countries, xkeyboard-config's of keyboard layouts (loaded once)."""
    if domain not in _other_domains:
        try:
            _other_domains[domain] = gettext.translation(domain, fallback=True).gettext
        except Exception:   # a broken .mo
            _other_domains[domain] = str
    return _other_domains[domain](text)


