---
# FlickOS installer branding. Reference: https://calamares.io/docs/branding
# Images are placeholders from tools/make-placeholder-art.sh.
componentName:  flickos

welcomeStyleCalamares:  true
welcomeExpandingLogo:   true
windowExpanding:        normal
windowSize:             800px,580px
windowPlacement:        center

strings:
    productName:         FlickOS
    shortProductName:    FlickOS
    # Must match FLICKOS_VERSION in packages/flickos-branding/usr/lib/flickos-release
    # (tools/build-iso.sh checks this).
    version:             "2.2"
    shortVersion:        "2.2"
    versionedName:       "FlickOS 2.2"
    shortVersionedName:  "FlickOS 2.2"
    # Used as the GRUB menu entry and EFI directory name.
    bootloaderEntryName: FlickOS
    # Links on the welcome page (enabled in modules/welcome.conf).
    # Switch productUrl to https://flickos.net once the site is online.
    productUrl:          "https://sourceforge.net/projects/flickos/"
    supportUrl:          "https://github.com/dvbondoy/FlickOS/issues"
    knownIssuesUrl:      "https://github.com/dvbondoy/FlickOS/issues"
    releaseNotesUrl:     "https://sourceforge.net/projects/flickos/files/"
    donateUrl:           "https://flickos.vercel.app/donate"

sidebar:     widget
navigation:  widget

images:
    productLogo:     "logo.png"
    productIcon:     "logo.png"
    productWelcome:  "welcome.png"

slideshow:     "show.qml"
slideshowAPI:  2

# Arc-Dark: title-bar background and text; the current step in FlickOS's brand
# amber with Arc-Dark's #2f343f on it.
style:
    SidebarBackground:         "#2f343f"
    SidebarText:               "#d3dae3"
    SidebarTextCurrent:        "#2f343f"
    SidebarBackgroundCurrent:  "#ffb13d"
